{"ast":null,"code":"import { createCommentVNode as _createCommentVNode, createElementVNode as _createElementVNode, openBlock as _openBlock, createElementBlock as _createElementBlock } from \"vue\";\nconst _hoisted_1 = {\n  class: \"dashboard-container\"\n};\nconst _hoisted_2 = {\n  class: \"chart-container\"\n};\nconst _hoisted_3 = {\n  ref: \"genderChart\",\n  style: {\n    \"width\": \"100%\",\n    \"height\": \"400px\"\n  }\n};\nexport function render(_ctx, _cache, $props, $setup, $data, $options) {\n  return _openBlock(), _createElementBlock(\"div\", _hoisted_1, [_createCommentVNode(\" 现有的用户表格代码保持不变 \"), _createCommentVNode(\" 新增的性别分布图表 \"), _createElementVNode(\"div\", _hoisted_2, [_cache[0] || (_cache[0] = _createElementVNode(\"h2\", null, \"数据图\", -1 /* HOISTED */)), _createElementVNode(\"div\", _hoisted_3, null, 512 /* NEED_PATCH */)])]);\n}","map":{"version":3,"names":["class","ref","style","_createElementBlock","_hoisted_1","_createCommentVNode","_createElementVNode","_hoisted_2","_hoisted_3"],"sources":["E:\\vue_fastapi\\my_vue\\my_vue\\src\\views\\UserDashboard.vue"],"sourcesContent":["<template>\r\n  <div class=\"dashboard-container\">\r\n    <!-- 现有的用户表格代码保持不变 -->\r\n    \r\n    <!-- 新增的性别分布图表 -->\r\n    <div class=\"chart-container\">\r\n      <h2>数据图</h2>\r\n      <div ref=\"genderChart\" style=\"width: 100%; height: 400px;\"></div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, onMounted } from 'vue'\r\nimport * as echarts from 'echarts'\r\nimport axios from 'axios'\r\nimport { API_CONFIG } from './config';\r\n\r\nconst genderChart = ref(null)\r\n\r\n// 获取并渲染性别分布数据\r\nconst renderGenderChart = async () => {\r\n  try {\r\n    const response = await axios.get(`${API_CONFIG.BASE_URL}/bigdata/gender-distribution`)\r\n    const data = response.data\r\n    \r\n    const chart = echarts.init(genderChart.value)\r\n    const option = {\r\n      tooltip: {\r\n        trigger: 'item',\r\n        formatter: '{a} <br/>{b}: {c} ({d}%)'\r\n      },\r\n      legend: {\r\n        orient: 'vertical',\r\n        left: 10,\r\n        data: ['男', '女', '其他']\r\n      },\r\n      series: [\r\n        {\r\n          name: '性别分布',\r\n          type: 'pie',\r\n          radius: ['50%', '70%'],\r\n          avoidLabelOverlap: false,\r\n          label: {\r\n            show: false,\r\n            position: 'center'\r\n          },\r\n          emphasis: {\r\n            label: {\r\n              show: true,\r\n              fontSize: '18',\r\n              fontWeight: 'bold'\r\n            }\r\n          },\r\n          labelLine: {\r\n            show: false\r\n          },\r\n          data: [\r\n            { value: data.male_count, name: '男' },\r\n            { value: data.female_count, name: '女' },\r\n            { value: data.other_count, name: '其他' }\r\n          ]\r\n        }\r\n      ]\r\n    }\r\n    chart.setOption(option)\r\n    \r\n    // 响应式调整大小\r\n    window.addEventListener('resize', function() {\r\n      chart.resize()\r\n    })\r\n  } catch (error) {\r\n    console.error('获取性别分布数据失败:', error)\r\n  }\r\n}\r\n\r\nonMounted(() => {\r\n  renderGenderChart()\r\n})\r\n</script>\r\n\r\n<style scoped>\r\n.chart-container {\r\n  margin-top: 40px;\r\n  padding: 20px;\r\n  background: #fff;\r\n  border-radius: 8px;\r\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\r\n}\r\n</style>"],"mappings":";;EACOA,KAAK,EAAC;AAAqB;;EAIzBA,KAAK,EAAC;AAAiB;;EAErBC,GAAG,EAAC,aAAa;EAACC,KAAmC,EAAnC;IAAA;IAAA;EAAA;;;uBAN3BC,mBAAA,CAQM,OARNC,UAQM,GAPJC,mBAAA,mBAAsB,EAEtBA,mBAAA,eAAkB,EAClBC,mBAAA,CAGM,OAHNC,UAGM,G,0BAFJD,mBAAA,CAAY,YAAR,KAAG,sBACPA,mBAAA,CAAiE,OAAjEE,UAAiE,8B","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}