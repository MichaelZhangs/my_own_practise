{"ast":null,"code":"import { ref, nextTick } from 'vue';\nimport { useStore } from 'vuex';\nimport axios from 'axios';\nexport default {\n  __name: 'UserDetail',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const store = useStore();\n\n    // 响应式数据\n    const editableUser = ref({\n      ...store.state.user,\n      description: store.state.user.description || ''\n    });\n    const qrcodeUrl = ref('');\n    const isPhoneEditable = ref(false);\n    const smsCode = ref('');\n    const countdown = ref(0);\n    let timer = null;\n\n    // 启用手机号编辑\n    const startPhoneEdit = async () => {\n      if (!isPhoneEditable.value) {\n        isPhoneEditable.value = true;\n        await nextTick();\n        document.querySelector('.sms-input')?.focus();\n      }\n    };\n\n    // 取消编辑\n    const cancelPhoneEdit = () => {\n      isPhoneEditable.value = false;\n      smsCode.value = '';\n    };\n\n    // 发送短信验证码\n    const sendSmsCode = async () => {\n      try {\n        if (!/^1[3-9]\\d{9}$/.test(editableUser.value.phone)) {\n          alert('请输入有效的手机号码');\n          return;\n        }\n        const response = await axios.post('/api/send-sms', {\n          phone: editableUser.value.phone\n        });\n        if (response.data.message === '验证码已发送') {\n          countdown.value = 60;\n          timer = setInterval(() => {\n            countdown.value--;\n            if (countdown.value <= 0) clearInterval(timer);\n          }, 1000);\n        }\n      } catch (error) {\n        alert('验证码发送失败，请重试');\n      }\n    };\n\n    // 头像上传处理\n    const handleAvatarUpload = async event => {\n      const file = event.target.files?.[0];\n      if (file && file.type.startsWith('image/')) {\n        try {\n          const formData = new FormData();\n          formData.append('file', file);\n          const response = await axios.post('/api/upload-avatar', formData, {\n            headers: {\n              'Content-Type': 'multipart/form-data'\n            }\n          });\n          editableUser.value.photo = response.data.url;\n        } catch (error) {\n          alert('头像上传失败，请重试');\n        }\n      }\n    };\n\n    // 生成二维码\n    const generateQRWithAvatar = async () => {\n      try {\n        const response = await axios.post('/api/generate-qrcode', {\n          username: editableUser.value.username,\n          phone: editableUser.value.phone,\n          avatar_url: editableUser.value.photo\n        });\n        if (response.data.qrcode_url) {\n          qrcodeUrl.value = response.data.qrcode_url;\n          await store.dispatch('updateUser', editableUser.value);\n        }\n      } catch (error) {\n        alert('二维码生成失败，请重试');\n      }\n    };\n\n    // 保存用户信息\n    const saveUserInfo = async () => {\n      try {\n        if (isPhoneEditable.value) {\n          if (!smsCode.value) {\n            alert('请先完成短信验证');\n            return;\n          }\n          await axios.post('/api/update-phone', {\n            new_phone: editableUser.value.phone,\n            verification_code: smsCode.value\n          });\n        }\n        await axios.put('/api/info', {\n          ...editableUser.value,\n          verification_code: smsCode.value\n        });\n        await store.dispatch('updateUser', editableUser.value);\n        cancelPhoneEdit();\n        alert('信息保存成功!');\n      } catch (error) {\n        alert(error.response?.data?.detail || '保存失败，请检查网络后重试');\n      }\n    };\n    const __returned__ = {\n      store,\n      editableUser,\n      qrcodeUrl,\n      isPhoneEditable,\n      smsCode,\n      countdown,\n      get timer() {\n        return timer;\n      },\n      set timer(v) {\n        timer = v;\n      },\n      startPhoneEdit,\n      cancelPhoneEdit,\n      sendSmsCode,\n      handleAvatarUpload,\n      generateQRWithAvatar,\n      saveUserInfo,\n      ref,\n      nextTick,\n      get useStore() {\n        return useStore;\n      },\n      get axios() {\n        return axios;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","nextTick","useStore","axios","store","editableUser","state","user","description","qrcodeUrl","isPhoneEditable","smsCode","countdown","timer","startPhoneEdit","value","document","querySelector","focus","cancelPhoneEdit","sendSmsCode","test","phone","alert","response","post","data","message","setInterval","clearInterval","error","handleAvatarUpload","event","file","target","files","type","startsWith","formData","FormData","append","headers","photo","url","generateQRWithAvatar","username","avatar_url","qrcode_url","dispatch","saveUserInfo","new_phone","verification_code","put","detail"],"sources":["E:/vue_learn/ai_vue/ai_vue/src/views/UserDetail.vue"],"sourcesContent":["<template>\r\n    <div class=\"user-detail-page\">\r\n      <h1 class=\"page-title\">用户详情</h1>\r\n      <div class=\"user-container\">\r\n        <!-- 可编辑头像 -->\r\n        <div class=\"avatar-wrapper\">\r\n          <label class=\"avatar-upload\">\r\n            <input \r\n              type=\"file\" \r\n              accept=\"image/*\" \r\n              @change=\"handleAvatarUpload\" \r\n              hidden\r\n            />\r\n            <img \r\n              :src=\"editableUser.photo || defaultAvatar\" \r\n              alt=\"用户头像\" \r\n              class=\"user-avatar\"\r\n            />\r\n            <span class=\"edit-tip\">点击更换头像</span>\r\n          </label>\r\n        </div>\r\n  \r\n        <!-- 用户信息编辑 -->\r\n        <div class=\"info-section\">\r\n          <div class=\"info-item\">\r\n            <label>姓名：</label>\r\n            <input v-model=\"editableUser.username\" class=\"short-input\" />\r\n          </div>\r\n          \r\n          <div class=\"info-item\">\r\n            <label>性别：</label>\r\n            <select v-model=\"editableUser.sex\">\r\n              <option value=\"男\">男</option>\r\n              <option value=\"女\">女</option>\r\n            </select>\r\n          </div>\r\n  \r\n          <div class=\"info-item\">\r\n            <label>手机：</label>\r\n            <div class=\"phone-edit-wrapper\">\r\n              <input\r\n                v-model=\"editableUser.phone\"\r\n                :readonly=\"!isPhoneEditable\"\r\n                class=\"short-input\"\r\n                @dblclick=\"startPhoneEdit\"\r\n                @blur=\"cancelPhoneEdit\"\r\n              />\r\n              <span v-if=\"!isPhoneEditable\" class=\"edit-hint\">(双击修改)</span>\r\n              \r\n              <div v-if=\"isPhoneEditable\" class=\"sms-verify\">\r\n                <input\r\n                  v-model=\"smsCode\"\r\n                  placeholder=\"请输入验证码\"\r\n                  class=\"sms-input\"\r\n                />\r\n                <button \r\n                  class=\"sms-btn\"\r\n                  :disabled=\"countdown > 0\"\r\n                  @click=\"sendSmsCode\"\r\n                >\r\n                  {{ countdown > 0 ? `${countdown}s后重试` : '获取验证码' }}\r\n                </button>\r\n              </div>\r\n            </div>\r\n          </div>\r\n  \r\n          <div class=\"info-item\">\r\n            <label>邮箱：</label>\r\n            <input v-model=\"editableUser.email\" class=\"short-input\" />\r\n          </div>\r\n  \r\n          <div class=\"info-item\">\r\n            <label>描述：</label>\r\n            <input v-model=\"editableUser.description\" class=\"short-input\" />\r\n          </div>\r\n  \r\n          <!-- 二维码展示 -->\r\n          <div class=\"info-item\">\r\n            <label class=\"qr-label\">我的二维码：</label>\r\n            <div class=\"qr-wrapper\" @click=\"generateQRWithAvatar\">\r\n              <img \r\n                :src=\"qrcodeUrl || defaultQR\" \r\n                alt=\"个人二维码\" \r\n                class=\"wechat-qr\"\r\n              />\r\n            </div>\r\n          </div>\r\n        </div>\r\n  \r\n        <button class=\"save-btn\" @click=\"saveUserInfo\">保存修改</button>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script setup>\r\n  import { ref, nextTick } from 'vue'\r\n  import { useStore } from 'vuex'\r\n  import axios from 'axios'\r\n  \r\n  const store = useStore()\r\n  \r\n  // 响应式数据\r\n  const editableUser = ref({\r\n    ...store.state.user,\r\n    description: store.state.user.description || ''\r\n  })\r\n  const qrcodeUrl = ref('')\r\n  const isPhoneEditable = ref(false)\r\n  const smsCode = ref('')\r\n  const countdown = ref(0)\r\n  let timer = null\r\n  \r\n  // 启用手机号编辑\r\n  const startPhoneEdit = async () => {\r\n    if (!isPhoneEditable.value) {\r\n      isPhoneEditable.value = true\r\n      await nextTick()\r\n      document.querySelector('.sms-input')?.focus()\r\n    }\r\n  }\r\n  \r\n  // 取消编辑\r\n  const cancelPhoneEdit = () => {\r\n    isPhoneEditable.value = false\r\n    smsCode.value = ''\r\n  }\r\n  \r\n  // 发送短信验证码\r\n  const sendSmsCode = async () => {\r\n    try {\r\n      if (!/^1[3-9]\\d{9}$/.test(editableUser.value.phone)) {\r\n        alert('请输入有效的手机号码')\r\n        return\r\n      }\r\n  \r\n      const response = await axios.post('/api/send-sms', {\r\n        phone: editableUser.value.phone\r\n      })\r\n  \r\n      if (response.data.message === '验证码已发送') {\r\n        countdown.value = 60\r\n        timer = setInterval(() => {\r\n          countdown.value--\r\n          if (countdown.value <= 0) clearInterval(timer)\r\n        }, 1000)\r\n      }\r\n    } catch (error) {\r\n      alert('验证码发送失败，请重试')\r\n    }\r\n  }\r\n  \r\n  // 头像上传处理\r\n  const handleAvatarUpload = async (event) => {\r\n    const file = event.target.files?.[0]\r\n    if (file && file.type.startsWith('image/')) {\r\n      try {\r\n        const formData = new FormData()\r\n        formData.append('file', file)\r\n        \r\n        const response = await axios.post('/api/upload-avatar', formData, {\r\n          headers: { 'Content-Type': 'multipart/form-data' }\r\n        })\r\n  \r\n        editableUser.value.photo = response.data.url\r\n      } catch (error) {\r\n        alert('头像上传失败，请重试')\r\n      }\r\n    }\r\n  }\r\n  \r\n  // 生成二维码\r\n  const generateQRWithAvatar = async () => {\r\n    try {\r\n      const response = await axios.post('/api/generate-qrcode', {\r\n        username: editableUser.value.username,\r\n        phone: editableUser.value.phone,\r\n        avatar_url: editableUser.value.photo\r\n      })\r\n  \r\n      if (response.data.qrcode_url) {\r\n        qrcodeUrl.value = response.data.qrcode_url\r\n        await store.dispatch('updateUser', editableUser.value)\r\n      }\r\n    } catch (error) {\r\n      alert('二维码生成失败，请重试')\r\n    }\r\n  }\r\n  \r\n  // 保存用户信息\r\n  const saveUserInfo = async () => {\r\n    try {\r\n      if (isPhoneEditable.value) {\r\n        if (!smsCode.value) {\r\n          alert('请先完成短信验证')\r\n          return\r\n        }\r\n  \r\n        await axios.post('/api/update-phone', {\r\n          new_phone: editableUser.value.phone,\r\n          verification_code: smsCode.value\r\n        })\r\n      }\r\n  \r\n      await axios.put('/api/info', {\r\n        ...editableUser.value,\r\n        verification_code: smsCode.value\r\n      })\r\n  \r\n      await store.dispatch('updateUser', editableUser.value)\r\n      cancelPhoneEdit()\r\n      alert('信息保存成功!')\r\n    } catch (error) {\r\n      alert(error.response?.data?.detail || '保存失败，请检查网络后重试')\r\n    }\r\n  }\r\n  </script>\r\n  \r\n  <style scoped>\r\n  /* 基础布局 */\r\n  .user-detail-page {\r\n    max-width: 600px;\r\n    margin: 0 auto;\r\n    padding: 2rem;\r\n    font-family: 'Helvetica Neue', Arial, sans-serif;\r\n  }\r\n  \r\n  .page-title {\r\n    text-align: center;\r\n    font-size: 1.5rem;\r\n    color: #333;\r\n    margin-bottom: 2rem;\r\n  }\r\n\r\n  /* 手机号编辑区域 */\r\n    .phone-edit-wrapper {\r\n    flex: 1;\r\n    position: relative;\r\n    }\r\n    \r\n  .user-container {\r\n    background: #fff;\r\n    border-radius: 12px;\r\n    padding: 1.5rem;\r\n    box-shadow: 0 2px 8px rgba(0,0,0,0.1);\r\n  }\r\n  \r\n  /* 头像样式 */\r\n  .avatar-wrapper {\r\n    text-align: center;\r\n    margin-bottom: 1.5rem;\r\n  }\r\n  \r\n  .user-avatar {\r\n    width: 100px;\r\n    height: 100px;\r\n    border-radius: 50%;\r\n    border: 3px solid #07c160;\r\n    cursor: pointer;\r\n    transition: transform 0.3s ease;\r\n  }\r\n  \r\n  .user-avatar:hover {\r\n    transform: scale(1.05);\r\n  }\r\n  /* 二维码标签特殊样式 */\r\n    .qr-label {\r\n    margin-top: 5px; /* 保持垂直对齐 */\r\n    }\r\n  \r\n  .edit-tip {\r\n    display: block;\r\n    color: #666;\r\n    font-size: 0.8rem;\r\n    margin-top: 0.5rem;\r\n  }\r\n  \r\n  /* 手机号编辑提示 */\r\n    .edit-hint {\r\n    color: #999;\r\n    font-size: 0.8rem;\r\n    margin-left: 10px;\r\n    }\r\n    /* 手机号输入框只读状态 */\r\n    input:read-only {\r\n    background-color: #f5f5f5;\r\n    cursor: not-allowed;\r\n    border-color: #eee;\r\n    }\r\n\r\n    /* 短信验证样式 */\r\n    .sms-verify {\r\n    margin-top: 10px;\r\n    display: flex;\r\n    gap: 10px;\r\n    }\r\n\r\n\r\n        .sms-input {\r\n    flex: 1;\r\n    max-width: 150px;\r\n    padding: 8px;\r\n    border: 1px solid #ddd;\r\n    border-radius: 4px;\r\n    }\r\n\r\n    .sms-btn {\r\n    padding: 8px 15px;\r\n    background: #07c160;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 4px;\r\n    cursor: pointer;\r\n    }\r\n\r\n    .sms-btn:disabled {\r\n    background: #cccccc;\r\n    cursor: not-allowed;\r\n    }\r\n  /* 信息项样式 */\r\n  .info-section {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 1rem;\r\n  }\r\n  \r\n  .info-item {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 1rem;\r\n  }\r\n  \r\n  .info-item label {\r\n  flex: 0 0 100px;\r\n  text-align: left; /* 改为左对齐 */\r\n  color: #666;\r\n  font-size: 0.9rem;\r\n  margin-right: 15px;\r\n}\r\n  \r\n  /* 输入控件样式 */\r\n  .short-input, select {\r\n    flex: 1;\r\n    padding: 0.5rem;\r\n    border: 1px solid #ddd;\r\n    border-radius: 4px;\r\n    max-width: 300px;\r\n    font-size: 0.9rem;\r\n  }\r\n  \r\n  select {\r\n    background: white;\r\n    cursor: pointer;\r\n  }\r\n  \r\n  /* 二维码区域 */\r\n  .qr-wrapper {\r\n    flex: 1;\r\n    cursor: pointer;\r\n  }\r\n  \r\n  .wechat-qr {\r\n    width: 160px;\r\n    height: 160px;\r\n    border: 3px solid #07c160;\r\n    border-radius: 8px;\r\n    padding: 5px;\r\n    background: white;\r\n    transition: transform 0.3s ease;\r\n  }\r\n  \r\n  .wechat-qr:hover {\r\n    transform: scale(1.05);\r\n  }\r\n  \r\n  /* 保存按钮 */\r\n  .save-btn {\r\n    display: block;\r\n    width: 200px;\r\n    padding: 0.8rem;\r\n    margin: 2rem auto 0;\r\n    background: #07c160;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 25px;\r\n    cursor: pointer;\r\n    font-size: 1rem;\r\n    transition: background 0.3s ease;\r\n  }\r\n  \r\n  .save-btn:hover {\r\n    background: #05964d;\r\n  }\r\n  \r\n  /* 响应式设计 */\r\n  @media (max-width: 480px) {\r\n    .user-container {\r\n      padding: 1rem;\r\n    }\r\n  \r\n    .info-item {\r\n      flex-direction: column;\r\n      align-items: flex-start;\r\n    }\r\n  \r\n    .info-item label {\r\n      text-align: left;\r\n      flex: none;\r\n    }\r\n  \r\n    .short-input, select {\r\n      max-width: 100%;\r\n      width: 100%;\r\n    }\r\n  \r\n    .wechat-qr {\r\n      width: 140px;\r\n      height: 140px;\r\n    }\r\n  }\r\n  </style>  "],"mappings":"AA+FE,SAASA,GAAG,EAAEC,QAAQ,QAAQ,KAAK;AACnC,SAASC,QAAQ,QAAQ,MAAM;AAC/B,OAAOC,KAAK,MAAM,OAAO;;;;;;;IAEzB,MAAMC,KAAK,GAAGF,QAAQ,CAAC,CAAC;;IAExB;IACA,MAAMG,YAAY,GAAGL,GAAG,CAAC;MACvB,GAAGI,KAAK,CAACE,KAAK,CAACC,IAAI;MACnBC,WAAW,EAAEJ,KAAK,CAACE,KAAK,CAACC,IAAI,CAACC,WAAW,IAAI;IAC/C,CAAC,CAAC;IACF,MAAMC,SAAS,GAAGT,GAAG,CAAC,EAAE,CAAC;IACzB,MAAMU,eAAe,GAAGV,GAAG,CAAC,KAAK,CAAC;IAClC,MAAMW,OAAO,GAAGX,GAAG,CAAC,EAAE,CAAC;IACvB,MAAMY,SAAS,GAAGZ,GAAG,CAAC,CAAC,CAAC;IACxB,IAAIa,KAAK,GAAG,IAAI;;IAEhB;IACA,MAAMC,cAAc,GAAG,MAAAA,CAAA,KAAY;MACjC,IAAI,CAACJ,eAAe,CAACK,KAAK,EAAE;QAC1BL,e