e=\"phone\"\r\n              checked\r\n            /> 短信登录\r\n          </label>\r\n          <label>\r\n            <input\r\n              type=\"radio\"\r\n              v-model=\"loginType\"\r\n              value=\"email\"\r\n            /> 邮箱登录\r\n          </label>\r\n        </div>\r\n\r\n        <!-- 手机号登录 -->\r\n        <div v-if=\"loginType === 'phone'\" class=\"input-group\">\r\n          <input\r\n            type=\"text\"\r\n            v-model=\"phone\"\r\n            placeholder=\"请输入手机号\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <!-- 邮箱登录 -->\r\n        <div v-else class=\"input-group\">\r\n          <input\r\n            type=\"email\"\r\n            v-model=\"email\"\r\n            placeholder=\"请输入邮箱\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <!-- 验证码输入 -->\r\n        <div class=\"input-group code-group\">\r\n          <input\r\n            type=\"text\"\r\n            v-model=\"code\"\r\n            placeholder=\"请输入验证码\"\r\n            required\r\n          />\r\n          <button type=\"button\" @click=\"sendCode\" class=\"code-button\">\r\n            获取验证码\r\n          </button>\r\n        </div>\r\n\r\n        <!-- 登录按钮 -->\r\n        <button type=\"submit\" class=\"login-button\">登录</button>\r\n      </form>\r\n\r\n      <!-- 显示登录结果 -->\r\n      <div v-if=\"loginResult\" class=\"login-result\">\r\n        <p v-if=\"loginResult.success\">登录成功！</p>\r\n        <p v-else>登录失败：{{ loginResult.message }}</p>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 验证码弹窗 -->\r\n    <div v-if=\"showCodeModal\" class=\"modal-overlay\">\r\n      <div class=\"modal-content\">\r\n        <h3>验证码已发送</h3>\r\n        <p>您的验证码是：<strong>{{ generatedCode }}</strong></p>\r\n        <button @click=\"fillCodeAndCloseModal\">填充验证码并关闭</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref } from \"vue\";\r\nimport { useRouter } from \"vue-router\"; // 导入 useRouter\r\nimport axios from \"axios\";\r\n\r\nexport default {\r\n  name: \"UserLogin\",\r\n  setup() {\r\n    const router = useRouter(); // 获取路由对象\r\n    console.log(\"router -- 1 \", router)\r\n    const loginType = ref(\"phone\"); // 登录方式：phone 或 email\r\n    const phone = ref(\"\"); // 手机号\r\n    const email = ref(\"\"); // 邮箱\r\n    const code = ref(\"\"); // 验证码\r\n    const loginResult = ref(null); // 登录结果\r\n    const generatedCode = ref(\"\"); // 从后端获取的验证码\r\n    const showCodeModal = ref(false); // 是否显示验证码弹窗\r\n\r\n    // 发送验证码\r\n    const sendCode = async () => {\r\n      if (loginType.value === \"phone\" && !phone.value) {\r\n        alert(\"请输入手机号\");\r\n        return;\r\n      }\r\n      if (loginType.value === \"email\" && !email.value) {\r\n        alert(\"请输入邮箱\");\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const username = loginType.value === \"phone\" ? phone.value : email.value;\r\n\r\n        // 打印日志：发送验证码请求\r\n        console.log(\"发送验证码请求：\", {\r\n          username,\r\n        });\r\n\r\n        // 调用后端接口获取验证码\r\n        const response = await axios.post(\"http://127.0.0.1:8000/api/send-code\", {\r\n          username,\r\n        });\r\n\r\n        // 打印日志：验证码请求响应\r\n        console.log(\"验证码请求响应：\", response.data);\r\n\r\n        // 从后端获取验证码\r\n        generatedCode.value = response.data.code;\r\n\r\n        // 显示验证码弹窗\r\n        showCodeModal.value = true;\r\n      } catch (error) {\r\n        // 打印日志：验证码请求失败\r\n        console.error(\"验证码请求失败：\", error.response?.data);\r\n\r\n        alert(\"验证码发送失败\");\r\n      }\r\n    };\r\n\r\n    // 填充验证码并关闭弹窗\r\n    const fillCodeAndCloseModal = () => {\r\n      code.value = generatedCode.value; // 将验证码填充到输入框\r\n      showCodeModal.value = false; // 关闭弹窗\r\n    };\r\n\r\n    // 处理登录\r\n    const handleLogin = async () => {\r\n        console.log(\"router 对象： \",  router);\r\n\r\n\r\n      if (!code.value) {\r\n        alert(\"请输入验证码\");\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const username = loginType.value === \"phone\" ? phone.value : email.value;\r\n        const password = code.value;\r\n\r\n        // 打印日志：发送登录请求\r\n        console.log(\"发送登录请求：\", {\r\n          username,\r\n          password,\r\n        });\r\n\r\n        // 调用后端登录接口\r\n        const response = await axios.post(\r\n          \"http://127.0.0.1:8000/api/login\",\r\n          {\r\n            username,\r\n            password,\r\n          },\r\n          {\r\n            headers: {\r\n              \"Content-Type\": \"application/json\", // 确保设置正确的 Content-Type\r\n            },\r\n          }\r\n        );\r\n\r\n        // 打印日志：登录请求响应\r\n        console.log(\"登录请求响应：\", response.data);\r\n\r\n        // 登录成功\r\n        loginResult.value = {\r\n          success: true,\r\n          message: \"登录成功！\",\r\n          data: response.data,\r\n        };\r\n\r\n        // 跳转到用户页面\r\n        console.log(\"准备跳转到用户页面\");\r\n        await router.push(\"/user\"); // 使用 await 确保跳转完成\r\n\r\n        console.log(router);\r\n\r\n        console.log(\"跳转成功\");\r\n      } catch (error) {\r\n        // 打印日志：登录请求失败\r\n        console.error(\"登录请求失败：\", error);\r\n\r\n        if (error.response) {\r\n          console.error(\"响应数据：\", error.response.data);\r\n          console.error(\"状态码：\", error.response.status);\r\n          console.error(\"响应头：\", error.response.headers);\r\n        } else if (error.request) {\r\n          console.error(\"请求未收到响应：\", error.request);\r\n        } else {\r\n          console.error(\"请求配置错误：\", error.config);\r\n        }\r\n\r\n        // 登录失败\r\n        loginResult.value = {\r\n          success: false,\r\n          message: error.response?.data?.detail || \"登录失败\",\r\n        };\r\n      }\r\n    };\r\n\r\n    return {\r\n      loginType,\r\n      phone,\r\n      email,\r\n      code,\r\n      loginResult,\r\n      generatedCode,\r\n      showCodeModal,\r\n      sendCode,\r\n      fillCodeAndCloseModal,\r\n      handleLogin,\r\n      router,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.login-wrapper {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  height: 100vh;\r\n  background-color: #f5f5f5; /* 背景颜色 */\r\n}\r\n\r\n.user-login-container {\r\n  max-width: 400px;\r\n  width: 100%;\r\n  padding: 30px;\r\n  border-radius: 10px;\r\n  background-color: white; /* 登录框背景颜色 */\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);\r\n}\r\n\r\nh1 {\r\n  text-align: center;\r\n  color: #333;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.login-type {\r\n  display: flex;\r\n  justify-content: center;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.login-type label {\r\n  margin: 0 10px;\r\n  font-size: 16px;\r\n}\r\n\r\n.input-group {\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.input-group input {\r\n  width: 100%;\r\n  padding: 10px;\r\n  border: 1px solid #ccc;\r\n  border-radius: 5px;\r\n  font-size: 16px;\r\n}\r\n\r\n.code-group {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.code-group input {\r\n  flex: 1;\r\n  margin-right: 10px;\r\n}\r\n\r\n.code-button {\r\n  padding: 10px 15px;\r\n  background-color: #42b983;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n  font-size: 14px;\r\n}\r\n\r\n.code-button:hover {\r\n  background-color: #369f6e;\r\n}\r\n\r\n.login-button {\r\n  width: 100%;\r\n  padding: 10px;\r\n  background-color: #42b983;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n  font-size: 16px;\r\n}\r\n\r\n.login-button:hover {\r\n  background-color: #369f6e;\r\n}\r\n\r\n.login-result {\r\n  margin-top: 20px;\r\n  text-align: center;\r\n  font-size: 16px;\r\n  color: #333;\r\n}\r\n\r\n/* 弹窗样式 */\r\n.modal-overlay {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background-color: rgba(0, 0, 0, 0.5);\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n\r\n.modal-content {\r\n  background-color: white;\r\n  padding: 20px;\r\n  border-radius: 10px;\r\n  text-align: center;\r\n}\r\n\r\n.modal-content h3 {\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.modal-content button {\r\n  margin-top: 10px;\r\n  padding: 10px 20px;\r\n  background-color: #42b983;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n}\r\n\r\n.modal-content button:hover {\r\n  background-color: #369f6e;\r\n}\r\n</style>"],"mappings":";;EACOA,KAAK,EAAC;AAAe;;EACnBA,KAAK,EAAC;AAAsB;;EAIxBA,KAAK,EAAC;AAAY;;EAN/BC,GAAA;EAyB0CD,KAAK,EAAC;;;EAU5BA,KAAK,EAAC;AAAa;;EAU1BA,KAAK,EAAC;AAAwB;;EA7C3CC,GAAA;EA8D8BD,KAAK,EAAC;;;EA9DpCC,GAAA;AAAA;;EAAAA,GAAA;AAAA;;EAAAA,GAAA;EAqE8BD,KAAK,EAAC;;;EACzBA,KAAK,EAAC;AAAe;;uBArE9BE,mBAAA,CA2EM,OA3ENC,UA2EM,GA1EJC,mBAAA,CAgEM,OAhENC,UAgEM,G,4BA/DJD,mBAAA,CAAa,YAAT,MAAI,sBACRA,mBAAA,CAuDO;IAvDAE,QAAM,EAAAC,MAAA,QAAAA,MAAA,MAJnBC,cAAA,KAAAC,IAAA,KAI6BC,MAAA,CAAAC,WAAA,IAAAD,MAAA,CAAAC,WAAA,IAAAF,IAAA,CAAW;MAChCG,mBAAA,YAAe,EACfR,mBAAA,CAgBM,OAhBNS,UAgBM,GAfJT,mBAAA,CAOQ,gB,gBANNA,mBAAA,CAKE;IAJAU,IAAI,EAAC,OAAO;IAT1B,uBAAAP,MAAA,QAAAA,MAAA,MAAAQ,MAAA,IAUuBL,MAAA,CAAAM,SAAS,GAAAD,MAAA;IAClBE,KAAK,EAAC,OAAO;IACbC,OAAO,EAAP;kDAFSR,MAAA,CAAAM,SAAS,E,6BAVhCG,gBAAA,CAac,QACJ,G,GACAf,mBAAA,CAMQ,gB,gBALNA,mBAAA,CAIE;IAHAU,IAAI,EAAC,OAAO;IAjB1B,uBAAAP,MAAA,QAAAA,MAAA,MAAAQ,MAAA,IAkBuBL,MAAA,CAAAM,SAAS,GAAAD,MAAA;IAClBE,KAAK,EAAC;kDADGP,MAAA,CAAAM,SAAS,E,6BAlBhCG,gBAAA,CAoBc,QACJ,G,KAGFP,mBAAA,WAAc,EACHF,MAAA,CAAAM,SAAS,gB,cAApBd,mBAAA,CAOM,OAPNkB,UAOM,G,gBANJhB,mBAAA,CAKE;IAJAU,IAAI,EAAC,MAAM;IA3BvB,uBAAAP,MAAA,QAAAA,MAAA,MAAAQ,MAAA,IA4BqBL,MAAA,CAAAW,KAAK,GAAAN,MAAA;IACdO,WAAW,EAAC,QAAQ;IACpBC,QAAQ,EAAR;iDAFSb,MAAA,CAAAW,KAAK,E,sBAOlBnB,mBAAA,CAOMsB,SAAA;IA1CdvB,GAAA;EAAA,IAkCQW,mBAAA,UAAa,EACbR,mBAAA,CAOM,OAPNqB,UAOM,G,gBANJrB,mBAAA,CAKE;IAJAU,IAAI,EAAC,OAAO;IArCxB,uBAAAP,MAAA,QAAAA,MAAA,MAAAQ,MAAA,IAsCqBL,MAAA,CAAAgB,KAAK,GAAAX,MAAA;IACdO,WAAW,EAAC,OAAO;IACnBC,QAAQ,EAAR;iDAFSb,MAAA,CAAAgB,KAAK,E,uDAMlBd,mBAAA,WAAc,EACdR,mBAAA,CAUM,OAVNuB,UAUM,G,gBATJvB,mBA