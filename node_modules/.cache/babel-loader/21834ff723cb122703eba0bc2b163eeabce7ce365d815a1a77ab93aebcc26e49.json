{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from \"axios\";\nexport default {\n  name: \"PasswordLogin\",\n  data() {\n    return {\n      username: this.$route.query.username || \"\",\n      // 从路由参数中获取用户名\n      password: \"\"\n    };\n  },\n  methods: {\n    async handlePasswordLogin() {\n      try {\n        const response = await axios.post(\"http://127.0.0.1:8000/api/password-login\", {\n          username: this.username,\n          password: this.password\n        });\n\n        // 登录成功\n        this.$store.dispatch(\"login\", {\n          user: response.data.user,\n          token: response.data.access_token\n        });\n        const {\n          user,\n          token\n        } = response.data;\n\n        // 更新 Vuex 状态\n        this.$store.dispatch(\"login\", {\n          user,\n          token\n        });\n\n        // 跳转到用户页面\n        this.$router.push(\"/user\");\n      } catch (error) {\n        if (error.response?.status === 400) {\n          // 密码错误，跳转到重置密码页面\n          this.$router.push({\n            path: \"/reset-password\",\n            query: {\n              username: this.username\n            }\n          });\n        } else {\n          console.error(\"登录失败\", error);\n        }\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","username","$route","query","password","methods","handlePasswordLogin","response","post","$store","dispatch","user","token","access_token","$router","push","error","status","path","console"],"sources":["E:\\vue_learn\\ai_vue\\ai_vue\\src\\views\\PasswordLogin.vue"],"sourcesContent":["<template>\r\n    <div class=\"password-login\">\r\n      <h1>密码登录</h1>\r\n      <form @submit.prevent=\"handlePasswordLogin\">\r\n        <div class=\"input-group\">\r\n          <input\r\n            type=\"text\"\r\n            v-model=\"username\"\r\n            placeholder=\"请输入用户名/手机号/邮箱\"\r\n            required\r\n          />\r\n        </div>\r\n        <div class=\"input-group\">\r\n          <input\r\n            type=\"password\"\r\n            v-model=\"password\"\r\n            placeholder=\"请输入密码\"\r\n            required\r\n          />\r\n        </div>\r\n        <button type=\"submit\" class=\"login-button\">登录</button>\r\n      </form>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import axios from \"axios\";\r\n  \r\n  export default {\r\n    name: \"PasswordLogin\",\r\n    data() {\r\n      return {\r\n        username: this.$route.query.username || \"\", // 从路由参数中获取用户名\r\n        password: \"\",\r\n      };\r\n    },\r\n    methods: {\r\n      async handlePasswordLogin() {\r\n        try {\r\n          const response = await axios.post(\"http://127.0.0.1:8000/api/password-login\", {\r\n            username: this.username,\r\n            password: this.password,\r\n          });\r\n  \r\n          // 登录成功\r\n           this.$store.dispatch(\"login\", {\r\n            user: response.data.user,\r\n            token: response.data.access_token,\r\n          });\r\n          \r\n          const { user, token } = response.data;\r\n\r\n        // 更新 Vuex 状态\r\n        this.$store.dispatch(\"login\", { user, token });\r\n\r\n          // 跳转到用户页面\r\n          this.$router.push(\"/user\");\r\n        } catch (error) {\r\n          if (error.response?.status === 400) {\r\n            // 密码错误，跳转到重置密码页面\r\n            this.$router.push({\r\n              path: \"/reset-password\",\r\n              query: { username: this.username },\r\n            });\r\n          } else {\r\n            console.error(\"登录失败\", error);\r\n          }\r\n        }\r\n      },\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .password-login {\r\n    max-width: 400px;\r\n    margin: 0 auto;\r\n    padding: 20px;\r\n    background-color: white;\r\n    border-radius: 10px;\r\n    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);\r\n  }\r\n  \r\n  h1 {\r\n    text-align: center;\r\n    color: #333;\r\n    margin-bottom: 20px;\r\n  }\r\n  \r\n  .input-group {\r\n    margin-bottom: 15px;\r\n  }\r\n  \r\n  .input-group input {\r\n    width: 100%;\r\n    padding: 10px;\r\n    border: 1px solid #ccc;\r\n    border-radius: 5px;\r\n    font-size: 16px;\r\n  }\r\n  \r\n  .login-button {\r\n    width: 100%;\r\n    padding: 10px;\r\n    background-color: #42b983;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 5px;\r\n    cursor: pointer;\r\n    font-size: 16px;\r\n  }\r\n  \r\n  .login-button:hover {\r\n    background-color: #369f6e;\r\n  }\r\n  </style>"],"mappings":";AA0BE,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,eAAe;EACrBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,IAAI,CAACC,MAAM,CAACC,KAAK,CAACF,QAAO,IAAK,EAAE;MAAE;MAC5CG,QAAQ,EAAE;IACZ,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,mBAAmBA,CAAA,EAAG;MAC1B,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMT,KAAK,CAACU,IAAI,CAAC,0CAA0C,EAAE;UAC5EP,QAAQ,EAAE,IAAI,CAACA,QAAQ;UACvBG,QAAQ,EAAE,IAAI,CAACA;QACjB,CAAC,CAAC;;QAEF;QACC,IAAI,CAACK,MAAM,CAACC,QAAQ,CAAC,OAAO,EAAE;UAC7BC,IAAI,EAAEJ,QAAQ,CAACP,IAAI,CAACW,IAAI;UACxBC,KAAK,EAAEL,QAAQ,CAACP,IAAI,CAACa;QACvB,CAAC,CAAC;QAEF,MAAM;UAAEF,IAAI;UAAEC;QAAM,IAAIL,QAAQ,CAACP,IAAI;;QAEvC;QACA,IAAI,CAACS,MAAM,CAACC,QAAQ,CAAC,OAAO,EAAE;UAAEC,IAAI;UAAEC;QAAM,CAAC,CAAC;;QAE5C;QACA,IAAI,CAACE,OAAO,CAACC,IAAI,CAAC,OAAO,CAAC;MAC5B,EAAE,OAAOC,KAAK,EAAE;QACd,IAAIA,KAAK,CAACT,QAAQ,EAAEU,MAAK,KAAM,GAAG,EAAE;UAClC;UACA,IAAI,CAACH,OAAO,CAACC,IAAI,CAAC;YAChBG,IAAI,EAAE,iBAAiB;YACvBf,KAAK,EAAE;cAAEF,QAAQ,EAAE,IAAI,CAACA;YAAS;UACnC,CAAC,CAAC;QACJ,OAAO;UACLkB,OAAO,CAACH,KAAK,CAAC,MAAM,EAAEA,KAAK,CAAC;QAC9B;MACF;IACF;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}