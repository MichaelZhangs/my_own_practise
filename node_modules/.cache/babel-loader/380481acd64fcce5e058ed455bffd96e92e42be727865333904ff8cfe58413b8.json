{"ast":null,"code":"import { computed, ref } from 'vue';\nimport { useStore } from 'vuex';\nimport defaultAvatar from '@/assets/default-avatar.png';\nimport defaultqrcode from '@/assets/logo.png';\nimport QRCode from 'qrcode';\nexport default {\n  name: 'UserDetail',\n  setup() {\n    const store = useStore();\n\n    // 从 Vuex 中获取用户信息\n    const user = computed(() => store.state.user);\n\n    // 二维码 URL\n    const qrcodeUrl = ref('');\n\n    // 生成二维码\n    const generateQrcode = async () => {\n      try {\n        const content = `用户名: ${user.value.username}\\n手机号: ${user.value.phone}`;\n\n        // 生成二维码\n        const qrCanvas = document.createElement('canvas');\n        await QRCode.toCanvas(qrCanvas, content, {\n          errorCorrectionLevel: 'H',\n          // 高容错率\n          width: 200,\n          // 二维码大小\n          color: {\n            dark: '#07c160',\n            // 二维码颜色（微信绿）\n            light: '#ffffff' // 背景颜色\n          }\n        });\n\n        // 创建头像 canvas\n        const avatarCanvas = document.createElement('canvas');\n        const avatarCtx = avatarCanvas.getContext('2d');\n        const avatarImg = new Image();\n        avatarImg.src = user.value.photo || defaultAvatar;\n\n        // 等待头像加载完成\n        await new Promise(resolve => {\n          avatarImg.onload = resolve;\n        });\n\n        // 设置头像 canvas 大小\n        avatarCanvas.width = 40; // 头像大小\n        avatarCanvas.height = 40;\n        avatarCtx.drawImage(avatarImg, 0, 0, 40, 40);\n\n        // 将头像绘制到二维码中心\n        const qrCtx = qrCanvas.getContext('2d');\n        const center = (qrCanvas.width - 40) / 2;\n        qrCtx.drawImage(avatarCanvas, center, center);\n\n        // 将 canvas 转换为 URL\n        qrcodeUrl.value = qrCanvas.toDataURL();\n      } catch (error) {\n        console.error(\"生成二维码失败\", error);\n      }\n    };\n    return {\n      user,\n      defaultAvatar,\n      defaultqrcode,\n      qrcodeUrl,\n      generateQrcode\n    };\n  }\n};","map":{"version":3,"names":["computed","ref","useStore","defaultAvatar","defaultqrcode","QRCode","name","setup","store","user","state","qrcodeUrl","generateQrcode","content","value","username","phone","qrCanvas","document","createElement","toCanvas","errorCorrectionLevel","width","color","dark","light","avatarCanvas","avatarCtx","getContext","avatarImg","Image","src","photo","Promise","resolve","onload","height","drawImage","qrCtx","center","toDataURL","error","console"],"sources":["E:\\vue_learn\\ai_vue\\ai_vue\\src\\views\\UserDetail.vue"],"sourcesContent":["<template>\r\n    <div class=\"user-detail-page\">\r\n      <h1>用户详情</h1>\r\n      <div class=\"user-detail-container\">\r\n        <!-- 用户信息 -->\r\n        <div class=\"info-section\">\r\n          <!-- 头像 -->\r\n          <div class=\"avatar-section\">\r\n            <img :src=\"user?.photo || defaultAvatar\" alt=\"头像\" class=\"avatar\" />\r\n          </div>\r\n  \r\n          <!-- 用户信息 -->\r\n          <div class=\"info-item\">\r\n            <label>名字：</label>\r\n            <span>{{ user?.username || \"未设置\" }}</span>\r\n          </div>\r\n          <div class=\"info-item\">\r\n            <label>性别：</label>\r\n            <span>{{ user?.sex || \"未设置\" }}</span>\r\n          </div>\r\n          <div class=\"info-item\">\r\n            <label>手机号：</label>\r\n            <span>{{ user?.phone || \"未设置\" }}</span>\r\n          </div>\r\n          <div class=\"info-item\">\r\n            <label>邮箱：</label>\r\n            <span>{{ user?.email || \"未设置\" }}</span>\r\n          </div>\r\n          <div class=\"info-item\">\r\n            <label>描述：</label>\r\n            <span>{{ user?.description || \"未设置\" }}</span>\r\n          </div>\r\n  \r\n          <!-- 二维码 -->\r\n          <div class=\"qr-code-section\">\r\n            <h2 @click=\"generateQrcode\">我的二维码</h2>\r\n            <div class=\"qr-code-container\">\r\n              <img :src=\"qrcodeUrl || defaultqrcode\" alt=\"我的二维码\" class=\"qr-code\" />\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import { computed, ref } from 'vue';\r\n  import { useStore } from 'vuex';\r\n  import defaultAvatar from '@/assets/default-avatar.png';\r\n  import defaultqrcode from '@/assets/logo.png';\r\n  import QRCode from 'qrcode';\r\n  \r\n  export default {\r\n    name: 'UserDetail',\r\n    setup() {\r\n      const store = useStore();\r\n  \r\n      // 从 Vuex 中获取用户信息\r\n      const user = computed(() => store.state.user);\r\n  \r\n      // 二维码 URL\r\n      const qrcodeUrl = ref('');\r\n  \r\n      // 生成二维码\r\n      const generateQrcode = async () => {\r\n        try {\r\n          const content = `用户名: ${user.value.username}\\n手机号: ${user.value.phone}`;\r\n  \r\n          // 生成二维码\r\n          const qrCanvas = document.createElement('canvas');\r\n          await QRCode.toCanvas(qrCanvas, content, {\r\n            errorCorrectionLevel: 'H', // 高容错率\r\n            width: 200, // 二维码大小\r\n            color: {\r\n              dark: '#07c160', // 二维码颜色（微信绿）\r\n              light: '#ffffff', // 背景颜色\r\n            },\r\n          });\r\n  \r\n          // 创建头像 canvas\r\n          const avatarCanvas = document.createElement('canvas');\r\n          const avatarCtx = avatarCanvas.getContext('2d');\r\n          const avatarImg = new Image();\r\n          avatarImg.src = user.value.photo || defaultAvatar;\r\n  \r\n          // 等待头像加载完成\r\n          await new Promise((resolve) => {\r\n            avatarImg.onload = resolve;\r\n          });\r\n  \r\n          // 设置头像 canvas 大小\r\n          avatarCanvas.width = 40; // 头像大小\r\n          avatarCanvas.height = 40;\r\n          avatarCtx.drawImage(avatarImg, 0, 0, 40, 40);\r\n  \r\n          // 将头像绘制到二维码中心\r\n          const qrCtx = qrCanvas.getContext('2d');\r\n          const center = (qrCanvas.width - 40) / 2;\r\n          qrCtx.drawImage(avatarCanvas, center, center);\r\n  \r\n          // 将 canvas 转换为 URL\r\n          qrcodeUrl.value = qrCanvas.toDataURL();\r\n        } catch (error) {\r\n          console.error(\"生成二维码失败\", error);\r\n        }\r\n      };\r\n  \r\n      return {\r\n        user,\r\n        defaultAvatar,\r\n        defaultqrcode,\r\n        qrcodeUrl,\r\n        generateQrcode,\r\n      };\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .user-detail-page {\r\n    padding: 20px;\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center; /* 整体内容居中 */\r\n  }\r\n  \r\n  h1 {\r\n    font-size: 24px;\r\n    margin-bottom: 20px;\r\n    text-align: center;\r\n  }\r\n  \r\n  .user-detail-container {\r\n    max-width: 800px; /* 限制容器宽度 */\r\n    width: 100%;\r\n    display: flex;\r\n    justify-content: center; /* 内容居中 */\r\n  }\r\n  \r\n  .info-section {\r\n    width: 100%;\r\n    max-width: 500px; /* 限制信息区域宽度 */\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: flex-start; /* 左对齐 */\r\n    gap: 15px; /* 信息项间距 */\r\n  }\r\n  \r\n  .avatar-section {\r\n    display: flex;\r\n    justify-content: center;\r\n    width: 100%;\r\n    margin-bottom: 20px;\r\n  }\r\n  \r\n  .avatar {\r\n    width: 100px;\r\n    height: 100px;\r\n    border-radius: 50%;\r\n  }\r\n  \r\n  .info-item {\r\n    display: flex;\r\n    align-items: center;\r\n    width: 100%;\r\n  }\r\n  \r\n  .info-item label {\r\n    font-weight: bold;\r\n    width: 80px;\r\n    text-align: left; /* 标签左对齐 */\r\n    margin-right: 10px;\r\n  }\r\n  \r\n  .info-item span {\r\n    flex: 1;\r\n    padding: 5px;\r\n    border: 1px solid transparent; /* 保持对齐 */\r\n    border-radius: 4px;\r\n  }\r\n  \r\n  .qr-code-section {\r\n    width: 100%;\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: flex-start; /* 左对齐 */\r\n    margin-top: 20px;\r\n  }\r\n  \r\n  .qr-code-section h2 {\r\n    cursor: pointer; /* 点击区域 */\r\n    color: #1890ff;\r\n    margin-bottom: 10px;\r\n  }\r\n  \r\n  .qr-code-section h2:hover {\r\n    text-decoration: underline;\r\n  }\r\n  \r\n  .qr-code-container {\r\n    display: flex;\r\n    justify-content: flex-start; /* 左对齐 */\r\n    align-items: center;\r\n  }\r\n  \r\n  .qr-code {\r\n    width: 200px; /* 二维码大小 */\r\n    height: 200px;\r\n    border: 5px solid #07c160; /* 微信二维码样式 */\r\n    border-radius: 10px;\r\n  }\r\n  </style>"],"mappings":"AA8CE,SAASA,QAAQ,EAAEC,GAAE,QAAS,KAAK;AACnC,SAASC,QAAO,QAAS,MAAM;AAC/B,OAAOC,aAAY,MAAO,6BAA6B;AACvD,OAAOC,aAAY,MAAO,mBAAmB;AAC7C,OAAOC,MAAK,MAAO,QAAQ;AAE3B,eAAe;EACbC,IAAI,EAAE,YAAY;EAClBC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIN,QAAQ,CAAC,CAAC;;IAExB;IACA,MAAMO,IAAG,GAAIT,QAAQ,CAAC,MAAMQ,KAAK,CAACE,KAAK,CAACD,IAAI,CAAC;;IAE7C;IACA,MAAME,SAAQ,GAAIV,GAAG,CAAC,EAAE,CAAC;;IAEzB;IACA,MAAMW,cAAa,GAAI,MAAAA,CAAA,KAAY;MACjC,IAAI;QACF,MAAMC,OAAM,GAAI,QAAQJ,IAAI,CAACK,KAAK,CAACC,QAAQ,UAAUN,IAAI,CAACK,KAAK,CAACE,KAAK,EAAE;;QAEvE;QACA,MAAMC,QAAO,GAAIC,QAAQ,CAACC,aAAa,CAAC,QAAQ,CAAC;QACjD,MAAMd,MAAM,CAACe,QAAQ,CAACH,QAAQ,EAAEJ,OAAO,EAAE;UACvCQ,oBAAoB,EAAE,GAAG;UAAE;UAC3BC,KAAK,EAAE,GAAG;UAAE;UACZC,KAAK,EAAE;YACLC,IAAI,EAAE,SAAS;YAAE;YACjBC,KAAK,EAAE,SAAS,CAAE;UACpB;QACF,CAAC,CAAC;;QAEF;QACA,MAAMC,YAAW,GAAIR,QAAQ,CAACC,aAAa,CAAC,QAAQ,CAAC;QACrD,MAAMQ,SAAQ,GAAID,YAAY,CAACE,UAAU,CAAC,IAAI,CAAC;QAC/C,MAAMC,SAAQ,GAAI,IAAIC,KAAK,CAAC,CAAC;QAC7BD,SAAS,CAACE,GAAE,GAAItB,IAAI,CAACK,KAAK,CAACkB,KAAI,IAAK7B,aAAa;;QAEjD;QACA,MAAM,IAAI8B,OAAO,CAAEC,OAAO,IAAK;UAC7BL,SAAS,CAACM,MAAK,GAAID,OAAO;QAC5B,CAAC,CAAC;;QAEF;QACAR,YAAY,CAACJ,KAAI,GAAI,EAAE,EAAE;QACzBI,YAAY,CAACU,MAAK,GAAI,EAAE;QACxBT,SAAS,CAACU,SAAS,CAACR,SAAS,EAAE,CAAC,EAAE,CAAC,EAAE,EAAE,EAAE,EAAE,CAAC;;QAE5C;QACA,MAAMS,KAAI,GAAIrB,QAAQ,CAACW,UAAU,CAAC,IAAI,CAAC;QACvC,MAAMW,MAAK,GAAI,CAACtB,QAAQ,CAACK,KAAI,GAAI,EAAE,IAAI,CAAC;QACxCgB,KAAK,CAACD,SAAS,CAACX,YAAY,EAAEa,MAAM,EAAEA,MAAM,CAAC;;QAE7C;QACA5B,SAAS,CAACG,KAAI,GAAIG,QAAQ,CAACuB,SAAS,CAAC,CAAC;MACxC,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,SAAS,EAAEA,KAAK,CAAC;MACjC;IACF,CAAC;IAED,OAAO;MACLhC,IAAI;MACJN,aAAa;MACbC,aAAa;MACbO,SAAS;MACTC;IACF,CAAC;EACH;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}