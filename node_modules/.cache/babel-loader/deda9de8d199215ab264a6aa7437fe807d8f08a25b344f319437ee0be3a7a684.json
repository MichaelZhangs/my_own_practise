{"ast":null,"code":"import { ref, computed } from 'vue';\nexport default {\n  setup() {\n    const loginMethod = ref('password'); // 'password' 或 'code'\n    const username = ref('');\n    const password = ref('');\n    const phone = ref('');\n    const code = ref('');\n    const countdown = ref(0);\n    const isCodeButtonDisabled = computed(() => countdown.value > 0);\n    const codeButtonText = computed(() => {\n      return countdown.value > 0 ? `${countdown.value}s后重新发送` : '发送验证码';\n    });\n    const switchLoginMethod = method => {\n      loginMethod.value = method;\n    };\n    const sendCode = () => {\n      if (isCodeButtonDisabled.value) return;\n\n      // 模拟发送验证码\n      console.log('发送验证码到:', phone.value);\n\n      // 开始倒计时\n      countdown.value = 60;\n      const timer = setInterval(() => {\n        countdown.value--;\n        if (countdown.value <= 0) {\n          clearInterval(timer);\n        }\n      }, 1000);\n    };\n    const handleLogin = () => {\n      if (loginMethod.value === 'password') {\n        console.log('密码登录:', username.value, password.value);\n      } else {\n        console.log('验证码登录:', phone.value, code.value);\n      }\n    };\n    return {\n      loginMethod,\n      username,\n      password,\n      phone,\n      code,\n      isCodeButtonDisabled,\n      codeButtonText,\n      switchLoginMethod,\n      sendCode,\n      handleLogin\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","setup","loginMethod","username","password","phone","code","countdown","isCodeButtonDisabled","value","codeButtonText","switchLoginMethod","method","sendCode","console","log","timer","setInterval","clearInterval","handleLogin"],"sources":["E:\\vue_learn\\ai_vue\\ai_vue\\src\\components\\UserLogin.vue"],"sourcesContent":["<template>\r\n  <div class=\"login-container\">\r\n    <h2>用户登录</h2>\r\n    <div class=\"login-method\">\r\n      <button @click=\"switchLoginMethod('password')\" :class=\"{ active: loginMethod === 'password' }\">密码登录</button>\r\n      <button @click=\"switchLoginMethod('code')\" :class=\"{ active: loginMethod === 'code' }\">验证码登录</button>\r\n    </div>\r\n\r\n    <form @submit.prevent=\"handleLogin\">\r\n      <div v-if=\"loginMethod === 'password'\" class=\"form-group\">\r\n        <label for=\"username\">用户名</label>\r\n        <input type=\"text\" id=\"username\" v-model=\"username\" required />\r\n      </div>\r\n\r\n      <div v-if=\"loginMethod === 'password'\" class=\"form-group\">\r\n        <label for=\"password\">密码</label>\r\n        <input type=\"password\" id=\"password\" v-model=\"password\" required />\r\n      </div>\r\n\r\n      <div v-if=\"loginMethod === 'code'\" class=\"form-group\">\r\n        <label for=\"phone\">手机号</label>\r\n        <input type=\"text\" id=\"phone\" v-model=\"phone\" required />\r\n      </div>\r\n\r\n      <div v-if=\"loginMethod === 'code'\" class=\"form-group\">\r\n        <label for=\"code\">验证码</label>\r\n        <input type=\"text\" id=\"code\" v-model=\"code\" required />\r\n        <button type=\"button\" @click=\"sendCode\" :disabled=\"isCodeButtonDisabled\">\r\n          {{ codeButtonText }}\r\n        </button>\r\n      </div>\r\n\r\n      <button type=\"submit\">登录</button>\r\n    </form>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed } from 'vue';\r\n\r\nexport default {\r\n  setup() {\r\n    const loginMethod = ref('password'); // 'password' 或 'code'\r\n    const username = ref('');\r\n    const password = ref('');\r\n    const phone = ref('');\r\n    const code = ref('');\r\n    const countdown = ref(0);\r\n    const isCodeButtonDisabled = computed(() => countdown.value > 0);\r\n\r\n    const codeButtonText = computed(() => {\r\n      return countdown.value > 0 ? `${countdown.value}s后重新发送` : '发送验证码';\r\n    });\r\n\r\n    const switchLoginMethod = (method) => {\r\n      loginMethod.value = method;\r\n    };\r\n\r\n    const sendCode = () => {\r\n      if (isCodeButtonDisabled.value) return;\r\n\r\n      // 模拟发送验证码\r\n      console.log('发送验证码到:', phone.value);\r\n\r\n      // 开始倒计时\r\n      countdown.value = 60;\r\n      const timer = setInterval(() => {\r\n        countdown.value--;\r\n        if (countdown.value <= 0) {\r\n          clearInterval(timer);\r\n        }\r\n      }, 1000);\r\n    };\r\n\r\n    const handleLogin = () => {\r\n      if (loginMethod.value === 'password') {\r\n        console.log('密码登录:', username.value, password.value);\r\n      } else {\r\n        console.log('验证码登录:', phone.value, code.value);\r\n      }\r\n    };\r\n\r\n    return {\r\n      loginMethod,\r\n      username,\r\n      password,\r\n      phone,\r\n      code,\r\n      isCodeButtonDisabled,\r\n      codeButtonText,\r\n      switchLoginMethod,\r\n      sendCode,\r\n      handleLogin,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.login-container {\r\n  max-width: 400px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n  border: 1px solid #ccc;\r\n  border-radius: 5px;\r\n}\r\n\r\n.login-method button {\r\n  margin-right: 10px;\r\n  padding: 5px 10px;\r\n  cursor: pointer;\r\n}\r\n\r\n.login-method button.active {\r\n  background-color: #007bff;\r\n  color: white;\r\n}\r\n\r\n.form-group {\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.form-group label {\r\n  display: block;\r\n  margin-bottom: 5px;\r\n}\r\n\r\n.form-group input {\r\n  width: 100%;\r\n  padding: 8px;\r\n  box-sizing: border-box;\r\n}\r\n\r\nbutton[disabled] {\r\n  background-color: #ccc;\r\n  cursor: not-allowed;\r\n}\r\n</style>"],"mappings":"AAsCA,SAASA,GAAG,EAAEC,QAAO,QAAS,KAAK;AAEnC,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,WAAU,GAAIH,GAAG,CAAC,UAAU,CAAC,EAAE;IACrC,MAAMI,QAAO,GAAIJ,GAAG,CAAC,EAAE,CAAC;IACxB,MAAMK,QAAO,GAAIL,GAAG,CAAC,EAAE,CAAC;IACxB,MAAMM,KAAI,GAAIN,GAAG,CAAC,EAAE,CAAC;IACrB,MAAMO,IAAG,GAAIP,GAAG,CAAC,EAAE,CAAC;IACpB,MAAMQ,SAAQ,GAAIR,GAAG,CAAC,CAAC,CAAC;IACxB,MAAMS,oBAAmB,GAAIR,QAAQ,CAAC,MAAMO,SAAS,CAACE,KAAI,GAAI,CAAC,CAAC;IAEhE,MAAMC,cAAa,GAAIV,QAAQ,CAAC,MAAM;MACpC,OAAOO,SAAS,CAACE,KAAI,GAAI,IAAI,GAAGF,SAAS,CAACE,KAAK,QAAO,GAAI,OAAO;IACnE,CAAC,CAAC;IAEF,MAAME,iBAAgB,GAAKC,MAAM,IAAK;MACpCV,WAAW,CAACO,KAAI,GAAIG,MAAM;IAC5B,CAAC;IAED,MAAMC,QAAO,GAAIA,CAAA,KAAM;MACrB,IAAIL,oBAAoB,CAACC,KAAK,EAAE;;MAEhC;MACAK,OAAO,CAACC,GAAG,CAAC,SAAS,EAAEV,KAAK,CAACI,KAAK,CAAC;;MAEnC;MACAF,SAAS,CAACE,KAAI,GAAI,EAAE;MACpB,MAAMO,KAAI,GAAIC,WAAW,CAAC,MAAM;QAC9BV,SAAS,CAACE,KAAK,EAAE;QACjB,IAAIF,SAAS,CAACE,KAAI,IAAK,CAAC,EAAE;UACxBS,aAAa,CAACF,KAAK,CAAC;QACtB;MACF,CAAC,EAAE,IAAI,CAAC;IACV,CAAC;IAED,MAAMG,WAAU,GAAIA,CAAA,KAAM;MACxB,IAAIjB,WAAW,CAACO,KAAI,KAAM,UAAU,EAAE;QACpCK,OAAO,CAACC,GAAG,CAAC,OAAO,EAAEZ,QAAQ,CAACM,KAAK,EAAEL,QAAQ,CAACK,KAAK,CAAC;MACtD,OAAO;QACLK,OAAO,CAACC,GAAG,CAAC,QAAQ,EAAEV,KAAK,CAACI,KAAK,EAAEH,IAAI,CAACG,KAAK,CAAC;MAChD;IACF,CAAC;IAED,OAAO;MACLP,WAAW;MACXC,QAAQ;MACRC,QAAQ;MACRC,KAAK;MACLC,IAAI;MACJE,oBAAoB;MACpBE,cAAc;MACdC,iBAAiB;MACjBE,QAAQ;MACRM;IACF,CAAC;EACH;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}