{"ast":null,"code":"import { ref, nextTick } from 'vue';\nimport { useStore } from 'vuex';\nimport QRCode from 'qrcode';\nimport defaultAvatar from '@/assets/default-avatar.png';\nimport defaultQR from '@/assets/logo.png';\nexport default {\n  __name: 'UserDetail',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const store = useStore();\n\n    // 响应式数据\n    const editableUser = ref({\n      ...store.state.user,\n      description: store.state.user.description || ''\n    });\n    const qrcodeUrl = ref(defaultQR);\n    const isPhoneEditable = ref(false);\n    const phoneInput = ref(null);\n\n    // 启用手机号编辑\n    const enablePhoneEdit = async () => {\n      isPhoneEditable.value = true;\n      await nextTick();\n      phoneInput.value.focus();\n    };\n\n    // 头像上传处理\n    const handleAvatarUpload = event => {\n      const file = event.target.files?.[0];\n      if (file && file.type.startsWith('image/')) {\n        const reader = new FileReader();\n        reader.onload = e => {\n          editableUser.value.photo = e.target.result;\n        };\n        reader.readAsDataURL(file);\n      }\n    };\n\n    // 生成带头像的二维码\n    const generateQRWithAvatar = async () => {\n      try {\n        const userData = {\n          name: editableUser.value.username,\n          phone: editableUser.value.phone,\n          email: editableUser.value.email,\n          description: editableUser.value.description\n        };\n\n        // 生成基础二维码\n        const canvas = document.createElement('canvas');\n        await QRCode.toCanvas(canvas, JSON.stringify(userData), {\n          width: 200,\n          margin: 2,\n          color: {\n            dark: '#07c160',\n            light: '#ffffff'\n          },\n          errorCorrectionLevel: 'H'\n        });\n\n        // 添加圆形头像\n        const ctx = canvas.getContext('2d');\n        const avatarImg = new Image();\n        avatarImg.src = editableUser.value.photo || defaultAvatar;\n        await new Promise(resolve => {\n          avatarImg.onload = resolve;\n          avatarImg.onerror = resolve;\n        });\n        ctx.beginPath();\n        ctx.arc(100, 100, 25, 0, Math.PI * 2);\n        ctx.clip();\n        ctx.drawImage(avatarImg, 75, 75, 50, 50);\n        qrcodeUrl.value = canvas.toDataURL();\n      } catch (error) {\n        console.error('二维码生成失败:', error);\n        alert('二维码生成失败，请重试');\n      }\n    };\n\n    // 保存用户信息\n    const saveUserInfo = async () => {\n      try {\n        await store.dispatch('updateUser', editableUser.value);\n        isPhoneEditable.value = false; // 保存后关闭编辑状态\n        alert('信息保存成功!');\n      } catch (error) {\n        console.error('保存失败:', error);\n        alert('保存失败，请检查网络后重试');\n      }\n    };\n    const __returned__ = {\n      store,\n      editableUser,\n      qrcodeUrl,\n      isPhoneEditable,\n      phoneInput,\n      enablePhoneEdit,\n      handleAvatarUpload,\n      generateQRWithAvatar,\n      saveUserInfo,\n      ref,\n      nextTick,\n      get useStore() {\n        return useStore;\n      },\n      get QRCode() {\n        return QRCode;\n      },\n      get defaultAvatar() {\n        return defaultAvatar;\n      },\n      get defaultQR() {\n        return defaultQR;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","nextTick","useStore","QRCode","defaultAvatar","defaultQR","store","editableUser","state","user","description","qrcodeUrl","isPhoneEditable","phoneInput","enablePhoneEdit","value","focus","handleAvatarUpload","event","file","target","files","type","startsWith","reader","FileReader","onload","e","photo","result","readAsDataURL","generateQRWithAvatar","userData","name","username","phone","email","canvas","document","createElement","toCanvas","JSON","stringify","width","margin","color","dark","light","errorCorrectionLevel","ctx","getContext","avatarImg","Image","src","Promise","resolve","onerror","beginPath","arc","Math","PI","clip","drawImage","toDataURL","error","console","alert","saveUserInfo","dispatch"],"sources":["E:/vue_learn/ai_vue/ai_vue/src/views/UserDetail.vue"],"sourcesContent":["<template>\r\n    <div class=\"user-detail-page\">\r\n      <h1 class=\"page-title\">用户详情</h1>\r\n      <div class=\"user-container\">\r\n        <!-- 头像部分 -->\r\n        <div class=\"avatar-wrapper\">\r\n          <label class=\"avatar-upload\">\r\n            <input \r\n              type=\"file\" \r\n              accept=\"image/*\" \r\n              @change=\"handleAvatarUpload\" \r\n              hidden\r\n            />\r\n            <img \r\n              :src=\"editableUser.photo || defaultAvatar\" \r\n              alt=\"用户头像\" \r\n              class=\"user-avatar\"\r\n            />\r\n            <span class=\"edit-tip\">点击更换头像</span>\r\n          </label>\r\n        </div>\r\n  \r\n        <!-- 用户信息编辑 -->\r\n        <div class=\"info-section\">\r\n          <div class=\"info-item\">\r\n            <label>姓名：</label>\r\n            <input v-model=\"editableUser.username\" class=\"short-input\" />\r\n          </div>\r\n          \r\n          <div class=\"info-item\">\r\n            <label>性别：</label>\r\n            <select v-model=\"editableUser.sex\">\r\n              <option value=\"男\">男</option>\r\n              <option value=\"女\">女</option>\r\n            </select>\r\n          </div>\r\n  \r\n          <div class=\"info-item\">\r\n            <label>手机：</label>\r\n            <input\r\n              v-model=\"editableUser.phone\"\r\n              :readonly=\"!isPhoneEditable\"\r\n              class=\"short-input\"\r\n              @dblclick=\"enablePhoneEdit\"\r\n              ref=\"phoneInput\"\r\n            />\r\n            <span v-if=\"!isPhoneEditable\" class=\"edit-hint\">(双击编辑)</span>\r\n          </div>\r\n  \r\n          <div class=\"info-item\">\r\n            <label>邮箱：</label>\r\n            <input v-model=\"editableUser.email\" class=\"short-input\" />\r\n          </div>\r\n  \r\n          <div class=\"info-item\">\r\n            <label>描述：</label>\r\n            <input v-model=\"editableUser.description\" class=\"short-input\" />\r\n          </div>\r\n  \r\n          <!-- 二维码展示 -->\r\n          <div class=\"info-item\">\r\n            <label>我的二维码：</label>\r\n            <div class=\"qr-wrapper\" @click=\"generateQRWithAvatar\">\r\n              <img \r\n                :src=\"qrcodeUrl || defaultQR\" \r\n                alt=\"个人二维码\" \r\n                class=\"wechat-qr\"\r\n              />\r\n            </div>\r\n          </div>\r\n        </div>\r\n  \r\n        <!-- 保存按钮 -->\r\n        <button class=\"save-btn\" @click=\"saveUserInfo\">保存修改</button>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script setup>\r\n  import { ref, nextTick } from 'vue'\r\n  import { useStore } from 'vuex'\r\n  import QRCode from 'qrcode'\r\n  import defaultAvatar from '@/assets/default-avatar.png'\r\n  import defaultQR from '@/assets/logo.png'\r\n  \r\n  const store = useStore()\r\n  \r\n  // 响应式数据\r\n  const editableUser = ref({\r\n    ...store.state.user,\r\n    description: store.state.user.description || ''\r\n  })\r\n  const qrcodeUrl = ref(defaultQR)\r\n  const isPhoneEditable = ref(false)\r\n  const phoneInput = ref(null)\r\n  \r\n  // 启用手机号编辑\r\n  const enablePhoneEdit = async () => {\r\n    isPhoneEditable.value = true\r\n    await nextTick()\r\n    phoneInput.value.focus()\r\n  }\r\n  \r\n  // 头像上传处理\r\n  const handleAvatarUpload = (event) => {\r\n    const file = event.target.files?.[0]\r\n    if (file && file.type.startsWith('image/')) {\r\n      const reader = new FileReader()\r\n      reader.onload = (e) => {\r\n        editableUser.value.photo = e.target.result\r\n      }\r\n      reader.readAsDataURL(file)\r\n    }\r\n  }\r\n  \r\n  // 生成带头像的二维码\r\n  const generateQRWithAvatar = async () => {\r\n    try {\r\n      const userData = {\r\n        name: editableUser.value.username,\r\n        phone: editableUser.value.phone,\r\n        email: editableUser.value.email,\r\n        description: editableUser.value.description\r\n      }\r\n  \r\n      // 生成基础二维码\r\n      const canvas = document.createElement('canvas')\r\n      await QRCode.toCanvas(canvas, JSON.stringify(userData), {\r\n        width: 200,\r\n        margin: 2,\r\n        color: {\r\n          dark: '#07c160',\r\n          light: '#ffffff'\r\n        },\r\n        errorCorrectionLevel: 'H'\r\n      })\r\n  \r\n      // 添加圆形头像\r\n      const ctx = canvas.getContext('2d')\r\n      const avatarImg = new Image()\r\n      avatarImg.src = editableUser.value.photo || defaultAvatar\r\n      \r\n      await new Promise((resolve) => {\r\n        avatarImg.onload = resolve\r\n        avatarImg.onerror = resolve\r\n      })\r\n  \r\n      ctx.beginPath()\r\n      ctx.arc(100, 100, 25, 0, Math.PI * 2)\r\n      ctx.clip()\r\n      ctx.drawImage(avatarImg, 75, 75, 50, 50)\r\n  \r\n      qrcodeUrl.value = canvas.toDataURL()\r\n    } catch (error) {\r\n      console.error('二维码生成失败:', error)\r\n      alert('二维码生成失败，请重试')\r\n    }\r\n  }\r\n  \r\n  // 保存用户信息\r\n  const saveUserInfo = async () => {\r\n    try {\r\n      await store.dispatch('updateUser', editableUser.value)\r\n      isPhoneEditable.value = false // 保存后关闭编辑状态\r\n      alert('信息保存成功!')\r\n    } catch (error) {\r\n      console.error('保存失败:', error)\r\n      alert('保存失败，请检查网络后重试')\r\n    }\r\n  }\r\n  </script>\r\n  \r\n  <style scoped>\r\n  /* 新增手机号编辑提示样式 */\r\n  .edit-hint {\r\n    color: #999;\r\n    font-size: 0.8rem;\r\n    margin-left: 0.5rem;\r\n    vertical-align: middle;\r\n  }\r\n  \r\n  /* 手机号输入框只读状态样式 */\r\n  input:read-only {\r\n    background-color: #f5f5f5;\r\n    cursor: not-allowed;\r\n    border-color: #eee;\r\n  }\r\n  \r\n  /* 其他样式保持原有实现... */\r\n  </style>"],"mappings":"AA+EE,SAASA,GAAG,EAAEC,QAAQ,QAAQ,KAAK;AACnC,SAASC,QAAQ,QAAQ,MAAM;AAC/B,OAAOC,MAAM,MAAM,QAAQ;AAC3B,OAAOC,aAAa,MAAM,6BAA6B;AA