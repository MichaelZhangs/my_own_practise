{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport { ref, onMounted, computed } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { useStore } from 'vuex';\nimport axios from 'axios';\nimport DOMPurify from 'dompurify';\nimport defaultAvatar from '@/assets/default-avatar.png';\nimport { API_CONFIG } from '@/config/config';\nimport { ElMessage } from 'element-plus';\nexport default {\n  setup() {\n    const router = useRouter();\n    const store = useStore();\n\n    // 状态管理\n    const currentTab = ref('published'); // 默认显示\"我发布的\"\n    const myMoments = ref([]);\n    const likedMoments = ref([]);\n    const loading = ref(false);\n    const hasMore = ref(true);\n    const page = ref(1);\n\n    // 用户信息\n    const currentUser = computed(() => store.state.user || {});\n\n    // 工具方法\n    const getFullUrl = path => {\n      if (!path || path === defaultAvatar) return path;\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`;\n    };\n    const formatTime = timestamp => {\n      const date = new Date(timestamp);\n      return `${date.getFullYear()}-${(date.getMonth() + 1).toString().padStart(2, '0')}-` + `${date.getDate().toString().padStart(2, '0')} ` + `${date.getHours().toString().padStart(2, '0')}:` + `${date.getMinutes().toString().padStart(2, '0')}`;\n    };\n    const sanitizeHtml = html => DOMPurify.sanitize(html);\n    const openImagePreview = url => {\n      window.open(url, '_blank');\n    };\n\n    // 切换选项卡\n    const switchTab = tab => {\n      if (currentTab.value !== tab) {\n        currentTab.value = tab;\n        page.value = 1;\n        if (tab === 'published' && !myMoments.value.length) {\n          fetchMyMoments();\n        } else if (tab === 'liked' && !likedMoments.value.length) {\n          fetchLikedMoments();\n        }\n      }\n    };\n\n    // 获取我发布的内容\n    const fetchMyMoments = async () => {\n      if (loading.value || !hasMore.value) return;\n      loading.value = true;\n      try {\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/user/${currentUser.value.id}/moments`, {\n          params: {\n            page: page.value,\n            limit: 10\n          },\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        });\n        const newMoments = response.data.moments || [];\n        if (page.value === 1) {\n          myMoments.value = newMoments;\n        } else {\n          myMoments.value = [...myMoments.value, ...newMoments];\n        }\n        hasMore.value = newMoments.length >= 10;\n        page.value += 1;\n      } catch (error) {\n        console.error('获取我的动态失败:', error);\n        ElMessage.error('加载内容失败');\n      } finally {\n        loading.value = false;\n      }\n    };\n\n    // 获取我喜欢的内容\n    const fetchLikedMoments = async () => {\n      if (loading.value || !hasMore.value) return;\n      loading.value = true;\n      try {\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/user/${currentUser.value.id}/liked_moments`, {\n          params: {\n            page: page.value,\n            limit: 10\n          },\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        });\n        const newMoments = response.data.moments || [];\n        if (page.value === 1) {\n          likedMoments.value = newMoments;\n        } else {\n          likedMoments.value = [...likedMoments.value, ...newMoments];\n        }\n        hasMore.value = newMoments.length >= 10;\n        page.value += 1;\n      } catch (error) {\n        console.error('获取我喜欢的动态失败:', error);\n        ElMessage.error('加载内容失败');\n      } finally {\n        loading.value = false;\n      }\n    };\n\n    // 点赞/取消点赞\n    const toggleLike = async momentId => {\n      try {\n        const response = await axios.post(`${API_CONFIG.BASE_URL}/article/like`, {\n          moment_id: momentId,\n          user_id: currentUser.value.id\n        }, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        });\n        if (response.data.success) {\n          // 更新本地状态\n          if (currentTab.value === 'published') {\n            const momentIndex = myMoments.value.findIndex(m => m.id === momentId);\n            if (momentIndex !== -1) {\n              myMoments.value[momentIndex].isLiked = !myMoments.value[momentIndex].isLiked;\n              myMoments.value[momentIndex].stats.likes += myMoments.value[momentIndex].isLiked ? 1 : -1;\n            }\n          } else if (currentTab.value === 'liked') {\n            const momentIndex = likedMoments.value.findIndex(m => m.id === momentId);\n            if (momentIndex !== -1) {\n              likedMoments.value[momentIndex].isLiked = !likedMoments.value[momentIndex].isLiked;\n              likedMoments.value[momentIndex].stats.likes += likedMoments.value[momentIndex].isLiked ? 1 : -1;\n\n              // 如果取消点赞，从列表中移除\n              if (!likedMoments.value[momentIndex].isLiked) {\n                likedMoments.value.splice(momentIndex, 1);\n              }\n            }\n          }\n          ElMessage.success(response.data.message);\n        }\n      } catch (error) {\n        console.error('点赞操作失败:', error);\n        ElMessage.error('操作失败');\n      }\n    };\n\n    // 删除动态\n    const deleteMoment = async momentId => {\n      ElMessage.confirm('确定要删除这条动态吗？', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(async () => {\n        try {\n          await axios.delete(`${API_CONFIG.BASE_URL}/article/${momentId}`, {\n            headers: {\n              Authorization: `Bearer ${store.state.token}`\n            }\n          });\n\n          // 更新本地状态\n          myMoments.value = myMoments.value.filter(m => m.id !== momentId);\n          ElMessage.success('删除成功');\n        } catch (error) {\n          console.error('删除动态失败:', error);\n          ElMessage.error('删除失败');\n        }\n      }).catch(() => {\n        // 取消操作\n      });\n    };\n\n    // 导航相关\n    const goToPublish = () => {\n      router.push('/publish');\n    };\n    const goToExplore = () => {\n      router.push('/explore');\n    };\n    const goToMomentDetail = momentId => {\n      router.push(`/moment/${momentId}`);\n    };\n\n    // 滚动加载更多\n    const handleScroll = () => {\n      const {\n        scrollTop,\n        scrollHeight,\n        clientHeight\n      } = document.documentElement;\n      if (scrollTop + clientHeight >= scrollHeight - 200 && !loading.value && hasMore.value) {\n        if (currentTab.value === 'published') {\n          fetchMyMoments();\n        } else if (currentTab.value === 'liked') {\n          fetchLikedMoments();\n        }\n      }\n    };\n\n    // 生命周期钩子\n    onMounted(() => {\n      fetchMyMoments();\n      window.addEventListener('scroll', handleScroll);\n    });\n    return {\n      currentTab,\n      myMoments,\n      likedMoments,\n      loading,\n      hasMore,\n      currentUser,\n      defaultAvatar,\n      switchTab,\n      getFullUrl,\n      formatTime,\n      sanitizeHtml,\n      openImagePreview,\n      toggleLike,\n      deleteMoment,\n      goToPublish,\n      goToExplore,\n      goToMomentDetail\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","computed","useRouter","useStore","axios","DOMPurify","defaultAvatar","API_CONFIG","ElMessage","setup","router","store","currentTab","myMoments","likedMoments","loading","hasMore","page","currentUser","state","user","getFullUrl","path","startsWith","BASE_URL","formatTime","timestamp","date","Date","getFullYear","getMonth","toString","padStart","getDate","getHours","getMinutes","sanitizeHtml","html","sanitize","openImagePreview","url","window","open","switchTab","tab","value","length","fetchMyMoments","fetchLikedMoments","response","get","id","params","limit","headers","Authorization","token","newMoments","data","moments","error","console","toggleLike","momentId","post","moment_id","user_id","success","momentIndex","findIndex","m","isLiked","stats","likes","splice","message","deleteMoment","confirm","confirmButtonText","cancelButtonText","type","then","delete","filter","catch","goToPublish","push","goToExplore","goToMomentDetail","handleScroll","scrollTop","scrollHeight","clientHeight","document","documentElement","addEventListener"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\views\\UserPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"user-moments-page\">\r\n    <!-- 顶部导航 -->\r\n    <div class=\"page-header\">\r\n      <div class=\"header-title\">我的动态</div>\r\n      <div class=\"tab-buttons\">\r\n        <el-button \r\n          :class=\"{ 'active': currentTab === 'published' }\"\r\n          @click=\"switchTab('published')\"\r\n        >\r\n          我发布的\r\n        </el-button>\r\n        <el-button \r\n          :class=\"{ 'active': currentTab === 'liked' }\"\r\n          @click=\"switchTab('liked')\"\r\n        >\r\n          我喜欢的\r\n        </el-button>\r\n      </div>\r\n    </div>\r\n    \r\n    <!-- 内容区域 -->\r\n    <div class=\"content-container\">\r\n      <!-- 我发布的内容 -->\r\n      <div v-if=\"currentTab === 'published'\" class=\"moments-list\">\r\n        <div \r\n          v-for=\"moment in myMoments\" \r\n          :key=\"moment.id\" \r\n          class=\"moment-card\"\r\n        >\r\n          <!-- 动态内容 -->\r\n          <div class=\"moment-content\">\r\n            <div class=\"user-info\">\r\n              <img \r\n                :src=\"getFullUrl(moment.user.photo) || defaultAvatar\" \r\n                class=\"user-avatar\" \r\n                alt=\"用户头像\"\r\n              >\r\n              <div class=\"user-details\">\r\n                <div class=\"username\">{{ moment.user.username }}</div>\r\n                <div class=\"post-time\">{{ formatTime(moment.created_at) }}</div>\r\n              </div>\r\n            </div>\r\n            \r\n            <div class=\"content-text\" v-html=\"sanitizeHtml(moment.content)\"></div>\r\n            \r\n            <!-- 媒体内容 -->\r\n            <div v-if=\"moment.media?.length\" class=\"media-grid\">\r\n              <div \r\n                v-for=\"(media, index) in moment.media\" \r\n                :key=\"index\" \r\n                class=\"media-item\"\r\n              >\r\n                <img \r\n                  v-if=\"media.type === 'image'\" \r\n                  :src=\"getFullUrl(media.url)\" \r\n                  alt=\"动态图片\"\r\n                  @click=\"openImagePreview(getFullUrl(media.url))\"\r\n                >\r\n                <video \r\n                  v-else \r\n                  :src=\"getFullUrl(media.url)\" \r\n                  controls \r\n                  muted \r\n                  :poster=\"getFullUrl(media.thumbnail)\"\r\n                  alt=\"动态视频\"\r\n                ></video>\r\n              </div>\r\n            </div>\r\n            \r\n            <!-- 互动区域 -->\r\n            <div class=\"interaction-area\">\r\n              <div class=\"like-button\" @click=\"toggleLike(moment.id)\">\r\n                <i \r\n                  class=\"fa-solid fa-thumbs-up\" \r\n                  :class=\"{ 'liked': moment.isLiked }\"\r\n                ></i>\r\n                <span>{{ moment.stats.likes }}</span>\r\n              </div>\r\n              <div class=\"comment-button\" @click=\"goToMomentDetail(moment.id)\">\r\n                <i class=\"fa-solid fa-comment\"></i>\r\n                <span>{{ moment.stats.comments }}</span>\r\n              </div>\r\n              <div class=\"delete-button\" @click=\"deleteMoment(moment.id)\">\r\n                <i class=\"fa-solid fa-trash-can\"></i>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        \r\n        <!-- 加载状态 -->\r\n        <div v-if=\"loading && !myMoments.length\" class=\"loading-placeholder\">\r\n          <el-skeleton :count=\"3\" animated></el-skeleton>\r\n        </div>\r\n        \r\n        <!-- 空状态 -->\r\n        <div v-else-if=\"!myMoments.length && !loading\" class=\"default-avatar\">\r\n          <img src=\"@/assets/default-avatar.png\" alt=\"暂无内容\" class=\"empty-image\">\r\n          <p class=\"empty-text\">还没有发布任何内容</p>\r\n          <el-button type=\"primary\" @click=\"goToPublish\">发布动态</el-button>\r\n        </div>\r\n        \r\n        <!-- 加载更多 -->\r\n        <div v-if=\"myMoments.length && hasMore && loading\" class=\"loading-more\">\r\n          <el-loading v-model=\"loading\" text=\"加载中...\"></el-loading>\r\n        </div>\r\n        \r\n        <!-- 没有更多 -->\r\n        <div v-if=\"myMoments.length && !hasMore\" class=\"no-more-content\">\r\n          <span>没有更多内容了</span>\r\n        </div>\r\n      </div>\r\n      \r\n      <!-- 我喜欢的内容 -->\r\n      <div v-if=\"currentTab === 'liked'\" class=\"liked-moments-list\">\r\n        <div \r\n          v-for=\"moment in likedMoments\" \r\n          :key=\"moment.id\" \r\n          class=\"liked-moment-card\"\r\n        >\r\n          <!-- 动态内容 -->\r\n          <div class=\"moment-content\">\r\n            <div class=\"user-info\">\r\n              <img \r\n                :src=\"getFullUrl(moment.user.photo) || defaultAvatar\" \r\n                class=\"user-avatar\" \r\n                alt=\"用户头像\"\r\n              >\r\n              <div class=\"user-details\">\r\n                <div class=\"username\">{{ moment.user.username }}</div>\r\n                <div class=\"post-time\">{{ formatTime(moment.created_at) }}</div>\r\n              </div>\r\n            </div>\r\n            \r\n            <div class=\"content-text\" v-html=\"sanitizeHtml(moment.content)\"></div>\r\n            \r\n            <!-- 媒体内容 -->\r\n            <div v-if=\"moment.media?.length\" class=\"media-grid\">\r\n              <div \r\n                v-for=\"(media, index) in moment.media\" \r\n                :key=\"index\" \r\n                class=\"media-item\"\r\n              >\r\n                <img \r\n                  v-if=\"media.type === 'image'\" \r\n                  :src=\"getFullUrl(media.url)\" \r\n                  alt=\"动态图片\"\r\n                  @click=\"openImagePreview(getFullUrl(media.url))\"\r\n                >\r\n                <video \r\n                  v-else \r\n                  :src=\"getFullUrl(media.url)\" \r\n                  controls \r\n                  muted \r\n                  :poster=\"getFullUrl(media.thumbnail)\"\r\n                  alt=\"动态视频\"\r\n                ></video>\r\n              </div>\r\n            </div>\r\n            \r\n            <!-- 互动区域 -->\r\n            <div class=\"interaction-area\">\r\n              <div class=\"like-button\" @click=\"toggleLike(moment.id)\">\r\n                <i \r\n                  class=\"fa-solid fa-thumbs-up liked\" \r\n                ></i>\r\n                <span>{{ moment.stats.likes }}</span>\r\n              </div>\r\n              <div class=\"comment-button\" @click=\"goToMomentDetail(moment.id)\">\r\n                <i class=\"fa-solid fa-comment\"></i>\r\n                <span>{{ moment.stats.comments }}</span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        \r\n        <!-- 加载状态 -->\r\n        <div v-if=\"loading && !likedMoments.length\" class=\"loading-placeholder\">\r\n          <el-skeleton :count=\"3\" animated></el-skeleton>\r\n        </div>\r\n        \r\n        <!-- 空状态 -->\r\n        <div v-else-if=\"!likedMoments.length && !loading\" class=\"empty-state\">\r\n          <img src=\"@/assets/empty-liked.png\" alt=\"暂无喜欢内容\" class=\"empty-image\">\r\n          <p class=\"empty-text\">还没有喜欢任何内容</p>\r\n          <p class=\"empty-hint\">去发现喜欢的内容吧</p>\r\n          <el-button type=\"primary\" @click=\"goToExplore\">去探索</el-button>\r\n        </div>\r\n        \r\n        <!-- 加载更多 -->\r\n        <div v-if=\"likedMoments.length && hasMore && loading\" class=\"loading-more\">\r\n          <el-loading v-model=\"loading\" text=\"加载中...\"></el-loading>\r\n        </div>\r\n        \r\n        <!-- 没有更多 -->\r\n        <div v-if=\"likedMoments.length && !hasMore\" class=\"no-more-content\">\r\n          <span>没有更多内容了</span>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted, computed } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport { useStore } from 'vuex'\r\nimport axios from 'axios'\r\nimport DOMPurify from 'dompurify'\r\nimport defaultAvatar from '@/assets/default-avatar.png'\r\nimport { API_CONFIG } from '@/config/config'\r\nimport { ElMessage } from 'element-plus'\r\n\r\nexport default {\r\n  setup() {\r\n    const router = useRouter()\r\n    const store = useStore()\r\n    \r\n    // 状态管理\r\n    const currentTab = ref('published') // 默认显示\"我发布的\"\r\n    const myMoments = ref([])\r\n    const likedMoments = ref([])\r\n    const loading = ref(false)\r\n    const hasMore = ref(true)\r\n    const page = ref(1)\r\n    \r\n    // 用户信息\r\n    const currentUser = computed(() => store.state.user || {})\r\n    \r\n    // 工具方法\r\n    const getFullUrl = (path) => {\r\n      if (!path || path === defaultAvatar) return path\r\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`\r\n    }\r\n    \r\n    const formatTime = (timestamp) => {\r\n      const date = new Date(timestamp)\r\n      return `${date.getFullYear()}-${(date.getMonth() + 1).toString().padStart(2, '0')}-` +\r\n             `${date.getDate().toString().padStart(2, '0')} ` +\r\n             `${date.getHours().toString().padStart(2, '0')}:` +\r\n             `${date.getMinutes().toString().padStart(2, '0')}`\r\n    }\r\n    \r\n    const sanitizeHtml = (html) => DOMPurify.sanitize(html)\r\n    \r\n    const openImagePreview = (url) => {\r\n      window.open(url, '_blank')\r\n    }\r\n    \r\n    // 切换选项卡\r\n    const switchTab = (tab) => {\r\n      if (currentTab.value !== tab) {\r\n        currentTab.value = tab\r\n        page.value = 1\r\n        \r\n        if (tab === 'published' && !myMoments.value.length) {\r\n          fetchMyMoments()\r\n        } else if (tab === 'liked' && !likedMoments.value.length) {\r\n          fetchLikedMoments()\r\n        }\r\n      }\r\n    }\r\n    \r\n    // 获取我发布的内容\r\n    const fetchMyMoments = async () => {\r\n      if (loading.value || !hasMore.value) return\r\n      \r\n      loading.value = true\r\n      \r\n      try {\r\n        const response = await axios.get(\r\n          `${API_CONFIG.BASE_URL}/user/${currentUser.value.id}/moments`,\r\n          {\r\n            params: {\r\n              page: page.value,\r\n              limit: 10\r\n            },\r\n            headers: {\r\n              Authorization: `Bearer ${store.state.token}`\r\n            }\r\n          }\r\n        )\r\n        \r\n        const newMoments = response.data.moments || []\r\n        \r\n        if (page.value === 1) {\r\n          myMoments.value = newMoments\r\n        } else {\r\n          myMoments.value = [...myMoments.value, ...newMoments]\r\n        }\r\n        \r\n        hasMore.value = newMoments.length >= 10\r\n        page.value += 1\r\n      } catch (error) {\r\n        console.error('获取我的动态失败:', error)\r\n        ElMessage.error('加载内容失败')\r\n      } finally {\r\n        loading.value = false\r\n      }\r\n    }\r\n    \r\n    // 获取我喜欢的内容\r\n    const fetchLikedMoments = async () => {\r\n      if (loading.value || !hasMore.value) return\r\n      \r\n      loading.value = true\r\n      \r\n      try {\r\n        const response = await axios.get(\r\n          `${API_CONFIG.BASE_URL}/user/${currentUser.value.id}/liked_moments`,\r\n          {\r\n            params: {\r\n              page: page.value,\r\n              limit: 10\r\n            },\r\n            headers: {\r\n              Authorization: `Bearer ${store.state.token}`\r\n            }\r\n          }\r\n        )\r\n        \r\n        const newMoments = response.data.moments || []\r\n        \r\n        if (page.value === 1) {\r\n          likedMoments.value = newMoments\r\n        } else {\r\n          likedMoments.value = [...likedMoments.value, ...newMoments]\r\n        }\r\n        \r\n        hasMore.value = newMoments.length >= 10\r\n        page.value += 1\r\n      } catch (error) {\r\n        console.error('获取我喜欢的动态失败:', error)\r\n        ElMessage.error('加载内容失败')\r\n      } finally {\r\n        loading.value = false\r\n      }\r\n    }\r\n    \r\n    // 点赞/取消点赞\r\n    const toggleLike = async (momentId) => {\r\n      try {\r\n        const response = await axios.post(\r\n          `${API_CONFIG.BASE_URL}/article/like`,\r\n          {\r\n            moment_id: momentId,\r\n            user_id: currentUser.value.id\r\n          },\r\n          {\r\n            headers: {\r\n              Authorization: `Bearer ${store.state.token}`\r\n            }\r\n          }\r\n        )\r\n        \r\n        if (response.data.success) {\r\n          // 更新本地状态\r\n          if (currentTab.value === 'published') {\r\n            const momentIndex = myMoments.value.findIndex(m => m.id === momentId)\r\n            if (momentIndex !== -1) {\r\n              myMoments.value[momentIndex].isLiked = !myMoments.value[momentIndex].isLiked\r\n              myMoments.value[momentIndex].stats.likes += myMoments.value[momentIndex].isLiked ? 1 : -1\r\n            }\r\n          } else if (currentTab.value === 'liked') {\r\n            const momentIndex = likedMoments.value.findIndex(m => m.id === momentId)\r\n            if (momentIndex !== -1) {\r\n              likedMoments.value[momentIndex].isLiked = !likedMoments.value[momentIndex].isLiked\r\n              likedMoments.value[momentIndex].stats.likes += likedMoments.value[momentIndex].isLiked ? 1 : -1\r\n              \r\n              // 如果取消点赞，从列表中移除\r\n              if (!likedMoments.value[momentInd