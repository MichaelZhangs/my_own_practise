ted(() => {\r\n      fetchMyMoments()\r\n      window.addEventListener('scroll', handleScroll)\r\n    })\r\n    \r\n    return {\r\n      currentTab,\r\n      myMoments,\r\n      likedMoments,\r\n      loading,\r\n      hasMore,\r\n      currentUser,\r\n      defaultAvatar,\r\n      switchTab,\r\n      getFullUrl,\r\n      formatTime,\r\n      sanitizeHtml,\r\n      openImagePreview,\r\n      toggleLike,\r\n      deleteMoment,\r\n      goToPublish,\r\n      goToExplore,\r\n      goToMomentDetail\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.user-moments-page {\r\n  padding: 20px;\r\n  max-width: 800px;\r\n  margin: 0 auto;\r\n}\r\n\r\n.page-header {\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.header-title {\r\n  font-size: 24px;\r\n  font-weight: 600;\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.tab-buttons {\r\n  display: flex;\r\n  gap: 10px;\r\n}\r\n\r\n.tab-buttons .el-button {\r\n  padding: 8px 20px;\r\n  border-radius: 20px;\r\n  background-color: #f5f5f5;\r\n  color: #333;\r\n  border: none;\r\n  transition: all 0.3s;\r\n}\r\n\r\n.tab-buttons .el-button.active {\r\n  background-color: #409eff;\r\n  color: white;\r\n}\r\n\r\n.moment-card, .liked-moment-card {\r\n  background-color: white;\r\n  border-radius: 10px;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);\r\n  margin-bottom: 15px;\r\n  overflow: hidden;\r\n  transition: transform 0.2s;\r\n}\r\n\r\n.moment-card:hover, .liked-moment-card:hover {\r\n  transform: translateY(-2px);\r\n}\r\n\r\n.user-info {\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 15px 15px 10px;\r\n}\r\n\r\n.user-avatar {\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 50%;\r\n  margin-right: 12px;\r\n  object-fit: cover;\r\n}\r\n\r\n.username {\r\n  font-weight: 500;\r\n  color: #333;\r\n}\r\n\r\n.post-time {\r\n  font-size: 12px;\r\n  color: #999;\r\n}\r\n\r\n.content-text {\r\n  padding: 0 15px 10px;\r\n  line-height: 1.6;\r\n  color: #333;\r\n}\r\n\r\n.media-grid {\r\n  display: grid;\r\n  grid-template-colu