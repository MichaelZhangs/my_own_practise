, [\"enter\"]))\n  }, null, 544 /* NEED_HYDRATION, NEED_PATCH */), [[_vModelText, $setup.searchKeyword]]), _createElementVNode(\"button\", {\n    class: \"search-button\",\n    onClick: _cache[5] || (_cache[5] = (...args) => $setup.searchUsers && $setup.searchUsers(...args))\n  }, _cache[9] || (_cache[9] = [_createElementVNode(\"i\", {\n    class: \"fa fa-search\",\n    \"aria-hidden\": \"true\"\n  }, null, -1 /* HOISTED */)])), _createElementVNode(\"button\", {\n    class: \"cancel-button\",\n    onClick: _cache[6] || (_cache[6] = (...args) => $setup.toggleSearch && $setup.toggleSearch(...args))\n  }, \" 取消 \")]), _createCommentVNode(\" 搜索结果列表 \"), $setup.isSearching ? (_openBlock(), _createElementBlock(\"div\", _hoisted_12, _cache[10] || (_cache[10] = [_createElementVNode(\"i\", {\n    class: \"fa fa-spinner fa-spin\",\n    \"aria-hidden\": \"true\"\n  }, null, -1 /* HOISTED */), _createTextVNode(\" 搜索中... \")]))) : $setup.searchResults.length > 0 ? (_openBlock(), _createElementBlock(\"div\", _hoisted_13, [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList($setup.searchResults.value.data, user => {\n    return _openBlock(), _createElementBlock(\"div\", {\n      key: user.id,\n      class: \"search-result-item\",\n      onClick: $event => $setup.startChat(user)\n    }, [_createElementVNode(\"img\", {\n      src: $setup.getFullUrl(user.photo) || $setup.defaultAvatar,\n      alt: \"搜索结果头像\",\n      class: \"result-avatar\"\n    }, null, 8 /* PROPS */, _hoisted_15), _createElementVNode(\"div\", _hoisted_16, [_createElementVNode(\"div\", _hoisted_17, _toDisplayString(user.username), 1 /* TEXT */), _createElementVNode(\"div\", _hoisted_18, _toDisplayString(user.phone), 1 /* TEXT */)])], 8 /* PROPS */, _hoisted_14);\n  }), 128 /* KEYED_FRAGMENT */))])) : $setup.searchKeyword && !$setup.isSearching ? (_openBlock(), _createElementBlock(\"div\", _hoisted_19, \" 没有找到匹配的用户 \")) : _createCommentVNode(\"v-if\", true)])) : _createCommentVNode(\"v-if\", true)]), 