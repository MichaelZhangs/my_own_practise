{"ast":null,"code":"import { createCommentVNode as _createCommentVNode, createElementVNode as _createElementVNode, openBlock as _openBlock, createElementBlock as _createElementBlock } from \"vue\";\nconst _hoisted_1 = {\n  class: \"dashboard-container\"\n};\nconst _hoisted_2 = {\n  class: \"charts-row\"\n};\nconst _hoisted_3 = {\n  class: \"chart-wrapper\"\n};\nconst _hoisted_4 = {\n  ref: \"genderChart\",\n  class: \"chart\"\n};\nconst _hoisted_5 = {\n  class: \"chart-wrapper\"\n};\nconst _hoisted_6 = {\n  ref: \"ageChart\",\n  class: \"chart\"\n};\nexport function render(_ctx, _cache, $props, $setup, $data, $options) {\n  return _openBlock(), _createElementBlock(\"div\", _hoisted_1, [_createElementVNode(\"div\", _hoisted_2, [_createCommentVNode(\" 3D立体饼图 \"), _createElementVNode(\"div\", _hoisted_3, [_createElementVNode(\"div\", _hoisted_4, null, 512 /* NEED_PATCH */), _cache[0] || (_cache[0] = _createElementVNode(\"div\", {\n    class: \"chart-title\"\n  }, \"性别比例分布\", -1 /* HOISTED */))]), _createCommentVNode(\" 右侧可以添加其他图表 \"), _createElementVNode(\"div\", _hoisted_5, [_createElementVNode(\"div\", _hoisted_6, null, 512 /* NEED_PATCH */), _cache[1] || (_cache[1] = _createElementVNode(\"div\", {\n    class: \"chart-title\"\n  }, \"年龄分布\", -1 /* HOISTED */))])])]);\n}","map":{"version":3,"names":["class","ref","_createElementBlock","_hoisted_1","_createElementVNode","_hoisted_2","_createCommentVNode","_hoisted_3","_hoisted_4","_hoisted_5","_hoisted_6"],"sources":["E:\\vue_fastapi\\my_vue\\my_vue\\src\\views\\UserDashboard.vue"],"sourcesContent":["<template>\r\n  <div class=\"dashboard-container\">\r\n    <div class=\"charts-row\">\r\n      <!-- 3D立体饼图 -->\r\n      <div class=\"chart-wrapper\">\r\n        <div ref=\"genderChart\" class=\"chart\"></div>\r\n        <div class=\"chart-title\">性别比例分布</div>\r\n      </div>\r\n      \r\n      <!-- 右侧可以添加其他图表 -->\r\n      <div class=\"chart-wrapper\">\r\n        <div ref=\"ageChart\" class=\"chart\"></div>\r\n        <div class=\"chart-title\">年龄分布</div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, onMounted, onUnmounted } from 'vue'\r\nimport * as echarts from 'echarts'\r\nimport 'echarts-gl' // 引入echarts-gl扩展\r\nimport axios from 'axios'\r\nimport { API_CONFIG } from './config';\r\n\r\nconst genderChart = ref(null)\r\nconst ageChart = ref(null)\r\nlet genderChartInstance = null\r\nlet ageChartInstance = null\r\n\r\n// 获取并渲染3D性别分布饼图\r\nconst renderGenderChart = async () => {\r\n  try {\r\n    const response = await axios.get(`${API_CONFIG.BASE_URL}/bigdata/gender-distribution`)\r\n    const data = response.data\r\n    \r\n    genderChartInstance = echarts.init(genderChart.value)\r\n    \r\n    // 3D饼图配置\r\n    const option = {\r\n      tooltip: {\r\n        trigger: 'item',\r\n        formatter: '{a} <br/>{b}: {c} ({d}%)'\r\n      },\r\n      visualMap: {\r\n        show: false,\r\n        min: 0,\r\n        max: Math.max(data.male_count, data.female_count),\r\n        inRange: {\r\n          colorLightness: [0.8, 0.3] // 颜色明暗范围\r\n        }\r\n      },\r\n      series: [\r\n        {\r\n          name: '性别分布',\r\n          type: 'pie',\r\n          radius: '55%',\r\n          roseType: 'radius', // 玫瑰图效果，增加立体感\r\n          itemStyle: {\r\n            color: '#c23531',\r\n            shadowBlur: 20,\r\n            shadowColor: 'rgba(0, 0, 0, 0.5)',\r\n            borderRadius: 5,\r\n            borderWidth: 2,\r\n            borderColor: '#fff'\r\n          },\r\n          label: {\r\n            color: 'rgba(0, 0, 0, 0.8)',\r\n            formatter: '{b|{b}:} {per|{d}%}',\r\n            rich: {\r\n              b: {\r\n                fontSize: 12,\r\n                lineHeight: 20,\r\n                color: '#333'\r\n              },\r\n              per: {\r\n                color: '#333',\r\n                fontSize: 14,\r\n                fontWeight: 'bold',\r\n                padding: [2, 4],\r\n                borderRadius: 4\r\n              }\r\n            }\r\n          },\r\n          labelLine: {\r\n            lineStyle: {\r\n              color: 'rgba(0, 0, 0, 0.3)'\r\n            },\r\n            smooth: 0.2,\r\n            length: 10,\r\n            length2: 20\r\n          },\r\n          data: [\r\n            { \r\n              value: data.male_count, \r\n              name: '男',\r\n              itemStyle: {\r\n                color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\r\n                  { offset: 0, color: '#4b6cb7' }, // 顶部颜色\r\n                  { offset: 1, color: '#182848' }  // 底部颜色\r\n                ])\r\n              }\r\n            },\r\n            { \r\n              value: data.female_count, \r\n              name: '女',\r\n              itemStyle: {\r\n                color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\r\n                  { offset: 0, color: '#f857a6' }, // 顶部颜色\r\n                  { offset: 1, color: '#ff5858' }  // 底部颜色\r\n                ])\r\n              }\r\n            }\r\n          ],\r\n          // 3D效果设置\r\n          animationType: 'scale',\r\n          animationEasing: 'elasticOut',\r\n          animationDelay: function (idx) {\r\n            return Math.random() * 200;\r\n          },\r\n          // 立体阴影效果\r\n          emphasis: {\r\n            itemStyle: {\r\n              shadowBlur: 30,\r\n              shadowOffsetX: 0,\r\n              shadowColor: 'rgba(0, 0, 0, 0.5)'\r\n            },\r\n            label: {\r\n              show: true,\r\n              fontSize: '16',\r\n              fontWeight: 'bold'\r\n            }\r\n          }\r\n        }\r\n      ]\r\n    };\r\n    \r\n    genderChartInstance.setOption(option)\r\n    \r\n  } catch (error) {\r\n    console.error('获取性别分布数据失败:', error)\r\n  }\r\n}\r\n\r\nconst handleResize = () => {\r\n  if (genderChartInstance) genderChartInstance.resize()\r\n  if (ageChartInstance) ageChartInstance.resize()\r\n}\r\n\r\nonMounted(() => {\r\n  renderGenderChart()\r\n  window.addEventListener('resize', handleResize)\r\n})\r\n\r\nonUnmounted(() => {\r\n  window.removeEventListener('resize', handleResize)\r\n  if (genderChartInstance) {\r\n    genderChartInstance.dispose()\r\n    genderChartInstance = null\r\n  }\r\n  if (ageChartInstance) {\r\n    ageChartInstance.dispose()\r\n    ageChartInstance = null\r\n  }\r\n})\r\n</script>\r\n\r\n<style scoped>\r\n.dashboard-container {\r\n  padding: 20px;\r\n}\r\n\r\n.charts-row {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 20px;\r\n  margin-top: 20px;\r\n}\r\n\r\n.chart-wrapper {\r\n  flex: 1;\r\n  min-width: 300px;\r\n  background: #fff;\r\n  border-radius: 8px;\r\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\r\n  padding: 15px;\r\n  transition: all 0.3s ease;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.chart-wrapper:hover {\r\n  box-shadow: 0 4px 16px 0 rgba(0, 0, 0, 0.2);\r\n  transform: translateY(-5px);\r\n}\r\n\r\n.chart {\r\n  width: 100%;\r\n  height: 350px; /* 增加高度以适应3D效果 */\r\n}\r\n\r\n.chart-title {\r\n  text-align: center;\r\n  margin-top: 15px;\r\n  font-size: 16px;\r\n  font-weight: bold;\r\n  color: #333;\r\n  padding: 8px 0;\r\n  background: #f7f7f7;\r\n  border-radius: 4px;\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .charts-row {\r\n    flex-direction: column;\r\n  }\r\n}\r\n</style>"],"mappings":";;EACOA,KAAK,EAAC;AAAqB;;EACzBA,KAAK,EAAC;AAAY;;EAEhBA,KAAK,EAAC;AAAe;;EACnBC,GAAG,EAAC,aAAa;EAACD,KAAK,EAAC;;;EAK1BA,KAAK,EAAC;AAAe;;EACnBC,GAAG,EAAC,UAAU;EAACD,KAAK,EAAC;;;uBAVhCE,mBAAA,CAcM,OAdNC,UAcM,GAbJC,mBAAA,CAYM,OAZNC,UAYM,GAXJC,mBAAA,YAAe,EACfF,mBAAA,CAGM,OAHNG,UAGM,GAFJH,mBAAA,CAA2C,OAA3CI,UAA2C,+B,0BAC3CJ,mBAAA,CAAqC;IAAhCJ,KAAK,EAAC;EAAa,GAAC,QAAM,qB,GAGjCM,mBAAA,gBAAmB,EACnBF,mBAAA,CAGM,OAHNK,UAGM,GAFJL,mBAAA,CAAwC,OAAxCM,UAAwC,+B,0BACxCN,mBAAA,CAAmC;IAA9BJ,KAAK,EAAC;EAAa,GAAC,MAAI,qB","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}