{"ast":null,"code":"import { computed } from 'vue';\nimport { useStore } from 'vuex';\nimport defaultAvatar from '@/assets/default-avatar.png';\nimport defaultqrcode from '@/assets/logo.png';\nexport default {\n  name: 'UserDetail',\n  setup() {\n    const store = useStore();\n\n    // 从 Vuex 中获取用户信息\n    const user = computed(() => store.state.user);\n    return {\n      user,\n      defaultAvatar,\n      defaultqrcode\n    };\n  }\n};","map":{"version":3,"names":["computed","useStore","defaultAvatar","defaultqrcode","name","setup","store","user","state"],"sources":["E:\\vue_learn\\ai_vue\\ai_vue\\src\\views\\UserDetail.vue"],"sourcesContent":["<template>\r\n    <div class=\"user-detail-page\">\r\n      <h1>用户详情</h1>\r\n      <div class=\"user-detail-container\">\r\n        <!-- 头像 -->\r\n        <div class=\"avatar-section\">\r\n          <img :src=\"user?.photo || defaultAvatar\" alt=\"头像\" class=\"avatar\" />\r\n        </div>\r\n  \r\n        <!-- 用户信息 -->\r\n        <div class=\"info-section\">\r\n          <div class=\"info-item\">\r\n            <label>名字：</label>\r\n            <span>{{ user?.username || \"未设置\" }}</span>\r\n          </div>\r\n          <div class=\"info-item\">\r\n            <label>性别：</label>\r\n            <span>{{ user?.sex || \"未设置\" }}</span>\r\n          </div>\r\n          <div class=\"info-item\">\r\n            <label>手机号：</label>\r\n            <span>{{ user?.phone || \"未设置\" }}</span>\r\n          </div>\r\n          <div class=\"info-item\">\r\n            <label>邮箱：</label>\r\n            <span>{{ user?.email || \"未设置\" }}</span>\r\n          </div>\r\n          <div class=\"info-item\">\r\n            <label>描述：</label>\r\n            <span>{{ user?.description || \"未设置\" }}</span>\r\n          </div>\r\n        </div>\r\n  \r\n        <!-- 个人二维码 -->\r\n        <div class=\"qr-code-section\">\r\n          <h2>个人二维码</h2>\r\n          <img :src=\"user?.qrcode || defaultqrcode\" alt=\"个人二维码\" class=\"qr-code\" />\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import { computed } from 'vue';\r\n  import { useStore } from 'vuex';\r\n  import defaultAvatar from '@/assets/default-avatar.png';\r\n  import defaultqrcode from '@/assets/logo.png';\r\n  \r\n  export default {\r\n    name: 'UserDetail',\r\n    setup() {\r\n      const store = useStore();\r\n  \r\n      // 从 Vuex 中获取用户信息\r\n      const user = computed(() => store.state.user);\r\n  \r\n      return {\r\n        user,\r\n        defaultAvatar,\r\n        defaultqrcode,\r\n      };\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .user-detail-page {\r\n    padding: 20px;\r\n  }\r\n  \r\n  h1 {\r\n    font-size: 24px;\r\n    margin-bottom: 20px;\r\n  }\r\n  \r\n  .user-detail-container {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 20px;\r\n  }\r\n  \r\n  .avatar-section {\r\n    display: flex;\r\n    justify-content: center;\r\n  }\r\n  \r\n  .avatar {\r\n    width: 100px;\r\n    height: 100px;\r\n    border-radius: 50%;\r\n  }\r\n  \r\n  .info-section {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 10px;\r\n  }\r\n  \r\n  .info-item {\r\n    display: flex;\r\n    align-items: center;\r\n  }\r\n  \r\n  .info-item label {\r\n    font-weight: bold;\r\n    width: 100px;\r\n  }\r\n  \r\n  .qr-code-section {\r\n    margin-top: 20px;\r\n    text-align: center;\r\n  }\r\n  \r\n  .qr-code {\r\n    width: 200px;\r\n    height: 200px;\r\n    margin-top: 10px;\r\n  }\r\n  </style>"],"mappings":"AA2CE,SAASA,QAAO,QAAS,KAAK;AAC9B,SAASC,QAAO,QAAS,MAAM;AAC/B,OAAOC,aAAY,MAAO,6BAA6B;AACvD,OAAOC,aAAY,MAAO,mBAAmB;AAE7C,eAAe;EACbC,IAAI,EAAE,YAAY;EAClBC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIL,QAAQ,CAAC,CAAC;;IAExB;IACA,MAAMM,IAAG,GAAIP,QAAQ,CAAC,MAAMM,KAAK,CAACE,KAAK,CAACD,IAAI,CAAC;IAE7C,OAAO;MACLA,IAAI;MACJL,aAAa;MACbC;IACF,CAAC;EACH;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}