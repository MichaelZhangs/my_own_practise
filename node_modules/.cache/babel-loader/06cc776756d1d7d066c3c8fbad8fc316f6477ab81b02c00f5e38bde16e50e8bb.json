{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { onMounted } from \"vue\"; // 导入生命周期钩子\nimport { useRouter } from \"vue-router\"; // 导入 useRouter\n\nexport default {\n  name: \"App\",\n  setup() {\n    const router = useRouter(); // 获取路由对象\n\n    // 在组件挂载时检查登录状态\n    onMounted(() => {\n      const token = localStorage.getItem(\"token\"); // 从本地存储中获取 token\n      if (!token) {\n        // 如果未登录，跳转到登录页\n        router.push(\"/login\").then(() => {\n          console.log(\"未登录，跳转到登录页\");\n        }).catch(error => {\n          console.error(\"跳转失败：\", error);\n        });\n      }\n    });\n    return {};\n  }\n};","map":{"version":3,"names":["onMounted","useRouter","name","setup","router","token","localStorage","getItem","push","then","console","log","catch","error"],"sources":["E:\\vue_learn\\ai_vue\\ai_vue\\src\\App.vue"],"sourcesContent":["<!-- <template>\n  <div id=\"app\">\n    <router-view></router-view>\n    <img alt=\"Vue logo\" src=\"./assets/logo.png\">\n    <HelloWorld msg=\"Welcome\"/>\n    <UserLogin />\n  </div>\n</template> -->\n\n<template>\n  <router-view></router-view>\n</template>\n\n<script>\nimport { onMounted } from \"vue\"; // 导入生命周期钩子\nimport { useRouter } from \"vue-router\"; // 导入 useRouter\n\nexport default {\n  name: \"App\",\n  setup() {\n    const router = useRouter(); // 获取路由对象\n\n    // 在组件挂载时检查登录状态\n    onMounted(() => {\n      const token = localStorage.getItem(\"token\"); // 从本地存储中获取 token\n      if (!token) {\n        // 如果未登录，跳转到登录页\n        router.push(\"/login\")\n          .then(() => {\n            console.log(\"未登录，跳转到登录页\");\n          })\n          .catch((error) => {\n            console.error(\"跳转失败：\", error);\n          });\n      }\n    });\n\n    return {};\n  },\n};\n</script>\n\n<style>\n/* 全局样式 */\nbody {\n  margin: 0;\n  font-family: Arial, sans-serif;\n  background-color: #f0f2f5; /* 背景颜色 */\n}\n\n#app {\n  height: 100vh;\n  display: flex;\n  flex-direction: column;\n}\n</style>"],"mappings":";AAcA,SAASA,SAAQ,QAAS,KAAK,EAAE;AACjC,SAASC,SAAQ,QAAS,YAAY,EAAE;;AAExC,eAAe;EACbC,IAAI,EAAE,KAAK;EACXC,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIH,SAAS,CAAC,CAAC,EAAE;;IAE5B;IACAD,SAAS,CAAC,MAAM;MACd,MAAMK,KAAI,GAAIC,YAAY,CAACC,OAAO,CAAC,OAAO,CAAC,EAAE;MAC7C,IAAI,CAACF,KAAK,EAAE;QACV;QACAD,MAAM,CAACI,IAAI,CAAC,QAAQ,EACjBC,IAAI,CAAC,MAAM;UACVC,OAAO,CAACC,GAAG,CAAC,YAAY,CAAC;QAC3B,CAAC,EACAC,KAAK,CAAEC,KAAK,IAAK;UAChBH,OAAO,CAACG,KAAK,CAAC,OAAO,EAAEA,KAAK,CAAC;QAC/B,CAAC,CAAC;MACN;IACF,CAAC,CAAC;IAEF,OAAO,CAAC,CAAC;EACX;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}