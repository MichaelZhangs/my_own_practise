证码是：\")), _createElementVNode(\"strong\", null, _toDisplayString($data.generatedCode), 1 /* TEXT */)]), _createElementVNode(\"button\", {\n    onClick: _cache[13] || (_cache[13] = (...args) => $options.fillCodeAndCloseModal && $options.fillCodeAndCloseModal(...args))\n  }, \"填充验证码并关闭\")])])) : _createCommentVNode(\"v-if\", true)]);\n}","map":{"version":3,"names":["class","key","type","_createElementBlock","_hoisted_1","_createElementVNode","_hoisted_2","onSubmit","_cache","_withModifiers","args","$options","handleLogin","_createCommentVNode","$data","isPasswordLogin","_hoisted_3","$event","loginType","value","disabled","_hoisted_4","_createTextVNode","_hoisted_5","_hoisted_6","phone","placeholder","required","_Fragment","_hoisted_7","email","_hoisted_8","code","onClick","sendCode","isCodeButtonDisabled","codeButtonText","_hoisted_9","_hoisted_10","_hoisted_11","username","onInput","checkUsername","usernameCheckResult","_hoisted_12","_toDisplayString","_hoisted_13","_hoisted_14","password","_hoisted_15","togglePasswordLogin","goToRegisterPage","_hoisted_16","_hoisted_17","loginResult","_hoisted_18","success","_hoisted_19","_hoisted_20","message","showCodeModal","_hoisted_21","_hoisted_22","generatedCode","fillCodeAndCloseModal"],"sources":["E:\\vue_learn\\ai_vue\\ai_vue\\src\\components\\UserLogin.vue"],"sourcesContent":["<template>\r\n  <div class=\"login-wrapper\">\r\n    <div class=\"user-login-container\">\r\n      <h1>用户登录</h1>\r\n      <form @submit.prevent=\"handleLogin\">\r\n        <!-- 登录方式选择，当不是密码登录时显示 -->\r\n        <div v-if=\"!isPasswordLogin\" class=\"login-type\">\r\n          <label>\r\n            <input\r\n              type=\"radio\"\r\n              v-model=\"loginType\"\r\n              value=\"phone\"\r\n              :disabled=\"isPasswordLogin\"\r\n            /> 短信登录\r\n          </label>\r\n          <label>\r\n            <input\r\n              type=\"radio\"\r\n              v-model=\"loginType\"\r\n              value=\"email\"\r\n              :disabled=\"isPasswordLogin\"\r\n            /> 邮箱登录\r\n          </label>\r\n        </div>\r\n\r\n        <!-- 手机号登录，当不是密码登录且选择短信登录时显示 -->\r\n        <div v-if=\"loginType === 'phone' && !isPasswordLogin\" class=\"input-group\">\r\n          <input\r\n            type=\"text\"\r\n            v-model=\"phone\"\r\n            placeholder=\"请输入手机号\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <!-- 邮箱登录，当不是密码登录且选择邮箱登录时显示 -->\r\n        <div v-else-if=\"loginType === 'email' && !isPasswordLogin\" class=\"input-group\">\r\n          <input\r\n            type=\"email\"\r\n            v-model=\"email\"\r\n            placeholder=\"请输入邮箱\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <!-- 验证码输入，当不是密码登录时显示 -->\r\n        <div v-if=\"!isPasswordLogin\" class=\"input-group code-group\">\r\n          <input\r\n            type=\"text\"\r\n            v-model=\"code\"\r\n            placeholder=\"请输入验证码\"\r\n            required\r\n          />\r\n          <button\r\n            type=\"button\"\r\n            @click=\"sendCode\"\r\n            class=\"code-button\"\r\n            :disabled=\"isCodeButtonDisabled\"\r\n          >\r\n            {{ codeButtonText }}\r\n          </button>\r\n        </div>\r\n\r\n        <!-- 密码登录表单 -->\r\n        <div v-if=\"isPasswordLogin\" class=\"password-login-form\">\r\n          <div class=\"input-group\">\r\n            <input\r\n              type=\"text\"\r\n              v-model=\"username\"\r\n              placeholder=\"请输入用户名/手机号/邮箱\"\r\n              required\r\n              @input=\"checkUsername\"\r\n            />\r\n            <span v-if=\"isPasswordLogin && usernameCheckResult!== null\" class=\"check-icon\">\r\n              {{ usernameCheckResult? '✔' : '✖' }}\r\n            </span>\r\n            <p v-if=\"isPasswordLogin && usernameCheckResult === false\" class=\"error-message\">用户不存在</p>\r\n          </div>\r\n          <div class=\"input-group\">\r\n            <input\r\n              type=\"password\"\r\n              v-model=\"password\"\r\n              placeholder=\"请输入密码\"\r\n              required\r\n            />\r\n          </div>\r\n          <!-- 验证码登录和注册新用户链接 -->\r\n          <div v-if=\"isPasswordLogin\" class=\"switch-links\">\r\n            <span class=\"switch-login-link\" @click=\"togglePasswordLogin\">验证码登录</span>\r\n            <span class=\"register-link\" @click=\"goToRegisterPage\">注册新用户</span>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- 密码登录链接 -->\r\n        <div class=\"password-login-link\">\r\n          <a @click=\"togglePasswordLogin\">\r\n            {{ isPasswordLogin? \"验证码登录\" : \"密码登录\" }}\r\n          </a>\r\n        </div>\r\n\r\n        <!-- 登录按钮 -->\r\n        <button type=\"submit\" class=\"login-button\">\r\n          {{ isPasswordLogin? \"密码登录\" : \"登录\" }}\r\n        </button>\r\n      </form>\r\n\r\n      <!-- 显示登录结果 -->\r\n      <div v-if=\"loginResult\" class=\"login-result\">\r\n        <p v-if=\"loginResult.success\">登录成功！</p>\r\n        <p v-else>登录失败：{{ loginResult.message }}</p>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 验证码弹窗 -->\r\n    <div v-if=\"showCodeModal\" class=\"modal-overlay\">\r\n      <div class=\"modal-content\">\r\n        <h3>验证码已发送</h3>\r\n        <p>您的验证码是：<strong>{{ generatedCode }}</strong></p>\r\n        <button @click=\"fillCodeAndCloseModal\">填充验证码并关闭</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from \"axios\";\r\n\r\nexport default {\r\n  name: \"UserLogin\",\r\n  data() {\r\n    return {\r\n      loginType: \"phone\", // 登录方式：phone 或 email\r\n      phone: \"\", // 手机号\r\n      email: \"\", // 邮箱\r\n      code: \"\", // 验证码\r\n      username: \"\", // 用户名/手机号/邮箱（用于密码登录）\r\n      password: \"\", // 密码（用于密码登录）\r\n      loginResult: null, // 登录结果\r\n      generatedCode: \"\", // 从后端获取的验证码\r\n      showCodeModal: false, // 是否显示验证码弹窗\r\n      isCodeButtonDisabled: false, // 获取验证码按钮是否禁用\r\n      codeButtonText: \"获取验证码\", // 获取验证码按钮文本\r\n      countdown: 0, // 倒计时时间\r\n      isPasswordLogin: false, // 是否使用密码登录\r\n      usernameCheckResult: null // 用户名检查结果\r\n    };\r\n  },\r\n  methods: {\r\n    // 发送验证码\r\n    async sendCode() {\r\n      if (this.loginType === \"phone\" && !this.phone) {\r\n        alert(\"请输入手机号\");\r\n        return;\r\n      }\r\n      if (this.loginType === \"email\" && !this.email) {\r\n        alert(\"请输入邮箱\");\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const username = this.loginType === \"phone\"? this.phone : this.email;\r\n\r\n        // 调用后端接口获取验证码\r\n        const response = await axios.post(\"http://127.0.0.1:8000/api/send-code\", {\r\n          username\r\n        });\r\n\r\n        // 从后端获取验证码\r\n        this.generatedCode = response.data.code;\r\n\r\n        // 显示验证码弹窗\r\n        this.showCodeModal = true;\r\n\r\n        // 启动倒计时\r\n        this.startCountdown();\r\n      } catch (error) {\r\n        console.error(\"验证码请求失败：\", error.response?.data);\r\n        alert(\"验证码发送失败\");\r\n      }\r\n    },\r\n\r\n    // 启动倒计时\r\n    startCountdown() {\r\n      this.isCodeButtonDisabled = true; // 禁用按钮\r\n      this.countdown = 60; // 设置倒计时时间\r\n      const timer = setInterval(() => {\r\n        this.countdown--;\r\n        if (this.countdown <= 0) {\r\n          clearInterval(timer);\r\n          this.isCodeButtonDisabled = false; // 恢复按钮\r\n          this.codeButtonText = \"获取验证码\"; // 恢复按钮文本\r\n        } else {\r\n          this.codeButtonText = `${this.countdown}s后重新获取`; // 更新按钮文本\r\n        }\r\n      }, 1000);\r\n    },\r\n\r\n    // 填充验证码并关闭弹窗\r\n    fillCodeAndCloseModal() {\r\n      this.code = this.generatedCode; // 将验证码填充到输入框\r\n      this.showCodeModal = false; // 关闭弹窗\r\n    },\r\n\r\n    // 处理登录\r\n    async handleLogin() {\r\n      if (this.isPasswordLogin) {\r\n        // 密码登录逻辑\r\n        await this.handlePasswordLogin();\r\n      } else {\r\n        // 验证码登录逻辑\r\n        await this.handleCodeLogin();\r\n      }\r\n    },\r\n\r\n    // 处理验证码登录\r\n    async handleCodeLogin() {\r\n      if (!this.code) {\r\n        alert(\"请输入验证码\");\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const username = this.loginType === \"phone\"? this.phone : this.email;\r\n        const password = this.code;\r\n\r\n        // 调用后端登录接口\r\n        const response = await axios.post(\r\n          \"http://127.0.0.1:8000/api/login\",\r\n          {\r\n            username,\r\n            password\r\n          },\r\n          {\r\n            headers: {\r\n              \"Content-Type\": \"application/json\"\r\n            }\r\n          }\r\n        );\r\n\r\n        // 登录成功\r\n        this.loginResult = {\r\n          success: true,\r\n          message: \"登录成功！\",\r\n          data: response.data\r\n        };\r\n\r\n        // 存储用户信息和 Token 到 Vuex\r\n        this.$store.dispatch(\"login\", {\r\n          user: response.data.user,\r\n          token: response.data.access_token\r\n        });\r\n\r\n        // 跳转到用户页面\r\n        this.$router.push(\"/user\");\r\n      } catch (error) {\r\n        // 登录失败\r\n        this.loginResult = {\r\n          success: false,\r\n          message: error.response?.data?.detail || \"登录失败\"\r\n        };\r\n      }\r\n    },\r\n\r\n    // 处理密码登录\r\n    async handlePasswordLogin() {\r\n      if (!this.username || !this.password) {\r\n        alert(\"请输入用户名和密码\");\r\n        return;\r\n      }\r\n\r\n      try {\r\n        // 先检查用户名是否存在\r\n        const checkResponse = await axios.post(\r\n          \"http://127.0.0.1:8000/api/check-user\",\r\n          {\r\n            username: this.username\r\n          },\r\n          {\r\n            headers: {\r\n              \"Content-Type\": \"application/json\"\r\n            }\r\n          }\r\n        );\r\n        this.usernameCheckResult = checkResponse.data.exists;\r\n        if (!this.usernameCheckResult) {\r\n          return;\r\n        }\r\n\r\n        // 调用后端密码登录接口\r\n        const response = await axios.post(\r\n          \"http://127.0.0.1:8000/api/password-login\",\r\n          {\r\n            username: this.username,\r\n            password: this.password\r\n          },\r\n          {\r\n            headers: {\r\n              \"Content-Type\": \"application/json\"\r\n            }\r\n          }\r\n        );\r\n\r\n        // 登录成功\r\n        this.loginResult = {\r\n          success: true,\r\n          message: \"登录成功！\",\r\n          data: response.data\r\n        };\r\n\r\n        // 存储用户信息和 Token 到 Vuex\r\n        this.$store.dispatch(\"login\", {\r\n          user: response.data.user,\r\n          token: response.data.access_token\r\n        });\r\n\r\n        // 跳转到用户页面\r\n        this.$router.push(\"/user\");\r\n      } catch (error) {\r\n        // 登录失败\r\n        this.loginResult = {\r\n          success: false,\r\n          message: error.response?.data?.detail || \"登录失败\"\r\n        };\r\n      }\r\n    },\r\n\r\n    // 切换密码登录\r\n    togglePasswordLogin() {\r\n      this.isPasswordLogin = !this.isPasswordLogin;\r\n      // 清空验证码登录的输入框\r\n      if (this.isPasswordLogin) {\r\n        this.phone = \"\";\r\n        this.email = \"\";\r\n        this.code = \"\";\r\n        this.usernameCheckResult = null;\r\n      } else {\r\n        this.username = \"\";\r\n        this.password = \"\";\r\n      }\r\n    },\r\n\r\n    // 跳转到注册页面\r\n    goToRegisterPage() {\r\n      this.$router.push(\"/register\");\r\n    },\r\n\r\n    // 检查用户名是否存在\r\n    async checkUsername() {\r\n      if (this.isPasswordLogin && this.username) {\r\n        try {\r\n          const checkResponse = await axios.post(\r\n            \"http://127.0.0.1:8000/api/check-user\",\r\n            {\r\n              username: this.username\r\n            },\r\n            {\r\n              headers: {\r\n                \"Content-Type\": \"application/json\"\r\n              }\r\n            }\r\n          );\r\n          this.usernameCheckResult = checkR