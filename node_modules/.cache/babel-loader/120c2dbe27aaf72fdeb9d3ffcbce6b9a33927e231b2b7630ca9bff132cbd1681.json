"div\", _hoisted_19, _cache[11] || (_cache[11] = [_createElementVNode(\"i\", {\n    class: \"fa fa-exclamation-triangle\",\n    \"aria-hidden\": \"true\"\n  }, null, -1 /* HOISTED */), _createTextVNode(\" 未连接 \")]))) : _createCommentVNode(\"v-if\", true), _createElementVNode(\"div\", _hoisted_20, [_createElementVNode(\"button\", {\n    class: \"tool-button\",\n    onClick: _cache[1] || (_cache[1] = (...args) => $setup.toggleEmojiPicker && $setup.toggleEmojiPicker(...args))\n  }, _cache[12] || (_cache[12] = [_createElementVNode(\"i\", {\n    class: \"fa fa-smile-o\",\n    \"aria-hidden\": \"true\"\n  }, null, -1 /* HOISTED */)])), _createElementVNode(\"label\", _hoisted_21, [_cache[13] || (_cache[13] = _createElementVNode(\"i\", {\n    class: \"fa fa-picture-o\",\n    \"aria-hidden\": \"true\"\n  }, null, -1 /* HOISTED */)), _createElementVNode(\"input\", {\n    type: \"file\",\n    accept: \"image/*\",\n    onChange: _cache[2] || (_cache[2] = (...args) => $setup.handleFileUpload && $setup.handleFileUpload(...args)),\n    ref: \"fileInput\"\n  }, null, 544 /* NEED_HYDRATION, NEED_PATCH */)]), _createElementVNode(\"label\", _hoisted_22, [_cache[14] || (_cache[14] = _createElementVNode(\"i\", {\n    class: \"fa fa-video-camera\",\n    \"aria-hidden\": \"true\"\n  }, null, -1 /* HOISTED */)), _createElementVNode(\"input\", {\n    type: \"file\",\n    accept: \"video/*\",\n    onChange: _cache[3] || (_cache[3] = (...args) => $setup.handleFileUpload && $setup.handleFileUpload(...args))\n  }, null, 32 /* NEED_HYDRATION */)]), _createElementVNode(\"label\", _hoisted_23, [_cache[15] || (_cache[15] = _createElementVNode(\"i\", {\n    class: \"fa fa-file-o\",\n    \"aria-hidden\": \"true\"\n  }, null, -1 /* HOISTED */)), _createElementVNode(\"input\", {\n    type: \"file\",\n    onChange: _cache[4] || (_cache[4] = (...args) => $setup.handleFileUpload && $setup.handleFileUpload(...args))\n  }, null, 32 /* NEED_HYDRATION */)])]), $setup.isUploading.value ? (_openBlock(), _create