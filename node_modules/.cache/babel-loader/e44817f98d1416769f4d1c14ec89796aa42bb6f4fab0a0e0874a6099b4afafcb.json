rnameCheckResult","_hoisted_10","_toDisplayString","_hoisted_11","_hoisted_12","password","switchToCodeLogin","goToRegisterPage","_hoisted_13","loginResult","_hoisted_14","success","_hoisted_15","_hoisted_16","message","showCodeModal","_hoisted_17","_hoisted_18","generatedCode","fillCodeAndCloseModal"],"sources":["E:\\vue_learn\\ai_vue\\ai_vue\\src\\components\\UserLogin.vue"],"sourcesContent":["<template>\r\n  <div class=\"login-wrapper\">\r\n    <div class=\"user-login-container\">\r\n      <h1>用户登录</h1>\r\n      <form @submit.prevent=\"handleLogin\">\r\n        <!-- 登录方式选择 -->\r\n        <div class=\"login-type\">\r\n          <label>\r\n            <input\r\n              type=\"radio\"\r\n              v-model=\"loginType\"\r\n              value=\"password\"\r\n            /> 密码登录\r\n          </label>\r\n          <label>\r\n            <input\r\n              type=\"radio\"\r\n              v-model=\"loginType\"\r\n              value=\"phone\"\r\n            /> 短信登录\r\n          </label>\r\n          <label>\r\n            <input\r\n              type=\"radio\"\r\n              v-model=\"loginType\"\r\n              value=\"email\"\r\n            /> 邮箱登录\r\n          </label>\r\n        </div>\r\n\r\n        <!-- 手机号登录 -->\r\n        <div v-if=\"loginType === 'phone'\" class=\"input-group\">\r\n          <input\r\n            type=\"text\"\r\n            v-model=\"phone\"\r\n            placeholder=\"请输入手机号\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <!-- 邮箱登录 -->\r\n        <div v-if=\"loginType === 'email'\" class=\"input-group\">\r\n          <input\r\n            type=\"email\"\r\n            v-model=\"email\"\r\n            placeholder=\"请输入邮箱\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <!-- 验证码输入 -->\r\n        <div v-if=\"loginType!== 'password'\" class=\"input-group code-group\">\r\n          <input\r\n            type=\"text\"\r\n            v-model=\"code\"\r\n            placeholder=\"请输入验证码\"\r\n            required\r\n          />\r\n          <button\r\n            type=\"button\"\r\n            @click=\"sendCode\"\r\n            class=\"code-button\"\r\n            :disabled=\"isCodeButtonDisabled\"\r\n          >\r\n            {{ codeButtonText }}\r\n          </button>\r\n        </div>\r\n\r\n        <!-- 密码登录表单 -->\r\n        <div v-if=\"loginType === 'password'\" class=\"password-login-form\">\r\n          <div class=\"input-group\">\r\n            <input\r\n              type=\"text\"\r\n              v-model=\"username\"\r\n              placeholder=\"请输入用户名/手机号/邮箱\"\r\n              required\r\n            />\r\n            <span v-if=\"usernameCheckResult!== null\" class=\"check-icon\">\r\n              {{ usernameCheckResult? '✔' : '✖' }}\r\n            </span>\r\n            <p v-if=\"usernameCheckResult === false\" class=\"error-message\">用户不存在</p>\r\n          </div>\r\n          <div class=\"input-group password-input-group\">\r\n            <input\r\n              type=\"password\"\r\n              v-model=\"password\"\r\n              placeholder=\"请输入密码\"\r\n              required\r\n            />\r\n            <span class=\"switch-login-link\" @click=\"switchToCodeLogin\">验证码登录</span>\r\n            <span class=\"register-link\" @click=\"goToRegisterPage\">注册新用户</span>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- 登录按钮 -->\r\n        <button type=\"submit\" class=\"login-button\">\r\n          {{ loginType === 'password'? '密码登录' : '登录' }}\r\n        </button>\r\n      </form>\r\n\r\n      <!-- 显示登录结果 -->\r\n      <div v-if=\"loginResult\" class=\"login-result\">\r\n        <p v-if=\"loginResult.success\">登录成功！</p>\r\n        <p v-else>登录失败：{{ loginResult.message }}</p>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 验证码弹窗 -->\r\n    <div v-if=\"showCodeModal\" class=\"modal-overlay\">\r\n      <div class=\"modal-content\">\r\n        <h3>验证码已发送</h3>\r\n        <p>您的验证码是：<strong>{{ generatedCode }}</strong></p>\r\n        <button @click=\"fillCodeAndCloseModal\">填充验证码并关闭</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from \"axios\";\r\n\r\nexport default {\r\n  name: \"UserLogin\",\r\n  data() {\r\n    return {\r\n      loginType: \"password\",\r\n      phone: \"\",\r\n      email: \"\",\r\n      code: \"\",\r\n      username: \"\",\r\n      password: \"\",\r\n      loginResult: null,\r\n      generatedCode: \"\",\r\n      showCodeModal: false,\r\n      isCodeButtonDisabled: false,\r\n      codeButtonText: \"获取验证码\",\r\n      countdown: 0,\r\n      usernameCheckResult: null\r\n    };\r\n  },\r\n  methods: {\r\n    // 发送验证码\r\n    async sendCode() {\r\n      if (this.loginType === \"phone\" &&!this.phone) {\r\n        alert(\"请输入手机号\");\r\n        return;\r\n      }\r\n      if (this.loginType === \"email\" &&!this.email) {\r\n        alert(\"请输入邮箱\");\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const username = this.loginType === \"phone\"? this.phone : this.email;\r\n        const response = await axios.post(\"http://127.0.0.1:8000/api/send-code\", {\r\n          username\r\n        });\r\n        this.generatedCode = response.data.code;\r\n        this.showCodeModal = true;\r\n        this.startCountdown();\r\n      } catch (error) {\r\n        console.error(\"验证码请求失败：\", error.response?.data);\r\n        alert(\"验证码发送失败\");\r\n      }\r\n    },\r\n\r\n    // 启动倒计时\r\n    startCountdown() {\r\n      this.isCodeButtonDisabled = true;\r\n      this.countdown = 60;\r\n      const timer = setInterval(() => {\r\n        this.countdown--;\r\n        if (this.countdown <= 0) {\r\n          clearInterval(timer);\r\n          this.isCodeButtonDisabled = false;\r\n          this.codeButtonText = \"获取验证码\";\r\n        } else {\r\n          this.codeButtonText = `${this.countdown}s后重新获取`;\r\n        }\r\n      }, 1000);\r\n    },\r\n\r\n    // 填充验证码并关闭弹窗\r\n    fillCodeAndCloseModal() {\r\n      this.code = this.generatedCode;\r\n      this.showCodeModal = false;\r\n    },\r\n\r\n    // 处理登录\r\n    async handleLogin() {\r\n      if (this.loginType === \"password\") {\r\n        await this.handlePasswordLogin();\r\n      } else {\r\n        await this.handleCodeLogin();\r\n      }\r\n    },\r\n\r\n    // 处理验证码登录\r\n    async handleCodeLogin() {\r\n      if (!this.code) {\r\n        alert(\"请输入验证码\");\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const username = this.loginType === \"phone\"? this.phone : this.email;\r\n        const password = this.code;\r\n        const response = await axios.post(\r\n          \"http://127.0.0.1:8000/api/login\",\r\n          {\r\n            username,\r\n            password\r\n          },\r\n          {\r\n            headers: {\r\n              \"Content-Type\": \"application/json\"\r\n            }\r\n          }\r\n        );\r\n        this.loginResult = {\r\n          success: true,\r\n          message: \"登录成功！\",\r\n          data: response.data\r\n        };\r\n        this.$store.dispatch(\"login\", {\r\n          user: response.data.user,\r\n          token: response.data.access_token\r\n        });\r\n        this.$router.push(\"/user\");\r\n      } catch (error) {\r\n        this.loginResult = {\r\n          success: false,\r\n          message: error.response?.data?.detail || \"登录失败\"\r\n        };\r\n      }\r\n    },\r\n\r\n    // 处理密码登录\r\n    async handlePasswordLogin() {\r\n      if (!this.username ||!this.password) {\r\n        alert(\"请输入用户名和密码\");\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const checkResponse = await axios.post(\r\n          \"http://127.0.0.1:8000/api/check-user\",\r\n          {\r\n            username: this.username\r\n          },\r\n          {\r\n            headers: {\r\n              \"Content-Type\": \"application/json\"\r\n            }\r\n          }\r\n        );\r\n        this.usernameCheckResult = checkResponse.data.exists;\r\n        if (!this.usernameCheckResult) {\r\n          return;\r\n        }\r\n\r\n        const response = await axios.post(\r\n          \"http://127.0.0.1:8000/api/password-login\",\r\n          {\r\n            username: this.username,\r\n            password: this.password\r\n          },\r\n          {\r\n            headers: {\r\n              \"Content-Type\": \"application/json\"\r\n            }\r\n          }\r\n        );\r\n        this.loginResult = {\r\n          success: true,\r\n          message: \"登录成功！\",\r\n          data: response.data\r\n        };\r\n        this.$store.dispatch(\"login\", {\r\n          user: response.data.user,\r\n          token: response.data.access_token\r\n        });\r\n        this.$router.push(\"/user\");\r\n      } catch (error) {\r\n        this.loginResult = {\r\n          success: false,\r\n          message: error.response?.data?.detail || \"登录失败\"\r\n        };\r\n      }\r\n    },\r\n\r\n    // 切换到验证码登录\r\n    switchToCodeLogin() {\r\n      this.loginType = \"phone\";\r\n      this.username = \"\";\r\n      this.password = \"\";\r\n    },\r\n\r\n    // 跳转到注册页面\r\n    goToRegisterPage() {\r\n      this.$router.push(\"/register\");\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.login-wrapper {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  height: 100vh;\r\n  background-color: #f5f5f5;\r\n}\r\n\r\n.user-login-container {\r\n  max-width: 400px;\r\n  width: 100%;\r\n  padding: 30px;\r\n  border-radius: 10px;\r\n  background-color: white;\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);\r\n}\r\n\r\nh1 {\r\n  text-align: center;\r\n  color: #333;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.login-type {\r\n  display: flex;\r\n  justify-content: center;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.login-type label {\r\n  margin: 0 10px;\r\n  font-size: 16px;\r\n}\r\n\r\n.input-group {\r\n  margin-bottom: 15px;\r\n  position: relative;\r\n}\r\n\r\n.input-group input {\r\n  width: 100%;\r\n  padding: 10px;\r\n  border: 1px solid #ccc;\r\n  border-radius: 5px;\r\n  font-size: 16px;\r\n}\r\n\r\n.check-icon {\r\n  position: absolute;\r\n  right: 10px;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  font-size: 20px;\r\n}\r\n\r\n.error-message {\r\n  color: red;\r\n  font-size: 12px;\r\n  margin-top: 5px;\r\n}\r\n\r\n.code-group {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.code-group input {\r\n  flex: 1;\r\n  margin-right: 10px;\r\n}\r\n\r\n.code-button {\r\n  padding: 10px 15px;\r\n  background-color: #42b983;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n  font-size: 14px;\r\n}\r\n\r\n.code-button:disabled {\r\n  background-color: #ccc;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.code-button:hover:not(:disabled) {\r\n  background-color: #369f6e;\r\n}\r\n\r\n.password-login-form {\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.password-input-group {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n}\r\n\r\n.switch-login-link,\r\n.register-link {\r\n  font-size: 12px;\r\n  color: #42b983;\r\n  cursor: pointer;\r\n}\r\n\r\n.switch-login-link:hover,\r\n.register-link:hover {\r\n  text-decoration: underline;\r\n}\r\n\r\n.login-button {\r\n  width: 100%;\r\n  padding: 10px;\r\n  background-color: #42b983;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n  font-size: 16px;\r\n}\r\n\r\n.login-button:hover {\r\n  background-color: #369f6e;\r\n}\r\n\r\n.login-result {\r\n  margin-top: 20px;\r\n  text-align: center;\r\n  font-size: 16px;\r\n  color: #333;\r\n}\r\n\r\n.modal-overlay {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background-color: rgba(0, 0, 0, 0.5);\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n\r\n.modal-content {\r\n  background-color: white;\r\n  padding: 20px;\r\n  border-radius: 10px;\r\n  text-align: center;\r\n}\r\n\r\n.modal-content h3 {\r\n  margin-bottom: 10