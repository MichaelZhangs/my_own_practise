{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref } from \"vue\";\nimport { useRouter } from \"vue-router\"; // 导入 useRouter\nimport axios from \"axios\";\nexport default {\n  name: \"UserLogin\",\n  setup() {\n    const router = useRouter(); // 获取路由对象\n\n    const loginType = ref(\"phone\"); // 登录方式：phone 或 email\n    const phone = ref(\"\"); // 手机号\n    const email = ref(\"\"); // 邮箱\n    const code = ref(\"\"); // 验证码\n    const loginResult = ref(null); // 登录结果\n    const generatedCode = ref(\"\"); // 从后端获取的验证码\n    const showCodeModal = ref(false); // 是否显示验证码弹窗\n\n    // 发送验证码\n    const sendCode = async () => {\n      if (loginType.value === \"phone\" && !phone.value) {\n        alert(\"请输入手机号\");\n        return;\n      }\n      if (loginType.value === \"email\" && !email.value) {\n        alert(\"请输入邮箱\");\n        return;\n      }\n      try {\n        const username = loginType.value === \"phone\" ? phone.value : email.value;\n\n        // 打印日志：发送验证码请求\n        console.log(\"发送验证码请求：\", {\n          username\n        });\n\n        // 调用后端接口获取验证码\n        const response = await axios.post(\"http://127.0.0.1:8000/api/send-code\", {\n          username\n        });\n\n        // 打印日志：验证码请求响应\n        console.log(\"验证码请求响应：\", response.data);\n\n        // 从后端获取验证码\n        generatedCode.value = response.data.code;\n\n        // 显示验证码弹窗\n        showCodeModal.value = true;\n      } catch (error) {\n        // 打印日志：验证码请求失败\n        console.error(\"验证码请求失败：\", error.response?.data);\n        alert(\"验证码发送失败\");\n      }\n    };\n\n    // 填充验证码并关闭弹窗\n    const fillCodeAndCloseModal = () => {\n      code.value = generatedCode.value; // 将验证码填充到输入框\n      showCodeModal.value = false; // 关闭弹窗\n    };\n\n    // 处理登录\n    const handleLogin = async () => {\n      if (!code.value) {\n        alert(\"请输入验证码\");\n        return;\n      }\n      try {\n        const username = loginType.value === \"phone\" ? phone.value : email.value;\n        const password = code.value;\n\n        // 打印日志：发送登录请求\n        console.log(\"发送登录请求：\", {\n          username,\n          password\n        });\n\n        // 调用后端登录接口\n        const response = await axios.post(\"http://127.0.0.1:8000/api/login\", {\n          username,\n          password\n        }, {\n          headers: {\n            \"Content-Type\": \"application/json\" // 确保设置正确的 Content-Type\n          }\n        });\n\n        // 打印日志：登录请求响应\n        console.log(\"登录请求响应：\", response.data);\n\n        // 登录成功\n        loginResult.value = {\n          success: true,\n          message: \"登录成功！\",\n          data: response.data\n        };\n\n        // 跳转到用户页面\n        console.log(\"准备跳转到用户页面\");\n        await router.push(\"/user\"); // 使用 await 确保跳转完成\n        console.log(router);\n        console.log(\"跳转成功\");\n      } catch (error) {\n        // 打印日志：登录请求失败\n        console.error(\"登录请求失败：\", error);\n        if (error.response) {\n          console.error(\"响应数据：\", error.response.data);\n          console.error(\"状态码：\", error.response.status);\n          console.error(\"响应头：\", error.response.headers);\n        } else if (error.request) {\n          console.error(\"请求未收到响应：\", error.request);\n        } else {\n          console.error(\"请求配置错误：\", error.config);\n        }\n\n        // 登录失败\n        loginResult.value = {\n          success: false,\n          message: error.response?.data?.detail || \"登录失败\"\n        };\n      }\n    };\n    return {\n      loginType,\n      phone,\n      email,\n      code,\n      loginResult,\n      generatedCode,\n      showCodeModal,\n      sendCode,\n      fillCodeAndCloseModal,\n      handleLogin,\n      router\n    };\n  }\n};","map":{"version":3,"names":["ref","useRouter","axios","name","setup","router","loginType","phone","email","code","loginResult","generatedCode","showCodeModal","sendCode","value","alert","username","console","log","response","post","data","error","fillCodeAndCloseModal","handleLogin","password","headers","success","message","push","status","request","config","detail"],"sources":["E:\\vue_learn\\ai_vue\\ai_vue\\src\\components\\UserLogin.vue"],"sourcesContent":["<template>\r\n  <div class=\"login-wrapper\">\r\n    <div class=\"user-login-container\">\r\n      <h1>用户登录</h1>\r\n      <form @submit.prevent=\"handleLogin\">\r\n        <!-- 登录方式选择 -->\r\n        <div class=\"login-type\">\r\n          <label>\r\n            <input\r\n              type=\"radio\"\r\n              v-model=\"loginType\"\r\n              value=\"phone\"\r\n              checked\r\n            /> 短信登录\r\n          </label>\r\n          <label>\r\n            <input\r\n              type=\"radio\"\r\n              v-model=\"loginType\"\r\n              value=\"email\"\r\n            /> 邮箱登录\r\n          </label>\r\n        </div>\r\n\r\n        <!-- 手机号登录 -->\r\n        <div v-if=\"loginType === 'phone'\" class=\"input-group\">\r\n          <input\r\n            type=\"text\"\r\n            v-model=\"phone\"\r\n            placeholder=\"请输入手机号\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <!-- 邮箱登录 -->\r\n        <div v-else class=\"input-group\">\r\n          <input\r\n            type=\"email\"\r\n            v-model=\"email\"\r\n            placeholder=\"请输入邮箱\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <!-- 验证码输入 -->\r\n        <div class=\"input-group code-group\">\r\n          <input\r\n            type=\"text\"\r\n            v-model=\"code\"\r\n            placeholder=\"请输入验证码\"\r\n            required\r\n          />\r\n          <button type=\"button\" @click=\"sendCode\" class=\"code-button\">\r\n            获取验证码\r\n          </button>\r\n        </div>\r\n\r\n        <!-- 登录按钮 -->\r\n        <button type=\"submit\" class=\"login-button\">登录</button>\r\n      </form>\r\n\r\n      <!-- 显示登录结果 -->\r\n      <div v-if=\"loginResult\" class=\"login-result\">\r\n        <p v-if=\"loginResult.success\">登录成功！</p>\r\n        <p v-else>登录失败：{{ loginResult.message }}</p>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 验证码弹窗 -->\r\n    <div v-if=\"showCodeModal\" class=\"modal-overlay\">\r\n      <div class=\"modal-content\">\r\n        <h3>验证码已发送</h3>\r\n        <p>您的验证码是：<strong>{{ generatedCode }}</strong></p>\r\n        <button @click=\"fillCodeAndCloseModal\">填充验证码并关闭</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref } from \"vue\";\r\nimport { useRouter } from \"vue-router\"; // 导入 useRouter\r\nimport axios from \"axios\";\r\n\r\nexport default {\r\n  name: \"UserLogin\",\r\n  setup() {\r\n    const router = useRouter(); // 获取路由对象\r\n\r\n    const loginType = ref(\"phone\"); // 登录方式：phone 或 email\r\n    const phone = ref(\"\"); // 手机号\r\n    const email = ref(\"\"); // 邮箱\r\n    const code = ref(\"\"); // 验证码\r\n    const loginResult = ref(null); // 登录结果\r\n    const generatedCode = ref(\"\"); // 从后端获取的验证码\r\n    const showCodeModal = ref(false); // 是否显示验证码弹窗\r\n\r\n    // 发送验证码\r\n    const sendCode = async () => {\r\n      if (loginType.value === \"phone\" && !phone.value) {\r\n        alert(\"请输入手机号\");\r\n        return;\r\n      }\r\n      if (loginType.value === \"email\" && !email.value) {\r\n        alert(\"请输入邮箱\");\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const username = loginType.value === \"phone\" ? phone.value : email.value;\r\n\r\n        // 打印日志：发送验证码请求\r\n        console.log(\"发送验证码请求：\", {\r\n          username,\r\n        });\r\n\r\n        // 调用后端接口获取验证码\r\n        const response = await axios.post(\"http://127.0.0.1:8000/api/send-code\", {\r\n          username,\r\n        });\r\n\r\n        // 打印日志：验证码请求响应\r\n        console.log(\"验证码请求响应：\", response.data);\r\n\r\n        // 从后端获取验证码\r\n        generatedCode.value = response.data.code;\r\n\r\n        // 显示验证码弹窗\r\n        showCodeModal.value = true;\r\n      } catch (error) {\r\n        // 打印日志：验证码请求失败\r\n        console.error(\"验证码请求失败：\", error.response?.data);\r\n\r\n        alert(\"验证码发送失败\");\r\n      }\r\n    };\r\n\r\n    // 填充验证码并关闭弹窗\r\n    const fillCodeAndCloseModal = () => {\r\n      code.value = generatedCode.value; // 将验证码填充到输入框\r\n      showCodeModal.value = false; // 关闭弹窗\r\n    };\r\n\r\n    // 处理登录\r\n    const handleLogin = async () => {\r\n      if (!code.value) {\r\n        alert(\"请输入验证码\");\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const username = loginType.value === \"phone\" ? phone.value : email.value;\r\n        const password = code.value;\r\n\r\n        // 打印日志：发送登录请求\r\n        console.log(\"发送登录请求：\", {\r\n          username,\r\n          password,\r\n        });\r\n\r\n        // 调用后端登录接口\r\n        const response = await axios.post(\r\n          \"http://127.0.0.1:8000/api/login\",\r\n          {\r\n            username,\r\n            password,\r\n          },\r\n          {\r\n            headers: {\r\n              \"Content-Type\": \"application/json\", // 确保设置正确的 Content-Type\r\n            },\r\n          }\r\n        );\r\n\r\n        // 打印日志：登录请求响应\r\n        console.log(\"登录请求响应：\", response.data);\r\n\r\n        // 登录成功\r\n        loginResult.value = {\r\n          success: true,\r\n          message: \"登录成功！\",\r\n          data: response.data,\r\n        };\r\n\r\n        // 跳转到用户页面\r\n        console.log(\"准备跳转到用户页面\");\r\n        await router.push(\"/user\"); // 使用 await 确保跳转完成\r\n        console.log(router);\r\n\r\n        console.log(\"跳转成功\");\r\n      } catch (error) {\r\n        // 打印日志：登录请求失败\r\n        console.error(\"登录请求失败：\", error);\r\n\r\n        if (error.response) {\r\n          console.error(\"响应数据：\", error.response.data);\r\n          console.error(\"状态码：\", error.response.status);\r\n          console.error(\"响应头：\", error.response.headers);\r\n        } else if (error.request) {\r\n          console.error(\"请求未收到响应：\", error.request);\r\n        } else {\r\n          console.error(\"请求配置错误：\", error.config);\r\n        }\r\n\r\n        // 登录失败\r\n        loginResult.value = {\r\n          success: false,\r\n          message: error.response?.data?.detail || \"登录失败\",\r\n        };\r\n      }\r\n    };\r\n\r\n    return {\r\n      loginType,\r\n      phone,\r\n      email,\r\n      code,\r\n      loginResult,\r\n      generatedCode,\r\n      showCodeModal,\r\n      sendCode,\r\n      fillCodeAndCloseModal,\r\n      handleLogin,\r\n      router,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.login-wrapper {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  height: 100vh;\r\n  background-color: #f5f5f5; /* 背景颜色 */\r\n}\r\n\r\n.user-login-container {\r\n  max-width: 400px;\r\n  width: 100%;\r\n  padding: 30px;\r\n  border-radius: 10px;\r\n  background-color: white; /* 登录框背景颜色 */\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);\r\n}\r\n\r\nh1 {\r\n  text-align: center;\r\n  color: #333;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.login-type {\r\n  display: flex;\r\n  justify-content: center;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.login-type label {\r\n  margin: 0 10px;\r\n  font-size: 16px;\r\n}\r\n\r\n.input-group {\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.input-group input {\r\n  width: 100%;\r\n  padding: 10px;\r\n  border: 1px solid #ccc;\r\n  border-radius: 5px;\r\n  font-size: 16px;\r\n}\r\n\r\n.code-group {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.code-group input {\r\n  flex: 1;\r\n  margin-right: 10px;\r\n}\r\n\r\n.code-button {\r\n  padding: 10px 15px;\r\n  background-color: #42b983;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n  font-size: 14px;\r\n}\r\n\r\n.code-button:hover {\r\n  background-color: #369f6e;\r\n}\r\n\r\n.login-button {\r\n  width: 100%;\r\n  padding: 10px;\r\n  background-color: #42b983;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n  font-size: 16px;\r\n}\r\n\r\n.login-button:hover {\r\n  background-color: #369f6e;\r\n}\r\n\r\n.login-result {\r\n  margin-top: 20px;\r\n  text-align: center;\r\n  font-size: 16px;\r\n  color: #333;\r\n}\r\n\r\n/* 弹窗样式 */\r\n.modal-overlay {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background-color: rgba(0, 0, 0, 0.5);\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n\r\n.modal-content {\r\n  background-color: white;\r\n  padding: 20px;\r\n  border-radius: 10px;\r\n  text-align: center;\r\n}\r\n\r\n.modal-content h3 {\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.modal-content button {\r\n  margin-top: 10px;\r\n  padding: 10px 20px;\r\n  background-color: #42b983;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n}\r\n\r\n.modal-content button:hover {\r\n  background-color: #369f6e;\r\n}\r\n</style>"],"mappings":";AAgFA,SAASA,GAAE,QAAS,KAAK;AACzB,SAASC,SAAQ,QAAS,YAAY,EAAE;AACxC,OAAOC,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIJ,SAAS,CAAC,CAAC,EAAE;;IAE5B,MAAMK,SAAQ,GAAIN,GAAG,CAAC,OAAO,CAAC,EAAE;IAChC,MAAMO,KAAI,GAAIP,GAAG,CAAC,EAAE,CAAC,EAAE;IACvB,MAAMQ,KAAI,GAAIR,GAAG,CAAC,EAAE,CAAC,EAAE;IACvB,MAAMS,IAAG,GAAIT,GAAG,CAAC,EAAE,CAAC,EAAE;IACtB,MAAMU,WAAU,GAAIV,GAAG,CAAC,IAAI,CAAC,EAAE;IAC/B,MAAMW,aAAY,GAAIX,GAAG,CAAC,EAAE,CAAC,EAAE;IAC/B,MAAMY,aAAY,GAAIZ,GAAG,CAAC,KAAK,CAAC,EAAE;;IAElC;IACA,MAAMa,QAAO,GAAI,MAAAA,CAAA,KAAY;MAC3B,IAAIP,SAAS,CAACQ,KAAI,KAAM,OAAM,IAAK,CAACP,KAAK,CAACO,KAAK,EAAE;QAC/CC,KAAK,CAAC,QAAQ,CAAC;QACf;MACF;MACA,IAAIT,SAAS,CAACQ,KAAI,KAAM,OAAM,IAAK,CAACN,KAAK,CAACM,KAAK,EAAE;QAC/CC,KAAK,CAAC,OAAO,CAAC;QACd;MACF;MAEA,IAAI;QACF,MAAMC,QAAO,GAAIV,SAAS,CAACQ,KAAI,KAAM,OAAM,GAAIP,KAAK,CAACO,KAAI,GAAIN,KAAK,CAACM,KAAK;;QAExE;QACAG,OAAO,CAACC,GAAG,CAAC,UAAU,EAAE;UACtBF;QACF,CAAC,CAAC;;QAEF;QACA,MAAMG,QAAO,GAAI,MAAMjB,KAAK,CAACkB,IAAI,CAAC,qCAAqC,EAAE;UACvEJ;QACF,CAAC,CAAC;;QAEF;QACAC,OAAO,CAACC,GAAG,CAAC,UAAU,EAAEC,QAAQ,CAACE,IAAI,CAAC;;QAEtC;QACAV,aAAa,CAACG,KAAI,GAAIK,QA