{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { computed, ref, onMounted, onUnmounted, nextTick, watch } from 'vue';\nimport { useRoute, useRouter } from 'vue-router';\nimport { useStore } from 'vuex';\nimport defaultAvatar from '@/assets/default-avatar.png';\nimport { API_CONFIG } from '@/config/config';\nimport { ElMessage, ElNotification } from 'element-plus';\nimport axios from 'axios';\nimport CryptoUtils from '@/utils/crypto';\nexport default {\n  setup() {\n    const route = useRoute();\n    const router = useRouter();\n    const store = useStore();\n    const messagesContainer = ref(null);\n    const targetUser = ref({});\n    const messages = ref([]);\n    const inputMessage = ref('');\n    const myAvatar = computed(() => {\n      const user = store.state.user;\n      return user.photo ? `${API_CONFIG.BASE_URL}${user.photo}` : defaultAvatar;\n    });\n    const socket = ref(null);\n    const isConnected = ref(false);\n    const reconnecting = ref(false);\n    const reconnectTimer = ref(null);\n    const myId = computed(() => store.state.user.id);\n    const myUser = computed(() => store.state.user); // 获取当前用户信息\n    const cryptoUtils = new CryptoUtils();\n\n    // 工具方法：处理图片URL\n    const getFullUrl = path => {\n      if (!path) return defaultAvatar;\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`;\n    };\n\n    // 工具方法：格式化时间\n    const formatTime = time => {\n      if (!time) return '';\n      const date = new Date(time);\n      const now = new Date();\n      if (date.toDateString() === now.toDateString()) {\n        return date.toTimeString().substring(0, 5);\n      }\n      const yesterday = new Date();\n      yesterday.setDate(now.getDate() - 1);\n      if (date.toDateString() === yesterday.toDateString()) {\n        return '昨天';\n      }\n      return `${date.getMonth() + 1}/${date.getDate()}`;\n    };\n\n    // 初始化WebSocket连接\n    const initWebSocket = () => {\n      if (myId.value && targetUser.value.id) {\n        const wsUrl = `ws://${API_CONFIG.URL_CHAT}/ws/chat/${myId.value}/${targetUser.value.id}`;\n        if (socket.value) {\n          socket.value.close();\n        }\n        socket.value = new WebSocket(wsUrl);\n        socket.value.onopen = () => {\n          isConnected.value = true;\n          reconnecting.value = false;\n          ElNotification({\n            title: '连接成功',\n            message: `已与 ${targetUser.value.username || '对方'} 建立聊天连接`,\n            type: 'success',\n            duration: 3000\n          });\n\n          // 连接成功后可以尝试加载历史消息\n          loadHistoryMessages();\n        };\n        socket.value.onmessage = async event => {\n          try {\n            const messageData = JSON.parse(event.data);\n            // console.log(\"获取聊天信息： \", messageData)\n            let msg;\n            // 检查是否是加密消息\n            if (messageData.encrypt_data && messageData.publick_key) {\n              // 解密消息\n              msg = await cryptoUtils.decrypt(messageData.encrypt_data, messageData.publick_key);\n            } else {\n              // 非加密消息，直接使用\n              msg = messageData;\n              // console.log(\"普通消息:\", msg);\n            }\n\n            // 处理消息\n            addMessage({\n              id: msg.id,\n              text: msg.text,\n              fromMe: msg.from === myId.value,\n              time: msg.time\n            });\n\n            // 更新最近聊天列表（使用消息中的发送者信息）\n            const senderInfo = {\n              id: parseInt(msg.from, 10),\n              username: msg.fromUsername || '未知用户',\n              photo: msg.fromPhoto\n            };\n            // console.log(\"获取最近聊天 senderInfo: \", senderInfo)\n            store.commit('chat/ADD_RECENT_CHAT', senderInfo);\n            store.dispatch('chat/saveRecentChat');\n          } catch (e) {\n            console.error('解析消息失败', e);\n            ElMessage.error('接收消息失败');\n          }\n        };\n        // socket.value.onmessage = (event) => {\n        //   try {\n        //     const msg = JSON.parse(event.data);\n        //     addMessage({\n        //       id: msg.id,\n        //       text: msg.text,\n        //       fromMe: msg.from === myId.value,\n        //       time: msg.time\n        //     });\n\n        //     // 更新最近聊天列表（使用消息中的发送者信息）\n        //     const senderInfo = {\n        //       id: parseInt(msg.from, 10),\n        //       username: msg.fromUsername || '未知用户',\n        //       photo: msg.fromPhoto\n        //     };\n        //     console.log(\"获取最近聊天 senderInfo: \", senderInfo)\n        //     store.commit('chat/ADD_RECENT_CHAT', senderInfo);\n        //     store.dispatch('chat/saveRecentChat');\n\n        //   } catch (e) {\n        //     console.error('解析消息失败', e);\n        //     ElMessage.error('接收消息失败');\n        //   }\n        // };\n\n        socket.value.onclose = () => {\n          isConnected.value = false;\n          ElNotification({\n            title: '连接断开',\n            message: '聊天连接已断开，正在尝试重连...',\n            type: 'warning',\n            duration: 0\n          });\n          if (!reconnecting.value) {\n            startReconnect();\n          }\n        };\n        socket.value.onerror = errorEvent => {\n          console.error('WebSocket错误', errorEvent);\n          ElMessage.error('聊天连接错误，请稍后再试');\n        };\n      }\n    };\n\n    // 加载历史消息\n\n    const loadHistoryMessages = async () => {\n      if (myId.value && targetUser.value.id) {\n        try {\n          const res = await axios.get(`${API_CONFIG.BASE_URL}/ws/chat/history/${myId.value}/${targetUser.value.id}`, {\n            headers: {\n              Authorization: `Bearer ${store.state.token}`\n            }\n          });\n          if (res.data && res.data.length) {\n            const cryptoUtils = new CryptoUtils();\n            const decryptedMessages = [];\n\n            // 逐个解密历史消息\n            for (const encryptedMsg of res.data) {\n              try {\n                // 解密消息\n                const decryptedMsg = await cryptoUtils.decrypt(encryptedMsg.encrypt_data, encryptedMsg.publick_key);\n                // 转换消息格式以匹配前端期望\n                decryptedMessages.push({\n                  id: decryptedMsg.id,\n                  text: decryptedMsg.text,\n                  fromMe: decryptedMsg.from_id === myId.value,\n                  time: decryptedMsg.created_at\n                });\n              } catch (decryptError) {\n                console.error(\"解密历史消息失败:\", decryptError);\n                // 可以选择跳过解密失败的消息或显示错误信息\n              }\n            }\n\n            // 设置解密后的消息\n            messages.value = decryptedMessages;\n            nextTick(() => {\n              if (messagesContainer.value) {\n                messagesContainer.value.scrollTop = messagesContainer.value.scrollHeight;\n              }\n            });\n          }\n        } catch (err) {\n          console.error('加载历史消息失败', err);\n          ElMessage.warning('历史消息加载失败');\n        }\n      }\n    };\n\n    // 加载历史消息，未加密\n    // const loadHistoryMessages = () => {\n    //   if (myId.value && targetUser.value.id) {\n    //     axios.get(`${API_CONFIG.BASE_URL}/ws/chat/history/${myId.value}/${targetUser.value.id}`, {\n    //       headers: { Authorization: `Bearer ${store.state.token}` }\n    //     })\n    //     .then(res => {\n    //       if (res.data && res.data.length) {\n    //         messages.value = res.data.map(msg => ({\n    //           id: msg.id,\n    //           text: msg.text,\n    //           // 判断消息是否由当前用户发送\n    //           fromMe: msg.from_id === myId.value,\n    //           time: msg.created_at\n    //         }));\n\n    //         nextTick(() => {\n    //           if (messagesContainer.value) {\n    //             messagesContainer.value.scrollTop = messagesContainer.value.scrollHeight;\n    //           }\n    //         });\n    //       }\n    //     })\n    //     .catch(err => {\n    //       console.error('加载历史消息失败', err);\n    //       ElMessage.warning('历史消息加载失败');\n    //     });\n    //   }\n    // };\n\n    // 开始重连\n    const startReconnect = () => {\n      if (reconnecting.value || !targetUser.value.id) return;\n      reconnecting.value = true;\n      reconnectTimer.value = setTimeout(() => {\n        initWebSocket();\n        reconnecting.value = false;\n      }, 3000);\n    };\n\n    // 停止重连\n    const stopReconnect = () => {\n      if (reconnectTimer.value) {\n        clearTimeout(reconnectTimer.value);\n        reconnectTimer.value = null;\n        reconnecting.value = false;\n      }\n    };\n\n    // 添加消息到列表\n    const addMessage = msg => {\n      messages.value.push(msg);\n      nextTick(() => {\n        if (messagesContainer.value) {\n          messagesContainer.value.scrollTop = messagesContainer.value.scrollHeight;\n        }\n      });\n    };\n\n    // 发送消息\n    const sendMessage = () => {\n      // 空内容拦截（强化提示）\n      const content = inputMessage.value.trim();\n      if (!content) {\n        ElMessage.warning('消息内容不能为空，请输入后再发送～');\n        return;\n      }\n      if (!isConnected.value) {\n        ElMessage.warning('当前连接已断开，无法发送消息');\n        return;\n      }\n      const msg = {\n        id: Date.now(),\n        text: inputMessage.value.trim(),\n        fromMe: true,\n        time: new Date().toISOString()\n      };\n      addMessage(msg);\n      inputMessage.value = '';\n      try {\n        // 发送消息时包含fromUsername和fromPhoto\n        socket.value.send(JSON.stringify({\n          id: msg.id,\n          text: msg.text,\n          time: msg.time,\n          from: myId.value,\n          to: targetUser.value.id,\n          fromUsername: myUser.value.username,\n          // 发送者用户名\n          fromPhoto: myUser.value.photo // 发送者头像\n        }));\n      } catch (error) {\n        console.error('发送消息失败', error);\n        ElMessage.error('消息发送失败，请稍后再试');\n      }\n\n      // 更新最近聊天列表\n      store.commit('chat/ADD_RECENT_CHAT', targetUser.value);\n      store.dispatch('chat/saveRecentChat');\n    };\n\n    // 返回上一页\n    const goBack = () => {\n      router.back();\n      stopReconnect();\n      if (socket.value) {\n        socket.value.close();\n      }\n    };\n\n    // 监听路由参数变化\n    watch(() => route.params.userId, newId => {\n      if (newId) {\n        fetchUserInfo(newId);\n      }\n    });\n\n    // 获取用户信息\n    const fetchUserInfo = userId => {\n      axios.get(`${API_CONFIG.BASE_URL}/user/info`, {\n        // 修改URL路径\n        params: {\n          id: userId\n        },\n        // 添加查询参数\n        headers: {\n          Authorization: `Bearer ${store.state.token}`\n        }\n      }).then(res => {\n        if (res.data && res.data.id) {\n          targetUser.value = res.data;\n          initWebSocket();\n        } else {\n          console.error(\"res : \", res.data);\n          throw new Error('用户信息为空');\n        }\n      }).catch(err => {\n        console.log(\"失败： \", userId);\n        console.error('获取用户信息失败', err);\n        ElMessage.error('获取用户信息失败');\n        router.back();\n      });\n    };\n    onMounted(() => {\n      if (route.params.userId) {\n        fetchUserInfo(route.params.userId);\n      } else {\n        ElMessage.error('未指定聊天对象');\n        router.back();\n      }\n    });\n    onUnmounted(() => {\n      stopReconnect();\n      if (socket.value) {\n        socket.value.close();\n      }\n    });\n    return {\n      targetUser,\n      messages,\n      inputMessage,\n      myAvatar,\n      getFullUrl,\n      formatTime,\n      sendMessage,\n      goBack,\n      messagesContainer,\n      isConnected\n    };\n  }\n};","map":{"version":3,"names":["computed","ref","onMounted","onUnmounted","nextTick","watch","useRoute","useRouter","useStore","defaultAvatar","API_CONFIG","ElMessage","ElNotification","axios","CryptoUtils","setup","route","router","store","messagesContainer","targetUser","messages","inputMessage","myAvatar","user","state","photo","BASE_URL","socket","isConnected","reconnecting","reconnectTimer","myId","id","myUser","cryptoUtils","getFullUrl","path","startsWith","formatTime","time","date","Date","now","toDateString","toTimeString","substring","yesterday","setDate","getDate","getMonth","initWebSocket","value","wsUrl","URL_CHAT","close","WebSocket","onopen","title","message","username","type","duration","loadHistoryMessages","onmessage","event","messageData","JSON","parse","data","msg","encrypt_data","publick_key","decrypt","addMessage","text","fromMe","from","senderInfo","parseInt","fromUsername","fromPhoto","commit","dispatch","e","console","error","onclose","startReconnect","onerror","errorEvent","res","get","headers","Authorization","token","length","decryptedMessages","encryptedMsg","decryptedMsg","push","from_id","created_at","decryptError","scrollTop","scrollHeight","err","warning","setTimeout","stopReconnect","clearTimeout","sendMessage","content","trim","toISOString","send","stringify","to","goBack","back","params","userId","newId","fetchUserInfo","then","Error","catch","log"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\views\\ChatView.vue"],"sourcesContent":["<template>\r\n  <div class=\"chat-view\">\r\n    <div class=\"chat-header\">\r\n      <div class=\"back-button\" @click=\"goBack\">\r\n        <i class=\"fa fa-arrow-left\" aria-hidden=\"true\"></i>\r\n      </div>\r\n      <div class=\"chat-title\">{{ targetUser.username || '未知用户' }}</div>\r\n      <div class=\"chat-avatar\">\r\n        <img \r\n          :src=\"getFullUrl(targetUser.photo || defaultAvatar)\" \r\n          alt=\"对方头像\" \r\n          class=\"avatar\" \r\n          onerror=\"this.src='@/assets/default-avatar.png'\"\r\n        />\r\n      </div>\r\n    </div>\r\n    \r\n    <div class=\"chat-messages\" ref=\"messagesContainer\">\r\n      <div v-if=\"messages.length === 0\" class=\"empty-chat\">\r\n        开始和 {{ targetUser.username || '对方' }} 聊天吧\r\n      </div>\r\n      \r\n      <div \r\n        v-for=\"(msg, index) in messages\" \r\n        :key=\"msg.id || index\" \r\n        :class=\"['message-item', msg.fromMe ? 'from-me' : 'from-other']\"\r\n      >\r\n        <div class=\"message-avatar\">\r\n          <img \r\n            :src=\"msg.fromMe ? myAvatar : getFullUrl(targetUser.photo || defaultAvatar)\" \r\n            alt=\"头像\" \r\n            class=\"avatar-sm\" \r\n            onerror=\"this.src='@/assets/default-avatar.png'\"\r\n          />\r\n        </div>\r\n        \r\n        <div class=\"message-content\">\r\n          <div class=\"message-bubble\">{{ msg.text }}</div>\r\n          <div class=\"message-time\">{{ formatTime(msg.time) }}</div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    \r\n    <div class=\"chat-input-area\">\r\n      <div class=\"connection-status\" v-if=\"!isConnected\">\r\n        <i class=\"fa fa-exclamation-triangle\" aria-hidden=\"true\"></i> 未连接\r\n      </div>\r\n      <input \r\n        type=\"text\" \r\n        v-model=\"inputMessage\" \r\n        placeholder=\"输入消息...\" \r\n        @keyup.enter=\"sendMessage\"\r\n        :disabled=\"!isConnected\"\r\n      />\r\n      <button class=\"send-button\" @click=\"sendMessage\" :disabled=\"!isConnected\">\r\n        <i class=\"fa fa-paper-plane\" aria-hidden=\"true\"></i>\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { computed, ref, onMounted, onUnmounted, nextTick, watch } from 'vue';\r\nimport { useRoute, useRouter } from 'vue-router';\r\nimport { useStore } from 'vuex';\r\nimport defaultAvatar from '@/assets/default-avatar.png';\r\nimport { API_CONFIG } from '@/config/config';\r\nimport { ElMessage, ElNotification } from 'element-plus';\r\nimport axios from 'axios';\r\nimport CryptoUtils from '@/utils/crypto';\r\n\r\nexport default {\r\n  setup() {\r\n    const route = useRoute();\r\n    const router = useRouter();\r\n    const store = useStore();\r\n    const messagesContainer = ref(null);\r\n    const targetUser = ref({});\r\n    const messages = ref([]);\r\n    const inputMessage = ref('');\r\n    const myAvatar = computed(() => {\r\n      const user = store.state.user;\r\n      return user.photo ? `${API_CONFIG.BASE_URL}${user.photo}` : defaultAvatar;\r\n    });\r\n    const socket = ref(null);\r\n    const isConnected = ref(false);\r\n    const reconnecting = ref(false);\r\n    const reconnectTimer = ref(null);\r\n    const myId = computed(() => store.state.user.id);\r\n    const myUser = computed(() => store.state.user); // 获取当前用户信息\r\n    const cryptoUtils = new CryptoUtils();\r\n\r\n    // 工具方法：处理图片URL\r\n    const getFullUrl = (path) => {\r\n      if (!path) return defaultAvatar;\r\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`;\r\n    };\r\n    \r\n    // 工具方法：格式化时间\r\n    const formatTime = (time) => {\r\n      if (!time) return '';\r\n      const date = new Date(time);\r\n      const now = new Date();\r\n      \r\n      if (date.toDateString() === now.toDateString()) {\r\n        return date.toTimeString().substring(0, 5);\r\n      }\r\n      \r\n      const yesterday = new Date();\r\n      yesterday.setDate(now.getDate() - 1);\r\n      if (date.toDateString() === yesterday.toDateString()) {\r\n        return '昨天';\r\n      }\r\n      \r\n      return `${date.getMonth() + 1}/${date.getDate()}`;\r\n    };\r\n    \r\n    // 初始化WebSocket连接\r\n    const initWebSocket = () => {\r\n      if (myId.value && targetUser.value.id) {\r\n        const wsUrl = `ws://${API_CONFIG.URL_CHAT}/ws/chat/${myId.value}/${targetUser.value.id}`;\r\n        if (socket.value) {\r\n          socket.value.close();\r\n        }\r\n        \r\n        socket.value = new WebSocket(wsUrl);\r\n       \r\n        socket.value.onopen = () => {\r\n          isConnected.value = true;\r\n          reconnecting.value = false;\r\n          ElNotification({\r\n            title: '连接成功',\r\n            message: `已与 ${targetUser.value.username || '对方'} 建立聊天连接`,\r\n            type: 'success',\r\n            duration: 3000\r\n          });\r\n          \r\n          // 连接成功后可以尝试加载历史消息\r\n          loadHistoryMessages();\r\n        };\r\n        \r\n         socket.value.onmessage = async (event) => {\r\n      try {\r\n        const messageData = JSON.parse(event.data);\r\n        // console.log(\"获取聊天信息： \", messageData)\r\n        let msg;\r\n        // 检查是否是加密消息\r\n        if (messageData.encrypt_data && messageData.publick_key) {\r\n          // 解密消息\r\n          msg = await cryptoUtils.decrypt(\r\n            messageData.encrypt_data,\r\n            messageData.publick_key\r\n          );\r\n        } else {\r\n          // 非加密消息，直接使用\r\n          msg = messageData;\r\n          // console.log(\"普通消息:\", msg);\r\n        }\r\n        \r\n        // 处理消息\r\n        addMessage({\r\n          id: msg.id,\r\n          text: msg.text,\r\n          fromMe: msg.from === myId.value,\r\n          time: msg.time\r\n        });\r\n        \r\n        // 更新最近聊天列表（使用消息中的发送者信息）\r\n        const senderInfo = {\r\n          id: parseInt(msg.from, 10),\r\n          username: msg.fromUsername || '未知用户',\r\n          photo: msg.fromPhoto\r\n        };\r\n        // console.log(\"获取最近聊天 senderInfo: \", senderInfo)\r\n        store.commit('chat/ADD_RECENT_CHAT', senderInfo);\r\n        store.dispatch('chat/saveRecentChat');\r\n\r\n      } catch (e) {\r\n        console.error('解析消息失败', e);\r\n        ElMessage.error('接收消息失败');\r\n      }\r\n    };\r\n        // socket.value.onmessage = (event) => {\r\n        //   try {\r\n        //     const msg = JSON.parse(event.data);\r\n        //     addMessage({\r\n        //       id: msg.id,\r\n        //       text: msg.text,\r\n        //       fromMe: msg.from === myId.value,\r\n        //       time: msg.time\r\n        //     });\r\n            \r\n        //     // 更新最近聊天列表（使用消息中的发送者信息）\r\n        //     const senderInfo = {\r\n        //       id: parseInt(msg.from, 10),\r\n        //       username: msg.fromUsername || '未知用户',\r\n        //       photo: msg.fromPhoto\r\n        //     };\r\n        //     console.log(\"获取最近聊天 senderInfo: \", senderInfo)\r\n        //     store.commit('chat/ADD_RECENT_CHAT', senderInfo);\r\n        //     store.dispatch('chat/saveRecentChat');\r\n\r\n        //   } catch (e) {\r\n        //     console.error('解析消息失败', e);\r\n        //     ElMessage.error('接收消息失败');\r\n        //   }\r\n        // };\r\n        \r\n        socket.value.onclose = () => {\r\n          isConnected.value = false;\r\n          ElNotification({\r\n            title: '连接断开',\r\n            message: '聊天连接已断开，正在尝试重连...',\r\n            type: 'warning',\r\n            duration: 0\r\n          });\r\n          \r\n          if (!reconnecting.value) {\r\n            startReconnect();\r\n          }\r\n        };\r\n        \r\n        socket.value.onerror = (errorEvent) => {\r\n          console.error('WebSocket错误', errorEvent);\r\n          ElMessage.error('聊天连接错误，请稍后再试');\r\n        };\r\n      }\r\n    };\r\n    \r\n    // 加载历史消息\r\n\r\n    const loadHistoryMessages = async () => {\r\n  if (myId.value && targetUser.value.id) {\r\n    try {\r\n      const res = await axios.get(`${API_CONFIG.BASE_URL}/ws/chat/history/${myId.value}/${targetUser.value.id}`, {\r\n        headers: { Authorization: `Bearer ${store.state.token}` }\r\n      });\r\n      \r\n      if (res.data && res.data.length) {\r\n        const cryptoUtils = new CryptoUtils();\r\n        const decryptedMessages = [];\r\n        \r\n        // 逐个解密历史消息\r\n        for (const encryptedMsg of res.data) {\r\n          try {\r\n            // 解密消息\r\n            const decryptedMsg = await cryptoUtils.decrypt(encryptedMsg.encrypt_data, encryptedMsg.publick_key);\r\n            // 转换消息格式以匹配前端期望\r\n            decryptedMessages.push({\r\n              id: decryptedMsg.id,\r\n              text: decryptedMsg.text,\r\n              fromMe: decryptedMsg.from_id === myId.value,\r\n              time: decryptedMsg.created_at\r\n            });\r\n          } catch (decryptError) {\r\n            console.error(\"解密历史消息失败:\", decryptError);\r\n            // 可以选择跳过解密失败的消息或显示错误信息\r\n          }\r\n        }\r\n        \r\n        // 设置解密后的消息\r\n        messages.value = decryptedMessages;\r\n        \r\n        nextTick(() => {\r\n          if (messagesContainer.value) {\r\n            messagesContainer.value.scrollTop = messagesContainer.value.scrollHeight;\r\n          }\r\n        });\r\n      }\r\n    } catch (err) {\r\n      console.error('加载历史消息失败', err);\r\n      ElMessage.warning('历史消息加载失败');\r\n    }\r\n  }\r\n};\r\n\r\n  // 加载历史消息，未加密\r\n    // const loadHistoryMessages = () => {\r\n    //   if (myId.value && targetUser.value.id) {\r\n    //     axios.get(`${API_CONFIG.BASE_URL}/ws/chat/history/${myId.value}/${targetUser.value.id}`, {\r\n    //       headers: { Authorization: `Bearer ${store.state.token}` }\r\n    //     })\r\n    //     .then(res => {\r\n    //       if (res.data && res.data.length) {\r\n    //         messages.value = res.data.map(msg => ({\r\n    //           id: msg.id,\r\n    //           text: msg.text,\r\n    //           // 判断消息是否由当前用户发送\r\n    //           fromMe: msg.from_id === myId.value,\r\n    //           time: msg.created_at\r\n    //         }));\r\n            \r\n    //         nextTick(() => {\r\n    //           if (messagesContainer.value) {\r\n    //             messagesContainer.value.scrollTop = messagesContainer.value.scrollHeight;\r\n    //           }\r\n    //         });\r\n    //       }\r\n    //     })\r\n    //     .catch(err => {\r\n    //       console.error('加载历史消息失败', err);\r\n    //       ElMessage.warning('历史消息加载失败');\r\n    //     });\r\n    //   }\r\n    // };\r\n    \r\n    // 开始重连\r\n    const startReconnect = () => {\r\n      if (reconnecting.value || !targetUser.value.id) return;\r\n      \r\n      reconnecting.value = true;\r\n      reconnectTimer.value = setTimeout(() => {\r\n        initWebSocket();\r\n        reconnecting.value = false;\r\n      }, 3000);\r\n    };\r\n    \r\n    // 停止重连\r\n    const stopReconnect = () => {\r\n      if (reconnectTimer.value) {\r\n        clearTimeout(reconnectTimer.value);\r\n        reconnectTimer.value = null;\r\n        reconnecting.value = false;\r\n      }\r\n    };\r\n    \r\n    // 添加消息到列表\r\n    const addMessage = (msg) => {\r\n      messages.value.push(msg);\r\n      nextTick(() => {\r\n        if (messagesContainer.value) {\r\n          messagesContainer.value.scrollTop = messagesContainer.value.scrollHeight;\r\n        }\r\n      });\r\n    };\r\n    \r\n    // 发送消息\r\n    const sendMessage = () => {\r\n      // 空内容拦截（强化提示）\r\n      const content = inputMessage.value.trim();\r\n      if (!content) {\r\n        ElMessage.warning('消息内容不能为空，请输入后再发送～');\r\n        return;\r\n      }\r\n      \r\n      if (!isConnected.value) {\r\n        ElMessage.warning('当前连接已断开，无法发送消息');\r\n        return;\r\n      }\r\n      \r\n      const msg = {\r\n        id: Date.now(),\r\n        text: inputMessage.value.trim(),\r\n        fromMe: true,\r\n        time: new Date().toISOString()\r\n      };\r\n      \r\n      addMessage(msg);\r\n      inputMessage.value = '';\r\n      \r\n      try {\r\n        // 发送消息时包含fromUsername和fromPhoto\r\n        socket.value.send(JSON.stringify({\r\n          id: msg.id,\r\n          text: msg.text,\r\n          time: msg.time,\r\n          from: myId.value,\r\n          to: targetUser.value.id,\r\n          fromUsername: myUser.value.username, // 发送者用户名\r\n          fromPhoto: myUser.value.photo // 发送者头像\r\n        }));\r\n      } catch (error) {\r\n        console.error('发送消息失败', error);\r\n        ElMessage.error('消息发送失败，请稍后再试');\r\n      }\r\n\r\n      // 更新最近聊天列表\r\n      store.commit('chat/ADD_RECENT_CHAT', targetUser.value);\r\n      store.dispatch('chat/saveRecentChat');\r\n    };\r\n    \r\n    // 返回上一页\r\n    const goBack = () => {\r\n      router.back();\r\n      stopReconnect();\r\n      if (socket.value) {\r\n        socket.value.close();\r\n      }\r\n    };\r\n    \r\n    // 监听路由参数变化\r\n    watch(() => route.params.userId, (newId) => {\r\n      if (newId) {\r\n        fetchUserInfo(newId);\r\n      }\r\n    });\r\n\r\n    // 获取用户信息\r\n    const fetchUserInfo = (userId) => {\r\n\r\n     axios.get(`${API_CONFIG.BASE_URL}/user/info`, { // 修改URL路径\r\n    params: { id: userId }, // 添加查询参数\r\n    headers: { Authorization: `Bearer ${store.state.token}` }\r\n  }).then(res => {\r\n        if (res.data && res.data.id) {\r\n          targetUser.value = res.data;\r\n          initWebSocket();\r\n        } else {\r\n          console.error(\"res : \", res.data)\r\n          throw new Error('用户信息为空');\r\n        }\r\n      })\r\n      .catch(err => {\r\n        \r\n        console.log(\"失败： \", userId)\r\n        console.error('获取用户信息失败', err);\r\n        ElMessage.error('获取用户信息失败');\r\n        router.back();\r\n      });\r\n    };\r\n    \r\n    onMounted(() => {\r\n      if (route.params.userId) {\r\n        fetchUserInfo(route.params.userId);\r\n      } else {\r\n        ElMessage.error('未指定聊天对象');\r\n        router.back();\r\n      }\r\n    });\r\n    \r\n    onUnmounted(() => {\r\n      stopReconnect();\r\n      if (socket.value) {\r\n        socket.value.close();\r\n      }\r\n    });\r\n\r\n    return {\r\n      targetUser,\r\n      messages,\r\n      inputMessage,\r\n      myAvatar,\r\n      getFullUrl,\r\n      formatTime,\r\n      sendMessage,\r\n      goBack,\r\n      messagesContainer,\r\n      isConnected\r\n    };\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.chat-view {\r\n  display: flex;\r\n  flex-direction: column;\r\n  height: 100vh;\r\n  background-color: #f5f5f5;\r\n}\r\n\r\n.chat-header {\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 0 15px;\r\n  height: 50px;\r\n  background-color: #fff;\r\n  border-bottom: 1px solid #e5e5e5;\r\n  position: relative;\r\n}\r\n\r\n.back-button {\r\n  position: absolute;\r\n  left: 15px;\r\n  cursor: pointer;\r\n}\r\n\r\n.chat-title {\r\n  flex: 1;\r\n  text-align: center;\r\n  font-weight: bold;\r\n}\r\n\r\n.chat-avatar 