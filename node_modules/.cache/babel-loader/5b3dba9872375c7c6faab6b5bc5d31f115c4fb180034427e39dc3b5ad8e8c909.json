{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { computed, ref, onMounted, watch } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nimport defaultAvatar from '@/assets/default-avatar.png';\nimport { API_CONFIG } from '@/config/config';\nimport axios from 'axios';\nimport { ElMessage } from 'element-plus';\nimport { debounce } from 'lodash'; // 引入防抖函数\n\nexport default {\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const isUserInfoOpen = ref(false);\n    const user = computed(() => store.state.user);\n    const displayName = computed(() => user.value?.username || '未登录');\n\n    // 搜索相关状态\n    const isSearchOpen = ref(false);\n    const searchKeyword = ref('');\n    const searchResults = ref([]);\n    const isSearching = ref(false);\n\n    // 最近聊天列表（从 Vuex 获取）\n    const recentChats = computed(() => store.getters['chat/getRecentChats']);\n    console.log(\"最近聊天: \", recentChats);\n\n    // 工具方法\n    const getFullUrl = path => {\n      if (!path || path === defaultAvatar) return path;\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`;\n    };\n    // 新增：最近聊天折叠状态\n    const isRecentChatCollapse = ref(true); // 初始为折叠状态\n    const toggleRecentChatCollapse = () => {\n      isRecentChatCollapse.value = !isRecentChatCollapse.value;\n    };\n    const avatarUrl = computed(() => {\n      if (user.value?.photo) {\n        return `${API_CONFIG.BASE_URL}${user.value.photo}`;\n      }\n      return defaultAvatar;\n    });\n    const logout = () => {\n      store.dispatch('logout');\n      router.push('/login');\n    };\n    const goToUserDetail = () => {\n      router.push('/user/userinfo/' + user.value?.id);\n    };\n    const toggleUserInfo = () => {\n      isUserInfoOpen.value = !isUserInfoOpen.value;\n    };\n\n    // 搜索相关方法\n    const toggleSearch = () => {\n      isSearchOpen.value = !isSearchOpen.value;\n\n      // 关闭搜索时清空结果\n      if (!isSearchOpen.value) {\n        searchKeyword.value = '';\n        searchResults.value = [];\n      }\n    };\n\n    // 初始化防抖函数\n    const searchUsers = debounce(async keyword => {\n      if (!keyword.trim()) {\n        searchResults.value = []; // 清空搜索结果\n        return;\n      }\n      try {\n        // 调用搜索API\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/user/search`, {\n          params: {\n            keyword: keyword.trim()\n          },\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        });\n        searchResults.value = response.data.data || [];\n        console.log(\"实时搜索结果: \", searchResults.value);\n      } catch (error) {\n        console.error('搜索用户失败:', error);\n        ElMessage.error('搜索用户失败');\n      } finally {\n        isSearching.value = false;\n      }\n    }, 300); // 设置300ms防抖延迟\n\n    // 实时搜索函数\n    const handleLiveSearch = e => {\n      const keyword = e.target.value;\n      isSearching.value = true;\n      searchUsers(keyword);\n    };\n\n    // const searchUsers = async () => {\n    //   if (!searchKeyword.value.trim()) {\n    //     ElMessage.warning('请输入搜索关键词');\n    //     return;\n    //   }\n\n    //   isSearching.value = true;\n\n    //   try {\n    //     // 调用搜索API\n    //     const response = await axios.get(`${API_CONFIG.BASE_URL}/user/search`, {\n    //       params: {\n    //         keyword: searchKeyword.value.trim()\n    //       },\n    //       headers: { Authorization: `Bearer ${store.state.token}` }\n    //     });\n\n    //     searchResults.value = response.data.data || [];\n    //     console.log(\"查找结果: \", searchResults.value)\n\n    //   } catch (error) {\n    //     console.error('搜索用户失败:', error);\n    //     ElMessage.error('搜索用户失败');\n    //   } finally {\n    //     isSearching.value = false;\n    //   }\n    // };\n\n    // 检查用户是否已登录\n    const isUserLoggedIn = computed(() => !!user.value?.id);\n\n    // 组件挂载时尝试加载最近聊天\n    onMounted(() => {\n      if (isUserLoggedIn.value) {\n        loadRecentChats();\n      }\n    });\n\n    // 监听用户状态变化，确保登录后立即加载\n    watch(user, newUser => {\n      if (newUser?.id) {\n        console.log('用户已登录，加载最近聊天...');\n        loadRecentChats();\n      }\n    });\n    const loadRecentChats = async () => {\n      try {\n        await store.dispatch('chat/loadRecentChats');\n        console.log('最近聊天加载完成:', store.getters['chat/getRecentChats']);\n      } catch (error) {\n        console.error('加载最近聊天失败:', error);\n      }\n    };\n\n    // 开始聊天方法，跳转到聊天页面\n    // 修改startChat方法，添加保存最近聊天记录到数据库的逻辑\n    const startChat = async user => {\n      ElMessage.success(`开始与 ${user.username} 聊天`);\n      console.log(\"start chat user: \", user);\n      const userId = parseInt(user.id, 10);\n      const newUser = {\n        ...user,\n        id: userId\n      };\n\n      // 更新最近聊天列表\n      store.commit('chat/ADD_RECENT_CHAT', newUser);\n\n      // 打印用户对象，确认其结构\n      console.log('准备保存的用户对象:', newUser);\n      // 保存到数据库\n      await store.dispatch('chat/saveRecentChat', newUser);\n      // 清除未读计数\n      await store.dispatch('chat/clearUnreadCount', newUser.id);\n      isSearchOpen.value = false;\n      searchKeyword.value = '';\n      searchResults.value = [];\n\n      // 跳转到聊天页面，传递用户ID\n      router.push({\n        name: 'Chat',\n        params: {\n          userId: newUser.id\n        }\n      });\n    };\n    return {\n      user,\n      displayName,\n      avatarUrl,\n      getFullUrl,\n      logout,\n      handleLiveSearch,\n      goToUserDetail,\n      isUserInfoOpen,\n      toggleUserInfo,\n      isSearchOpen,\n      searchKeyword,\n      searchResults,\n      isSearching,\n      toggleSearch,\n      searchUsers,\n      startChat,\n      defaultAvatar,\n      API_CONFIG,\n      recentChats,\n      // 新增：暴露折叠状态和切换方法\n      isRecentChatCollapse,\n      toggleRecentChatCollapse\n    };\n  }\n};","map":{"version":3,"names":["computed","ref","onMounted","watch","useStore","useRouter","defaultAvatar","API_CONFIG","axios","ElMessage","debounce","setup","store","router","isUserInfoOpen","user","state","displayName","value","username","isSearchOpen","searchKeyword","searchResults","isSearching","recentChats","getters","console","log","getFullUrl","path","startsWith","BASE_URL","isRecentChatCollapse","toggleRecentChatCollapse","avatarUrl","photo","logout","dispatch","push","goToUserDetail","id","toggleUserInfo","toggleSearch","searchUsers","keyword","trim","response","get","params","headers","Authorization","token","data","error","handleLiveSearch","e","target","isUserLoggedIn","loadRecentChats","newUser","startChat","success","userId","parseInt","commit","name"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\views\\UserLayout.vue"],"sourcesContent":["<template>\r\n  <div class=\"user-page\">\r\n    <header class=\"header\">\r\n      <div class=\"header-left\">\r\n        <div class=\"user-info\" @click=\"goToUserDetail\">\r\n          <img :src=\"avatarUrl\" alt=\"用户头像\" class=\"avatar\" />\r\n          <span class=\"username\">{{ displayName }}</span>\r\n        </div>\r\n      </div>\r\n      \r\n      <div class=\"header-right\">\r\n        <button @click=\"logout\" class=\"logout-button\">退出登录</button>\r\n      </div>\r\n    </header>\r\n\r\n    <div class=\"main-layout\">\r\n      <aside class=\"sidebar\">\r\n        <!-- 搜索组件 -->\r\n        <div class=\"sidebar-search\">\r\n          <div class=\"search-toggle\" @click=\"toggleSearch\">\r\n            <i class=\"fa fa-search\" aria-hidden=\"true\"></i>\r\n            <span>搜索用户</span>\r\n          </div>\r\n          \r\n          <div v-if=\"isSearchOpen\" class=\"search-box\">\r\n            <div class=\"search-input-group\">\r\n              <input \r\n                type=\"text\" \r\n                v-model=\"searchKeyword\" \r\n                placeholder=\"搜索用户...\" \r\n                @keyup.enter=\"searchUsers\"\r\n              />\r\n              <button class=\"search-button\" @click=\"searchUsers\">\r\n                <i class=\"fa fa-search\" aria-hidden=\"true\"></i>\r\n              </button>\r\n              <button class=\"cancel-button\" @click=\"toggleSearch\">\r\n                取消\r\n              </button>\r\n            </div>\r\n            \r\n            <!-- 搜索结果列表 -->\r\n            <div v-if=\"isSearching\" class=\"search-loading\">\r\n              <i class=\"fa fa-spinner fa-spin\" aria-hidden=\"true\"></i> 搜索中...\r\n            </div>\r\n            \r\n            <div v-else-if=\"searchResults.length > 0\" class=\"search-results\">\r\n              <div \r\n                v-for=\"user in searchResults\" \r\n                :key=\"user.id\" \r\n                class=\"search-result-item\"\r\n                @click=\"startChat(user)\"\r\n              >\r\n                <div class=\"result-avatar-container\">\r\n                  <img \r\n                    :src=\"getFullUrl(user.photo)|| defaultAvatar\" \r\n                    alt=\"用户头像\" \r\n                    class=\"result-avatar\"\r\n                  />\r\n                </div>\r\n                <div class=\"result-info\">\r\n                  <div class=\"result-name\">{{ user.username }}</div>\r\n                  <div class=\"result-phone\">{{ user.phone }}</div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            \r\n            <div v-else-if=\"searchKeyword && !isSearching\" class=\"no-results\">\r\n              没有找到匹配的用户\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- 菜单保持不变 -->\r\n        <ul class=\"menu\">\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/user/dashboard\" class=\"menu-link\">仪表盘</router-link>\r\n          </li>\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/user-moment\" class=\"menu-link\">我相关</router-link>\r\n          </li>\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/moments\" class=\"menu-link\">朋友圈</router-link>\r\n          </li>\r\n          <li class=\"menu-item\">\r\n            <div @click=\"toggleUserInfo\" class=\"menu-title\">\r\n              用户信息\r\n              <span class=\"arrow\">{{ isUserInfoOpen ? '▼' : '▶' }}</span>\r\n            </div>\r\n            <ul v-if=\"isUserInfoOpen\" class=\"sub-menu\">\r\n              <li class=\"sub-menu-item\">\r\n                <router-link to=\"/user/userinfo/userlist\" class=\"sub-menu-link\">用户列表</router-link>\r\n              </li>\r\n              <li class=\"sub-menu-item2\">\r\n                <router-link to=\"/user/bigdatauser\" class=\"sub-menu-link\">大数据用户</router-link>\r\n              </li>\r\n            </ul>\r\n          </li>\r\n          <!-- 最近聊天列表 -->\r\n<div class=\"recent-chats\">\r\n  <!-- 可点击的标题，用于切换折叠状态 -->\r\n  <div \r\n    class=\"recent-chats-title\" \r\n    @click=\"toggleRecentChatCollapse\"\r\n  >\r\n    最近聊天\r\n    <!-- 可选：添加箭头图标表示折叠状态，这里用文字示例 -->\r\n    <span>{{ isRecentChatCollapse ? '▶' : '▼' }}</span>\r\n  </div>\r\n  <!-- 根据折叠状态决定是否显示聊天用户列表 -->\r\n  <div \r\n    class=\"recent-chat-list\" \r\n    v-show=\"!isRecentChatCollapse\"\r\n  >\r\n    <div\r\n      v-for=\"(user, index) in recentChats\"\r\n      :key=\"index\"\r\n      class=\"recent-chat-item\"\r\n      @click=\"startChat(user)\"\r\n    >\r\n      <div class=\"result-avatar-container\">\r\n        <img\r\n          :src=\"getFullUrl(user.photo) || defaultAvatar\"\r\n          alt=\"用户头像\"\r\n          class=\"result-avatar\"\r\n        />\r\n      </div>\r\n      <div class=\"result-info\">\r\n        <div class=\"result-name\">{{ user.username }}</div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n        </ul>\r\n      </aside>\r\n\r\n      <main class=\"main-content\">\r\n        <router-view />\r\n      </main>\r\n      \r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { computed, ref,onMounted, watch } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { useRouter } from 'vue-router';\r\nimport defaultAvatar from '@/assets/default-avatar.png';\r\nimport { API_CONFIG } from '@/config/config';\r\nimport axios from 'axios';\r\nimport { ElMessage } from 'element-plus';\r\nimport { debounce } from 'lodash'; // 引入防抖函数\r\n\r\nexport default {\r\n  setup() {\r\n    const store = useStore();\r\n    const router = useRouter();\r\n    const isUserInfoOpen = ref(false);\r\n    const user = computed(() => store.state.user);\r\n    const displayName = computed(() => user.value?.username || '未登录');\r\n    \r\n    // 搜索相关状态\r\n    const isSearchOpen = ref(false);\r\n    const searchKeyword = ref('');\r\n    const searchResults = ref([]);\r\n    const isSearching = ref(false);\r\n    \r\n        // 最近聊天列表（从 Vuex 获取）\r\n    const recentChats = computed(() => store.getters['chat/getRecentChats']);\r\n    console.log(\"最近聊天: \",recentChats)\r\n\r\n        // 工具方法\r\n    const getFullUrl = (path) => {\r\n      if (!path || path === defaultAvatar) return path\r\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`\r\n    }\r\n        // 新增：最近聊天折叠状态\r\n    const isRecentChatCollapse = ref(true); // 初始为折叠状态\r\n    const toggleRecentChatCollapse = () => {\r\n      isRecentChatCollapse.value = !isRecentChatCollapse.value;\r\n    };\r\n\r\n    const avatarUrl = computed(() => {\r\n      if (user.value?.photo) {\r\n        return `${API_CONFIG.BASE_URL}${user.value.photo}`;\r\n      }\r\n      return defaultAvatar;\r\n    });\r\n\r\n    const logout = () => {\r\n      store.dispatch('logout');\r\n      router.push('/login');\r\n    };\r\n\r\n    const goToUserDetail = () => {\r\n      router.push('/user/userinfo/' + user.value?.id);\r\n    };\r\n\r\n    const toggleUserInfo = () => {\r\n      isUserInfoOpen.value = !isUserInfoOpen.value;\r\n    };\r\n    \r\n    // 搜索相关方法\r\n    const toggleSearch = () => {\r\n      isSearchOpen.value = !isSearchOpen.value;\r\n      \r\n      // 关闭搜索时清空结果\r\n      if (!isSearchOpen.value) {\r\n        searchKeyword.value = '';\r\n        searchResults.value = [];\r\n      }\r\n    };\r\n\r\n\r\n\r\n// 初始化防抖函数\r\n    const searchUsers = debounce(async (keyword) => {\r\n      if (!keyword.trim()) {\r\n        searchResults.value = []; // 清空搜索结果\r\n        return;\r\n      }\r\n      \r\n      try {\r\n        // 调用搜索API\r\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/user/search`, {\r\n          params: {\r\n            keyword: keyword.trim()\r\n          },\r\n          headers: { Authorization: `Bearer ${store.state.token}` }\r\n        });\r\n        \r\n        searchResults.value = response.data.data || [];\r\n        console.log(\"实时搜索结果: \", searchResults.value);\r\n      } catch (error) {\r\n        console.error('搜索用户失败:', error);\r\n        ElMessage.error('搜索用户失败');\r\n      } finally {\r\n        isSearching.value = false;\r\n      }\r\n    }, 300); // 设置300ms防抖延迟\r\n\r\n    // 实时搜索函数\r\n    const handleLiveSearch = (e) => {\r\n      const keyword = e.target.value;\r\n      isSearching.value = true;\r\n      searchUsers(keyword);\r\n    };\r\n\r\n    // const searchUsers = async () => {\r\n    //   if (!searchKeyword.value.trim()) {\r\n    //     ElMessage.warning('请输入搜索关键词');\r\n    //     return;\r\n    //   }\r\n      \r\n    //   isSearching.value = true;\r\n      \r\n    //   try {\r\n    //     // 调用搜索API\r\n    //     const response = await axios.get(`${API_CONFIG.BASE_URL}/user/search`, {\r\n    //       params: {\r\n    //         keyword: searchKeyword.value.trim()\r\n    //       },\r\n    //       headers: { Authorization: `Bearer ${store.state.token}` }\r\n    //     });\r\n        \r\n    //     searchResults.value = response.data.data || [];\r\n    //     console.log(\"查找结果: \", searchResults.value)\r\n\r\n          \r\n    //   } catch (error) {\r\n    //     console.error('搜索用户失败:', error);\r\n    //     ElMessage.error('搜索用户失败');\r\n    //   } finally {\r\n    //     isSearching.value = false;\r\n    //   }\r\n    // };\r\n    \r\n    // 检查用户是否已登录\r\n    const isUserLoggedIn = computed(() => !!user.value?.id);\r\n    \r\n    // 组件挂载时尝试加载最近聊天\r\n    onMounted(() => {\r\n      if (isUserLoggedIn.value) {\r\n        loadRecentChats();\r\n      }\r\n    });\r\n    \r\n    // 监听用户状态变化，确保登录后立即加载\r\n    watch(user, (newUser) => {\r\n      if (newUser?.id) {\r\n        console.log('用户已登录，加载最近聊天...');\r\n        loadRecentChats();\r\n      }\r\n    });\r\n    \r\n    const loadRecentChats = async () => {\r\n      try {\r\n        await store.dispatch('chat/loadRecentChats');\r\n        console.log('最近聊天加载完成:', store.getters['chat/getRecentChats']);\r\n      } catch (error) {\r\n        console.error('加载最近聊天失败:', error);\r\n      }\r\n    };\r\n\r\n    // 开始聊天方法，跳转到聊天页面\r\n    // 修改startChat方法，添加保存最近聊天记录到数据库的逻辑\r\n    const startChat = async (user) => {\r\n      ElMessage.success(`开始与 ${user.username} 聊天`);\r\n\r\n      console.log(\"start chat user: \", user)\r\n      const userId = parseInt(user.id, 10);\r\n      const newUser = { ...user, id: userId };\r\n\r\n      // 更新最近聊天列表\r\n      store.commit('chat/ADD_RECENT_CHAT', newUser);\r\n\r\n        // 打印用户对象，确认其结构\r\n  console.log('准备保存的用户对象:', newUser);\r\n      // 保存到数据库\r\n      await store.dispatch('chat/saveRecentChat', newUser);\r\n      // 清除未读计数\r\n      await store.dispatch('chat/clearUnreadCount', newUser.id);\r\n\r\n      isSearchOpen.value = false;\r\n      searchKeyword.value = '';\r\n      searchResults.value = [];\r\n\r\n      // 跳转到聊天页面，传递用户ID\r\n      router.push({\r\n        name: 'Chat',\r\n        params: { userId: newUser.id },\r\n      });\r\n    };\r\n\r\n    return {\r\n      user,\r\n      displayName,\r\n      avatarUrl,\r\n      getFullUrl,\r\n      logout,\r\n      handleLiveSearch,\r\n      goToUserDetail,\r\n      isUserInfoOpen,\r\n      toggleUserInfo,\r\n      isSearchOpen,\r\n      searchKeyword,\r\n      searchResults,\r\n      isSearching,\r\n      toggleSearch,\r\n      searchUsers,\r\n      startChat,\r\n      defaultAvatar,\r\n      API_CONFIG,\r\n      recentChats,\r\n            // 新增：暴露折叠状态和切换方法\r\n      isRecentChatCollapse,\r\n      toggleRecentChatCollapse\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n\r\n/* 新增最近聊天列表样式 */\r\n.recent-chats {\r\n  padding: 15px 20px;\r\n  border-bottom: 1px solid #002140;\r\n}\r\n\r\n.recent-chats-title {\r\n  font-size: 14px;\r\n  font-weight: bold;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.recent-chat-item {\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 10px 0;\r\n  cursor: pointer;\r\n}\r\n\r\n.recent-chat-item:hover {\r\n  background-color: #003a75;\r\n}\r\n\r\n.result-avatar {\r\n  width: 32px;\r\n  height: 32px;\r\n  border-radius: 50%;\r\n  margin-right: 10px;\r\n}\r\n\r\n.result-name {\r\n  font-size: 14px;\r\n}\r\n\r\n/* 与原UserPage.vue样式一致，新增搜索相关样式 */\r\n.user-page {\r\n  display: flex;\r\n  flex-direction: column;\r\n  height: 100vh;\r\n  background-color: #f0f2f5;\r\n}\r\n\r\n.header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  padding: 0 20px;\r\n  height: 60px;\r\n  background-color: #001529;\r\n  color: white;\r\n}\r\n\r\n.header-left {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.user-info {\r\n  display: flex;\r\n  align-items: center;\r\n  cursor: pointer;\r\n}\r\n\r\n.avatar {\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 50%;\r\n  margin-right: 10px;\r\n}\r\n\r\n.username {\r\n  margin-right: 20px;\r\n  font-size: 16px;\r\n}\r\n\r\n.logout-button {\r\n  padding: 5px 10px;\r\n  background-color: #1890ff;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n}\r\n\r\n.logout-button:hover {\r\n  background-color: #40a9ff;\r\n}\r\n\r\n.main-layout {\r\n  display: flex;\r\n  flex: 1;\r\n  overflow: hidden;\r\n}\r\n\r\n.sidebar {\r\n  width: 200px;\r\n  background-color: #001529;\r\n  color: white;\r\n  overflow-y: auto;\r\n}\r\n\r\n.menu {\r\n  list-style: none;\r\n  padding: 