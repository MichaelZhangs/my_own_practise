{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nimport \"core-js/modules/web.url-search-params.delete.js\";\nimport \"core-js/modules/web.url-search-params.has.js\";\nimport \"core-js/modules/web.url-search-params.size.js\";\nimport { ref, computed } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { useStore } from 'vuex';\nimport axios from 'axios';\nimport { ElMessage, ElMessageBox } from 'element-plus';\nimport { API_CONFIG } from '@/config/config';\nexport default {\n  setup() {\n    const router = useRouter();\n    const store = useStore();\n    const editor = ref(null);\n    const content = ref('');\n    const files = ref([]);\n    const publishing = ref(false);\n    const canPublish = computed(() => {\n      return (content.value.trim().length > 0 || files.value.length > 0) && !publishing.value;\n    });\n    const formatText = command => {\n      document.execCommand(command, false);\n      editor.value.focus();\n    };\n    const updateContent = e => {\n      content.value = e.target.innerHTML;\n    };\n    const handleFileChange = file => {\n      files.value.push({\n        raw: file.raw,\n        preview: URL.createObjectURL(file.raw),\n        type: file.raw.type\n      });\n    };\n    const removeFile = index => {\n      files.value.splice(index, 1);\n    };\n    const handleCancel = () => {\n      if (content.value || files.value.length > 0) {\n        ElMessageBox.confirm('确定要放弃当前编辑的内容吗？', '提示', {\n          confirmButtonText: '确定',\n          cancelButtonText: '取消',\n          type: 'warning'\n        }).then(() => {\n          router.push('/moments');\n        });\n      } else {\n        router.push('/moments');\n      }\n    };\n    const publish = async () => {\n      if (!canPublish.value) return;\n      publishing.value = true;\n      try {\n        const formData = new FormData();\n        formData.append('content', content.value);\n        formData.append('user_id', store.state.user.id);\n        console.log(\"user_id: \", store.state.user.id);\n        files.value.forEach(file => {\n          formData.append('files', file.raw);\n        });\n        const response = await axios.post(`${API_CONFIG.BASE_URL}/article/moments`, formData, {\n          headers: {\n            'Content-Type': 'multipart/form-data',\n            'Authorization': `Bearer ${store.state.token}`\n          }\n        });\n        if (response.data.id) {\n          ElMessage.success('发布成功');\n          router.push('/moments');\n        }\n      } catch (error) {\n        ElMessage.error(`发布失败: ${error.response?.data?.detail || error.message}`);\n      } finally {\n        publishing.value = false;\n      }\n    };\n    return {\n      editor,\n      content,\n      files,\n      publishing,\n      canPublish,\n      formatText,\n      updateContent,\n      handleFileChange,\n      removeFile,\n      handleCancel,\n      publish\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","useRouter","useStore","axios","ElMessage","ElMessageBox","API_CONFIG","setup","router","store","editor","content","files","publishing","canPublish","value","trim","length","formatText","command","document","execCommand","focus","updateContent","e","target","innerHTML","handleFileChange","file","push","raw","preview","URL","createObjectURL","type","removeFile","index","splice","handleCancel","confirm","confirmButtonText","cancelButtonText","then","publish","formData","FormData","append","state","user","id","console","log","forEach","response","post","BASE_URL","headers","token","data","success","error","detail","message"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\article\\UserPublish.vue"],"sourcesContent":["<!-- Publish.vue -->\r\n<template>\r\n  <div class=\"publish-page\">\r\n    <div class=\"editor-container\">\r\n      <div class=\"header\">\r\n        <button class=\"cancel-btn\" @click=\"handleCancel\">取消</button>\r\n        <h3>发布动态</h3>\r\n        <button \r\n          class=\"publish-button\"\r\n          :disabled=\"!canPublish\"\r\n          @click=\"publish\"\r\n        >\r\n          {{ publishing ? '发布中...' : '发布' }}\r\n        </button>\r\n      </div>\r\n\r\n      <div class=\"toolbar\">\r\n        <button @click=\"formatText('bold')\" title=\"加粗\">\r\n          <strong>B</strong>\r\n        </button>\r\n        <button @click=\"formatText('italic')\" title=\"斜体\">\r\n          <em>I</em>\r\n        </button>\r\n        <button @click=\"formatText('underline')\" title=\"下划线\">\r\n          <u>U</u>\r\n        </button>\r\n      </div>\r\n      \r\n      <div \r\n        ref=\"editor\" \r\n        contenteditable=\"true\"\r\n        class=\"content-editor\"\r\n        placeholder=\"分享新鲜事...\"\r\n        @input=\"updateContent\"\r\n      ></div>\r\n\r\n      <!-- 文件上传 -->\r\n      <div class=\"upload-section\">\r\n        <el-upload\r\n          multiple\r\n          :limit=\"9\"\r\n          accept=\"image/*,video/*\"\r\n          :file-list=\"fileList\"\r\n          :on-change=\"handleFileChange\"\r\n          :auto-upload=\"false\"\r\n          :show-file-list=\"false\"\r\n        >\r\n          <el-button type=\"primary\" plain class=\"upload-btn\">\r\n            <el-icon><Plus /></el-icon>\r\n            添加图片/视频\r\n          </el-button>\r\n        </el-upload>\r\n\r\n        <div class=\"preview-grid\">\r\n          <div \r\n            v-for=\"(file, index) in files\" \r\n            :key=\"index\"\r\n            class=\"preview-item\"\r\n          >\r\n            <img v-if=\"file.type.startsWith('image')\" :src=\"file.preview\" />\r\n            <video v-else :src=\"file.preview\" controls></video>\r\n            <el-icon class=\"remove-btn\" @click=\"removeFile(index)\">\r\n              <Close />\r\n            </el-icon>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport { useStore } from 'vuex'\r\nimport axios from 'axios'\r\nimport { ElMessage, ElMessageBox } from 'element-plus'\r\nimport { API_CONFIG } from '@/config/config'\r\n\r\nexport default {\r\n  setup() {\r\n    const router = useRouter()\r\n    const store = useStore()\r\n    const editor = ref(null)\r\n    const content = ref('')\r\n    const files = ref([])\r\n    const publishing = ref(false)\r\n\r\n    const canPublish = computed(() => {\r\n      return (content.value.trim().length > 0 || files.value.length > 0) && !publishing.value\r\n    })\r\n\r\n    const formatText = (command) => {\r\n      document.execCommand(command, false)\r\n      editor.value.focus()\r\n    }\r\n\r\n    const updateContent = (e) => {\r\n      content.value = e.target.innerHTML\r\n    }\r\n\r\n    const handleFileChange = (file) => {\r\n      files.value.push({\r\n        raw: file.raw,\r\n        preview: URL.createObjectURL(file.raw),\r\n        type: file.raw.type\r\n      })\r\n    }\r\n\r\n    const removeFile = (index) => {\r\n      files.value.splice(index, 1)\r\n    }\r\n\r\n    const handleCancel = () => {\r\n      if (content.value || files.value.length > 0) {\r\n        ElMessageBox.confirm('确定要放弃当前编辑的内容吗？', '提示', {\r\n          confirmButtonText: '确定',\r\n          cancelButtonText: '取消',\r\n          type: 'warning'\r\n        }).then(() => {\r\n          router.push('/moments')\r\n        })\r\n      } else {\r\n        router.push('/moments')\r\n      }\r\n    }\r\n\r\n    const publish = async () => {\r\n      if (!canPublish.value) return\r\n\r\n      publishing.value = true\r\n\r\n      try {\r\n        const formData = new FormData()\r\n        formData.append('content', content.value)\r\n        formData.append('user_id', store.state.user.id)\r\n        console.log(\"user_id: \", store.state.user.id)\r\n        files.value.forEach(file => {\r\n          formData.append('files', file.raw)\r\n        })\r\n\r\n        const response = await axios.post(`${API_CONFIG.BASE_URL}/article/moments`, formData, {\r\n          headers: {\r\n            'Content-Type': 'multipart/form-data',\r\n            'Authorization': `Bearer ${store.state.token}`\r\n          }\r\n        })\r\n\r\n        if (response.data.id) {\r\n          ElMessage.success('发布成功')\r\n          router.push('/moments')\r\n        }\r\n      } catch (error) {\r\n        ElMessage.error(`发布失败: ${error.response?.data?.detail || error.message}`)\r\n      } finally {\r\n        publishing.value = false\r\n      }\r\n    }\r\n\r\n    return { \r\n      editor,\r\n      content,\r\n      files,\r\n      publishing,\r\n      canPublish,\r\n      formatText,\r\n      updateContent,\r\n      handleFileChange,\r\n      removeFile,\r\n      handleCancel,\r\n      publish\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.publish-page {\r\n  max-width: 600px;\r\n  margin: 0 auto;\r\n  background: #fff;\r\n  min-height: 100vh;\r\n}\r\n\r\n.editor-container {\r\n  border: 1px solid #e0e0e0;\r\n  border-radius: 12px;\r\n  overflow: hidden;\r\n}\r\n\r\n.header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  padding: 12px 20px;\r\n  border-bottom: 1px solid #e0e0e0;\r\n}\r\n\r\n.cancel-btn {\r\n  color: #666;\r\n  background: none;\r\n  border: none;\r\n  cursor: pointer;\r\n  padding: 8px 12px;\r\n}\r\n\r\n.cancel-btn:hover {\r\n  background: #f5f5f5;\r\n  border-radius: 4px;\r\n}\r\n\r\n.toolbar {\r\n  padding: 12px;\r\n  background: #f8f8f8;\r\n  border-bottom: 1px solid #e0e0e0;\r\n  display: flex;\r\n  gap: 12px;\r\n}\r\n\r\n.toolbar button {\r\n  padding: 6px 12px;\r\n  border: 1px solid #ddd;\r\n  border-radius: 6px;\r\n  background: #fff;\r\n  cursor: pointer;\r\n  transition: all 0.2s;\r\n}\r\n\r\n.toolbar button:hover {\r\n  background: #f0f0f0;\r\n}\r\n\r\n.content-editor {\r\n  min-height: 300px;\r\n  padding: 20px;\r\n  outline: none;\r\n  font-size: 16px;\r\n  line-height: 1.6;\r\n}\r\n\r\n.content-editor:empty::before {\r\n  content: attr(placeholder);\r\n  color: #999;\r\n}\r\n\r\n.upload-section {\r\n  padding: 0 20px 20px;\r\n}\r\n\r\n.upload-btn {\r\n  margin: 10px 0;\r\n}\r\n\r\n.preview-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, 1fr);\r\n  gap: 10px;\r\n  margin-top: 10px;\r\n}\r\n\r\n.preview-item {\r\n  position: relative;\r\n  height: 120px;\r\n  border-radius: 8px;\r\n  overflow: hidden;\r\n}\r\n\r\n.preview-item img,\r\n.preview-item video {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n}\r\n\r\n.remove-btn {\r\n  position: absolute;\r\n  top: 5px;\r\n  right: 5px;\r\n  background: rgba(0,0,0,0.5);\r\n  color: white;\r\n  border-radius: 50%;\r\n  padding: 4px;\r\n  cursor: pointer;\r\n}\r\n\r\n.publish-button {\r\n  background: #07c160;\r\n  color: white;\r\n  border: none;\r\n  padding: 10px 20px;\r\n  border-radius: 20px;\r\n  cursor: pointer;\r\n  transition: background 0.2s;\r\n}\r\n\r\n.publish-button:disabled {\r\n  background: #ccc;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.publish-button:hover:not(:disabled) {\r\n  background: #06ad54;\r\n}\r\n</style>"],"mappings":";;;;;;AAwEA,SAASA,GAAG,EAAEC,QAAO,QAAS,KAAI;AAClC,SAASC,SAAQ,QAAS,YAAW;AACrC,SAASC,QAAO,QAAS,MAAK;AAC9B,OAAOC,KAAI,MAAO,OAAM;AACxB,SAASC,SAAS,EAAEC,YAAW,QAAS,cAAa;AACrD,SAASC,UAAS,QAAS,iBAAgB;AAE3C,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIP,SAAS,CAAC;IACzB,MAAMQ,KAAI,GAAIP,QAAQ,CAAC;IACvB,MAAMQ,MAAK,GAAIX,GAAG,CAAC,IAAI;IACvB,MAAMY,OAAM,GAAIZ,GAAG,CAAC,EAAE;IACtB,MAAMa,KAAI,GAAIb,GAAG,CAAC,EAAE;IACpB,MAAMc,UAAS,GAAId,GAAG,CAAC,KAAK;IAE5B,MAAMe,UAAS,GAAId,QAAQ,CAAC,MAAM;MAChC,OAAO,CAACW,OAAO,CAACI,KAAK,CAACC,IAAI,CAAC,CAAC,CAACC,MAAK,GAAI,KAAKL,KAAK,CAACG,KAAK,CAACE,MAAK,GAAI,CAAC,KAAK,CAACJ,UAAU,CAACE,KAAI;IACxF,CAAC;IAED,MAAMG,UAAS,GAAKC,OAAO,IAAK;MAC9BC,QAAQ,CAACC,WAAW,CAACF,OAAO,EAAE,KAAK;MACnCT,MAAM,CAACK,KAAK,CAACO,KAAK,CAAC;IACrB;IAEA,MAAMC,aAAY,GAAKC,CAAC,IAAK;MAC3B