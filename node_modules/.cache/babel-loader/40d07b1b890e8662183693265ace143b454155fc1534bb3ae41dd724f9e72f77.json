{"ast":null,"code":"import { computed, ref } from 'vue';\nimport { useStore } from 'vuex';\nimport defaultAvatar from '@/assets/default-avatar.png';\nimport defaultqrcode from '@/assets/logo.png';\nimport QRCode from 'qrcode';\nexport default {\n  name: 'UserDetail',\n  setup() {\n    const store = useStore();\n    const user = computed(() => store.state.user);\n    const editableUser = ref({\n      ...user.value\n    });\n    const qrcodeUrl = ref(defaultqrcode); // 初始化使用默认二维码\n\n    // 生成二维码\n    const generateQrcode = async () => {\n      try {\n        const content = `用户信息：\n  姓名：${editableUser.value.username}\n  手机：${editableUser.value.phone}\n  邮箱：${editableUser.value.email}`;\n\n        // 生成二维码\n        const qrCanvas = document.createElement('canvas');\n        await QRCode.toCanvas(qrCanvas, content, {\n          errorCorrectionLevel: 'H',\n          width: 200,\n          color: {\n            dark: '#07c160',\n            light: '#ffffff00' // 透明背景\n          }\n        });\n\n        // 添加头像\n        const avatarImg = new Image();\n        avatarImg.src = user.value.photo || defaultAvatar;\n        await new Promise(resolve => avatarImg.onload = resolve);\n        const ctx = qrCanvas.getContext('2d');\n        const avatarSize = 40;\n        ctx.drawImage(avatarImg, (qrCanvas.width - avatarSize) / 2, (qrCanvas.height - avatarSize) / 2, avatarSize, avatarSize);\n        qrcodeUrl.value = qrCanvas.toDataURL();\n      } catch (error) {\n        console.error(\"二维码生成失败:\", error);\n      }\n    };\n\n    // 保存用户信息\n    const saveUserInfo = async () => {\n      try {\n        await store.dispatch('updateUser', editableUser.value);\n        alert('信息保存成功！');\n      } catch (error) {\n        console.error(\"保存失败:\", error);\n        alert('保存失败，请重试');\n      }\n    };\n    return {\n      user,\n      editableUser,\n      qrcodeUrl,\n      defaultAvatar,\n      defaultqrcode,\n      generateQrcode,\n      saveUserInfo\n    };\n  }\n};","map":{"version":3,"names":["computed","ref","useStore","defaultAvatar","defaultqrcode","QRCode","name","setup","store","user","state","editableUser","value","qrcodeUrl","generateQrcode","content","username","phone","email","qrCanvas","document","createElement","toCanvas","errorCorrectionLevel","width","color","dark","light","avatarImg","Image","src","photo","Promise","resolve","onload","ctx","getContext","avatarSize","drawImage","height","toDataURL","error","console","saveUserInfo","dispatch","alert"],"sources":["E:\\vue_learn\\ai_vue\\ai_vue\\src\\views\\UserDetail.vue"],"sourcesContent":["<template>\r\n    <div class=\"user-detail-page\">\r\n      <h1>用户详情</h1>\r\n      <div class=\"user-detail-container\">\r\n        <!-- 用户信息 -->\r\n        <div class=\"info-section\">\r\n          <!-- 头像 -->\r\n          <div class=\"avatar-section\">\r\n            <img :src=\"user?.photo || defaultAvatar\" alt=\"头像\" class=\"avatar\" />\r\n          </div>\r\n  \r\n          <!-- 用户信息 -->\r\n          <div class=\"info-item\">\r\n            <label>名字：</label>\r\n            <input v-model=\"editableUser.username\" placeholder=\"未设置\" />\r\n          </div>\r\n          <div class=\"info-item\">\r\n            <label>性别：</label>\r\n            <input v-model=\"editableUser.sex\" placeholder=\"未设置\" />\r\n          </div>\r\n          <div class=\"info-item\">\r\n            <label>手机号：</label>\r\n            <input v-model=\"editableUser.phone\" placeholder=\"未设置\" />\r\n          </div>\r\n          <div class=\"info-item\">\r\n            <label>邮箱：</label>\r\n            <input v-model=\"editableUser.email\" placeholder=\"未设置\" />\r\n          </div>\r\n          <div class=\"info-item\">\r\n            <label>描述：</label>\r\n            <textarea v-model=\"editableUser.description\" placeholder=\"未设置\"></textarea>\r\n          </div>\r\n  \r\n          <!-- 二维码 -->\r\n          <div class=\"qr-code-section\">\r\n            <h2 @click=\"generateQrcode\">我的二维码</h2>\r\n            <div class=\"qr-code-container\">\r\n              <img :src=\"qrcodeUrl || defaultqrcode\" alt=\"我的二维码\" class=\"qr-code\" />\r\n            </div>\r\n          </div>\r\n  \r\n          <!-- 保存按钮 -->\r\n          <button @click=\"saveUserInfo\" class=\"save-button\">保存信息</button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import { computed, ref } from 'vue'\r\n  import { useStore } from 'vuex'\r\n  import defaultAvatar from '@/assets/default-avatar.png'\r\n  import defaultqrcode from '@/assets/logo.png'\r\n  import QRCode from 'qrcode'\r\n  \r\n  export default {\r\n    name: 'UserDetail',\r\n    setup() {\r\n      const store = useStore()\r\n      const user = computed(() => store.state.user)\r\n      const editableUser = ref({ ...user.value })\r\n      const qrcodeUrl = ref(defaultqrcode)  // 初始化使用默认二维码\r\n  \r\n      // 生成二维码\r\n      const generateQrcode = async () => {\r\n        try {\r\n          const content = `用户信息：\r\n  姓名：${editableUser.value.username}\r\n  手机：${editableUser.value.phone}\r\n  邮箱：${editableUser.value.email}`\r\n  \r\n          // 生成二维码\r\n          const qrCanvas = document.createElement('canvas')\r\n          await QRCode.toCanvas(qrCanvas, content, {\r\n            errorCorrectionLevel: 'H',\r\n            width: 200,\r\n            color: {\r\n              dark: '#07c160',\r\n              light: '#ffffff00' // 透明背景\r\n            }\r\n          })\r\n  \r\n          // 添加头像\r\n          const avatarImg = new Image()\r\n          avatarImg.src = user.value.photo || defaultAvatar\r\n          await new Promise(resolve => (avatarImg.onload = resolve))\r\n  \r\n          const ctx = qrCanvas.getContext('2d')\r\n          const avatarSize = 40\r\n          ctx.drawImage(\r\n            avatarImg,\r\n            (qrCanvas.width - avatarSize) / 2,\r\n            (qrCanvas.height - avatarSize) / 2,\r\n            avatarSize,\r\n            avatarSize\r\n          )\r\n  \r\n          qrcodeUrl.value = qrCanvas.toDataURL()\r\n        } catch (error) {\r\n          console.error(\"二维码生成失败:\", error)\r\n        }\r\n      }\r\n  \r\n      // 保存用户信息\r\n      const saveUserInfo = async () => {\r\n        try {\r\n          await store.dispatch('updateUser', editableUser.value)\r\n          alert('信息保存成功！')\r\n        } catch (error) {\r\n          console.error(\"保存失败:\", error)\r\n          alert('保存失败，请重试')\r\n        }\r\n      }\r\n  \r\n      return {\r\n        user,\r\n        editableUser,\r\n        qrcodeUrl,\r\n        defaultAvatar,\r\n        defaultqrcode,\r\n        generateQrcode,\r\n        saveUserInfo\r\n      }\r\n    }\r\n  }\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .user-detail-page {\r\n    max-width: 800px;\r\n    margin: 0 auto;\r\n    padding: 20px;\r\n  }\r\n  \r\n  .user-detail-container {\r\n    background: #fff;\r\n    border-radius: 8px;\r\n    padding: 30px;\r\n    box-shadow: 0 2px 12px rgba(0,0,0,0.1);\r\n  }\r\n  \r\n  .avatar-section {\r\n    text-align: center;\r\n    margin-bottom: 25px;\r\n  }\r\n  \r\n  .avatar {\r\n    width: 120px;\r\n    height: 120px;\r\n    border-radius: 50%;\r\n    border: 3px solid #07c160;\r\n  }\r\n  \r\n  .info-item {\r\n    margin: 15px 0;\r\n    display: flex;\r\n    align-items: center;\r\n  }\r\n  \r\n  .info-item label {\r\n    width: 80px;\r\n    font-weight: 600;\r\n    color: #333;\r\n  }\r\n  \r\n  .info-item input,\r\n  .info-item textarea {\r\n    flex: 1;\r\n    padding: 8px 12px;\r\n    border: 1px solid #ddd;\r\n    border-radius: 4px;\r\n    font-size: 14px;\r\n  }\r\n  \r\n  textarea {\r\n    height: 80px;\r\n    resize: vertical;\r\n  }\r\n  \r\n  .qr-code-section {\r\n    margin-top: 25px;\r\n    border-top: 1px solid #eee;\r\n    padding-top: 25px;\r\n  }\r\n  \r\n  .qr-code-section h2 {\r\n    color: #07c160;\r\n    cursor: pointer;\r\n    margin-bottom: 15px;\r\n  }\r\n  \r\n  .qr-code {\r\n    width: 200px;\r\n    height: 200px;\r\n    background: white;\r\n    padding: 10px;\r\n    border-radius: 8px;\r\n    box-shadow: 0 2px 8px rgba(0,0,0,0.1);\r\n  }\r\n  \r\n  .save-button {\r\n    display: block;\r\n    width: 100%;\r\n    padding: 12px;\r\n    background: #07c160;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 4px;\r\n    margin-top: 25px;\r\n    cursor: pointer;\r\n    transition: background 0.3s;\r\n  }\r\n  \r\n  .save-button:hover {\r\n    background: #05964d;\r\n  }\r\n  \r\n  @media (max-width: 768px) {\r\n    .user-detail-container {\r\n      padding: 20px;\r\n    }\r\n    \r\n    .info-item {\r\n      flex-direction: column;\r\n      align-items: flex-start;\r\n    }\r\n    \r\n    .info-item label {\r\n      margin-bottom: 5px;\r\n    }\r\n  }\r\n  </style>"],"mappings":"AAiDE,SAASA,QAAQ,EAAEC,GAAE,QAAS,KAAI;AAClC,SAASC,QAAO,QAAS,MAAK;AAC9B,OAAOC,aAAY,MAAO,6BAA4B;AACtD,OAAOC,aAAY,MAAO,mBAAkB;AAC5C,OAAOC,MAAK,MAAO,QAAO;AAE1B,eAAe;EACbC,IAAI,EAAE,YAAY;EAClBC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIN,QAAQ,CAAC;IACvB,MAAMO,IAAG,GAAIT,QAAQ,CAAC,MAAMQ,KAAK,CAACE,KAAK,CAACD,IAAI;IAC5C,MAAME,YAAW,GAAIV,GAAG,CAAC;MAAE,GAAGQ,IAAI,CAACG;IAAM,CAAC;IAC1C,MAAMC,SAAQ,GAAIZ,GAAG,CAACG,aAAa,GAAG;;IAEtC;IACA,MAAMU,cAAa,GAAI,MAAAA,CAAA,KAAY;MACjC,IAAI;QACF,MAAMC,OAAM,GAAI;OACnBJ,YAAY,CAACC,KAAK,CAACI,QAAQ;OAC3BL,YAAY,CAACC,KAAK,CAACK,KAAK;OACxBN,YAAY,CAACC,KAAK,CAACM,KAAK,EAAC;;QAEtB;QACA,MAAMC,QAAO,GAAIC,QAAQ,CAACC,aAAa,CAAC,QAAQ;QAChD,MAAMhB,MAAM,CAACiB,QAAQ,CAACH,QAAQ,EAAEJ,OAAO,EAAE;UACvCQ,oBAAoB,EAAE,GAAG;UACzBC,KAAK,EAAE,GAAG;UACVC,KAAK,EAAE;YACLC,IAAI,EAAE,SAAS;YACfC,KAAK,EAAE,WAAU,CAAE;UACrB;QACF,CAAC;;QAED;QACA,MAAMC,SAAQ,GAAI,IAAIC,KAAK,CAAC;QAC5BD,SAAS,CAACE,GAAE,GAAIrB,IAAI,CAACG,KAAK,CAACmB,KAAI,IAAK5B,aAAY;QAChD,MAAM,IAAI6B,OAAO,CAACC,OAAM,IAAML,SAAS,CAACM,MAAK,GAAID,OAAQ;QAEzD,MAAME,GAAE,GAAIhB,QAAQ,CAACiB,UAAU,CAAC,IAAI;QACpC,MAAMC,UAAS,GAAI,EAAC;QACpBF,GAAG,CAACG,SAAS,CACXV,SAAS,EACT,CAACT,QAAQ,CAACK,KAAI,GAAIa,UAAU,IAAI,CAAC,EACjC,CAAClB,QAAQ,CAACoB,MAAK,GAAIF,UAAU,IAAI,CAAC,EAClCA,UAAU,EACVA,UACF;QAEAxB,SAAS,C