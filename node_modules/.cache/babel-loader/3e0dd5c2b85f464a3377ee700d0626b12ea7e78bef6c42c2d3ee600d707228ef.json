","_hoisted_42","messageInput","sendMessage"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\views\\UserLayout.vue"],"sourcesContent":["<template>\r\n  <div class=\"user-page\">\r\n    <header class=\"header\">\r\n      <div class=\"header-left\">\r\n        <div class=\"user-info\" @click=\"goToUserDetail\">\r\n          <img :src=\"avatarUrl\" alt=\"用户头像\" class=\"avatar\" />\r\n          <span class=\"username\">{{ displayName }}</span>\r\n        </div>\r\n      </div>\r\n      \r\n      <div class=\"header-right\">\r\n        <button @click=\"logout\" class=\"logout-button\">退出登录</button>\r\n      </div>\r\n    </header>\r\n\r\n    <div class=\"main-layout\">\r\n      <aside class=\"sidebar\">\r\n        <!-- 搜索组件 -->\r\n        <div class=\"sidebar-search\">\r\n          <div class=\"search-toggle\" @click=\"toggleSearch\">\r\n            <i class=\"fa fa-search\" aria-hidden=\"true\"></i>\r\n            <span>搜索用户</span>\r\n          </div>\r\n          \r\n          <div v-if=\"isSearchOpen\" class=\"search-box\">\r\n            <div class=\"search-input-group\">\r\n              <input \r\n                type=\"text\" \r\n                v-model=\"searchKeyword\" \r\n                placeholder=\"搜索用户...\" \r\n                @keyup.enter=\"searchUsers\"\r\n              />\r\n              <button class=\"search-button\" @click=\"searchUsers\">\r\n                <i class=\"fa fa-search\" aria-hidden=\"true\"></i>\r\n              </button>\r\n              <button class=\"cancel-button\" @click=\"toggleSearch\">\r\n                取消\r\n              </button>\r\n            </div>\r\n            \r\n            <!-- 搜索结果列表 -->\r\n            <div v-if=\"isSearching\" class=\"search-loading\">\r\n              <i class=\"fa fa-spinner fa-spin\" aria-hidden=\"true\"></i> 搜索中...\r\n            </div>\r\n            \r\n            <div v-else-if=\"searchResults.length > 0\" class=\"search-results\">\r\n              <div \r\n                v-for=\"user in searchResults\" \r\n                :key=\"user.id\" \r\n                class=\"search-result-item\"\r\n                @click=\"startChat(user)\"\r\n              >\r\n                <div class=\"result-avatar-container\">\r\n                  <img \r\n                    :src=\"getFullUrl(user.photo)|| defaultAvatar\" \r\n                    alt=\"用户头像\" \r\n                    class=\"result-avatar\"\r\n                  />\r\n                </div>\r\n                <div class=\"result-info\">\r\n                  <div class=\"result-name\">{{ user.username }}</div>\r\n                  <div class=\"result-phone\">{{ user.phone }}</div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            \r\n            <div v-else-if=\"searchKeyword && !isSearching\" class=\"no-results\">\r\n              没有找到匹配的用户\r\n            </div>\r\n          </div>\r\n        </div>\r\n        \r\n        <!-- 菜单保持不变 -->\r\n        <ul class=\"menu\">\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/user/dashboard\" class=\"menu-link\">仪表盘</router-link>\r\n          </li>\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/user-moment\" class=\"menu-link\">我相关</router-link>\r\n          </li>\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/moments\" class=\"menu-link\">朋友圈</router-link>\r\n          </li>\r\n          <li class=\"menu-item\">\r\n            <div @click=\"toggleUserInfo\" class=\"menu-title\">\r\n              用户信息\r\n              <span class=\"arrow\">{{ isUserInfoOpen ? '▼' : '▶' }}</span>\r\n            </div>\r\n            <ul v-if=\"isUserInfoOpen\" class=\"sub-menu\">\r\n              <li class=\"sub-menu-item\">\r\n                <router-link to=\"/user/userinfo/userlist\" class=\"sub-menu-link\">用户列表</router-link>\r\n              </li>\r\n              <li class=\"sub-menu-item2\">\r\n                <router-link to=\"/user/bigdatauser\" class=\"sub-menu-link\">大数据用户</router-link>\r\n              </li>\r\n            </ul>\r\n          </li>\r\n        </ul>\r\n      </aside>\r\n\r\n      <main class=\"main-content\">\r\n        <!-- 聊天界面 -->\r\n        <div v-if=\"currentChatUser.id\" class=\"chat-container\">\r\n          <div class=\"chat-header\">\r\n            <div class=\"back-button\" @click=\"closeChat\">\r\n              <i class=\"fa fa-arrow-left\" aria-hidden=\"true\"></i>\r\n            </div>\r\n            <div class=\"chat-title\">{{ currentChatUser.username }}</div>\r\n            <div class=\"chat-options\">\r\n              <button class=\"option-button\">\r\n                <i class=\"fa fa-info-circle\" aria-hidden=\"true\"></i>\r\n              </button>\r\n            </div>\r\n          </div>\r\n          \r\n          <div class=\"chat-messages\" ref=\"messagesContainer\">\r\n            <div v-if=\"currentMessages.length === 0\" class=\"empty-chat\">\r\n              开始和 {{ currentChatUser.username }} 聊天吧\r\n            </div>\r\n            \r\n            <div \r\n              v-for=\"(message, index) in currentMessages\" \r\n              :key=\"message.id || index\" \r\n              :class=\"['message-item', message.fromMe ? 'message-from-me' : 'message-from-other']\"\r\n            >\r\n              <div class=\"message-avatar\">\r\n                <img \r\n                  :src=\"message.fromMe ? avatarUrl : (currentChatUser.photo ? `${API_CONFIG.BASE_URL}${currentChatUser.photo}` : defaultAvatar)\" \r\n                  alt=\"头像\" \r\n                  class=\"avatar-sm\"\r\n                />\r\n              </div>\r\n              \r\n              <div class=\"message-content\">\r\n                <div class=\"message-bubble\">\r\n                  {{ message.text }}\r\n                </div>\r\n                <div class=\"message-time\">{{ formatMessageTime(message.time) }}</div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          \r\n          <div class=\"chat-input-area\">\r\n            <div class=\"input-tools\">\r\n              <button class=\"tool-button\">\r\n                <i class=\"fa fa-smile-o\" aria-hidden=\"true\"></i>\r\n              </button>\r\n              <button class=\"tool-button\">\r\n                <i class=\"fa fa-picture-o\" aria-hidden=\"true\"></i>\r\n              </button>\r\n              <button class=\"tool-button\">\r\n                <i class=\"fa fa-file-o\" aria-hidden=\"true\"></i>\r\n              </button>\r\n            </div>\r\n            \r\n            <div class=\"message-input-container\">\r\n              <input \r\n                type=\"text\" \r\n                v-model=\"messageInput\" \r\n                placeholder=\"输入消息...\" \r\n                @keyup.enter=\"sendMessage\"\r\n              />\r\n              <button class=\"send-button\" @click=\"sendMessage\">\r\n                发送\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        \r\n        <!-- 无聊天界面时的提示 -->\r\n        <div v-else class=\"empty-chat-view\">\r\n          <div class=\"empty-icon\">\r\n            <i class=\"fa fa-comments-o\" aria-hidden=\"true\"></i>\r\n          </div>\r\n          <div class=\"empty-text\">选择一个联系人开始聊天</div>\r\n        </div>\r\n      </main>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { computed, ref } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { useRouter } from 'vue-router';\r\nimport defaultAvatar from '@/assets/default-avatar.png';\r\nimport { API_CONFIG } from '@/config/config';\r\nimport axios from 'axios';\r\nimport { ElMessage } from 'element-plus';\r\n\r\nexport default {\r\n  setup() {\r\n    const store = useStore();\r\n    const router = useRouter();\r\n    const isUserInfoOpen = ref(false);\r\n    const user = computed(() => store.state.user);\r\n    const displayName = computed(() => user.value?.username || '未登录');\r\n    \r\n    // 搜索相关状态\r\n    const isSearchOpen = ref(false);\r\n    const searchKeyword = ref('');\r\n    const searchResults = ref([]);\r\n    const isSearching = ref(false);\r\n    \r\n        // 聊天相关状态\r\n    const currentChatUser = ref({});\r\n    const messageInput = ref('');\r\n    const allChats = ref({}); // 所有聊天记录，按userId分组\r\n    const recentChats = ref([]); // 最近聊天列表\r\n    const messagesContainer = ref(null); // 添加对消息容器的引用\r\n\r\n\r\n        // 工具方法\r\n    const getFullUrl = (path) => {\r\n      if (!path || path === defaultAvatar) return path\r\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`\r\n    }\r\n\r\n    const avatarUrl = computed(() => {\r\n      if (user.value?.photo) {\r\n        return `${API_CONFIG.BASE_URL}${user.value.photo}`;\r\n      }\r\n      return defaultAvatar;\r\n    });\r\n\r\n    const logout = () => {\r\n      store.dispatch('logout');\r\n      router.push('/login');\r\n    };\r\n\r\n    const goToUserDetail = () => {\r\n      router.push('/user/userinfo/' + user.value?.id);\r\n    };\r\n\r\n    const toggleUserInfo = () => {\r\n      isUserInfoOpen.value = !isUserInfoOpen.value;\r\n    };\r\n    \r\n    // 搜索相关方法\r\n    const toggleSearch = () => {\r\n      isSearchOpen.value = !isSearchOpen.value;\r\n      \r\n      // 关闭搜索时清空结果\r\n      if (!isSearchOpen.value) {\r\n        searchKeyword.value = '';\r\n        searchResults.value = [];\r\n      }\r\n    };\r\n    \r\n    const searchUsers = async () => {\r\n      if (!searchKeyword.value.trim()) {\r\n        ElMessage.warning('请输入搜索关键词');\r\n        return;\r\n      }\r\n      \r\n      isSearching.value = true;\r\n      \r\n      try {\r\n        // 调用搜索API\r\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/user/search`, {\r\n          params: {\r\n            keyword: searchKeyword.value.trim()\r\n          },\r\n          headers: { Authorization: `Bearer ${store.state.token}` }\r\n        });\r\n        \r\n        searchResults.value = response.data.data || [];\r\n        console.log(\"查找结果: \", searchResults.value)\r\n\r\n          \r\n      } catch (error) {\r\n        console.error('搜索用户失败:', error);\r\n        ElMessage.error('搜索用户失败');\r\n      } finally {\r\n        isSearching.value = false;\r\n      }\r\n    };\r\n    \r\n     // 聊天相关方法\r\n    const startChat = (user) => {\r\n      // 更新当前聊天用户\r\n      currentChatUser.value = user;\r\n      \r\n      // 如果没有该用户的聊天记录，初始化一个空数组\r\n      if (!allChats.value[user.id]) {\r\n        allChats.value[user.id] = [];\r\n      }\r\n      \r\n      // 更新最近聊天列表\r\n      updateRecentChats(user);\r\n      \r\n      // 滚动到底部\r\n      scrollToBottom();\r\n    };\r\n    \r\n    const closeChat = () => {\r\n      currentChatUser.value = {};\r\n    };\r\n    \r\n    const sendMessage = () => {\r\n      if (!messageInput.value.trim()) {\r\n        return;\r\n      }\r\n      \r\n      const message = {\r\n        id: Date.now(),\r\n        text: messageInput.value.trim(),\r\n        fromMe: true,\r\n        time: new Date().toISOString()\r\n      };\r\n      \r\n      // 添加消息到聊天记录\r\n      if (!allChats.value[currentChatUser.value.id]) {\r\n        allChats.value[currentChatUser.value.id] = [];\r\n      }\r\n      \r\n      allChats.value[currentChatUser.value.id].push(message);\r\n      \r\n      // 清空输入框\r\n      messageInput.value = '';\r\n      \r\n      // 更新最近聊天列表\r\n      updateRecentChats(currentChatUser.value);\r\n      \r\n      // 滚动到底部\r\n      scrollToBottom();\r\n      \r\n      // 模拟对方回复\r\n      simulateReply();\r\n    };\r\n    \r\n    const simulateReply = () => {\r\n      if (!currentChatUser.value.id) {\r\n        return;\r\n      }\r\n      \r\n      // 延迟1-3秒回复\r\n      const delay = Math.floor(Math.random() * 2000) + 1000;\r\n      \r\n      setTimeout(() => {\r\n        const replies = [\r\n          \"好的，我明白了。\",\r\n          \"谢谢！\",\r\n          \"有什么我可以帮助你的吗？\",\r\n          \"哈哈，真有趣！\",\r\n          \"我稍后回复你。\",\r\n          \"是的，你说得对。\",\r\n          \"很高兴收到你的消息！\"\r\n        ];\r\n        \r\n        const randomReply = replies[Math.floor(Math.random() * replies.length)];\r\n        \r\n        const reply = {\r\n          id: Date.now(),\r\n          text: randomReply,\r\n          fromMe: false,\r\n          time: new Date().toISOString()\r\n        };\r\n        \r\n        allChats.value[currentChatUser.value.id].push(reply);\r\n        \r\n        // 更新最近聊天列表\r\n        updateRecentChats(currentChatUser.value);\r\n        \r\n        // 滚动到底部\r\n        scrollToBottom();\r\n      }, delay);\r\n    };\r\n    \r\n    const updateRecentChats = (user) => {\r\n      // 检查用户是否已在最近聊天列表中\r\n      const index = recentChats.value.findIndex(chat => chat.id === user.id);\r\n      \r\n      if (index > -1) {\r\n        // 如果已存在，移到列表顶部\r\n        recentChats.value.splice(index, 1);\r\n      }\r\n      \r\n      // 添加到列表顶部\r\n      recentChats.value.unshift({\r\n        id: user.id,\r\n        username: user.username,\r\n        phone: user.phone,\r\n        photo: user.photo\r\n      });\r\n      \r\n      // 限制列表长度为10\r\n      if (recentChats.value.length > 10) {\r\n        recentChats.value.pop();\r\n      }\r\n    };\r\n    \r\n    const scrollToBottom = () => {\r\n      nextTick(() => {\r\n        if (messagesContainer.value) {\r\n          messagesContainer.value.scrollTop = messagesContainer.value.scrollHeight;\r\n        }\r\n      });\r\n    };\r\n    \r\n    const currentMessages = computed(() => {\r\n      return allChats.value[currentChatUser.value.id] || [];\r\n    });\r\n    \r\n    const getLastMessage = (userId) => {\r\n      const messages = allChats.value[userId] || [];\r\n      if (messages.length === 0) {\r\n        return '';\r\n      }\r\n      return messages[messages.length - 1].text;\r\n    };\r\n    \r\n    const getLastMessageTime = (userId) => {\r\n      const messages = allChats.value[userId] || [];\r\n      if (messages.length === 0) {\r\n        return '';\r\n      }\r\n      return formatMessageTime(messages[messages.length - 1].time);\r\n    };\r\n    \r\n    const formatMessageTime = (time) => {\r\n      if (!time) {\r\n        return '';\r\n      }\r\n      \r\n      const date = new Date(time);\r\n      const now = new Date();\r\n      \r\n      // 如果是今天的消息，显示时分\r\n      if (date.toDateString() === now.toDateString()) {\r\n        return date.toTimeString().substring(0, 5);\r\n      }\r\n      \r\n      // 如果是昨天的消息，显示\"昨天\"\r\n      const yesterday = new Date();\r\n      yesterday.setDate(now.getDate() - 1);\r\n      if (date.toDateString() === yesterday.toDateString()) {\r\n        return \"昨天\";\r\n      }\r\n      \r\n      // 否则显示月/日\r\n      return `${date.getMonth() + 1}/${date.getDate()}`;\r\n    };\r\n\r\n    return {\r\n      user,\r\n      displayName,\r\n      avatarUrl,\r\n      logout,\r\n      goToUserDetail,\r\n      isUserInfoOpen,\r\n      toggleUserInfo,\r\n      isSearchOpen,\r\n      searchKeyword,\r\n      searchResults,\r\n      isSearching,\r\n      toggleSearch,\r\n      searchUsers,\r\n      currentChatUser,\r\n      messageInput,\r\n      allChats,\r\n      recentChats,\r\n      currentMessages,\r\n      startChat,\r\n      closeChat,\r\n      sendMessage,\r\n      defaultAvatar,\r\n      API_CONFIG,\r\n      messagesContainer,\r\n      getLastMessage,\r\n      getLastMessageTime,\r\n      formatMessageTime,\r\n      getFullUrl\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* 与原UserPage.vue样式一致，新增搜索相关样式 */\r\n.user-page {\r\n  display: flex;\r\n  flex-direction: column;\r\n  height: 100vh;\r\n  background-color: #f0f2f5;\r\n}\r\n\r\n.header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  padding: 0 20px;\r\n  height: 60px;\r\n  background-color: #001529;\r\n  color: white;\r\n}\r\n\r\n.header-left {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.user-info {\r\n  display: flex;\r\n  align-items: center;\r\n  cursor: pointer;\r\n}\r\n\r\n.avatar {\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 50%;\r\n  margin-right: 10px;\r\n}\r\n\r\n.username {\r\n  margin-right: 20px;\r\n  font-size: 16px;\r\n}\r\n\r\n.logout-button {\r\n  padding: 5px 10px;\r\n  background-color: #1890ff;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n}\r\n\r\n.logout-button:hover {\r\n  background-color: #40a9ff;\r\n}\r\n\r\n.main-layout {\r\n  display: flex;\r\n  flex: 1;\r\n  overflow: hidden;\r\n}\r\n\r\n.sidebar {\r\n  width: 200px;\r\n  background-color: #001529;\r\n  color: white;\r\n  overflow-y: auto;\r\n}\r\n\r\n.menu {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 0;\r\n}\r\n\r\n.menu-item {\r\n  padding: 15px 20px;\r\n  border-bottom: 1px solid #002140;\r\n}\r\n\r\n.menu-link {\r\n  color: white;\r\n  text-decoration: none;\r\n  font-size: 14px;\r\n}\r\n\r\n.menu-link:hover {\r\n  color: #1890ff;\r\n}\r\n\r\n.menu-title {\r\n  cursor: pointer;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  font-size: 14px;\r\n}\r\n\r\n.arrow {\r\n  font-size: 12px;\r\n}\r\n\r\n.sub-menu {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 10px 0 0 20px;\r\n}\r\n\r\n.sub-menu-item {\r\n  padding: 10px 0;\r\n}\r\n\r\n.sub-menu-link {\r\n  color: white;\r\n  text-decoration: none;\r\n  font-size: 14px;\r\n}\r\n\r\n.sub-menu-link:hover {\r\n  color: #1890ff;\r\n}\r\n\r\n.main-content {\r\n  flex: 1;\r\n  padding: 20px;\r\n  background-color: white;\r\n  overflow-y: auto;\r\n  position: relative;\r\n}\r\n\r\n/* 新增侧边栏搜索区域样式 */\r\n.sidebar-search {\r\n  padding: 15px 20px;\r\n  border-bottom: 1px solid #002140;\r\n}\r\n\r\n.search-toggle {\r\n  cursor: pointer;\r\n  display: flex;\r\n  align-items: center;\r\n  font-size: 14px;\r\n}\r\n\r\n.search-toggle i {\r\n  margin-right: 10px;\r\n}\r\n\r\n.search-box {\r\n  margin-top: 10px;\r\n  background-color: #002140;\r\n  border-radius: 4px;\r\n  padding: 10px;\r\n}\r\n\r\n.search-input-group {\r\n  display: flex;\r\n  align-items: center;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.search-input-group input {\r\n  flex: 1;\r\n  padding: 8px;\r\n  border: 1px solid #003a75;\r\n  border-radius: 4px 0 0 4px;\r\n  outline: none;\r\n  background-color: #003a75;\r\n  color: white;\r\n}\r\n\r\n.search-input-group input::placeholder {\r\n  color: #8c8c8c;\r\n}\r\n\r\n.search-button, .cancel-button {\r\n  padding: 8px 12px;\r\n  background-color: #1890ff;\r\n  color: white;\r\n  border: none;\r\n  cursor: pointer;\r\n}\r\n\r\n.search-button {\r\n  border-radius: 0 4px 4px 0;\r\n}\r\n\r\n.cancel-button {\r\n  margin-left: 5px;\r\n  border-radius: 4px;\r\n  background-color: #f5222d;\r\n}\r\n\r\n.search-loading, .no-results {\r\n  padding: 10px;\r\n  text-align: center;\r\n  color: #8c8c8c;\r\n}\r\n\r\n.search-results {\r\n  max-height: 300px;\r\n  overflow-y: auto;\r\n}\r\n\r\n.search-result-item {\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 10px;\r\n  border-bottom: 1px solid #003a75;\r\n  cursor: pointer;\r\n}\r\n\r\n.search-result-item:hover {\r\n  background-color: #003a75;\r\n}\r\n\r\n.result-avatar {\r\n  width: 32px;\r\n  height: 32px;\r\n  border-radius: 50%;\r\n  margin-right: 10px;\r\n}\r\n\r\n.result-info {\r\n  flex: 1;\r\n}\r\n\r\n.result-name {\r\n  font-weight: bold;\r\n}\r\n\r\n.result-phone {\r\n  font-size: 12px;\r\n  color: #8c8c8c;\r\n}\r\n\r\n/* 聊天容器 */\r\n.chat-container {\r\n  display: flex;\r\n  flex-direction: column;\r\n  height: 100%;\r\n}\r\n\r\n.chat-header {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  padding: 10px 15px;\r\n  border-bottom: 1px solid #e5e5e5;\r\n  background-color: #f8f8f8;\r\n}\r\n\r\n.back-button {\r\n  cursor: pointer;\r\n  margin-right: 10px;\r\n}\r\n\r\n.chat-title {\r\n  font-weight: bold;\r\n  font-size: 16px;\r\n  flex: 1;\r\n  text-align: center;\r\n}\r\n\r\n.chat-options {\r\n  display: flex;\r\n}\r\n\r\n.option-button {\r\n  background: none;\r\n  border: none;\r\n  cursor: pointer;\r\n  padding: 5px;\r\n}\r\n\r\n.chat-messages {\r\n  flex: 1;\r\n  overflow-y: auto;\r\n  padding: 15px;\r\n  background-color: #f0f0f0;\r\n}\r\n\r\n.message-item {\r\n  display: flex;\r\n  margin-bottom: 15px;\r\n  max-width: 80%;\r\n}\r\n\r\n.message-from-me {\r\n  justify-content: flex-end;\r\n  margin-left: auto;\r\n}\r\n\r\n.message-from-other {\r\n  justify-content: flex-start;\r\n  margin-right: auto;\r\n}\r\n\r\n.message-avatar {\r\n  width: 32px;\r\n  height: 32px;\r\n  margin: 0 8px;\r\n}\r\n\r\n.avatar-sm {\r\n  width: 100%;\r\n  height: 100%;\r\n  border-radius: 50%;\r\n  object-fit: cover;\r\n}\r\n\r\n.message-content {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.message-bubble {\r\n  padding: 8px 12px;\r\n  border-radius: 18px;\r\n  position: relative;\r\n  max-width: 100%;\r\n}\r\n\r\n.message-from-me .message-bubble {\r\n  background-color: #95ec69;\r\n  color: #333;\r\n}\r\n\r\n.message-from-other .message-bubble {\r\n  background-color: white;\r\n  color: #333;\r\n}\r\n\r\n.message-time {\r\n  font-size: 10px;\r\n  color: #888;\r\n  text-align: center;\r\n  margin-top: 3px;\r\n}\r\n\r\n.empty-chat {\r\n  text-align: center;\r\n  color: #888;\r\n  padding-top: 20px;\r\n}\r\n\r\n.chat-input-area {\r\n  border-top: 1px solid #e5e5e5;\r\n  padding: 10px;\r\n  background-color: white;\r\n}\r\n\r\n.input-tools {\r\n  display: flex;\r\n  padding: 5px 0;\r\n}\r\n\r\n.tool-button {\r\n  background: none;\r\n  border: none;\r\n  cursor: pointer;\r\n  padding: 5px 10px;\r\n  color: #888;\r\n}\r\n\r\n.message-input-container {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.message-input-container input {\r\n  flex: 1;\r\n  padding: 8px 12px;\r\n  border: 1px solid #e5e5e5;\r\n  border-radius: 20px;\r\n  outline: none;\r\n}\r\n\r\n.send-button {\r\n  background-color: #1890ff;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 20px;\r\n  padding: 8px 15px;\r\n  margin-left: 10px;\r\n  cursor: pointer;\r\n}\r\n\r\n