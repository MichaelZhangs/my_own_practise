\n          </div>\r\n          <div class=\"info-item\">\r\n            <label>描述：</label>\r\n            <textarea v-model=\"editableUser.description\" placeholder=\"未设置\"></textarea>\r\n          </div>\r\n  \r\n          <!-- 二维码 -->\r\n          <div class=\"qr-code-section\">\r\n            <h2 @click=\"generateQrcode\">我的二维码</h2>\r\n            <div class=\"qr-code-container\">\r\n              <img :src=\"qrcodeUrl || defaultqrcode\" alt=\"我的二维码\" class=\"qr-code\" />\r\n            </div>\r\n          </div>\r\n  \r\n          <!-- 保存按钮 -->\r\n          <button @click=\"saveUserInfo\" class=\"save-button\">保存信息</button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import { computed, ref } from 'vue'\r\n  import { useStore } from 'vuex'\r\n  import defaultAvatar from '@/assets/default-avatar.png'\r\n  import defaultqrcode from '@/assets/logo.png'\r\n  import QRCode from 'qrcode'\r\n  \r\n  export default {\r\n    name: 'UserDetail',\r\n    setup() {\r\n      const store = useStore()\r\n      const user = computed(() => store.state.user)\r\n      const editableUser = ref({ ...user.value })\r\n      const qrcodeUrl = ref('')\r\n  \r\n      // 生成二维码（保持原逻辑）\r\n      const generateQrcode = async () => { /* 原代码逻辑 */ }\r\n  \r\n      // 保存用户信息（保持原逻辑）\r\n      const saveUserInfo = async () => { /* 原代码逻辑 */ }\r\n  \r\n      return { /* 原返回数据 */ }\r\n    }\r\n  }\r\n  </script>\r\n  \r\n  <style scoped>\r\n  /* 整体布局 */\r\n  .user-detail-page {\r\n    padding: 20px;\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center;\r\n  }\r\n  \r\n  .user-detail-container {\r\n    width: 100%;\r\n    max-width: 600px;\r\n  }\r\n  \r\n  /* 信息区块 */\r\n  .info-section {\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: flex-start; /* 强制左对齐 */\r\n    gap: 15px;\r\n    width: 100%;\r\n  }\r\n  \r\n  /* 头像 */\r\n  .avatar-section {\r\n    width: 100%;\r\n    display: flex;\r\n    justify-content: flex-start; /* 左对齐 */\r\n  }\r\n  \r\n  .avatar {\r\n    width: 100px;\r\n    height: 100px;\r\n    border-radius: 50%;\r\n  }\r\n  \r\n  /* 信息项 */\r\n  .info-item {\r\n    width: 100%;\r\n    display: flex;\r\n    align-items: flex-start; /* 顶部对齐 */\r\n  }\r\n  \r\n  .info-item label {\r\n    width: 80px;\r\n    text-align: left; /* 左对齐 */\r\n    font-weight: bold;\r\n    padding: 5px 10px 5px 0;\r\n  }\r\n  \r\n  .info-item input,\r\n  .info-item textarea {\r\n    flex: 1;\r\n    padding: 8px;\r\n    border: 1px solid #ddd;\r\n    border-radius: 4px;\r\n    min-width: 250px;\r\n  }\r\n  \r\n  /* 二维码区域 */\r\n  .qr-code-section {\r\n    width: 100%;\r\n    margin-top: 20px;\r\n  }\r\n  \r\n  .qr-code-section h2 {\r\n    cursor: pointer;\r\n    color: #1890ff;\r\n    margin-bottom: 10px;\r\n    text-align: left; /* 左对齐 */\r\n  }\r\n  \r\n  .qr-code-container {\r\n    display: flex;\r\n    justify-content: flex-start; /* 左对齐 */\r\n  }\r\n  \r\n  .qr-code {\r\n    width: 200px;\r\n    height: 200px;\r\n    border: 3px solid #07c160;\r\n    border-radius: 8px;\r\n    box-shadow: 0 2px 8px rgba(0,0,0,0.1);\r\n  }\r\n  \r\n  /* 保存按钮 */\r\n  .save-button {\r\n    margin-top: 30px;\r\n    padding: 12px 35px;\r\n    background: #1890ff;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 4px;\r\n    cursor: pointer;\r\n    align-self: flex-start; /* 左对齐 */\r\n    transition: background 0.3s;\r\n  }\r\n  \r\n  .save-button:hover {\r\n    background: #40a9ff;\r\n  }\r\n  \r\n  /* 响应式调整 */\r\n  @media (max-width: 768px) {\r\n    .info-item {\r\n      flex-direction: column;\r\n      gap: 5px;\r\n    }\r\n    \r\n    .info-item label {\r\n      width: 100%;\r\n      text-align: left;\r\n    }\r\n  }\r\n  </style>"],"mappings":"AAiDE,SAASA,QAAQ,EAAEC,GAAE,QAAS,KAAI;AAClC,SAASC,QAAO,QAAS,MAAK;AAC9B,OAAOC,aAAY,MAAO,6BAA4B;AACtD,OAAOC,aAAY,MAAO,mBAAkB;AAC5C,OAAOC,MAAK,MAAO,QAAO;AAE1B,eAAe;EACbC,IAAI,EAAE,YAAY;EAClBC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIN,QAAQ,CAAC;IACv