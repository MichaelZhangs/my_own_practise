{"ast":null,"code":"import { ref, onMounted, computed } from 'vue';\nimport axios from 'axios';\nimport defaultAvatar from '@/assets/default-avatar.png'; // 默认头像\n\nexport default {\n  name: 'UserList',\n  setup() {\n    const users = ref([]); // 所有用户数据\n    const searchQuery = ref({\n      username: '',\n      phone: '',\n      sex: ''\n    }); // 查询条件\n    const currentPage = ref(1); // 当前页码\n    const pageSize = 10; // 每页显示的数据量\n\n    // 获取用户列表\n    const fetchUsers = async () => {\n      try {\n        const response = await axios.get('http://127.0.0.1:8000/user/get-users', {\n          params: {\n            username: searchQuery.value.username,\n            phone: searchQuery.value.phone,\n            sex: searchQuery.value.sex,\n            page: currentPage.value,\n            page_size: pageSize\n          }\n        });\n        users.value = response.data.data; // 更新用户数据\n        totalCount.value = response.data.total; // 更新总数据量\n      } catch (error) {\n        console.error('获取用户列表失败:', error);\n      }\n    };\n\n    // 分页后的用户数据\n    const paginatedUsers = computed(() => {\n      const start = (currentPage.value - 1) * pageSize;\n      const end = start + pageSize;\n      return users.value.slice(start, end);\n    });\n\n    // 总页数\n    const totalPages = computed(() => {\n      return Math.ceil(users.value.length / pageSize);\n    });\n\n    // 上一页\n    const prevPage = () => {\n      if (currentPage.value > 1) {\n        currentPage.value--;\n      }\n    };\n\n    // 下一页\n    const nextPage = () => {\n      if (currentPage.value < totalPages.value) {\n        currentPage.value++;\n      }\n    };\n\n    // 页面加载时获取用户列表\n    onMounted(() => {\n      fetchUsers();\n    });\n    return {\n      users,\n      searchQuery,\n      paginatedUsers,\n      currentPage,\n      totalPages,\n      prevPage,\n      nextPage,\n      fetchUsers,\n      defaultAvatar\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","computed","axios","defaultAvatar","name","setup","users","searchQuery","username","phone","sex","currentPage","pageSize","fetchUsers","response","get","params","value","page","page_size","data","totalCount","total","error","console","paginatedUsers","start","end","slice","totalPages","Math","ceil","length","prevPage","nextPage"],"sources":["E:\\vue_learn\\my_vue\\my_vue\\src\\views\\UserList.vue"],"sourcesContent":["<template>\r\n    <div class=\"user-list-container\">\r\n      <h2>用户列表</h2>\r\n  \r\n      <!-- 查询框 -->\r\n      <div class=\"search-box\">\r\n        <input\r\n          v-model=\"searchQuery.username\"\r\n          placeholder=\"用户名\"\r\n          class=\"search-input\"\r\n        />\r\n        <input\r\n          v-model=\"searchQuery.phone\"\r\n          placeholder=\"手机号\"\r\n          class=\"search-input\"\r\n        />\r\n        <select v-model=\"searchQuery.sex\" class=\"search-select\">\r\n          <option value=\"\">全部性别</option>\r\n          <option value=\"male\">男</option>\r\n          <option value=\"female\">女</option>\r\n          <option value=\"other\">其他</option>\r\n        </select>\r\n        <button @click=\"fetchUsers\" class=\"search-button\">查询</button>\r\n      </div>\r\n  \r\n      <!-- 用户列表表格 -->\r\n      <table class=\"user-table\">\r\n        <thead>\r\n          <tr>\r\n            <th>ID</th>\r\n            <th>用户名</th>\r\n            <th>手机号</th>\r\n            <th>性别</th>\r\n            <th>头像</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"user in paginatedUsers\" :key=\"user.id\">\r\n            <td>{{ user.id }}</td>\r\n            <td>{{ user.username }}</td>\r\n            <td>{{ user.phone }}</td>\r\n            <td>{{ user.sex }}</td>\r\n            <td>\r\n              <img\r\n                :src=\"user.photo ? `http://127.0.0.1:8000${user.photo}` : defaultAvatar\"\r\n                alt=\"头像\"\r\n                class=\"user-avatar\"\r\n              />\r\n            </td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n  \r\n      <!-- 分页组件 -->\r\n      <div class=\"pagination\">\r\n        <button\r\n          @click=\"prevPage\"\r\n          :disabled=\"currentPage === 1\"\r\n          class=\"pagination-button\"\r\n        >\r\n          上一页\r\n        </button>\r\n        <span class=\"pagination-info\">\r\n          第 {{ currentPage }} 页 / 共 {{ totalPages }} 页\r\n        </span>\r\n        <button\r\n          @click=\"nextPage\"\r\n          :disabled=\"currentPage === totalPages\"\r\n          class=\"pagination-button\"\r\n        >\r\n          下一页\r\n        </button>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import { ref, onMounted, computed } from 'vue';\r\n  import axios from 'axios';\r\n  import defaultAvatar from '@/assets/default-avatar.png'; // 默认头像\r\n  \r\n  export default {\r\n    name: 'UserList',\r\n    setup() {\r\n      const users = ref([]); // 所有用户数据\r\n      const searchQuery = ref({\r\n        username: '',\r\n        phone: '',\r\n        sex: '',\r\n      }); // 查询条件\r\n      const currentPage = ref(1); // 当前页码\r\n      const pageSize = 10; // 每页显示的数据量\r\n  \r\n      // 获取用户列表\r\n      const fetchUsers = async () => {\r\n  try {\r\n    const response = await axios.get('http://127.0.0.1:8000/user/get-users', {\r\n      params: {\r\n        username: searchQuery.value.username,\r\n        phone: searchQuery.value.phone,\r\n        sex: searchQuery.value.sex,\r\n        page: currentPage.value,\r\n        page_size: pageSize,\r\n      },\r\n    });\r\n    users.value = response.data.data; // 更新用户数据\r\n    totalCount.value = response.data.total; // 更新总数据量\r\n  } catch (error) {\r\n    console.error('获取用户列表失败:', error);\r\n  }\r\n};\r\n  \r\n      // 分页后的用户数据\r\n      const paginatedUsers = computed(() => {\r\n        const start = (currentPage.value - 1) * pageSize;\r\n        const end = start + pageSize;\r\n        return users.value.slice(start, end);\r\n      });\r\n  \r\n      // 总页数\r\n      const totalPages = computed(() => {\r\n        return Math.ceil(users.value.length / pageSize);\r\n      });\r\n  \r\n      // 上一页\r\n      const prevPage = () => {\r\n        if (currentPage.value > 1) {\r\n          currentPage.value--;\r\n        }\r\n      };\r\n  \r\n      // 下一页\r\n      const nextPage = () => {\r\n        if (currentPage.value < totalPages.value) {\r\n          currentPage.value++;\r\n        }\r\n      };\r\n  \r\n      // 页面加载时获取用户列表\r\n      onMounted(() => {\r\n        fetchUsers();\r\n      });\r\n  \r\n      return {\r\n        users,\r\n        searchQuery,\r\n        paginatedUsers,\r\n        currentPage,\r\n        totalPages,\r\n        prevPage,\r\n        nextPage,\r\n        fetchUsers,\r\n        defaultAvatar,\r\n      };\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .user-list-container {\r\n    padding: 20px;\r\n    max-width: 1200px;\r\n    margin: 0 auto;\r\n  }\r\n  \r\n  h2 {\r\n    text-align: center;\r\n    margin-bottom: 20px;\r\n  }\r\n  \r\n  .search-box {\r\n    display: flex;\r\n    gap: 10px;\r\n    margin-bottom: 20px;\r\n  }\r\n  \r\n  .search-input {\r\n    padding: 8px;\r\n    border: 1px solid #ddd;\r\n    border-radius: 4px;\r\n    flex: 1;\r\n  }\r\n  \r\n  .search-select {\r\n    padding: 8px;\r\n    border: 1px solid #ddd;\r\n    border-radius: 4px;\r\n  }\r\n  \r\n  .search-button {\r\n    padding: 8px 16px;\r\n    background-color: #1890ff;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 4px;\r\n    cursor: pointer;\r\n  }\r\n  \r\n  .search-button:hover {\r\n    background-color: #40a9ff;\r\n  }\r\n  \r\n  .user-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    margin-bottom: 20px;\r\n  }\r\n  \r\n  .user-table th,\r\n  .user-table td {\r\n    padding: 12px;\r\n    border: 1px solid #ddd;\r\n    text-align: left;\r\n  }\r\n  \r\n  .user-table th {\r\n    background-color: #f5f5f5;\r\n    font-weight: bold;\r\n  }\r\n  \r\n  .user-table tr:hover {\r\n    background-color: #f9f9f9;\r\n  }\r\n  \r\n  .user-avatar {\r\n    width: 50px;\r\n    height: 50px;\r\n    border-radius: 50%;\r\n    object-fit: cover;\r\n  }\r\n  \r\n  .pagination {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    gap: 10px;\r\n  }\r\n  \r\n  .pagination-button {\r\n    padding: 8px 16px;\r\n    background-color: #1890ff;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 4px;\r\n    cursor: pointer;\r\n  }\r\n  \r\n  .pagination-button:disabled {\r\n    background-color: #ccc;\r\n    cursor: not-allowed;\r\n  }\r\n  \r\n  .pagination-info {\r\n    font-size: 14px;\r\n    color: #666;\r\n  }\r\n  </style>"],"mappings":"AA6EE,SAASA,GAAG,EAAEC,SAAS,EAAEC,QAAO,QAAS,KAAK;AAC9C,OAAOC,KAAI,MAAO,OAAO;AACzB,OAAOC,aAAY,MAAO,6BAA6B,EAAE;;AAEzD,eAAe;EACbC,IAAI,EAAE,UAAU;EAChBC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIP,GAAG,CAAC,EAAE,CAAC,EAAE;IACvB,MAAMQ,WAAU,GAAIR,GAAG,CAAC;MACtBS,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,GAAG,EAAE;IACP,CAAC,CAAC,EAAE;IACJ,MAAMC,WAAU,GAAIZ,GAAG,CAAC,CAAC,CAAC,EAAE;IAC5B,MAAMa,QAAO,GAAI,EAAE,EAAE;;IAErB;IACA,MAAMC,UAAS,GAAI,MAAAA,CAAA,KAAY;MACnC,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMZ,KAAK,CAACa,GAAG,CAAC,sCAAsC,EAAE;UACvEC,MAAM,EAAE;YACNR,QAAQ,EAAED,WAAW,CAACU,KAAK,CAACT,QAAQ;YACpCC,KAAK,EAAEF,WAAW,CAACU,KAAK,CAACR,KAAK;YAC9BC,GAAG,EAAEH,WAAW,CAACU,KAAK,CAACP,GAAG;YAC1BQ,IAAI,EAAEP,WAAW,CAACM,KAAK;YACvBE,SAAS,EAAEP;UACb;QACF,CAAC,CAAC;QACFN,KAAK,CAACW,KAAI,GAAIH,QAAQ,CAACM,IAAI,CAACA,IAAI,EAAE;QAClCC,UAAU,CAACJ,KAAI,GAAIH,QAAQ,CAACM,IAAI,CAACE,KAAK,EAAE;MAC1C,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,WAAW,EAAEA,KAAK,CAAC;MACnC;IACF,CAAC;;IAEK;IACA,MAAME,cAAa,GAAIxB,QAAQ,CAAC,MAAM;MACpC,MAAMyB,KAAI,GAAI,CAACf,WAAW,CAACM,KAAI,GAAI,CAAC,IAAIL,QAAQ;MAChD,MAAMe,GAAE,GAAID,KAAI,GAAId,QAAQ;MAC5B,OAAON,KAAK,CAACW,KAAK,CAACW,KAAK,CAACF,KAAK,EAAEC,GAAG,CAAC;IACtC,CAAC,CAAC;;IAEF;IACA,MAAME,UAAS,GAAI5B,QAAQ,CAAC,MAAM;MAChC,OAAO6B,IAAI,CAACC,IAAI,CAACzB,KAAK,CAACW,KAAK,CAACe,MA