mmentInput = $event,\n      type: \"text\",\n      placeholder: \"发表评论...\",\n      class: \"flex-1 border border-gray-300 rounded-md p-2 mr-2\"\n    }, null, 8 /* PROPS */, _hoisted_5), [[_vModelText, moment.commentInput]]), _createElementVNode(\"button\", {\n      onClick: $event => $setup.postComment(moment.id),\n      disabled: !moment.commentInput.trim(),\n      class: _normalizeClass([{\n        'bg-green-500 text-white': moment.commentInput.trim(),\n        'bg-gray-300 text-gray-500': !moment.commentInput.trim()\n      }, \"px-4 py-2 rounded-md hover:bg-green-600\"])\n    }, \" 发布 \", 10 /* CLASS, PROPS */, _hoisted_6)])) : _createCommentVNode(\"v-if\", true), _createCommentVNode(\" 评论展示区域 \"), moment.comments && moment.comments.length > 0 ? (_openBlock(), _createElementBlock(\"ul\", _hoisted_7, [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList(moment.comments.slice(0, $setup.showAllComments ? moment.comments.length : 3), (comment, index) => {\n      return _openBlock(), _createElementBlock(\"li\", {\n        key: index,\n        class: \"comment-item border-b border-gray-100 py-4\"\n      }, [_createCommentVNode(\" 其他代码不变 \"), _createCommentVNode(\" 评论的点赞和评论按钮 \"), _createElementVNode(\"div\", _hoisted_8, [_createElementVNode(\"div\", {\n        class: \"comment-like flex items-center space-x-1 cursor-pointer\",\n        onClick: $event => $setup.likeComment(moment.id, index)\n      }, [_createElementVNode(\"i\", {\n        class: _normalizeClass([\"fa-solid fa-thumbs-up\", {\n          'liked': comment.isLiked\n        }])\n      }, null, 2 /* CLASS */), _createElementVNode(\"span\", null, _toDisplayString(comment.likes), 1 /* TEXT */)], 8 /* PROPS */, _hoisted_9), _createElementVNode(\"div\", {\n        class: \"comment-comment flex items-center space-x-1 cursor-pointer\",\n        onClick: $event => $setup.commentOnComment(moment.id, index)\n      }, [_cache[1] || (_cache[1] = _createElementVNode(\"i\", {\n        class: \"fa-solid fa-comment\"\n      }, null, -1 /* HOISTED */)), _createElementVNode(\"span\", null, _toDisplayString(comment.commentsCount), 1 /* TEXT */)], 8 /* PROPS */, _hoisted_10), _createCommentVNode(\" 新增评论回复输入框相关代码 \"), comment.showReplyInput ? (_openBlock(), _createElementBlock(\"div\", _hoisted_11, [_withDirectives(_createElementVNode(\"input\", {\n        \"onUpdate:modelValue\": $event => comment.replyInput = $event,\n        type: \"text\",\n        placeholder: \"回复评论...\",\n        class: \"flex-1 border border-gray-300 rounded-md p-2 mr-2\"\n      }, null, 8 /* PROPS */, _hoisted_12), [[_vModelText, comment.replyInput]]), _createElementVNode(\"button\", {\n        onClick: $event => _ctx.postReply(moment.id, index),\n        disabled: !comment.replyInput.trim(),\n        class: _normalizeClass([{\n          'bg-green-500 text-white': comment.replyInput.trim(),\n          'bg-gray-300 text-gray-500': !comment.replyInput.trim()\n        }, \"px-4 py-2 rounded-md hover:bg-green-600\"])\n      }, \" 回复 \", 10 /* CLASS, PROPS */, _hoisted_13)])) : _createCommentVNode(\"v-if\", true)])]);\n    }), 128 /* KEYED_FRAGMENT */)), _createCommentVNode(\" 如果评论数大于3，显示展开按钮 \"), moment.comments.length > 3 && !$setup.showAllComments ? (_openBlock(), _createElementBlock(\"li\", {\n      key: 0,\n      class: \"show-more-comments text-blue-500 cursor-pointer\",\n      onClick: _cache[0] || (_cache[0] = $event => $setup.showAllComments = true)\n    }, \" 展开查看全部评论 \")) : _createCommentVNode(\"v-if\", true)])) : _createCommentVNode(\"v-if\", true)]);\n  }), 128 /* KEYED_FRAGMENT */))]), $setup.noMore ? (_openBlock(), _createElementBlock(\"div\", _hoisted_14, \"没有其他的内容了哦\")) : _createCommentVNode(\"v-if\", true)])]);\n}","map":{"version":3,"names":["class","key","_createElementBlock","_hoisted_1","_createCommentVNode","_createElementVNode","_hoisted_2","_hoisted_3","_Fragment","_renderList","$setup","moments","moment","id","showCommentInput","_hoisted_4","$event","commentInput","type","placeholder","_hoisted_5","onClick","postComment","disabled","trim","_normalizeClass","_hoisted_6","comments","length","_hoisted_7","slice","showAllComments","comment","index","_hoisted_8","likeComment","isLiked","_toDisplayString","likes","_hoisted_9","commentOnComment","commentsCount","_hoisted_10","showReplyInput","_hoisted_11","replyInput","_hoisted_12","_ctx","postReply","_hoisted_13","_cache","noMore","_hoisted_14"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\article\\UserMoments.vue"],"sourcesContent":["<template>\r\n    <div class=\"moments-page\">\r\n        <!-- 其他代码不变 -->\r\n        <div class=\"moments-container\">\r\n            <div class=\"moments-list\">\r\n                <div\r\n                    v-for=\"moment in moments\"\r\n                    :key=\"moment.id\"\r\n                    class=\"moment-item\"\r\n                >\r\n                    <!-- 其他代码不变 -->\r\n                    <!-- 评论输入框，初始隐藏 -->\r\n                    <div v-if=\"moment.showCommentInput\" class=\"comment-input-area flex items-center mt-2\">\r\n                        <input\r\n                            v-model=\"moment.commentInput\"\r\n                            type=\"text\"\r\n                            placeholder=\"发表评论...\"\r\n                            class=\"flex-1 border border-gray-300 rounded-md p-2 mr-2\"\r\n                        />\r\n                        <button\r\n                            @click=\"postComment(moment.id)\"\r\n                            :disabled=\"!moment.commentInput.trim()\"\r\n                            :class=\"{ 'bg-green-500 text-white': moment.commentInput.trim(), 'bg-gray-300 text-gray-500':!moment.commentInput.trim() }\"\r\n                            class=\"px-4 py-2 rounded-md hover:bg-green-600\"\r\n                        >\r\n                            发布\r\n                        </button>\r\n                    </div>\r\n                    <!-- 评论展示区域 -->\r\n                    <ul v-if=\"moment.comments && moment.comments.length > 0\" class=\"comments-list\">\r\n                        <li\r\n                            v-for=\"(comment, index) in moment.comments.slice(0, showAllComments? moment.comments.length : 3)\"\r\n                            :key=\"index\"\r\n                            class=\"comment-item border-b border-gray-100 py-4\"\r\n                        >\r\n                            <!-- 其他代码不变 -->\r\n                            <!-- 评论的点赞和评论按钮 -->\r\n                            <div class=\"comment-actions flex justify-end space-x-4 mt-2 text-sm text-gray-500\">\r\n                                <div class=\"comment-like flex items-center space-x-1 cursor-pointer\" @click=\"likeComment(moment.id, index)\">\r\n                                    <i\r\n                                        class=\"fa-solid fa-thumbs-up\"\r\n                                        :class=\"{ 'liked': comment.isLiked }\"\r\n                                    ></i>\r\n                                    <span>{{ comment.likes }}</span>\r\n                                </div>\r\n                                <div class=\"comment-comment flex items-center space-x-1 cursor-pointer\" @click=\"commentOnComment(moment.id, index)\">\r\n                                    <i class=\"fa-solid fa-comment\"></i>\r\n                                    <span>{{ comment.commentsCount }}</span>\r\n                                </div>\r\n                                <!-- 新增评论回复输入框相关代码 -->\r\n                                <div v-if=\"comment.showReplyInput\" class=\"reply-input-area flex items-center mt-2\">\r\n                                    <input\r\n                                        v-model=\"comment.replyInput\"\r\n                                        type=\"text\"\r\n                                        placeholder=\"回复评论...\"\r\n                                        class=\"flex-1 border border-gray-300 rounded-md p-2 mr-2\"\r\n                                    />\r\n                                    <button\r\n                                        @click=\"postReply(moment.id, index)\"\r\n                                        :disabled=\"!comment.replyInput.trim()\"\r\n                                        :class=\"{ 'bg-green-500 text-white': comment.replyInput.trim(), 'bg-gray-300 text-gray-500':!comment.replyInput.trim() }\"\r\n                                        class=\"px-4 py-2 rounded-md hover:bg-green-600\"\r\n                                    >\r\n                                        回复\r\n                                    </button>\r\n                                </div>\r\n                            </div>\r\n                        </li>\r\n                        <!-- 如果评论数大于3，显示展开按钮 -->\r\n                        <li v-if=\"moment.comments.length > 3 &&!showAllComments\" class=\"show-more-comments text-blue-500 cursor-pointer\" @click=\"showAllComments = true\">\r\n                            展开查看全部评论\r\n                        </li>\r\n                    </ul>\r\n                </div>\r\n            </div>\r\n            <div v-if=\"noMore\" class=\"no-more-message text-center text-gray-500 py-4\">没有其他的内容了哦</div>\r\n        </div>\r\n    </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted, onUnmounted, computed } from 'vue';\r\nimport { useRouter } from 'vue-router';\r\nimport { useStore } from 'vuex';\r\nimport axios from 'axios';\r\nimport DOMPurify from 'dompurify';\r\nimport defaultAvatar from '@/assets/default-avatar.png';\r\nimport { API_CONFIG } from '@/config/config';\r\nimport { ElMessage } from 'element-plus';\r\n\r\nexport default {\r\n  setup() {\r\n      const router = useRouter();\r\n      const store = useStore();\r\n      const moments = ref([]);\r\n      const loading = ref(false);\r\n      const noMore = ref(false);\r\n      const lastId = ref(null);\r\n      const pageSize = 10;\r\n      const showAllComments = ref(false);\r\n\r\n      const goToUser = () => {\r\n          router.push('/user');\r\n      };\r\n\r\n      const goToUserProfile = (userId) => {\r\n          router.push(`/user/${userId}`);\r\n      };\r\n\r\n      const currentUser = computed(() => store.state.user || {});\r\n\r\n      const getFullUrl = (path) => {\r\n          if (!path || path === defaultAvatar) {\r\n              return path;\r\n          }\r\n          return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`;\r\n      };\r\n\r\n      const openImagePreview = (url) => {\r\n          window.open(url, '_blank');\r\n      };\r\n\r\n      const openMediaPreview = (url) => {\r\n          if (url.match(/\\.(mp4|mov|avi)$/i)) {\r\n              window.open(url, '_blank');\r\n          } else {\r\n              window.open(url, '_blank');\r\n          }\r\n      };\r\n\r\n      const getVideoType = (url) => {\r\n          const extension = url.split('.').pop().toLowerCase();\r\n          switch (extension) {\r\n              case 'mp4':\r\n                  return 'video/mp4';\r\n              case 'mov':\r\n                  return 'video/quicktime';\r\n              case 'avi':\r\n                  return 'video/x-msvideo';\r\n              default:\r\n                  return 'video/mp4';\r\n          }\r\n      };\r\n\r\n      const fetchMoments = async () => {\r\n          if (loading.value || noMore.value) return;\r\n\r\n          loading.value = true;\r\n          try {\r\n              const params = {\r\n                  limit: pageSize,\r\n                  last_id: lastId.value\r\n              };\r\n\r\n              const response = await axios.get(`${API_CONFIG.BASE_URL}/article/moments`, {\r\n                  headers: {\r\n                      Authorization: `Bearer ${store.state.token}`\r\n                  },\r\n                  params\r\n              });\r\n\r\n              const newMoments = response.data.map(moment => ({\r\n                  ...moment,\r\n                  user_id: moment.user_id,\r\n                  user: {\r\n                      username: moment.user?.username || '未知用户',\r\n                      photo: moment.user?.photo || '',\r\n                  },\r\n                  isLiked: moment.like_users?.includes(currentUser.value.id) || false,\r\n                  commentInput: '',\r\n                  showCommentInput: false,\r\n                  comments: moment.comments || []\r\n              }));\r\n\r\n              if (newMoments.length < pageSize) {\r\n                  noMore.value = true;\r\n              }\r\n\r\n              moments.value = [...moments.value, ...newMoments];\r\n              lastId.value = newMoments[newMoments.length - 1]?.id;\r\n          } catch (error) {\r\n              console.error('获取动态失败:', error);\r\n          } finally {\r\n              loading.value = false;\r\n          }\r\n      };\r\n\r\n      const formatTime = (timestamp) => {\r\n          const date = new Date(timestamp);\r\n          return `${date.getFullYear()}-${(date.getMonth() + 1).toString().padStart(2, '0')}-${date.getDate().toString().padStart(2, '0')} \r\n    ${date.getHours().toString().padStart(2, '0')}:${date.getMinutes().toString().padStart(2, '0')}`;\r\n      };\r\n\r\n      const getTimeAgo = (timestamp) => {\r\n          const now = new Date();\r\n          const created = new Date(timestamp);\r\n          const diff = now - created;\r\n\r\n          const minutes = Math.floor(diff / (1000 * 60));\r\n          const hours = Math.floor(diff / (1000 * 60 * 60));\r\n          const days = Math.floor(diff / (1000 * 60 * 60 * 24));\r\n\r\n          if (minutes < 1) {\r\n              return '刚刚';\r\n          } else if (minutes < 60) {\r\n              return `${minutes} 分钟前`;\r\n          } else if (hours < 24) {\r\n              return `${hours} 小时前`;\r\n          } else {\r\n              return `${days} 天前`;\r\n          }\r\n      };\r\n\r\n      const sanitizeHtml = (html) => {\r\n          return DOMPurify.sanitize(html);\r\n      };\r\n\r\n      const handleScroll = () => {\r\n          const { scrollTop, clientHeight, scrollHeight } = document.documentElement;\r\n          if (scrollTop + clientHeight >= scrollHeight - 100 &&!loading.value &&!noMore.value) {\r\n              fetchMoments();\r\n          }\r\n      };\r\n\r\n      const deleteMoment = async (momentId) => {\r\n          try {\r\n              await axios.post(`${API_CONFIG.BASE_URL}/article/delete/moment`, {\r\n                  moment_id: momentId\r\n              }, {\r\n                  headers: {\r\n                      Authorization: `Bearer ${store.state.token}`\r\n                  }\r\n              });\r\n              moments.value = moments.value.filter(moment => moment.id!== momentId);\r\n              ElMessage.success('动态删除成功');\r\n          } catch (error) {\r\n              console.error('删除动态失败:', error);\r\n              ElMessage.error('删除动态失败，请稍后重试');\r\n          }\r\n      };\r\n\r\n      const likeMoment = async (momentId) => {\r\n          const targetMoment = moments.value.find(moment => moment.id === momentId);\r\n          if (!targetMoment) return;\r\n\r\n          const originalIsLiked = targetMoment.isLiked;\r\n          const originalLikes = targetMoment.stats.likes;\r\n\r\n          try {\r\n              targetMoment.isLiked =!targetMoment.isLiked;\r\n              targetMoment.stats.likes += targetMoment.isLiked? 1 : -1;\r\n\r\n              const response = await axios.post(`${API_CONFIG.BASE_URL}/article/like_moment`, {\r\n                  moment_id: momentId,\r\n                  user_id: currentUser.value.id,\r\n                  is_like: targetMoment.isLiked\r\n              }, {\r\n                  headers: {\r\n                      Authorization: `Bearer ${store.state.token}`\r\n                  },\r\n                  timeout: 5000\r\n              });\r\n\r\n              if (response.data.success) {\r\n                  if (!targetMoment.stats) {\r\n                      targetMoment.stats = { likes: 0 };\r\n                  }\r\n\r\n                  targetMoment.isLiked = response.data.likes > targetMoment.stats.likes;\r\n                  targetMoment.stats.likes = response.data.likes;\r\n                  ElMessage.success(targetMoment.isLiked? '点赞成功' : '已取消点赞');\r\n\r\n                  targetMoment.isLiked = response.data.is_liked;\r\n                  targetMoment.stats.likes = response.data.likes_count;\r\n\r\n                  if (response.data.is_liked) {\r\n                      targetMoment.like_users = [\r\n                          ...(targetMoment.like_users || []),\r\n                          currentUser.value.id\r\n                      ];\r\n                  } else {\r\n                      targetMoment.like_users = (targetMoment.like_users || [])\r\n                         .filter(id => id!== currentUser.value.id);\r\n                  }\r\n              }\r\n          } catch (error) {\r\n              targetMoment.isLiked = originalIsLiked;\r\n              targetMoment.stats.likes = originalLikes;\r\n\r\n              console.error('点赞操作失败:', error);\r\n              ElMessage.error(`操作失败: ${error.response?.data?.msg || '网络错误'}`);\r\n          }\r\n      };\r\n\r\n      const toggleCommentInput = (moment) => {\r\n          moment.showCommentInput =!moment.showCommentInput;\r\n          if (moment.showCommentInput) {\r\n              moment.commentInput = '';\r\n          }\r\n      };\r\n\r\n      const postComment = async (momentId) => {\r\n          const targetMoment = moments.value.find(moment => moment.id === momentId);\r\n          const commentText = targetMoment.commentInput;\r\n          if (commentText.trim() === '') {\r\n              ElMessage.warning('评论内容不能为空');\r\n              return;\r\n          }\r\n          try {\r\n              const response = await axios.post(`${API_CONFIG.BASE_URL}/article/post_comment`, {\r\n                  moment_id: momentId,\r\n                  comment_user_id: currentUser.value.id,\r\n                  comment_user_name: currentUser.value.username,\r\n                  comment: commentText\r\n              }, {\r\n                  headers: {\r\n                      Authorization: `Bearer ${store.state.token}`\r\n                  }\r\n              });\r\n              if (response.data.success) {\r\n                  targetMoment.stats.comments = (targetMoment.stats.comments || 0) + 1;\r\n                  const newComment = {\r\n                      moment_id: momentId,\r\n                      comment: commentText,\r\n                      created_at: new Date(),\r\n                      comment_user_name: currentUser.value.username,\r\n                      comment_user_id: currentUser.value.id,\r\n                      comment_user_photo: currentUser.value.photo,\r\n                      isLiked: false,\r\n                      likes: 0,\r\n                      commentsCount: 0\r\n                  };\r\n                  targetMoment.comments.push(newComment);\r\n                  targetMoment.commentInput = '';\r\n                  targetMoment.showCommentInput = false;\r\n                  ElMessage.success('评论发布成功');\r\n              } else {\r\n                  ElMessage.error('评论发布失败，请稍后重试');\r\n              }\r\n          } catch (error) {\r\n              console.error('评论发布失败:', error);\r\n              ElMessage.error('评论发布失败，请稍后重试');\r\n          }\r\n      };\r\n\r\n      const commentIconClick = (moment) => {\r\n          toggleCommentInput(moment);\r\n      };\r\n\r\n      const likeComment = async (momentId, commentIndex) => {\r\n          const targetMoment = moments.value.find(moment => moment.id === momentId);\r\n          const targetComment = targetMoment.comments[commentIndex];\r\n          if (!targetComment) return;\r\n\r\n          const originalIsLiked = targetComment.isLiked;\r\n          const originalLikes = targetComment.likes;\r\n\r\n          try {\r\n              targetComment.isLiked =!targetComment.isLiked;\r\n              targetComment.likes += targetComment.isLiked? 1 : -1;\r\n\r\n              const response = await axios.post(`${API_CONFIG.BASE_URL}/article/like_comment`, {\r\n                  moment_id: momentId,\r\n                  comment_index: commentIndex,\r\n                  user_id: currentUser.value.id,\r\n                  is_like: targetComment.isLiked\r\n              }, {\r\n                  headers: {\r\n                      Authorization: `Bearer ${store.state.token}`\r\n                  },\r\n                  timeout: 5000\r\n              });\r\n\r\n              if (response.data.success) {\r\n                  targetComment.isLiked = response.data.is_liked;\r\n                  targetComment.likes = response.data.likes_count;\r\n              }\r\n          } catch (error) {\r\n              targetComment.isLiked = originalIsLiked;\r\n              targetComment.likes = originalLikes;\r\n\r\n              console.error('评论点赞操作失败:', error);\r\n          }\r\n      };\r\n\r\n      const commentOnComment = (momentId, commentIndex) => {\r\n          // 这里可以弹出评论框或者跳转到新页面进行评论，具体逻辑根据实际需求实现\r\n          console.log(`对第 ${commentIndex} 条评论进行评论，动态id为 ${momentId}`);\r\n      };\r\n\r\n      onMounted(() => {\r\n          fetchMoments();\r\n          window.addEventListener('scroll', handleScroll);\r\n      });\r\n\r\n      onUnmounted(() => {\r\n          window.removeEventListener('scroll', handleScroll);\r\n      });\r\n\r\n      return {\r\n          getFullUrl,\r\n          openImagePreview,\r\n          moments,\r\n          currentUser,\r\n          formatTime,\r\n          sanitizeHtml,\r\n          defaultAvatar,\r\n          openMediaPreview,\r\n          getVideoType,\r\n          goToUser,\r\n          goToPublish: () => router.push('/publish'),\r\n          noMore,\r\n          loading,\r\n          getTimeAgo,\r\n          deleteMoment,\r\n          likeMoment,\r\n     