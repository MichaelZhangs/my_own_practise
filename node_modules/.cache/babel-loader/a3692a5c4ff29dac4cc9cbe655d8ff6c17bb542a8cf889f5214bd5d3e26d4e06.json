{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { computed, ref, onMounted, onUnmounted, closeEvent, nextTick, watch } from 'vue';\nimport { useRoute, useRouter } from 'vue-router';\nimport { useStore } from 'vuex';\nimport defaultAvatar from '@/assets/default-avatar.png';\nimport { API_CONFIG } from '@/config/config';\nimport { ElMessage, ElNotification } from 'element-plus';\nimport axios from 'axios';\nexport default {\n  setup() {\n    const route = useRoute();\n    const router = useRouter();\n    const store = useStore();\n    const messagesContainer = ref(null);\n    const targetUser = ref({});\n    const messages = ref([]);\n    const inputMessage = ref('');\n    const myAvatar = computed(() => {\n      const user = store.state.user;\n      return user.photo ? `${API_CONFIG.BASE_URL}${user.photo}` : defaultAvatar;\n    });\n    const socket = ref(null);\n    const isConnected = ref(false);\n    const reconnecting = ref(false);\n    const reconnectTimer = ref(null);\n    const myId = computed(() => store.state.user.id);\n\n    // 工具方法：处理图片URL\n    const getFullUrl = path => {\n      if (!path || path === defaultAvatar) return path;\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`;\n    };\n\n    // 工具方法：格式化时间\n    const formatTime = time => {\n      if (!time) return '';\n      const date = new Date(time);\n      const now = new Date();\n      if (date.toDateString() === now.toDateString()) {\n        return date.toTimeString().substring(0, 5);\n      }\n      const yesterday = new Date();\n      yesterday.setDate(now.getDate() - 1);\n      if (date.toDateString() === yesterday.toDateString()) {\n        return '昨天';\n      }\n      return `${date.getMonth() + 1}/${date.getDate()}`;\n    };\n\n    // 初始化WebSocket连接\n    const initWebSocket = () => {\n      if (myId.value && targetUser.value.id) {\n        const wsUrl = `ws://${window.location.host}/ws/chat/${myId.value}/${targetUser.value.id}`;\n        if (socket.value) {\n          socket.value.close();\n        }\n        socket.value = new WebSocket(wsUrl);\n        socket.value.onopen = () => {\n          isConnected.value = true;\n          ElNotification({\n            title: '连接成功',\n            message: '已建立聊天连接',\n            type: 'success',\n            duration: 3000\n          });\n        };\n        socket.value.onmessage = event => {\n          // 这里的event参数被使用，保留\n          try {\n            const msg = JSON.parse(event.data);\n            addMessage({\n              id: msg.id,\n              text: msg.text,\n              fromMe: false,\n              time: msg.time\n            });\n          } catch (e) {\n            console.error('解析消息失败', e);\n          }\n        };\n        socket.value.onclose = closeEvent => {\n          // 重命名为closeEvent并使用\n          isConnected.value = false;\n          ElNotification({\n            title: '连接断开',\n            message: '聊天连接已断开，正在尝试重连...',\n            type: 'warning',\n            duration: 0\n          });\n          if (!reconnecting.value) {\n            startReconnect();\n          }\n        };\n        socket.value.onerror = errorEvent => {\n          // 重命名为errorEvent并使用\n          console.error('WebSocket错误', errorEvent);\n          ElMessage.error('聊天连接错误，请稍后再试');\n        };\n      }\n    };\n\n    // 开始重连\n    const startReconnect = () => {\n      if (reconnecting.value) return;\n      reconnecting.value = true;\n      reconnectTimer.value = setTimeout(() => {\n        initWebSocket();\n        reconnecting.value = false;\n      }, 3000);\n    };\n\n    // 停止重连\n    const stopReconnect = () => {\n      if (reconnectTimer.value) {\n        clearTimeout(reconnectTimer.value);\n        reconnectTimer.value = null;\n        reconnecting.value = false;\n      }\n    };\n\n    // 添加消息到列表\n    const addMessage = msg => {\n      messages.value.push(msg);\n      nextTick(() => {\n        if (messagesContainer.value) {\n          messagesContainer.value.scrollTop = messagesContainer.value.scrollHeight;\n        }\n      });\n    };\n\n    // 发送消息\n    const sendMessage = () => {\n      if (!inputMessage.value.trim() || !isConnected.value) {\n        if (!isConnected.value) {\n          ElMessage.warning('当前连接已断开，消息发送失败');\n        }\n        return;\n      }\n      const msg = {\n        id: Date.now(),\n        text: inputMessage.value.trim(),\n        fromMe: true,\n        time: new Date().toISOString()\n      };\n      addMessage(msg);\n      inputMessage.value = '';\n      try {\n        socket.value.send(JSON.stringify({\n          id: msg.id,\n          text: msg.text,\n          time: msg.time,\n          from: myId.value,\n          to: targetUser.value.id\n        }));\n      } catch (error) {\n        console.error('发送消息失败', error);\n        ElMessage.error('消息发送失败，请稍后再试');\n      }\n    };\n\n    // 返回上一页\n    const goBack = () => {\n      router.back();\n      stopReconnect();\n      if (socket.value) {\n        socket.value.close();\n      }\n    };\n\n    // 监听路由参数变化\n    watch(() => route.params.userId, newId => {\n      if (newId) {\n        // 获取目标用户信息\n        axios.get(`${API_CONFIG.BASE_URL}/user/userinfo/${newId}`, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        }).then(res => {\n          targetUser.value = res.data;\n          initWebSocket();\n        }).catch(err => {\n          console.error('获取用户信息失败', err);\n          ElMessage.error('获取用户信息失败');\n          router.back();\n        });\n      }\n    });\n    onMounted(() => {\n      if (route.params.userId) {\n        // 初始化时获取目标用户信息\n        axios.get(`${API_CONFIG.BASE_URL}/user/userinfo/${route.params.userId}`, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        }).then(res => {\n          targetUser.value = res.data;\n          initWebSocket();\n        }).catch(err => {\n          console.error('获取用户信息失败', err);\n          ElMessage.error('获取用户信息失败');\n          router.back();\n        });\n      }\n    });\n    onUnmounted(() => {\n      stopReconnect();\n      if (socket.value) {\n        socket.value.close();\n      }\n    });\n    return {\n      targetUser,\n      messages,\n      inputMessage,\n      myAvatar,\n      getFullUrl,\n      formatTime,\n      sendMessage,\n      goBack,\n      messagesContainer,\n      isConnected\n    };\n  }\n};","map":{"version":3,"names":["computed","ref","onMounted","onUnmounted","closeEvent","nextTick","watch","useRoute","useRouter","useStore","defaultAvatar","API_CONFIG","ElMessage","ElNotification","axios","setup","route","router","store","messagesContainer","targetUser","messages","inputMessage","myAvatar","user","state","photo","BASE_URL","socket","isConnected","reconnecting","reconnectTimer","myId","id","getFullUrl","path","startsWith","formatTime","time","date","Date","now","toDateString","toTimeString","substring","yesterday","setDate","getDate","getMonth","initWebSocket","value","wsUrl","window","location","host","close","WebSocket","onopen","title","message","type","duration","onmessage","event","msg","JSON","parse","data","addMessage","text","fromMe","e","console","error","onclose","startReconnect","onerror","errorEvent","setTimeout","stopReconnect","clearTimeout","push","scrollTop","scrollHeight","sendMessage","trim","warning","toISOString","send","stringify","from","to","goBack","back","params","userId","newId","get","headers","Authorization","token","then","res","catch","err"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\views\\ChatView.vue"],"sourcesContent":["<template>\r\n  <div class=\"chat-view\">\r\n    <div class=\"chat-header\">\r\n      <div class=\"back-button\" @click=\"goBack\">\r\n        <i class=\"fa fa-arrow-left\" aria-hidden=\"true\"></i>\r\n      </div>\r\n      <div class=\"chat-title\">{{ targetUser.username || '聊天' }}</div>\r\n      <div class=\"chat-avatar\">\r\n        <img :src=\"getFullUrl(targetUser.photo)\" alt=\"对方头像\" class=\"avatar\" />\r\n      </div>\r\n    </div>\r\n    \r\n    <div class=\"chat-messages\" ref=\"messagesContainer\">\r\n      <div v-if=\"messages.length === 0\" class=\"empty-chat\">\r\n        开始和 {{ targetUser.username || '对方' }} 聊天吧\r\n      </div>\r\n      \r\n      <div \r\n        v-for=\"(msg, index) in messages\" \r\n        :key=\"msg.id || index\" \r\n        :class=\"['message-item', msg.fromMe ? 'from-me' : 'from-other']\"\r\n      >\r\n        <div class=\"message-avatar\">\r\n          <img \r\n            :src=\"msg.fromMe ? myAvatar : getFullUrl(targetUser.photo)\" \r\n            alt=\"头像\" \r\n            class=\"avatar-sm\"\r\n          />\r\n        </div>\r\n        \r\n        <div class=\"message-content\">\r\n          <div class=\"message-bubble\">{{ msg.text }}</div>\r\n          <div class=\"message-time\">{{ formatTime(msg.time) }}</div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    \r\n    <div class=\"chat-input-area\">\r\n      <input \r\n        type=\"text\" \r\n        v-model=\"inputMessage\" \r\n        placeholder=\"输入消息...\" \r\n        @keyup.enter=\"sendMessage\"\r\n      />\r\n      <button class=\"send-button\" @click=\"sendMessage\">\r\n        <i class=\"fa fa-paper-plane\" aria-hidden=\"true\"></i>\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { computed, ref, onMounted, onUnmounted,closeEvent, nextTick, watch } from 'vue';\r\nimport { useRoute, useRouter } from 'vue-router';\r\nimport { useStore } from 'vuex';\r\nimport defaultAvatar from '@/assets/default-avatar.png';\r\nimport { API_CONFIG } from '@/config/config';\r\nimport { ElMessage, ElNotification } from 'element-plus';\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  setup() {\r\n    const route = useRoute();\r\n    const router = useRouter();\r\n    const store = useStore();\r\n    const messagesContainer = ref(null);\r\n    const targetUser = ref({});\r\n    const messages = ref([]);\r\n    const inputMessage = ref('');\r\n    const myAvatar = computed(() => {\r\n      const user = store.state.user;\r\n      return user.photo ? `${API_CONFIG.BASE_URL}${user.photo}` : defaultAvatar;\r\n    });\r\n    const socket = ref(null);\r\n    const isConnected = ref(false);\r\n    const reconnecting = ref(false);\r\n    const reconnectTimer = ref(null);\r\n    const myId = computed(() => store.state.user.id);\r\n    \r\n    // 工具方法：处理图片URL\r\n    const getFullUrl = (path) => {\r\n      if (!path || path === defaultAvatar) return path;\r\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`;\r\n    };\r\n    \r\n    // 工具方法：格式化时间\r\n    const formatTime = (time) => {\r\n      if (!time) return '';\r\n      const date = new Date(time);\r\n      const now = new Date();\r\n      \r\n      if (date.toDateString() === now.toDateString()) {\r\n        return date.toTimeString().substring(0, 5);\r\n      }\r\n      \r\n      const yesterday = new Date();\r\n      yesterday.setDate(now.getDate() - 1);\r\n      if (date.toDateString() === yesterday.toDateString()) {\r\n        return '昨天';\r\n      }\r\n      \r\n      return `${date.getMonth() + 1}/${date.getDate()}`;\r\n    };\r\n    \r\n    // 初始化WebSocket连接\r\n    const initWebSocket = () => {\r\n      if (myId.value && targetUser.value.id) {\r\n        const wsUrl = `ws://${window.location.host}/ws/chat/${myId.value}/${targetUser.value.id}`;\r\n        \r\n        if (socket.value) {\r\n          socket.value.close();\r\n        }\r\n        \r\n        socket.value = new WebSocket(wsUrl);\r\n        \r\n        socket.value.onopen = () => {\r\n          isConnected.value = true;\r\n          ElNotification({\r\n            title: '连接成功',\r\n            message: '已建立聊天连接',\r\n            type: 'success',\r\n            duration: 3000\r\n          });\r\n        };\r\n        \r\n        socket.value.onmessage = (event) => {  // 这里的event参数被使用，保留\r\n          try {\r\n            const msg = JSON.parse(event.data);\r\n            addMessage({\r\n              id: msg.id,\r\n              text: msg.text,\r\n              fromMe: false,\r\n              time: msg.time\r\n            });\r\n          } catch (e) {\r\n            console.error('解析消息失败', e);\r\n          }\r\n        };\r\n        \r\n        socket.value.onclose = (closeEvent) => {  // 重命名为closeEvent并使用\r\n          isConnected.value = false;\r\n          ElNotification({\r\n            title: '连接断开',\r\n            message: '聊天连接已断开，正在尝试重连...',\r\n            type: 'warning',\r\n            duration: 0\r\n          });\r\n          \r\n          if (!reconnecting.value) {\r\n            startReconnect();\r\n          }\r\n        };\r\n        \r\n        socket.value.onerror = (errorEvent) => {  // 重命名为errorEvent并使用\r\n          console.error('WebSocket错误', errorEvent);\r\n          ElMessage.error('聊天连接错误，请稍后再试');\r\n        };\r\n      }\r\n    };\r\n    \r\n    // 开始重连\r\n    const startReconnect = () => {\r\n      if (reconnecting.value) return;\r\n      \r\n      reconnecting.value = true;\r\n      reconnectTimer.value = setTimeout(() => {\r\n        initWebSocket();\r\n        reconnecting.value = false;\r\n      }, 3000);\r\n    };\r\n    \r\n    // 停止重连\r\n    const stopReconnect = () => {\r\n      if (reconnectTimer.value) {\r\n        clearTimeout(reconnectTimer.value);\r\n        reconnectTimer.value = null;\r\n        reconnecting.value = false;\r\n      }\r\n    };\r\n    \r\n    // 添加消息到列表\r\n    const addMessage = (msg) => {\r\n      messages.value.push(msg);\r\n      nextTick(() => {\r\n        if (messagesContainer.value) {\r\n          messagesContainer.value.scrollTop = messagesContainer.value.scrollHeight;\r\n        }\r\n      });\r\n    };\r\n    \r\n    // 发送消息\r\n    const sendMessage = () => {\r\n      if (!inputMessage.value.trim() || !isConnected.value) {\r\n        if (!isConnected.value) {\r\n          ElMessage.warning('当前连接已断开，消息发送失败');\r\n        }\r\n        return;\r\n      }\r\n      \r\n      const msg = {\r\n        id: Date.now(),\r\n        text: inputMessage.value.trim(),\r\n        fromMe: true,\r\n        time: new Date().toISOString()\r\n      };\r\n      \r\n      addMessage(msg);\r\n      inputMessage.value = '';\r\n      \r\n      try {\r\n        socket.value.send(JSON.stringify({\r\n          id: msg.id,\r\n          text: msg.text,\r\n          time: msg.time,\r\n          from: myId.value,\r\n          to: targetUser.value.id\r\n        }));\r\n      } catch (error) {\r\n        console.error('发送消息失败', error);\r\n        ElMessage.error('消息发送失败，请稍后再试');\r\n      }\r\n    };\r\n    \r\n    // 返回上一页\r\n    const goBack = () => {\r\n      router.back();\r\n      stopReconnect();\r\n      if (socket.value) {\r\n        socket.value.close();\r\n      }\r\n    };\r\n    \r\n    // 监听路由参数变化\r\n    watch(() => route.params.userId, (newId) => {\r\n      if (newId) {\r\n        // 获取目标用户信息\r\n        axios.get(`${API_CONFIG.BASE_URL}/user/userinfo/${newId}`, {\r\n          headers: { Authorization: `Bearer ${store.state.token}` }\r\n        })\r\n        .then(res => {\r\n          targetUser.value = res.data;\r\n          initWebSocket();\r\n        })\r\n        .catch(err => {\r\n          console.error('获取用户信息失败', err);\r\n          ElMessage.error('获取用户信息失败');\r\n          router.back();\r\n        });\r\n      }\r\n    });\r\n    \r\n    onMounted(() => {\r\n      if (route.params.userId) {\r\n        // 初始化时获取目标用户信息\r\n        axios.get(`${API_CONFIG.BASE_URL}/user/userinfo/${route.params.userId}`, {\r\n          headers: { Authorization: `Bearer ${store.state.token}` }\r\n        })\r\n        .then(res => {\r\n          targetUser.value = res.data;\r\n          initWebSocket();\r\n        })\r\n        .catch(err => {\r\n          console.error('获取用户信息失败', err);\r\n          ElMessage.error('获取用户信息失败');\r\n          router.back();\r\n        });\r\n      }\r\n    });\r\n    \r\n    onU