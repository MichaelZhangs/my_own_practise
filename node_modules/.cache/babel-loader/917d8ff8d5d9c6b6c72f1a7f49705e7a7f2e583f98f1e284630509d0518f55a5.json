t: \"对方头像\",\n    class: \"avatar\",\n    onerror: \"this.src='@/assets/default-avatar.png'\"\n  }, null, 8 /* PROPS */, _hoisted_5)])]), _createElementVNode(\"div\", _hoisted_6, [_ctx.messages.length === 0 ? (_openBlock(), _createElementBlock(\"div\", _hoisted_7, \" 开始和 \" + _toDisplayString(_ctx.targetUser.username || '对方') + \" 聊天吧 \", 1 /* TEXT */)) : _createCommentVNode(\"v-if\", true), (_openBlock(true), _createElementBlock(_Fragment, null, _renderList(_ctx.messages, (msg, index) => {\n    return _openBlock(), _createElementBlock(\"div\", {\n      key: msg.id || index,\n      class: _normalizeClass(['message-item', msg.fromMe ? 'from-me' : 'from-other'])\n    }, [_createElementVNode(\"div\", _hoisted_8, [_createElementVNode(\"img\", {\n      src: msg.fromMe ? _ctx.myAvatar : _ctx.getFullUrl(_ctx.targetUser.photo || _ctx.defaultAvatar),\n      alt: \"头像\",\n      class: \"avatar-sm\",\n      onerror: \"this.src='@/assets/default-avatar.png'\"\n    }, null, 8 /* PROPS */, _hoisted_9)]), _createElementVNode(\"div\", _hoisted_10, [_createElementVNode(\"div\", _hoisted_11, _toDisplayString(msg.text), 1 /* TEXT */), _createElementVNode(\"div\", _hoisted_12, _toDisplayString(_ctx.formatTime(msg.time)), 1 /* TEXT */)])], 2 /* CLASS */);\n  }), 128 /* KEYED_FRAGMENT */))], 512 /* NEED_PATCH */), _createElementVNode(\"div\", _hoisted_13, [!_ctx.isConnected ? (_openBlock(), _createElementBlock(\"div\", _hoisted_14, _cache[5] || (_cache[5] = [_createElementVNode(\"i\", {\n    class: \"fa fa-exclamation-triangle\",\n    \"aria-hidden\": \"true\"\n  }, null, -1 /* HOISTED */), _createTextVNode(\" 未连接 \")]))) : _createCommentVNode(\"v-if\", true), _withDirectives(_createElementVNode(\"input\", {\n    type: \"text\",\n    \"onUpdate:modelValue\": _cache[1] || (_cache[1] = $event => _ctx.inputMessage = $event),\n    placeholder: \"输入消息...\",\n    onKeyup: _cache[2] || (_cache[2] = _withKeys((...args) => _ctx.sendMessage && _ctx.sendMessage(...args), [\"enter\"])),\n    disabled: !_ctx.isConnected\n  }, null, 40 /* PROPS, NEED_HYDRATION */, _hoisted_15), [[_vModelText, _ctx.inputMessage]]), _createElementVNode(\"button\", {\n    class: \"send-button\",\n    onClick: _cache[3] || (_cache[3] = (...args) => _ctx.sendMessage && _ctx.sendMessage(...args)),\n    disabled: !_ctx.isConnected\n  }, _cache[6] || (_cache[6] = [_createElementVNode(\"i\", {\n    class: \"fa fa-paper-plane\",\n    \"aria-hidden\": \"true\"\n  }, null, -1 /* HOISTED */)]), 8 /* PROPS */, _hoisted_16)])]);\n}","map":{"version":3,"names":["class","ref","key","_createElementBlock","_hoisted_1","_createElementVNode","_hoisted_2","onClick","_cache","args","_ctx","goBack","_hoisted_3","_toDisplayString","targetUser","username","_hoisted_4","src","getFullUrl","photo","defaultAvatar","alt","onerror","_hoisted_5","_hoisted_6","messages","length","_hoisted_7","_createCommentVNode","_Fragment","_renderList","msg","index","id","_normalizeClass","fromMe","_hoisted_8","myAvatar","_hoisted_9","_hoisted_10","_hoisted_11","text","_hoisted_12","formatTime","time","_hoisted_13","isConnected","_hoisted_14","_createTextVNode","type","$event","inputMessage","placeholder","onKeyup","_withKeys","sendMessage","disabled","_hoisted_15","_hoisted_16"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\views\\ChatView.vue"],"sourcesContent":["<template>\r\n  <div class=\"chat-view\">\r\n    <div class=\"chat-header\">\r\n      <div class=\"back-button\" @click=\"goBack\">\r\n        <i class=\"fa fa-arrow-left\" aria-hidden=\"true\"></i>\r\n      </div>\r\n      <div class=\"chat-title\">{{ targetUser.username || '未知用户' }}</div>\r\n      <div class=\"chat-avatar\">\r\n        <img \r\n          :src=\"getFullUrl(targetUser.photo || defaultAvatar)\" \r\n          alt=\"对方头像\" \r\n          class=\"avatar\" \r\n          onerror=\"this.src='@/assets/default-avatar.png'\"\r\n        />\r\n      </div>\r\n    </div>\r\n    \r\n    <div class=\"chat-messages\" ref=\"messagesContainer\">\r\n      <div v-if=\"messages.length === 0\" class=\"empty-chat\">\r\n        开始和 {{ targetUser.username || '对方' }} 聊天吧\r\n      </div>\r\n      \r\n      <div \r\n        v-for=\"(msg, index) in messages\" \r\n        :key=\"msg.id || index\" \r\n        :class=\"['message-item', msg.fromMe ? 'from-me' : 'from-other']\"\r\n      >\r\n        <div class=\"message-avatar\">\r\n          <img \r\n            :src=\"msg.fromMe ? myAvatar : getFullUrl(targetUser.photo || defaultAvatar)\" \r\n            alt=\"头像\" \r\n            class=\"avatar-sm\" \r\n            onerror=\"this.src='@/assets/default-avatar.png'\"\r\n          />\r\n        </div>\r\n        \r\n        <div class=\"message-content\">\r\n          <div class=\"message-bubble\">{{ msg.text }}</div>\r\n          <div class=\"message-time\">{{ formatTime(msg.time) }}</div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    \r\n    <div class=\"chat-input-area\">\r\n      <div class=\"connection-status\" v-if=\"!isConnected\">\r\n        <i class=\"fa fa-exclamation-triangle\" aria-hidden=\"true\"></i> 未连接\r\n      </div>\r\n      <input \r\n        type=\"text\" \r\n        v-model=\"inputMessage\" \r\n        placeholder=\"输入消息...\" \r\n        @keyup.enter=\"sendMessage\"\r\n        :disabled=\"!isConnected\"\r\n      />\r\n      <button class=\"send-button\" @click=\"sendMessage\" :disabled=\"!isConnected\">\r\n        <i class=\"fa fa-paper-plane\" aria-hidden=\"true\"></i>\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { computed, ref, onMounted, onUnmounted, nextTick, watch } from 'vue';\r\nimport { useRoute, useRouter } from 'vue-router';\r\nimport { useStore } from 'vuex';\r\nimport defaultAvatar from '@/assets/default-avatar.png';\r\nimport { API_CONFIG } from '@/config/config';\r\nimport { ElMessage, ElNotification } from 'element-plus';\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  setup() {\r\n    const route = useRoute();\r\n    const router = useRouter();\r\n    const store = useStore();\r\n    const messagesContainer = ref(null);\r\n    const targetUser = ref({});\r\n    const messages = ref([]);\r\n    const inputMessage = ref('');\r\n    const myAvatar = computed(() => {\r\n      const user = store.state.user;\r\n      return user.photo ? `${API_CONFIG.BASE_URL}${user.photo}` : defaultAvatar;\r\n    });\r\n    const socket = ref(null);\r\n    const isConnected = ref(false);\r\n    const reconnecting = ref(false);\r\n    const reconnectTimer = ref(null);\r\n    const myId = computed(() => store.state.user.id);\r\n    const myUser = computed(() => store.state.user); // 获取当前用户信息\r\n    \r\n    // 工具方法：处理图片URL\r\n    const getFullUrl = (path) => {\r\n      if (!path) return defaultAvatar;\r\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`;\r\n    };\r\n    \r\n    // 工具方法：格式化时间\r\n    const formatTime = (time) => {\r\n      if (!time) return '';\r\n      const date = new Date(time);\r\n      const now = new Date();\r\n      \r\n      if (date.toDateString() === now.toDateString()) {\r\n        return date.toTimeString().substring(0, 5);\r\n      }\r\n      \r\n      const yesterday = new Date();\r\n      yesterday.setDate(now.getDate() - 1);\r\n      if (date.toDateString() === yesterday.toDateString()) {\r\n        return '昨天';\r\n      }\r\n      \r\n      return `${date.getMonth() + 1}/${date.getDate()}`;\r\n    };\r\n    \r\n    // 初始化WebSocket连接\r\n    const initWebSocket = () => {\r\n      if (myId.value && targetUser.value.id) {\r\n        const wsUrl = `ws://${API_CONFIG.URL_CHAT}/ws/chat/${myId.value}/${targetUser.value.id}`;\r\n        console.log(\"wsulr = \", wsUrl)\r\n        if (socket.value) {\r\n          socket.value.close();\r\n        }\r\n        \r\n        socket.value = new WebSocket(wsUrl);\r\n        \r\n        socket.value.onopen = () => {\r\n          isConnected.value = true;\r\n          reconnecting.value = false;\r\n          ElNotification({\r\n            title: '连接成功',\r\n            message: `已与 ${targetUser.value.username || '对方'} 建立聊天连接`,\r\n            type: 'success',\r\n            duration: 3000\r\n          });\r\n          \r\n          // 连接成功后可以尝试加载历史消息\r\n          loadHistoryMessages();\r\n        };\r\n        \r\n        socket.value.onmessage = (event) => {\r\n          try {\r\n            const msg = JSON.parse(event.data);\r\n            addMessage({\r\n              id: msg.id,\r\n              text: msg.text,\r\n              fromMe: msg.from === myId.value,\r\n              time: msg.time\r\n            });\r\n            \r\n            // 更新最近聊天列表（使用消息中的发送者信息）\r\n            const senderInfo = {\r\n              id: parseInt(msg.from, 10),,\r\n              username: msg.fromUsername || '未知用户',\r\n              photo: getFullUrl(msg.fromPhoto)\r\n            };\r\n            store.commit('chat/ADD_RECENT_CHAT', senderInfo);\r\n            store.dispatch('chat/saveRecentChats');\r\n\r\n          } catch (e) {\r\n            console.error('解析消息失败', e);\r\n            ElMessage.error('接收消息失败');\r\n          }\r\n        };\r\n        \r\n        socket.value.onclose = () => {\r\n          isConnected.value = false;\r\n          ElNotification({\r\n            title: '连接断开',\r\n            message: '聊天连接已断开，正在尝试重连...',\r\n            type: 'warning',\r\n            duration: 0\r\n          });\r\n          \r\n          if (!reconnecting.value) {\r\n            startReconnect();\r\n          }\r\n        };\r\n        \r\n        socket.value.onerror = (errorEvent) => {\r\n          console.error('WebSocket错误', errorEvent);\r\n          ElMessage.error('聊天连接错误，请稍后再试');\r\n        };\r\n      }\r\n    };\r\n    \r\n    // 加载历史消息\r\n    const loadHistoryMessages = () => {\r\n      if (myId.value && targetUser.value.id) {\r\n        axios.get(`${API_CONFIG.BASE_URL}/ws/chat/history/${myId.value}/${targetUser.value.id}`, {\r\n          headers: { Authorization: `Bearer ${store.state.token}` }\r\n        })\r\n        .then(res => {\r\n          if (res.data && res.data.length) {\r\n            messages.value = res.data.map(msg => ({\r\n              id: msg.id,\r\n              text: msg.text,\r\n              // 判断消息是否由当前用户发送\r\n              fromMe: msg.from_id === myId.value,\r\n              time: msg.created_at\r\n            }));\r\n            \r\n            nextTick(() => {\r\n              if (messagesContainer.value) {\r\n                messagesContainer.value.scrollTop = messagesContainer.value.scrollHeight;\r\n              }\r\n            });\r\n          }\r\n        })\r\n        .catch(err => {\r\n          console.error('加载历史消息失败', err);\r\n          ElMessage.warning('历史消息加载失败');\r\n        });\r\n      }\r\n    };\r\n    \r\n    // 开始重连\r\n    const startReconnect = () => {\r\n      if (reconnecting.value || !targetUser.value.id) return;\r\n      \r\n      reconnecting.value = true;\r\n      reconnectTimer.value = setTimeout(() => {\r\n        initWebSocket();\r\n        reconnecting.value = false;\r\n      }, 3000);\r\n    };\r\n    \r\n    // 停止重连\r\n    const stopReconnect = () => {\r\n      if (reconnectTimer.value) {\r\n        clearTimeout(reconnectTimer.value);\r\n        reconnectTimer.value = null;\r\n        reconnecting.value = false;\r\n      }\r\n    };\r\n    \r\n    // 添加消息到列表\r\n    const addMessage = (msg) => {\r\n      messages.value.push(msg);\r\n      nextTick(() => {\r\n        if (messagesContainer.value) {\r\n          messagesContainer.value.scrollTop = messagesContainer.value.scrollHeight;\r\n        }\r\n      });\r\n    };\r\n    \r\n    // 发送消息\r\n    const sendMessage = () => {\r\n      // 空内容拦截（强化提示）\r\n      const content = inputMessage.value.trim();\r\n      if (!content) {\r\n        ElMessage.warning('消息内容不能为空，请输入后再发送～');\r\n        return;\r\n      }\r\n      \r\n      if (!isConnected.value) {\r\n        ElMessage.warning('当前连接已断开，无法发送消息');\r\n        return;\r\n      }\r\n      \r\n      const msg = {\r\n        id: Date.now(),\r\n        text: inputMessage.value.trim(),\r\n        fromMe: true,\r\n        time: new Date().toISOString()\r\n      };\r\n      \r\n      addMessage(msg);\r\n      inputMessage.value = '';\r\n      \r\n      try {\r\n        // 发送消息时包含fromUsername和fromPhoto\r\n        socket.value.send(JSON.stringify({\r\n          id: msg.id,\r\n          text: msg.text,\r\n          time: msg.time,\r\n          from: myId.value,\r\n          to: targetUser.value.id,\r\n          fromUsername: myUser.value.username, // 发送者用户名\r\n          fromPhoto: getFullUrl(myUser.value.photo )// 发送者头像\r\n        }));\r\n      } catch (error) {\r\n        console.error('发送消息失败', error);\r\n        ElMessage.error('消息发送失败，请稍后再试');\r\n      }\r\n       console.log('targetUser:', targetUser.value); \r\n      // 更新最近聊天列表\r\n      store.commit('chat/ADD_RECENT_CHAT', targetUser.value);\r\n      store.dispatch('chat/saveRecentChats');\r\n    };\r\n    \r\n    // 返回上一页\r\n    const goBack = () => {\r\n      router.back();\r\n      stopReconnect();\r\n      if (socket.value) {\r\n        socket.value.close();\r\n      }\r\n    };\r\n    \r\n    // 监听路由参数变化\r\n    watch(() => route.params.userId, (newId) => {\r\n      if (newId) {\r\n        fetchUserInfo(newId);\r\n      }\r\n      console.log(\"newId : \", newId)\r\n    });\r\n\r\n    // 获取用户信息\r\n    const fetchUserInfo = (userId) => {\r\n      console.log(\"userId \", userId)\r\n      console.log(`${API_CONFIG.BASE_URL}/user/info/${userId}`)\r\n\r\n\r\n     axios.get(`${API_CONFIG.BASE_URL}/user/info`, { // 修改URL路径\r\n    params: { id: userId }, // 添加查询参数\r\n    headers: { Authorization: `Bearer ${store.state.token}` }\r\n  }).then(res => {\r\n        if (res.data && res.data.id) {\r\n          console.log(\"res = \", res.data)\r\n          targetUser.value = res.data;\r\n          initWebSocket();\r\n        } else {\r\n          console.error(\"res : \", res.data)\r\n          throw new Error('用户信息为空');\r\n        }\r\n      })\r\n      .catch(err => {\r\n        \r\n        console.log(\"失败： \", userId)\r\n        console.error('获取用户信息失败', err);\r\n        ElMessage.error('获取用户信息失败');\r\n        router.back();\r\n      });\r\n    };\r\n    \r\n    onMounted(() => {\r\n      if (route.params.userId) {\r\n        fetchUserInfo(route.params.userId);\r\n      } else {\r\n        ElMessage.error('未指定聊天对象');\r\n        router.back();\r\n      }\r\n    });\r\n    \r\n    onUnmounted(() => {\r\n      stopReconnect();\r\n      if (socket.value) {\r\n        socket.value.close();\r\n      }\r\n    });\r\n\r\n    return {\r\n      targetUser,\r\n      messages,\r\n      inputMessage,\r\n      myAvatar,\r\n      getFullUrl,\r\n      formatTime,\r\n      sendMessage,\r\n      goBack,\r\n      messagesContainer,\r\n      isConnected\r\n    };\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.chat-view {\r\n  display: flex;\r\n  flex-direction: column;\r\n  height: 100vh;\r\n  background-color: #f5f5f5;\r\n}\r\n\r\n.chat-header {\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 0 15px;\r\n  height: 50px;\r\n  background-color: #fff;\r\n  border-bottom: 1px solid #e5e5e5;\r\n  position: relative;\r\n}\r\n\r\n.back-button {\r\n  position: absolute;\r\n  left: 15px;\r\n  cursor: pointer;\r\n}\r\n\r\n.chat-title {\r\n  flex: 1;\r\n  text-align: center;\r\n  font-weight: bold;\r\n}\r\n\r\n.chat-avatar {\r\n  position: absolute;\r\n  right: 15px;\r\n  width: 30px;\r\n  height: 30px;\r\n  border-radius: 50%;\r\n  overflow: hidden;\r\n}\r\n\r\n.avatar {\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n\r\n.chat-messages {\r\n  flex: 1;\r\n  overflow-y: auto;\r\n  padding: 15px;\r\n}\r\n\r\n.empty-chat {\r\n  text-align: center;\r\n  color: #999;\r\n  padding-top: 30px;\r\n}\r\n\r\n.message-item {\r\n  display: flex;\r\n  margin-bottom: 15px;\r\n  max-width: 80%;\r\n}\r\n\r\n.from-me {\r\n  justify-content: flex-end;\r\n  margin-left: auto;\r\n}\r\n\r\n.from-other {\r\n  justify-content: flex-start;\r\n  margin-right: auto;\r\n}\r\n\r\n.from-me .message-bubble {\r\n  background-color: #1890ff;\r\n  color: #fff;\r\n}\r\n\r\n.from-other .message-bubble {\r\n  background-color: #fff;\r\n  color: #333;\r\n  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.message-avatar {\r\n  width: 32px;\r\n  height: 32px;\r\n  margin: 0 8px;\r\n}\r\n\r\n.avatar-sm {\r\n  width: 100%;\r\n  height: 100%;\r\n  border-radius: 50%;\r\n}\r\n\r\n.message-content {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.message-bubble {\r\n  padding: 8px 12px;\r\n  border-radius: 18px;\r\n  position: relative;\r\n  max-width: 100%;\r\n}\r\n\r\n.message-time {\r\n  font-size: 10px;\r\n  color: #999;\r\n  text-align: center;\r\n  margin-top: 3px;\r\n}\r\n\r\n.chat-input-area {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  padding: 10px 15px;\r\n  background-color: #fff;\r\n  border-top: 1px solid #e5e5e5;\r\n  position: relative;\r\n}\r\n\r\n.connection-status {\r\n  position: absolute;\r\n  top: -20px;\r\n  left: 0;\r\n  right: 0;\r\n  text-align: center;\r\n  background-color: #f5222d;\r\n  color: white;\r\n  font-size: 12px;\r\n  padding: 2px;\r\n}\r\n\r\n.chat-input-area input {\r\n  flex: 1;\r\n  height: 32px;\r\n  padding: 0 12px;\r\n  border: 1px solid #e5e5e5;\r\n  border-radius: 16px;\r\n  outline: none;\r\n}\r\n\r\n.chat-input-area input:disabled {\r\n  background-color: #f5f5f5;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.send-button {\r\n  background-color: #1890ff;\r\n  color: #fff;\r\n  border: none;\r\n  border-radius: 50%;\r\n  width: 32px;\r\n  height: 32px;\r\n  margin-left: 10px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  cursor: pointer;\r\n}\r\n\r\n.send-button:disabled {\r\n  background-color: #bfbfbf;\r\n  cursor: not-allowed;\r\n}\r\n</style>"],"mappings":";;EACOA,KAAK,EAAC;AAAW;;EACfA,KAAK,EAAC;AAAa;;EAIjBA,KAAK,EAAC;AAAY;;EAClBA,KAAK,EAAC;AAAa;mBAP9B;;EAiBSA,KAAK,EAAC,eAAe;EAACC,