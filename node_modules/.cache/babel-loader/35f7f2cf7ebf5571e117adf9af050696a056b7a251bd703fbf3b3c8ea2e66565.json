{"ast":null,"code":"import { computed, ref } from 'vue';\nimport { useStore } from 'vuex';\nimport defaultAvatar from '@/assets/default-avatar.png';\nimport defaultqrcode from '@/assets/logo.png';\nimport QRCode from 'qrcode';\nexport default {\n  name: 'UserDetail',\n  setup() {\n    const store = useStore();\n\n    // 从 Vuex 中获取用户信息\n    const user = computed(() => store.state.user);\n\n    // 二维码 URL\n    const qrcodeUrl = ref('');\n\n    // 生成二维码\n    const generateQrcode = async () => {\n      try {\n        const content = `用户名: ${user.value.username}\\n手机号: ${user.value.phone}`;\n        const url = await QRCode.toDataURL(content, {\n          errorCorrectionLevel: 'H',\n          // 高容错率\n          type: 'image/png',\n          // 二维码类型\n          margin: 2,\n          // 二维码边距\n          color: {\n            dark: '#000000',\n            // 二维码颜色\n            light: '#ffffff' // 背景颜色\n          }\n        });\n        qrcodeUrl.value = url;\n        alert(\"二维码生成成功\");\n      } catch (error) {\n        console.error(\"生成二维码失败\", error);\n        alert(\"生成二维码失败\");\n      }\n    };\n    return {\n      user,\n      defaultAvatar,\n      defaultqrcode,\n      qrcodeUrl,\n      generateQrcode\n    };\n  }\n};","map":{"version":3,"names":["computed","ref","useStore","defaultAvatar","defaultqrcode","QRCode","name","setup","store","user","state","qrcodeUrl","generateQrcode","content","value","username","phone","url","toDataURL","errorCorrectionLevel","type","margin","color","dark","light","alert","error","console"],"sources":["E:\\vue_learn\\ai_vue\\ai_vue\\src\\views\\UserDetail.vue"],"sourcesContent":["<template>\r\n    <div class=\"user-detail-page\">\r\n      <h1>用户详情</h1>\r\n      <div class=\"user-detail-container\">\r\n        <!-- 左侧：用户信息 -->\r\n        <div class=\"info-section\">\r\n          <!-- 头像 -->\r\n          <div class=\"avatar-section\">\r\n            <img :src=\"user?.photo || defaultAvatar\" alt=\"头像\" class=\"avatar\" />\r\n          </div>\r\n  \r\n          <!-- 用户信息 -->\r\n          <div class=\"info-item\">\r\n            <label>名字：</label>\r\n            <input v-model=\"user.username\" placeholder=\"未设置\" />\r\n          </div>\r\n          <div class=\"info-item\">\r\n            <label>性别：</label>\r\n            <input v-model=\"user.sex\" placeholder=\"未设置\" />\r\n          </div>\r\n          <div class=\"info-item\">\r\n            <label>手机号：</label>\r\n            <input v-model=\"user.phone\" placeholder=\"未设置\" />\r\n          </div>\r\n          <div class=\"info-item\">\r\n            <label>邮箱：</label>\r\n            <input v-model=\"user.email\" placeholder=\"未设置\" />\r\n          </div>\r\n          <div class=\"info-item\">\r\n            <label>描述：</label>\r\n            <textarea v-model=\"user.description\" placeholder=\"未设置\"></textarea>\r\n          </div>\r\n        </div>\r\n  \r\n        <!-- 右侧：二维码 -->\r\n        <div class=\"qr-code-section\">\r\n          <h2 @click=\"generateQrcode\">我的二维码</h2>\r\n          <div class=\"qr-code-container\">\r\n            <img :src=\"qrcodeUrl || defaultqrcode\" alt=\"我的二维码\" class=\"qr-code\" />\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\nimport { computed, ref } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport defaultAvatar from '@/assets/default-avatar.png';\r\nimport defaultqrcode from '@/assets/logo.png';\r\nimport QRCode from 'qrcode';\r\n\r\nexport default {\r\n  name: 'UserDetail',\r\n  setup() {\r\n    const store = useStore();\r\n\r\n    // 从 Vuex 中获取用户信息\r\n    const user = computed(() => store.state.user);\r\n\r\n    // 二维码 URL\r\n    const qrcodeUrl = ref('');\r\n\r\n    // 生成二维码\r\n    const generateQrcode = async () => {\r\n      try {\r\n        const content = `用户名: ${user.value.username}\\n手机号: ${user.value.phone}`;\r\n        const url = await QRCode.toDataURL(content, {\r\n          errorCorrectionLevel: 'H', // 高容错率\r\n          type: 'image/png', // 二维码类型\r\n          margin: 2, // 二维码边距\r\n          color: {\r\n            dark: '#000000', // 二维码颜色\r\n            light: '#ffffff', // 背景颜色\r\n          },\r\n        });\r\n        qrcodeUrl.value = url;\r\n        alert(\"二维码生成成功\");\r\n      } catch (error) {\r\n        console.error(\"生成二维码失败\", error);\r\n        alert(\"生成二维码失败\");\r\n      }\r\n    };\r\n\r\n    return {\r\n      user,\r\n      defaultAvatar,\r\n      defaultqrcode,\r\n      qrcodeUrl,\r\n      generateQrcode,\r\n    };\r\n  },\r\n};\r\n</script>\r\n  \r\n<style scoped>\r\n.user-detail-page {\r\n  padding: 20px;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center; /* 整体内容居中 */\r\n}\r\n\r\nh1 {\r\n  font-size: 24px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.user-detail-container {\r\n  display: flex;\r\n  max-width: 800px; /* 限制容器宽度 */\r\n  width: 100%;\r\n  gap: 40px; /* 左右两部分间距 */\r\n}\r\n\r\n.info-section {\r\n  flex: 1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n}\r\n\r\n.avatar-section {\r\n  display: flex;\r\n  justify-content: center;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.avatar {\r\n  width: 100px;\r\n  height: 100px;\r\n  border-radius: 50%;\r\n}\r\n\r\n.info-item {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.info-item label {\r\n  font-weight: bold;\r\n  width: 80px;\r\n}\r\n\r\n.info-item input,\r\n.info-item textarea {\r\n  flex: 1;\r\n  padding: 5px;\r\n  border: 1px solid #ccc;\r\n  border-radius: 4px;\r\n}\r\n\r\n.info-item textarea {\r\n  height: 80px;\r\n  resize: vertical;\r\n}\r\n\r\n.qr-code-section {\r\n  flex: 1;\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n}\r\n\r\n.qr-code-section h2 {\r\n  cursor: pointer; /* 点击区域 */\r\n  color: #1890ff;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.qr-code-section h2:hover {\r\n  text-decoration: underline;\r\n}\r\n\r\n.qr-code-container {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n\r\n.qr-code {\r\n  width: 150px; /* 二维码大小 */\r\n  height: 150px;\r\n  border: 5px solid #07c160; /* 微信二维码样式 */\r\n  border-radius: 10px;\r\n}\r\n</style>"],"mappings":"AA8CA,SAASA,QAAQ,EAAEC,GAAE,QAAS,KAAK;AACnC,SAASC,QAAO,QAAS,MAAM;AAC/B,OAAOC,aAAY,MAAO,6BAA6B;AACvD,OAAOC,aAAY,MAAO,mBAAmB;AAC7C,OAAOC,MAAK,MAAO,QAAQ;AAE3B,eAAe;EACbC,IAAI,EAAE,YAAY;EAClBC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIN,QAAQ,CAAC,CAAC;;IAExB;IACA,MAAMO,IAAG,GAAIT,QAAQ,CAAC,MAAMQ,KAAK,CAACE,KAAK,CAACD,IAAI,CAAC;;IAE7C;IACA,MAAME,SAAQ,GAAIV,GAAG,CAAC,EAAE,CAAC;;IAEzB;IACA,MAAMW,cAAa,GAAI,MAAAA,CAAA,KAAY;MACjC,IAAI;QACF,MAAMC,OAAM,GAAI,QAAQJ,IAAI,CAACK,KAAK,CAACC,QAAQ,UAAUN,IAAI,CAACK,KAAK,CAACE,KAAK,EAAE;QACvE,MAAMC,GAAE,GAAI,MAAMZ,MAAM,CAACa,SAAS,CAACL,OAAO,EAAE;UAC1CM,oBAAoB,EAAE,GAAG;UAAE;UAC3BC,IAAI,EAAE,WAAW;UAAE;UACnBC,MAAM,EAAE,CAAC;UAAE;UACXC,KAAK,EAAE;YACLC,IAAI,EAAE,SAAS;YAAE;YACjBC,KAAK,EAAE,SAAS,CAAE;UACpB;QACF,CAAC,CAAC;QACFb,SAAS,CAACG,KAAI,GAAIG,GAAG;QACrBQ,KAAK,CAAC,SAAS,CAAC;MAClB,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,SAAS,EAAEA,KAAK,CAAC;QAC/BD,KAAK,CAAC,SAAS,CAAC;MAClB;IACF,CAAC;IAED,OAAO;MACLhB,IAAI;MACJN,aAAa;MACbC,aAAa;MACbO,SAAS;MACTC;IACF,CAAC;EACH;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}