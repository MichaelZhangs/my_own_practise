{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { computed, onMounted } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nimport defaultAvatar from '@/assets/default-avatar.png';\nimport axios from 'axios';\nexport default {\n  name: 'UserPage',\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const user = computed(() => store.state.user);\n    const displayName = computed(() => user.value?.username || user.value?.phone || user.value?.email || '未登录');\n\n    // 退出登录\n    const logout = () => {\n      store.dispatch('logout');\n      router.push('/login');\n    };\n\n    // 获取用户信息\n    const fetchUserInfo = async () => {\n      try {\n        const phone = user.value?.phone; // 从 Vuex 中获取当前用户的手机号\n        if (!phone) {\n          alert(\"用户未登录\");\n          return;\n        }\n\n        // 调用后端接口获取用户信息\n        const response = await axios.get(`/user/info?phone=${phone}`);\n        const userInfo = response.data;\n\n        // 更新 Vuex 中的用户信息\n        store.commit('setUser', userInfo);\n\n        // 提示用户信息已更新\n        alert(\"用户信息已更新\");\n      } catch (error) {\n        console.error(\"获取用户信息失败\", error);\n        alert(\"获取用户信息失败\");\n      }\n    };\n\n    // 页面加载时检查用户是否登录\n    onMounted(() => {\n      if (!store.state.user) {\n        router.push('/login');\n      }\n    });\n    return {\n      user,\n      displayName,\n      defaultAvatar,\n      logout,\n      fetchUserInfo\n    };\n  }\n};","map":{"version":3,"names":["computed","onMounted","useStore","useRouter","defaultAvatar","axios","name","setup","store","router","user","state","displayName","value","username","phone","email","logout","dispatch","push","fetchUserInfo","alert","response","get","userInfo","data","commit","error","console"],"sources":["E:\\vue_learn\\ai_vue\\ai_vue\\src\\views\\UserPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"user-page\">\r\n    <header class=\"header\">\r\n      <div class=\"header-left\">\r\n        <!-- 点击头像获取用户信息 -->\r\n        <div class=\"user-info\" @click=\"fetchUserInfo\">\r\n          <img :src=\"user?.photo || defaultAvatar\" alt=\"头像\" class=\"avatar\" />\r\n          <span class=\"username\">{{ displayName }}</span>\r\n        </div>\r\n      </div>\r\n      <div class=\"header-right\">\r\n        <button @click=\"logout\" class=\"logout-button\">退出登录</button>\r\n      </div>\r\n    </header>\r\n\r\n    <div class=\"main-layout\">\r\n      <aside class=\"sidebar\">\r\n        <ul class=\"menu\">\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/user/dashboard\">仪表盘</router-link>\r\n          </li>\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/user/profile\">个人资料</router-link>\r\n          </li>\r\n        </ul>\r\n      </aside>\r\n\r\n      <main class=\"main-content\">\r\n        <router-view></router-view>\r\n      </main>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { computed, onMounted } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { useRouter } from 'vue-router';\r\nimport defaultAvatar from '@/assets/default-avatar.png';\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'UserPage',\r\n  setup() {\r\n    const store = useStore();\r\n    const router = useRouter();\r\n\r\n    const user = computed(() => store.state.user);\r\n    const displayName = computed(() => user.value?.username || user.value?.phone || user.value?.email || '未登录');\r\n\r\n    // 退出登录\r\n    const logout = () => {\r\n      store.dispatch('logout');\r\n      router.push('/login');\r\n    };\r\n\r\n    // 获取用户信息\r\n    const fetchUserInfo = async () => {\r\n      try {\r\n        const phone = user.value?.phone; // 从 Vuex 中获取当前用户的手机号\r\n        if (!phone) {\r\n          alert(\"用户未登录\");\r\n          return;\r\n        }\r\n\r\n        // 调用后端接口获取用户信息\r\n        const response = await axios.get(`/user/info?phone=${phone}`);\r\n        const userInfo = response.data;\r\n\r\n        // 更新 Vuex 中的用户信息\r\n        store.commit('setUser', userInfo);\r\n\r\n        // 提示用户信息已更新\r\n        alert(\"用户信息已更新\");\r\n      } catch (error) {\r\n        console.error(\"获取用户信息失败\", error);\r\n        alert(\"获取用户信息失败\");\r\n      }\r\n    };\r\n\r\n    // 页面加载时检查用户是否登录\r\n    onMounted(() => {\r\n      if (!store.state.user) {\r\n        router.push('/login');\r\n      }\r\n    });\r\n\r\n    return {\r\n      user,\r\n      displayName,\r\n      defaultAvatar,\r\n      logout,\r\n      fetchUserInfo,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.user-page {\r\n  display: flex;\r\n  flex-direction: column;\r\n  height: 100vh;\r\n  background-color: #f0f2f5;\r\n}\r\n\r\n.header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  padding: 0 20px;\r\n  height: 60px;\r\n  background-color: #001529;\r\n  color: white;\r\n}\r\n\r\n.header-left {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.user-info {\r\n  display: flex;\r\n  align-items: center;\r\n  cursor: pointer;\r\n}\r\n\r\n.avatar {\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 50%;\r\n  margin-right: 10px;\r\n}\r\n\r\n.username {\r\n  margin-right: 20px;\r\n  font-size: 16px;\r\n}\r\n\r\n.logout-button {\r\n  padding: 5px 10px;\r\n  background-color: #1890ff;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n}\r\n\r\n.logout-button:hover {\r\n  background-color: #40a9ff;\r\n}\r\n\r\n.main-layout {\r\n  display: flex;\r\n  flex: 1;\r\n  overflow: hidden;\r\n}\r\n\r\n.sidebar {\r\n  width: 200px;\r\n  background-color: #001529;\r\n  color: white;\r\n  overflow-y: auto;\r\n}\r\n\r\n.menu {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 0;\r\n}\r\n\r\n.menu-item {\r\n  padding: 15px 20px;\r\n  border-bottom: 1px solid #002140;\r\n}\r\n\r\n.menu-item a {\r\n  color: white;\r\n  text-decoration: none;\r\n  display: block;\r\n}\r\n\r\n.menu-item a:hover {\r\n  color: #1890ff;\r\n}\r\n\r\n.main-content {\r\n  flex: 1;\r\n  padding: 20px;\r\n  background-color: white;\r\n  overflow-y: auto;\r\n  position: relative;\r\n}\r\n</style>"],"mappings":";AAmCA,SAASA,QAAQ,EAAEC,SAAQ,QAAS,KAAK;AACzC,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,SAAQ,QAAS,YAAY;AACtC,OAAOC,aAAY,MAAO,6BAA6B;AACvD,OAAOC,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,UAAU;EAChBC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIN,QAAQ,CAAC,CAAC;IACxB,MAAMO,MAAK,GAAIN,SAAS,CAAC,CAAC;IAE1B,MAAMO,IAAG,GAAIV,QAAQ,CAAC,MAAMQ,KAAK,CAACG,KAAK,CAACD,IAAI,CAAC;IAC7C,MAAME,WAAU,GAAIZ,QAAQ,CAAC,MAAMU,IAAI,CAACG,KAAK,EAAEC,QAAO,IAAKJ,IAAI,CAACG,KAAK,EAAEE,KAAI,IAAKL,IAAI,CAACG,KAAK,EAAEG,KAAI,IAAK,KAAK,CAAC;;IAE3G;IACA,MAAMC,MAAK,GAAIA,CAAA,KAAM;MACnBT,KAAK,CAACU,QAAQ,CAAC,QAAQ,CAAC;MACxBT,MAAM,CAACU,IAAI,CAAC,QAAQ,CAAC;IACvB,CAAC;;IAED;IACA,MAAMC,aAAY,GAAI,MAAAA,CAAA,KAAY;MAChC,IAAI;QACF,MAAML,KAAI,GAAIL,IAAI,CAACG,KAAK,EAAEE,KAAK,EAAE;QACjC,IAAI,CAACA,KAAK,EAAE;UACVM,KAAK,CAAC,OAAO,CAAC;UACd;QACF;;QAEA;QACA,MAAMC,QAAO,GAAI,MAAMjB,KAAK,CAACkB,GAAG,CAAC,oBAAoBR,KAAK,EAAE,CAAC;QAC7D,MAAMS,QAAO,GAAIF,QAAQ,CAACG,IAAI;;QAE9B;QACAjB,KAAK,CAACkB,MAAM,CAAC,SAAS,EAAEF,QAAQ,CAAC;;QAEjC;QACAH,KAAK,CAAC,SAAS,CAAC;MAClB,EAAE,OAAOM,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,UAAU,EAAEA,KAAK,CAAC;QAChCN,KAAK,CAAC,UAAU,CAAC;MACnB;IACF,CAAC;;IAED;IACApB,SAAS,CAAC,MAAM;MACd,IAAI,CAACO,KAAK,CAACG,KAAK,CAACD,IAAI,EAAE;QACrBD,MAAM,CAACU,IAAI,CAAC,QAAQ,CAAC;MACvB;IACF,CAAC,CAAC;IAEF,OAAO;MACLT,IAAI;MACJE,WAAW;MACXR,aAAa;MACba,MAAM;MACNG;IACF,CAAC;EACH;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}