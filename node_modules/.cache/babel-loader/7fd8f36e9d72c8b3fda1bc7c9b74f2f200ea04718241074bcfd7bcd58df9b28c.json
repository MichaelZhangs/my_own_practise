{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'ForgetPassword',\n  data() {\n    return {\n      identifier: '',\n      // 电话号码或邮箱\n      newPassword: '',\n      // 新密码\n      confirmPassword: '',\n      // 确认新密码\n      verificationCode: '',\n      // 验证码\n      isCodeButtonDisabled: false,\n      // 获取验证码按钮是否禁用\n      codeButtonText: '获取验证码',\n      // 获取验证码按钮文本\n      countdown: 0,\n      // 倒计时时间\n      resultMessage: '',\n      // 操作结果消息\n      resultSuccess: false // 操作结果是否成功\n    };\n  },\n  methods: {\n    // 发送验证码\n    async sendVerificationCode() {\n      if (!this.identifier) {\n        alert('请输入电话号码或邮箱');\n        return;\n      }\n      try {\n        // 调用后端接口发送验证码，修改为 /send-code\n        await axios.post('http://127.0.0.1:8000/api/send-verification-code', {\n          identifier: this.identifier\n        });\n\n        // 启动倒计时\n        this.startCountdown();\n      } catch (error) {\n        console.error('发送验证码失败:', error);\n        alert('发送验证码失败，请稍后重试');\n      }\n    },\n    // 启动倒计时\n    startCountdown() {\n      this.isCodeButtonDisabled = true;\n      this.countdown = 60;\n      this.codeButtonText = `${this.countdown}s 后重新获取`;\n      const timer = setInterval(() => {\n        this.countdown--;\n        if (this.countdown <= 0) {\n          clearInterval(timer);\n          this.isCodeButtonDisabled = false;\n          this.codeButtonText = '获取验证码';\n        } else {\n          this.codeButtonText = `${this.countdown}s 后重新获取`;\n        }\n      }, 1000);\n    },\n    // 处理表单提交\n    async handleSubmit() {\n      if (!this.identifier || !this.newPassword || !this.confirmPassword || !this.verificationCode) {\n        alert('请填写所有必填字段');\n        return;\n      }\n      if (this.newPassword !== this.confirmPassword) {\n        this.resultMessage = '两次输入的密码不一致，请重新输入';\n        this.resultSuccess = false;\n        return;\n      }\n      try {\n        // 调用后端接口验证验证码并重置密码\n        const response = await axios.post('http://127.0.0.1:8000/api/reset-password', {\n          identifier: this.identifier,\n          verificationCode: this.verificationCode,\n          newPassword: this.newPassword\n        });\n        console.log(\"response : \", response);\n        // 验证成功，可根据实际情况跳转到登录页面等\n        this.resultMessage = '密码重置成功，请使用新密码登录';\n        this.resultSuccess = true;\n        // 这里可以添加跳转到登录页面的逻辑，例如：\n        // this.$router.push('/login');\n      } catch (error) {\n        console.error('密码重置失败:', error);\n        this.resultMessage = '密码重置失败，请重试';\n        this.resultSuccess = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","identifier","newPassword","confirmPassword","verificationCode","isCodeButtonDisabled","codeButtonText","countdown","resultMessage","resultSuccess","methods","sendVerificationCode","alert","post","startCountdown","error","console","timer","setInterval","clearInterval","handleSubmit","response","log"],"sources":["E:\\vue_learn\\ai_vue\\ai_vue\\src\\views\\ForgetPassword.vue"],"sourcesContent":["<template>\r\n  <div class=\"forgot-password-container\">\r\n    <h1>找回密码</h1>\r\n    <form @submit.prevent=\"handleSubmit\">\r\n      <div class=\"input-group\">\r\n        <input\r\n          type=\"text\"\r\n          v-model=\"identifier\"\r\n          placeholder=\"请输入电话号码或邮箱\"\r\n          required\r\n        />\r\n      </div>\r\n      <div class=\"input-group\">\r\n        <input\r\n          type=\"password\"\r\n          v-model=\"newPassword\"\r\n          placeholder=\"请输入新密码\"\r\n          required\r\n        />\r\n      </div>\r\n      <div class=\"input-group\">\r\n        <input\r\n          type=\"password\"\r\n          v-model=\"confirmPassword\"\r\n          placeholder=\"请再次输入新密码\"\r\n          required\r\n        />\r\n      </div>\r\n      <div class=\"input-group code-group\">\r\n        <input\r\n          type=\"text\"\r\n          v-model=\"verificationCode\"\r\n          placeholder=\"请输入验证码\"\r\n          required\r\n        />\r\n        <button\r\n          type=\"button\"\r\n          @click=\"sendVerificationCode\"\r\n          class=\"code-button\"\r\n          :disabled=\"isCodeButtonDisabled\"\r\n        >\r\n          {{ codeButtonText }}\r\n        </button>\r\n      </div>\r\n      <button type=\"submit\" class=\"submit-button\">提交</button>\r\n    </form>\r\n    <div v-if=\"resultMessage\" class=\"result-message\">\r\n      <p :class=\"{ success: resultSuccess, error:!resultSuccess }\">{{ resultMessage }}</p>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'ForgetPassword',\r\n  data() {\r\n    return {\r\n      identifier: '', // 电话号码或邮箱\r\n      newPassword: '', // 新密码\r\n      confirmPassword: '', // 确认新密码\r\n      verificationCode: '', // 验证码\r\n      isCodeButtonDisabled: false, // 获取验证码按钮是否禁用\r\n      codeButtonText: '获取验证码', // 获取验证码按钮文本\r\n      countdown: 0, // 倒计时时间\r\n      resultMessage: '', // 操作结果消息\r\n      resultSuccess: false, // 操作结果是否成功\r\n    };\r\n  },\r\n  methods: {\r\n    // 发送验证码\r\n    async sendVerificationCode() {\r\n      if (!this.identifier) {\r\n        alert('请输入电话号码或邮箱');\r\n        return;\r\n      }\r\n\r\n      try {\r\n        // 调用后端接口发送验证码，修改为 /send-code\r\n        await axios.post('http://127.0.0.1:8000/api/send-verification-code', {\r\n          identifier: this.identifier,\r\n        });\r\n\r\n        // 启动倒计时\r\n        this.startCountdown();\r\n      } catch (error) {\r\n        console.error('发送验证码失败:', error);\r\n        alert('发送验证码失败，请稍后重试');\r\n      }\r\n    },\r\n    // 启动倒计时\r\n    startCountdown() {\r\n      this.isCodeButtonDisabled = true;\r\n      this.countdown = 60;\r\n      this.codeButtonText = `${this.countdown}s 后重新获取`;\r\n\r\n      const timer = setInterval(() => {\r\n        this.countdown--;\r\n        if (this.countdown <= 0) {\r\n          clearInterval(timer);\r\n          this.isCodeButtonDisabled = false;\r\n          this.codeButtonText = '获取验证码';\r\n        } else {\r\n          this.codeButtonText = `${this.countdown}s 后重新获取`;\r\n        }\r\n      }, 1000);\r\n    },\r\n    // 处理表单提交\r\n    async handleSubmit() {\r\n      if (!this.identifier || !this.newPassword || !this.confirmPassword || !this.verificationCode) {\r\n        alert('请填写所有必填字段');\r\n        return;\r\n      }\r\n\r\n      if (this.newPassword!== this.confirmPassword) {\r\n        this.resultMessage = '两次输入的密码不一致，请重新输入';\r\n        this.resultSuccess = false;\r\n        return;\r\n      }\r\n\r\n      try {\r\n        // 调用后端接口验证验证码并重置密码\r\n        const response = await axios.post('http://127.0.0.1:8000/api/reset-password', {\r\n          identifier: this.identifier,\r\n          verificationCode: this.verificationCode,\r\n          newPassword: this.newPassword,\r\n        });\r\n        console.log(\"response : \", response)\r\n        // 验证成功，可根据实际情况跳转到登录页面等\r\n        this.resultMessage = '密码重置成功，请使用新密码登录';\r\n        this.resultSuccess = true;\r\n        // 这里可以添加跳转到登录页面的逻辑，例如：\r\n        // this.$router.push('/login');\r\n      } catch (error) {\r\n        console.error('密码重置失败:', error);\r\n        this.resultMessage = '密码重置失败，请重试';\r\n        this.resultSuccess = false;\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.forgot-password-container {\r\n  max-width: 400px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n  border: 1px solid #ccc;\r\n  border-radius: 5px;\r\n  background-color: #f9f9f9;\r\n}\r\n\r\nh1 {\r\n  text-align: center;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.input-group {\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.input-group input {\r\n  width: 100%;\r\n  padding: 10px;\r\n  border: 1px solid #ccc;\r\n  border-radius: 5px;\r\n}\r\n\r\n.code-group {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.code-group input {\r\n  flex: 1;\r\n  margin-right: 10px;\r\n}\r\n\r\n.code-button {\r\n  padding: 10px 15px;\r\n  background-color: #007bff;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n}\r\n\r\n.code-button:disabled {\r\n  background-color: #ccc;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.submit-button {\r\n  width: 100%;\r\n  padding: 10px;\r\n  background-color: #28a745;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n}\r\n\r\n.submit-button:hover {\r\n  background-color: #218838;\r\n}\r\n\r\n.result-message {\r\n  margin-top: 15px;\r\n  text-align: center;\r\n}\r\n\r\n.success {\r\n  color: green;\r\n}\r\n\r\n.error {\r\n  color: red;\r\n}\r\n</style>"],"mappings":"AAqDA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,gBAAgB;EACtBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,UAAU,EAAE,EAAE;MAAE;MAChBC,WAAW,EAAE,EAAE;MAAE;MACjBC,eAAe,EAAE,EAAE;MAAE;MACrBC,gBAAgB,EAAE,EAAE;MAAE;MACtBC,oBAAoB,EAAE,KAAK;MAAE;MAC7BC,cAAc,EAAE,OAAO;MAAE;MACzBC,SAAS,EAAE,CAAC;MAAE;MACdC,aAAa,EAAE,EAAE;MAAE;MACnBC,aAAa,EAAE,KAAK,CAAE;IACxB,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP;IACA,MAAMC,oBAAoBA,CAAA,EAAG;MAC3B,IAAI,CAAC,IAAI,CAACV,UAAU,EAAE;QACpBW,KAAK,CAAC,YAAY,CAAC;QACnB;MACF;MAEA,IAAI;QACF;QACA,MAAMd,KAAK,CAACe,IAAI,CAAC,kDAAkD,EAAE;UACnEZ,UAAU,EAAE,IAAI,CAACA;QACnB,CAAC,CAAC;;QAEF;QACA,IAAI,CAACa,cAAc,CAAC,CAAC;MACvB,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,UAAU,EAAEA,KAAK,CAAC;QAChCH,KAAK,CAAC,eAAe,CAAC;MACxB;IACF,CAAC;IACD;IACAE,cAAcA,CAAA,EAAG;MACf,IAAI,CAACT,oBAAmB,GAAI,IAAI;MAChC,IAAI,CAACE,SAAQ,GAAI,EAAE;MACnB,IAAI,CAACD,cAAa,GAAI,GAAG,IAAI,CAACC,SAAS,SAAS;MAEhD,MAAMU,KAAI,GAAIC,WAAW,CAAC,MAAM;QAC9B,IAAI,CAACX,SAAS,EAAE;QAChB,IAAI,IAAI,CAACA,SAAQ,IAAK,CAAC,EAAE;UACvBY,aAAa,CAACF,KAAK,CAAC;UACpB,IAAI,CAACZ,oBAAmB,GAAI,KAAK;UACjC,IAAI,CAACC,cAAa,GAAI,OAAO;QAC/B,OAAO;UACL,IAAI,CAACA,cAAa,GAAI,GAAG,IAAI,CAACC,SAAS,SAAS;QAClD;MACF,CAAC,EAAE,IAAI,CAAC;IACV,CAAC;IACD;IACA,MAAMa,YAAYA,CAAA,EAAG;MACnB,IAAI,CAAC,IAAI,CAACnB,UAAS,IAAK,CAAC,IAAI,CAACC,WAAU,IAAK,CAAC,IAAI,CAACC,eAAc,IAAK,CAAC,IAAI,CAACC,gBAAgB,EAAE;QAC5FQ,KAAK,CAAC,WAAW,CAAC;QAClB;MACF;MAEA,IAAI,IAAI,CAACV,WAA