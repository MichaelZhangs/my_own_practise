class=\"chart-title\">年龄分布</div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script setup>\r\nimport { ref, onMounted, onUnmounted } from 'vue'\r\nimport * as echarts from 'echarts'\r\nimport axios from 'axios'\r\nimport { API_CONFIG } from './config';\r\n\r\nconst genderChart = ref(null)\r\nlet genderChartInstance = null\r\n\r\nonMounted(() => {\r\n  const renderGenderChart = async () => {\r\n    try {\r\n      const response = await axios.get(`${API_CONFIG.BASE_URL}/bigdata/gender-distribution`)\r\n      const data = response.data\r\n      \r\n      genderChartInstance = echarts.init(genderChart.value)\r\n      \r\n      const option = {\r\n        tooltip: {\r\n          trigger: 'item',\r\n          formatter: '{b}: {c}人 ({d}%)'\r\n        },\r\n        legend: {\r\n          orient: 'vertical',\r\n          right: 10,\r\n          top: 'center',\r\n          data: ['男', '女']\r\n        },\r\n        series: [\r\n          {\r\n            name: '性别分布',\r\n            type: 'pie',\r\n            radius: ['50%', '70%'],\r\n            avoidLabelOverlap: false,\r\n            itemStyle: {\r\n              borderRadius: 5,\r\n              borderColor: '#fff',\r\n              borderWidth: 2\r\n            },\r\n            label: {\r\n              show: true,\r\n              formatter: '{b}: {d}%',\r\n              color: '#333',\r\n              fontWeight: 'bold'\r\n            },\r\n            labelLine: {\r\n              show: true,\r\n              length: 10,\r\n              length2: 15\r\n            },\r\n            emphasis: {\r\n              label: {\r\n                show: true,\r\n                fontSize: '18',\r\n                fontWeight: 'bold'\r\n              }\r\n            },\r\n            data: [\r\n              { \r\n                value: data.male_count, \r\n                name: '男',\r\n                itemStyle: {\r\n                  color: '#5470C6'\r\n                }\r\n              },\r\n              { \r\n                value: data.female_count, \r\n                name: '女',\r\n                itemStyle: {\r\n                  color: '#EE6666'\r\n                }\r\n              }\r\n            ]\r\n          }\r\n        ]\r\n      };\r\n      \r\n      genderChartInstance.setOption(option)\r\n      \r\n    } catch (error) {\r\n      console.error('获取性别分布数据失败:', error)\r\n    }\r\n  }\r\n\r\n  renderGenderChart()\r\n  window.addEventListener('resize', handleResize)\r\n})\r\n\r\nconst handleResize = () => {\r\n  if (genderChartInstance) genderChartInstance.resize()\r\n}\r\n\r\nonUnmounted(() => {\r\n  window.removeEventListener('resize', handleResize)\r\n  if (genderChartInstance) {\r\n    genderChartInstance.dispose()\r\n    genderChartInstance = null\r\n  }\r\n})\r\n</script>\r\n\r\n<style scoped>\r\n.dashboard-container {\r\n  padding: 20px;\r\n}\r\n\r\n.charts-row {\r\n  display: flex;\r\n  justify-content: center;\r\n  margin-top: 20px;\r\n}\r\n\r\n.chart-wrapper {\r\n  width: 500px;\r\n  background: #fff;\r\n  border-radius: 8px;\r\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\r\n  padding: 20px;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.chart {\r\n  width: 100%;\r\n  height: 400px;\r\n}\r\n\r\n.chart-title {\r\n  text-align: center;\r\n  margin-top: 15px;\r\n  font-size: 18px;\r\n  font-weight: bold;\r\n  color: #333;\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .chart-wrapper {\r\n    width: 100%;\r\n  }\r\n}\r\n</style>"],"mappings":";;EACOA,KAAK,EAAC;AAAqB;;EACzBA,KAAK,EAAC;AAAY;;EAEhBA,KAAK,EAAC;AAAe;;EACnBC,GAAG,EAAC,aAAa;EAACD,KAAK,EAAC;;;EAK1BA,KAAK,EAAC;AAAe;;EACnBC,GAAG,EAAC,UAAU;EAACD,KAAK,EAAC;;;uBAVhCE,mBAAA,CAcM,OAdNC,UAcM,GAbJC,mBAAA,CAYM,OAZNC,UAYM,GAXJC,mBAAA,YAAe,EACfF,mBAAA,CAGM,OAHNG,UAGM,GAFJH,mBAAA,CAA2C,OAA3CI,UAA2C,+B,0BAC3CJ,mBAAA,CAAqC;IAAhCJ,KAAK,EAAC;EAAa,GAAC,QAAM,qB,GAGjCM,mBAAA,gBAAmB,EACnBF,mBAAA,CAGM,OAHNK,UAGM,GAFJL,mBAAA,CAAwC,OAAxCM,UAAwC,+B,0BACxCN,mBAAA,CAAmC;IAA9BJ,KAAK,EAAC;EAAa,GAAC,MAAI,qB","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}