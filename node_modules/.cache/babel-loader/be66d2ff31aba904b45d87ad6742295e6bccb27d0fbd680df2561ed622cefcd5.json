{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.iterator.some.js\";\nimport \"core-js/modules/web.url-search-params.delete.js\";\nimport \"core-js/modules/web.url-search-params.has.js\";\nimport \"core-js/modules/web.url-search-params.size.js\";\nimport { ref, computed, onMounted, onBeforeUnmount, nextTick } from 'vue';\nimport { Picture, VideoCamera, Smoking, Thumb, ChatDotRound, Close, Loading, Edit } from '@element-plus/icons-vue';\nimport axios from 'axios';\nimport { ElMessage, ElMessageBox } from 'element-plus';\nimport defaultAvatar from '@/assets/default-avatar.png';\n\n// Data\n\nexport default {\n  __name: 'UserArticle',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const currentUser = ref({\n      id: 1,\n      username: '当前用户',\n      photo: 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\n    });\n    const moments = ref([]);\n    const loading = ref(false);\n    const noMore = ref(false);\n    const lastId = ref(null);\n    const container = ref(null);\n    const newMoment = ref({\n      content: '',\n      media: []\n    });\n    const posting = ref(false);\n    const showEmojiPicker = ref(false);\n    const showPreview = ref(false);\n    const previewImages = ref([]);\n    const previewIndex = ref(0);\n    const showPostEditor = ref(false);\n    const emojis = ['😀', '😃', '😄', '😁', '😆', '😅', '😂', '🤣', '😊', '😇', '🙂', '🙃', '😉', '😌', '😍', '🥰', '😘', '😗', '😙', '😚', '😋', '😛', '😝', '😜', '🤪', '🤨', '🧐', '🤓', '😎', '🤩', '🥳'];\n\n    // Computed\n    const visibleMoments = computed(() => {\n      return moments.value.filter(moment => moment.is_delete !== -1);\n    });\n\n    // Methods\n    const fetchMoments = async () => {\n      if (loading.value || noMore.value) return;\n      loading.value = true;\n      try {\n        const params = {\n          is_delete: 0\n        };\n        if (lastId.value) {\n          params.last_id = lastId.value;\n        }\n        const response = await axios.get('/api/moments', {\n          params\n        });\n        if (response.data.length === 0) {\n          noMore.value = true;\n          return;\n        }\n        const newMoments = response.data.map(moment => ({\n          ...moment,\n          showCommentInput: false,\n          newComment: '',\n          is_delete: moment.is_delete || 0\n        }));\n        if (lastId.value) {\n          moments.value = [...moments.value, ...newMoments];\n        } else {\n          moments.value = newMoments;\n        }\n        lastId.value = newMoments[newMoments.length - 1].id;\n      } catch (error) {\n        console.error('获取动态列表失败:', error);\n        ElMessage.error('获取动态失败');\n      } finally {\n        loading.value = false;\n      }\n    };\n    const handleScroll = () => {\n      if (noMore.value || loading.value) return;\n      const {\n        scrollTop,\n        scrollHeight,\n        clientHeight\n      } = container.value;\n      const threshold = 100;\n      if (scrollHeight - (scrollTop + clientHeight) < threshold) {\n        fetchMoments();\n      }\n    };\n    const postMoment = async () => {\n      if (!newMoment.value.content.trim() && newMoment.value.media.length === 0) {\n        ElMessage.warning('请填写内容或上传图片/视频');\n        return;\n      }\n      posting.value = true;\n      try {\n        const formData = new FormData();\n        formData.append('content', newMoment.value.content);\n        newMoment.value.media.forEach((media, index) => {\n          if (media.file) {\n            formData.append(`media_${index}`, media.file);\n          }\n        });\n        const response = await axios.post('/api/moments', formData, {\n          headers: {\n            'Content-Type': 'multipart/form-data'\n          }\n        });\n        moments.value.unshift({\n          ...response.data,\n          showCommentInput: false,\n          newComment: '',\n          is_delete: 0,\n          likes: [],\n          comments: []\n        });\n        newMoment.value.content = '';\n        newMoment.value.media = [];\n        showPostEditor.value = false;\n        ElMessage.success('发布成功');\n      } catch (error) {\n        console.error('发布动态失败:', error);\n        ElMessage.error('发布失败');\n      } finally {\n        posting.value = false;\n      }\n    };\n    const handleUploadSuccess = (response, file) => {\n      const type = file.raw.type.startsWith('image') ? 'image' : 'video';\n      newMoment.value.media.push({\n        type,\n        url: URL.createObjectURL(file.raw),\n        file: file.raw\n      });\n    };\n    const beforeUpload = file => {\n      const isMedia = file.type.startsWith('image/') || file.type.startsWith('video/');\n      const isLt10M = file.size / 1024 / 1024 < 10;\n      if (!isMedia) {\n        ElMessage.error('只能上传图片或视频!');\n        return false;\n      }\n      if (!isLt10M) {\n        ElMessage.error('文件大小不能超过10MB!');\n        return false;\n      }\n      return true;\n    };\n    const removeMedia = index => {\n      newMoment.value.media.splice(index, 1);\n    };\n    const toggleLike = async moment => {\n      try {\n        const isLiked = moment.likes.some(like => like.user_id === currentUser.value.id);\n        if (isLiked) {\n          await axios.delete(`/api/moments/${moment.id}/likes`);\n          moment.likes = moment.likes.filter(like => like.user_id !== currentUser.value.id);\n        } else {\n          const response = await axios.post(`/api/moments/${moment.id}/likes`);\n          moment.likes.push(response.data);\n        }\n      } catch (error) {\n        console.error('操作点赞失败:', error);\n        ElMessage.error('操作失败');\n      }\n    };\n    const toggleCommentInput = moment => {\n      moment.showCommentInput = !moment.showCommentInput;\n      if (moment.showCommentInput) {\n        nextTick(() => {\n          document.querySelector(`.moment-item[data-id=\"${moment.id}\"] .comment-input input`).focus();\n        });\n      }\n    };\n    const postComment = async moment => {\n      if (!moment.newComment.trim()) return;\n      try {\n        const response = await axios.post(`/api/moments/${moment.id}/comments`, {\n          content: moment.newComment\n        });\n        moment.comments.push(response.data);\n        moment.newComment = '';\n        moment.showCommentInput = false;\n        ElMessage.success('评论成功');\n      } catch (error) {\n        console.error('发表评论失败:', error);\n        ElMessage.error('评论失败');\n      }\n    };\n    const confirmDelete = momentId => {\n      ElMessageBox.confirm('确定要删除这条动态吗？', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        softDeleteMoment(momentId);\n      }).catch(() => {});\n    };\n    const softDeleteMoment = async momentId => {\n      try {\n        await axios.patch(`/api/moments/${momentId}`, {\n          is_delete: -1\n        });\n        moments.value = moments.value.filter(moment => moment.id !== momentId);\n        ElMessage.success('删除成功');\n      } catch (error) {\n        console.error('删除动态失败:', error);\n        ElMessage.error('删除失败');\n      }\n    };\n    const openPreview = (mediaList, index) => {\n      previewImages.value = mediaList.filter(media => media.type === 'image').map(media => media.url);\n      if (previewImages.value.length > 0) {\n        previewIndex.value = index;\n        showPreview.value = true;\n      }\n    };\n    const closePreview = () => {\n      showPreview.value = false;\n    };\n    const handleCloseEditor = done => {\n      if (newMoment.value.content || newMoment.value.media.length > 0) {\n        ElMessageBox.confirm('确定要放弃编辑吗？', '提示', {\n          confirmButtonText: '确定',\n          cancelButtonText: '取消',\n          type: 'warning'\n        }).then(() => {\n          newMoment.value.content = '';\n          newMoment.value.media = [];\n          done();\n        }).catch(() => {});\n      } else {\n        done();\n      }\n    };\n    const getMediaGrid = count => {\n      if (count === 1) return '1fr';\n      if (count === 2) return '1fr 1fr';\n      if (count === 3) return '1fr 1fr 1fr';\n      if (count === 4) return '1fr 1fr';\n      return '1fr 1fr 1fr';\n    };\n    const formatDate = dateString => {\n      const date = new Date(dateString);\n      const now = new Date();\n      const diff = now - date;\n      const minutes = Math.floor(diff / 60000);\n      if (minutes < 1) return '刚刚';\n      if (minutes < 60) return `${minutes}分钟前`;\n      const hours = Math.floor(minutes / 60);\n      if (hours < 24) return `${hours}小时前`;\n      const days = Math.floor(hours / 24);\n      if (days < 7) return `${days}天前`;\n      return date.toLocaleDateString();\n    };\n\n    // const getUserAvatar = (userId) => {\n    //   // In a real app, you would fetch this from your users data\n    //   return 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\n    // }\n\n    const getUsername = userId => {\n      // In a real app, you would fetch this from your users data\n      return `用户${userId}`;\n    };\n    const insertEmoji = emoji => {\n      newMoment.value.content += emoji;\n      showEmojiPicker.value = false;\n    };\n\n    // Lifecycle Hooks\n    onMounted(() => {\n      fetchMoments();\n      window.addEventListener('scroll', handleScroll);\n    });\n    onBeforeUnmount(() => {\n      window.removeEventListener('scroll', handleScroll);\n    });\n    const __returned__ = {\n      currentUser,\n      moments,\n      loading,\n      noMore,\n      lastId,\n      container,\n      newMoment,\n      posting,\n      showEmojiPicker,\n      showPreview,\n      previewImages,\n      previewIndex,\n      showPostEditor,\n      emojis,\n      visibleMoments,\n      fetchMoments,\n      handleScroll,\n      postMoment,\n      handleUploadSuccess,\n      beforeUpload,\n      removeMedia,\n      toggleLike,\n      toggleCommentInput,\n      postComment,\n      confirmDelete,\n      softDeleteMoment,\n      openPreview,\n      closePreview,\n      handleCloseEditor,\n      getMediaGrid,\n      formatDate,\n      getUsername,\n      insertEmoji,\n      ref,\n      computed,\n      onMounted,\n      onBeforeUnmount,\n      nextTick,\n      get Picture() {\n        return Picture;\n      },\n      get VideoCamera() {\n        return VideoCamera;\n      },\n      get Smoking() {\n        return Smoking;\n      },\n      get Thumb() {\n        return Thumb;\n      },\n      get ChatDotRound() {\n        return ChatDotRound;\n      },\n      get Close() {\n        return Close;\n      },\n      get Loading() {\n        return Loading;\n      },\n      get Edit() {\n        return Edit;\n      },\n      get axios() {\n        return axios;\n      },\n      get ElMessage() {\n        return ElMessage;\n      },\n      get ElMessageBox() {\n        return ElMessageBox;\n      },\n      get defaultAvatar() {\n        return defaultAvatar;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","onBeforeUnmount","nextTick","Picture","VideoCamera","Smoking","Thumb","ChatDotRound","Close","Loading","Edit","axios","ElMessage","ElMessageBox","defaultAvatar","currentUser","id","username","photo","moments","loading","noMore","lastId","container","newMoment","content","media","posting","showEmojiPicker","showPreview","previewImages","previewIndex","showPostEditor","emojis","visibleMoments","value","filter","moment","is_delete","fetchMoments","params","last_id","response","get","data","length","newMoments","map","showCommentInput","newComment","error","console","handleScroll","scrollTop","scrollHeight","clientHeight","threshold","postMoment","trim","warning","formData","FormData","append","forEach","index","file","post","headers","unshift","likes","comments","success","handleUploadSuccess","type","raw","startsWith","push","url","URL","createObjectURL","beforeUpload","isMedia","isLt10M","size","removeMedia","splice","toggleLike","isLiked","some","like","user_id","delete","toggleCommentInput","document","querySelector","focus","postComment","confirmDelete","momentId","confirm","confirmButtonText","cancelButtonText","then","softDeleteMoment","catch","patch","openPreview","mediaList","closePreview","handleCloseEditor","done","getMediaGrid","count","formatDate","dateString","date","Date","now","diff","minutes","Math","floor","hours","days","toLocaleDateString","getUsername","userId","insertEmoji","emoji","window","addEventListener","removeEventListener"],"sources":["E:/vue_fastapi/my_vue/vue_pro/src/article/UserArticle.vue"],"sourcesContent":["<template>\r\n  <div class=\"moment-container\" ref=\"container\">\r\n    <!-- Header -->\r\n    <div class=\"header\">\r\n      <h2>朋友圈</h2>\r\n    </div>\r\n\r\n    <!-- Moments List -->\r\n    <div class=\"moment-list\">\r\n      <template v-if=\"moments.length > 0\">\r\n        <div \r\n          v-for=\"moment in visibleMoments\" \r\n          :key=\"moment.id\" \r\n          class=\"moment-item\"\r\n        >\r\n          <!-- User Info -->\r\n          <div class=\"user-info\">\r\n            <el-avatar :src=\"getUserAvatar(moment.user_id)\" />\r\n            <div class=\"user-details\">\r\n              <div class=\"user-meta\">\r\n                <span class=\"username\">{{ getUsername(moment.user_id) }}</span>\r\n                <el-button \r\n                  v-if=\"moment.user_id === currentUser.id\"\r\n                  type=\"text\" \r\n                  size=\"small\" \r\n                  @click=\"confirmDelete(moment.id)\"\r\n                  class=\"delete-btn\"\r\n                >\r\n                  删除\r\n                </el-button>\r\n              </div>\r\n              <span class=\"post-time\">{{ formatDate(moment.created_at) }}</span>\r\n            </div>\r\n          </div>\r\n          \r\n          <!-- Content -->\r\n          <div class=\"moment-content\">{{ moment.content }}</div>\r\n          \r\n          <!-- Media -->\r\n          <div \r\n            class=\"media-container\" \r\n            v-if=\"moment.media && moment.media.length > 0\"\r\n            :style=\"{ 'grid-template-columns': getMediaGrid(moment.media.length) }\"\r\n          >\r\n            <div \r\n              v-for=\"(media, index) in moment.media\" \r\n              :key=\"index\" \r\n              class=\"media-item\"\r\n            >\r\n              <img \r\n                v-if=\"media.type === 'image'\" \r\n                :src=\"media.url\" \r\n                @click=\"openPreview(moment.media, index)\"\r\n              />\r\n              <video \r\n                v-else \r\n                :src=\"media.url\" \r\n                controls\r\n              />\r\n            </div>\r\n          </div>\r\n          \r\n          <!-- Interactions -->\r\n          <div class=\"interaction\">\r\n            <div class=\"action-buttons\">\r\n              <el-button \r\n                :icon=\"Thumb\" \r\n                :type=\"moment.likes.some(like => like.user_id === currentUser.id) ? 'primary' : 'text'\"\r\n                @click=\"toggleLike(moment)\"\r\n                size=\"small\"\r\n              >\r\n                {{ moment.likes.length }}\r\n              </el-button>\r\n              <el-button \r\n                :icon=\"ChatDotRound\" \r\n                @click=\"toggleCommentInput(moment)\"\r\n                size=\"small\"\r\n              >\r\n                {{ moment.comments.length }}\r\n              </el-button>\r\n            </div>\r\n            \r\n            <!-- Comment Input -->\r\n            <div v-if=\"moment.showCommentInput\" class=\"comment-input\">\r\n              <el-input\r\n                v-model=\"moment.newComment\"\r\n                placeholder=\"写评论...\"\r\n                size=\"small\"\r\n                @keyup.enter=\"postComment(moment)\"\r\n              >\r\n                <template #append>\r\n                  <el-button @click=\"postComment(moment)\">\r\n                    发送\r\n                  </el-button>\r\n                </template>\r\n              </el-input>\r\n            </div>\r\n            \r\n            <!-- Comments List -->\r\n            <div v-if=\"moment.comments.length > 0\" class=\"comment-list\">\r\n              <div \r\n                v-for=\"comment in moment.comments\" \r\n                :key=\"comment.id\" \r\n                class=\"comment-item\"\r\n              >\r\n                <span class=\"comment-user\">{{ getUsername(comment.user_id) }}：</span>\r\n                <span class=\"comment-content\">{{ comment.content }}</span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </template>\r\n      <div v-else class=\"empty-state\">\r\n        <el-empty description=\"当前没有任何内容，请发布哦\">\r\n          <el-button \r\n            type=\"primary\" \r\n            @click=\"showPostEditor = true\"\r\n            :icon=\"Edit\"\r\n          >\r\n            发布第一条动态\r\n          </el-button>\r\n        </el-empty>\r\n      </div>\r\n      \r\n      <!-- Loading States -->\r\n      <div v-if=\"loading\" class=\"loading-more\">\r\n        <el-icon class=\"is-loading\"><Loading /></el-icon>\r\n        <span>加载中...</span>\r\n      </div>\r\n      <div v-if=\"noMore && moments.length > 0\" class=\"no-more\">\r\n        没有更多内容了\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Image Preview -->\r\n    <el-image-viewer\r\n      v-if=\"showPreview\"\r\n      :url-list=\"previewImages\"\r\n      :initial-index=\"previewIndex\"\r\n      @close=\"closePreview\"\r\n    />\r\n\r\n    <!-- Floating Post Button -->\r\n    <el-button \r\n      type=\"primary\" \r\n      class=\"floating-button\" \r\n      @click=\"showPostEditor = true\"\r\n      :icon=\"Edit\"\r\n      circle\r\n    />\r\n\r\n    <!-- Post Editor -->\r\n    <el-dialog\r\n      v-model=\"showPostEditor\"\r\n      title=\"发布动态\"\r\n      width=\"90%\"\r\n      :max-width=\"600\"\r\n      :before-close=\"handleCloseEditor\"\r\n    >\r\n      <div class=\"post-editor\">\r\n        <div class=\"user-info\">\r\n          <el-avatar :src=\"currentUser.photo || defaultAvatar\" />\r\n          <div class=\"post-input\">\r\n            <el-input\r\n              v-model=\"newMoment.content\"\r\n              type=\"textarea\"\r\n              :rows=\"3\"\r\n              placeholder=\"分享你的想法...\"\r\n              resize=\"none\"\r\n            />\r\n            <div class=\"media-preview\" v-if=\"newMoment.media.length > 0\">\r\n              <div \r\n                v-for=\"(media, index) in newMoment.media\" \r\n                :key=\"index\" \r\n                class=\"media-item\"\r\n              >\r\n                <img \r\n                  v-if=\"media.type === 'image'\" \r\n                  :src=\"media.url\" \r\n                  @click=\"openPreview(newMoment.media, index)\"\r\n                />\r\n                <video \r\n                  v-else \r\n                  :src=\"media.url\" \r\n                  controls\r\n                />\r\n                <el-icon class=\"delete-icon\" @click=\"removeMedia(index)\">\r\n                  <Close />\r\n                </el-icon>\r\n              </div>\r\n            </div>\r\n            <div class=\"post-actions\">\r\n              <div class=\"action-buttons\">\r\n                <el-upload\r\n                  action=\"/api/upload\"\r\n                  :show-file-list=\"false\"\r\n                  :multiple=\"true\"\r\n                  :limit=\"9\"\r\n                  accept=\"image/*,video/*\"\r\n                  :on-success=\"handleUploadSuccess\"\r\n                  :before-upload=\"beforeUpload\"\r\n                >\r\n                  <el-button type=\"text\" :icon=\"Picture\" />\r\n                </el-upload>\r\n                <el-button type=\"text\" :icon=\"VideoCamera\" />\r\n                <el-button type=\"text\" :icon=\"Smoking\" @click=\"showEmojiPicker = !showEmojiPicker\" />\r\n              </div>\r\n              <el-button \r\n                type=\"primary\" \r\n                size=\"small\" \r\n                @click=\"postMoment\"\r\n                :loading=\"posting\"\r\n              >\r\n                发布\r\n              </el-button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </el-dialog>\r\n\r\n    <!-- Emoji Picker -->\r\n    <el-popover\r\n      v-model:visible=\"showEmojiPicker\"\r\n      placement=\"top-start\"\r\n      :width=\"300\"\r\n      trigger=\"click\"\r\n    >\r\n      <div class=\"emoji-grid\">\r\n        <span \r\n          v-for=\"emoji in emojis\" \r\n          :key=\"emoji\" \r\n          @click=\"insertEmoji(emoji)\"\r\n          class=\"emoji-item\"\r\n        >\r\n          {{ emoji }}\r\n        </span>\r\n      </div>\r\n      <template #reference>\r\n        <div style=\"display: none;\"></div>\r\n      </template>\r\n    </el-popover>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, computed, onMounted, onBeforeUnmount,nextTick } from 'vue'\r\nimport { \r\n  Picture, VideoCamera, Smoking, Thumb, ChatDotRound, Close, Loading, Edit \r\n} from '@element-plus/icons-vue'\r\nimport axios from 'axios'\r\nimport { ElMessage, ElMessageBox } from 'element-plus'\r\nimport defaultAvatar from '@/assets/default-avatar.png'\r\n\r\n// Data\r\nconst currentUser = ref({\r\n  id: 1,\r\n  username: '当前用户',\r\n  photo: 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\r\n})\r\n\r\nconst moments = ref([])\r\nconst loading = ref(false)\r\nconst noMore = ref(false)\r\nconst lastId = ref(null)\r\nconst container = ref(null)\r\n\r\nconst newMoment = ref({\r\n  content: '',\r\n  media: []\r\n})\r\n\r\nconst posting = ref(false)\r\nconst showEmojiPicker = ref(false)\r\nconst showPreview = ref(false)\r\nconst previewImages = ref([])\r\nconst previewIndex = ref(0)\r\nconst showPostEditor = ref(false)\r\n\r\nconst emojis = ['😀', '😃', '😄', '😁', '😆', '😅', '😂', '🤣', '😊', '😇', '🙂', '🙃', '😉', '😌', '😍', '🥰', '😘', '😗', '😙', '😚', '😋', '😛', '😝', '😜', '🤪', '🤨', '🧐', '🤓', '😎', '🤩', '🥳']\r\n\r\n// Computed\r\nconst visibleMoments = computed(() => {\r\n  return moments.value.filter(moment => moment.is_delete !== -1)\r\n})\r\n\r\n// Methods\r\nconst fetchMoments = async () => {\r\n  if (loading.value || noMore.value) return\r\n  \r\n  loading.value = true\r\n  \r\n  try {\r\n    const params = { is_delete: 0 }\r\n    if (lastId.value) {\r\n      params.last_id = lastId.value\r\n    }\r\n    \r\n    const response = await axios.get('/api/moments', { params })\r\n    \r\n    if (response.data.length === 0) {\r\n      noMore.value = true\r\n      return\r\n    }\r\n    \r\n    const newMoments = response.data.map(moment => ({\r\n      ...moment,\r\n      showCommentInput: false,\r\n      newComment: '',\r\n      is_delete: moment.is_delete || 0\r\n    }))\r\n    \r\n    if (lastId.value) {\r\n      moments.value = [...moments.value, ...newMoments]\r\n    } else {\r\n      moments.value = newMoments\r\n    }\r\n    \r\n    lastId.value = newMoments[newMoments.length - 1].id\r\n  } catch (error) {\r\n    console.error('获取动态列表失败:', error)\r\n    ElMessage.error('获取动态失败')\r\n  } finally {\r\n    loading.value = false\r\n  }\r\n}\r\n\r\nconst handleScroll = () => {\r\n  if (noMore.value || loading.value) return\r\n  \r\n  const { scrollTop, scrollHeight, clientHeight } = container.value\r\n  const threshold = 100\r\n  \r\n  if (scrollHeight - (scrollTop + clientHeight) < threshold) {\r\n    fetchMoments()\r\n  }\r\n}\r\n\r\nconst postMoment = async () => {\r\n  if (!newMoment.value.content.trim() && newMoment.value.media.length === 0) {\r\n    ElMessage.warning('请填写内容或上传图片/视频')\r\n    return\r\n  }\r\n  \r\n  posting.value = true\r\n  \r\n  try {\r\n    const formData = new FormData()\r\n    formData.append('content', newMoment.value.content)\r\n    newMoment.value.media.forEach((media, index) => {\r\n      if (media.file) {\r\n        formData.append(`media_${index}`, media.file)\r\n      }\r\n    })\r\n    \r\n    const response = await axios.post('/api/moments', formData, {\r\n      headers: {\r\n        'Content-Type': 'multipart/form-data'\r\n      }\r\n    })\r\n    \r\n    moments.value.unshift({\r\n      ...response.data,\r\n      showCommentInput: false,\r\n      newComment: '',\r\n      is_delete: 0,\r\n      likes: [],\r\n      comments: []\r\n    })\r\n    \r\n    newMoment.value.content = ''\r\n    newMoment.value.media = []\r\n    showPostEditor.value = false\r\n    ElMessage.success('发布成功')\r\n  } catch (error) {\r\n    console.error('发布动态失败:', error)\r\n    ElMessage.error('发布失败')\r\n  } finally {\r\n    posting.value = false\r\n  }\r\n}\r\n\r\nconst handleUploadSuccess = (response, file) => {\r\n  const type = file.raw.type.startsWith('image') ? 'image' : 'video'\r\n  newMoment.value.media.push({\r\n    type,\r\n    url: URL.createObjectURL(file.raw),\r\n    file: file.raw\r\n  })\r\n}\r\n\r\nconst beforeUpload = (file) => {\r\n  const isMedia = file.type.startsWith('image/') || file.type.startsWith('video/')\r\n  const isLt10M = file.size / 1024 / 1024 < 10\r\n  \r\n  if (!isMedia) {\r\n    ElMessage.error('只能上传图片或视频!')\r\n    return false\r\n  }\r\n  if (!isLt10M) {\r\n    ElMessage.error('文件大小不能超过10MB!')\r\n    return false\r\n  }\r\n  \r\n  return true\r\n}\r\n\r\nconst removeMedia = (index) => {\r\n  newMoment.value.media.splice(index, 1)\r\n}\r\n\r\nconst toggleLike = async (moment) => {\r\n  try {\r\n    const isLiked = moment.likes.some(like => like.user_id === currentUser.value.id)\r\n    \r\n    if (isLiked) {\r\n      await axios.delete(`/api/moments/${moment.id}/likes`)\r\n      moment.likes = moment.likes.filter(like => like.user_id !== currentUser.value.id)\r\n    } else {\r\n      const response = await axios.post(`/api/moments/${moment.id}/likes`)\r\n      moment.likes.push(response.data)\r\n    }\r\n  } catch (error) {\r\n    console.error('操作点赞失败:', error)\r\n    ElMessage.error('操作失败')\r\n  }\r\n}\r\n\r\nconst toggleCommentInput = (moment) => {\r\n  moment.showCommentInput = !moment.showCommentInput\r\n  if (moment.showCommentInput) {\r\n    nextTick(() => {\r\n      document.querySelector(`.moment-item[data-id=\"${moment.id}\"] .comment-input input`).focus()\r\n    })\r\n  }\r\n}\r\n\r\nconst postComment = async (moment) => {\r\n  if (!moment.newComment.trim()) return\r\n  \r\n  try {\r\n    const response = await axios.post(`/api/moments/${moment.id}/comments`, {\r\n      content: moment.newComment\r\n    })\r\n    \r\n    moment.comments.push(response.data)\r\n    moment.newComment = ''\r\n    moment.showCommentInput = false\r\n    ElMessage.success('评论成功')\r\n  } catch (error) {\r\n    console.error('发表评论失败:', error)\r\n    ElMessage.error('评论失败')\r\n  }\r\n}\r\n\r\nconst confirmDelete = (momentId) => {\r\n  ElMessageBox.confirm('确定要删除这条动态吗？', '提示', {\r\n    confirmButtonText: '确定',\r\n    cancelButtonText: '取消',\r\n    type: 'warning'\r\n  }).then(() => {\r\n    softDeleteMoment(momentId)\r\n  }).catch(() => {})\r\n}\r\n\r\nconst softDeleteMoment = async (momentId) => {\r\n  try {\r\n    await axios.patch(`/api/moments/${momentId}`, {\r\n      is_delete: -1\r\n    })\r\n    \r\n    moments.value = moments.value.filter(moment => moment.id !== momentId)\r\n    ElMessage.success('删除成功')\r\n  } catch (error) {\r\n    console.error('删除动态失败:', error)\r\n    ElMessage.error('删除失败')\r\n  }\r\n}\r\n\r\nconst openPreview = (mediaList, index) => {\r\n  previewImages.value = mediaList\r\n    .filter(media => media.type === 'image')\r\n    .map(media => media.url)\r\n  \r\n  if (previewImages.value.length > 0) {\r\n    previewIndex.value = index\r\n    showPreview.value = true\r\n  }\r\n}\r\n\r\nconst closePreview = () => {\r\n  showPreview.value = false\r\n}\r\n\r\nconst handleCloseEditor = (done) => {\r\n  if (newMoment.value.content || newMoment.value.media.length > 0) {\r\n    ElMessageBox.confirm('确定要放弃编辑吗？', '提示', {\r\n      confirmButtonText: '确定',\r\n      cancelButtonText: '取消',\r\n      type: 'warning'\r\n    }).then(() => {\r\n      newMoment.value.content = ''\r\n      newMoment.value.media = []\r\n      done()\r\n    }).catch(() => {})\r\n  } else {\r\n    done()\r\n  }\r\n}\r\n\r\nconst getMediaGrid = (count) => {\r\n  if (count === 1) return '1fr'\r\n  if (count === 2) return '1fr 1fr'\r\n  if (count === 3) return '1fr 1fr 1fr'\r\n  if (count === 4) return '1fr 1fr'\r\n  return '1fr 1fr 1fr'\r\n}\r\n\r\nconst formatDate = (dateString) => {\r\n  const date = new Date(dateString)\r\n  const now = new Date()\r\n  const diff = now - date\r\n  const minutes = Math.floor(diff / 60000)\r\n  \r\n  if (minutes < 1) return '刚刚'\r\n  if (minutes < 60) return `${minutes}分钟前`\r\n  \r\n  const hours = Math.floor(minutes / 60)\r\n  if (hours < 24) return `${hours}小时前`\r\n  \r\n  const days = Math.floor(hours / 24)\r\n  if (days < 7) return `${days}天前`\r\n  \r\n  return date.toLocaleDateString()\r\n}\r\n\r\n// const getUserAvatar = (userId) => {\r\n//   // In a real app, you would fetch this from your users data\r\n//   return 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\r\n// }\r\n\r\nconst getUsername = (userId) => {\r\n  // In a real app, you would fetch this from your users data\r\n  return `用户${userId}`\r\n}\r\n\r\nconst insertEmoji = (emoji) => {\r\n  newMoment.value.content += emoji\r\n  showEmojiPicker.value = false\r\n}\r\n\r\n// Lifecycle Hooks\r\nonMounted(() => {\r\n  fetchMoments()\r\n  window.addEventListener('scroll', handleScroll)\r\n})\r\n\r\nonBeforeUnmount(() => {\r\n  window.removeEventListener('scroll', handleScroll)\r\n})\r\n</script>\r\n\r\n<style scoped>\r\n.moment-container {\r\n  max-width: 600px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n  background-color: #fff;\r\n  box-shadow: 0 0 5px rgba(0, 0, 0, 0.1);\r\n  border-radius: 10px;\r\n  position: relative;\r\n}\r\n\r\n.header {\r\n  text-align: center;\r\n  margin-bottom: 20px;\r\n  padding-bottom: 15px;\r\n  border-bottom: 1px solid #f0f0f0;\r\n}\r\n\r\n.moment-list {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 20px;\r\n}\r\n\r\n.empty-state {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  height: 300px;\r\n  background-color: #f9f9f9;\r\n  border-radius: 8px;\r\n  margin-top: 20px;\r\n}\r\n\r\n.empty-state .el-empty {\r\n  padding: 20px;\r\n}\r\n\r\n.empty-state .el-button {\r\n  margin-top: 20px;\r\n}\r\n\r\n.moment-item {\r\n  padding: 15px;\r\n  border-radius: 8px;\r\n  background-color: #f9f9f9;\r\n  box-shadow: 0 0 3px rgba(0, 0, 0, 0.08);\r\n}\r\n\r\n.user-info {\r\n  display: flex;\r\n  gap: 10px;\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.user-details {\r\n  display: flex;\r\n  flex-direction: column;\r\n  flex: 1;\r\n}\r\n\r\n.user-meta {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n}\r\n\r\n.username {\r\n  font-weight: bold;\r\n}\r\n\r\n.post-time {\r\n  font-size: 12px;\r\n  color: #999;\r\n}\r\n\r\n.delete-btn {\r\n  color: #f56c6c;\r\n  padding: 0;\r\n  margin-left: 10px;\r\n}\r\n\r\n.delete-btn:hover {\r\n  color: #f78989;\r\n}\r\n\r\n.moment-content {\r\n  margin: 10px 0;\r\n  line-height: 1.5;\r\n  word-break: break-word;\r\n}\r\n\r\n.media-container {\r\n  display: grid;\r\n  gap: 5px;\r\n  margin: 10px 0;\r\n}\r\n\r\n.media-container .media-item {\r\n  position: relative;\r\n  border-radius: 4px;\r\n  overflow: hidden;\r\n  aspect-ratio: 1/1;\r\n}\r\n\r\n.media-container .media-item img,\r\n.media-container .media-item video {\r\n  width: 100%;\r\n  height: 100%;\r\n 