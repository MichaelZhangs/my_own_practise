eturn _openBlock(), _createElementBlock(\"div\", _hoisted_1, [_createCommentVNode(\" 用户信息区域 \"), _createElementVNode(\"div\", _hoisted_2, [_createElementVNode(\"img\", {\n    src: $setup.getFullUrl($setup.currentUser.value.photo) || $setup.defaultAvatar,\n    class: \"user-avatar\",\n    onClick: _cache[0] || (_cache[0] = (...args) => $setup.goToUserPage && $setup.goToUserPage(...args))\n  }, null, 8 /* PROPS */, _hoisted_3), _createElementVNode(\"div\", _hoisted_4, [_createElementVNode(\"span\", _hoisted_5, _toDisplayString($setup.currentUser.value.id), 1 /* TEXT */), _createElementVNode(\"span\", _hoisted_6, _toDisplayString($setup.currentUser.value.username), 1 /* TEXT */)])]), _createCommentVNode(\" 头部容器 \"), _cache[4] || (_cache[4] = _createElementVNode(\"div\", {\n    class: \"moments-header\"\n  }, [_createElementVNode(\"div\", {\n    class: \"header-content\"\n  }, [_createElementVNode(\"div\", {\n    class: \"title-container\"\n  }, [_createElementVNode(\"h1\", null, \"朋友圈\")])])], -1 /* HOISTED */)), _createCommentVNode(\" 独立定位的发布按钮 \"), _createElementVNode(\"button\", {\n    class: \"publish-btn\",\n    onClick: _cache[1] || (_cache[1] = (...args) => $setup.goToPublish && $setup.goToPublish(...args))\n  }, \"+\"), _createCommentVNode(\" 内容容器 \"), _createElementVNode(\"div\", _hoisted_7, [_createElementVNode(\"div\", _hoisted_8, [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList($setup.moments, moment => {\n    return _openBlock(), _createElementBlock(\"div\", {\n      key: moment.id,\n      class: \"moment-item\"\n    }, [_createCommentVNode(\" 用户信息 \"), _createElementVNode(\"div\", _hoisted_9, [_createElementVNode(\"img\", {\n      src: $setup.getFullUrl(moment.user.photo) || $setup.defaultAvatar,\n      class: \"user-avatar\"\n    }, null, 8 /* PROPS */, _hoisted_10), _createElementVNode(\"div\", _hoisted_11, [_createElementVNode(\"span\", _hoisted_12, _toDisplayString(moment.user.username), 1 /* TEXT */), _createElementVNode(\"span\", _hoisted_13, _toDisplayString($setup.formatTime(moment.created_at)), 1 /* TEXT */)])]), _createCommentVNode(\" 动态内容 \"), _createElementVNode(\"div\", {\n      class: \"moment-content\",\n      innerHTML: $setup.sanitizeHtml(moment.content)\n    }, null, 8 /* PROPS */, _hoisted_14), _createCommentVNode(\" 图片展示 \"), moment.media?.length ? (_openBlock(), _createElementBlock(\"div\", _hoisted_15, [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList(moment.media, (media, index) => {\n      return _openBlock(), _createElementBlock(\"div\", {\n        key: index,\n        class: _normalizeClass([\"media-item\", {\n          'video-container': media.type === 'video'\n        }])\n      }, [media.type === 'image' ? (_openBlock(), _createElementBlock(\"img\", {\n        key: 0,\n        src: $setup.getFullUrl(media.url),\n        onClick: $event => $setup.openImagePreview($setup.getFullUrl(media.url))\n      }, null, 8 /* PROPS */, _hoisted_16)) : media.type === 'video' ? (_openBlock(), _createElementBlock(_Fragment, {\n        key: 1\n      }, [_createCommentVNode(\" 视频展示 \"), _createElementVNode(\"video\", {\n        src: $setup.getFullUrl(media.url),\n        controls: \"\",\n        poster: $setup.getFullUrl(media.thumbnail),\n        onClick: _cache[2] || (_cache[2] = _withModifiers((...args) => _ctx.handleVideoClick && _ctx.handleVideoClick(...args), [\"stop\"]))\n      }, [_createElementVNode(\"source\", {\n        src: $setup.getFullUrl(media.url),\n        type: $setup.getVideoType(media.url)\n      }, null, 8 /* PROPS */, _hoisted_18), _cache[3] || (_cache[3] = _createTextVNode(\" 您的浏览器不支持视频播放 \"))], 8 /* PROPS */, _hoisted_17)], 2112 /* STABLE_FRAGMENT, DEV_ROOT_FRAGMENT */)) : _createCommentVNode(\"v-if\", true)], 2 /* CLASS */);\n    }), 128 /* KEYED_FRAGMENT */))])) : _createCommentVNode(\"v-if\", true), _createCommentVNode(\" 点赞和评论区域 \"), _createElementVNode(\"div\", _hoisted_19, [_createElementVNode(\"div\", _hoisted_20, [_createElementVNode(\"i\", {\n      class: _normalizeClass([\"fa-solid fa-thumbs-up\", {\n        'liked': moment.isLiked\n      }]),\n      onClick: $event => $setup.likeMoment(moment.id)\n    }, null, 10 /* CLASS, PROPS */, _hoisted_21), _createElementVNode(\"span\", null, _toDisplayString(moment.stats.likes), 1 /* TEXT */)]), _createElementVNode(\"div\", _hoisted_22, [_createElementVNode(\"div\", _hoisted_23, [_createElementVNode(\"i\", {\n      class: \"fa-solid fa-comment\",\n      onClick: $event => $setup.commentIconClick(moment)\n    }, null, 8 /* PROPS */, _hoisted_24), _createElementVNode(\"span\", null, _toDisplayString(moment.stats.comments), 1 /* TEXT */)]), moment.showCommentInput ? (_openBlock(), _createElementBlock(\"div\", {\n      key: 0,\n      class: _normalizeClass(['comment-input-container', moment.commentInputContainerClass])\n    }, [_withDirectives(_createElementVNode(\"input\", {\n      type: \"text\",\n      \"onUpdate:modelValue\": $event => moment.commentInput = $event,\n      placeholder: \"发表评论\"\n    }, null, 8 /* PROPS */, _hoisted_25), [[_vModelText, moment.commentInput]]), _createElementVNode(\"button\", {\n      onClick: $event => $setup.postComment(moment.id)\n    }, \"发布\", 8 /* PROPS */, _hoisted_26)], 2 /* CLASS */)) : _createCommentVNode(\"v-if\", true)])]), _createCommentVNode(\" 底部操作区域 \"), _createElementVNode(\"div\", _hoisted_27, [_createElementVNode(\"span\", _hoisted_28, _toDisplayString($setup.getTimeAgo(moment.created_at)), 1 /* TEXT */), moment.user_id === $setup.currentUser.value.id ? (_openBlock(), _createElementBlock(\"i\", {\n      key: 0,\n      class: \"fa-solid fa-trash-can delete-btn\",\n      onClick: $event => $setup.deleteMoment(moment.id)\n    }, null, 8 /* PROPS */, _hoisted_29)) : _createCommentVNode(\"v-if\", true)])]);\n  }), 128 /* KEYED_FRAGMENT */))]), $setup.noMore ? (_openBlock(), _createElementBlock(\"div\", _hoisted_30, \"没有其他的内容了哦\")) : _createCommentVNode(\"v-if\", true)])]);\n}","map":{"version":3,"names":["class","key","_createElementBlock","_hoisted_1","_createCommentVNode","_createElementVNode","_hoisted_2","src","$setup","getFullUrl","currentUser","value","photo","defaultAvatar","onClick","_cache","args","goToUserPage","_hoisted_3","_hoisted_4","_hoisted_5","_toDisplayString","id","_hoisted_6","username","goToPublish","_hoisted_7","_hoisted_8","_Fragment","_renderList","moments","moment","_hoisted_9","user","_hoisted_10","_hoisted_11","_hoisted_12","_hoisted_13","formatTime","created_at","innerHTML","sanitizeHtml","content","_hoisted_14","media","length","_hoisted_15","index","_normalizeClass","type","url","$event","openImagePreview","_hoisted_16","controls","poster","thumbnail","_withModifiers","_ctx","handleVideoClick","getVideoType","_hoisted_18","_createTextVNode","_hoisted_17","_hoisted_19","_hoisted_20","isLiked","likeMoment","_hoisted_21","stats","likes","_hoisted_22","_hoisted_23","commentIconClick","_hoisted_24","comments","showCommentInput","commentInputContainerClass","commentInput","placeholder","_hoisted_25","postComment","_hoisted_26","_hoisted_27","_hoisted_28","getTimeAgo","user_id","deleteMoment","_hoisted_29","noMore","_hoisted_30"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\article\\UserMoments.vue"],"sourcesContent":["<template>\r\n  <div class=\"moments-page\">\r\n    <!-- 用户信息区域 -->\r\n    <div class=\"user-profile\">\r\n      <img :src=\"getFullUrl(currentUser.value.photo) || defaultAvatar\" class=\"user-avatar\" @click=\"goToUserPage\" />\r\n      <div class=\"user-details\">\r\n        <span class=\"user-id\">{{ currentUser.value.id }}</span>\r\n        <span class=\"username\">{{ currentUser.value.username }}</span>\r\n      </div>\r\n    </div>\r\n    <!-- 头部容器 -->\r\n    <div class=\"moments-header\">\r\n      <div class=\"header-content\">\r\n        <div class=\"title-container\">\r\n          <h1>朋友圈</h1>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 独立定位的发布按钮 -->\r\n    <button class=\"publish-btn\" @click=\"goToPublish\">+</button>\r\n\r\n    <!-- 内容容器 -->\r\n    <div class=\"moments-container\">\r\n      <div class=\"moments-list\">\r\n        <div \r\n          v-for=\"moment in moments\" \r\n          :key=\"moment.id\" \r\n          class=\"moment-item\"\r\n        >\r\n          <!-- 用户信息 -->\r\n          <div class=\"user-info\">\r\n            <img :src=\"getFullUrl(moment.user.photo) || defaultAvatar\" class=\"user-avatar\" />\r\n            <div class=\"user-details\">\r\n              <span class=\"username\">{{ moment.user.username }}</span>\r\n              <span class=\"post-time\">{{ formatTime(moment.created_at) }}</span>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- 动态内容 -->\r\n          <div class=\"moment-content\" v-html=\"sanitizeHtml(moment.content)\"></div>\r\n\r\n          <!-- 图片展示 -->\r\n          <div v-if=\"moment.media?.length\" class=\"media-grid\">\r\n            <div \r\n              v-for=\"(media, index) in moment.media\" \r\n              :key=\"index\"\r\n              class=\"media-item\"\r\n              :class=\"{ 'video-container': media.type === 'video' }\"\r\n            >\r\n              <img \r\n                v-if=\"media.type === 'image'\"\r\n                :src=\"getFullUrl(media.url)\"\r\n                @click=\"openImagePreview(getFullUrl(media.url))\"\r\n              />\r\n              <!-- 视频展示 -->\r\n              <video \r\n                v-else-if=\"media.type === 'video'\"\r\n                :src=\"getFullUrl(media.url)\"\r\n                controls\r\n                :poster=\"getFullUrl(media.thumbnail)\"   \r\n                @click.stop=\"handleVideoClick\"\r\n              >\r\n                <source :src=\"getFullUrl(media.url)\" :type=\"getVideoType(media.url)\">\r\n                您的浏览器不支持视频播放\r\n              </video>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- 点赞和评论区域 -->\r\n          <div class=\"moment-interaction\">\r\n            <div class=\"like-container\">\r\n              <i \r\n                class=\"fa-solid fa-thumbs-up\" \r\n                :class=\"{ 'liked': moment.isLiked }\"\r\n                @click=\"likeMoment(moment.id)\"\r\n              ></i>\r\n              <span>{{ moment.stats.likes }}</span>\r\n            </div>\r\n            <div class=\"comment-container\">\r\n              <div class=\"comment-icon-container\">\r\n                <i class=\"fa-solid fa-comment\" @click=\"commentIconClick(moment)\"></i> \r\n                <span>{{ moment.stats.comments }}</span>\r\n              </div>\r\n              <div v-if=\"moment.showCommentInput\" :class=\"['comment-input-container', moment.commentInputContainerClass]\">\r\n                <input \r\n                  type=\"text\" \r\n                  v-model=\"moment.commentInput\" \r\n                  placeholder=\"发表评论\"\r\n                />\r\n                <button @click=\"postComment(moment.id)\">发布</button>\r\n              </div>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- 底部操作区域 -->\r\n          <div class=\"moment-footer\">\r\n            <span class=\"time-ago\">{{ getTimeAgo(moment.created_at) }}</span>\r\n            <i \r\n              v-if=\"moment.user_id === currentUser.value.id\" \r\n              class=\"fa-solid fa-trash-can delete-btn\" \r\n              @click=\"deleteMoment(moment.id)\"\r\n            ></i>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div v-if=\"noMore\" class=\"no-more-message\">没有其他的内容了哦</div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted, onUnmounted, computed } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport { useStore } from 'vuex'\r\nimport axios from 'axios'\r\nimport DOMPurify from 'dompurify'\r\nimport defaultAvatar from '@/assets/default-avatar.png'\r\nimport { API_CONFIG } from '@/config/config'\r\nimport { ElMessage } from 'element-plus'\r\n\r\nexport default {\r\n  setup() {\r\n    const router = useRouter()\r\n    const store = useStore()\r\n    const moments = ref([])\r\n    const loading = ref(false)\r\n    const noMore = ref(false)\r\n    const lastId = ref(null)\r\n    const pageSize = 10\r\n\r\n    // 从 Vuex 获取当前用户信息\r\n    const currentUser = computed(() => store.state.user || {})\r\n    console.log(\"current user: \", currentUser)\r\n\r\n    const getFullUrl = (path) => {\r\n        // 确保path是字符串类型\r\n        if (typeof path!== 'string') {\r\n          return defaultAvatar;\r\n        }\r\n\r\n        // 如果path为null或undefined，或者等于默认头像路径，返回path\r\n        if (!path || path === defaultAvatar) {\r\n          return path;\r\n        }\r\n\r\n        // 如果path已经是完整的URL，直接返回\r\n        if (path.startsWith('http')) {\r\n          return path;\r\n        }\r\n\r\n        // 否则，将path与API_CONFIG.BASE_URL拼接后返回\r\n        return `${API_CONFIG.BASE_URL}${path}`;\r\n      };\r\n\r\n    const openImagePreview = (url) => {\r\n      window.open(url, '_blank')\r\n    }\r\n    // 媒体预览处理\r\n    const openMediaPreview = (url) => {\r\n      if (url.match(/\\.(mp4|mov|avi)$/i)) {\r\n        // 视频处理逻辑\r\n        window.open(url, '_blank')\r\n      } else {\r\n        // 图片预览实现（可以使用第三方库实现模态框预览）\r\n        window.open(url, '_blank')\r\n      }\r\n    }\r\n\r\n    // 获取视频类型\r\n    const getVideoType = (url) => {\r\n      const extension = url.split('.').pop().toLowerCase()\r\n      switch(extension) {\r\n        case 'mp4': return 'video/mp4'\r\n        case 'mov': return 'video/quicktime'\r\n        case 'avi': return 'video/x-msvideo'\r\n        default: return 'video/mp4'\r\n      }\r\n    }\r\n\r\n    // 获取动态数据\r\n    const fetchMoments = async () => {\r\n      if (loading.value || noMore.value) return\r\n      \r\n      loading.value = true\r\n      try {\r\n        const params = {\r\n          limit: pageSize,\r\n          last_id: lastId.value\r\n        }\r\n\r\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/article/moments`, {\r\n          headers: {\r\n            Authorization: `Bearer ${store.state.token}`\r\n          },\r\n          params\r\n        })\r\n\r\n        // 直接使用 Vuex 中的用户信息\r\n        const newMoments = response.data.map(moment => ({\r\n          ...moment,\r\n          user_id: moment.user_id,\r\n          user: {\r\n            username: moment.user?.username || '未知用户',\r\n            photo: moment.user?.photo || '',\r\n            // 其他用户字段...\r\n          },\r\n          isLiked: moment.like_users?.includes(currentUser.value.id) || false, // 新增：初始化是否点赞状态\r\n          commentInput: '', // 新增：初始化评论输入内容\r\n          showCommentInput: false // 新增：初始化是否显示评论输入框\r\n        }))\r\n\r\n        if (newMoments.length < pageSize) {\r\n          noMore.value = true\r\n        }\r\n\r\n        moments.value = [...moments.value, ...newMoments]\r\n        lastId.value = newMoments[newMoments.length - 1]?.id\r\n      } catch (error) {\r\n        console.error('获取动态失败:', error)\r\n      } finally {\r\n        loading.value = false\r\n      }\r\n    }\r\n\r\n    // 时间格式化\r\n    const formatTime = (timestamp) => {\r\n      const date = new Date(timestamp)\r\n      return `${date.getFullYear()}-${(date.getMonth() + 1).toString().padStart(2, '0')}-${date.getDate().toString().padStart(2, '0')} \r\n      ${date.getHours().toString().padStart(2, '0')}:${date.getMinutes().toString().padStart(2, '0')}`\r\n    }\r\n\r\n    // 计算多久之前\r\n    const getTimeAgo = (timestamp) => {\r\n      const now = new Date()\r\n      const created = new Date(timestamp)\r\n      const diff = now - created\r\n\r\n      const minutes = Math.floor(diff / (1000 * 60))\r\n      const hours = Math.floor(diff / (1000 * 60 * 60))\r\n      const days = Math.floor(diff / (1000 * 60 * 60 * 24))\r\n\r\n      if (minutes < 1) {\r\n        return '刚刚'\r\n      } else if (minutes < 60) {\r\n        return `${minutes} 分钟前`\r\n      } else if (hours < 24) {\r\n        return `${hours} 小时前`\r\n      } else {\r\n        return `${days} 天前`\r\n      }\r\n    }\r\n\r\n    // HTML消毒\r\n    const sanitizeHtml = (html) => {\r\n      return DOMPurify.sanitize(html)\r\n    }\r\n\r\n    const handleScroll = () => {\r\n      const { scrollTop, clientHeight, scrollHeight } = document.documentElement;\r\n      if (scrollTop + clientHeight >= scrollHeight - 100 &&!loading.value &&!noMore.value) {\r\n        fetchMoments();\r\n      }\r\n    };\r\n\r\n    const deleteMoment = async (momentId) => {\r\n      try {\r\n        await axios.post(`${API_CONFIG.BASE_URL}/article/delete/moment`, {\r\n          moment_id: momentId\r\n        }, {\r\n          headers: {\r\n            Authorization: `Bearer ${store.state.token}`\r\n          }\r\n        })\r\n        moments.value = moments.value.filter(moment => moment.id!== momentId)\r\n        ElMessage.success('动态删除成功')\r\n      } catch (error) {\r\n        console.error('删除动态失败:', error)\r\n        ElMessage.error('删除动态失败，请稍后重试')\r\n      }\r\n    }\r\n\r\n    // 点赞功能\r\n    const likeMoment = async (momentId) => {\r\n      const targetMoment = moments.value.find(moment => moment.id === momentId)\r\n      if (!targetMoment) return\r\n\r\n      // 保存原始状态用于回滚\r\n      const originalIsLiked = targetMoment.isLiked\r\n      const originalLikes = targetMoment.stats.likes\r\n      \r\n      try {\r\n        // 立即更新UI状态\r\n        targetMoment.isLiked = !targetMoment.isLiked\r\n        targetMoment.stats.likes += targetMoment.isLiked ? 1 : -1\r\n\r\n        const response = await axios.post(`${API_CONFIG.BASE_URL}/article/like_moment`, {\r\n          moment_id: momentId,\r\n          user_id: currentUser.value.id,\r\n          is_like: targetMoment.isLiked\r\n        }, {\r\n          headers: {\r\n            Authorization: `Bearer ${store.state.token}`\r\n          },\r\n          timeout: 5000 // 增加超时控制\r\n        })\r\n\r\n        if (response.data.success) {\r\n          // 检查 stats 是否存在，如果不存在则初始化\r\n          if (!targetMoment.stats) {\r\n                targetMoment.stats = { likes: 0 };\r\n            }\r\n            \r\n            // 更新前端状态\r\n            targetMoment.isLiked = response.data.likes > targetMoment.stats.likes;\r\n            targetMoment.stats.likes = response.data.likes;\r\n            ElMessage.success(targetMoment.isLiked ? '点赞成功' : '已取消点赞');\r\n\r\n          // 精确同步后端数据\r\n          targetMoment.isLiked = response.data.is_liked\r\n          targetMoment.stats.likes = response.data.likes_count\r\n          \r\n          // 更新like_users列表\r\n          if (response.data.is_liked) {\r\n            targetMoment.like_users = [\r\n              ...(targetMoment.like_users || []),\r\n              currentUser.value.id\r\n            ]\r\n          } else {\r\n            targetMoment.like_users = (targetMoment.like_users || [])\r\n              .filter(id => id !== currentUser.value.id)\r\n          }\r\n        }\r\n      } catch (error) {\r\n        // 回滚状态\r\n        targetMoment.isLiked = originalIsLiked\r\n        targetMoment.stats.likes = originalLikes\r\n        \r\n        console.error('点赞操作失败:', error)\r\n        ElMessage.error(`操作失败: ${error.response?.data?.msg || '网络错误'}`)\r\n      }\r\n    }\r\n\r\n    // 切换评论输入框显示状态\r\n    const toggleCommentInput = (moment) => {\r\n      moment.showCommentInput =!moment.showCommentInput;\r\n      if (moment.showCommentInput) {\r\n        moment.commentInputContainerClass = 'active';\r\n      } else {\r\n        moment.commentInputContainerClass = '';\r\n      }\r\n    }\r\n\r\n    // 发布评论功能\r\n    const postComment = async (momentId) => {\r\n      const targetMoment = moments.value.find(moment => moment.id === momentId);\r\n      const commentText = targetMoment.commentInput;\r\n      if (commentText.trim() === '') {\r\n        ElMessage.warning('评论内容不能为空');\r\n        return;\r\n      }\r\n      try {\r\n        const response = await axios.post(`${API_CONFIG.BASE_URL}/article/post_comment`, {\r\n          moment_id: momentId,\r\n          comment: commentText\r\n        }, {\r\