{"ast":null,"code":"export default {\n  name: \"UserInfo\",\n  data() {\n    return {\n      showUserList: false,\n      // 控制用户列表的显示\n      selectedUser: null,\n      // 当前选中的用户\n      users: [\n      // 模拟用户数据\n      {\n        id: 1,\n        name: \"张三\",\n        email: \"zhangsan@example.com\",\n        role: \"管理员\"\n      }, {\n        id: 2,\n        name: \"李四\",\n        email: \"lisi@example.com\",\n        role: \"普通用户\"\n      }, {\n        id: 3,\n        name: \"王五\",\n        email: \"wangwu@example.com\",\n        role: \"普通用户\"\n      }]\n    };\n  },\n  methods: {\n    // 切换用户列表的显示状态\n    toggleUserList() {\n      this.showUserList = !this.showUserList;\n      this.selectedUser = null; // 收起用户列表时清空选中的用户\n    },\n    // 选择用户\n    selectUser(user) {\n      this.selectedUser = user;\n    }\n  }\n};","map":{"version":3,"names":["name","data","showUserList","selectedUser","users","id","email","role","methods","toggleUserList","selectUser","user"],"sources":["E:\\vue_learn\\my_vue\\my_vue\\src\\views\\UserInfo.vue"],"sourcesContent":["<template>\r\n  <div class=\"userinfo\">\r\n    <!-- 用户信息标题 -->\r\n    <h1 @click=\"toggleUserList\">用户信息</h1>\r\n    <p>这里是用户信息，用户可以查看和编辑个人信息。</p>\r\n\r\n    <!-- 用户列表 -->\r\n    <div v-if=\"showUserList\" class=\"user-list\">\r\n      <h2>用户列表</h2>\r\n      <ul>\r\n        <li v-for=\"user in users\" :key=\"user.id\" @click=\"selectUser(user)\">\r\n          {{ user.name }} ({{ user.email }})\r\n        </li>\r\n      </ul>\r\n    </div>\r\n\r\n    <!-- 用户详情 -->\r\n    <div v-if=\"selectedUser\" class=\"user-detail\">\r\n      <h2>用户详情 - {{ selectedUser.name }}</h2>\r\n      <p><strong>邮箱:</strong> {{ selectedUser.email }}</p>\r\n      <p><strong>角色:</strong> {{ selectedUser.role }}</p>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"UserInfo\",\r\n  data() {\r\n    return {\r\n      showUserList: false, // 控制用户列表的显示\r\n      selectedUser: null,  // 当前选中的用户\r\n      users: [             // 模拟用户数据\r\n        { id: 1, name: \"张三\", email: \"zhangsan@example.com\", role: \"管理员\" },\r\n        { id: 2, name: \"李四\", email: \"lisi@example.com\", role: \"普通用户\" },\r\n        { id: 3, name: \"王五\", email: \"wangwu@example.com\", role: \"普通用户\" },\r\n      ],\r\n    };\r\n  },\r\n  methods: {\r\n    // 切换用户列表的显示状态\r\n    toggleUserList() {\r\n      this.showUserList = !this.showUserList;\r\n      this.selectedUser = null; // 收起用户列表时清空选中的用户\r\n    },\r\n    // 选择用户\r\n    selectUser(user) {\r\n      this.selectedUser = user;\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.userinfo {\r\n  padding: 20px;\r\n  border: 1px solid #ccc;\r\n  border-radius: 8px;\r\n  max-width: 600px;\r\n  margin: 0 auto;\r\n}\r\n\r\nh1 {\r\n  cursor: pointer;\r\n  color: #07c160;\r\n}\r\n\r\nh1:hover {\r\n  text-decoration: underline;\r\n}\r\n\r\n.user-list {\r\n  margin-top: 20px;\r\n}\r\n\r\n.user-list ul {\r\n  list-style-type: none;\r\n  padding: 0;\r\n}\r\n\r\n.user-list li {\r\n  padding: 10px;\r\n  border: 1px solid #eee;\r\n  margin-bottom: 5px;\r\n  cursor: pointer;\r\n  border-radius: 4px;\r\n}\r\n\r\n.user-list li:hover {\r\n  background-color: #f5f5f5;\r\n}\r\n\r\n.user-detail {\r\n  margin-top: 20px;\r\n  padding: 15px;\r\n  border: 1px solid #ddd;\r\n  border-radius: 8px;\r\n  background-color: #f9f9f9;\r\n}\r\n</style>"],"mappings":"AA0BA,eAAe;EACbA,IAAI,EAAE,UAAU;EAChBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,YAAY,EAAE,KAAK;MAAE;MACrBC,YAAY,EAAE,IAAI;MAAG;MACrBC,KAAK,EAAE;MAAc;MACnB;QAAEC,EAAE,EAAE,CAAC;QAAEL,IAAI,EAAE,IAAI;QAAEM,KAAK,EAAE,sBAAsB;QAAEC,IAAI,EAAE;MAAM,CAAC,EACjE;QAAEF,EAAE,EAAE,CAAC;QAAEL,IAAI,EAAE,IAAI;QAAEM,KAAK,EAAE,kBAAkB;QAAEC,IAAI,EAAE;MAAO,CAAC,EAC9D;QAAEF,EAAE,EAAE,CAAC;QAAEL,IAAI,EAAE,IAAI;QAAEM,KAAK,EAAE,oBAAoB;QAAEC,IAAI,EAAE;MAAO,CAAC;IAEpE,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP;IACAC,cAAcA,CAAA,EAAG;MACf,IAAI,CAACP,YAAW,GAAI,CAAC,IAAI,CAACA,YAAY;MACtC,IAAI,CAACC,YAAW,GAAI,IAAI,EAAE;IAC5B,CAAC;IACD;IACAO,UAAUA,CAACC,IAAI,EAAE;MACf,IAAI,CAACR,YAAW,GAAIQ,IAAI;IAC1B;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}