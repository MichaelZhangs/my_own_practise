{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { useStore } from 'vuex';\nexport default {\n  setup() {\n    const router = useRouter();\n    const store = useStore();\n    const editor = ref(null);\n    const content = ref('');\n    const formatText = command => {\n      document.execCommand(command, false);\n      editor.value.focus();\n    };\n    const updateContent = e => {\n      content.value = e.target.innerHTML;\n    };\n    const publish = () => {\n      if (content.value.trim()) {\n        const newMoment = {\n          content: content.value,\n          time: new Date().toLocaleString()\n        };\n        store.commit('addMoment', newMoment);\n        router.push('/moments');\n      }\n    };\n    return {\n      editor,\n      formatText,\n      updateContent,\n      publish\n    };\n  }\n};","map":{"version":3,"names":["ref","useRouter","useStore","setup","router","store","editor","content","formatText","command","document","execCommand","value","focus","updateContent","e","target","innerHTML","publish","trim","newMoment","time","Date","toLocaleString","commit","push"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\article\\UserPublish.vue"],"sourcesContent":["<!-- Publish.vue -->\r\n<template>\r\n  <div class=\"publish-page\">\r\n    <div class=\"editor-container\">\r\n      <div class=\"toolbar\">\r\n        <button @click=\"formatText('bold')\" title=\"加粗\">\r\n          <strong>B</strong>\r\n        </button>\r\n        <button @click=\"formatText('italic')\" title=\"斜体\">\r\n          <em>I</em>\r\n        </button>\r\n        <button @click=\"formatText('underline')\" title=\"下划线\">\r\n          <u>U</u>\r\n        </button>\r\n      </div>\r\n      \r\n      <div \r\n        ref=\"editor\" \r\n        contenteditable=\"true\"\r\n        class=\"content-editor\"\r\n        placeholder=\"输入内容...\"\r\n        @input=\"updateContent\"\r\n      ></div>\r\n      \r\n      <button class=\"publish-button\" @click=\"publish\">\r\n        发布\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport { useStore } from 'vuex'\r\n\r\nexport default {\r\n  setup() {\r\n    const router = useRouter()\r\n    const store = useStore()\r\n    const editor = ref(null)\r\n    const content = ref('')\r\n\r\n    const formatText = (command) => {\r\n      document.execCommand(command, false)\r\n      editor.value.focus()\r\n    }\r\n\r\n    const updateContent = (e) => {\r\n      content.value = e.target.innerHTML\r\n    }\r\n\r\n    const publish = () => {\r\n      if (content.value.trim()) {\r\n        const newMoment = {\r\n          content: content.value,\r\n          time: new Date().toLocaleString()\r\n        }\r\n        \r\n        store.commit('addMoment', newMoment)\r\n        router.push('/moments')\r\n      }\r\n    }\r\n\r\n    return { editor, formatText, updateContent, publish }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.publish-page {\r\n  max-width: 600px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n  background: #fff;\r\n  min-height: 100vh;\r\n}\r\n\r\n.editor-container {\r\n  border: 1px solid #e0e0e0;\r\n  border-radius: 12px;\r\n  overflow: hidden;\r\n}\r\n\r\n.toolbar {\r\n  padding: 12px;\r\n  background: #f8f8f8;\r\n  border-bottom: 1px solid #e0e0e0;\r\n  display: flex;\r\n  gap: 12px;\r\n}\r\n\r\n.toolbar button {\r\n  padding: 6px 12px;\r\n  border: 1px solid #ddd;\r\n  border-radius: 6px;\r\n  background: #fff;\r\n  cursor: pointer;\r\n  transition: all 0.2s;\r\n}\r\n\r\n.toolbar button:hover {\r\n  background: #f0f0f0;\r\n}\r\n\r\n.content-editor {\r\n  min-height: 300px;\r\n  padding: 20px;\r\n  outline: none;\r\n  font-size: 16px;\r\n  line-height: 1.6;\r\n}\r\n\r\n.content-editor:empty::before {\r\n  content: attr(placeholder);\r\n  color: #999;\r\n}\r\n\r\n.publish-button {\r\n  display: block;\r\n  width: 100%;\r\n  padding: 14px;\r\n  background: #07c160;\r\n  color: white;\r\n  border: none;\r\n  border-top: 1px solid #e0e0e0;\r\n  cursor: pointer;\r\n  font-size: 16px;\r\n  transition: background 0.2s;\r\n}\r\n\r\n.publish-button:hover {\r\n  background: #06ad54;\r\n}\r\n</style>"],"mappings":";AAgCA,SAASA,GAAE,QAAS,KAAI;AACxB,SAASC,SAAQ,QAAS,YAAW;AACrC,SAASC,QAAO,QAAS,MAAK;AAE9B,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIH,SAAS,CAAC;IACzB,MAAMI,KAAI,GAAIH,QAAQ,CAAC;IACvB,MAAMI,MAAK,GAAIN,GAAG,CAAC,IAAI;IACvB,MAAMO,OAAM,GAAIP,GAAG,CAAC,EAAE;IAEtB,MAAMQ,UAAS,GAAKC,OAAO,IAAK;MAC9BC,QAAQ,CAACC,WAAW,CAACF,OAAO,EAAE,KAAK;MACnCH,MAAM,CAACM,KAAK,CAACC,KAAK,CAAC;IACrB;IAEA,MAAMC,aAAY,GAAKC,CAAC,IAAK;MAC3BR,OAAO,CAACK,KAAI,GAAIG,CAAC,CAACC,MAAM,CAACC,SAAQ;IACnC;IAEA,MAAMC,OAAM,GAAIA,CAAA,KAAM;MACpB,IAAIX,OAAO,CAACK,KAAK,CAACO,IAAI,CAAC,CAAC,EAAE;QACxB,MAAMC,SAAQ,GAAI;UAChBb,OAAO,EAAEA,OAAO,CAACK,KAAK;UACtBS,IAAI,EAAE,IAAIC,IAAI,CAAC,CAAC,CAACC,cAAc,CAAC;QAClC;QAEAlB,KAAK,CAACmB,MAAM,CAAC,WAAW,EAAEJ,SAAS;QACnChB,MAAM,CAACqB,IAAI,CAAC,UAAU;MACxB;IACF;IAEA,OAAO;MAAEnB,MAAM;MAAEE,UAAU;MAAEM,aAAa;MAAEI;IAAQ;EACtD;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}