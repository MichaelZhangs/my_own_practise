{"ast":null,"code":"import { computed, onMounted, ref } from 'vue';\nimport { useStore } from 'vuex';\nimport defaultAvatar from '@/assets/default-avatar.png';\nimport defaultqrcode from '@/assets/logo.png';\nimport axios from 'axios';\nimport QRCode from 'qrcode';\nexport default {\n  name: 'PersonInfo',\n  setup() {\n    const store = useStore();\n    const user = computed(() => store.state.user);\n    const qrcodeUrl = ref('');\n\n    // 生成二维码\n    const generateQrcode = async () => {\n      try {\n        const content = `用户名: ${user.value.username}\\n手机号: ${user.value.phone}`;\n        const url = await QRCode.toDataURL(content);\n        qrcodeUrl.value = url;\n        alert(\"二维码生成成功\");\n      } catch (error) {\n        console.error(\"生成二维码失败\", error);\n        alert(\"生成二维码失败\");\n      }\n    };\n\n    // 下载二维码\n    const downloadQrcode = () => {\n      if (qrcodeUrl.value) {\n        const link = document.createElement('a');\n        link.href = qrcodeUrl.value;\n        link.download = 'my-qrcode.png';\n        link.click();\n      } else {\n        alert(\"请先生成二维码\");\n      }\n    };\n\n    // 更换头像\n    const changeAvatar = () => {\n      alert(\"更换头像功能待实现\");\n    };\n    return {\n      user,\n      defaultAvatar,\n      defaultqrcode,\n      qrcodeUrl,\n      generateQrcode,\n      downloadQrcode,\n      changeAvatar\n    };\n  }\n};","map":{"version":3,"names":["computed","onMounted","ref","useStore","defaultAvatar","defaultqrcode","axios","QRCode","name","setup","store","user","state","qrcodeUrl","generateQrcode","content","value","username","phone","url","toDataURL","alert","error","console","downloadQrcode","link","document","createElement","href","download","click","changeAvatar"],"sources":["E:\\vue_learn\\ai_vue\\ai_vue\\src\\views\\PersonInfo.vue"],"sourcesContent":["<template>\r\n  <div class=\"profile-page\">\r\n    <h1>个人资料</h1>\r\n    <div class=\"profile-container\">\r\n      <!-- 头像 -->\r\n      <div class=\"avatar-section\">\r\n        <img :src=\"user?.photo || defaultAvatar\" alt=\"头像\" class=\"avatar\" />\r\n        <button @click=\"changeAvatar\" class=\"change-avatar-button\">更换头像</button>\r\n      </div>\r\n\r\n      <!-- 用户信息 -->\r\n      <div class=\"info-section\">\r\n        <div class=\"info-item\">\r\n          <label>名字：</label>\r\n          <span>{{ user?.username || \"未设置\" }}</span>\r\n        </div>\r\n        <div class=\"info-item\">\r\n          <label>性别：</label>\r\n          <span>{{ user?.sex || \"未设置\" }}</span>\r\n        </div>\r\n        <div class=\"info-item\">\r\n          <label>手机号：</label>\r\n          <span>{{ user?.phone || \"未设置\" }}</span>\r\n        </div>\r\n        <div class=\"info-item\">\r\n          <label>描述：</label>\r\n          <span>{{ user?.description || \"未设置\" }}</span>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 个人二维码 -->\r\n      <div class=\"qr-code-section\">\r\n        <h2>个人二维码</h2>\r\n        <img :src=\"qrcodeUrl || defaultqrcode\" alt=\"个人二维码\" class=\"qr-code\" />\r\n        <button @click=\"generateQrcode\" class=\"generate-button\">生成二维码</button>\r\n        <button @click=\"downloadQrcode\" class=\"download-button\">下载二维码</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { computed, onMounted, ref } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport defaultAvatar from '@/assets/default-avatar.png';\r\nimport defaultqrcode from '@/assets/logo.png';\r\nimport axios from 'axios';\r\nimport QRCode from 'qrcode';\r\n\r\nexport default {\r\n  name: 'PersonInfo',\r\n  setup() {\r\n    const store = useStore();\r\n    const user = computed(() => store.state.user);\r\n    const qrcodeUrl = ref('');\r\n\r\n    // 生成二维码\r\n    const generateQrcode = async () => {\r\n      try {\r\n        const content = `用户名: ${user.value.username}\\n手机号: ${user.value.phone}`;\r\n        const url = await QRCode.toDataURL(content);\r\n        qrcodeUrl.value = url;\r\n        alert(\"二维码生成成功\");\r\n      } catch (error) {\r\n        console.error(\"生成二维码失败\", error);\r\n        alert(\"生成二维码失败\");\r\n      }\r\n    };\r\n\r\n    // 下载二维码\r\n    const downloadQrcode = () => {\r\n      if (qrcodeUrl.value) {\r\n        const link = document.createElement('a');\r\n        link.href = qrcodeUrl.value;\r\n        link.download = 'my-qrcode.png';\r\n        link.click();\r\n      } else {\r\n        alert(\"请先生成二维码\");\r\n      }\r\n    };\r\n\r\n    // 更换头像\r\n    const changeAvatar = () => {\r\n      alert(\"更换头像功能待实现\");\r\n    };\r\n\r\n    return {\r\n      user,\r\n      defaultAvatar,\r\n      defaultqrcode,\r\n      qrcodeUrl,\r\n      generateQrcode,\r\n      downloadQrcode,\r\n      changeAvatar,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.profile-page {\r\n  padding: 20px;\r\n}\r\n\r\nh1 {\r\n  font-size: 24px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.profile-container {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 20px;\r\n}\r\n\r\n.avatar-section {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n}\r\n\r\n.avatar {\r\n  width: 100px;\r\n  height: 100px;\r\n  border-radius: 50%;\r\n}\r\n\r\n.change-avatar-button {\r\n  padding: 5px 10px;\r\n  background-color: #1890ff;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n}\r\n\r\n.change-avatar-button:hover {\r\n  background-color: #40a9ff;\r\n}\r\n\r\n.info-section {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n}\r\n\r\n.info-item {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.info-item label {\r\n  font-weight: bold;\r\n  width: 80px;\r\n}\r\n\r\n.qr-code-section {\r\n  margin-top: 20px;\r\n}\r\n\r\n.qr-code {\r\n  width: 200px;\r\n  height: 200px;\r\n  margin-top: 10px;\r\n}\r\n\r\n.generate-button,\r\n.download-button {\r\n  padding: 5px 10px;\r\n  background-color: #1890ff;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n  margin-top: 10px;\r\n  margin-right: 10px;\r\n}\r\n\r\n.generate-button:hover,\r\n.download-button:hover {\r\n  background-color: #40a9ff;\r\n}\r\n</style>"],"mappings":"AA0CA,SAASA,QAAQ,EAAEC,SAAS,EAAEC,GAAE,QAAS,KAAK;AAC9C,SAASC,QAAO,QAAS,MAAM;AAC/B,OAAOC,aAAY,MAAO,6BAA6B;AACvD,OAAOC,aAAY,MAAO,mBAAmB;AAC7C,OAAOC,KAAI,MAAO,OAAO;AACzB,OAAOC,MAAK,MAAO,QAAQ;AAE3B,eAAe;EACbC,IAAI,EAAE,YAAY;EAClBC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIP,QAAQ,CAAC,CAAC;IACxB,MAAMQ,IAAG,GAAIX,QAAQ,CAAC,MAAMU,KAAK,CAACE,KAAK,CAACD,IAAI,CAAC;IAC7C,MAAME,SAAQ,GAAIX,GAAG,CAAC,EAAE,CAAC;;IAEzB;IACA,MAAMY,cAAa,GAAI,MAAAA,CAAA,KAAY;MACjC,IAAI;QACF,MAAMC,OAAM,GAAI,QAAQJ,IAAI,CAACK,KAAK,CAACC,QAAQ,UAAUN,IAAI,CAACK,KAAK,CAACE,KAAK,EAAE;QACvE,MAAMC,GAAE,GAAI,MAAMZ,MAAM,CAACa,SAAS,CAACL,OAAO,CAAC;QAC3CF,SAAS,CAACG,KAAI,GAAIG,GAAG;QACrBE,KAAK,CAAC,SAAS,CAAC;MAClB,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,SAAS,EAAEA,KAAK,CAAC;QAC/BD,KAAK,CAAC,SAAS,CAAC;MAClB;IACF,CAAC;;IAED;IACA,MAAMG,cAAa,GAAIA,CAAA,KAAM;MAC3B,IAAIX,SAAS,CAACG,KAAK,EAAE;QACnB,MAAMS,IAAG,GAAIC,QAAQ,CAACC,aAAa,CAAC,GAAG,CAAC;QACxCF,IAAI,CAACG,IAAG,GAAIf,SAAS,CAACG,KAAK;QAC3BS,IAAI,CAACI,QAAO,GAAI,eAAe;QAC/BJ,IAAI,CAACK,KAAK,CAAC,CAAC;MACd,OAAO;QACLT,KAAK,CAAC,SAAS,CAAC;MAClB;IACF,CAAC;;IAED;IACA,MAAMU,YAAW,GAAIA,CAAA,KAAM;MACzBV,KAAK,CAAC,WAAW,CAAC;IACpB,CAAC;IAED,OAAO;MACLV,IAAI;MACJP,aAAa;MACbC,aAAa;MACbQ,SAAS;MACTC,cAAc;MACdU,cAAc;MACdO;IACF,CAAC;EACH;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}