{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from \"axios\";\nexport default {\n  name: \"UserRegister\",\n  data() {\n    return {\n      username: \"\",\n      phone: \"\",\n      password: \"\",\n      confirmPassword: \"\",\n      registerResult: null\n    };\n  },\n  methods: {\n    async handleRegister() {\n      if (this.password !== this.confirmPassword) {\n        alert(\"两次输入的密码不一致\");\n        return;\n      }\n      try {\n        // 这里可以根据实际情况处理响应数据，如果不需要使用，可以不定义 response 变量\n        await axios.post(\"http://127.0.0.1:8000/api/register\", {\n          username: this.username,\n          phone: this.phone,\n          password: this.password\n        }, {\n          headers: {\n            \"Content-Type\": \"application/json\"\n          }\n        });\n        this.registerResult = {\n          success: true,\n          message: \"注册成功！请登录。\"\n        };\n        this.$router.push(\"/login\");\n      } catch (error) {\n        this.registerResult = {\n          success: false,\n          message: error.response?.data?.detail || \"注册失败\"\n        };\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","username","phone","password","confirmPassword","registerResult","methods","handleRegister","alert","post","headers","success","message","$router","push","error","response","detail"],"sources":["E:\\vue_learn\\ai_vue\\ai_vue\\src\\views\\UserRegister.vue"],"sourcesContent":["<template>\r\n  <div class=\"register-wrapper\">\r\n    <div class=\"register-container\">\r\n      <h1>用户注册</h1>\r\n      <form @submit.prevent=\"handleRegister\">\r\n        <div class=\"input-group\">\r\n          <input\r\n            type=\"text\"\r\n            v-model=\"username\"\r\n            placeholder=\"请输入用户名\"\r\n            required\r\n          />\r\n        </div>\r\n        <div class=\"input-group\">\r\n          <input\r\n            type=\"text\"\r\n            v-model=\"phone\"\r\n            placeholder=\"请输入电话号码\"\r\n            required\r\n          />\r\n        </div>\r\n        <div class=\"input-group\">\r\n          <input\r\n            type=\"password\"\r\n            v-model=\"password\"\r\n            placeholder=\"请输入密码\"\r\n            required\r\n          />\r\n        </div>\r\n        <div class=\"input-group\">\r\n          <input\r\n            type=\"password\"\r\n            v-model=\"confirmPassword\"\r\n            placeholder=\"请再次输入密码\"\r\n            required\r\n          />\r\n          <p v-if=\"password!== confirmPassword && confirmPassword\" class=\"error-message\">两次输入的密码不一致</p>\r\n        </div>\r\n        <button type=\"submit\" class=\"register-button\" :disabled=\"password!== confirmPassword\">注册</button>\r\n      </form>\r\n      <div v-if=\"registerResult\" class=\"register-result\">\r\n        <p v-if=\"registerResult.success\">注册成功！请登录。</p>\r\n        <p v-else>注册失败：{{ registerResult.message }}</p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from \"axios\";\r\n\r\nexport default {\r\n  name: \"UserRegister\",\r\n  data() {\r\n    return {\r\n      username: \"\",\r\n      phone: \"\",\r\n      password: \"\",\r\n      confirmPassword: \"\",\r\n      registerResult: null\r\n    };\r\n  },\r\n  methods: {\r\n    async handleRegister() {\r\n      if (this.password!== this.confirmPassword) {\r\n        alert(\"两次输入的密码不一致\");\r\n        return;\r\n      }\r\n      try {\r\n        // 这里可以根据实际情况处理响应数据，如果不需要使用，可以不定义 response 变量\r\n        await axios.post(\r\n          \"http://127.0.0.1:8000/api/register\",\r\n          {\r\n            username: this.username,\r\n            phone: this.phone,\r\n            password: this.password\r\n          },\r\n          {\r\n            headers: {\r\n              \"Content-Type\": \"application/json\"\r\n            }\r\n          }\r\n        );\r\n        this.registerResult = {\r\n          success: true,\r\n          message: \"注册成功！请登录。\"\r\n        };\r\n        this.$router.push(\"/login\");\r\n      } catch (error) {\r\n        this.registerResult = {\r\n          success: false,\r\n          message: error.response?.data?.detail || \"注册失败\"\r\n        };\r\n      }\r\n    }\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.register-wrapper {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  height: 100vh;\r\n  background-color: #f5f5f5;\r\n}\r\n\r\n.register-container {\r\n  max-width: 400px;\r\n  width: 100%;\r\n  padding: 30px;\r\n  border-radius: 10px;\r\n  background-color: white;\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);\r\n}\r\n\r\nh1 {\r\n  text-align: center;\r\n  color: #333;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.input-group {\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.input-group input {\r\n  width: 100%;\r\n  padding: 10px;\r\n  border: 1px solid #ccc;\r\n  border-radius: 5px;\r\n  font-size: 16px;\r\n}\r\n\r\n.error-message {\r\n  color: red;\r\n  font-size: 12px;\r\n  margin-top: 5px;\r\n}\r\n\r\n.register-button {\r\n  width: 100%;\r\n  padding: 10px;\r\n  background-color: #42b983;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n  font-size: 16px;\r\n}\r\n\r\n.register-button:disabled {\r\n  background-color: #ccc;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.register-button:hover:not(:disabled) {\r\n  background-color: #369f6e;\r\n}\r\n\r\n.register-result {\r\n  margin-top: 20px;\r\n  text-align: center;\r\n  font-size: 16px;\r\n  color: #333;\r\n}\r\n</style>"],"mappings":";AAiDA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,cAAc;EACpBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,eAAe,EAAE,EAAE;MACnBC,cAAc,EAAE;IAClB,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP,MAAMC,cAAcA,CAAA,EAAG;MACrB,IAAI,IAAI,CAACJ,QAAQ,KAAI,IAAI,CAACC,eAAe,EAAE;QACzCI,KAAK,CAAC,YAAY,CAAC;QACnB;MACF;MACA,IAAI;QACF;QACA,MAAMV,KAAK,CAACW,IAAI,CACd,oCAAoC,EACpC;UACER,QAAQ,EAAE,IAAI,CAACA,QAAQ;UACvBC,K