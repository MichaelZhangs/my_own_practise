{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from 'axios';\nexport default {\n  name: 'UserLogin',\n  data() {\n    return {\n      currentView: 'login',\n      // 当前视图状态，可选值：'login', 'passwordLogin', 'forgotPassword'\n      loginType: 'phone',\n      // 登录方式，可选值：'phone', 'email'\n      phone: '',\n      // 手机号\n      email: '',\n      // 邮箱\n      code: '',\n      // 验证码\n      username: '',\n      // 用户名/手机号/邮箱（用于密码登录）\n      password: '',\n      // 密码（用于密码登录）\n      forgotPasswordInput: '',\n      // 找回密码时输入的手机号或邮箱\n      forgotPasswordCode: '',\n      // 找回密码时的验证码\n      result: null,\n      // 操作结果\n      generatedCode: '',\n      // 从后端获取的验证码\n      showCodeModal: false,\n      // 是否显示验证码弹窗\n      isCodeButtonDisabled: false,\n      // 登录验证码按钮是否禁用\n      codeButtonText: '获取验证码',\n      // 登录验证码按钮文本\n      countdown: 0,\n      // 倒计时时间\n      isForgotPasswordCodeButtonDisabled: false,\n      // 找回密码验证码按钮是否禁用\n      forgotPasswordCodeButtonText: '获取验证码',\n      // 找回密码验证码按钮文本\n      forgotPasswordCountdown: 0,\n      // 找回密码倒计时时间\n      usernameCheckResult: null // 用户名检查结果\n    };\n  },\n  methods: {\n    // 发送登录验证码\n    async sendCode() {\n      const username = this.loginType === 'phone' ? this.phone : this.email;\n      if (!username) {\n        alert('请输入手机号或邮箱');\n        return;\n      }\n      try {\n        const response = await axios.post('http://127.0.0.1:8000/api/send-code', {\n          username\n        });\n        this.generatedCode = response.data.code;\n        this.showCodeModal = true;\n        this.startCountdown('login');\n      } catch (error) {\n        console.error('验证码请求失败：', error.response?.data);\n        alert('验证码发送失败');\n      }\n    },\n    // 发送找回密码验证码\n    async sendForgotPasswordCode() {\n      const username = this.forgotPasswordInput;\n      if (!username) {\n        alert('请输入手机号或邮箱');\n        return;\n      }\n      try {\n        const response = await axios.post('http://127.0.0.1:8000/api/send-code', {\n          username\n        });\n        this.generatedCode = response.data.code;\n        this.showCodeModal = true;\n        this.startCountdown('forgotPassword');\n      } catch (error) {\n        console.error('验证码请求失败：', error.response?.data);\n        alert('验证码发送失败');\n      }\n    },\n    // 启动倒计时\n    startCountdown(type) {\n      if (type === 'login') {\n        this.isCodeButtonDisabled = true;\n        this.countdown = 60;\n        const timer = setInterval(() => {\n          this.countdown--;\n          if (this.countdown <= 0) {\n            clearInterval(timer);\n            this.isCodeButtonDisabled = false;\n            this.codeButtonText = '获取验证码';\n          } else {\n            this.codeButtonText = `${this.countdown}s后重新获取`;\n          }\n        }, 1000);\n      } else if (type === 'forgotPassword') {\n        this.isForgotPasswordCodeButtonDisabled = true;\n        this.forgotPasswordCountdown = 60;\n        const timer = setInterval(() => {\n          this.forgotPasswordCountdown--;\n          if (this.forgotPasswordCountdown <= 0) {\n            clearInterval(timer);\n            this.isForgotPasswordCodeButtonDisabled = false;\n            this.forgotPasswordCodeButtonText = '获取验证码';\n          } else {\n            this.forgotPasswordCodeButtonText = `${this.forgotPasswordCountdown}s后重新获取`;\n          }\n        }, 1000);\n      }\n    },\n    // 填充验证码并关闭弹窗\n    fillCodeAndCloseModal() {\n      if (this.currentView === 'login') {\n        this.code = this.generatedCode;\n      } else if (this.currentView === 'forgotPassword') {\n        this.forgotPasswordCode = this.generatedCode;\n      }\n      this.showCodeModal = false;\n    },\n    // 处理提交操作\n    async handleSubmit() {\n      if (this.currentView === 'login') {\n        this.handleLogin();\n      } else if (this.currentView === 'passwordLogin') {\n        this.handlePasswordLogin();\n      } else if (this.currentView === 'forgotPassword') {\n        this.handleForgotPassword();\n      }\n    },\n    // 处理验证码登录\n    async handleLogin() {\n      if (!this.code) {\n        alert('请输入验证码');\n        return;\n      }\n      const username = this.loginType === 'phone' ? this.phone : this.email;\n      try {\n        const response = await axios.post('http://127.0.0.1:8000/api/login', {\n          username,\n          password: this.code\n        }, {\n          headers: {\n            'Content-Type': 'application/json'\n          }\n        });\n        this.result = {\n          success: true,\n          message: '登录成功！',\n          data: response.data\n        };\n        this.$store.dispatch('login', {\n          user: response.data.user,\n          token: response.data.access_token\n        });\n        this.$router.push('/user');\n      } catch (error) {\n        this.result = {\n          success: false,\n          message: error.response?.data?.detail || '登录失败'\n        };\n      }\n    },\n    // 处理密码登录\n    async handlePasswordLogin() {\n      if (!this.username || !this.password) {\n        alert('请输入用户名和密码');\n        return;\n      }\n      try {\n        const checkResponse = await axios.post('http://127.0.0.1:8000/api/check-user', {\n          username: this.username\n        }, {\n          headers: {\n            'Content-Type': 'application/json'\n          }\n        });\n        this.usernameCheckResult = checkResponse.data.exists;\n        if (!this.usernameCheckResult) {\n          return;\n        }\n        const response = await axios.post('http://127.0.0.1:8000/api/password-login', {\n          username: this.username,\n          password: this.password\n        }, {\n          headers: {\n            'Content-Type': 'application/json'\n          }\n        });\n        this.result = {\n          success: true,\n          message: '登录成功！',\n          data: response.data\n        };\n        this.$store.dispatch('login', {\n          user: response.data.user,\n          token: response.data.access_token\n        });\n        this.$router.push('/user');\n      } catch (error) {\n        this.result = {\n          success: false,\n          message: error.response?.data?.detail || '登录失败'\n        };\n      }\n    },\n    // 处理找回密码提交\n    async handleForgotPassword() {\n      if (!this.forgotPasswordCode) {\n        alert('请输入验证码');\n        return;\n      }\n      const username = this.forgotPasswordInput;\n      try {\n        const response = await axios.post('http://127.0.0.1:8000/api/verify-forgot-password-code', {\n          username,\n          code: this.forgotPasswordCode\n        }, {\n          headers: {\n            'Content-Type': 'application/json'\n          }\n        });\n        // 这里可以根据实际需求使用 response 做更多处理\n        this.result = {\n          success: true,\n          message: '验证码验证成功，请重置密码！'\n        };\n        // 可以在这里跳转到重置密码页面\n      } catch (error) {\n        this.result = {\n          success: false,\n          message: error.response?.data?.detail || '验证码验证失败'\n        };\n      }\n    },\n    // 切换到密码登录视图\n    toggleToPasswordLogin() {\n      this.currentView = 'passwordLogin';\n    },\n    // 切换到普通登录视图\n    toggleToLogin() {\n      this.currentView = 'login';\n    },\n    // 切换到找回密码视图\n    toggleToForgotPassword() {\n      this.currentView = 'forgotPassword';\n    },\n    // 跳转到注册页面\n    goToRegisterPage() {\n      this.$router.push('/register');\n    },\n    // 检查用户名是否存在\n    async checkUsername() {\n      if (this.currentView === 'passwordLogin' && this.username) {\n        try {\n          const checkResponse = await axios.post('http://127.0.0.1:8000/api/check-user', {\n            username: this.username\n          }, {\n            headers: {\n              'Content-Type': 'application/json'\n            }\n          });\n          this.usernameCheckResult = checkResponse.data.exists;\n        } catch (error) {\n          console.error('检查用户存在性失败：', error.response?.data);\n          this.usernameCheckResult = null;\n        }\n      } else {\n        this.usernameCheckResult = null;\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","currentView","loginType","phone","email","code","username","password","forgotPasswordInput","forgotPasswordCode","result","generatedCode","showCodeModal","isCodeButtonDisabled","codeButtonText","countdown","isForgotPasswordCodeButtonDisabled","forgotPasswordCodeButtonText","forgotPasswordCountdown","usernameCheckResult","methods","sendCode","alert","response","post","startCountdown","error","console","sendForgotPasswordCode","type","timer","setInterval","clearInterval","fillCodeAndCloseModal","handleSubmit","handleLogin","handlePasswordLogin","handleForgotPassword","headers","success","message","$store","dispatch","user","token","access_token","$router","push","detail","checkResponse","exists","toggleToPasswordLogin","toggleToLogin","toggleToForgotPassword","goToRegisterPage","checkUsername"],"sources":["E:\\vue_learn\\ai_vue\\ai_vue\\src\\components\\UserLogin.vue"],"sourcesContent":["<template>\r\n  <div class=\"login-wrapper\">\r\n    <div class=\"user-login-container\">\r\n      <h1>{{ currentView === 'login' ? '用户登录' : currentView === 'passwordLogin' ? '密码登录' : '找回密码' }}</h1>\r\n      <form @submit.prevent=\"handleSubmit\">\r\n        <!-- 登录方式选择，仅在普通登录时显示 -->\r\n        <div v-if=\"currentView === 'login'\" class=\"login-type\">\r\n          <label>\r\n            <input\r\n              type=\"radio\"\r\n              v-model=\"loginType\"\r\n              value=\"phone\"\r\n              :disabled=\"currentView!== 'login'\"\r\n            />\r\n            短信登录\r\n          </label>\r\n          <label>\r\n            <input\r\n              type=\"radio\"\r\n              v-model=\"loginType\"\r\n              value=\"email\"\r\n              :disabled=\"currentView!== 'login'\"\r\n            />\r\n            邮箱登录\r\n          </label>\r\n        </div>\r\n\r\n        <!-- 手机号或邮箱输入 -->\r\n        <div v-if=\"currentView === 'login' || currentView === 'forgotPassword'\" class=\"input-group\">\r\n          <input\r\n            v-if=\"currentView === 'login' && loginType === 'phone'\"\r\n            type=\"text\"\r\n            v-model=\"phone\"\r\n            placeholder=\"请输入手机号\"\r\n            required\r\n          />\r\n          <input\r\n            v-if=\"currentView === 'login' && loginType === 'email'\"\r\n            type=\"email\"\r\n            v-model=\"email\"\r\n            placeholder=\"请输入邮箱\"\r\n            required\r\n          />\r\n          <input\r\n            v-if=\"currentView === 'forgotPassword'\"\r\n            type=\"text\"\r\n            v-model=\"forgotPasswordInput\"\r\n            placeholder=\"请输入手机号或邮箱\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <!-- 验证码输入 -->\r\n        <div v-if=\"(currentView === 'login' &&!isPasswordLogin) || currentView === 'forgotPassword'\" class=\"input-group code-group\">\r\n          <input\r\n            type=\"text\"\r\n            v-model=\"currentView === 'login'? code : forgotPasswordCode\"\r\n            placeholder=\"请输入验证码\"\r\n            required\r\n          />\r\n          <button\r\n            type=\"button\"\r\n            @click=\"currentView === 'login'? sendCode() : sendForgotPasswordCode()\"\r\n            class=\"code-button\"\r\n            :disabled=\"currentView === 'login'? isCodeButtonDisabled : isForgotPasswordCodeButtonDisabled\"\r\n          >\r\n            {{ currentView === 'login'? codeButtonText : forgotPasswordCodeButtonText }}\r\n          </button>\r\n        </div>\r\n\r\n        <!-- 不同视图下的链接 -->\r\n        <div v-if=\"currentView === 'login'\" class=\"switch-links\">\r\n          <span class=\"switch-login-link\" @click=\"toggleToPasswordLogin\">密码登录</span>\r\n          <span class=\"register-link\" @click=\"goToRegisterPage\">注册新用户</span>\r\n        </div>\r\n        <div v-if=\"currentView === 'passwordLogin'\" class=\"switch-links\">\r\n          <span class=\"switch-login-link\" @click=\"toggleToLogin\">验证码登录</span>\r\n          <span class=\"forgot-password-link\" @click=\"toggleToForgotPassword\">找回密码</span>\r\n        </div>\r\n        <div v-if=\"currentView === 'forgotPassword'\" class=\"switch-links\">\r\n          <span class=\"switch-login-link\" @click=\"toggleToLogin\">返回登录</span>\r\n        </div>\r\n\r\n        <!-- 密码登录表单 -->\r\n        <div v-if=\"currentView === 'passwordLogin'\" class=\"password-login-form\">\r\n          <div class=\"input-group\">\r\n            <input\r\n              type=\"text\"\r\n              v-model=\"username\"\r\n              placeholder=\"请输入用户名/手机号/邮箱\"\r\n              required\r\n              @input=\"checkUsername\"\r\n            />\r\n            <span\r\n              v-if=\"currentView === 'passwordLogin' && usernameCheckResult!== null\"\r\n              :class=\"{\r\n                'check-icon': true,\r\n                'check-icon-valid': usernameCheckResult,\r\n                'check-icon-invalid':!usernameCheckResult,\r\n              }\"\r\n            >\r\n              {{ usernameCheckResult? '✔' : '✖' }}\r\n            </span>\r\n            <p v-if=\"currentView === 'passwordLogin' && usernameCheckResult === false\" class=\"error-message\">\r\n              用户不存在\r\n            </p>\r\n          </div>\r\n          <div class=\"input-group\">\r\n            <input\r\n              type=\"password\"\r\n              v-model=\"password\"\r\n              placeholder=\"请输入密码\"\r\n              required\r\n            />\r\n          </div>\r\n        </div>\r\n\r\n        <!-- 提交按钮 -->\r\n        <button type=\"submit\" class=\"login-button\">\r\n          {{ currentView === 'login'? '登录' : currentView === 'passwordLogin'? '密码登录' : '提交验证码' }}\r\n        </button>\r\n      </form>\r\n\r\n      <!-- 显示操作结果 -->\r\n      <div v-if=\"result\" class=\"login-result\">\r\n        <p v-if=\"result.success\">{{ result.message }}</p>\r\n        <p v-else>{{ result.message }}</p>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 验证码弹窗 -->\r\n    <div v-if=\"showCodeModal\" class=\"modal-overlay\">\r\n      <div class=\"modal-content\">\r\n        <h3>验证码已发送</h3>\r\n        <p>您的验证码是：<strong>{{ generatedCode }}</strong></p>\r\n        <button @click=\"fillCodeAndCloseModal\">填充验证码并关闭</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'UserLogin',\r\n  data() {\r\n    return {\r\n      currentView: 'login', // 当前视图状态，可选值：'login', 'passwordLogin', 'forgotPassword'\r\n      loginType: 'phone', // 登录方式，可选值：'phone', 'email'\r\n      phone: '', // 手机号\r\n      email: '', // 邮箱\r\n      code: '', // 验证码\r\n      username: '', // 用户名/手机号/邮箱（用于密码登录）\r\n      password: '', // 密码（用于密码登录）\r\n      forgotPasswordInput: '', // 找回密码时输入的手机号或邮箱\r\n      forgotPasswordCode: '', // 找回密码时的验证码\r\n      result: null, // 操作结果\r\n      generatedCode: '', // 从后端获取的验证码\r\n      showCodeModal: false, // 是否显示验证码弹窗\r\n      isCodeButtonDisabled: false, // 登录验证码按钮是否禁用\r\n      codeButtonText: '获取验证码', // 登录验证码按钮文本\r\n      countdown: 0, // 倒计时时间\r\n      isForgotPasswordCodeButtonDisabled: false, // 找回密码验证码按钮是否禁用\r\n      forgotPasswordCodeButtonText: '获取验证码', // 找回密码验证码按钮文本\r\n      forgotPasswordCountdown: 0, // 找回密码倒计时时间\r\n      usernameCheckResult: null, // 用户名检查结果\r\n    };\r\n  },\r\n  methods: {\r\n    // 发送登录验证码\r\n    async sendCode() {\r\n      const username = this.loginType === 'phone'? this.phone : this.email;\r\n      if (!username) {\r\n        alert('请输入手机号或邮箱');\r\n        return;\r\n      }\r\n      try {\r\n        const response = await axios.post('http://127.0.0.1:8000/api/send-code', {\r\n          username,\r\n        });\r\n        this.generatedCode = response.data.code;\r\n        this.showCodeModal = true;\r\n        this.startCountdown('login');\r\n      } catch (error) {\r\n        console.error('验证码请求失败：', error.response?.data);\r\n        alert('验证码发送失败');\r\n      }\r\n    },\r\n    // 发送找回密码验证码\r\n    async sendForgotPasswordCode() {\r\n      const username = this.forgotPasswordInput;\r\n      if (!username) {\r\n        alert('请输入手机号或邮箱');\r\n        return;\r\n      }\r\n      try {\r\n        const response = await axios.post('http://127.0.0.1:8000/api/send-code', {\r\n          username,\r\n        });\r\n        this.generatedCode = response.data.code;\r\n        this.showCodeModal = true;\r\n        this.startCountdown('forgotPassword');\r\n      } catch (error) {\r\n        console.error('验证码请求失败：', error.response?.data);\r\n        alert('验证码发送失败');\r\n      }\r\n    },\r\n    // 启动倒计时\r\n    startCountdown(type) {\r\n      if (type === 'login') {\r\n        this.isCodeButtonDisabled = true;\r\n        this.countdown = 60;\r\n        const timer = setInterval(() => {\r\n          this.countdown--;\r\n          if (this.countdown <= 0) {\r\n            clearInterval(timer);\r\n            this.isCodeButtonDisabled = false;\r\n            this.codeButtonText = '获取验证码';\r\n          } else {\r\n            this.codeButtonText = `${this.countdown}s后重新获取`;\r\n          }\r\n        }, 1000);\r\n      } else if (type === 'forgotPassword') {\r\n        this.isForgotPasswordCodeButtonDisabled = true;\r\n        this.forgotPasswordCountdown = 60;\r\n        const timer = setInterval(() => {\r\n          this.forgotPasswordCountdown--;\r\n          if (this.forgotPasswordCountdown <= 0) {\r\n            clearInterval(timer);\r\n            this.isForgotPasswordCodeButtonDisabled = false;\r\n            this.forgotPasswordCodeButtonText = '获取验证码';\r\n          } else {\r\n            this.forgotPasswordCodeButtonText = `${this.forgotPasswordCountdown}s后重新获取`;\r\n          }\r\n        }, 1000);\r\n      }\r\n    },\r\n    // 填充验证码并关闭弹窗\r\n    fillCodeAndCloseModal() {\r\n      if (this.currentView === 'login') {\r\n        this.code = this.generatedCode;\r\n      } else if (this.currentView === 'forgotPassword') {\r\n        this.forgotPasswordCode = this.generatedCode;\r\n      }\r\n      this.showCodeModal = false;\r\n    },\r\n    // 处理提交操作\r\n    async handleSubmit() {\r\n      if (this.currentView === 'login') {\r\n        this.handleLogin();\r\n      } else if (this.currentView === 'passwordLogin') {\r\n        this.handlePasswordLogin();\r\n      } else if (this.currentView === 'forgotPassword') {\r\n        this.handleForgotPassword();\r\n      }\r\n    },\r\n    // 处理验证码登录\r\n    async handleLogin() {\r\n      if (!this.code) {\r\n        alert('请输入验证码');\r\n        return;\r\n      }\r\n      const username = this.loginType === 'phone'? this.phone : this.email;\r\n      try {\r\n        const response = await axios.post(\r\n          'http://127.0.0.1:8000/api/login',\r\n          {\r\n            username,\r\n            password: this.code,\r\n          },\r\n          {\r\n            headers: {\r\n              'Content-Type': 'application/json',\r\n            },\r\n          }\r\n        );\r\n        this.result = {\r\n          success: true,\r\n          message: '登录成功！',\r\n          data: response.data,\r\n        };\r\n        this.$store.dispatch('login', {\r\n          user: response.data.user,\r\n          token: response.data.access_token,\r\n        });\r\n        this.$router.push('/user');\r\n      } catch (error) {\r\n        this.result = {\r\n          success: false,\r\n          message: error.response?.data?.detail || '登录失败',\r\n        };\r\n      }\r\n    },\r\n    // 处理密码登录\r\n    async handlePasswordLogin() {\r\n      if (!this.username || !this.password) {\r\n        alert('请输入用户名和密码');\r\n        return;\r\n      }\r\n      try {\r\n        const checkResponse = await axios.post(\r\n          'http://127.0.0.1:8000/api/check-user',\r\n          {\r\n            username: this.username,\r\n          },\r\n          {\r\n            headers: {\r\n              'Content-Type': 'application/json',\r\n            },\r\n          }\r\n        );\r\n        this.usernameCheckResult = checkResponse.data.exists;\r\n        if (!this.usernameCheckResult) {\r\n          return;\r\n        }\r\n        const response = await axios.post(\r\n          'http://127.0.0.1:8000/api/password-login',\r\n          {\r\n            username: this.username,\r\n            password: this.password,\r\n          },\r\n          {\r\n            headers: {\r\n              'Content-Type': 'application/json',\r\n            },\r\n          }\r\n        );\r\n        this.result = {\r\n          success: true,\r\n          message: '登录成功！',\r\n          data: response.data,\r\n        };\r\n        this.$store.dispatch('login', {\r\n          user: response.data.user,\r\n          token: response.data.access_token,\r\n        });\r\n        this.$router.push('/user');\r\n      } catch (error) {\r\n        this.result = {\r\n          success: false,\r\n          message: error.response?.data?.detail || '登录失败',\r\n        };\r\n      }\r\n    },\r\n    // 处理找回密码提交\r\n    async handleForgotPassword() {\r\n      if (!this.forgotPasswordCode) {\r\n        alert('请输入验证码');\r\n        return;\r\n      }\r\n      const username = this.forgotPasswordInput;\r\n      try {\r\n        const response = await axios.post(\r\n          'http://127.0.0.1:8000/api/verify-forgot-password-code',\r\n          {\r\n            username,\r\n            code: this.forgotPasswordCode,\r\n          },\r\n          {\r\n            headers: {\r\n              'Content-Type': 'application/json',\r\n            },\r\n          }\r\n        );\r\n        // 这里可以根据实际需求使用 response 做更多处理\r\n        this.result = {\r\n          success: true,\r\n          message: '验证码验证成功，请重置密码！',\r\n        };\r\n        // 可以在这里跳转到重置密码页面\r\n      } catch (error) {\r\n        this.result = {\r\n          success: false,\r\n          message: error.response?.data?.detail || '验证码验证失败',\r\n        };\r\n      }\r\n    },\r\n    // 切换到密码登录视图\r\n    toggleToPassw