[16] = [_createTextVNode(\"用户列表\")])),\n    _: 1 /* STABLE */\n  })]), _createElementVNode(\"li\", _hoisted_29, [_createVNode(_component_router_link, {\n    to: \"/user/bigdatauser\",\n    class: \"sub-menu-link\"\n  }, {\n    default: _withCtx(() => _cache[17] || (_cache[17] = [_createTextVNode(\"大数据用户\")])),\n    _: 1 /* STABLE */\n  })])])) : _createCommentVNode(\"v-if\", true)]), _createCommentVNode(\" 最近聊天列表 \"), _createElementVNode(\"div\", _hoisted_30, [_createCommentVNode(\" 可点击的标题，用于切换折叠状态 \"), _createElementVNode(\"div\", {\n    class: \"recent-chats-title\",\n    onClick: _cache[8] || (_cache[8] = (...args) => $setup.toggleRecentChatCollapse && $setup.toggleRecentChatCollapse(...args))\n  }, [_cache[18] || (_cache[18] = _createTextVNode(\" 最近聊天 \")), _createCommentVNode(\" 可选：添加箭头图标表示折叠状态，这里用文字示例 \"), _createElementVNode(\"span\", null, _toDisplayString($setup.isRecentChatCollapse ? '▶' : '▼'), 1 /* TEXT */)]), _createCommentVNode(\" 根据折叠状态决定是否显示聊天用户列表 \"), _withDirectives(_createElementVNode(\"div\", _hoisted_31, [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList($setup.recentChats, (user, index) => {\n    return _openBlock(), _createElementBlock(\"div\", {\n      key: index,\n      class: \"recent-chat-item\",\n      onClick: $event => $setup.startChat(user)\n    }, [_createElementVNode(\"div\", _hoisted_33, [_createElementVNode(\"img\", {\n      src: $setup.getFullUrl(user.photo) || $setup.defaultAvatar,\n      alt: \"用户头像\",\n      class: \"result-avatar\"\n    }, null, 8 /* PROPS */, _hoisted_34)]), _createElementVNode(\"div\", _hoisted_35, [_createElementVNode(\"div\", _hoisted_36, _toDisplayString(user.username), 1 /* TEXT */)])], 8 /* PROPS */, _hoisted_32);\n  }), 128 /* KEYED_FRAGMENT */))], 512 /* NEED_PATCH */), [[_vShow, !$setup.isRecentChatCollapse]])])])]), _createElementVNode(\"main\", _hoisted_37, [_createVNode(_component_router_view)])])]);\n}","map":{"version":3,"names":["class","key","_createElementBlock","_hoisted_1","_createElementVNode","_hoisted_2","_hoisted_3","onClick","_cache","args","$setup","goToUserDetail","src","avatarUrl","alt","_hoisted_4","_hoisted_5","_toDisplayString","displayName","_hoisted_6","logout","_hoisted_7","_hoisted_8","_createCommentVNode","_hoisted_9","toggleSearch","isSearchOpen","_hoisted_10","_hoisted_11","type","$event","searchKeyword","placeholder","onKeyup","_withKeys","searchUsers","isSearching","_hoisted_12","_createTextVNode","searchResults","length","_hoisted_13","_Fragment","_renderList","user","id","startChat","_hoisted_15","getFullUrl","photo","defaultAvatar","_hoisted_16","_hoisted_17","_hoisted_18","username","_hoisted_19","phone","_hoisted_14","_hoisted_20","_hoisted_21","_hoisted_22","_createVNode","_component_router_link","to","default","_withCtx","_","_hoisted_23","_hoisted_24","_hoisted_25","toggleUserInfo","_hoisted_26","isUserInfoOpen","_hoisted_27","_hoisted_28","_hoisted_29","_hoisted_30","toggleRecentChatCollapse","isRecentChatCollapse","_hoisted_31","recentChats","index","_hoisted_33","_hoisted_34","_hoisted_35","_hoisted_36","_hoisted_32","_hoisted_37","_component_router_view"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\views\\UserLayout.vue"],"sourcesContent":["<template>\r\n  <div class=\"user-page\">\r\n    <header class=\"header\">\r\n      <div class=\"header-left\">\r\n        <div class=\"user-info\" @click=\"goToUserDetail\">\r\n          <img :src=\"avatarUrl\" alt=\"用户头像\" class=\"avatar\" />\r\n          <span class=\"username\">{{ displayName }}</span>\r\n        </div>\r\n      </div>\r\n      \r\n      <div class=\"header-right\">\r\n        <button @click=\"logout\" class=\"logout-button\">退出登录</button>\r\n      </div>\r\n    </header>\r\n\r\n    <div class=\"main-layout\">\r\n      <aside class=\"sidebar\">\r\n        <!-- 搜索组件 -->\r\n        <div class=\"sidebar-search\">\r\n          <div class=\"search-toggle\" @click=\"toggleSearch\">\r\n            <i class=\"fa fa-search\" aria-hidden=\"true\"></i>\r\n            <span>搜索用户</span>\r\n          </div>\r\n          \r\n          <div v-if=\"isSearchOpen\" class=\"search-box\">\r\n            <div class=\"search-input-group\">\r\n              <input \r\n                type=\"text\" \r\n                v-model=\"searchKeyword\" \r\n                placeholder=\"搜索用户...\" \r\n                @keyup.enter=\"searchUsers\"\r\n              />\r\n              <button class=\"search-button\" @click=\"searchUsers\">\r\n                <i class=\"fa fa-search\" aria-hidden=\"true\"></i>\r\n              </button>\r\n              <button class=\"cancel-button\" @click=\"toggleSearch\">\r\n                取消\r\n              </button>\r\n            </div>\r\n            \r\n            <!-- 搜索结果列表 -->\r\n            <div v-if=\"isSearching\" class=\"search-loading\">\r\n              <i class=\"fa fa-spinner fa-spin\" aria-hidden=\"true\"></i> 搜索中...\r\n            </div>\r\n            \r\n            <div v-else-if=\"searchResults.length > 0\" class=\"search-results\">\r\n              <div \r\n                v-for=\"user in searchResults\" \r\n                :key=\"user.id\" \r\n                class=\"search-result-item\"\r\n                @click=\"startChat(user)\"\r\n              >\r\n                <div class=\"result-avatar-container\">\r\n                  <img \r\n                    :src=\"getFullUrl(user.photo)|| defaultAvatar\" \r\n                    alt=\"用户头像\" \r\n                    class=\"result-avatar\"\r\n                  />\r\n                </div>\r\n                <div class=\"result-info\">\r\n                  <div class=\"result-name\">{{ user.username }}</div>\r\n                  <div class=\"result-phone\">{{ user.phone }}</div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            \r\n            <div v-else-if=\"searchKeyword && !isSearching\" class=\"no-results\">\r\n              没有找到匹配的用户\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- 菜单保持不变 -->\r\n        <ul class=\"menu\">\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/user/dashboard\" class=\"menu-link\">仪表盘</router-link>\r\n          </li>\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/user-moment\" class=\"menu-link\">我相关</router-link>\r\n          </li>\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/moments\" class=\"menu-link\">朋友圈</router-link>\r\n          </li>\r\n          <li class=\"menu-item\">\r\n            <div @click=\"toggleUserInfo\" class=\"menu-title\">\r\n              用户信息\r\n              <span class=\"arrow\">{{ isUserInfoOpen ? '▼' : '▶' }}</span>\r\n            </div>\r\n            <ul v-if=\"isUserInfoOpen\" class=\"sub-menu\">\r\n              <li class=\"sub-menu-item\">\r\n                <router-link to=\"/user/userinfo/userlist\" class=\"sub-menu-link\">用户列表</router-link>\r\n              </li>\r\n              <li class=\"sub-menu-item2\">\r\n                <router-link to=\"/user/bigdatauser\" class=\"sub-menu-link\">大数据用户</router-link>\r\n              </li>\r\n            </ul>\r\n          </li>\r\n          <!-- 最近聊天列表 -->\r\n<div class=\"recent-chats\">\r\n  <!-- 可点击的标题，用于切换折叠状态 -->\r\n  <div \r\n    class=\"recent-chats-title\" \r\n    @click=\"toggleRecentChatCollapse\"\r\n  >\r\n    最近聊天\r\n    <!-- 可选：添加箭头图标表示折叠状态，这里用文字示例 -->\r\n    <span>{{ isRecentChatCollapse ? '▶' : '▼' }}</span>\r\n  </div>\r\n  <!-- 根据折叠状态决定是否显示聊天用户列表 -->\r\n  <div \r\n    class=\"recent-chat-list\" \r\n    v-show=\"!isRecentChatCollapse\"\r\n  >\r\n    <div\r\n      v-for=\"(user, index) in recentChats\"\r\n      :key=\"index\"\r\n      class=\"recent-chat-item\"\r\n      @click=\"startChat(user)\"\r\n    >\r\n      <div class=\"result-avatar-container\">\r\n        <img\r\n          :src=\"getFullUrl(user.photo) || defaultAvatar\"\r\n          alt=\"用户头像\"\r\n          class=\"result-avatar\"\r\n        />\r\n      </div>\r\n      <div class=\"result-info\">\r\n        <div class=\"result-name\">{{ user.username }}</div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n        </ul>\r\n      </aside>\r\n\r\n      <main class=\"main-content\">\r\n        <router-view />\r\n      </main>\r\n      \r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { computed, ref,onMounted, watch } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { useRouter } from 'vue-router';\r\nimport defaultAvatar from '@/assets/default-avatar.png';\r\nimport { API_CONFIG } from '@/config/config';\r\nimport axios from 'axios';\r\nimport { ElMessage } from 'element-plus';\r\nimport { debounce } from 'lodash'; // 引入防抖函数\r\n\r\nexport default {\r\n  setup() {\r\n    const store = useStore();\r\n    const router = useRouter();\r\n    const isUserInfoOpen = ref(false);\r\n    const user = computed(() => store.state.user);\r\n    const displayName = computed(() => user.value?.username || '未登录');\r\n    \r\n    // 搜索相关状态\r\n    const isSearchOpen = ref(false);\r\n    const searchKeyword = ref('');\r\n    const searchResults = ref([]);\r\n    const isSearching = ref(false);\r\n    \r\n        // 最近聊天列表（从 Vuex 获取）\r\n    const recentChats = computed(() => store.getters['chat/getRecentChats']);\r\n    console.log(\"最近聊天: \",recentChats)\r\n\r\n        // 工具方法\r\n    const getFullUrl = (path) => {\r\n      if (!path || path === defaultAvatar) return path\r\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`\r\n    }\r\n        // 新增：最近聊天折叠状态\r\n    const isRecentChatCollapse = ref(true); // 初始为折叠状态\r\n    const toggleRecentChatCollapse = () => {\r\n      isRecentChatCollapse.value = !isRecentChatCollapse.value;\r\n    };\r\n\r\n    const avatarUrl = computed(() => {\r\n      if (user.value?.photo) {\r\n        return `${API_CONFIG.BASE_URL}${user.value.photo}`;\r\n      }\r\n      return defaultAvatar;\r\n    });\r\n\r\n    const logout = () => {\r\n      store.dispatch('logout');\r\n      router.push('/login');\r\n    };\r\n\r\n    const goToUserDetail = () => {\r\n      router.push('/user/userinfo/' + user.value?.id);\r\n    };\r\n\r\n    const toggleUserInfo = () => {\r\n      isUserInfoOpen.value = !isUserInfoOpen.value;\r\n    };\r\n    \r\n    // 搜索相关方法\r\n    const toggleSearch = () => {\r\n      isSearchOpen.value = !isSearchOpen.value;\r\n      \r\n      // 关闭搜索时清空结果\r\n      if (!isSearchOpen.value) {\r\n        searchKeyword.value = '';\r\n        searchResults.value = [];\r\n      }\r\n    };\r\n\r\n\r\n\r\n// 初始化防抖函数\r\n    const searchUsers = debounce(async (keyword) => {\r\n      if (!keyword.trim()) {\r\n        searchResults.value = []; // 清空搜索结果\r\n        return;\r\n      }\r\n      \r\n      try {\r\n        // 调用搜索API\r\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/user/search`, {\r\n          params: {\r\n            keyword: keyword.trim()\r\n          },\r\n          headers: { Authorization: `Bearer ${store.state.token}` }\r\n        });\r\n        \r\n        searchResults.value = response.data.data || [];\r\n        console.log(\"实时搜索结果: \", searchResults.value);\r\n      } catch (error) {\r\n        console.error('搜索用户失败:', error);\r\n        ElMessage.error('搜索用户失败');\r\n      } finally {\r\n        isSearching.value = false;\r\n      }\r\n    }, 300); // 设置300ms防抖延迟\r\n\r\n    // 实时搜索函数\r\n    const handleLiveSearch = (e) => {\r\n      const keyword = e.target.value;\r\n      isSearching.value = true;\r\n      searchUsers(keyword);\r\n    };\r\n\r\n    // const searchUsers = async () => {\r\n    //   if (!searchKeyword.value.trim()) {\r\n    //     ElMessage.warning('请输入搜索关键词');\r\n    //     return;\r\n    //   }\r\n      \r\n    //   isSearching.value = true;\r\n      \r\n    //   try {\r\n    //     // 调用搜索API\r\n    //     const response = await axios.get(`${API_CONFIG.BASE_URL}/user/search`, {\r\n    //       params: {\r\n    //         keyword: searchKeyword.value.trim()\r\