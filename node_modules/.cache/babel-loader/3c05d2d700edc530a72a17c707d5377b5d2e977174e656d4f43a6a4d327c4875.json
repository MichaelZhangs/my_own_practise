{"ast":null,"code":"import { ref } from 'vue';\nimport { useStore } from 'vuex';\nimport defaultAvatar from '@/assets/default-avatar.png';\nimport QRCode from 'qrcode';\nexport default {\n  name: 'UserDetail',\n  setup() {\n    const store = useStore();\n    const editableUser = ref({\n      ...store.state.user,\n      description: '' // 确保description字段存在\n    });\n    const qrcodeUrl = ref('');\n\n    // 生成二维码逻辑（保持原有实现）\n    const generateWechatQR = async () => {\n      try {\n        const content = JSON.stringify({\n          name: editableUser.value.username,\n          phone: editableUser.value.phone,\n          email: editableUser.value.email,\n          description: editableUser.value.description\n        });\n        const canvas = document.createElement('canvas');\n        await QRCode.toCanvas(canvas, content, {\n          width: 160,\n          margin: 1,\n          color: {\n            dark: '#07c160',\n            light: '#ffffff'\n          }\n        });\n\n        // 添加头像\n        const ctx = canvas.getContext('2d');\n        const avatarImg = new Image();\n        avatarImg.src = editableUser.value.photo || defaultAvatar;\n        await new Promise(resolve => avatarImg.onload = resolve);\n        ctx.beginPath();\n        ctx.arc(80, 80, 20, 0, Math.PI * 2);\n        ctx.clip();\n        ctx.drawImage(avatarImg, 60, 60, 40, 40);\n        qrcodeUrl.value = canvas.toDataURL();\n      } catch (error) {\n        console.error('二维码生成失败:', error);\n      }\n    };\n\n    // 其他方法保持不变...\n    return {\n      editableUser,\n      qrcodeUrl,\n      defaultAvatar,\n      generateWechatQR,\n      updateAvatar: e => {/* 原有头像更新逻辑 */},\n      saveUserInfo: () => {/* 原有保存逻辑 */}\n    };\n  }\n};","map":{"version":3,"names":["ref","useStore","defaultAvatar","QRCode","name","setup","store","editableUser","state","user","description","qrcodeUrl","generateWechatQR","content","JSON","stringify","value","username","phone","email","canvas","document","createElement","toCanvas","width","margin","color","dark","light","ctx","getContext","avatarImg","Image","src","photo","Promise","resolve","onload","beginPath","arc","Math","PI","clip","drawImage","toDataURL","error","console","updateAvatar","e","saveUserInfo"],"sources":["E:\\vue_learn\\ai_vue\\ai_vue\\src\\views\\UserDetail.vue"],"sourcesContent":["<template>\r\n    <div class=\"user-detail-page\">\r\n      <h1 class=\"page-title\">用户详情</h1>\r\n      <div class=\"user-container\">\r\n        <!-- 头像 -->\r\n        <div class=\"avatar-wrapper\">\r\n          <label class=\"avatar-upload\">\r\n            <input type=\"file\" accept=\"image/*\" @change=\"updateAvatar\" hidden />\r\n            <img :src=\"editableUser.photo || defaultAvatar\" \r\n                 alt=\"用户头像\" \r\n                 class=\"user-avatar\" />\r\n            <span class=\"edit-tip\">点击更换</span>\r\n          </label>\r\n        </div>\r\n  \r\n        <!-- 用户信息 -->\r\n        <div class=\"info-section\">\r\n          <!-- 个人信息 -->\r\n          <div class=\"info-item\">\r\n            <label>姓名：</label>\r\n            <input v-model=\"editableUser.username\" class=\"short-input\" />\r\n          </div>\r\n          <div class=\"info-item\">\r\n            <label>性别：</label>\r\n            <select v-model=\"editableUser.sex\">\r\n              <option value=\"男\">男</option>\r\n              <option value=\"女\">女</option>\r\n            </select>\r\n          </div>\r\n          <div class=\"info-item\">\r\n            <label>手机：</label>\r\n            <input v-model=\"editableUser.phone\" class=\"short-input\" />\r\n          </div>\r\n          <div class=\"info-item\">\r\n            <label>邮箱：</label>\r\n            <input v-model=\"editableUser.email\" class=\"short-input\" />\r\n          </div>\r\n          <div class=\"info-item\">\r\n            <label>描述：</label>\r\n            <input v-model=\"editableUser.description\" class=\"short-input\" />\r\n          </div>\r\n  \r\n          <!-- 二维码 -->\r\n          <div class=\"info-item\">\r\n            <label>我的二维码：</label>\r\n            <div class=\"qr-wrapper\" @click=\"generateWechatQR\">\r\n              <img :src=\"qrcodeUrl\" \r\n                   alt=\"二维码\" \r\n                   class=\"wechat-qr\" />\r\n            </div>\r\n          </div>\r\n        </div>\r\n  \r\n        <button class=\"save-btn\" @click=\"saveUserInfo\">保存修改</button>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import { ref } from 'vue'\r\n  import { useStore } from 'vuex'\r\n  import defaultAvatar from '@/assets/default-avatar.png'\r\n  import QRCode from 'qrcode'\r\n  \r\n  export default {\r\n    name: 'UserDetail',\r\n    setup() {\r\n      const store = useStore()\r\n      const editableUser = ref({ \r\n        ...store.state.user,\r\n        description: '' // 确保description字段存在\r\n      })\r\n      const qrcodeUrl = ref('')\r\n  \r\n      // 生成二维码逻辑（保持原有实现）\r\n      const generateWechatQR = async () => {\r\n        try {\r\n          const content = JSON.stringify({\r\n            name: editableUser.value.username,\r\n            phone: editableUser.value.phone,\r\n            email: editableUser.value.email,\r\n            description: editableUser.value.description\r\n          })\r\n  \r\n          const canvas = document.createElement('canvas')\r\n          await QRCode.toCanvas(canvas, content, {\r\n            width: 160,\r\n            margin: 1,\r\n            color: {\r\n              dark: '#07c160',\r\n              light: '#ffffff'\r\n            }\r\n          })\r\n  \r\n          // 添加头像\r\n          const ctx = canvas.getContext('2d')\r\n          const avatarImg = new Image()\r\n          avatarImg.src = editableUser.value.photo || defaultAvatar\r\n          await new Promise(resolve => (avatarImg.onload = resolve))\r\n  \r\n          ctx.beginPath()\r\n          ctx.arc(80, 80, 20, 0, Math.PI * 2)\r\n          ctx.clip()\r\n          ctx.drawImage(avatarImg, 60, 60, 40, 40)\r\n  \r\n          qrcodeUrl.value = canvas.toDataURL()\r\n        } catch (error) {\r\n          console.error('二维码生成失败:', error)\r\n        }\r\n      }\r\n  \r\n      // 其他方法保持不变...\r\n      return {\r\n        editableUser,\r\n        qrcodeUrl,\r\n        defaultAvatar,\r\n        generateWechatQR,\r\n        updateAvatar: (e) => { /* 原有头像更新逻辑 */ },\r\n        saveUserInfo: () => { /* 原有保存逻辑 */ }\r\n      }\r\n    }\r\n  }\r\n  </script>\r\n  \r\n  <style scoped>\r\n  /* 基础样式 */\r\n  .user-detail-page {\r\n    max-width: 600px;\r\n    margin: 0 auto;\r\n    padding: 20px;\r\n  }\r\n  \r\n  .page-title {\r\n    text-align: center;\r\n    font-size: 20px;\r\n    color: #333;\r\n    margin-bottom: 25px;\r\n  }\r\n  \r\n  /* 头像样式 */\r\n  .avatar-wrapper {\r\n    text-align: center;\r\n    margin-bottom: 25px;\r\n  }\r\n  \r\n  .user-avatar {\r\n    width: 100px;\r\n    height: 100px;\r\n    border-radius: 50%;\r\n    border: 2px solid #07c160;\r\n    cursor: pointer;\r\n  }\r\n  \r\n  .edit-tip {\r\n    display: block;\r\n    color: #666;\r\n    font-size: 12px;\r\n    margin-top: 5px;\r\n  }\r\n  \r\n  /* 信息区域 */\r\n  .info-section {\r\n    width: 100%;\r\n    max-width: 400px;\r\n    margin: 0 auto;\r\n  }\r\n  \r\n  .info-item {\r\n    display: flex;\r\n    align-items: center;\r\n    margin-bottom: 15px;\r\n  }\r\n  \r\n  .info-item label {\r\n    width: 90px;\r\n    font-size: 14px;\r\n    color: #666;\r\n    text-align: right;\r\n    margin-right: 10px;\r\n  }\r\n  \r\n  /* 输入框样式 */\r\n  .short-input {\r\n    flex: 1;\r\n    padding: 6px 10px;\r\n    border: 1px solid #ddd;\r\n    border-radius: 4px;\r\n    font-size: 14px;\r\n    max-width: 250px;\r\n  }\r\n  \r\n  /* 二维码样式 */\r\n  .qr-wrapper {\r\n    flex: 1;\r\n    cursor: pointer;\r\n  }\r\n  \r\n  .wechat-qr {\r\n    width: 160px;\r\n    height: 160px;\r\n    border: 3px solid #07c160;\r\n    border-radius: 8px;\r\n    padding: 5px;\r\n    background: white;\r\n  }\r\n  \r\n  /* 保存按钮 */\r\n  .save-btn {\r\n    display: block;\r\n    width: 120px;\r\n    padding: 10px;\r\n    margin: 25px auto 0;\r\n    background: #07c160;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 4px;\r\n    cursor: pointer;\r\n  }\r\n  \r\n  @media (max-width: 480px) {\r\n    .info-item {\r\n      flex-direction: column;\r\n      align-items: flex-start;\r\n    }\r\n  \r\n    .info-item label {\r\n      text-align: left;\r\n      margin-bottom: 5px;\r\n    }\r\n  \r\n    .short-input {\r\n      max-width: 100%;\r\n      width: 100%;\r\n    }\r\n  \r\n    .wechat-qr {\r\n      width: 140px;\r\n      height: 140px;\r\n    }\r\n  }\r\n  </style>"],"mappings":"AA2DE,SAASA,GAAE,QAAS,KAAI;AACxB,SAASC,QAAO,QAAS,MAAK;AAC9B,OAAOC,aAAY,MAAO,6BAA4B;AACtD,OAAOC,MAAK,MAAO,QAAO;AAE1B,eAAe;EACbC,IAAI,EAAE,YAAY;EAClBC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIL,QAAQ,CAAC;IACvB,MAAMM,YAAW,GAAIP,GAAG,CAAC;MACvB,GAAGM,KAAK,CAACE,KAAK,CAACC,IAAI;MACnBC,WAAW,EAAE,EAAC,CAAE;IAClB,CAAC;IACD,MAAMC,SAAQ,GAAIX,GAAG,CAAC,EAAE;;IAExB;IACA,MAAMY,gBAAe,GAAI,MAAAA,CAAA,KAAY;MACnC,IAAI;QACF,MAAMC,OAAM,GAAIC,IAAI,CAACC,SAAS,CAAC;UAC7BX,IAAI,EAAEG,YAAY,CAACS,KAAK,CAACC,QAAQ;UACjCC,KAAK,EAAEX,YAAY,CAACS,KAAK,CAACE,KAAK;UAC/BC,KAAK,EAAEZ,YAAY,CAACS,KAAK,CAACG,KAAK;UAC/BT,WAAW,EAAEH,YAAY,CAACS,KAAK,CAACN;QAClC,CAAC;QAED,MAAMU,MAAK,GAAIC,QAAQ,CAACC,aAAa,CAAC,QAAQ;QAC9C,MAAMnB,MAAM,CAACoB,QAAQ,CAACH,MAAM,EAAEP,OAAO,EAAE;UACrCW,KAAK,EAAE,GAAG;UACVC,MAAM,EAAE,CAAC;UACTC,KAAK,EAAE;YACLC,IAAI,EAAE,SAAS;YACfC,KAAK,EAAE;UACT;QACF,CAAC;;QAED;QACA,MAAMC,GAAE,GAAIT,MAAM,CAACU,UAAU,CAAC,IAAI;QAClC,MAAMC,SAAQ,GAAI,IAAIC,KAAK,CAAC;QAC5BD,SAAS,CAACE,GAAE,GAAI1B,YAAY,CAACS,KAAK,CAACkB,KAAI,IAAKhC,aAAY;QACxD,MAAM,IAAIiC,OAAO,CAACC,OAAM,IAAML,SAAS,CAACM,MAAK,GAAID,OAAQ;QAEzDP,GAAG,CAACS,SAAS,CAAC;QACdT,GAAG,CAACU,GAAG,CAAC,EAAE,EAAE,EAAE,EAAE,EAAE,EAAE,CAAC,EAAEC,IAAI,CAACC,EAAC,GAAI,CAAC;QAClCZ,GAAG,CAACa,IAAI,CAAC;QACTb,GAAG,CAACc,SAAS,CAACZ,SAAS,EAAE,EAAE,EAAE,EAAE,EAAE,EAAE,EAAE,EAAE;QAEvCpB,SAAS,CAACK,KAAI,GAAII,MAAM,CAACwB,SAAS,CAAC;MACrC,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,UAAU,EAAEA,KAAK;MACjC;IACF;;IAEA;IACA,OAAO;MACLtC,YAAY;MACZI,SAAS;MACTT,aAAa;MACbU,gBAAgB;MAChBmC,YAAY,EAAGC,CAAC,IAAK,CAAE,eAAgB;MACvCC,YAAY,EAAEA,CAAA,KAAM,CAAE;IACxB;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}