{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { mapState, mapActions } from 'vuex';\nexport default {\n  name: \"UserPage\",\n  computed: {\n    ...mapState(['user']),\n    // 从 Vuex 中获取用户信息\n    displayName() {\n      // 优先展示用户名，其次是电话号码，最后是邮箱号码\n      return this.user?.username || this.user?.phone || this.user?.email || \"未登录\";\n    }\n  },\n  methods: {\n    ...mapActions(['logout']),\n    // 使用 Vuex 的 logout 方法\n    async logout() {\n      await this.$store.dispatch(\"logout\"); // 清除用户信息和 Token\n      this.$router.push(\"/login\"); // 跳转到登录页\n    }\n  }\n};","map":{"version":3,"names":["mapState","mapActions","name","computed","displayName","user","username","phone","email","methods","logout","$store","dispatch","$router","push"],"sources":["E:\\vue_learn\\ai_vue\\ai_vue\\src\\views\\UserPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"user-page\">\r\n    <!-- 顶部导航栏 -->\r\n    <header class=\"header\">\r\n      <div class=\"header-left\">\r\n        <span class=\"logo\">个人中心</span>\r\n      </div>\r\n      <div class=\"header-right\">\r\n        <span class=\"username\">{{ displayName }}</span>\r\n        <button @click=\"logout\" class=\"logout-button\">退出登录</button>\r\n      </div>\r\n    </header>\r\n\r\n    <!-- 主体区域 -->\r\n    <div class=\"main-layout\">\r\n      <!-- 侧边栏 -->\r\n      <aside class=\"sidebar\">\r\n        <ul class=\"menu\">\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/user/dashboard\">仪表盘</router-link>\r\n          </li>\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/user/profile\">个人资料</router-link>\r\n          </li>\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/user/settings\">设置</router-link>\r\n          </li>\r\n        </ul>\r\n      </aside>\r\n\r\n      <!-- 主内容区域 -->\r\n      <main class=\"main-content\">\r\n        <router-view></router-view>\r\n      </main>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { mapState, mapActions } from 'vuex';\r\n\r\nexport default {\r\n  name: \"UserPage\",\r\n  computed: {\r\n    ...mapState(['user']), // 从 Vuex 中获取用户信息\r\n    displayName() {\r\n      // 优先展示用户名，其次是电话号码，最后是邮箱号码\r\n      return (\r\n        this.user?.username ||\r\n        this.user?.phone ||\r\n        this.user?.email ||\r\n        \"未登录\"\r\n      );\r\n    },\r\n  },\r\n  methods: {\r\n    ...mapActions(['logout']), // 使用 Vuex 的 logout 方法\r\n    async logout() {\r\n      await this.$store.dispatch(\"logout\"); // 清除用户信息和 Token\r\n      this.$router.push(\"/login\"); // 跳转到登录页\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* 样式保持不变 */\r\n.user-page {\r\n  display: flex;\r\n  flex-direction: column;\r\n  height: 100vh;\r\n  background-color: #f0f2f5;\r\n}\r\n\r\n.header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  padding: 0 20px;\r\n  height: 60px;\r\n  background-color: #001529;\r\n  color: white;\r\n}\r\n\r\n.header-left .logo {\r\n  font-size: 20px;\r\n  font-weight: bold;\r\n}\r\n\r\n.header-right .username {\r\n  margin-right: 20px;\r\n}\r\n\r\n.logout-button {\r\n  padding: 5px 10px;\r\n  background-color: #1890ff;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n}\r\n\r\n.logout-button:hover {\r\n  background-color: #40a9ff;\r\n}\r\n\r\n.main-layout {\r\n  display: flex;\r\n  flex: 1;\r\n  overflow: hidden;\r\n}\r\n\r\n.sidebar {\r\n  width: 200px;\r\n  background-color: #001529;\r\n  color: white;\r\n  overflow-y: auto;\r\n}\r\n\r\n.menu {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 0;\r\n}\r\n\r\n.menu-item {\r\n  padding: 15px 20px;\r\n  border-bottom: 1px solid #002140;\r\n}\r\n\r\n.menu-item a {\r\n  color: white;\r\n  text-decoration: none;\r\n  display: block;\r\n}\r\n\r\n.menu-item a:hover {\r\n  color: #1890ff;\r\n}\r\n\r\n.main-content {\r\n  flex: 1;\r\n  padding: 20px;\r\n  background-color: white;\r\n  overflow-y: auto;\r\n}\r\n</style>"],"mappings":";AAuCA,SAASA,QAAQ,EAAEC,UAAS,QAAS,MAAM;AAE3C,eAAe;EACbC,IAAI,EAAE,UAAU;EAChBC,QAAQ,EAAE;IACR,GAAGH,QAAQ,CAAC,CAAC,MAAM,CAAC,CAAC;IAAE;IACvBI,WAAWA,CAAA,EAAG;MACZ;MACA,OACE,IAAI,CAACC,IAAI,EAAEC,QAAO,IAClB,IAAI,CAACD,IAAI,EAAEE,KAAI,IACf,IAAI,CAACF,IAAI,EAAEG,KAAI,IACf,KAAI;IAER;EACF,CAAC;EACDC,OAAO,EAAE;IACP,GAAGR,UAAU,CAAC,CAAC,QAAQ,CAAC,CAAC;IAAE;IAC3B,MAAMS,MAAMA,CAAA,EAAG;MACb,MAAM,IAAI,CAACC,MAAM,CAACC,QAAQ,CAAC,QAAQ,CAAC,EAAE;MACtC,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,QAAQ,CAAC,EAAE;IAC/B;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}