{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { computed, onMounted, ref } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nimport defaultAvatar from '@/assets/default-avatar.png';\nimport { API_CONFIG } from '@/config/config';\nimport UserMoments from '@/article/UserMoments.vue'; // 引入UserMoments组件\n\nexport default {\n  name: 'UserPage',\n  components: {\n    UserMoments\n  },\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const isUserInfoOpen = ref(false); // 控制用户信息子目录的展开状态\n    const activeTab = ref('myPosts'); // 默认显示\"我发布的内容\"\n\n    const user = computed(() => store.state.user);\n    const displayName = computed(() => user.value?.username || user.value?.phone || user.value?.email || '未登录');\n\n    // 处理头像路径\n    const avatarUrl = computed(() => {\n      if (user.value?.photo) {\n        console.log(\"详情页: 头像: \", user.value);\n        console.log(\"打印头像: \", `${API_CONFIG.BASE_URL}${user.value.photo}`);\n        // 拼接完整 URL\n        return `${API_CONFIG.BASE_URL}${user.value.photo}`;\n      }\n      // 如果头像为空，使用默认头像\n      return defaultAvatar;\n    });\n\n    // 退出登录\n    const logout = () => {\n      store.dispatch('logout');\n      router.push('/login');\n    };\n\n    // 跳转到用户详情页\n    const goToUserDetail = () => {\n      router.push('/user/detail');\n    };\n\n    // 切换用户信息子目录的展开状态\n    const toggleUserInfo = () => {\n      isUserInfoOpen.value = !isUserInfoOpen.value;\n    };\n\n    // 页面加载时检查用户是否登录\n    onMounted(() => {\n      if (!store.state.user) {\n        router.push('/login');\n      }\n    });\n    return {\n      user,\n      displayName,\n      avatarUrl,\n      logout,\n      goToUserDetail,\n      isUserInfoOpen,\n      toggleUserInfo,\n      activeTab\n    };\n  }\n};","map":{"version":3,"names":["computed","onMounted","ref","useStore","useRouter","defaultAvatar","API_CONFIG","UserMoments","name","components","setup","store","router","isUserInfoOpen","activeTab","user","state","displayName","value","username","phone","email","avatarUrl","photo","console","log","BASE_URL","logout","dispatch","push","goToUserDetail","toggleUserInfo"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\views\\UserPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"user-page\">\r\n    <header class=\"header\">\r\n      <div class=\"header-left\">\r\n        <!-- 点击头像跳转到用户详情页 -->\r\n        <div class=\"user-info\" @click=\"goToUserDetail\">\r\n          <img :src=\"avatarUrl\" alt=\"头像\" class=\"avatar\" />\r\n          <span class=\"username\">{{ displayName }}</span>\r\n        </div>\r\n      </div>\r\n      <div class=\"header-right\">\r\n        <button @click=\"logout\" class=\"logout-button\">退出登录</button>\r\n      </div>\r\n    </header>\r\n\r\n    <div class=\"main-layout\">\r\n      <aside class=\"sidebar\">\r\n        <ul class=\"menu\">\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/user/dashboard\" class=\"menu-link\">仪表盘</router-link>\r\n          </li>\r\n        \r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/moments\" class=\"menu-link\">朋友圈</router-link>\r\n          </li>\r\n\r\n          <li class=\"menu-item\">\r\n            <!-- 用户信息 -->\r\n            <div @click=\"toggleUserInfo\" class=\"menu-title\">\r\n              用户信息\r\n              <span class=\"arrow\">{{ isUserInfoOpen ? '▼' : '▶' }}</span>\r\n            </div>\r\n            <!-- 用户信息子目录 -->\r\n            <ul v-if=\"isUserInfoOpen\" class=\"sub-menu\">\r\n              <li class=\"sub-menu-item\">\r\n                <router-link to=\"/user/userinfo/userlist\" class=\"sub-menu-link\">用户列表</router-link>\r\n              </li>\r\n              <li class=\"sub-menu-item2\">\r\n                <router-link to=\"/user/bigdatauser/userlist\" class=\"sub-menu-link\">大数据用户</router-link>\r\n              </li>\r\n            </ul>\r\n          </li>\r\n        </ul>\r\n      </aside>\r\n\r\n      <main class=\"main-content\">\r\n        <!-- 使用Element Plus的Tabs组件 -->\r\n        <el-tabs v-model=\"activeTab\" type=\"card\">\r\n          <el-tab-pane label=\"我发布的内容\" name=\"myPosts\">\r\n            <div class=\"content-container\">\r\n              <!-- 这里放置\"我发布的内容\"组件 -->\r\n              <UserMoments :fetchType=\"'myPosts'\" />\r\n            </div>\r\n          </el-tab-pane>\r\n          <el-tab-pane label=\"我喜欢的内容\" name=\"myLikes\">\r\n            <div class=\"content-container\">\r\n              <!-- 这里放置\"我喜欢的内容\"组件 -->\r\n              <UserMoments :fetchType=\"'myLikes'\" />\r\n            </div>\r\n          </el-tab-pane>\r\n        </el-tabs>\r\n      </main>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { computed, onMounted, ref } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { useRouter } from 'vue-router';\r\nimport defaultAvatar from '@/assets/default-avatar.png';\r\nimport { API_CONFIG } from '@/config/config';\r\nimport UserMoments from '@/article/UserMoments.vue'; // 引入UserMoments组件\r\n\r\nexport default {\r\n  name: 'UserPage',\r\n  components: {\r\n    UserMoments\r\n  },\r\n  setup() {\r\n    const store = useStore();\r\n    const router = useRouter();\r\n    const isUserInfoOpen = ref(false); // 控制用户信息子目录的展开状态\r\n    const activeTab = ref('myPosts'); // 默认显示\"我发布的内容\"\r\n\r\n    const user = computed(() => store.state.user);\r\n    const displayName = computed(() => user.value?.username || user.value?.phone || user.value?.email || '未登录');\r\n\r\n    // 处理头像路径\r\n    const avatarUrl = computed(() => {\r\n      if (user.value?.photo) {\r\n        console.log(\"详情页: 头像: \", user.value)\r\n        console.log(\"打印头像: \",`${API_CONFIG.BASE_URL}${user.value.photo}`)\r\n        // 拼接完整 URL\r\n        return `${API_CONFIG.BASE_URL}${user.value.photo}`;\r\n      }\r\n      // 如果头像为空，使用默认头像\r\n      return defaultAvatar;\r\n    });\r\n\r\n    // 退出登录\r\n    const logout = () => {\r\n      store.dispatch('logout');\r\n      router.push('/login');\r\n    };\r\n\r\n    // 跳转到用户详情页\r\n    const goToUserDetail = () => {\r\n      router.push('/user/detail');\r\n    };\r\n\r\n    // 切换用户信息子目录的展开状态\r\n    const toggleUserInfo = () => {\r\n      isUserInfoOpen.value = !isUserInfoOpen.value;\r\n    };\r\n\r\n    // 页面加载时检查用户是否登录\r\n    onMounted(() => {\r\n      if (!store.state.user) {\r\n        router.push('/login');\r\n      }\r\n    });\r\n\r\n    return {\r\n      user,\r\n      displayName,\r\n      avatarUrl,\r\n      logout,\r\n      goToUserDetail,\r\n      isUserInfoOpen,\r\n      toggleUserInfo,\r\n      activeTab\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.user-page {\r\n  display: flex;\r\n  flex-direction: column;\r\n  height: 100vh;\r\n  background-color: #f0f2f5;\r\n}\r\n\r\n.header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  padding: 0 20px;\r\n  height: 60px;\r\n  background-color: #001529;\r\n  color: white;\r\n}\r\n\r\n.header-left {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.user-info {\r\n  display: flex;\r\n  align-items: center;\r\n  cursor: pointer;\r\n}\r\n\r\n.avatar {\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 50%;\r\n  margin-right: 10px;\r\n}\r\n\r\n.username {\r\n  margin-right: 20px;\r\n  font-size: 16px;\r\n}\r\n\r\n.logout-button {\r\n  padding: 5px 10px;\r\n  background-color: #1890ff;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n}\r\n\r\n.logout-button:hover {\r\n  background-color: #40a9ff;\r\n}\r\n\r\n.main-layout {\r\n  display: flex;\r\n  flex: 1;\r\n  overflow: hidden;\r\n}\r\n\r\n.sidebar {\r\n  width: 200px;\r\n  background-color: #001529;\r\n  color: white;\r\n  overflow-y: auto;\r\n}\r\n\r\n.menu {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 0;\r\n}\r\n\r\n.menu-item {\r\n  padding: 15px 20px;\r\n  border-bottom: 1px solid #002140;\r\n}\r\n\r\n.menu-link {\r\n  color: white;\r\n  text-decoration: none;\r\n  font-size: 14px; /* 仪表盘字体大小 */\r\n}\r\n\r\n.menu-link:hover {\r\n  color: #1890ff;\r\n}\r\n\r\n.menu-title {\r\n  cursor: pointer;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  font-size: 14px; /* 用户信息字体大小 */\r\n}\r\n\r\n.arrow {\r\n  font-size: 12px;\r\n}\r\n\r\n.sub-menu {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 10px 0 0 20px;\r\n}\r\n\r\n.sub-menu-item {\r\n  padding: 10px 0;\r\n}\r\n\r\n.sub-menu-link {\r\n  color: white;\r\n  text-decoration: none;\r\n  font-size: 14px; /* 用户列表字体大小 */\r\n}\r\n\r\n.sub-menu-link:hover {\r\n  color: #1890ff;\r\n}\r\n\r\n.main-content {\r\n  flex: 1;\r\n  padding: 20px;\r\n  background-color: white;\r\n  overflow-y: auto;\r\n  position: relative;\r\n}\r\n\r\n.content-container {\r\n  height: calc(100vh - 100px); /* 调整内容区域高度 */\r\n  overflow-y: auto; /* 添加滚动条 */\r\n}\r\n</style>"],"mappings":";AAmEA,SAASA,QAAQ,EAAEC,SAAS,EAAEC,GAAE,QAAS,KAAK;AAC9C,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,SAAQ,QAAS,YAAY;AACtC,OAAOC,aAAY,MAAO,6BAA6B;AACvD,SAASC,UAAS,QAAS,iBAAiB;AAC5C,OAAOC,WAAU,MAAO,2BAA2B,EAAE;;AAErD,eAAe;EACbC,IAAI,EAAE,UAAU;EAChBC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIR,QAAQ,CAAC,CAAC;IACxB,MAAMS,MAAK,GAAIR,SAAS,CAAC,CAAC;IAC1B,MAAMS,cAAa,GAAIX,GAAG,CAAC,KAAK,CAAC,EAAE;IACnC,MAAMY,SAAQ,GAAIZ,GAAG,CAAC,SAAS,CAAC,EAAE;;IAElC,MAAMa,IAAG,GAAIf,QAAQ,CAAC,MAAMW,KAAK,CAACK,KAAK,CAACD,IAAI,CAAC;IAC7C,MAAME,WAAU,GAAIjB,QAAQ,CAAC,MAAMe,IAAI,CAACG,KAAK,EAAEC,QAAO,IAAKJ,IAAI,CAACG,KAAK,EAAEE,KAAI,IAAKL,IAAI,CAACG,KAAK,EAAEG,KAAI,IAAK,KAAK,CAAC;;IAE3G;IACA,MAAMC,SAAQ,GAAItB,QAAQ,CAAC,MAAM;MAC/B,IAAIe,IAAI,CAACG,KAAK,EAAEK,KAAK,EAAE;QACrBC,OAAO,CAACC,GAAG,CAAC,WAAW,EAAEV,IAAI,CAACG,KAAK;QACnCM,OAAO,CAACC,GAAG,CAAC,QAAQ,EAAC,GAAGnB,UAAU,CAACoB,QAAQ,GAAGX,IAAI,CAACG,KAAK,CAACK,KAAK,EAAE;QAChE;QACA,OAAO,GAAGjB,UAAU,CAACoB,QAAQ,GAAGX,IAAI,CAACG,KAAK,CAACK,KAAK,EAAE;MACpD;MACA;MACA,OAAOlB,aAAa;IACtB,CAAC,CAAC;;IAEF;IACA,MAAMsB,MAAK,GAAIA,CAAA,KAAM;