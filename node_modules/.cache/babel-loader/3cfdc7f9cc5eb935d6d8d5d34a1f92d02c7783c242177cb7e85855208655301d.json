{"ast":null,"code":"import { computed, ref } from 'vue';\nimport { useStore } from 'vuex';\nimport defaultAvatar from '@/assets/default-avatar.png';\nimport defaultqrcode from '@/assets/logo.png';\nimport QRCode from 'qrcode';\nexport default {\n  name: 'UserDetail',\n  setup() {\n    const store = useStore();\n    const user = computed(() => store.state.user);\n    const editableUser = ref({\n      ...user.value\n    });\n    const qrcodeUrl = ref(defaultqrcode);\n\n    // 更新头像\n    const updateAvatar = e => {\n      const file = e.target.files[0];\n      if (file) {\n        const reader = new FileReader();\n        reader.onload = e => {\n          editableUser.value.photo = e.target.result;\n        };\n        reader.readAsDataURL(file);\n      }\n    };\n\n    // 生成彩色二维码\n    const generateQrcode = async () => {\n      try {\n        const content = JSON.stringify({\n          name: editableUser.value.username,\n          phone: editableUser.value.phone,\n          email: editableUser.value.email\n        });\n        const qrCanvas = document.createElement('canvas');\n        await QRCode.toCanvas(qrCanvas, content, {\n          width: 200,\n          errorCorrectionLevel: 'H',\n          color: {\n            dark: '#E91E63',\n            // 粉色\n            light: '#FFFFFF' // 白色背景\n          }\n        });\n\n        // 添加头像\n        if (editableUser.value.photo) {\n          const ctx = qrCanvas.getContext('2d');\n          const avatarImg = new Image();\n          avatarImg.src = editableUser.value.photo;\n          await new Promise(resolve => avatarImg.onload = resolve);\n          ctx.beginPath();\n          ctx.arc(100, 100, 20, 0, 2 * Math.PI);\n          ctx.clip();\n          ctx.drawImage(avatarImg, 80, 80, 40, 40);\n        }\n        qrcodeUrl.value = qrCanvas.toDataURL();\n      } catch (error) {\n        console.error(\"生成二维码失败:\", error);\n      }\n    };\n\n    // 保存信息\n    const saveUserInfo = async () => {\n      try {\n        await store.dispatch('updateUser', editableUser.value);\n        alert('信息保存成功！');\n      } catch (error) {\n        console.error(\"保存失败:\", error);\n        alert('保存失败，请重试');\n      }\n    };\n    return {\n      editableUser,\n      qrcodeUrl,\n      defaultAvatar,\n      defaultqrcode,\n      updateAvatar,\n      generateQrcode,\n      saveUserInfo\n    };\n  }\n};","map":{"version":3,"names":["computed","ref","useStore","defaultAvatar","defaultqrcode","QRCode","name","setup","store","user","state","editableUser","value","qrcodeUrl","updateAvatar","e","file","target","files","reader","FileReader","onload","photo","result","readAsDataURL","generateQrcode","content","JSON","stringify","username","phone","email","qrCanvas","document","createElement","toCanvas","width","errorCorrectionLevel","color","dark","light","ctx","getContext","avatarImg","Image","src","Promise","resolve","beginPath","arc","Math","PI","clip","drawImage","toDataURL","error","console","saveUserInfo","dispatch","alert"],"sources":["E:\\vue_learn\\ai_vue\\ai_vue\\src\\views\\UserDetail.vue"],"sourcesContent":["<template>\r\n    <div class=\"user-detail-page\">\r\n      <h1>用户详情</h1>\r\n      <div class=\"user-detail-container\">\r\n        <div class=\"info-section\">\r\n          <!-- 可编辑头像 -->\r\n          <div class=\"avatar-section\">\r\n            <label class=\"avatar-upload\">\r\n              <input type=\"file\" accept=\"image/*\" @change=\"updateAvatar\" hidden />\r\n              <img :src=\"editableUser.photo || defaultAvatar\" alt=\"头像\" class=\"avatar\" />\r\n              <span class=\"edit-icon\">✎</span>\r\n            </label>\r\n          </div>\r\n  \r\n          <!-- 用户信息 -->\r\n          <div class=\"info-item\">\r\n            <label>名字：</label>\r\n            <input v-model=\"editableUser.username\" placeholder=\"未设置\" />\r\n          </div>\r\n          \r\n          <div class=\"info-item\">\r\n            <label>性别：</label>\r\n            <select v-model=\"editableUser.sex\">\r\n              <option value=\"未设置\">未设置</option>\r\n              <option value=\"男\">男</option>\r\n              <option value=\"女\">女</option>\r\n            </select>\r\n          </div>\r\n  \r\n          <div class=\"info-item\">\r\n            <label>手机号：</label>\r\n            <input v-model=\"editableUser.phone\" placeholder=\"未设置\" />\r\n          </div>\r\n  \r\n          <div class=\"info-item\">\r\n            <label>邮箱：</label>\r\n            <input v-model=\"editableUser.email\" placeholder=\"未设置\" />\r\n          </div>\r\n  \r\n          <div class=\"info-item\">\r\n            <label>描述：</label>\r\n            <input v-model=\"editableUser.description\" placeholder=\"未设置\" />\r\n          </div>\r\n  \r\n          <!-- 二维码区域 -->\r\n          <div class=\"qr-code-section\">\r\n            <div class=\"qr-code-display\">\r\n              <h2>我的二维码：</h2>\r\n              <div class=\"qr-code-container\" @click=\"generateQrcode\">\r\n                <img :src=\"qrcodeUrl || defaultqrcode\" alt=\"二维码\" class=\"qr-code\" />\r\n              </div>\r\n            </div>\r\n          </div>\r\n  \r\n          <button @click=\"saveUserInfo\" class=\"save-button\">保存信息</button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import { computed, ref } from 'vue'\r\n  import { useStore } from 'vuex'\r\n  import defaultAvatar from '@/assets/default-avatar.png'\r\n  import defaultqrcode from '@/assets/logo.png'\r\n  import QRCode from 'qrcode'\r\n  \r\n  export default {\r\n    name: 'UserDetail',\r\n    setup() {\r\n      const store = useStore()\r\n      const user = computed(() => store.state.user)\r\n      const editableUser = ref({ ...user.value })\r\n      const qrcodeUrl = ref(defaultqrcode)\r\n  \r\n      // 更新头像\r\n      const updateAvatar = (e) => {\r\n        const file = e.target.files[0]\r\n        if (file) {\r\n          const reader = new FileReader()\r\n          reader.onload = (e) => {\r\n            editableUser.value.photo = e.target.result\r\n          }\r\n          reader.readAsDataURL(file)\r\n        }\r\n      }\r\n  \r\n      // 生成彩色二维码\r\n      const generateQrcode = async () => {\r\n        try {\r\n          const content = JSON.stringify({\r\n            name: editableUser.value.username,\r\n            phone: editableUser.value.phone,\r\n            email: editableUser.value.email\r\n          })\r\n  \r\n          const qrCanvas = document.createElement('canvas')\r\n          await QRCode.toCanvas(qrCanvas, content, {\r\n            width: 200,\r\n            errorCorrectionLevel: 'H',\r\n            color: {\r\n              dark: '#E91E63', // 粉色\r\n              light: '#FFFFFF' // 白色背景\r\n            }\r\n          })\r\n  \r\n          // 添加头像\r\n          if (editableUser.value.photo) {\r\n            const ctx = qrCanvas.getContext('2d')\r\n            const avatarImg = new Image()\r\n            avatarImg.src = editableUser.value.photo\r\n            await new Promise(resolve => (avatarImg.onload = resolve))\r\n            \r\n            ctx.beginPath()\r\n            ctx.arc(100, 100, 20, 0, 2 * Math.PI)\r\n            ctx.clip()\r\n            ctx.drawImage(avatarImg, 80, 80, 40, 40)\r\n          }\r\n  \r\n          qrcodeUrl.value = qrCanvas.toDataURL()\r\n        } catch (error) {\r\n          console.error(\"生成二维码失败:\", error)\r\n        }\r\n      }\r\n  \r\n      // 保存信息\r\n      const saveUserInfo = async () => {\r\n        try {\r\n          await store.dispatch('updateUser', editableUser.value)\r\n          alert('信息保存成功！')\r\n        } catch (error) {\r\n          console.error(\"保存失败:\", error)\r\n          alert('保存失败，请重试')\r\n        }\r\n      }\r\n  \r\n      return {\r\n        editableUser,\r\n        qrcodeUrl,\r\n        defaultAvatar,\r\n        defaultqrcode,\r\n        updateAvatar,\r\n        generateQrcode,\r\n        saveUserInfo\r\n      }\r\n    }\r\n  }\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .user-detail-page {\r\n    max-width: 600px;\r\n    margin: 20px auto;\r\n    padding: 20px;\r\n  }\r\n  \r\n  .avatar-upload {\r\n    position: relative;\r\n    cursor: pointer;\r\n    display: inline-block;\r\n  }\r\n  \r\n  .avatar {\r\n    width: 100px;\r\n    height: 100px;\r\n    border-radius: 50%;\r\n    border: 3px solid #E91E63;\r\n    transition: 0.3s;\r\n  }\r\n  \r\n  .edit-icon {\r\n    position: absolute;\r\n    bottom: 5px;\r\n    right: 5px;\r\n    background: white;\r\n    padding: 5px;\r\n    border-radius: 50%;\r\n    box-shadow: 0 2px 5px rgba(0,0,0,0.2);\r\n  }\r\n  \r\n  .info-item {\r\n    display: flex;\r\n    align-items: center;\r\n    margin: 10px 0;\r\n    width: 100%;\r\n  }\r\n  \r\n  .info-item label {\r\n    width: 80px;\r\n    font-weight: bold;\r\n    color: #607D8B;\r\n  }\r\n  \r\n  input, select {\r\n    flex: 1;\r\n    padding: 8px 12px;\r\n    border: 1px solid #BDBDBD;\r\n    border-radius: 4px;\r\n    font-size: 14px;\r\n  }\r\n  \r\n  select {\r\n    background: white;\r\n    cursor: pointer;\r\n  }\r\n  \r\n  .qr-code-display {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 15px;\r\n    margin-top: 25px;\r\n  }\r\n  \r\n  .qr-code-display h2 {\r\n    color: #E91E63;\r\n    margin: 0;\r\n    font-size: 18px;\r\n  }\r\n  \r\n  .qr-code {\r\n    width: 120px;\r\n    height: 120px;\r\n    border: 2px solid #E91E63;\r\n    border-radius: 8px;\r\n    padding: 5px;\r\n    background: white;\r\n  }\r\n  \r\n  .save-button {\r\n    width: 100%;\r\n    padding: 12px;\r\n    background: #E91E63;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 4px;\r\n    margin-top: 25px;\r\n    cursor: pointer;\r\n    transition: 0.3s;\r\n  }\r\n  \r\n  .save-button:hover {\r\n    background: #C2185B;\r\n  }\r\n  \r\n  @media (max-width: 480px) {\r\n    .user-detail-page {\r\n      padding: 15px;\r\n    }\r\n    \r\n    .qr-code-display {\r\n      flex-direction: column;\r\n      align-items: flex-start;\r\n    }\r\n  }\r\n  </style>"],"mappings":"AA6DE,SAASA,QAAQ,EAAEC,GAAE,QAAS,KAAI;AAClC,SAASC,QAAO,QAAS,MAAK;AAC9B,OAAOC,aAAY,MAAO,6BAA4B;AACtD,OAAOC,aAAY,MAAO,mBAAkB;AAC5C,OAAOC,MAAK,MAAO,QAAO;AAE1B,eAAe;EACbC,IAAI,EAAE,YAAY;EAClBC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIN,QAAQ,CAAC;IACvB,MAAMO,IAAG,GAAIT,QAAQ,CAAC,MAAMQ,KAAK,CAACE,KAAK,CAACD,IAAI;IAC5C,MAAME,YAAW,GAAIV,GAAG,CAAC;MAAE,GAAGQ,IAAI,CAACG;IAAM,CAAC;IAC1C,MAAMC,SAAQ,GAAIZ,GAAG,CAACG,aAAa;;IAEnC;IACA,MAAMU,YAAW,GAAKC,CAAC,IAAK;MAC1B,MAAMC,IAAG,GAAID,CAAC,CAACE,MAAM,CAACC,KAAK,CAAC,CAAC;MAC7B,IAAIF,IAAI,EAAE;QACR,MAAMG,MAAK,GAAI,IAAIC,UAAU,CAAC;QAC9BD,MAAM,CAACE,MAAK,GAAKN,CAAC,IAAK;UACrBJ,YAAY,CAACC,KAAK,CAACU,KAAI,GAAIP,CAAC,CAACE,MAAM,CAACM,MAAK;QAC3C;QACAJ,MAAM,CAACK,aAAa,CAACR,IAAI;MAC3B;IACF;;IAEA;IACA,MAAMS,cAAa,GAAI,MAAAA,CAAA,KAAY;MACjC,IAAI;QACF,MAAMC,OAAM,GAAIC,IAAI,CAACC,SAAS,CAAC;UAC7BtB,IAAI,EAAEK,YAAY,CAACC,KAAK,CAACiB,QAAQ;UACjCC,KAAK,EAAEnB,YAAY,CAACC,KAAK,CAACkB,KAAK;UAC/BC,KAAK,EAAEpB,YAAY,CAACC,KAAK,CAACmB;QAC5B,CAAC;QAED,MAAMC,QAAO,GAAIC,QAAQ,CAACC,aAAa,CAAC,QAAQ;QAChD,MAAM7B,MAAM,CAAC8B,QAAQ,CAACH,QAAQ,EAAEN,OAAO,EAAE;UACvCU,KAAK,EAAE,GAAG;UACVC,oBAAoB,EAAE,GAAG;UACzBC,KAAK,EAAE;YACLC,IAAI,EAAE,SAAS;YAAE;YACjBC,KAAK,EAAE,SAAQ,CAAE;UACnB;QACF,CAAC;;QAED;QACA,IAAI7B,YAAY,CAACC,KAAK,CAACU,KAAK,EAAE;UAC5B,MAAMmB,GAAE,GAAIT,QAAQ,CAACU,UAAU,CAAC,IAAI;UACpC,MAAMC,SAAQ,GAAI,IAAIC,KAAK,CAAC;UAC5BD,SAAS,CAACE,GAAE,GAAIlC,YAAY,CAACC,KAAK,CAACU,KAAI;UACvC,MAAM,IAAIwB,OAAO,CAACC,OAAM,IAAMJ,SAAS,CAACtB,MAAK,GAAI0B,OAAQ;UAEzDN,GAAG,CAACO,SAAS,CAAC;UACdP,GAAG,CAACQ,GAAG,CAAC,GAAG,EAAE,GAAG,EAAE,EAAE,EAAE,CAAC,EAAE,IAAIC,IAAI,CAACC,EAAE;UACpCV,GAAG,CAACW,IAAI,CAAC;UACTX,GAAG,CAACY,SAAS,CAACV,SAAS,EAAE,EAAE,EAAE,EAAE,EAAE,EAAE,EAAE,EAAE;QACzC;QAEA9B,SAAS,CAACD,KAAI,GAAIoB,QAAQ,CAACsB,SAAS,CAAC;MACvC,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,UAAU,EAAEA,KAAK;MACjC;IACF;;IAEA;IACA,MAAME,YAAW,GAAI,MAAAA,CAAA,KAAY;MAC/B,IAAI;QACF,MAAMjD,KAAK,CAACkD,QAAQ,CAAC,YAAY,EAAE/C,YAAY,CAACC,KAAK;QACrD+C,KAAK,CAAC,SAAS;MACjB,EAAE,OAAOJ,KAAK,