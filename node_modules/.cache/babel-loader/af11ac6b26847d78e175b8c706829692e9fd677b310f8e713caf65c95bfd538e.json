{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { computed, ref, onMounted } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nimport defaultAvatar from '@/assets/default-avatar.png';\nimport { API_CONFIG } from '@/config/config';\nimport axios from 'axios';\nimport { ElMessage } from 'element-plus';\nexport default {\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const isUserInfoOpen = ref(false);\n    const user = computed(() => store.state.user);\n    const displayName = computed(() => user.value?.username || '未登录');\n\n    // 搜索相关状态\n    const isSearchOpen = ref(false);\n    const searchKeyword = ref('');\n    const searchResults = ref([]);\n    const isSearching = ref(false);\n    const avatarUrl = computed(() => {\n      if (user.value?.photo) {\n        return `${API_CONFIG.BASE_URL}${user.value.photo}`;\n      }\n      return defaultAvatar;\n    });\n    const logout = () => {\n      store.dispatch('logout');\n      router.push('/login');\n    };\n    const goToUserDetail = () => {\n      router.push('/user/userinfo/' + user.value?.id);\n    };\n    const toggleUserInfo = () => {\n      isUserInfoOpen.value = !isUserInfoOpen.value;\n    };\n\n    // 搜索相关方法\n    const toggleSearch = () => {\n      isSearchOpen.value = !isSearchOpen.value;\n\n      // 关闭搜索时清空结果\n      if (!isSearchOpen.value) {\n        searchKeyword.value = '';\n        searchResults.value = [];\n      }\n    };\n    const searchUsers = async () => {\n      if (!searchKeyword.value.trim()) {\n        ElMessage.warning('请输入搜索关键词');\n        return;\n      }\n      isSearching.value = true;\n      try {\n        // 调用搜索API\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/user/search`, {\n          params: {\n            keyword: searchKeyword.value.trim()\n          },\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        });\n\n        // 处理分页数据，提取data字段\n        searchResults.value = response.data.data || [];\n      } catch (error) {\n        console.error('搜索用户失败:', error);\n        ElMessage.error('搜索用户失败');\n      } finally {\n        isSearching.value = false;\n      }\n    };\n\n    // 开始聊天方法\n    const startChat = user => {\n      ElMessage.success(`开始与 ${user.username} 聊天`);\n\n      // 关闭搜索框\n      isSearchOpen.value = false;\n      searchKeyword.value = '';\n      searchResults.value = [];\n\n      // 跳转到聊天页面\n      router.push({\n        name: 'Chat',\n        params: {\n          userId: user.id\n        }\n      });\n    };\n    return {\n      user,\n      displayName,\n      avatarUrl,\n      logout,\n      goToUserDetail,\n      isUserInfoOpen,\n      toggleUserInfo,\n      isSearchOpen,\n      searchKeyword,\n      searchResults,\n      isSearching,\n      toggleSearch,\n      searchUsers,\n      startChat,\n      defaultAvatar,\n      API_CONFIG\n    };\n  }\n};","map":{"version":3,"names":["computed","ref","onMounted","useStore","useRouter","defaultAvatar","API_CONFIG","axios","ElMessage","setup","store","router","isUserInfoOpen","user","state","displayName","value","username","isSearchOpen","searchKeyword","searchResults","isSearching","avatarUrl","photo","BASE_URL","logout","dispatch","push","goToUserDetail","id","toggleUserInfo","toggleSearch","searchUsers","trim","warning","response","get","params","keyword","headers","Authorization","token","data","error","console","startChat","success","name","userId"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\views\\UserLayout.vue"],"sourcesContent":["<template>\r\n  <div class=\"user-page\">\r\n    <header class=\"header\">\r\n      <div class=\"header-left\">\r\n        <div class=\"user-info\" @click=\"goToUserDetail\">\r\n          <img :src=\"avatarUrl\" alt=\"用户头像\" class=\"avatar\" />\r\n          <span class=\"username\">{{ displayName }}</span>\r\n        </div>\r\n      </div>\r\n      \r\n      <div class=\"header-right\">\r\n        <button @click=\"logout\" class=\"logout-button\">退出登录</button>\r\n      </div>\r\n    </header>\r\n\r\n    <div class=\"main-layout\">\r\n      <aside class=\"sidebar\">\r\n        <!-- 搜索组件 -->\r\n        <div class=\"sidebar-search\">\r\n          <div class=\"search-toggle\" @click=\"toggleSearch\">\r\n            <i class=\"fa fa-search\" aria-hidden=\"true\"></i>\r\n            <span>搜索用户</span>\r\n          </div>\r\n          \r\n          <div v-if=\"isSearchOpen\" class=\"search-box\">\r\n            <div class=\"search-input-group\">\r\n              <input \r\n                type=\"text\" \r\n                v-model=\"searchKeyword\" \r\n                placeholder=\"搜索用户...\" \r\n                @keyup.enter=\"searchUsers\"\r\n              />\r\n              <button class=\"search-button\" @click=\"searchUsers\">\r\n                <i class=\"fa fa-search\" aria-hidden=\"true\"></i>\r\n              </button>\r\n              <button class=\"cancel-button\" @click=\"toggleSearch\">\r\n                取消\r\n              </button>\r\n            </div>\r\n            \r\n            <!-- 搜索结果列表 -->\r\n            <div v-if=\"isSearching\" class=\"search-loading\">\r\n              <i class=\"fa fa-spinner fa-spin\" aria-hidden=\"true\"></i> 搜索中...\r\n            </div>\r\n            \r\n            <div v-else-if=\"searchResults.length > 0\" class=\"search-results\">\r\n              <div \r\n                v-for=\"user in searchResults\" \r\n                :key=\"user.id\" \r\n                class=\"search-result-item\"\r\n                @click=\"startChat(user)\"\r\n              >\r\n                <div class=\"result-avatar-container\">\r\n                  <img \r\n                    :src=\"user.photo ? `${API_CONFIG.BASE_URL}${user.photo}` : defaultAvatar\" \r\n                    alt=\"用户头像\" \r\n                    class=\"result-avatar\"\r\n                  />\r\n                </div>\r\n                <div class=\"result-info\">\r\n                  <div class=\"result-name\">{{ user.username }}</div>\r\n                  <div class=\"result-phone\">{{ user.phone }}</div>\r\n                </div>\r\n                <div class=\"result-action\">\r\n                  <button class=\"chat-button\">\r\n                    <i class=\"fa fa-comment-o\" aria-hidden=\"true\"></i> 聊天\r\n                  </button>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            \r\n            <div v-else-if=\"searchKeyword && !isSearching\" class=\"no-results\">\r\n              没有找到匹配的用户\r\n            </div>\r\n          </div>\r\n        </div>\r\n        \r\n        <!-- 菜单 -->\r\n        <ul class=\"menu\">\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/user/dashboard\" class=\"menu-link\">仪表盘</router-link>\r\n          </li>\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/user-moment\" class=\"menu-link\">我相关</router-link>\r\n          </li>\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/moments\" class=\"menu-link\">朋友圈</router-link>\r\n          </li>\r\n          <li class=\"menu-item\">\r\n            <div @click=\"toggleUserInfo\" class=\"menu-title\">\r\n              用户信息\r\n              <span class=\"arrow\">{{ isUserInfoOpen ? '▼' : '▶' }}</span>\r\n            </div>\r\n            <ul v-if=\"isUserInfoOpen\" class=\"sub-menu\">\r\n              <li class=\"sub-menu-item\">\r\n                <router-link to=\"/user/userinfo/userlist\" class=\"sub-menu-link\">用户列表</router-link>\r\n              </li>\r\n              <li class=\"sub-menu-item2\">\r\n                <router-link to=\"/user/bigdatauser\" class=\"sub-menu-link\">大数据用户</router-link>\r\n              </li>\r\n            </ul>\r\n          </li>\r\n        </ul>\r\n      </aside>\r\n\r\n      <main class=\"main-content\">\r\n        <router-view />\r\n      </main>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { computed, ref, onMounted } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { useRouter } from 'vue-router';\r\nimport defaultAvatar from '@/assets/default-avatar.png';\r\nimport { API_CONFIG } from '@/config/config';\r\nimport axios from 'axios';\r\nimport { ElMessage } from 'element-plus';\r\n\r\nexport default {\r\n  setup() {\r\n    const store = useStore();\r\n    const router = useRouter();\r\n    const isUserInfoOpen = ref(false);\r\n    const user = computed(() => store.state.user);\r\n    const displayName = computed(() => user.value?.username || '未登录');\r\n    \r\n    // 搜索相关状态\r\n    const isSearchOpen = ref(false);\r\n    const searchKeyword = ref('');\r\n    const searchResults = ref([]);\r\n    const isSearching = ref(false);\r\n    \r\n    const avatarUrl = computed(() => {\r\n      if (user.value?.photo) {\r\n        return `${API_CONFIG.BASE_URL}${user.value.photo}`;\r\n      }\r\n      return defaultAvatar;\r\n    });\r\n\r\n    const logout = () => {\r\n      store.dispatch('logout');\r\n      router.push('/login');\r\n    };\r\n\r\n    const goToUserDetail = () => {\r\n      router.push('/user/userinfo/' + user.value?.id);\r\n    };\r\n\r\n    const toggleUserInfo = () => {\r\n      isUserInfoOpen.value = !isUserInfoOpen.value;\r\n    };\r\n    \r\n    // 搜索相关方法\r\n    const toggleSearch = () => {\r\n      isSearchOpen.value = !isSearchOpen.value;\r\n      \r\n      // 关闭搜索时清空结果\r\n      if (!isSearchOpen.value) {\r\n        searchKeyword.value = '';\r\n        searchResults.value = [];\r\n      }\r\n    };\r\n    \r\n    const searchUsers = async () => {\r\n      if (!searchKeyword.value.trim()) {\r\n        ElMessage.warning('请输入搜索关键词');\r\n        return;\r\n      }\r\n      \r\n      isSearching.value = true;\r\n      \r\n      try {\r\n        // 调用搜索API\r\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/user/search`, {\r\n          params: {\r\n            keyword: searchKeyword.value.trim()\r\n          },\r\n          headers: { Authorization: `Bearer ${store.state.token}` }\r\n        });\r\n        \r\n        // 处理分页数据，提取data字段\r\n        searchResults.value = response.data.data || [];\r\n      } catch (error) {\r\n        console.error('搜索用户失败:', error);\r\n        ElMessage.error('搜索用户失败');\r\n      } finally {\r\n        isSearching.value = false;\r\n      }\r\n    };\r\n    \r\n    // 开始聊天方法\r\n    const startChat = (user) => {\r\n      ElMessage.success(`开始与 ${user.username} 聊天`);\r\n      \r\n      // 关闭搜索框\r\n      isSearchOpen.value = false;\r\n      searchKeyword.value = '';\r\n      searchResults.value = [];\r\n      \r\n      // 跳转到聊天页面\r\n      router.push({\r\n        name: 'Chat',\r\n        params: { userId: user.id }\r\n      });\r\n    };\r\n\r\n    return {\r\n      user,\r\n      displayName,\r\n      avatarUrl,\r\n      logout,\r\n      goToUserDetail,\r\n      isUserInfoOpen,\r\n      toggleUserInfo,\r\n      isSearchOpen,\r\n      searchKeyword,\r\n      searchResults,\r\n      isSearching,\r\n      toggleSearch,\r\n      searchUsers,\r\n      startChat,\r\n      defaultAvatar,\r\n      API_CONFIG\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* 保持原有样式，新增和修改以下样式 */\r\n\r\n/* 侧边栏搜索区域 */\r\n.sidebar-search {\r\n  padding: 15px 20px;\r\n  border-bottom: 1px solid #002140;\r\n}\r\n\r\n.search-toggle {\r\n  cursor: pointer;\r\n  display: flex;\r\n  align-items: center;\r\n  font-size: 14px;\r\n  padding: 10px 0;\r\n}\r\n\r\n.search-toggle i {\r\n  margin-right: 10px;\r\n}\r\n\r\n.search-box {\r\n  margin-top: 10px;\r\n  background-color: #002140;\r\n  border-radius: 4px;\r\n  padding: 10px;\r\n}\r\n\r\n.search-input-group {\r\n  display: flex;\r\n  align-items: center;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.search-input-group input {\r\n  flex: 1;\r\n  padding: 8px;\r\n  border: 1px solid #003a75;\r\n  border-radius: 4px 0 0 4px;\r\n  outline: none;\r\n  background-color: #003a75;\r\n  color: white;\r\n}\r\n\r\n.search-input-group input::placeholder {\r\n  color: #8c8c8c;\r\n}\r\n\r\n.search-button, .cancel-button {\r\n  padding: 8px 12px;\r\n  background-color: #1890ff;\r\n  color: white;\r\n  border: none;\r\n  cursor: pointer;\r\n}\r\n\r\n.search-button {\r\n  border-radius: 0 4px 4px 0;\r\n}\r\n\r\n.cancel-button {\r\n  margin-left: 5px;\r\n  border-radius: 4px;\r\n  background-color: #f5222d;\r\n}\r\n\r\n.search-loading, .no-results {\r\n  padding: 10px;\r\n  text-align: center;\r\n  color: #8c8c8c;\r\n}\r\n\r\n/* 搜索结果列表 */\r\n.search-results {\r\n  max-height: 300px;\r\n  overflow-y: auto;\r\n}\r\n\r\n.search-result-item {\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 10px;\r\n  border-bottom: 1px solid #003a75;\r\n  cursor: pointer;\r\n  transition: background-color 0.2s;\r\n}\r\n\r\n.search-result-item:hover {\r\n  background-color: #003a75;\r\n}\r\n\r\n.result-avatar-container {\r\n  width: 40px;\r\n  height: 40px;\r\n  margin-right: 10px;\r\n  position: relative;\r\n}\r\n\r\n.result-avatar {\r\n  width: 100%;\r\n  height: 100%;\r\n  border-radius: 50%;\r\n  object-fit: cover;\r\n}\r\n\r\n.result-info {\r\n  flex: 1;\r\n  min-width: 0;\r\n}\r\n\r\n.result-name {\r\n  font-weight: bold;\r\n  color: white;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.result-phone {\r\n  font-size: 12px;\r\n  color: #8c8c8c;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n}\r\n\r\n.result-action {\r\n  margin-left: 10px;\r\n}\r\n\r\n.chat-button {\r\n  background-color: #1890ff;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 4px;\r\n  padding: 5px 10px;\r\n  cursor: pointer;\r\n  font-size: 12px;\r\n  transition: background-color 0.2s;\r\n}\r\n\r\n.chat-button:hover {\r\n  background-color: #40a9ff;\r\n}\r\n</style>"],"mappings":";AAiHA,SAASA,QAAQ,EAAEC,GAAG,EAAEC,SAAQ,QAAS,KAAK;AAC9C,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,SAAQ,QAAS,YAAY;AACtC,OAAOC,aAAY,MAAO,6BAA6B;AACvD,SAASC,UAAS,QAA