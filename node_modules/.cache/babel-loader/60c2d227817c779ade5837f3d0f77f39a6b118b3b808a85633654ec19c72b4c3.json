entVNode(\"img\", {\n    src: $setup.getFullUrl($setup.currentUser.photo) || $setup.defaultAvatar,\n    class: \"sidebar-avatar\"\n  }, null, 8 /* PROPS */, _hoisted_3), _createElementVNode(\"span\", _hoisted_4, _toDisplayString($setup.currentUser.username), 1 /* TEXT */)])]), _createCommentVNode(\" 头部容器 \"), _cache[4] || (_cache[4] = _createElementVNode(\"div\", {\n    class: \"moments-header\"\n  }, [_createElementVNode(\"div\", {\n    class: \"header-content\"\n  }, [_createElementVNode(\"div\", {\n    class: \"title-container\"\n  }, [_createElementVNode(\"h1\", null, \"朋友圈\")])])], -1 /* HOISTED */)), _createCommentVNode(\" 发布按钮 \"), _createElementVNode(\"button\", {\n    class: \"publish-btn\",\n    onClick: _cache[1] || (_cache[1] = (...args) => $setup.goToPublish && $setup.goToPublish(...args))\n  }, \"+\"), _createCommentVNode(\" 动态内容容器 \"), _createElementVNode(\"div\", _hoisted_5, [_createElementVNode(\"div\", _hoisted_6, [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList($setup.moments, moment => {\n    return _openBlock(), _createElementBlock(\"div\", {\n      key: moment.id,\n      class: \"moment-item\",\n      onClick: $event => $setup.goToMomentDetail(moment.id)\n    }, [_createCommentVNode(\" 用户信息 \"), _createElementVNode(\"div\", _hoisted_8, [_createElementVNode(\"img\", {\n      src: $setup.getFullUrl(moment.user.photo) || $setup.defaultAvatar,\n      class: \"user-avatar\"\n    }, null, 8 /* PROPS */, _hoisted_9), _createElementVNode(\"div\", _hoisted_10, [_createElementVNode(\"span\", _hoisted_11, _toDisplayString(moment.user.username), 1 /* TEXT */), _createElementVNode(\"span\", _hoisted_12, _toDisplayString($setup.formatTime(moment.created_at)), 1 /* TEXT */)])]), _createCommentVNode(\" 动态内容 \"), _createElementVNode(\"div\", {\n      class: \"moment-content\",\n      innerHTML: $setup.sanitizeHtml(moment.content)\n    }, null, 8 /* PROPS */, _hoisted_13), _createCommentVNode(\" 媒体内容 \"), moment.media?.length ? (_openBlock(), _createElementBlock(\"div\", _hoisted_14, [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList(moment.media, (media, index) => {\n      return _openBlock(), _createElementBlock(\"div\", {\n        key: index,\n        class: _normalizeClass([\"media-item\", {\n          'video-container': media.type === 'video'\n        }])\n      }, [media.type === 'image' ? (_openBlock(), _createElementBlock(\"img\", {\n        key: 0,\n        src: $setup.getFullUrl(media.url),\n        onClick: _withModifiers($event => _ctx.openImagePreview($setup.getFullUrl(media.url)), [\"stop\"])\n      }, null, 8 /* PROPS */, _hoisted_15)) : media.type === 'video' ? (_openBlock(), _createElementBlock(\"video\", {\n        key: 1,\n        src: $setup.getFullUrl(media.url),\n        controls: \"\",\n        poster: $setup.getFullUrl(media.thumbnail)\n      }, [_createElementVNode(\"source\", {\n        src: $setup.getFullUrl(media.url),\n        type: _ctx.getVideoType(media.url)\n      }, null, 8 /* PROPS */, _hoisted_17), _cache[2] || (_cache[2] = _createTextVNode(\" 您的浏览器不支持视频播放 \"))], 8 /* PROPS */, _hoisted_16)) : _createCommentVNode(\"v-if\", true)], 2 /* CLASS */);\n    }), 128 /* KEYED_FRAGMENT */))])) : _createCommentVNode(\"v-if\", true), _createCommentVNode(\" 互动区域 \"), _createElementVNode(\"div\", _hoisted_18, [_createElementVNode(\"div\", {\n      class: \"like-container flex items-center space-x-1 cursor-pointer\",\n      onClick: _withModifiers($event => $setup.handleLikeMoment(moment.id), [\"stop\"])\n    }, [_createElementVNode(\"i\", {\n      class: _normalizeClass([\"fa-solid fa-thumbs-up\", {\n        'liked': moment.isLiked\n      }])\n    }, null, 2 /* CLASS */), _createElementVNode(\"span\", null, _toDisplayString(moment.stats.likes), 1 /* TEXT */)], 8 /* PROPS */, _hoisted_19), _createElementVNode(\"div\", {\n      class: \"comment-container flex items-center space-x-1 cursor-pointer\",\n      onClick: _withModifiers($event => $setup.goToMomentDetail(moment.id), [\"stop\"])\n    }, [_cache[3] || (_cache[3] = _createElementVNode(\"i\", {\n      class: \"fa-solid fa-comment\"\n    }, null, -1 /* HOISTED */)), _createElementVNode(\"span\", null, _toDisplayString(moment.stats.comments), 1 /* TEXT */)], 8 /* PROPS */, _hoisted_20)]), _createCommentVNode(\" 底部信息 \"), _createElementVNode(\"div\", _hoisted_21, [moment.user_id === $setup.currentUser.id ? (_openBlock(), _createElementBlock(\"i\", {\n      key: 0,\n      class: \"fa-solid fa-trash-can delete-btn cursor-pointer hover:text-red-500\",\n      onClick: _withModifiers($event => $setup.deleteMoment(moment.id), [\"stop\"])\n    }, null, 8 /* PROPS */, _hoisted_22)) : _createCommentVNode(\"v-if\", true), _createElementVNode(\"span\", _hoisted_23, _toDisplayString($setup.getTimeAgo(moment.created_at)), 1 /* TEXT */)])], 8 /* PROPS */, _hoisted_7);\n  }), 128 /* KEYED_FRAGMENT */))]), $setup.noMore ? (_openBlock(), _createElementBlock(\"div\", _hoisted_24, \" 没有更多动态了 \")) : _createCommentVNode(\"v-if\", true)])]);\n}","map":{"version":3,"names":["class","key","_createElementBlock","_hoisted_1","_createCommentVNode","_createElementVNode","_hoisted_2","onClick","_cache","args","$setup","goToUser","src","getFullUrl","currentUser","photo","defaultAvatar","_hoisted_3","_hoisted_4","_toDisplayString","username","goToPublish","_hoisted_5","_hoisted_6","_Fragment","_renderList","moments","moment","id","$event","goToMomentDetail","_hoisted_8","user","_hoisted_9","_hoisted_10","_hoisted_11","_hoisted_12","formatTime","created_at","innerHTML","sanitizeHtml","content","_hoisted_13","media","length","_hoisted_14","index","_normalizeClass","type","url","_withModifiers","_ctx","openImagePreview","_hoisted_15","controls","poster","thumbnail","getVideoType","_hoisted_17","_createTextVNode","_hoisted_16","_hoisted_18","handleLikeMoment","isLiked","stats","likes","_hoisted_19","comments","_hoisted_20","_hoisted_21","user_id","deleteMoment","_hoisted_22","_hoisted_23","getTimeAgo","_hoisted_7","noMore","_hoisted_24"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\article\\UserMoments_2.vue"],"sourcesContent":["<template>\r\n  <div class=\"moments-page\">\r\n    <!-- 左侧用户信息栏 -->\r\n    <div class=\"user-sidebar\">\r\n      <div class=\"user-profile\" @click=\"goToUser\">\r\n        <img\r\n          :src=\"getFullUrl(currentUser.photo) || defaultAvatar\"\r\n          class=\"sidebar-avatar\"\r\n        />\r\n        <span class=\"sidebar-username\">{{ currentUser.username }}</span>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 头部容器 -->\r\n    <div class=\"moments-header\">\r\n      <div class=\"header-content\">\r\n        <div class=\"title-container\">\r\n          <h1>朋友圈</h1>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 发布按钮 -->\r\n    <button class=\"publish-btn\" @click=\"goToPublish\">+</button>\r\n\r\n    <!-- 动态内容容器 -->\r\n    <div class=\"moments-container\">\r\n      <div class=\"moments-list\">\r\n        <div\r\n          v-for=\"moment in moments\"\r\n          :key=\"moment.id\"\r\n          class=\"moment-item\"\r\n          @click=\"goToMomentDetail(moment.id)\"\r\n        >\r\n          <!-- 用户信息 -->\r\n          <div class=\"user-info\">\r\n            <img\r\n              :src=\"getFullUrl(moment.user.photo) || defaultAvatar\"\r\n              class=\"user-avatar\"\r\n            />\r\n            <div class=\"user-details\">\r\n              <span class=\"username\">{{ moment.user.username }}</span>\r\n              <span class=\"post-time\">{{ formatTime(moment.created_at) }}</span>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- 动态内容 -->\r\n          <div class=\"moment-content\" v-html=\"sanitizeHtml(moment.content)\"></div>\r\n\r\n          <!-- 媒体内容 -->\r\n          <div v-if=\"moment.media?.length\" class=\"media-grid\">\r\n            <div\r\n              v-for=\"(media, index) in moment.media\"\r\n              :key=\"index\"\r\n              class=\"media-item\"\r\n              :class=\"{ 'video-container': media.type === 'video' }\"\r\n            >\r\n              <img\r\n                v-if=\"media.type === 'image'\"\r\n                :src=\"getFullUrl(media.url)\"\r\n                @click.stop=\"openImagePreview(getFullUrl(media.url))\"\r\n              />\r\n              <video\r\n                v-else-if=\"media.type === 'video'\"\r\n                :src=\"getFullUrl(media.url)\"\r\n                controls\r\n                :poster=\"getFullUrl(media.thumbnail)\"\r\n              >\r\n                <source :src=\"getFullUrl(media.url)\" :type=\"getVideoType(media.url)\">\r\n                您的浏览器不支持视频播放\r\n              </video>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- 互动区域 -->\r\n          <div class=\"moment-interaction flex justify-end space-x-4\">\r\n            <div \r\n              class=\"like-container flex items-center space-x-1 cursor-pointer\"\r\n              @click.stop=\"handleLikeMoment(moment.id)\"\r\n            >\r\n              <i\r\n                class=\"fa-solid fa-thumbs-up\"\r\n                :class=\"{ 'liked': moment.isLiked }\"\r\n              ></i>\r\n              <span>{{ moment.stats.likes }}</span>\r\n            </div>\r\n            <div \r\n              class=\"comment-container flex items-center space-x-1 cursor-pointer\"\r\n              @click.stop=\"goToMomentDetail(moment.id)\"\r\n            >\r\n              <i class=\"fa-solid fa-comment\"></i>\r\n              <span>{{ moment.stats.comments }}</span>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- 底部信息 -->\r\n          <div class=\"moment-footer flex items-center text-sm text-gray-500\">\r\n            <i\r\n              v-if=\"moment.user_id === currentUser.id\"\r\n              class=\"fa-solid fa-trash-can delete-btn cursor-pointer hover:text-red-500\"\r\n              @click.stop=\"deleteMoment(moment.id)\"\r\n            ></i>\r\n            <span class=\"time-ago\">{{ getTimeAgo(moment.created_at) }}</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      \r\n      <div v-if=\"noMore\" class=\"no-more-message\">\r\n        没有更多动态了\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n  \r\n  <script>\r\n  import { ref, onMounted, onUnmounted, computed, watchEffect } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport { useStore } from 'vuex'\r\nimport axios from 'axios'\r\nimport DOMPurify from 'dompurify'\r\nimport defaultAvatar from '@/assets/default-avatar.png'\r\nimport { API_CONFIG } from '@/config/config'\r\nimport { ElMessage } from 'element-plus'\r\nimport {useLike, updateLocalLikeStatus } from '@/utils/UserLike'\r\n\r\n\r\nexport default {\r\n\r\n  setup() {\r\n    const router = useRouter()\r\n    const store = useStore()\r\n    const moments = ref([])\r\n    const loading = ref(false)\r\n    const noMore = ref(false)\r\n    const lastId = ref(null)\r\n    const pageSize = 10\r\n    const error = ref(null)\r\n\r\n    // 用户方法\r\n    const currentUser = computed(() => store.state.user || {})\r\n    const goToUser = () => router.push('/user')\r\n    const goToUserProfile = (userId) => router.push(`/user/${userId}`)\r\n    const goToPublish = () => router.push('/publish')\r\n\r\n\r\n        // 初始化 useLike\r\n    const { toggleLike,updateLocalLikeStatus } = useLike()\r\n    const goToMomentDetail = (momentId) => {\r\n      router.push(`/moment/${momentId}`)\r\n    }\r\n    \r\n    // 工具方法\r\n    const getFullUrl = (path) => {\r\n      if (!path || path === defaultAvatar) return path\r\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`\r\n    }\r\n\r\n    const formatTime = (timestamp) => {\r\n      try {\r\n        const date = new Date(timestamp)\r\n        return `${date.getFullYear()}-${(date.getMonth() + 1).toString().padStart(2, '0')}-` +\r\n               `${date.getDate().toString().padStart(2, '0')} ` +\r\n               `${date.getHours().toString().padStart(2, '0')}:` +\r\n               `${date.getMinutes().toString().padStart(2, '0')}`\r\n      } catch (e) {\r\n        console.error('时间格式化错误:', e)\r\n        return '未知时间'\r\n      }\r\n    }\r\n\r\n    const getTimeAgo = (timestamp) => {\r\n      try {\r\n        const now = Date.now()\r\n        const diff = now - new Date(timestamp).getTime()\r\n        const minutes = Math.floor(diff / 60000)\r\n        const hours = Math.floor(minutes / 60)\r\n        const days = Math.floor(hours / 24)\r\n\r\n        if (minutes < 1) return '刚刚'\r\n        if (minutes < 60) return `${minutes}分钟前`\r\n        if (hours < 24) return `${hours}小时前`\r\n        return `${days}天前`\r\n      } catch (e) {\r\n        console.error('时间计算错误:', e)\r\n        return '未知时间'\r\n      }\r\n    }\r\n\r\n    const sanitizeHtml = (html) => {\r\n      try {\r\n        return DOMPurify.sanitize(html)\r\n      } catch (e) {\r\n        console.error('HTML净化错误:', e)\r\n        return ''\r\n      }\r\n    }\r\n\r\n    // 动态加载\r\n    const fetchMoments = async () => {\r\n      if (loading.value || noMore.value) return\r\n      loading.value = true\r\n      error.value = null\r\n\r\n      try {\r\n        const params = { limit: pageSize, last_id: lastId.value }\r\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/article/moments`, {\r\n          headers: { Authorization: `Bearer ${store.state.token}` },\r\n          params\r\n        })\r\n\r\n        if (!Array.isArray(response.data)) {\r\n          throw new Error('返回数据格式不正确')\r\n        }\r\n\r\n        const newMoments = response.data.map(moment => ({\r\n          ...moment,\r\n          showCommentInput: false,\r\n          commentInput: '',\r\n          comments: (moment.comments || []).map(comment => ({\r\n            ...comment,\r\n            showReplyInput: false,\r\n            replyInput: '',\r\n            replies: comment.replies || []\r\n          })),\r\n          showAllComments: false,\r\n          isLiked: moment.like_users?.includes(currentUser.value.id) || false\r\n        }))\r\n\r\n        moments.value = [...moments.value, ...newMoments]\r\n        lastId.value = newMoments[newMoments.length - 1]?.id\r\n        noMore.value = newMoments.length < pageSize\r\n      } catch (error) {\r\n        console.error('获取动态失败:', error)\r\n        error.value = error.message\r\n        ElMessage.error('加载动态失败')\r\n      } finally {\r\n        loading.value = false\r\n      }\r\n    }\r\n\r\n\r\nconst handleLikeMoment = async (momentId) => {\r\n  try {\r\n    // 显示加载状态\r\n    const moment = moments.value.find(m => m.id === momentId)\r\n    if (moment) {\r\n      moment.isLiked = !moment.isLiked\r\n      moment.stats = moment.stats || { likes: 0 }\r\n      moment.stats.likes += moment.isLiked ? 1 : -1\r\n    }\r\n    \r\n    // 执行点赞请求\r\n    const result = await toggleLike('moment', momentId)\r\n    console.log(\"点赞API结果:\", result)\r\n    \r\n    if (result) {\r\n      // 同步本地状态与服务器结果\r\n     updateLocalLikeStatus(moments.value, 'moment', momentId, result.isLiked, result.likes)\r\n    } else {\r\n      // 请求失败，回滚本地状态\r\n      if (moment) {\r\n        moment.isLiked = !moment.isLiked\r\n        moment.stats.likes += moment.isLiked ? -1 : 1\r\n      }\r\n    }\r\n  } catch (error) {\r\n    console.error('点赞失败:', error)\r\n    ElMessage.error('点赞操作失败')\r\n    \r\n    // 回滚本地状态\r\n    const moment = moments.value.find(m => m.id === momentId)\r\n    if (moment) {\r\n      moment.isLiked = !moment.isLiked\r\n      moment.stats.likes += moment.isLiked ? -1 : 1\r\n    }\r\n  }\r\n}\r\n\r\n\r\n    const deleteMoment = async (momentId) => {\r\n      try {\r\n        await axios.post(\r\n          `${API_CONFIG.BASE_URL}/article/delete/moment`,\r\n          { moment_id: momentId },\r\n          { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n        )\r\n        moments.value = moments.value.filter(m => m.id!== momentId)\r\n        ElMessage.success('删除成功')\r\n      } catch (error) {\r\n        console.error('删除失败:', error)\r\n        ElMessage.error('删除失败')\r\n      }\r\n    }\r\n\r\n    // 辅助函数\r\n    const visibleComments = (moment) => {\r\n      return moment.showAllComments? \r\n        moment.comments : \r\n        moment.comments.slice(0, 3)\r\n    }\r\n\r\n    // 生命周期\r\n    onMounted(() => {\r\n      fetchMoments()\r\n      window.addEventListener('scroll', handleScroll)\r\n    })\r\n\r\n    onUnmounted(() => {\r\n      window.removeEventListener('scroll', handleScroll)\r\n    })\r\n\r\n    const handleScroll = () => {\r\n      const { scrollTop, scrollHeight, clientHeight } = document.documentElement\r\n      if (scrollTop + clientHeight >= scrollHeight - 100 &&!loading.value) {\r\n        fetchMoments()\r\n      }\r\n    }\r\n\r\n    // 添加响应式错误处理\r\n    watchEffect(() => {\r\n      if (error.value) {\r\n        console.error('组件错误:', error.value)\r\n        // 可以在这里添加全局错误提示\r\n      }\r\n    })\r\n\r\n    return {\r\n      moments,\r\n      currentUser,\r\n      noMore,\r\n      loading,\r\n      error, // 暴露错误状态\r\n      visibleComments,\r\n      getFullUrl,\r\n      formatTime,\r\n      getTimeAgo,\r\n      sanitizeHtml,\r\n      goToUser,\r\n      goToUserProfile,\r\n      goToPublish,\r\n      goToMomentDetail,\r\n      handleLikeMoment,\r\n      deleteMoment,\r\n      defaultAvatar\r\n    }\r\n  }\r\n}\r\n  </script>\r\n  \r\n  <style scoped>\r\n  /* 新增侧边栏样式 */\r\n  .user-sidebar {\r\n    position: fixed;\r\n    left: 0;\r\n    top: 0;\r\n    bottom: 0;\r\n    width: 240px;\r\n    background: #fff;\r\n    box-shadow: 2px 0 8px rgba(0, 0, 0, 0.05);\r\n    z-index: 99;\r\n    padding: 20px;\r\n  }\r\n  \r\n  .user-profile {\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center;\r\n    cursor: pointer;\r\n    transition: transform 0.2s;\r\n  }\r\n  \r\n  .user-profile:hover {\r\n    transform: translateX(5px);\r\n  }\r\n  \r\n  .sidebar-avatar {\r\n    width: 80px;\r\n    height: 80px;\r\n    border-radius: 50%;\r\n    