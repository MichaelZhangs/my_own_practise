 computed, onMounted } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { useRouter } from 'vue-router';\r\nimport defaultAvatar from '@/assets/default-avatar.png';\r\n\r\nexport default {\r\n  name: 'UserPage',\r\n  setup() {\r\n    const store = useStore();\r\n    const router = useRouter();\r\n\r\n    const user = computed(() => store.state.user);\r\n    const displayName = computed(() => user.value?.username || user.value?.phone || user.value?.email || '未登录');\r\n\r\n    // 退出登录\r\n    const logout = () => {\r\n      store.dispatch('logout');\r\n      router.push('/login');\r\n    };\r\n\r\n    // 跳转到 PersonInfo.vue\r\n    const goToPersonInfo = () => {\r\n      router.push('/user/profile'); // 跳转到个人资料页面\r\n    };\r\n\r\n    // 页面加载时检查用户是否登录\r\n    onMounted(() => {\r\n      if (!store.state.user) {\r\n        router.push('/login');\r\n      }\r\n    });\r\n\r\n    return {\r\n      user,\r\n      displayName,\r\n      defaultAvatar,\r\n      logout,\r\n      goToPersonInfo,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.user-page {\r\n  display: flex;\r\n  flex-direction: column;\r\n  height: 100vh;\r\n  background-color: #f0f2f5;\r\n}\r\n\r\n.header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  padding: 0 20px;\r\n  height: 60px;\r\n  background-color: #001529;\r\n  color: white;\r\n}\r\n\r\n.header-left {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.user-info {\r\n  display: flex;\r\n  align-items: center;\r\n  cursor: pointer;\r\n}\r\n\r\n.avatar {\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 50%;\r\n  margin-right: 10px;\r\n}\r\n\r\n.username {\r\n  margin-right: 20px;\r\n  font-size: 16px;\r\n}\r\n\r\n.logout-button {\r\n  padding: 5px 10px;\r\n  background-color: #1890ff;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n}\r\n\r\n.logout-button:hover {\r\n  background-color: #40a9ff;\r\n}\r\n\r\n.main-layout {\r\n  display: flex;\r\n  flex: 1;\r\n  overflow: hidden;\r\n}\r\n\r\n.sidebar {\r\n  width: 200px;\r\n  background-color: #001529;\r\n  color: white;\r\n  overflow-y: auto;\r\n}\r\n\r\n.menu {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 0;\r\n}\r\n\r\n.menu-item {\r\n  padding: 15px 20px;\r\n  border-bottom: 1px solid #002140;\r\n}\r\n\r\n.menu-item a {\r\n  color: white;\r\n  text-decoration: none;\r\n  display: block;\r\n}\r\n\r\n.menu-item a:hover {\r\n  color: #1890ff;\r\n}\r\n\r\n.main-content {\r\n  flex: 1;\r\n  padding: 20px;\r\n  background-color: white;\r\n  overflow-y: auto;\r\n  position: relative;\r\n}\r\n</style>"],"mappings":";;EACOA,KAAK,EAAC;AAAW;;EACZA,KAAK,EAAC;AAAQ;;EACfA,KAAK,EAAC;AAAa;mBAH9B;;EAOgBA,KAAK,EAAC;AAAU;;EAGrBA,KAAK,EAAC;AAAc;;EAKtBA,KAAK,EAAC;AAAa;;EACfA,KAAK,EAAC;AAAS;;EAChBA,KAAK,EAAC;AAAM;;EACVA,KAAK,EAAC;AAAW;;EAMnBA,KAAK,EAAC;AAAc;;;;uBAvB9BC,mBAAA,CA2BM,OA3BNC,UA2BM,GA1BJC,mBAAA,CAWS,UAXTC,UAWS,GAVPD,mBAAA,CAMM,OANNE,UAMM,GALJC,mBAAA,4BAA+B,EAC/BH,mBAAA,CAGM;IAHDH,KAAK,EAAC,WAAW;IAAEO,OAAK,EAAAC,MAAA,QAAAA,MAAA,UAAAC,IAAA,KAAEC,MAAA,CAAAC,cAAA,IAAAD,MAAA,CAAAC,cAAA,IAAAF,IAAA,CAAc;MAC3CN,mBAAA,CAAmE;IAA7DS,GAAG,EAAEF,MAAA,CAAAG,IAAI,EAAEC,KAAK,IAAIJ,MAAA,CAAAK,aAAa;IAAEC,GAAG,EAAC,IAAI;IAAChB,KAAK,EAAC;0BANlEiB,UAAA,GAOUd,mBAAA,CAA+C,QAA/Ce,UAA+C,EAAAC,gBAAA,CAArBT,MAAA,CAAAU,WAAW,iB,KAGzCjB,mBAAA,CAEM,OAFNkB,UAEM,GADJlB,mBAAA,CAA2D;IAAlDI,OAAK,EAAAC,MAAA,QAAAA,MAAA,UAAAC,IAAA,KAAEC,MAAA,CAAAY,MAAA,IAAAZ,MAAA,CAAAY,MAAA,IAAAb,IAAA,CAAM;IAAET,KAAK,EAAC;KAAgB,MAAI,E,KAItDG,mBAAA,CAYM,OAZNoB,UAYM,GAXJpB,mBAAA,CAMQ,SANRqB,UAMQ,GALNrB,mBAAA,CAIK,MAJLsB,UAIK,GAHHtB,mBAAA,CAEK,MAFLuB,WAEK,GADHC,YAAA,CAAmDC,sBAAA;IAAtCC,EAAE,EAAC;EAAiB;IAnB7CC,OAAA,EAAAC,QAAA,CAmB8C,MAAGvB,MAAA,QAAAA,MAAA,OAnBjDwB,gBAAA,CAmB8C,KAAG,E;IAnBjDC,CAAA;YAwBM9B,mBAAA,CAEO,QAFP+B,WAEO,GADLP,YAAA,CAA2BQ,sBAAA,E","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}