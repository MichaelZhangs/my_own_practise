 class: \"short-input\"\n  }, null, 512 /* NEED_PATCH */), [[_vModelText, $setup.editableUser.email]])]), _createElementVNode(\"div\", _hoisted_13, [_cache[12] || (_cache[12] = _createElementVNode(\"label\", null, \"描述：\", -1 /* HOISTED */)), _withDirectives(_createElementVNode(\"input\", {\n    \"onUpdate:modelValue\": _cache[5] || (_cache[5] = $event => $setup.editableUser.description = $event),\n    class: \"short-input\"\n  }, null, 512 /* NEED_PATCH */), [[_vModelText, $setup.editableUser.description]])]), _createCommentVNode(\" 二维码展示 \"), _createElementVNode(\"div\", _hoisted_14, [_cache[13] || (_cache[13] = _createElementVNode(\"label\", {\n    class: \"qr-label\"\n  }, \"我的二维码：\", -1 /* HOISTED */)), _createElementVNode(\"div\", {\n    class: \"qr-wrapper\",\n    onClick: $setup.generateQRWithAvatar\n  }, [_createElementVNode(\"img\", {\n    src: $setup.qrcodeUrl || $setup.defaultQR,\n    alt: \"个人二维码\",\n    class: \"wechat-qr\"\n  }, null, 8 /* PROPS */, _hoisted_15)])])]), _createElementVNode(\"button\", {\n    class: \"save-btn\",\n    onClick: $setup.saveUserInfo\n  }, \"保存修改\")])]);\n}","map":{"version":3,"names":["class","key","_createElementBlock","_hoisted_1","_createElementVNode","_hoisted_2","_createCommentVNode","_hoisted_3","_hoisted_4","type","accept","onChange","$setup","handleAvatarUpload","hidden","src","editableUser","photo","defaultAvatar","alt","_hoisted_5","_hoisted_6","_hoisted_7","_cache","$event","username","_hoisted_8","sex","value","_hoisted_9","phone","readonly","isPhoneEditable","onDblclick","enablePhoneEdit","onBlur","_hoisted_10","_hoisted_11","_hoisted_12","email","_hoisted_13","description","_hoisted_14","onClick","generateQRWithAvatar","qrcodeUrl","defaultQR","_hoisted_15","saveUserInfo"],"sources":["E:\\vue_learn\\ai_vue\\ai_vue\\src\\views\\UserDetail.vue"],"sourcesContent":["<template>\r\n  <div class=\"user-detail-page\">\r\n    <h1 class=\"page-title\">用户详情</h1>\r\n    <div class=\"user-container\">\r\n      <!-- 可编辑头像 -->\r\n      <div class=\"avatar-wrapper\">\r\n        <label class=\"avatar-upload\">\r\n          <input \r\n            type=\"file\" \r\n            accept=\"image/*\" \r\n            @change=\"handleAvatarUpload\" \r\n            hidden\r\n          />\r\n          <img \r\n            :src=\"editableUser.photo || defaultAvatar\" \r\n            alt=\"用户头像\" \r\n            class=\"user-avatar\"\r\n          />\r\n          <span class=\"edit-tip\">点击更换头像</span>\r\n        </label>\r\n      </div>\r\n\r\n      <!-- 用户信息编辑 -->\r\n      <div class=\"info-section\">\r\n        <div class=\"info-item\">\r\n          <label>姓名：</label>\r\n          <input v-model=\"editableUser.username\" class=\"short-input\" />\r\n        </div>\r\n        \r\n        <div class=\"info-item\">\r\n          <label>性别：</label>\r\n          <select v-model=\"editableUser.sex\">\r\n            <option value=\"male\">male</option>\r\n            <option value=\"female\">female</option>\r\n          </select>\r\n        </div>\r\n\r\n        <div class=\"info-item\">\r\n          <label>手机：</label>\r\n          <input\r\n            v-model=\"editableUser.phone\"\r\n            :readonly=\"!isPhoneEditable\"\r\n            class=\"short-input\"\r\n            @dblclick=\"enablePhoneEdit\"\r\n            @blur=\"isPhoneEditable = false\"\r\n          />\r\n          <span v-if=\"!isPhoneEditable\" class=\"edit-hint\">(双击编辑)</span>\r\n        </div>\r\n\r\n        <div class=\"info-item\">\r\n          <label>邮箱：</label>\r\n          <input v-model=\"editableUser.email\" class=\"short-input\" />\r\n        </div>\r\n\r\n        <div class=\"info-item\">\r\n          <label>描述：</label>\r\n          <input v-model=\"editableUser.description\" class=\"short-input\" />\r\n        </div>\r\n\r\n        <!-- 二维码展示 -->\r\n        <div class=\"info-item\">\r\n          <label class=\"qr-label\">我的二维码：</label>\r\n          <div class=\"qr-wrapper\" @click=\"generateQRWithAvatar\">\r\n            <img \r\n              :src=\"qrcodeUrl || defaultQR\" \r\n              alt=\"个人二维码\" \r\n              class=\"wechat-qr\"\r\n            />\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <button class=\"save-btn\" @click=\"saveUserInfo\">保存修改</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n  \r\n<script setup>\r\nimport { ref, onMounted } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport axios from 'axios';\r\nimport QRCode from 'qrcode';\r\nimport defaultAvatar from '@/assets/default-avatar.png';\r\nimport defaultQR from '@/assets/logo.png';\r\n\r\nconst store = useStore();\r\n\r\n// 响应式数据\r\nconst editableUser = ref({\r\n  ...store.state.user,\r\n  description: store.state.user.description || ''\r\n});\r\nconst qrcodeUrl = ref(defaultQR);\r\nconst isPhoneEditable = ref(false);\r\n\r\n// 启用手机号编辑\r\nconst enablePhoneEdit = async () => {\r\n  isPhoneEditable.value = true;\r\n  document.querySelector('.short-input[readonly]')?.focus();\r\n};\r\n\r\n// 头像上传处理\r\nconst handleAvatarUpload = async (event) => {\r\n  const file = event.target.files?.[0];\r\n  if (!file || !file.type.startsWith('image/')) return;\r\n\r\n  try {\r\n    const formData = new FormData();\r\n    formData.append('phone', editableUser.value.phone); // 添加手机号参数\r\n    formData.append('file', file);\r\n\r\n    const response = await axios.post(\r\n      'http://127.0.0.1:8000/upload-avatar',\r\n      formData,\r\n      {\r\n        headers: {\r\n          'Content-Type': 'multipart/form-data'\r\n        }\r\n      }\r\n    );\r\n\r\n    if (response.data.url) {\r\n      // 更新本地数据（使用完整URL）\r\n      editableUser.value.photo = response.data.url;\r\n    }\r\n  } catch (error) {\r\n    console.error('头像上传失败:', error);\r\n    alert('头像上传失败，请重试');\r\n  }\r\n};\r\n\r\n// 生成带头像的二维码\r\nconst generateQRWithAvatar = async () => {\r\n  try {\r\n    const userData = {\r\n      name: editableUser.value.username,\r\n      phone: editableUser.value.phone,\r\n      email: editableUser.value.email,\r\n      description: editableUser.value.description\r\n    };\r\n\r\n    const canvas = document.createElement('canvas');\r\n    await QRCode.toCanvas(canvas, JSON.stringify(userData), {\r\n      width: 200,\r\n      margin: 2,\r\n      color: {\r\n        dark: '#07c160',\r\n        light: '#ffffff'\r\n      },\r\n      errorCorrectionLevel: 'H'\r\n    });\r\n\r\n    const ctx = canvas.getContext('2d');\r\n    const avatarImg = new Image();\r\n    avatarImg.src = editableUser.value.photo || defaultAvatar;\r\n    \r\n    await new Promise((resolve) => {\r\n      avatarImg.onload = resolve;\r\n      avatarImg.onerror = resolve;\r\n    });\r\n\r\n    ctx.beginPath();\r\n    ctx.arc(100, 100, 25, 0, Math.PI * 2);\r\n    ctx.clip();\r\n    ctx.drawImage(avatarImg, 75, 75, 50, 50);\r\n\r\n    qrcodeUrl.value = canvas.toDataURL();\r\n    editableUser.value.qrcode = qrcodeUrl.value; // 同步到可编辑数据\r\n  } catch (error) {\r\n    console.error('二维码生成失败:', error);\r\n    alert('二维码生成失败，请重试');\r\n  }\r\n};\r\n\r\n// 获取用户信息\r\nconst fetchUserInfo = async () => {\r\n  try {\r\n    const response = await axios.get('http://127.0.0.1:8000/user/info', {\r\n      params: {\r\n        phone: editableUser.value.phone  // 根据你的接口需求传参\r\n      }\r\n    });\r\n    \r\n    if (response.data) {\r\n      // 更新store中的用户信息\r\n      await store.dispatch('updateUser', response.data);\r\n      \r\n      // 更新本地可编辑数据\r\n      editableUser.value = { \r\n        ...response.data,\r\n        description: response.data.description || '' \r\n      };\r\n\r\n      // 如果用户有二维码信息，直接显示\r\n      if (response.data.qrcode) {\r\n        qrcodeUrl.value = response.data.qrcode;\r\n      }\r\n    }\r\n  } catch (error) {\r\n    console.error('获取用户信息失败:', error);\r\n    alert('获取用户信息失败，请重试');\r\n  }\r\n};\r\n\r\n// 组件挂载时自动获取用户信息\r\nonMounted(async () => {\r\n  await fetchUserInfo();\r\n});\r\n\r\n// 保存用户信息\r\nconst saveUserInfo = async () => {\r\n  try {\r\n    // 构造请求数据\r\n    const requestData = {\r\n      username: editableUser.value.username,\r\n      email: editableUser.value.email || \"\",\r\n      sex: editableUser.value.sex,\r\n      description: editableUser.value.description || \"\",\r\n      phone: editableUser.value.phone,\r\n      qrcode: qrcodeUrl.value // 将二维码数据添加到请求中\r\n    };\r\n\r\n    // 发送PUT请求保存用户信息\r\n    const response = await axios.put('http://127.0.0.1:8000/user/info', requestData);\r\n    console.log(\"response: \", response.status);\r\n\r\n    if (response.status === 200) {\r\n      // 更新本地存储\r\n      await store.dispatch('updateUser', requestData);\r\n\r\n      // 保存二维码到服务器\r\n      await saveQrcodeToServer();\r\n    }\r\n  } catch (error) {\r\n    console.error('保存失败:', error);\r\n    const errorMsg = error.response?.data?.detail || '保存失败，请检查网络后重试';\r\n    alert(`保存失败: ${errorMsg}`);\r\n  }\r\n};\r\n\r\n// 保存二维码到服务器\r\nconst saveQrcodeToServer = async () => {\r\n  try {\r\n    if (!qrcodeUrl.value) {\r\n      alert('请先生成二维码');\r\n      return;\r\n    }\r\n\r\n    const response = await axios.post('http://127.0.0.1:8000/user/save-qrcode', {\r\n      phone: editableUser.value.phone,\r\n      qrcode: qrcodeUrl.value // 二维码的Base64数据\r\n    });\r\n\r\n    if (response.status === 200) {\r\n      alert('二维码保存成功');\r\n    }\r\n  } catch (error) {\r\n    console.error('二维码保存失败:', error);\r\n    alert('二维码保存失败，请重试');\r\n  }\r\n};\r\n</script>\r\n  \r\n  <style scoped>\r\n  /* 基础布局 */\r\n  .user-detail-page {\r\n    max-width: 600px;\r\n    margin: 0 auto;\r\n    padding: 2rem;\r\n    font-family: 'Helvetica Neue', Arial, sans-serif;\r\n  }\r\n  \r\n  .page-title {\r\n    text-align: center;\r\n    font-size: 1.5rem;\r\n    color: #333;\r\n    margin-bottom: 2rem;\r\n  }\r\n  \r\n  .user-container {\r\n    background: #fff;\r\n    border-radius: 12px;\r\n    padding: 1.5rem;\r\n    box-shadow: 0 2px 8px rgba(0,0,0,0.1);\r\n  }\r\n  \r\n  /* 头像样式 */\r\n  .avatar-wrapper {\r\n    text-align: center;\r\n    margin-bottom: 1.5rem;\r\n  }\r\n  \r\n  .user-avatar {\r\n    width: 100px;\r\n    height: 100px;\r\n    border-radius: 50%;\r\n    border: 3px solid #07c160;\r\n    cursor: pointer;\r\n    transition: transform 0.3s ease;\r\n  }\r\n  \r\n  .user-avatar:hover {\r\n    transform: scale(1.05);\r\n  }\r\n  /* 二维码标签特殊样式 */\r\n    .qr-label {\r\n    margin-top: 5px; /* 保持垂直对齐 */\r\n    }\r\n  \r\n  .edit-tip {\r\n    display: block;\r\n    color: #666;\r\n    font-size: 0.8rem;\r\n    margin-top: 0.5rem;\r\n  }\r\n  \r\n  /* 手机号编辑提示 */\r\n    .edit-hint {\r\n    color: #999;\r\n    font-size: 0.8rem;\r\n    margin-left: 10px;\r\n    }\r\n    /* 手机号输入框只读状态 */\r\n    input:read-only {\r\n    background-color: #f5f5f5;\r\n    cursor: not-allowed;\r\n    border-color: #eee;\r\n    }\r\n\r\n  /* 信息项样式 */\r\n  .info-section {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 1rem;\r\n  }\r\n  \r\n  .info-item {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 1rem;\r\n  }\r\n  \r\n  .info-item label {\r\n  flex: 0 0 100px;\r\n  text-align: left; /* 改为左对齐 */\r\n  color: #666;\r\n  font-size: 0.9rem;\r\n  margin-right: 15px;\r\n}\r\n  \r\n  /* 输入控件样式 */\r\n  .short-input, select {\r\n    flex: 1;\r\n    padding: 0.5rem;\r\n    border: 1px solid #ddd;\r\n    border-radius: 4px;\r\n    max-width: 300px;\r\n    font-size: 0.9rem;\r\n  }\r\n  \r\n  select {\r\n    background: white;\r\n    cursor: pointer;\r\n  }\r\n  \r\n  /* 二维码区域 */\r\n  .qr-wrapper {\r\n    flex: 1;\r\n    cursor: pointer;\r\n  }\r\n  \r\n  .wechat-qr {\r\n    width: 160px;\r\n    height: 160px;\r\n    border: 3px solid #07c160;\r\n    border-radius: 8px;\r\n    padding: 5px;\r\n    background: white;\r\n    transition: transform 0.3s ease;\r\n  }\r\n  \r\n  .wechat-qr:hover {\r\n    transform: scale(1.05);\r\n  }\r\n  \r\n  /* 保存按钮 */\r\n  .save-btn {\r\n    display: block;\r\n    width: 200px;\r\n    padding: 0.8rem;\r\n    margin: 2rem auto 0;\r\n    background: #07c160;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 25px;\r\n    cursor: pointer;\r\n    font-size: 1rem;\r\n    transition: background 0.3s ease;\r\n  }\r\n  \r\n  .save-btn:hover {\r\n    background: #05964d;\r\n  }\r\n  \r\n  /* 响应式设计 */\r\n  @media (max-width: 480px) {\r\n    .user-container {\r\n      padding: 1rem;\r\n    }\r\n  \r\n    .info-item {\r\n      flex-direction: column;\r\n      align-items: flex-start;\r\n    }\r\n  \r\n    .info-item label {\r\n      text-align: left;\r\n      flex: none;\r\n    }\r\n  \r\n    .short-input, select {\r\n      max-width: 100%;\r\n      width: 100%;\r\n    }\r\n  \r\n    .wechat-qr {\r\n      width: 140px;\r\n      height: 140px;\r\n    }\r\n  }\r\n  </style>  "],"mappings":";;EACOA,KAAK,EAAC;AAAkB;;EAEtBA,KAAK,EAAC;AAAgB;;EAEpBA,KAAK,EAAC;AAAgB;;EAClBA,KAAK,EAAC;AAAe;mBANpC;;EAuBWA,KAAK,EAAC;AAAc;;EAClBA,KAAK,EAAC;AAAW;;EAKjBA,KAAK,EAAC;AAAW;;EAQjBA,KAAK,EAAC;AAAW;oBArC9B;;EAAAC,GAAA;EA8CwCD,KAAK,EAAC;;;EAGjCA,KAAK,EAAC;AAAW;;EAKjBA,KAAK,EAAC;AAAW;;EAMjBA,KAAK,EAAC;AAAW;oBA5D9B;;uBACEE,mBAAA,CAyEM,OAzENC,UAyEM,G,4BAxEJC,mBAAA,CAAgC;IAA5BJ,KAAK,EAAC;EAAY,GAAC,MAAI,sBAC3BI,mBAAA,CAsEM,OAtENC,UAsEM,GArEJC,mBAAA,WAAc,EACdF,mBAAA,CAeM,OAfNG,UAeM,GAdJH,mBAAA,CAaQ,SAbRI,UAaQ,GAZNJ,mBAAA,CAKE;IAJAK,IAAI,EAAC,MAAM;IACXC,MAAM,EAAC,SAAS;IACfC,QAAM,EAAEC,MAAA,CAAAC,kBAAkB;IAC3BC,MAAM,EAAN;qCAEFV,mBAAA,CAIE;IAHCW,GAAG,EAAEH,MAAA,CAAAI,YAAY,CAACC,KAAK,IAAIL,MAAA,CAAAM,aAAa;IACzCC,GAAG,EAAC,MAAM;IACVnB,KAAK,EAAC;0BAhBlBoB,UAAA,G,0BAkBUhB,mBAAA,CAAoC;IAA9BJ,KAAK,EAAC;EAAU,GAAC,QAAM,qB,KAIjCM,mBAAA,YAAe,EACfF,mBAAA,CA+CM,OA/CNiB,UA+CM,GA9CJjB,mBAAA,CAGM,OAHNkB,UAGM,G,0BAFJlB,mBAAA,CAAkB,eAAX,KAAG,sB,gBACVA,mBAAA,CAA6D;IA1BvE,uBAAAmB,MAAA,QAAAA,MAAA,MAAAC,MAAA,IA0B0BZ,MAAA,CAAAI,YAAY,CAACS,QAAQ,GAAAD,MAAA;IAAExB,KAAK,EAAC;iDAA7BY,MAAA,CAAAI,YAAY,CAACS,QAAQ,E,KAGvCrB,mBAAA,CAMM,OANNsB,UAMM,G,0BALJtB,mBAAA,CAAkB,eAAX,KAAG,sB,gBACVA,mBAAA,CAGS;IAlCnB,uBAAAmB,MAAA,QAAAA,MAAA,MAAAC,MAAA,IA+B2BZ,MAAA,CAAAI,YAAY,CAACW,GAAG,GAAAH,MAAA;gCAC/BpB,mBAAA,CAAkC;IAA1BwB,KAAK,EAAC;EAAM,GA