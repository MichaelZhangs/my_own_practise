{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { mapState, mapActions } from \"vuex\";\nimport defaultAvatar from \"@/assets/default-avatar.png\"; // 默认头像\nimport axios from \"axios\";\nexport default {\n  name: \"UserPage\",\n  data() {\n    return {\n      defaultAvatar,\n      // 默认头像\n      showInfo: false // 是否展示个人信息弹窗\n    };\n  },\n  computed: {\n    ...mapState([\"user\"]),\n    // 从 Vuex 中获取用户信息\n    displayName() {\n      // 优先展示用户名，其次是电话号码，最后是邮箱\n      return this.user?.username || this.user?.phone || this.user?.email || \"未登录\";\n    }\n  },\n  methods: {\n    ...mapActions([\"logout\"]),\n    // 使用 Vuex 的 logout 方法\n    // 获取用户信息\n    async fetchUserInfo() {\n      try {\n        const phone = this.user?.phone; // 从 Vuex 中获取当前用户的手机号\n        if (!phone) {\n          alert(\"用户未登录\");\n          return;\n        }\n\n        // 调用 personInfo.py 中的接口\n        const response = await axios.get(`/user/info?phone=${phone}`);\n        this.$store.commit(\"setUser\", response.data); // 更新 Vuex 中的用户信息\n        this.showInfo = true; // 展示个人信息弹窗\n      } catch (error) {\n        console.error(\"获取用户信息失败\", error);\n        alert(\"获取用户信息失败\");\n      }\n    },\n    // 关闭个人信息弹窗\n    closeInfoModal() {\n      this.showInfo = false;\n    }\n  },\n  created() {\n    // 如果未登录，则跳转到登录页\n    if (!this.user) {\n      this.$router.push(\"/login\");\n    }\n  }\n};","map":{"version":3,"names":["mapState","mapActions","defaultAvatar","axios","name","data","showInfo","computed","displayName","user","username","phone","email","methods","fetchUserInfo","alert","response","get","$store","commit","error","console","closeInfoModal","created","$router","push"],"sources":["E:\\vue_learn\\ai_vue\\ai_vue\\src\\views\\UserPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"user-page\">\r\n    <!-- 顶部导航栏 -->\r\n    <header class=\"header\">\r\n      <div class=\"header-left\">\r\n        <span class=\"logo\">用户中心</span>\r\n      </div>\r\n      <div class=\"header-right\">\r\n        <div class=\"user-info\" @click=\"fetchUserInfo\">\r\n          <img :src=\"user?.photo || defaultAvatar\" alt=\"头像\" class=\"avatar\" />\r\n          <span class=\"username\">{{ displayName }}</span>\r\n        </div>\r\n        <button @click=\"logout\" class=\"logout-button\">退出登录</button>\r\n      </div>\r\n    </header>\r\n\r\n    <!-- 主体区域 -->\r\n    <div class=\"main-layout\">\r\n      <!-- 侧边栏 -->\r\n      <aside class=\"sidebar\">\r\n        <ul class=\"menu\">\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/user/dashboard\">仪表盘</router-link>\r\n          </li>\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/user/profile\">个人资料</router-link>\r\n          </li>\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/user/settings\">设置</router-link>\r\n          </li>\r\n        </ul>\r\n      </aside>\r\n\r\n      <!-- 主内容区域 -->\r\n      <main class=\"main-content\">\r\n        <router-view></router-view>\r\n\r\n        <!-- 个人信息弹窗 -->\r\n        <div v-if=\"showInfo\" class=\"info-modal\">\r\n          <div class=\"modal-content\">\r\n            <h2>个人信息</h2>\r\n            <div class=\"info-section\">\r\n              <div class=\"info-item\">\r\n                <label>名字：</label>\r\n                <span>{{ user?.username || \"未设置\" }}</span>\r\n              </div>\r\n              <div class=\"info-item\">\r\n                <label>性别：</label>\r\n                <span>{{ user?.sex || \"未设置\" }}</span>\r\n              </div>\r\n              <div class=\"info-item\">\r\n                <label>手机号：</label>\r\n                <span>{{ user?.phone || \"未设置\" }}</span>\r\n              </div>\r\n              <div class=\"info-item\">\r\n                <label>邮箱：</label>\r\n                <span>{{ user?.email || \"未设置\" }}</span>\r\n              </div>\r\n              <div class=\"info-item\">\r\n                <label>描述：</label>\r\n                <span>{{ user?.description || \"未设置\" }}</span>\r\n              </div>\r\n            </div>\r\n            <button @click=\"closeInfoModal\" class=\"close-button\">关闭</button>\r\n          </div>\r\n        </div>\r\n      </main>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { mapState, mapActions } from \"vuex\";\r\nimport defaultAvatar from \"@/assets/default-avatar.png\"; // 默认头像\r\nimport axios from \"axios\";\r\n\r\nexport default {\r\n  name: \"UserPage\",\r\n  data() {\r\n    return {\r\n      defaultAvatar, // 默认头像\r\n      showInfo: false, // 是否展示个人信息弹窗\r\n    };\r\n  },\r\n  computed: {\r\n    ...mapState([\"user\"]), // 从 Vuex 中获取用户信息\r\n    displayName() {\r\n      // 优先展示用户名，其次是电话号码，最后是邮箱\r\n      return (\r\n        this.user?.username ||\r\n        this.user?.phone ||\r\n        this.user?.email ||\r\n        \"未登录\"\r\n      );\r\n    },\r\n  },\r\n  methods: {\r\n    ...mapActions([\"logout\"]), // 使用 Vuex 的 logout 方法\r\n    // 获取用户信息\r\n    async fetchUserInfo() {\r\n      try {\r\n        const phone = this.user?.phone; // 从 Vuex 中获取当前用户的手机号\r\n        if (!phone) {\r\n          alert(\"用户未登录\");\r\n          return;\r\n        }\r\n\r\n        // 调用 personInfo.py 中的接口\r\n        const response = await axios.get(`/user/info?phone=${phone}`);\r\n        this.$store.commit(\"setUser\", response.data); // 更新 Vuex 中的用户信息\r\n        this.showInfo = true; // 展示个人信息弹窗\r\n      } catch (error) {\r\n        console.error(\"获取用户信息失败\", error);\r\n        alert(\"获取用户信息失败\");\r\n      }\r\n    },\r\n    // 关闭个人信息弹窗\r\n    closeInfoModal() {\r\n      this.showInfo = false;\r\n    },\r\n  },\r\n  created() {\r\n    // 如果未登录，则跳转到登录页\r\n    if (!this.user) {\r\n      this.$router.push(\"/login\");\r\n    }\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.user-page {\r\n  display: flex;\r\n  flex-direction: column;\r\n  height: 100vh;\r\n  background-color: #f0f2f5;\r\n}\r\n\r\n.header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  padding: 0 20px;\r\n  height: 60px;\r\n  background-color: #001529;\r\n  color: white;\r\n}\r\n\r\n.header-left .logo {\r\n  font-size: 20px;\r\n  font-weight: bold;\r\n}\r\n\r\n.header-right {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.user-info {\r\n  display: flex;\r\n  align-items: center;\r\n  cursor: pointer;\r\n}\r\n\r\n.avatar {\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 50%;\r\n  margin-right: 10px;\r\n}\r\n\r\n.username {\r\n  margin-right: 20px;\r\n}\r\n\r\n.logout-button {\r\n  padding: 5px 10px;\r\n  background-color: #1890ff;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n}\r\n\r\n.logout-button:hover {\r\n  background-color: #40a9ff;\r\n}\r\n\r\n.main-layout {\r\n  display: flex;\r\n  flex: 1;\r\n  overflow: hidden;\r\n}\r\n\r\n.sidebar {\r\n  width: 200px;\r\n  background-color: #001529;\r\n  color: white;\r\n  overflow-y: auto;\r\n}\r\n\r\n.menu {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 0;\r\n}\r\n\r\n.menu-item {\r\n  padding: 15px 20px;\r\n  border-bottom: 1px solid #002140;\r\n}\r\n\r\n.menu-item a {\r\n  color: white;\r\n  text-decoration: none;\r\n  display: block;\r\n}\r\n\r\n.menu-item a:hover {\r\n  color: #1890ff;\r\n}\r\n\r\n.main-content {\r\n  flex: 1;\r\n  padding: 20px;\r\n  background-color: white;\r\n  overflow-y: auto;\r\n  position: relative;\r\n}\r\n\r\n.info-modal {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background-color: rgba(0, 0, 0, 0.5);\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n\r\n.modal-content {\r\n  background-color: white;\r\n  padding: 20px;\r\n  border-radius: 8px;\r\n  width: 400px;\r\n  max-width: 90%;\r\n}\r\n\r\n.modal-content h2 {\r\n  font-size: 20px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.info-section {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 10px;\r\n}\r\n\r\n.info-item {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.info-item label {\r\n  font-weight: bold;\r\n  width: 80px;\r\n}\r\n\r\n.close-button {\r\n  padding: 5px 10px;\r\n  background-color: #1890ff;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n  margin-top: 20px;\r\n  width: 100%;\r\n}\r\n\r\n.close-button:hover {\r\n  background-color: #40a9ff;\r\n}\r\n</style>"],"mappings":";AAwEA,SAASA,QAAQ,EAAEC,UAAS,QAAS,MAAM;AAC3C,OAAOC,aAAY,MAAO,6BAA6B,EAAE;AACzD,OAAOC,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,UAAU;EAChBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLH,aAAa;MAAE;MACfI,QAAQ,EAAE,KAAK,CAAE;IACnB,CAAC;EACH,CAAC;EACDC,QAAQ,EAAE;IACR,GAAGP,QAAQ,CAAC,CAAC,MAAM,CAAC,CAAC;IAAE;IACvBQ,WAAWA,CAAA,EAAG;MACZ;MACA,OACE,IAAI,CAACC,IAAI,EAAEC,QAAO,IAClB,IAAI,CAACD,IAAI,EAAEE,KAAI,IACf,IAAI,CAACF,IAAI,EAAEG,KAAI,IACf,KAAI;IAER;EACF,CAAC;EACDC,OAAO,EAAE;IACP,GAAGZ,UAAU,CAAC,CAAC,QAAQ,CAAC,CAAC;IAAE;IAC3B;IACA,MAAMa,aAAaA,CAAA,EAAG;MACpB,IAAI;QACF,MAAMH,KAAI,GAAI,IAAI,CAACF,IAAI,EAAEE,KAAK,EAAE;QAChC,IAAI,CAACA,KAAK,EAAE;UACVI,KAAK,CAAC,OAAO,CAAC;UACd;QACF;;QAEA;QACA,MAAMC,QAAO,GAAI,MAAMb,KAAK,CAACc,GAAG,CAAC,oBAAoBN,KAAK,EAAE,CAAC;QAC7D,IAAI,CAACO,MAAM,CAACC,MAAM,CAAC,SAAS,EAAEH,QAAQ,CAACX,IAAI,CAAC,EAAE;QAC9C,IAAI,CAACC,QAAO,GAAI,IAAI,EAAE;MACxB,EAAE,OAAOc,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,UAAU,EAAEA,KAAK,CAAC;QAChCL,KAAK,CAAC,UAAU,CAAC;MACnB;IACF,CAAC;IACD;IACAO,cAAcA,CAAA,EAAG;MACf,IAAI,CAAChB,QAAO,GAAI,KAAK;IACvB;EACF,CAAC;EACDiB,OAAOA,CAAA,EAAG;IACR;IACA,IAAI,CAAC,IAAI,CAACd,IAAI,EAAE;MACd,IAAI,CAACe,OAAO,CAACC,IAAI,CAAC,QAAQ,CAAC;IAC7B;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}