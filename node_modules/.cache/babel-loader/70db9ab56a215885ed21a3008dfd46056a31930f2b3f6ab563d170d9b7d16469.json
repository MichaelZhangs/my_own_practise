{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { computed, ref, nextTick } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nimport defaultAvatar from '@/assets/default-avatar.png';\nimport { API_CONFIG } from '@/config/config';\nimport axios from 'axios';\nimport { ElMessage } from 'element-plus';\nexport default {\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const messagesContainer = ref(null);\n    const isUserInfoOpen = ref(false);\n    const user = computed(() => store.state.user);\n    const displayName = computed(() => user.value?.username || '未登录');\n\n    // 搜索相关状态\n    const isSearchOpen = ref(false);\n    const searchKeyword = ref('');\n    const searchResults = ref([]);\n    const isSearching = ref(false);\n\n    // 聊天相关状态\n    const currentChatUser = ref({});\n    const messageInput = ref('');\n    const allChats = ref({}); // 所有聊天记录，按userId分组\n    const recentChats = ref([]); // 最近聊天列表\n\n    const avatarUrl = computed(() => {\n      if (user.value?.photo) {\n        return `${API_CONFIG.BASE_URL}${user.value.photo}`;\n      }\n      return defaultAvatar;\n    });\n    const logout = () => {\n      store.dispatch('logout');\n      router.push('/login');\n    };\n    const goToUserDetail = () => {\n      router.push('/user/userinfo/' + user.value?.id);\n    };\n    const toggleUserInfo = () => {\n      isUserInfoOpen.value = !isUserInfoOpen.value;\n    };\n\n    // 搜索相关方法\n    const toggleSearch = () => {\n      isSearchOpen.value = !isSearchOpen.value;\n\n      // 关闭搜索时清空结果\n      if (!isSearchOpen.value) {\n        searchKeyword.value = '';\n        searchResults.value = [];\n      }\n    };\n    const searchUsers = async () => {\n      if (!searchKeyword.value.trim()) {\n        ElMessage.warning('请输入搜索关键词');\n        return;\n      }\n      isSearching.value = true;\n      try {\n        // 调用搜索API\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/user/search`, {\n          params: {\n            keyword: searchKeyword.value.trim()\n          },\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        });\n\n        // 提取实际用户数据列表\n        searchResults.value = response.data.data || [];\n        console.log(\"搜索结果: \", searchResults.value);\n      } catch (error) {\n        console.error('搜索用户失败:', error);\n        ElMessage.error('搜索用户失败');\n      } finally {\n        isSearching.value = false;\n      }\n    };\n\n    // 聊天相关方法\n    const startChat = user => {\n      // 更新当前聊天用户\n      currentChatUser.value = user;\n\n      // 如果没有该用户的聊天记录，初始化一个空数组\n      if (!allChats.value[user.id]) {\n        allChats.value[user.id] = [];\n      }\n\n      // 更新最近聊天列表\n      updateRecentChats(user);\n\n      // 滚动到底部\n      scrollToBottom();\n    };\n    const closeChat = () => {\n      currentChatUser.value = {};\n    };\n    const sendMessage = () => {\n      if (!messageInput.value.trim()) {\n        return;\n      }\n      const message = {\n        id: Date.now(),\n        text: messageInput.value.trim(),\n        fromMe: true,\n        time: new Date().toISOString()\n      };\n\n      // 添加消息到聊天记录\n      if (!allChats.value[currentChatUser.value.id]) {\n        allChats.value[currentChatUser.value.id] = [];\n      }\n      allChats.value[currentChatUser.value.id].push(message);\n\n      // 清空输入框\n      messageInput.value = '';\n\n      // 更新最近聊天列表\n      updateRecentChats(currentChatUser.value);\n\n      // 滚动到底部\n      scrollToBottom();\n\n      // 模拟对方回复\n      simulateReply();\n    };\n    const simulateReply = () => {\n      if (!currentChatUser.value.id) {\n        return;\n      }\n\n      // 延迟1-3秒回复\n      const delay = Math.floor(Math.random() * 2000) + 1000;\n      setTimeout(() => {\n        const replies = [\"好的，我明白了。\", \"谢谢！\", \"有什么我可以帮助你的吗？\", \"哈哈，真有趣！\", \"我稍后回复你。\", \"是的，你说得对。\", \"很高兴收到你的消息！\"];\n        const randomReply = replies[Math.floor(Math.random() * replies.length)];\n        const reply = {\n          id: Date.now(),\n          text: randomReply,\n          fromMe: false,\n          time: new Date().toISOString()\n        };\n        allChats.value[currentChatUser.value.id].push(reply);\n\n        // 更新最近聊天列表\n        updateRecentChats(currentChatUser.value);\n\n        // 滚动到底部\n        scrollToBottom();\n      }, delay);\n    };\n    const updateRecentChats = user => {\n      // 检查用户是否已在最近聊天列表中\n      const index = recentChats.value.findIndex(chat => chat.id === user.id);\n      if (index > -1) {\n        // 如果已存在，移到列表顶部\n        recentChats.value.splice(index, 1);\n      }\n\n      // 添加到列表顶部\n      recentChats.value.unshift({\n        id: user.id,\n        username: user.username,\n        phone: user.phone,\n        photo: user.photo\n      });\n\n      // 限制列表长度为10\n      if (recentChats.value.length > 10) {\n        recentChats.value.pop();\n      }\n    };\n    const scrollToBottom = () => {\n      nextTick(() => {\n        if (messagesContainer.value) {\n          messagesContainer.value.scrollTop = messagesContainer.value.scrollHeight;\n        }\n      });\n    };\n    const currentMessages = computed(() => {\n      return allChats.value[currentChatUser.value.id] || [];\n    });\n    const getLastMessage = userId => {\n      const messages = allChats.value[userId] || [];\n      if (messages.length === 0) {\n        return '';\n      }\n      return messages[messages.length - 1].text;\n    };\n    const getLastMessageTime = userId => {\n      const messages = allChats.value[userId] || [];\n      if (messages.length === 0) {\n        return '';\n      }\n      return formatMessageTime(messages[messages.length - 1].time);\n    };\n    const formatMessageTime = time => {\n      if (!time) {\n        return '';\n      }\n      const date = new Date(time);\n      const now = new Date();\n\n      // 如果是今天的消息，显示时分\n      if (date.toDateString() === now.toDateString()) {\n        return date.toTimeString().substring(0, 5);\n      }\n\n      // 如果是昨天的消息，显示\"昨天\"\n      const yesterday = new Date();\n      yesterday.setDate(now.getDate() - 1);\n      if (date.toDateString() === yesterday.toDateString()) {\n        return \"昨天\";\n      }\n\n      // 否则显示月/日\n      return `${date.getMonth() + 1}/${date.getDate()}`;\n    };\n    return {\n      user,\n      displayName,\n      avatarUrl,\n      logout,\n      goToUserDetail,\n      isUserInfoOpen,\n      toggleUserInfo,\n      isSearchOpen,\n      searchKeyword,\n      searchResults,\n      isSearching,\n      toggleSearch,\n      searchUsers,\n      currentChatUser,\n      messageInput,\n      allChats,\n      recentChats,\n      currentMessages,\n      startChat,\n      closeChat,\n      sendMessage,\n      defaultAvatar,\n      API_CONFIG,\n      messagesContainer,\n      getLastMessage,\n      getLastMessageTime,\n      formatMessageTime\n    };\n  }\n};","map":{"version":3,"names":["computed","ref","nextTick","useStore","useRouter","defaultAvatar","API_CONFIG","axios","ElMessage","setup","store","router","messagesContainer","isUserInfoOpen","user","state","displayName","value","username","isSearchOpen","searchKeyword","searchResults","isSearching","currentChatUser","messageInput","allChats","recentChats","avatarUrl","photo","BASE_URL","logout","dispatch","push","goToUserDetail","id","toggleUserInfo","toggleSearch","searchUsers","trim","warning","response","get","params","keyword","headers","Authorization","token","data","console","log","error","startChat","updateRecentChats","scrollToBottom","closeChat","sendMessage","message","Date","now","text","fromMe","time","toISOString","simulateReply","delay","Math","floor","random","setTimeout","replies","randomReply","length","reply","index","findIndex","chat","splice","unshift","phone","pop","scrollTop","scrollHeight","currentMessages","getLastMessage","userId","messages","getLastMessageTime","formatMessageTime","date","toDateString","toTimeString","substring","yesterday","setDate","getDate","getMonth"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\views\\UserLayout.vue"],"sourcesContent":["<template>\r\n  <div class=\"user-page\">\r\n    <header class=\"header\">\r\n      <div class=\"header-left\">\r\n        <div class=\"user-info\" @click=\"goToUserDetail\">\r\n          <img :src=\"avatarUrl\" alt=\"用户头像\" class=\"avatar\" />\r\n          <span class=\"username\">{{ displayName }}</span>\r\n        </div>\r\n      </div>\r\n      \r\n      <div class=\"header-right\">\r\n        <button @click=\"logout\" class=\"logout-button\">退出登录</button>\r\n      </div>\r\n    </header>\r\n\r\n    <div class=\"main-layout\">\r\n      <aside class=\"sidebar\">\r\n        <!-- 搜索组件 -->\r\n        <div class=\"sidebar-search\">\r\n          <div class=\"search-toggle\" @click=\"toggleSearch\">\r\n            <i class=\"fa fa-search\" aria-hidden=\"true\"></i>\r\n            <span>搜索用户</span>\r\n          </div>\r\n          \r\n          <div v-if=\"isSearchOpen\" class=\"search-box\">\r\n            <div class=\"search-input-group\">\r\n              <input \r\n                type=\"text\" \r\n                v-model=\"searchKeyword\" \r\n                placeholder=\"搜索用户...\" \r\n                @keyup.enter=\"searchUsers\"\r\n              />\r\n              <button class=\"search-button\" @click=\"searchUsers\">\r\n                <i class=\"fa fa-search\" aria-hidden=\"true\"></i>\r\n              </button>\r\n              <button class=\"cancel-button\" @click=\"toggleSearch\">\r\n                取消\r\n              </button>\r\n            </div>\r\n            \r\n            <!-- 搜索结果列表 -->\r\n            <div v-if=\"isSearching\" class=\"search-loading\">\r\n              <i class=\"fa fa-spinner fa-spin\" aria-hidden=\"true\"></i> 搜索中...\r\n            </div>\r\n            \r\n            <div v-else-if=\"searchResults.length > 0\" class=\"search-results\">\r\n              <div \r\n                v-for=\"user in searchResults\" \r\n                :key=\"user.id\" \r\n                class=\"search-result-item\"\r\n                @click=\"startChat(user)\"\r\n              >\r\n                <div class=\"result-avatar-container\">\r\n                  <img \r\n                    :src=\"user.photo ? `${API_CONFIG.BASE_URL}${user.photo}` : defaultAvatar\" \r\n                    alt=\"用户头像\" \r\n                    class=\"result-avatar\"\r\n                  />\r\n                </div>\r\n                <div class=\"result-info\">\r\n                  <div class=\"result-name\">{{ user.username }}</div>\r\n                  <div class=\"result-phone\">{{ user.phone }}</div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            \r\n            <div v-else-if=\"searchKeyword && !isSearching\" class=\"no-results\">\r\n              没有找到匹配的用户\r\n            </div>\r\n          </div>\r\n        </div>\r\n        \r\n        <!-- 最近聊天列表 -->\r\n        <div class=\"chat-history\">\r\n          <div class=\"history-title\">最近聊天</div>\r\n          <div \r\n            v-for=\"chat in recentChats\" \r\n            :key=\"chat.id\" \r\n            class=\"chat-item\"\r\n            :class=\"{ 'active': currentChatUser && currentChatUser.id === chat.id }\"\r\n            @click=\"startChat(chat)\"\r\n          >\r\n            <div class=\"chat-avatar\">\r\n              <img \r\n                :src=\"chat.photo ? `${API_CONFIG.BASE_URL}${chat.photo}` : defaultAvatar\" \r\n                alt=\"聊天用户头像\" \r\n                class=\"avatar-sm\"\r\n              />\r\n            </div>\r\n            <div class=\"chat-info\">\r\n              <div class=\"chat-name\">{{ chat.username }}</div>\r\n              <div class=\"chat-message\">{{ getLastMessage(chat.id) || '开始聊天' }}</div>\r\n            </div>\r\n            <div class=\"chat-time\">{{ getLastMessageTime(chat.id) }}</div>\r\n          </div>\r\n        </div>\r\n        \r\n        <!-- 菜单 -->\r\n        <ul class=\"menu\">\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/user/dashboard\" class=\"menu-link\">仪表盘</router-link>\r\n          </li>\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/user-moment\" class=\"menu-link\">我相关</router-link>\r\n          </li>\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/moments\" class=\"menu-link\">朋友圈</router-link>\r\n          </li>\r\n          <li class=\"menu-item\">\r\n            <div @click=\"toggleUserInfo\" class=\"menu-title\">\r\n              用户信息\r\n              <span class=\"arrow\">{{ isUserInfoOpen ? '▼' : '▶' }}</span>\r\n            </div>\r\n            <ul v-if=\"isUserInfoOpen\" class=\"sub-menu\">\r\n              <li class=\"sub-menu-item\">\r\n                <router-link to=\"/user/userinfo/userlist\" class=\"sub-menu-link\">用户列表</router-link>\r\n              </li>\r\n              <li class=\"sub-menu-item2\">\r\n                <router-link to=\"/user/bigdatauser\" class=\"sub-menu-link\">大数据用户</router-link>\r\n              </li>\r\n            </ul>\r\n          </li>\r\n        </ul>\r\n      </aside>\r\n\r\n      <main class=\"main-content\">\r\n        <!-- 聊天界面 -->\r\n        <div v-if=\"currentChatUser.id\" class=\"chat-container\">\r\n          <div class=\"chat-header\">\r\n            <div class=\"back-button\" @click=\"closeChat\">\r\n              <i class=\"fa fa-arrow-left\" aria-hidden=\"true\"></i>\r\n            </div>\r\n            <div class=\"chat-title\">{{ currentChatUser.username }}</div>\r\n            <div class=\"chat-options\">\r\n              <button class=\"option-button\">\r\n                <i class=\"fa fa-info-circle\" aria-hidden=\"true\"></i>\r\n              </button>\r\n            </div>\r\n          </div>\r\n          \r\n          <div class=\"chat-messages\" ref=\"messagesContainer\">\r\n            <div v-if=\"currentMessages.length === 0\" class=\"empty-chat\">\r\n              开始和 {{ currentChatUser.username }} 聊天吧\r\n            </div>\r\n            \r\n            <div \r\n              v-for=\"(message, index) in currentMessages\" \r\n              :key=\"message.id || index\" \r\n              :class=\"['message-item', message.fromMe ? 'message-from-me' : 'message-from-other']\"\r\n            >\r\n              <div class=\"message-avatar\">\r\n                <img \r\n                  :src=\"message.fromMe ? avatarUrl : (currentChatUser.photo ? `${API_CONFIG.BASE_URL}${currentChatUser.photo}` : defaultAvatar)\" \r\n                  alt=\"头像\" \r\n                  class=\"avatar-sm\"\r\n                />\r\n              </div>\r\n              \r\n              <div class=\"message-content\">\r\n                <div class=\"message-bubble\">\r\n                  {{ message.text }}\r\n                </div>\r\n                <div class=\"message-time\">{{ formatMessageTime(message.time) }}</div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          \r\n          <div class=\"chat-input-area\">\r\n            <div class=\"input-tools\">\r\n              <button class=\"tool-button\">\r\n                <i class=\"fa fa-smile-o\" aria-hidden=\"true\"></i>\r\n              </button>\r\n              <button class=\"tool-button\">\r\n                <i class=\"fa fa-picture-o\" aria-hidden=\"true\"></i>\r\n              </button>\r\n              <button class=\"tool-button\">\r\n                <i class=\"fa fa-file-o\" aria-hidden=\"true\"></i>\r\n              </button>\r\n            </div>\r\n            \r\n            <div class=\"message-input-container\">\r\n              <input \r\n                type=\"text\" \r\n                v-model=\"messageInput\" \r\n                placeholder=\"输入消息...\" \r\n                @keyup.enter=\"sendMessage\"\r\n              />\r\n              <button class=\"send-button\" @click=\"sendMessage\">\r\n                发送\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        \r\n        <!-- 无聊天界面时的提示 -->\r\n        <div v-else class=\"empty-chat-view\">\r\n          <div class=\"empty-icon\">\r\n            <i class=\"fa fa-comments-o\" aria-hidden=\"true\"></i>\r\n          </div>\r\n          <div class=\"empty-text\">选择一个联系人开始聊天</div>\r\n        </div>\r\n      </main>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { computed, ref, nextTick } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { useRouter } from 'vue-router';\r\nimport defaultAvatar from '@/assets/default-avatar.png';\r\nimport { API_CONFIG } from '@/config/config';\r\nimport axios from 'axios';\r\nimport { ElMessage } from 'element-plus';\r\n\r\nexport default {\r\n  setup() {\r\n    const store = useStore();\r\n    const router = useRouter();\r\n    const messagesContainer = ref(null);\r\n    const isUserInfoOpen = ref(false);\r\n    const user = computed(() => store.state.user);\r\n    const displayName = computed(() => user.value?.username || '未登录');\r\n    \r\n    // 搜索相关状态\r\n    const isSearchOpen = ref(false);\r\n    const searchKeyword = ref('');\r\n    const searchResults = ref([]);\r\n    const isSearching = ref(false);\r\n    \r\n    // 聊天相关状态\r\n    const currentChatUser = ref({});\r\n    const messageInput = ref('');\r\n    const allChats = ref({}); // 所有聊天记录，按userId分组\r\n    const recentChats = ref([]); // 最近聊天列表\r\n    \r\n    const avatarUrl = computed(() => {\r\n      if (user.value?.photo) {\r\n        return `${API_CONFIG.BASE_URL}${user.value.photo}`;\r\n      }\r\n      return defaultAvatar;\r\n    });\r\n\r\n    const logout = () => {\r\n      store.dispatch('logout');\r\n      router.push('/login');\r\n    };\r\n\r\n    const goToUserDetail = () => {\r\n      router.push('/user/userinfo/' + user.value?.id);\r\n    };\r\n\r\n    const toggleUserInfo = () => {\r\n      isUserInfoOpen.value = !isUserInfoOpen.value;\r\n    };\r\n    \r\n    // 搜索相关方法\r\n    const toggleSearch = () => {\r\n      isSearchOpen.value = !isSearchOpen.value;\r\n      \r\n      // 关闭搜索时清空结果\r\n      if (!isSearchOpen.value) {\r\n        searchKeyword.value = '';\r\n        searchResults.value = [];\r\n      }\r\n    };\r\n    \r\n    const searchUsers = async () => {\r\n      if (!searchKeyword.value.trim()) {\r\n        ElMessage.warning('请输入搜索关键词');\r\n        return;\r\n      }\r\n      \r\n      isSearching.value = true;\r\n      \r\n      try {\r\n        // 调用搜索API\r\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/user/search`, {\r\n          params: {\r\n            keyword: searchKeyword.value.trim()\r\n          },\r\n          headers: { Authorization: `Bearer ${store.state.token}` }\r\n        });\r\n        \r\n        // 提取实际用户数据列表\r\n        searchResults.value = response.data.data || [];\r\n        console.log(\"搜索结果: \", searchResults.value);\r\n      } catch (error) {\r\n        console.error('搜索用户失败:', error);\r\n        ElMessage.error('搜索用户失败');\r\n      } finally {\r\n        isSearching.value = false;\r\n      }\r\n    };\r\n    \r\n    // 聊天相关方法\r\n    const startChat = (user) => {\r\n      // 更新当前聊天用户\r\n      currentChatUser.value = user;\r\n      \r\n      // 如果没有该用户的聊天记录，初始化一个空数组\r\n      if (!allChats.value[user.id]) {\r\n        allChats.value[user.id] = [];\r\n      }\r\n      \r\n      // 更新最近聊天列表\r\n      updateRecentChats(user);\r\n      \r\n      // 滚动到底部\r\n      scrollToBottom();\r\n    };\r\n    \r\n    const closeChat = () => {\r\n      currentChatUser.value = {};\r\n    };\r\n    \r\n    const sendMessage = () => {\r\n      if (!messageInput.value.trim()) {\r\n        return;\r\n      }\r\n      \r\n      const message = {\r\n        id: Date.now(),\r\n        text: messageInput.value.trim(),\r\n        fromMe: true,\r\n        time: new Date().toISOString()\r\n      };\r\n      \r\n      // 添加消息到聊天记录\r\n      if (!allChats.value[currentChatUser.value.id]) {\r\n        allChats.value[currentChatUser.value.id] = [];\r\n      }\r\n      \r\n      allChats.value[currentChatUser.value.id].push(message);\r\n      \r\n      // 清空输入框\r\n      messageInput.value = '';\r\n      \r\n      // 更新最近聊天列表\r\n      updateRecentChats(currentChatUser.value);\r\n      \r\n      // 滚动到底部\r\n      scrollToBottom();\r\n      \r\n      // 模拟对方回复\r\n      simulateReply();\r\n    };\r\n    \r\n    const simulateReply = () => {\r\n      if (!currentChatUser.value.id) {\r\n        return;\r\n      }\r\n      \r\n      // 延迟1-3秒回复\r\n      const delay = Math.floor(Math.random() * 2000) + 1000;\r\n      \r\n      setTimeout(() => {\r\n        const replies = [\r\n          \"好的，我明白了。\",\r\n          \"谢谢！\",\r\n          \"有什么我可以帮助你的吗？\",\r\n          \"哈哈，真有趣！\",\r\n          \"我稍后回复你。\",\r\n          \"是的，你说得对。\",\r\n          \"很高兴收到你的消息！\"\r\n        ];\r\n        \r\n        const randomReply = replies[Math.floor(Math.random() * replies.length)];\r\n        \r\n        const reply = {\r\n          id: Date.now(),\r\n          text: randomReply,\r\n          fromMe: false,\r\n          time: new Date().toISOString()\r\n        };\r\n        \r\n        allChats.value[currentChatUser.value.id].push(reply);\r\n        \r\n        // 更新最近聊天列表\r\n        updateRecentChats(currentChatUser.value);\r\n        \r\n        // 滚动到底部\r\n        scrollToBottom();\r\n      }, delay);\r\n    };\r\n    \r\n    const updateRecentChats = (user) => {\r\n      // 检查用户是否已在最近聊天列表中\r\n      const index = recentChats.value.findIndex(chat => chat.id === user.id);\r\n      \r\n      if (index > -1) {\r\n        // 如果已存在，移到列表顶部\r\n        recentChats.value.splice(index, 1);\r\n      }\r\n      \r\n      // 添加到列表顶部\r\n      recentChats.value.unshift({\r\n        id: user.id,\r\n        username: user.username,\r\n        phone: user.phone,\r\n        photo: user.photo\r\n      });\r\n      \r\n      // 限制列表长度为10\r\n      if (recentChats.value.length > 10) {\r\n        recentChats.va