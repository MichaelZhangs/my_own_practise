{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport { ref, onMounted, onUnmounted, computed } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { useStore } from 'vuex';\nimport axios from 'axios';\nimport DOMPurify from 'dompurify';\nimport defaultAvatar from '@/assets/default-avatar.png';\nimport { API_CONFIG } from '@/config/config';\nimport { ElMessage } from 'element-plus';\nexport default {\n  setup() {\n    const router = useRouter();\n    const store = useStore();\n    const moments = ref([]);\n    const loading = ref(false);\n    const noMore = ref(false);\n    const lastId = ref(null);\n    const pageSize = 10;\n\n    // 从 Vuex 获取当前用户信息\n    const currentUser = computed(() => store.state.user || {});\n    const getFullUrl = path => {\n      if (!path || path === defaultAvatar) {\n        return path;\n      }\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`;\n    };\n    const openImagePreview = url => {\n      window.open(url, '_blank');\n    };\n    // 媒体预览处理\n    const openMediaPreview = url => {\n      if (url.match(/\\.(mp4|mov|avi)$/i)) {\n        // 视频处理逻辑\n        window.open(url, '_blank');\n      } else {\n        // 图片预览实现（可以使用第三方库实现模态框预览）\n        window.open(url, '_blank');\n      }\n    };\n\n    // 获取视频类型\n    const getVideoType = url => {\n      const extension = url.split('.').pop().toLowerCase();\n      switch (extension) {\n        case 'mp4':\n          return 'video/mp4';\n        case 'mov':\n          return 'video/quicktime';\n        case 'avi':\n          return 'video/x-msvideo';\n        default:\n          return 'video/mp4';\n      }\n    };\n\n    // 获取动态数据\n    const fetchMoments = async () => {\n      if (loading.value || noMore.value) return;\n      loading.value = true;\n      try {\n        const params = {\n          limit: pageSize,\n          last_id: lastId.value\n        };\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/article/moments`, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          },\n          params\n        });\n\n        // 直接使用 Vuex 中的用户信息\n        const newMoments = response.data.map(moment => ({\n          ...moment,\n          user_id: moment.user_id,\n          user: {\n            username: moment.user?.username || '未知用户',\n            photo: moment.user?.photo || ''\n            // 其他用户字段...\n          },\n          isLiked: false,\n          // 新增：初始化是否点赞状态\n          commentInput: '',\n          // 新增：初始化评论输入内容\n          showCommentInput: false // 新增：初始化是否显示评论输入框\n        }));\n        if (newMoments.length < pageSize) {\n          noMore.value = true;\n        }\n        moments.value = [...moments.value, ...newMoments];\n        lastId.value = newMoments[newMoments.length - 1]?.id;\n      } catch (error) {\n        console.error('获取动态失败:', error);\n      } finally {\n        loading.value = false;\n      }\n    };\n\n    // 时间格式化\n    const formatTime = timestamp => {\n      const date = new Date(timestamp);\n      return `${date.getFullYear()}-${(date.getMonth() + 1).toString().padStart(2, '0')}-${date.getDate().toString().padStart(2, '0')} \n      ${date.getHours().toString().padStart(2, '0')}:${date.getMinutes().toString().padStart(2, '0')}`;\n    };\n\n    // 计算多久之前\n    const getTimeAgo = timestamp => {\n      const now = new Date();\n      const created = new Date(timestamp);\n      const diff = now - created;\n      const minutes = Math.floor(diff / (1000 * 60));\n      const hours = Math.floor(diff / (1000 * 60 * 60));\n      const days = Math.floor(diff / (1000 * 60 * 60 * 24));\n      if (minutes < 1) {\n        return '刚刚';\n      } else if (minutes < 60) {\n        return `${minutes} 分钟前`;\n      } else if (hours < 24) {\n        return `${hours} 小时前`;\n      } else {\n        return `${days} 天前`;\n      }\n    };\n\n    // HTML消毒\n    const sanitizeHtml = html => {\n      return DOMPurify.sanitize(html);\n    };\n    const handleScroll = () => {\n      const {\n        scrollTop,\n        clientHeight,\n        scrollHeight\n      } = document.documentElement;\n      if (scrollTop + clientHeight >= scrollHeight - 100 && !loading.value && !noMore.value) {\n        fetchMoments();\n      }\n    };\n    const deleteMoment = async momentId => {\n      try {\n        await axios.post(`${API_CONFIG.BASE_URL}/article/delete/moment`, {\n          moment_id: momentId\n        }, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        });\n        moments.value = moments.value.filter(moment => moment.id !== momentId);\n        ElMessage.success('动态删除成功');\n      } catch (error) {\n        console.error('删除动态失败:', error);\n        ElMessage.error('删除动态失败，请稍后重试');\n      }\n    };\n\n    // 点赞功能\n    const likeMoment = async momentId => {\n      try {\n        const targetMoment = moments.value.find(moment => moment.id === momentId);\n        targetMoment.isLiked = !targetMoment.isLiked;\n        const response = await axios.post(`${API_CONFIG.BASE_URL}/article/like_moment`, {\n          moment_id: momentId\n        }, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        });\n        if (response.data.success) {\n          targetMoment.stats.likes = response.data.likes;\n          ElMessage.success('点赞成功');\n        } else {\n          targetMoment.isLiked = !targetMoment.isLiked;\n          ElMessage.error('点赞失败，请稍后重试');\n        }\n      } catch (error) {\n        console.error('点赞失败:', error);\n        const targetMoment = moments.value.find(moment => moment.id === momentId);\n        targetMoment.isLiked = !targetMoment.isLiked;\n        ElMessage.error('点赞失败，请稍后重试');\n      }\n    };\n\n    // 切换评论输入框显示状态\n    const toggleCommentInput = moment => {\n      moment.showCommentInput = !moment.showCommentInput;\n      if (moment.showCommentInput) {\n        moment.commentInputContainerClass = 'active';\n      } else {\n        moment.commentInputContainerClass = '';\n      }\n    };\n\n    // 发布评论功能\n    const postComment = async momentId => {\n      const targetMoment = moments.value.find(moment => moment.id === momentId);\n      const commentText = targetMoment.commentInput;\n      if (commentText.trim() === '') {\n        ElMessage.warning('评论内容不能为空');\n        return;\n      }\n      try {\n        const response = await axios.post(`${API_CONFIG.BASE_URL}/article/post_comment`, {\n          moment_id: momentId,\n          comment: commentText\n        }, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        });\n        if (response.data.success) {\n          targetMoment.stats.comments = response.data.comments;\n          targetMoment.commentInput = '';\n          targetMoment.showCommentInput = false;\n          ElMessage.success('评论发布成功');\n        } else {\n          ElMessage.error('评论发布失败，请稍后重试');\n        }\n      } catch (error) {\n        console.error('评论发布失败:', error);\n        ElMessage.error('评论发布失败，请稍后重试');\n      }\n    };\n\n    // 给评论图标添加点击事件\n    const commentIconClick = moment => {\n      toggleCommentInput(moment);\n    };\n    onMounted(() => {\n      fetchMoments();\n      window.addEventListener('scroll', handleScroll);\n    });\n    onUnmounted(() => {\n      window.removeEventListener('scroll', handleScroll);\n    });\n    return {\n      getFullUrl,\n      openImagePreview,\n      moments,\n      currentUser,\n      formatTime,\n      sanitizeHtml,\n      defaultAvatar,\n      openMediaPreview,\n      getVideoType,\n      goToPublish: () => router.push('/publish'),\n      noMore,\n      loading,\n      getTimeAgo,\n      deleteMoment,\n      likeMoment,\n      toggleCommentInput,\n      postComment,\n      commentIconClick // 暴露评论图标点击方法\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","onUnmounted","computed","useRouter","useStore","axios","DOMPurify","defaultAvatar","API_CONFIG","ElMessage","setup","router","store","moments","loading","noMore","lastId","pageSize","currentUser","state","user","getFullUrl","path","startsWith","BASE_URL","openImagePreview","url","window","open","openMediaPreview","match","getVideoType","extension","split","pop","toLowerCase","fetchMoments","value","params","limit","last_id","response","get","headers","Authorization","token","newMoments","data","map","moment","user_id","username","photo","isLiked","commentInput","showCommentInput","length","id","error","console","formatTime","timestamp","date","Date","getFullYear","getMonth","toString","padStart","getDate","getHours","getMinutes","getTimeAgo","now","created","diff","minutes","Math","floor","hours","days","sanitizeHtml","html","sanitize","handleScroll","scrollTop","clientHeight","scrollHeight","document","documentElement","deleteMoment","momentId","post","moment_id","filter","success","likeMoment","targetMoment","find","stats","likes","toggleCommentInput","commentInputContainerClass","postComment","commentText","trim","warning","comment","comments","commentIconClick","addEventListener","removeEventListener","goToPublish","push"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\article\\UserMoments.vue"],"sourcesContent":["<template>\r\n  <div class=\"moments-page\">\r\n    <!-- 头部容器 -->\r\n    <div class=\"moments-header\">\r\n      <div class=\"header-content\">\r\n        <div class=\"title-container\">\r\n          <h1>朋友圈</h1>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 独立定位的发布按钮 -->\r\n    <button class=\"publish-btn\" @click=\"goToPublish\">+</button>\r\n\r\n    <!-- 内容容器 -->\r\n    <div class=\"moments-container\">\r\n      <div class=\"moments-list\">\r\n        <div \r\n          v-for=\"moment in moments\" \r\n          :key=\"moment.id\" \r\n          class=\"moment-item\"\r\n        >\r\n          <!-- 用户信息 -->\r\n          <div class=\"user-info\">\r\n            <img :src=\"getFullUrl(moment.user.photo) || defaultAvatar\" class=\"user-avatar\" />\r\n            <div class=\"user-details\">\r\n              <span class=\"username\">{{ moment.user.username }}</span>\r\n              <span class=\"post-time\">{{ formatTime(moment.created_at) }}</span>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- 动态内容 -->\r\n          <div class=\"moment-content\" v-html=\"sanitizeHtml(moment.content)\"></div>\r\n\r\n          <!-- 图片展示 -->\r\n          <div v-if=\"moment.media?.length\" class=\"media-grid\">\r\n            <div \r\n              v-for=\"(media, index) in moment.media\" \r\n              :key=\"index\"\r\n              class=\"media-item\"\r\n              :class=\"{ 'video-container': media.type === 'video' }\"\r\n            >\r\n              <img \r\n                v-if=\"media.type === 'image'\"\r\n                :src=\"getFullUrl(media.url)\"\r\n                @click=\"openImagePreview(getFullUrl(media.url))\"\r\n              />\r\n              <!-- 视频展示 -->\r\n              <video \r\n                v-else-if=\"media.type === 'video'\"\r\n                :src=\"getFullUrl(media.url)\"\r\n                controls\r\n                :poster=\"getFullUrl(media.thumbnail)\"   \r\n                @click.stop=\"handleVideoClick\"\r\n              >\r\n                <source :src=\"getFullUrl(media.url)\" :type=\"getVideoType(media.url)\">\r\n                您的浏览器不支持视频播放\r\n              </video>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- 点赞和评论区域 -->\r\n          <div class=\"moment-interaction\">\r\n            <div class=\"comment-container\">\r\n              <div class=\"comment-icon-container\">\r\n                <i class=\"fa-solid fa-comment\" @click=\"commentIconClick(moment)\"></i> \r\n              </div>\r\n              <span>{{ moment.stats.comments }}</span>\r\n              <div v-if=\"moment.showCommentInput\" :class=\"['comment-input-container', moment.commentInputContainerClass]\">\r\n                  <input \r\n                    type=\"text\" \r\n                    v-model=\"moment.commentInput\" \r\n                    placeholder=\"发表评论\"\r\n                  />\r\n                  <button @click=\"postComment(moment.id)\">发布</button>\r\n                </div>\r\n            </div>\r\n            <div class=\"like-container\">\r\n              <i \r\n                class=\"fa-solid fa-thumbs-up\" \r\n                :class=\"{ 'liked': moment.isLiked }\"\r\n                @click=\"likeMoment(moment.id)\"\r\n              ></i>\r\n              <span>{{ moment.stats.likes }}</span>\r\n            </div>\r\n          </div>\r\n\r\n          <!-- 底部操作区域 -->\r\n          <div class=\"moment-footer\">\r\n            <span class=\"time-ago\">{{ getTimeAgo(moment.created_at) }}</span>\r\n            <i \r\n              v-if=\"moment.user_id === currentUser.id\" \r\n              class=\"fa-solid fa-trash-can delete-btn\" \r\n              @click=\"deleteMoment(moment.id)\"\r\n            ></i>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div v-if=\"noMore\" class=\"no-more-message\">没有其他的内容了哦</div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted, onUnmounted, computed } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport { useStore } from 'vuex'\r\nimport axios from 'axios'\r\nimport DOMPurify from 'dompurify'\r\nimport defaultAvatar from '@/assets/default-avatar.png'\r\nimport { API_CONFIG } from '@/config/config'\r\nimport { ElMessage } from 'element-plus'\r\n\r\nexport default {\r\n  setup() {\r\n    const router = useRouter()\r\n    const store = useStore()\r\n    const moments = ref([])\r\n    const loading = ref(false)\r\n    const noMore = ref(false)\r\n    const lastId = ref(null)\r\n    const pageSize = 10\r\n\r\n    // 从 Vuex 获取当前用户信息\r\n    const currentUser = computed(() => store.state.user || {})\r\n\r\n    const getFullUrl = (path) => {\r\n      if (!path || path === defaultAvatar) {\r\n        return path\r\n      }\r\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`\r\n    }\r\n\r\n    const openImagePreview = (url) => {\r\n      window.open(url, '_blank')\r\n    }\r\n    // 媒体预览处理\r\n    const openMediaPreview = (url) => {\r\n      if (url.match(/\\.(mp4|mov|avi)$/i)) {\r\n        // 视频处理逻辑\r\n        window.open(url, '_blank')\r\n      } else {\r\n        // 图片预览实现（可以使用第三方库实现模态框预览）\r\n        window.open(url, '_blank')\r\n      }\r\n    }\r\n\r\n    // 获取视频类型\r\n    const getVideoType = (url) => {\r\n      const extension = url.split('.').pop().toLowerCase()\r\n      switch(extension) {\r\n        case 'mp4': return 'video/mp4'\r\n        case 'mov': return 'video/quicktime'\r\n        case 'avi': return 'video/x-msvideo'\r\n        default: return 'video/mp4'\r\n      }\r\n    }\r\n\r\n    // 获取动态数据\r\n    const fetchMoments = async () => {\r\n      if (loading.value || noMore.value) return\r\n      \r\n      loading.value = true\r\n      try {\r\n        const params = {\r\n          limit: pageSize,\r\n          last_id: lastId.value\r\n        }\r\n\r\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/article/moments`, {\r\n          headers: {\r\n            Authorization: `Bearer ${store.state.token}`\r\n          },\r\n          params\r\n        })\r\n\r\n        // 直接使用 Vuex 中的用户信息\r\n        const newMoments = response.data.map(moment => ({\r\n          ...moment,\r\n          user_id: moment.user_id,\r\n          user: {\r\n            username: moment.user?.username || '未知用户',\r\n            photo: moment.user?.photo || '',\r\n            // 其他用户字段...\r\n          },\r\n          isLiked: false, // 新增：初始化是否点赞状态\r\n          commentInput: '', // 新增：初始化评论输入内容\r\n          showCommentInput: false // 新增：初始化是否显示评论输入框\r\n        }))\r\n\r\n        if (newMoments.length < pageSize) {\r\n          noMore.value = true\r\n        }\r\n\r\n        moments.value = [...moments.value, ...newMoments]\r\n        lastId.value = newMoments[newMoments.length - 1]?.id\r\n      } catch (error) {\r\n        console.error('获取动态失败:', error)\r\n      } finally {\r\n        loading.value = false\r\n      }\r\n    }\r\n\r\n    // 时间格式化\r\n    const formatTime = (timestamp) => {\r\n      const date = new Date(timestamp)\r\n      return `${date.getFullYear()}-${(date.getMonth() + 1).toString().padStart(2, '0')}-${date.getDate().toString().padStart(2, '0')} \r\n      ${date.getHours().toString().padStart(2, '0')}:${date.getMinutes().toString().padStart(2, '0')}`\r\n    }\r\n\r\n    // 计算多久之前\r\n    const getTimeAgo = (timestamp) => {\r\n      const now = new Date()\r\n      const created = new Date(timestamp)\r\n      const diff = now - created\r\n\r\n      const minutes = Math.floor(diff / (1000 * 60))\r\n      const hours = Math.floor(diff / (1000 * 60 * 60))\r\n      const days = Math.floor(diff / (1000 * 60 * 60 * 24))\r\n\r\n      if (minutes < 1) {\r\n        return '刚刚'\r\n      } else if (minutes < 60) {\r\n        return `${minutes} 分钟前`\r\n      } else if (hours < 24) {\r\n        return `${hours} 小时前`\r\n      } else {\r\n        return `${days} 天前`\r\n      }\r\n    }\r\n\r\n    // HTML消毒\r\n    const sanitizeHtml = (html) => {\r\n      return DOMPurify.sanitize(html)\r\n    }\r\n\r\n    const handleScroll = () => {\r\n      const { scrollTop, clientHeight, scrollHeight } = document.documentElement;\r\n      if (scrollTop + clientHeight >= scrollHeight - 100 &&!loading.value &&!noMore.value) {\r\n        fetchMoments();\r\n      }\r\n    };\r\n\r\n    const deleteMoment = async (momentId) => {\r\n      try {\r\n        await axios.post(`${API_CONFIG.BASE_URL}/article/delete/moment`, {\r\n          moment_id: momentId\r\n        }, {\r\n          headers: {\r\n            Authorization: `Bearer ${store.state.token}`\r\n          }\r\n        })\r\n        moments.value = moments.value.filter(moment => moment.id!== momentId)\r\n        ElMessage.success('动态删除成功')\r\n      } catch (error) {\r\n        console.error('删除动态失败:', error)\r\n        ElMessage.error('删除动态失败，请稍后重试')\r\n      }\r\n    }\r\n\r\n    // 点赞功能\r\n    const likeMoment = async (momentId) => {\r\n      try {\r\n        const targetMoment = moments.value.find(moment => moment.id === momentId);\r\n        targetMoment.isLiked =!targetMoment.isLiked;\r\n        const response = await axios.post(`${API_CONFIG.BASE_URL}/article/like_moment`, {\r\n          moment_id: momentId\r\n        }, {\r\n          headers: {\r\n            Authorization: `Bearer ${store.state.token}`\r\n          }\r\n        });\r\n        if (response.data.success) {\r\n          targetMoment.stats.likes = response.data.likes;\r\n          ElMessage.success('点赞成功');\r\n        } else {\r\n          targetMoment.isLiked =!targetMoment.isLiked;\r\n          ElMessage.error('点赞失败，请稍后重试');\r\n        }\r\n      } catch (error) {\r\n        console.error('点赞失败:', error);\r\n        const targetMoment = moments.value.find(moment => moment.id === momentId);\r\n        targetMoment.isLiked =!targetMoment.isLiked;\r\n        ElMessage.error('点赞失败，请稍后重试');\r\n      }\r\n    }\r\n\r\n    // 切换评论输入框显示状态\r\n    const toggleCommentInput = (moment) => {\r\n      moment.showCommentInput =!moment.showCommentInput;\r\n      if (moment.showCommentInput) {\r\n        moment.commentInputContainerClass = 'active';\r\n      } else {\r\n        moment.commentInputContainerClass = '';\r\n      }\r\n    }\r\n\r\n    // 发布评论功能\r\n    const postComment = async (momentId) => {\r\n      const targetMoment = moments.value.find(moment => moment.id === momentId);\r\n      const commentText = targetMoment.commentInput;\r\n      if (commentText.trim() === '') {\r\n        ElMessage.warning('评论内容不能为空');\r\n        return;\r\n      }\r\n      try {\r\n        const response = await axios.post(`${API_CONFIG.BASE_URL}/article/post_comment`, {\r\n          moment_id: momentId,\r\n          comment: commentText\r\n        }, {\r\n          headers: {\r\n            Authorization: `Bearer ${store.state.token}`\r\n          }\r\n        });\r\n        if (response.data.success) {\r\n          targetMoment.stats.comments = response.data.comments;\r\n          targetMoment.commentInput = '';\r\n          targetMoment.showCommentInput = false;\r\n          ElMessage.success('评论发布成功');\r\n        } else {\r\n          ElMessage.error('评论发布失败，请稍后重试');\r\n        }\r\n      } catch (error) {\r\n        console.error('评论发布失败:', error);\r\n        ElMessage.error('评论发布失败，请稍后重试');\r\n      }\r\n    }\r\n\r\n    // 给评论图标添加点击事件\r\n    const commentIconClick = (moment) => {\r\n      toggleCommentInput(moment);\r\n    }\r\n\r\n    onMounted(() => {\r\n      fetchMoments()\r\n      window.addEventListener('scroll', handleScroll);\r\n    });\r\n\r\n    onUnmounted(() => {\r\n      window.removeEventListener('scroll', handleScroll);\r\n    });\r\n\r\n    return { \r\n      getFullUrl,\r\n      openImagePreview,\r\n      moments,\r\n      currentUser,\r\n      formatTime,\r\n      sanitizeHtml,\r\n      defaultAvatar,\r\n      openMediaPreview,\r\n      getVideoType,\r\n      goToPublish: () => router.push('/publish'),\r\n      noMore,\r\n      loading,\r\n      getTimeAgo,\r\n      deleteMoment,\r\n      likeMoment,\r\n      toggleCommentInput,\r\n      postComment,\r\n      commentIconClick // 暴露评论图标点击方法\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* 新增视频相关样式 */\r\n.video-container {\r\n  position: relative;\r\n  padding-top: 56.25%; /* 16:9 宽高比 */\r\n}\r\n\r\nvideo {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n  border-radius: 4px;\r\n  background: #000;\r\n}\r\n\r\n/* 调整媒体项高度 */\r\n.media-item {\r\n  height: 120px; /* 统一图片和视频