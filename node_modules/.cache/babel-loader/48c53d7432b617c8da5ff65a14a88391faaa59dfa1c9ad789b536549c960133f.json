{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport axios from \"axios\";\nexport default {\n  name: \"UserLogin\",\n  data() {\n    return {\n      loginType: \"phone\",\n      // 登录方式：phone 或 email\n      phone: \"\",\n      // 手机号\n      email: \"\",\n      // 邮箱\n      code: \"\",\n      // 验证码\n      loginResult: null,\n      // 登录结果\n      generatedCode: \"\",\n      // 从后端获取的验证码\n      showCodeModal: false,\n      // 是否显示验证码弹窗\n      loginButtonDisabled: false,\n      // 登录按钮是否禁用\n      loginButtonText: \"登录\",\n      // 登录按钮文本\n      countdown: 0 // 倒计时时间\n    };\n  },\n  computed: {\n    isLoginButtonDisabled() {\n      return this.loginButtonDisabled || this.countdown > 0;\n    }\n  },\n  methods: {\n    // 发送验证码\n    async sendCode() {\n      if (this.loginType === \"phone\" && !this.phone) {\n        alert(\"请输入手机号\");\n        return;\n      }\n      if (this.loginType === \"email\" && !this.email) {\n        alert(\"请输入邮箱\");\n        return;\n      }\n      try {\n        const username = this.loginType === \"phone\" ? this.phone : this.email;\n\n        // 调用后端接口获取验证码\n        const response = await axios.post(\"http://127.0.0.1:8000/api/send-code\", {\n          username\n        });\n\n        // 从后端获取验证码\n        this.generatedCode = response.data.code;\n\n        // 显示验证码弹窗\n        this.showCodeModal = true;\n      } catch (error) {\n        console.error(\"验证码请求失败：\", error.response?.data);\n        alert(\"验证码发送失败\");\n      }\n    },\n    // 填充验证码并关闭弹窗\n    fillCodeAndCloseModal() {\n      this.code = this.generatedCode; // 将验证码填充到输入框\n      this.showCodeModal = false; // 关闭弹窗\n    },\n    // 处理登录\n    async handleLogin() {\n      if (!this.code) {\n        alert(\"请输入验证码\");\n        return;\n      }\n\n      // 禁用登录按钮并启动倒计时\n      this.loginButtonDisabled = true;\n      this.startCountdown();\n      try {\n        const username = this.loginType === \"phone\" ? this.phone : this.email;\n        const password = this.code;\n\n        // 调用后端登录接口\n        const response = await axios.post(\"http://127.0.0.1:8000/api/login\", {\n          username,\n          password\n        }, {\n          headers: {\n            \"Content-Type\": \"application/json\"\n          }\n        });\n\n        // 登录成功\n        this.loginResult = {\n          success: true,\n          message: \"登录成功！\",\n          data: response.data\n        };\n\n        // 跳转到用户页面\n        this.$router.push(\"/user\");\n      } catch (error) {\n        // 登录失败\n        this.loginResult = {\n          success: false,\n          message: error.response?.data?.detail || \"登录失败\"\n        };\n      } finally {\n        // 无论成功或失败，恢复按钮状态\n        this.loginButtonDisabled = false;\n      }\n    },\n    // 启动倒计时\n    startCountdown() {\n      this.countdown = 60;\n      const timer = setInterval(() => {\n        this.countdown--;\n        if (this.countdown <= 0) {\n          clearInterval(timer);\n        }\n      }, 1000);\n    }\n  },\n  watch: {\n    countdown(newVal) {\n      this.loginButtonText = newVal > 0 ? `${newVal}s后重试` : \"登录\";\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","loginType","phone","email","code","loginResult","generatedCode","showCodeModal","loginButtonDisabled","loginButtonText","countdown","computed","isLoginButtonDisabled","methods","sendCode","alert","username","response","post","error","console","fillCodeAndCloseModal","handleLogin","startCountdown","password","headers","success","message","$router","push","detail","timer","setInterval","clearInterval","watch","newVal"],"sources":["E:\\vue_learn\\ai_vue\\ai_vue\\src\\components\\UserLogin.vue"],"sourcesContent":["<template>\r\n  <div class=\"login-wrapper\">\r\n    <div class=\"user-login-container\">\r\n      <h1>用户登录</h1>\r\n      <form @submit.prevent=\"handleLogin\">\r\n        <!-- 登录方式选择 -->\r\n        <div class=\"login-type\">\r\n          <label>\r\n            <input\r\n              type=\"radio\"\r\n              v-model=\"loginType\"\r\n              value=\"phone\"\r\n              checked\r\n            /> 短信登录\r\n          </label>\r\n          <label>\r\n            <input\r\n              type=\"radio\"\r\n              v-model=\"loginType\"\r\n              value=\"email\"\r\n            /> 邮箱登录\r\n          </label>\r\n        </div>\r\n\r\n        <!-- 手机号登录 -->\r\n        <div v-if=\"loginType === 'phone'\" class=\"input-group\">\r\n          <input\r\n            type=\"text\"\r\n            v-model=\"phone\"\r\n            placeholder=\"请输入手机号\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <!-- 邮箱登录 -->\r\n        <div v-else class=\"input-group\">\r\n          <input\r\n            type=\"email\"\r\n            v-model=\"email\"\r\n            placeholder=\"请输入邮箱\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <!-- 验证码输入 -->\r\n        <div class=\"input-group code-group\">\r\n          <input\r\n            type=\"text\"\r\n            v-model=\"code\"\r\n            placeholder=\"请输入验证码\"\r\n            required\r\n          />\r\n          <button type=\"button\" @click=\"sendCode\" class=\"code-button\">\r\n            获取验证码\r\n          </button>\r\n        </div>\r\n\r\n        <!-- 登录按钮 -->\r\n        <button type=\"submit\" class=\"login-button\" :disabled=\"isLoginButtonDisabled\">\r\n          {{ loginButtonText }}\r\n        </button>\r\n      </form>\r\n\r\n      <!-- 显示登录结果 -->\r\n      <div v-if=\"loginResult\" class=\"login-result\">\r\n        <p v-if=\"loginResult.success\">登录成功！</p>\r\n        <p v-else>登录失败：{{ loginResult.message }}</p>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 验证码弹窗 -->\r\n    <div v-if=\"showCodeModal\" class=\"modal-overlay\">\r\n      <div class=\"modal-content\">\r\n        <h3>验证码已发送</h3>\r\n        <p>您的验证码是：<strong>{{ generatedCode }}</strong></p>\r\n        <button @click=\"fillCodeAndCloseModal\">填充验证码并关闭</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from \"axios\";\r\n\r\nexport default {\r\n  name: \"UserLogin\",\r\n  data() {\r\n    return {\r\n      loginType: \"phone\", // 登录方式：phone 或 email\r\n      phone: \"\", // 手机号\r\n      email: \"\", // 邮箱\r\n      code: \"\", // 验证码\r\n      loginResult: null, // 登录结果\r\n      generatedCode: \"\", // 从后端获取的验证码\r\n      showCodeModal: false, // 是否显示验证码弹窗\r\n      loginButtonDisabled: false, // 登录按钮是否禁用\r\n      loginButtonText: \"登录\", // 登录按钮文本\r\n      countdown: 0, // 倒计时时间\r\n    };\r\n  },\r\n  computed: {\r\n    isLoginButtonDisabled() {\r\n      return this.loginButtonDisabled || this.countdown > 0;\r\n    },\r\n  },\r\n  methods: {\r\n    // 发送验证码\r\n    async sendCode() {\r\n      if (this.loginType === \"phone\" && !this.phone) {\r\n        alert(\"请输入手机号\");\r\n        return;\r\n      }\r\n      if (this.loginType === \"email\" && !this.email) {\r\n        alert(\"请输入邮箱\");\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const username = this.loginType === \"phone\" ? this.phone : this.email;\r\n\r\n        // 调用后端接口获取验证码\r\n        const response = await axios.post(\"http://127.0.0.1:8000/api/send-code\", {\r\n          username,\r\n        });\r\n\r\n        // 从后端获取验证码\r\n        this.generatedCode = response.data.code;\r\n\r\n        // 显示验证码弹窗\r\n        this.showCodeModal = true;\r\n      } catch (error) {\r\n        console.error(\"验证码请求失败：\", error.response?.data);\r\n        alert(\"验证码发送失败\");\r\n      }\r\n    },\r\n\r\n    // 填充验证码并关闭弹窗\r\n    fillCodeAndCloseModal() {\r\n      this.code = this.generatedCode; // 将验证码填充到输入框\r\n      this.showCodeModal = false; // 关闭弹窗\r\n    },\r\n\r\n    // 处理登录\r\n    async handleLogin() {\r\n      if (!this.code) {\r\n        alert(\"请输入验证码\");\r\n        return;\r\n      }\r\n\r\n      // 禁用登录按钮并启动倒计时\r\n      this.loginButtonDisabled = true;\r\n      this.startCountdown();\r\n\r\n      try {\r\n        const username = this.loginType === \"phone\" ? this.phone : this.email;\r\n        const password = this.code;\r\n\r\n        // 调用后端登录接口\r\n        const response = await axios.post(\r\n          \"http://127.0.0.1:8000/api/login\",\r\n          {\r\n            username,\r\n            password,\r\n          },\r\n          {\r\n            headers: {\r\n              \"Content-Type\": \"application/json\",\r\n            },\r\n          }\r\n        );\r\n\r\n        // 登录成功\r\n        this.loginResult = {\r\n          success: true,\r\n          message: \"登录成功！\",\r\n          data: response.data,\r\n        };\r\n\r\n        // 跳转到用户页面\r\n        this.$router.push(\"/user\");\r\n      } catch (error) {\r\n        // 登录失败\r\n        this.loginResult = {\r\n          success: false,\r\n          message: error.response?.data?.detail || \"登录失败\",\r\n        };\r\n      } finally {\r\n        // 无论成功或失败，恢复按钮状态\r\n        this.loginButtonDisabled = false;\r\n      }\r\n    },\r\n\r\n    // 启动倒计时\r\n    startCountdown() {\r\n      this.countdown = 60;\r\n      const timer = setInterval(() => {\r\n        this.countdown--;\r\n        if (this.countdown <= 0) {\r\n          clearInterval(timer);\r\n        }\r\n      }, 1000);\r\n    },\r\n  },\r\n  watch: {\r\n    countdown(newVal) {\r\n      this.loginButtonText = newVal > 0 ? `${newVal}s后重试` : \"登录\";\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* 样式保持不变 */\r\n.login-wrapper {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  height: 100vh;\r\n  background-color: #f5f5f5;\r\n}\r\n\r\n.user-login-container {\r\n  max-width: 400px;\r\n  width: 100%;\r\n  padding: 30px;\r\n  border-radius: 10px;\r\n  background-color: white;\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);\r\n}\r\n\r\nh1 {\r\n  text-align: center;\r\n  color: #333;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.login-type {\r\n  display: flex;\r\n  justify-content: center;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.login-type label {\r\n  margin: 0 10px;\r\n  font-size: 16px;\r\n}\r\n\r\n.input-group {\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.input-group input {\r\n  width: 100%;\r\n  padding: 10px;\r\n  border: 1px solid #ccc;\r\n  border-radius: 5px;\r\n  font-size: 16px;\r\n}\r\n\r\n.code-group {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.code-group input {\r\n  flex: 1;\r\n  margin-right: 10px;\r\n}\r\n\r\n.code-button {\r\n  padding: 10px 15px;\r\n  background-color: #42b983;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n  font-size: 14px;\r\n}\r\n\r\n.code-button:hover {\r\n  background-color: #369f6e;\r\n}\r\n\r\n.login-button {\r\n  width: 100%;\r\n  padding: 10px;\r\n  background-color: #42b983;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n  font-size: 16px;\r\n}\r\n\r\n.login-button:disabled {\r\n  background-color: #ccc;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.login-button:hover:not(:disabled) {\r\n  background-color: #369f6e;\r\n}\r\n\r\n.login-result {\r\n  margin-top: 20px;\r\n  text-align: center;\r\n  font-size: 16px;\r\n  color: #333;\r\n}\r\n\r\n/* 弹窗样式 */\r\n.modal-overlay {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background-color: rgba(0, 0, 0, 0.5);\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n\r\n.modal-content {\r\n  background-color: white;\r\n  padding: 20px;\r\n  border-radius: 10px;\r\n  text-align: center;\r\n}\r\n\r\n.modal-content h3 {\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.modal-content button {\r\n  margin-top: 10px;\r\n  padding: 10px 20px;\r\n  background-color: #42b983;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n}\r\n\r\n.modal-content button:hover {\r\n  background-color: #369f6e;\r\n}\r\n</style>"],"mappings":";AAkFA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE,OAAO;MAAE;MACpBC,KAAK,EAAE,EAAE;MAAE;M