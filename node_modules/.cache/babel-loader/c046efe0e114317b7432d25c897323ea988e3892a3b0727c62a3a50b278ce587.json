 fa-exclamation-triangle\",\n    \"aria-hidden\": \"true\"\n  }, null, -1 /* HOISTED */), _createTextVNode(\" 未连接 \")]))) : _createCommentVNode(\"v-if\", true), _createElementVNode(\"div\", _hoisted_20, [_createElementVNode(\"div\", _hoisted_21, [_createElementVNode(\"div\", _hoisted_22, [_createElementVNode(\"label\", _hoisted_23, [_cache[11] || (_cache[11] = _createElementVNode(\"i\", {\n    class: \"fa fa-video-camera\",\n    \"aria-hidden\": \"true\"\n  }, null, -1 /* HOISTED */)), _createElementVNode(\"input\", {\n    type: \"file\",\n    accept: \"video/*\",\n    onChange: _cache[1] || (_cache[1] = (...args) => $setup.handleFileUpload && $setup.handleFileUpload(...args)),\n    ref: \"videoInput\"\n  }, null, 544 /* NEED_HYDRATION, NEED_PATCH */)]), _cache[12] || (_cache[12] = _createElementVNode(\"span\", {\n    class: \"tooltip\"\n  }, \"视频\", -1 /* HOISTED */))]), _createElementVNode(\"div\", _hoisted_24, [_createElementVNode(\"label\", _hoisted_25, [_cache[13] || (_cache[13] = _createElementVNode(\"i\", {\n    class: \"fa fa-file\",\n    \"aria-hidden\": \"true\"\n  }, null, -1 /* HOISTED */)), _createElementVNode(\"input\", {\n    type: \"file\",\n    onChange: _cache[2] || (_cache[2] = (...args) => $setup.handleFileUpload && $setup.handleFileUpload(...args)),\n    ref: \"fileInput\"\n  }, null, 544 /* NEED_HYDRATION, NEED_PATCH */)]), _cache[14] || (_cache[14] = _createElementVNode(\"span\", {\n    class: \"tooltip\"\n  }, \"文件\", -1 /* HOISTED */))])])]), _createElementVNode(\"div\", _hoisted_26, [_createElementVNode(\"div\", {\n    class: \"emoji-btn\",\n    onClick: _cache[3] || (_cache[3] = (...args) => $setup.toggleEmojiPicker && $setup.toggleEmojiPicker(...args))\n  }, _cache[15] || (_cache[15] = [_createElementVNode(\"i\", {\n    class: \"fa-regular fa-face-smile\"\n  }, null, -1 /* HOISTED */)])), $setup.isUploading ? (_openBlock(), _createElementBlock(\"div\", _hoisted_27, [_createElementVNode(\"div\", {\n    class: \"upload-progress-bar\",\n    