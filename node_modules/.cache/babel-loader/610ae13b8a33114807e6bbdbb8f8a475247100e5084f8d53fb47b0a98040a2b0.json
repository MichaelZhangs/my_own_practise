{"ast":null,"code":"import { ref, nextTick, onBeforeUnmount } from 'vue';\nimport { useStore } from 'vuex';\nimport axios from 'axios';\nexport default {\n  __name: 'UserDetail',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const store = useStore();\n\n    // 响应式数据\n    const editableUser = ref({\n      ...store.state.user,\n      description: store.state.user.description || ''\n    });\n    const qrcodeUrl = ref('');\n    const isPhoneEditable = ref(false);\n    const smsCode = ref('');\n    const countdown = ref(0);\n    let timer = null;\n\n    // 生命周期钩子\n    onBeforeUnmount(() => {\n      if (timer) clearInterval(timer);\n    });\n\n    // 手机号编辑逻辑\n    const startPhoneEdit = async () => {\n      if (!isPhoneEditable.value) {\n        isPhoneEditable.value = true;\n        await nextTick();\n        document.querySelector('.sms-input')?.focus();\n      }\n    };\n    const handlePhoneBlur = () => {\n      if (smsCode.value === '') {\n        isPhoneEditable.value = false;\n      }\n    };\n\n    // 发送短信验证码\n    const sendSmsCode = async () => {\n      try {\n        const response = await axios.post('/user/send-sms', {\n          phone: editableUser.value.phone\n        });\n        if (response.data.message === '验证码已发送') {\n          countdown.value = 60;\n          timer = setInterval(() => {\n            countdown.value--;\n            if (countdown.value <= 0) clearInterval(timer);\n          }, 1000);\n        }\n      } catch (error) {\n        alert(error.response?.data?.detail || '验证码发送失败');\n      }\n    };\n\n    // 头像上传处理\n    const handleAvatarUpload = async event => {\n      const file = event.target.files?.[0];\n      if (file && file.type.startsWith('image/')) {\n        try {\n          const formData = new FormData();\n          formData.append('file', file);\n          const response = await axios.post('/user/upload-avatar', formData, {\n            headers: {\n              'Content-Type': 'multipart/form-data'\n            }\n          });\n          editableUser.value.photo = response.data.url;\n          await generateQRWithAvatar();\n        } catch (error) {\n          alert('头像上传失败，请重试');\n        }\n      }\n    };\n\n    // 生成二维码\n    const generateQRWithAvatar = async () => {\n      try {\n        const response = await axios.post('/user/generate-qrcode', {\n          username: editableUser.value.username,\n          phone: editableUser.value.phone,\n          avatar_url: editableUser.value.photo\n        });\n        qrcodeUrl.value = response.data.qrcode_url;\n        await store.dispatch('updateUser', {\n          ...editableUser.value,\n          qrcode: response.data.qrcode_url\n        });\n      } catch (error) {\n        alert('二维码生成失败，请重试');\n      }\n    };\n\n    // 保存用户信息\n    const saveUserInfo = async () => {\n      try {\n        // 手机号修改需要验证\n        if (isPhoneEditable.value) {\n          if (!smsCode.value) {\n            alert('请先完成短信验证');\n            return;\n          }\n          await axios.post('/user/update-phone', {\n            new_phone: editableUser.value.phone,\n            verification_code: smsCode.value\n          });\n        }\n\n        // 更新其他信息\n        await axios.put('/user/info', editableUser.value);\n\n        // 更新本地存储\n        await store.dispatch('updateUser', editableUser.value);\n        isPhoneEditable.value = false;\n        alert('信息保存成功!');\n      } catch (error) {\n        alert(error.response?.data?.detail || '保存失败，请检查输入');\n      }\n    };\n    const __returned__ = {\n      store,\n      editableUser,\n      qrcodeUrl,\n      isPhoneEditable,\n      smsCode,\n      countdown,\n      get timer() {\n        return timer;\n      },\n      set timer(v) {\n        timer = v;\n      },\n      startPhoneEdit,\n      handlePhoneBlur,\n      sendSmsCode,\n      handleAvatarUpload,\n      generateQRWithAvatar,\n      saveUserInfo,\n      ref,\n      nextTick,\n      onBeforeUnmount,\n      get useStore() {\n        return useStore;\n      },\n      get axios() {\n        return axios;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","nextTick","onBeforeUnmount","useStore","axios","store","editableUser","state","user","description","qrcodeUrl","isPhoneEditable","smsCode","countdown","timer","clearInterval","startPhoneEdit","value","document","querySelector","focus","handlePhoneBlur","sendSmsCode","response","post","phone","data","message","setInterval","error","alert","detail","handleAvatarUpload","event","file","target","files","type","startsWith","formData","FormData","append","headers","photo","url","generateQRWithAvatar","username","avatar_url","qrcode_url","dispatch","qrcode","saveUserInfo","new_phone","verification_code","put"],"sources":["E:/vue_learn/ai_vue/ai_vue/src/views/UserDetail.vue"],"sourcesContent":["<template>\r\n  <div class=\"user-detail-page\">\r\n    <h1 class=\"page-title\">用户详情</h1>\r\n    <div class=\"user-container\">\r\n      <!-- 可编辑头像 -->\r\n      <div class=\"avatar-wrapper\">\r\n        <label class=\"avatar-upload\">\r\n          <input \r\n            type=\"file\" \r\n            accept=\"image/*\" \r\n            @change=\"handleAvatarUpload\" \r\n            hidden\r\n          />\r\n          <img \r\n            :src=\"editableUser.photo || defaultAvatar\" \r\n            alt=\"用户头像\" \r\n            class=\"user-avatar\"\r\n          />\r\n          <span class=\"edit-tip\">点击更换头像</span>\r\n        </label>\r\n      </div>\r\n\r\n      <!-- 用户信息编辑 -->\r\n      <div class=\"info-section\">\r\n        <div class=\"info-item\">\r\n          <label>姓名：</label>\r\n          <input v-model=\"editableUser.username\" class=\"short-input\" />\r\n        </div>\r\n        \r\n        <div class=\"info-item\">\r\n          <label>性别：</label>\r\n          <select v-model=\"editableUser.sex\">\r\n            <option value=\"男\">男</option>\r\n            <option value=\"女\">女</option>\r\n          </select>\r\n        </div>\r\n\r\n        <div class=\"info-item\">\r\n          <label>手机：</label>\r\n          <div class=\"phone-edit-wrapper\">\r\n            <input\r\n              v-model=\"editableUser.phone\"\r\n              :readonly=\"!isPhoneEditable\"\r\n              class=\"short-input\"\r\n              @dblclick=\"startPhoneEdit\"\r\n              @blur=\"handlePhoneBlur\"\r\n            />\r\n            <span v-if=\"!isPhoneEditable\" class=\"edit-hint\">(双击修改)</span>\r\n            \r\n            <div v-if=\"isPhoneEditable\" class=\"sms-verify\">\r\n              <input\r\n                v-model=\"smsCode\"\r\n                placeholder=\"请输入验证码\"\r\n                class=\"sms-input\"\r\n              />\r\n              <button \r\n                class=\"sms-btn\"\r\n                :disabled=\"countdown > 0\"\r\n                @click=\"sendSmsCode\"\r\n              >\r\n                {{ countdown > 0 ? `${countdown}s后重试` : '获取验证码' }}\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <div class=\"info-item\">\r\n          <label>邮箱：</label>\r\n          <input v-model=\"editableUser.email\" class=\"short-input\" />\r\n        </div>\r\n\r\n        <div class=\"info-item\">\r\n          <label>描述：</label>\r\n          <input v-model=\"editableUser.description\" class=\"short-input\" />\r\n        </div>\r\n\r\n        <!-- 二维码展示 -->\r\n        <div class=\"info-item\">\r\n          <label class=\"qr-label\">我的二维码：</label>\r\n          <div class=\"qr-wrapper\" @click=\"generateQRWithAvatar\">\r\n            <img \r\n              :src=\"qrcodeUrl || defaultQR\" \r\n              alt=\"个人二维码\" \r\n              class=\"wechat-qr\"\r\n            />\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <button class=\"save-btn\" @click=\"saveUserInfo\">保存修改</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, nextTick, onBeforeUnmount } from 'vue'\r\nimport { useStore } from 'vuex'\r\nimport axios from 'axios'\r\n\r\nconst store = useStore()\r\n\r\n// 响应式数据\r\nconst editableUser = ref({\r\n  ...store.state.user,\r\n  description: store.state.user.description || ''\r\n})\r\nconst qrcodeUrl = ref('')\r\nconst isPhoneEditable = ref(false)\r\nconst smsCode = ref('')\r\nconst countdown = ref(0)\r\nlet timer = null\r\n\r\n// 生命周期钩子\r\nonBeforeUnmount(() => {\r\n  if (timer) clearInterval(timer)\r\n})\r\n\r\n// 手机号编辑逻辑\r\nconst startPhoneEdit = async () => {\r\n  if (!isPhoneEditable.value) {\r\n    isPhoneEditable.value = true\r\n    await nextTick()\r\n    document.querySelector('.sms-input')?.focus()\r\n  }\r\n}\r\n\r\nconst handlePhoneBlur = () => {\r\n  if (smsCode.value === '') {\r\n    isPhoneEditable.value = false\r\n  }\r\n}\r\n\r\n// 发送短信验证码\r\nconst sendSmsCode = async () => {\r\n  try {\r\n    const response = await axios.post('/user/send-sms', {\r\n      phone: editableUser.value.phone\r\n    })\r\n    \r\n    if (response.data.message === '验证码已发送') {\r\n      countdown.value = 60\r\n      timer = setInterval(() => {\r\n        countdown.value--\r\n        if (countdown.value <= 0) clearInterval(timer)\r\n      }, 1000)\r\n    }\r\n  } catch (error) {\r\n    alert(error.response?.data?.detail || '验证码发送失败')\r\n  }\r\n}\r\n\r\n// 头像上传处理\r\nconst handleAvatarUpload = async (event) => {\r\n  const file = event.target.files?.[0]\r\n  if (file && file.type.startsWith('image/')) {\r\n    try {\r\n      const formData = new FormData()\r\n      formData.append('file', file)\r\n      \r\n      const response = await axios.post('/user/upload-avatar', formData, {\r\n        headers: { 'Content-Type': 'multipart/form-data' }\r\n      })\r\n\r\n      editableUser.value.photo = response.data.url\r\n      await generateQRWithAvatar()\r\n    } catch (error) {\r\n      alert('头像上传失败，请重试')\r\n    }\r\n  }\r\n}\r\n\r\n// 生成二维码\r\nconst generateQRWithAvatar = async () => {\r\n  try {\r\n    const response = await axios.post('/user/generate-qrcode', {\r\n      username: editableUser.value.username,\r\n      phone: editableUser.value.phone,\r\n      avatar_url: editableUser.value.photo\r\n    })\r\n\r\n    qrcodeUrl.value = response.data.qrcode_url\r\n    await store.dispatch('updateUser', {\r\n      ...editableUser.value,\r\n      qrcode: response.data.qrcode_url\r\n    })\r\n  } catch (error) {\r\n    alert('二维码生成失败，请重试')\r\n  }\r\n}\r\n\r\n// 保存用户信息\r\nconst saveUserInfo = async () => {\r\n  try {\r\n    // 手机号修改需要验证\r\n    if (isPhoneEditable.value) {\r\n      if (!smsCode.value) {\r\n        alert('请先完成短信验证')\r\n        return\r\n      }\r\n\r\n      await axios.post('/user/update-phone', {\r\n        new_phone: editableUser.value.phone,\r\n        verification_code: smsCode.value\r\n      })\r\n    }\r\n\r\n    // 更新其他信息\r\n    await axios.put('/user/info', editableUser.value)\r\n    \r\n    // 更新本地存储\r\n    await store.dispatch('updateUser', editableUser.value)\r\n    isPhoneEditable.value = false\r\n    alert('信息保存成功!')\r\n  } catch (error) {\r\n    alert(error.response?.data?.detail || '保存失败，请检查输入')\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n/* 保持原有所有样式不变 */\r\n.user-detail-page {\r\n  max-width: 600px;\r\n  margin: 0 auto;\r\n  padding: 2rem;\r\n  font-family: 'Helvetica Neue', Arial, sans-serif;\r\n}\r\n\r\n.page-title {\r\n  text-align: center;\r\n  font-size: 1.5rem;\r\n  color: #333;\r\n  margin-bottom: 2rem;\r\n}\r\n\r\n.user-container {\r\n  background: #fff;\r\n  border-radius: 12px;\r\n  padding: 1.5rem;\r\n  box-shadow: 0 2px 8px rgba(0,0,0,0.1);\r\n}\r\n\r\n.avatar-wrapper {\r\n  text-align: center;\r\n  margin-bottom: 1.5rem;\r\n}\r\n\r\n.user-avatar {\r\n  width: 100px;\r\n  height: 100px;\r\n  border-radius: 50%;\r\n  border: 3px solid #07c160;\r\n  cursor: pointer;\r\n  transition: transform 0.3s ease;\r\n}\r\n\r\n.user-avatar:hover {\r\n  transform: scale(1.05);\r\n}\r\n\r\n.edit-tip {\r\n  display: block;\r\n  color: #666;\r\n  font-size: 0.8rem;\r\n  margin-top: 0.5rem;\r\n}\r\n\r\n.info-section {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1rem;\r\n}\r\n\r\n.info-item {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 1rem;\r\n}\r\n\r\n.info-item label {\r\n  flex: 0 0 100px;\r\n  text-align: left;\r\n  color: #666;\r\n  font-size: 0.9rem;\r\n  margin-right: 15px;\r\n}\r\n\r\n.short-input, select {\r\n  flex: 1;\r\n  padding: 0.5rem;\r\n  border: 1px solid #ddd;\r\n  border-radius: 4px;\r\n  max-width: 300px;\r\n  font-size: 0.9rem;\r\n}\r\n\r\nselect {\r\n  background: white;\r\n  cursor: pointer;\r\n}\r\n\r\n.qr-wrapper {\r\n  flex: 1;\r\n  cursor: pointer;\r\n}\r\n\r\n.wechat-qr {\r\n  width: 160px;\r\n  height: 160px;\r\n  border: 3px solid #07c160;\r\n  border-radius: 8px;\r\n  padding: 5px;\r\n  background: white;\r\n  transition: transform 0.3s ease;\r\n}\r\n\r\n.wechat-qr:hover {\r\n  transform: scale(1.05);\r\n}\r\n\r\n.save-btn {\r\n  display: block;\r\n  width: 200px;\r\n  padding: 0.8rem;\r\n  margin: 2rem auto 0;\r\n  background: #07c160;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 25px;\r\n  cursor: pointer;\r\n  font-size: 1rem;\r\n  transition: background 0.3s ease;\r\n}\r\n\r\n.save-btn:hover {\r\n  background: #05964d;\r\n}\r\n\r\n@media (max-width: 480px) {\r\n  .user-container {\r\n    padding: 1rem;\r\n  }\r\n\r\n  .info-item {\r\n    flex-direction: column;\r\n    align-items: flex-start;\r\n  }\r\n\r\n  .info-item label {\r\n    text-align: left;\r\n    flex: none;\r\n  }\r\n\r\n  .short-input, select {\r\n    max-width: 100%;\r\n    width: 100%;\r\n  }\r\n\r\n  .wechat-qr {\r\n    width: 140px;\r\n    height: 140px;\r\n  }\r\n}\r\n\r\n/* 手机号编辑相关样式 */\r\n.phone-edit-wrapper {\r\n  position: relative;\r\n  flex: 1;\r\n}\r\n\r\n.edit-hint {\r\n  color: #999;\r\n  font-size: 0.8rem;\r\n  margin-left: 10px;\r\n}\r\n\r\n.sms-verify {\r\n  margin-top: 10px;\r\n  display: flex;\r\n  gap: 10px;\r\n}\r\n\r\n.sms-input {\r\n  flex: 1;\r\n  max-width: 150px;\r\n  padding: 8px;\r\n  border: 1px solid #ddd;\r\n  border-radius: 4px;\r\n}\r\n\r\n.sms-btn {\r\n  padding: 8px 15px;\r\n  background: #07c160;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n}\r\n\r\n.sms-btn:disabled {\r\n  background: #ccc;\r\n  cursor: not-allowed;\r\n}\r\n\r\ninput:read-only {\r\n  background-color: #f5f5f5;\r\n  cursor: not-allowed;\r\n}\r\n</style>"],"mappings":"AA+FA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,eAAe,QAAQ,KAAK;AACpD,SAASC,QAAQ,QAAQ,MAAM;AAC/B,OAAOC,KAAK,MAAM,OAAO;;;;;;;IAEzB,MAAMC,KAAK,GAAGF,QAAQ,CAAC,CAAC;;IAExB;IACA,MAAMG,YAAY,GAAGN,GAAG,CAAC;MACvB,GAAGK,KAAK,CAACE,KAAK,CAACC,IAAI;MACnBC,WAAW,EAAEJ,KAAK,CAACE,KAAK,CAACC,IAAI,CAACC,WAAW,IAAI;IAC/C,CAAC,CAAC;IACF,MAAMC,SAAS,GAAGV,GAAG,CAAC,EAAE,CAAC;IACzB,MAAMW,eAAe,GAAGX,GAAG,CAAC,KAAK,CAAC;IAClC,MAAMY,OAAO,GAAGZ,GAAG,CAAC,EAAE,CAAC;IACvB,MAAMa,SAAS,GAAGb,GAAG,CAAC,CAAC,CAAC;IACxB,IAAIc,KAAK,GAAG,IAAI;;IAEhB;IACAZ,eAAe,CAAC,MAAM;MACpB,IAAIY,KAAK,EAAEC,aAAa,CAACD,KAAK,CAAC;IACjC,CAAC,CAAC;;IAEF;IACA,MAAME,cAAc,GAAG,MAAAA,CAAA,KAAY;MACjC,IAAI,CAACL,eAAe,CAACM,KAAK,EAAE;QAC1BN,eAAe,CAACM,KAAK,GAAG,IAAI;QAC5B,MAAMhB,QAAQ,CAAC,CAAC;QAChBiB,QAAQ,CAACC,aAAa,CAAC,YAAY,CAAC,EAAEC,KAAK,CAAC,CAAC;MAC/C;IACF,CAAC;IAED,MAAMC,eAAe,GAAGA,CAAA,KAAM;MAC5B,IAAIT,OAAO,CAACK,KAAK,KAAK,EAAE,EAAE;QACxBN,eAAe,CAACM,KAAK,GAAG,KAAK;MAC/B;IACF,CAAC;;IAED;IACA,MAAMK,WAAW,GAAG,MAAAA,CAAA,KAAY;MAC9B,IAAI;QACF,MAAMC,QAAQ,GAAG,MAAMnB,KAAK,CAACoB,IAAI,CAAC,gBAAgB,EAAE;UAClDC,KAAK,EAAEnB,YAAY,CAACW,KAAK,CAACQ;QAC5B,CAAC,CAAC;QAEF,IAAIF,QAAQ,CAACG,IAAI,CAACC,OAAO,KAAK,QAAQ,EAAE;UACtCd,SAAS,CAACI,KAAK,GAAG,EAAE;UACpBH,KAAK,GAAGc,WAAW,CAAC,MAAM;YACxBf,SAAS,CAACI,KAAK,EAAE;YACjB,IAAIJ,SAAS,CAACI,KAAK,IAAI,CAAC,EAAEF,aAAa,CAACD,KAAK,CAAC;UAChD,CAAC,EAAE,IAAI,CAAC;QACV;MACF,CAAC,CAAC,OAAOe,KAAK,EAAE;QACdC,KAAK,CAACD,KAAK,CAACN,QAAQ,EAAEG,IAAI,EAAEK,MAAM,IAAI,SAAS,CAAC;MAClD;IACF,CAAC;;IAED;IACA,MAAMC,kBAAkB,GAAG,MAAOC,KAAK,IAAK;MAC1C,MAAMC,IAAI,GAAGD,KAAK,CAACE,MAAM,CAACC,KAAK,GAAG,CAAC,CAAC;MACpC,IAAIF,IAAI,IAAIA,IAAI,CAACG,IAAI,CAACC,UAAU,CAAC,QAAQ,CAAC,EAAE;QAC1C,IAAI;UACF,MAAMC,QAAQ,GAAG,IAAIC,QAAQ,CAAC,CAAC;UAC/BD,QAAQ,CAACE,MAAM,CAAC,MAAM,EAAEP,IAAI,CAAC;UAE7B,MAAMX,QAAQ,GAAG,MAAMnB,KAAK,CAACoB,IAAI,CAAC,qBAAqB,EAAEe,QAAQ,EAAE;YACjEG,OAAO,EAAE;cAAE,cAAc,EAAE;YAAsB;UACnD,CAAC,CAAC;UAEFpC,YAAY,CAACW,KAAK,CAAC0B,KAAK,GAAGpB,QAAQ,CAACG,IAAI,CAACkB,GAAG;UAC5C,MAAMC,oBAAoB,CAAC,CAAC;QAC9B,CAAC,CAAC,OAAOhB,KAAK,EAAE;UACdC,KAAK,CAAC,YAAY,CAAC;QACrB;MACF;IACF,CAAC;;IAED;IACA,MAAMe,oBAAoB,GAAG,MAAAA,CAAA,KAAY;MACvC,IAAI;QACF,MAAMtB,QAAQ,GAAG,MAAMnB,KAAK,CAACoB,IAAI,CAAC,uBAAuB,EAAE;UACzDsB,QAAQ,EAAExC,YAAY,CAACW,KAAK,CAAC6B,QAAQ;UACrCrB,KAAK,EAAEnB,YAAY,CAACW,KAAK,CAACQ,KAAK;UAC/BsB,UAAU,EAAEzC,YAAY,CAACW,KAAK,CAAC0B;QACjC,CAAC,CAAC;QAEFjC,SAAS,CAACO,KAAK,GAAGM,QAAQ,CAACG,IAAI,CAACsB,UAAU;QAC1C,MAAM3C,KAAK,CAAC4C,QAAQ,CAAC,YAAY,EAAE;UACjC,GAAG3C,YAAY,CAACW,KAAK;UACrBiC,MAAM,EAAE3B,QAAQ,CAACG,IAAI,CAACsB;QACxB,CAAC,CAAC;MACJ,CAAC,CAAC,OAAOnB,KAAK,EAAE;QACdC,KAAK,CAAC,aAAa,CAAC;MACtB;IACF,CAAC;;IAED;IACA,MAAMqB,YAAY,GAAG,MAAAA,CAAA,KAAY;MAC/B,IAAI;QACF;QACA,IAAIxC,eAAe,CAACM,KAAK,EAAE;UACzB,IAAI,CAACL,OAAO,CAACK,KAAK,EAAE;YAClBa,KAAK,CAAC,UAAU,CAAC;YACjB;UACF;UAEA,MAAM1B,KAAK,CAACoB,IAAI,CAAC,oBAAoB,EAAE;YACrC4B,SAAS,EAAE9C,YAAY,CAACW,KAAK,CAACQ,KAAK;YACnC4B,iBAAiB,EAAEzC,OAAO,CAACK;UAC7B,CAAC,CAAC;QACJ;;QAEA;QACA,MAAMb,KAAK,CAACkD,GAAG,CAAC,YAAY,EAAEhD,YAAY,CAACW,KAAK,CAAC;;QAEjD;QACA,MAAMZ,KAAK,CAAC4C,QAAQ,CAAC,YAAY,EAAE3C,YAAY,CAACW,KAAK,CAAC;QACtDN,eAAe,CAACM,KAAK,GAAG,KAAK;QAC7Ba,KAAK,CAAC,SAAS,CAAC;MAClB,CAAC,CAAC,OAAOD,KAAK,EAAE;QACdC,KAAK,CAACD,KAAK,CAACN,QAAQ,EAAEG,IAAI,EAAEK,MAAM,IAAI,YAAY,CAAC;MACrD;IACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}