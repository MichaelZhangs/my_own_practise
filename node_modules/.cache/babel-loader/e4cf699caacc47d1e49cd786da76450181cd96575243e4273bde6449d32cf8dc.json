{"ast":null,"code":"import { ref } from 'vue';\nimport { useStore } from 'vuex';\nimport QRCode from 'qrcode';\nimport defaultAvatar from '@/assets/default-avatar.png';\nimport defaultQR from '@/assets/logo.png';\nexport default {\n  __name: 'UserDetail',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const store = useStore();\n\n    // 响应式数据\n    const editableUser = ref({\n      ...store.state.user,\n      description: store.state.user.description || ''\n    });\n    const qrcodeUrl = ref(defaultQR);\n\n    // 头像上传处理\n    const handleAvatarUpload = event => {\n      const file = event.target.files?.[0];\n      if (file && file.type.startsWith('image/')) {\n        const reader = new FileReader();\n        reader.onload = e => {\n          editableUser.value.photo = e.target.result;\n        };\n        reader.readAsDataURL(file);\n      }\n    };\n\n    // 生成带头像的二维码\n    const generateQRWithAvatar = async () => {\n      try {\n        const userData = {\n          name: editableUser.value.username,\n          phone: editableUser.value.phone,\n          email: editableUser.value.email,\n          description: editableUser.value.description\n        };\n\n        // 生成基础二维码\n        const canvas = document.createElement('canvas');\n        await QRCode.toCanvas(canvas, JSON.stringify(userData), {\n          width: 200,\n          margin: 2,\n          color: {\n            dark: '#07c160',\n            // 微信绿\n            light: '#ffffff'\n          },\n          errorCorrectionLevel: 'H'\n        });\n\n        // 添加圆形头像\n        const ctx = canvas.getContext('2d');\n        const avatarImg = new Image();\n        avatarImg.src = editableUser.value.photo || defaultAvatar;\n        await new Promise(resolve => {\n          avatarImg.onload = resolve;\n          avatarImg.onerror = resolve;\n        });\n        ctx.beginPath();\n        ctx.arc(100, 100, 25, 0, Math.PI * 2);\n        ctx.clip();\n        ctx.drawImage(avatarImg, 75, 75, 50, 50);\n        qrcodeUrl.value = canvas.toDataURL();\n      } catch (error) {\n        console.error('二维码生成失败:', error);\n        alert('二维码生成失败，请重试');\n      }\n    };\n\n    // 保存用户信息\n    const saveUserInfo = async () => {\n      try {\n        await store.dispatch('updateUser', editableUser.value);\n        alert('信息保存成功!');\n      } catch (error) {\n        console.error('保存失败:', error);\n        alert('保存失败，请检查网络后重试');\n      }\n    };\n    const __returned__ = {\n      store,\n      editableUser,\n      qrcodeUrl,\n      handleAvatarUpload,\n      generateQRWithAvatar,\n      saveUserInfo,\n      ref,\n      get useStore() {\n        return useStore;\n      },\n      get QRCode() {\n        return QRCode;\n      },\n      get defaultAvatar() {\n        return defaultAvatar;\n      },\n      get defaultQR() {\n        return defaultQR;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","useStore","QRCode","defaultAvatar","defaultQR","store","editableUser","state","user","description","qrcodeUrl","handleAvatarUpload","event","file","target","files","type","startsWith","reader","FileReader","onload","e","value","photo","result","readAsDataURL","generateQRWithAvatar","userData","name","username","phone","email","canvas","document","createElement","toCanvas","JSON","stringify","width","margin","color","dark","light","errorCorrectionLevel","ctx","getContext","avatarImg","Image","src","Promise","resolve","onerror","beginPath","arc","Math","PI","clip","drawImage","toDataURL","error","console","alert","saveUserInfo","dispatch"],"sources":["E:/vue_learn/ai_vue/ai_vue/src/views/UserDetail.vue"],"sourcesContent":["<template>\r\n    <div class=\"user-detail-page\">\r\n      <h1 class=\"page-title\">用户详情</h1>\r\n      <div class=\"user-container\">\r\n        <!-- 可编辑头像 -->\r\n        <div class=\"avatar-wrapper\">\r\n          <label class=\"avatar-upload\">\r\n            <input \r\n              type=\"file\" \r\n              accept=\"image/*\" \r\n              @change=\"handleAvatarUpload\" \r\n              hidden\r\n            />\r\n            <img \r\n              :src=\"editableUser.photo || defaultAvatar\" \r\n              alt=\"用户头像\" \r\n              class=\"user-avatar\"\r\n            />\r\n            <span class=\"edit-tip\">点击更换头像</span>\r\n          </label>\r\n        </div>\r\n  \r\n        <!-- 用户信息编辑 -->\r\n        <div class=\"info-section\">\r\n          <div class=\"info-item\">\r\n            <label>姓名：</label>\r\n            <input v-model=\"editableUser.username\" class=\"short-input\" />\r\n          </div>\r\n          \r\n          <div class=\"info-item\">\r\n            <label>性别：</label>\r\n            <select v-model=\"editableUser.sex\">\r\n              <option value=\"男\">男</option>\r\n              <option value=\"女\">女</option>\r\n            </select>\r\n          </div>\r\n  \r\n          <div class=\"info-item\">\r\n            <label>手机：</label>\r\n            <input v-model=\"editableUser.phone\" class=\"short-input\" />\r\n          </div>\r\n  \r\n          <div class=\"info-item\">\r\n            <label>邮箱：</label>\r\n            <input v-model=\"editableUser.email\" class=\"short-input\" />\r\n          </div>\r\n  \r\n          <div class=\"info-item\">\r\n            <label>描述：</label>\r\n            <input v-model=\"editableUser.description\" class=\"short-input\" />\r\n          </div>\r\n  \r\n          <!-- 二维码展示 -->\r\n          <div class=\"info-item\">\r\n            <label>我的二维码：</label>\r\n            <div class=\"qr-wrapper\" @click=\"generateQRWithAvatar\">\r\n              <img \r\n                :src=\"qrcodeUrl || defaultQR\" \r\n                alt=\"个人二维码\" \r\n                class=\"wechat-qr\"\r\n              />\r\n            </div>\r\n          </div>\r\n        </div>\r\n  \r\n        <!-- 保存按钮 -->\r\n        <button class=\"save-btn\" @click=\"saveUserInfo\">保存修改</button>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script setup>\r\n  import { ref } from 'vue'\r\n  import { useStore } from 'vuex'\r\n  import QRCode from 'qrcode'\r\n  import defaultAvatar from '@/assets/default-avatar.png'\r\n  import defaultQR from '@/assets/logo.png'\r\n  \r\n  const store = useStore()\r\n  \r\n  // 响应式数据\r\n  const editableUser = ref({\r\n    ...store.state.user,\r\n    description: store.state.user.description || ''\r\n  })\r\n  const qrcodeUrl = ref(defaultQR)\r\n  \r\n  // 头像上传处理\r\n  const handleAvatarUpload = (event) => {\r\n    const file = event.target.files?.[0]\r\n    if (file && file.type.startsWith('image/')) {\r\n      const reader = new FileReader()\r\n      reader.onload = (e) => {\r\n        editableUser.value.photo = e.target.result\r\n      }\r\n      reader.readAsDataURL(file)\r\n    }\r\n  }\r\n  \r\n  // 生成带头像的二维码\r\n  const generateQRWithAvatar = async () => {\r\n    try {\r\n      const userData = {\r\n        name: editableUser.value.username,\r\n        phone: editableUser.value.phone,\r\n        email: editableUser.value.email,\r\n        description: editableUser.value.description\r\n      }\r\n  \r\n      // 生成基础二维码\r\n      const canvas = document.createElement('canvas')\r\n      await QRCode.toCanvas(canvas, JSON.stringify(userData), {\r\n        width: 200,\r\n        margin: 2,\r\n        color: {\r\n          dark: '#07c160', // 微信绿\r\n          light: '#ffffff'\r\n        },\r\n        errorCorrectionLevel: 'H'\r\n      })\r\n  \r\n      // 添加圆形头像\r\n      const ctx = canvas.getContext('2d')\r\n      const avatarImg = new Image()\r\n      avatarImg.src = editableUser.value.photo || defaultAvatar\r\n      \r\n      await new Promise((resolve) => {\r\n        avatarImg.onload = resolve\r\n        avatarImg.onerror = resolve\r\n      })\r\n  \r\n      ctx.beginPath()\r\n      ctx.arc(100, 100, 25, 0, Math.PI * 2)\r\n      ctx.clip()\r\n      ctx.drawImage(avatarImg, 75, 75, 50, 50)\r\n  \r\n      qrcodeUrl.value = canvas.toDataURL()\r\n    } catch (error) {\r\n      console.error('二维码生成失败:', error)\r\n      alert('二维码生成失败，请重试')\r\n    }\r\n  }\r\n  \r\n  // 保存用户信息\r\n  const saveUserInfo = async () => {\r\n    try {\r\n      await store.dispatch('updateUser', editableUser.value)\r\n      alert('信息保存成功!')\r\n    } catch (error) {\r\n      console.error('保存失败:', error)\r\n      alert('保存失败，请检查网络后重试')\r\n    }\r\n  }\r\n  </script>\r\n  \r\n  <style scoped>\r\n  /* 基础布局 */\r\n  .user-detail-page {\r\n    max-width: 600px;\r\n    margin: 0 auto;\r\n    padding: 2rem;\r\n    font-family: 'Helvetica Neue', Arial, sans-serif;\r\n  }\r\n  \r\n  .page-title {\r\n    text-align: center;\r\n    font-size: 1.5rem;\r\n    color: #333;\r\n    margin-bottom: 2rem;\r\n  }\r\n  \r\n  .user-container {\r\n    background: #fff;\r\n    border-radius: 12px;\r\n    padding: 1.5rem;\r\n    box-shadow: 0 2px 8px rgba(0,0,0,0.1);\r\n  }\r\n  \r\n  /* 头像样式 */\r\n  .avatar-wrapper {\r\n    text-align: center;\r\n    margin-bottom: 1.5rem;\r\n  }\r\n  \r\n  .user-avatar {\r\n    width: 100px;\r\n    height: 100px;\r\n    border-radius: 50%;\r\n    border: 3px solid #07c160;\r\n    cursor: pointer;\r\n    transition: transform 0.3s ease;\r\n  }\r\n  \r\n  .user-avatar:hover {\r\n    transform: scale(1.05);\r\n  }\r\n  \r\n  .edit-tip {\r\n    display: block;\r\n    color: #666;\r\n    font-size: 0.8rem;\r\n    margin-top: 0.5rem;\r\n  }\r\n  \r\n  /* 信息项样式 */\r\n  .info-section {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 1rem;\r\n  }\r\n  \r\n  .info-item {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 1rem;\r\n  }\r\n  \r\n  .info-item label {\r\n    flex: 0 0 100px;\r\n    text-align: right;\r\n    color: #666;\r\n    font-size: 0.9rem;\r\n  }\r\n  \r\n  /* 输入控件样式 */\r\n  .short-input, select {\r\n    flex: 1;\r\n    padding: 0.5rem;\r\n    border: 1px solid #ddd;\r\n    border-radius: 4px;\r\n    max-width: 300px;\r\n    font-size: 0.9rem;\r\n  }\r\n  \r\n  select {\r\n    background: white;\r\n    cursor: pointer;\r\n  }\r\n  \r\n  /* 二维码区域 */\r\n  .qr-wrapper {\r\n    flex: 1;\r\n    cursor: pointer;\r\n  }\r\n  \r\n  .wechat-qr {\r\n    width: 160px;\r\n    height: 160px;\r\n    border: 3px solid #07c160;\r\n    border-radius: 8px;\r\n    padding: 5px;\r\n    background: white;\r\n    transition: transform 0.3s ease;\r\n  }\r\n  \r\n  .wechat-qr:hover {\r\n    transform: scale(1.05);\r\n  }\r\n  \r\n  /* 保存按钮 */\r\n  .save-btn {\r\n    display: block;\r\n    width: 200px;\r\n    padding: 0.8rem;\r\n    margin: 2rem auto 0;\r\n    background: #07c160;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 25px;\r\n    cursor: pointer;\r\n    font-size: 1rem;\r\n    transition: background 0.3s ease;\r\n  }\r\n  \r\n  .save-btn:hover {\r\n    background: #05964d;\r\n  }\r\n  \r\n  /* 响应式设计 */\r\n  @media (max-width: 480px) {\r\n    .user-container {\r\n      padding: 1rem;\r\n    }\r\n  \r\n    .info-item {\r\n      flex-direction: column;\r\n      align-items: flex-start;\r\n    }\r\n  \r\n    .info-item label {\r\n      text-align: left;\r\n      flex: none;\r\n    }\r\n  \r\n    .short-input, select {\r\n      max-width: 100%;\r\n      width: 100%;\r\n    }\r\n  \r\n    .wechat-qr {\r\n      width: 140px;\r\n      height: 140px;\r\n    }\r\n  }\r\n  </style>"],"mappings":"AAwEE,SAASA,GAAG,QAAQ,KAAK;AACzB,SAASC,QAAQ,QAAQ,MAAM;AAC/B,OAAOC,MAAM,MAAM,QAAQ;AAC3B,OAAOC,aAAa,MAAM,6BAA6B;AACvD,OAAOC,SAAS,MAAM,mBAAmB;;;;;;;IAEzC,MAAMC,KAAK,GAAGJ,QAAQ,CAAC,CAAC;;IAExB;IACA,MAAMK,YAAY,GAAGN,GAAG,CAAC;MACvB,GAAGK,KAAK,CAACE,KAAK,CAACC,IAAI;MACnBC,WAAW,EAAEJ,KAAK,CAACE,KAAK,CAACC,IAAI,CAACC,WAAW,IAAI;IAC/C,CAAC,CAAC;IACF,MAAMC,SAAS,GAAGV,GAAG,CAACI,SAAS,CAAC;;IAEhC;IACA,MAAMO,kBAAkB,GAAIC,KAAK,IAAK;MACpC,MAAMC,IAAI,GAAGD,KAAK,CAACE,MAAM,CAACC,KAAK,GAAG,CAAC,CAAC;MACpC,IAAIF,IAAI,IAAIA,IAAI,CAACG,IAAI,CAACC,UAAU,CAAC,QAAQ,CAAC,EAAE;QAC1C,MAAMC,MAAM