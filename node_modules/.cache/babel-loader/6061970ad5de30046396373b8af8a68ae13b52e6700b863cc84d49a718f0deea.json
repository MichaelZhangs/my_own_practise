{"ast":null,"code":"import { ref, nextTick } from 'vue';\nimport { useStore } from 'vuex';\nimport QRCode from 'qrcode';\nimport defaultAvatar from '@/assets/default-avatar.png';\nimport defaultQR from '@/assets/logo.png';\nexport default {\n  __name: 'UserDetail',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const store = useStore();\n\n    // 响应式数据\n    const editableUser = ref({\n      ...store.state.user,\n      description: store.state.user.description || ''\n    });\n    const qrcodeUrl = ref(defaultQR);\n    const isEditingPhone = ref(false);\n    const smsCode = ref('');\n    const countdown = ref(0);\n    let timer = null;\n\n    // 手机号编辑逻辑\n    const startPhoneEdit = async () => {\n      if (!isEditingPhone.value) {\n        isEditingPhone.value = true;\n        await nextTick();\n        document.querySelector('.sms-input')?.focus();\n      }\n    };\n    const cancelPhoneEdit = () => {\n      isEditingPhone.value = false;\n      smsCode.value = '';\n    };\n\n    // 短信验证码逻辑\n    const sendSmsCode = () => {\n      if (!/^1[3-9]\\d{9}$/.test(editableUser.value.phone)) {\n        alert('请输入有效的手机号码');\n        return;\n      }\n      countdown.value = 60;\n      timer = setInterval(() => {\n        countdown.value--;\n        if (countdown.value <= 0) clearInterval(timer);\n      }, 1000);\n\n      // TODO: 调用发送短信接口\n      console.log('发送验证码到:', editableUser.value.phone);\n    };\n\n    // 保存用户信息\n    const saveUserInfo = async () => {\n      if (isEditingPhone.value) {\n        if (!smsCode.value) {\n          alert('请先完成短信验证');\n          return;\n        }\n\n        // TODO: 验证短信验证码\n        if (smsCode.value !== '123456') {\n          // 模拟验证\n          alert('验证码错误');\n          return;\n        }\n      }\n      try {\n        await store.dispatch('updateUser', editableUser.value);\n        cancelPhoneEdit();\n        alert('信息保存成功!');\n      } catch (error) {\n        console.error('保存失败:', error);\n        alert('保存失败，请检查网络后重试');\n      }\n    };\n\n    // 其他方法保持原有实现...\n\n    const __returned__ = {\n      store,\n      editableUser,\n      qrcodeUrl,\n      isEditingPhone,\n      smsCode,\n      countdown,\n      get timer() {\n        return timer;\n      },\n      set timer(v) {\n        timer = v;\n      },\n      startPhoneEdit,\n      cancelPhoneEdit,\n      sendSmsCode,\n      saveUserInfo,\n      ref,\n      nextTick,\n      get useStore() {\n        return useStore;\n      },\n      get QRCode() {\n        return QRCode;\n      },\n      get defaultAvatar() {\n        return defaultAvatar;\n      },\n      get defaultQR() {\n        return defaultQR;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","nextTick","useStore","QRCode","defaultAvatar","defaultQR","store","editableUser","state","user","description","qrcodeUrl","isEditingPhone","smsCode","countdown","timer","startPhoneEdit","value","document","querySelector","focus","cancelPhoneEdit","sendSmsCode","test","phone","alert","setInterval","clearInterval","console","log","saveUserInfo","dispatch","error"],"sources":["E:/vue_learn/ai_vue/ai_vue/src/views/UserDetail.vue"],"sourcesContent":["<template>\r\n  <div class=\"user-detail-page\">\r\n    <h1 class=\"page-title\">用户详情</h1>\r\n    <div class=\"user-container\">\r\n      <!-- 头像部分 -->\r\n      <div class=\"avatar-wrapper\">\r\n        <label class=\"avatar-upload\">\r\n          <input \r\n            type=\"file\" \r\n            accept=\"image/*\" \r\n            @change=\"handleAvatarUpload\" \r\n            hidden\r\n          />\r\n          <img \r\n            :src=\"editableUser.photo || defaultAvatar\" \r\n            alt=\"用户头像\" \r\n            class=\"user-avatar\"\r\n          />\r\n          <span class=\"edit-tip\">点击更换头像</span>\r\n        </label>\r\n      </div>\r\n\r\n      <!-- 用户信息 -->\r\n      <div class=\"info-section\">\r\n        <div class=\"info-item\">\r\n          <label>姓名：</label>\r\n          <input v-model=\"editableUser.username\" class=\"short-input\" />\r\n        </div>\r\n        \r\n        <div class=\"info-item\">\r\n          <label>性别：</label>\r\n          <select v-model=\"editableUser.sex\">\r\n            <option value=\"男\">男</option>\r\n            <option value=\"女\">女</option>\r\n          </select>\r\n        </div>\r\n\r\n        <!-- 手机号编辑区域 -->\r\n        <div class=\"info-item\">\r\n          <label>手机号：</label>\r\n          <div class=\"phone-edit-wrapper\">\r\n            <input\r\n              v-model=\"editableUser.phone\"\r\n              :readonly=\"!isEditingPhone\"\r\n              class=\"short-input\"\r\n              @dblclick=\"startPhoneEdit\"\r\n              @blur=\"cancelPhoneEdit\"\r\n            />\r\n            <span v-if=\"!isEditingPhone\" class=\"edit-hint\">(双击修改)</span>\r\n            \r\n            <div v-if=\"isEditingPhone\" class=\"sms-verify\">\r\n              <input\r\n                v-model=\"smsCode\"\r\n                placeholder=\"请输入验证码\"\r\n                class=\"sms-input\"\r\n              />\r\n              <button \r\n                class=\"sms-btn\"\r\n                :disabled=\"countdown > 0\"\r\n                @click=\"sendSmsCode\"\r\n              >\r\n                {{ countdown > 0 ? `${countdown}s后重试` : '获取验证码' }}\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <div class=\"info-item\">\r\n          <label>邮箱：</label>\r\n          <input v-model=\"editableUser.email\" class=\"short-input\" />\r\n        </div>\r\n\r\n        <div class=\"info-item\">\r\n          <label>描述：</label>\r\n          <input v-model=\"editableUser.description\" class=\"short-input\" />\r\n        </div>\r\n\r\n        <!-- 二维码 -->\r\n        <div class=\"info-item\">\r\n          <label class=\"qr-label\">我的二维码：</label>\r\n          <div class=\"qr-wrapper\" @click=\"generateQRWithAvatar\">\r\n            <img \r\n              :src=\"qrcodeUrl || defaultQR\" \r\n              alt=\"个人二维码\" \r\n              class=\"wechat-qr\"\r\n            />\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <button class=\"save-btn\" @click=\"saveUserInfo\">保存修改</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, nextTick } from 'vue'\r\nimport { useStore } from 'vuex'\r\nimport QRCode from 'qrcode'\r\nimport defaultAvatar from '@/assets/default-avatar.png'\r\nimport defaultQR from '@/assets/logo.png'\r\n\r\nconst store = useStore()\r\n\r\n// 响应式数据\r\nconst editableUser = ref({\r\n  ...store.state.user,\r\n  description: store.state.user.description || ''\r\n})\r\nconst qrcodeUrl = ref(defaultQR)\r\nconst isEditingPhone = ref(false)\r\nconst smsCode = ref('')\r\nconst countdown = ref(0)\r\nlet timer = null\r\n\r\n// 手机号编辑逻辑\r\nconst startPhoneEdit = async () => {\r\n  if (!isEditingPhone.value) {\r\n    isEditingPhone.value = true\r\n    await nextTick()\r\n    document.querySelector('.sms-input')?.focus()\r\n  }\r\n}\r\n\r\nconst cancelPhoneEdit = () => {\r\n  isEditingPhone.value = false\r\n  smsCode.value = ''\r\n}\r\n\r\n// 短信验证码逻辑\r\nconst sendSmsCode = () => {\r\n  if (!/^1[3-9]\\d{9}$/.test(editableUser.value.phone)) {\r\n    alert('请输入有效的手机号码')\r\n    return\r\n  }\r\n\r\n  countdown.value = 60\r\n  timer = setInterval(() => {\r\n    countdown.value--\r\n    if (countdown.value <= 0) clearInterval(timer)\r\n  }, 1000)\r\n  \r\n  // TODO: 调用发送短信接口\r\n  console.log('发送验证码到:', editableUser.value.phone)\r\n}\r\n\r\n// 保存用户信息\r\nconst saveUserInfo = async () => {\r\n  if (isEditingPhone.value) {\r\n    if (!smsCode.value) {\r\n      alert('请先完成短信验证')\r\n      return\r\n    }\r\n    \r\n    // TODO: 验证短信验证码\r\n    if (smsCode.value !== '123456') { // 模拟验证\r\n      alert('验证码错误')\r\n      return\r\n    }\r\n  }\r\n\r\n  try {\r\n    await store.dispatch('updateUser', editableUser.value)\r\n    cancelPhoneEdit()\r\n    alert('信息保存成功!')\r\n  } catch (error) {\r\n    console.error('保存失败:', error)\r\n    alert('保存失败，请检查网络后重试')\r\n  }\r\n}\r\n\r\n// 其他方法保持原有实现...\r\n</script>\r\n\r\n<style scoped>\r\n/* 统一左对齐 */\r\n.info-item label {\r\n  flex: 0 0 100px;\r\n  text-align: left;\r\n  margin-right: 15px;\r\n}\r\n\r\n/* 手机号编辑区域 */\r\n.phone-edit-wrapper {\r\n  flex: 1;\r\n  position: relative;\r\n}\r\n\r\n.edit-hint {\r\n  color: #999;\r\n  font-size: 0.8rem;\r\n  margin-left: 10px;\r\n}\r\n\r\n/* 短信验证样式 */\r\n.sms-verify {\r\n  margin-top: 10px;\r\n  display: flex;\r\n  gap: 10px;\r\n}\r\n\r\n.sms-input {\r\n  flex: 1;\r\n  max-width: 150px;\r\n  padding: 6px 10px;\r\n  border: 1px solid #ddd;\r\n  border-radius: 4px;\r\n}\r\n\r\n.sms-btn {\r\n  padding: 6px 12px;\r\n  background: #07c160;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n}\r\n\r\n.sms-btn:disabled {\r\n  background: #cccccc;\r\n  cursor: not-allowed;\r\n}\r\n\r\n/* 二维码标签对齐 */\r\n.qr-label {\r\n  align-self: flex-start;\r\n  margin-top: 5px;\r\n}\r\n\r\n/* 其他样式保持原有实现... */\r\n</style>"],"mappings":"AAgGA,SAASA,GAAG,EAAEC,QAAQ,QAAQ,KAAK;AACnC,SAASC,QAAQ,QAAQ,MAAM;AAC/B,OAAOC,MAAM,MAAM,QAAQ;AAC3B,OAAOC,aAAa,MAAM,6BAA6B;AACvD,OAAOC,SAAS,MAAM,mBAAmB;;;;;;;IAEzC,MAAMC,KAAK,GAAGJ,QAAQ,CAAC,CAAC;;IAExB;IACA,MAAMK,YAAY,GAAGP,GAAG,CAAC;MACvB,GAAGM,KAAK,CAACE,KAAK,CAACC,IAAI;MACnBC,WAAW,EAAEJ,KAAK,CAACE,KAAK,CAACC,IAAI,CAACC,WAAW,IAAI;IAC/C,CAAC,CAAC;IACF,MAAMC,SAAS,GAAGX,GAAG,CAACK,SAAS,CAAC;IAChC,MAAMO,cAAc,GAAGZ,GAAG,CAAC,KAAK,CAAC;IACjC,MAAMa,OAAO,GAAGb,GAAG,CAAC,EAAE,CAAC;IACvB,MAAMc,SAAS,GAAGd,GAAG,CAAC,CAAC,CAAC;IACxB,IAAIe,KAAK,GAAG,IAAI;;IAEhB;IACA,MAAMC,cAAc,GAAG,MAAAA,CAAA,KAAY;MACjC,IAAI,CAACJ,cAAc,CAACK,KAAK,EAAE;QACzBL,cAAc,CAACK,KAAK,GAAG,IAAI;QAC3B,MAAMhB,QAAQ,CAAC,CAAC;QAChBiB,QAAQ,CAACC,aAAa,CAAC,YAAY,CAAC,EAAEC,KAAK,CAAC,CAAC;MAC/C;IACF,CAAC;IAED,MAAMC,eAAe,GAAGA,CAAA,KAAM;MAC5BT,cAAc,CAACK,KAAK,GAAG,KAAK;MAC5BJ,