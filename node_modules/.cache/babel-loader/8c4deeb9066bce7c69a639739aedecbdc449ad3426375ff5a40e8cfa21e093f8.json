{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport { ref, onMounted, onUnmounted, computed } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { useStore } from 'vuex';\nimport axios from 'axios';\nimport DOMPurify from 'dompurify';\nimport defaultAvatar from '@/assets/default-avatar.png';\nimport { API_CONFIG } from '@/config/config';\nimport { ElMessage } from 'element-plus';\nexport default {\n  setup() {\n    const router = useRouter();\n    const store = useStore();\n    const moments = ref([]);\n    const loading = ref(false);\n    const noMore = ref(false);\n    const lastId = ref(null);\n    const pageSize = 10;\n    const showAllComments = ref(false);\n    const goToUser = () => {\n      router.push('/user');\n    };\n    const goToUserProfile = userId => {\n      router.push(`/user/${userId}`);\n    };\n    const currentUser = computed(() => store.state.user || {});\n    const getFullUrl = path => {\n      if (!path || path === defaultAvatar) {\n        return path;\n      }\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`;\n    };\n    const openImagePreview = url => {\n      window.open(url, '_blank');\n    };\n    const openMediaPreview = url => {\n      if (url.match(/\\.(mp4|mov|avi)$/i)) {\n        window.open(url, '_blank');\n      } else {\n        window.open(url, '_blank');\n      }\n    };\n    const getVideoType = url => {\n      const extension = url.split('.').pop().toLowerCase();\n      switch (extension) {\n        case 'mp4':\n          return 'video/mp4';\n        case 'mov':\n          return 'video/quicktime';\n        case 'avi':\n          return 'video/x-msvideo';\n        default:\n          return 'video/mp4';\n      }\n    };\n    const fetchMoments = async () => {\n      if (loading.value || noMore.value) return;\n      loading.value = true;\n      try {\n        const params = {\n          limit: pageSize,\n          last_id: lastId.value\n        };\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/article/moments`, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          },\n          params\n        });\n        const newMoments = response.data.map(moment => ({\n          ...moment,\n          user_id: moment.user_id,\n          user: {\n            username: moment.user?.username || '未知用户',\n            photo: moment.user?.photo || ''\n          },\n          isLiked: moment.like_users?.includes(currentUser.value.id) || false,\n          commentInput: '',\n          showCommentInput: false,\n          comments: moment.comments || []\n        }));\n        if (newMoments.length < pageSize) {\n          noMore.value = true;\n        }\n        moments.value = [...moments.value, ...newMoments];\n        lastId.value = newMoments[newMoments.length - 1]?.id;\n      } catch (error) {\n        console.error('获取动态失败:', error);\n      } finally {\n        loading.value = false;\n      }\n    };\n    const formatTime = timestamp => {\n      const date = new Date(timestamp);\n      return `${date.getFullYear()}-${(date.getMonth() + 1).toString().padStart(2, '0')}-${date.getDate().toString().padStart(2, '0')} \n    ${date.getHours().toString().padStart(2, '0')}:${date.getMinutes().toString().padStart(2, '0')}`;\n    };\n    const getTimeAgo = timestamp => {\n      const now = new Date();\n      const created = new Date(timestamp);\n      const diff = now - created;\n      const minutes = Math.floor(diff / (1000 * 60));\n      const hours = Math.floor(diff / (1000 * 60 * 60));\n      const days = Math.floor(diff / (1000 * 60 * 60 * 24));\n      if (minutes < 1) {\n        return '刚刚';\n      } else if (minutes < 60) {\n        return `${minutes} 分钟前`;\n      } else if (hours < 24) {\n        return `${hours} 小时前`;\n      } else {\n        return `${days} 天前`;\n      }\n    };\n    const sanitizeHtml = html => {\n      return DOMPurify.sanitize(html);\n    };\n    const handleScroll = () => {\n      const {\n        scrollTop,\n        clientHeight,\n        scrollHeight\n      } = document.documentElement;\n      if (scrollTop + clientHeight >= scrollHeight - 100 && !loading.value && !noMore.value) {\n        fetchMoments();\n      }\n    };\n    const deleteMoment = async momentId => {\n      try {\n        await axios.post(`${API_CONFIG.BASE_URL}/article/delete/moment`, {\n          moment_id: momentId\n        }, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        });\n        moments.value = moments.value.filter(moment => moment.id !== momentId);\n        ElMessage.success('动态删除成功');\n      } catch (error) {\n        console.error('删除动态失败:', error);\n        ElMessage.error('删除动态失败，请稍后重试');\n      }\n    };\n    const likeMoment = async momentId => {\n      const targetMoment = moments.value.find(moment => moment.id === momentId);\n      if (!targetMoment) return;\n      const originalIsLiked = targetMoment.isLiked;\n      const originalLikes = targetMoment.stats.likes;\n      try {\n        targetMoment.isLiked = !targetMoment.isLiked;\n        targetMoment.stats.likes += targetMoment.isLiked ? 1 : -1;\n        const response = await axios.post(`${API_CONFIG.BASE_URL}/article/like_moment`, {\n          moment_id: momentId,\n          user_id: currentUser.value.id,\n          is_like: targetMoment.isLiked\n        }, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          },\n          timeout: 5000\n        });\n        if (response.data.success) {\n          if (!targetMoment.stats) {\n            targetMoment.stats = {\n              likes: 0\n            };\n          }\n          targetMoment.isLiked = response.data.likes > targetMoment.stats.likes;\n          targetMoment.stats.likes = response.data.likes;\n          ElMessage.success(targetMoment.isLiked ? '点赞成功' : '已取消点赞');\n          targetMoment.isLiked = response.data.is_liked;\n          targetMoment.stats.likes = response.data.likes_count;\n          if (response.data.is_liked) {\n            targetMoment.like_users = [...(targetMoment.like_users || []), currentUser.value.id];\n          } else {\n            targetMoment.like_users = (targetMoment.like_users || []).filter(id => id !== currentUser.value.id);\n          }\n        }\n      } catch (error) {\n        targetMoment.isLiked = originalIsLiked;\n        targetMoment.stats.likes = originalLikes;\n        console.error('点赞操作失败:', error);\n        ElMessage.error(`操作失败: ${error.response?.data?.msg || '网络错误'}`);\n      }\n    };\n    const toggleCommentInput = moment => {\n      moment.showCommentInput = !moment.showCommentInput;\n      if (moment.showCommentInput) {\n        moment.commentInput = '';\n      }\n    };\n    const postComment = async momentId => {\n      const targetMoment = moments.value.find(moment => moment.id === momentId);\n      const commentText = targetMoment.commentInput;\n      if (commentText.trim() === '') {\n        ElMessage.warning('评论内容不能为空');\n        return;\n      }\n      try {\n        const response = await axios.post(`${API_CONFIG.BASE_URL}/article/post_comment`, {\n          moment_id: momentId,\n          comment_user_id: currentUser.value.id,\n          comment_user_name: currentUser.value.username,\n          comment: commentText\n        }, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        });\n        if (response.data.success) {\n          targetMoment.stats.comments = (targetMoment.stats.comments || 0) + 1;\n          const newComment = {\n            moment_id: momentId,\n            comment: commentText,\n            created_at: new Date(),\n            comment_user_name: currentUser.value.username,\n            comment_user_id: currentUser.value.id,\n            comment_user_photo: currentUser.value.photo,\n            isLiked: false,\n            likes: 0,\n            commentsCount: 0\n          };\n          targetMoment.comments.push(newComment);\n          targetMoment.commentInput = '';\n          targetMoment.showCommentInput = false;\n          ElMessage.success('评论发布成功');\n        } else {\n          ElMessage.error('评论发布失败，请稍后重试');\n        }\n      } catch (error) {\n        console.error('评论发布失败:', error);\n        ElMessage.error('评论发布失败，请稍后重试');\n      }\n    };\n    const commentIconClick = moment => {\n      toggleCommentInput(moment);\n    };\n    const likeComment = async (momentId, commentIndex) => {\n      const targetMoment = moments.value.find(moment => moment.id === momentId);\n      const targetComment = targetMoment.comments[commentIndex];\n      if (!targetComment) return;\n      const originalIsLiked = targetComment.isLiked;\n      const originalLikes = targetComment.likes;\n      try {\n        targetComment.isLiked = !targetComment.isLiked;\n        targetComment.likes += targetComment.isLiked ? 1 : -1;\n        const response = await axios.post(`${API_CONFIG.BASE_URL}/article/like_comment`, {\n          moment_id: momentId,\n          comment_index: commentIndex,\n          user_id: currentUser.value.id,\n          is_like: targetComment.isLiked\n        }, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          },\n          timeout: 5000\n        });\n        if (response.data.success) {\n          targetComment.isLiked = response.data.is_liked;\n          targetComment.likes = response.data.likes_count;\n        }\n      } catch (error) {\n        targetComment.isLiked = originalIsLiked;\n        targetComment.likes = originalLikes;\n        console.error('评论点赞操作失败:', error);\n      }\n    };\n    const commentOnComment = (momentId, commentIndex) => {\n      // 这里可以弹出评论框或者跳转到新页面进行评论，具体逻辑根据实际需求实现\n      console.log(`对第 ${commentIndex} 条评论进行评论，动态id为 ${momentId}`);\n    };\n    onMounted(() => {\n      fetchMoments();\n      window.addEventListener('scroll', handleScroll);\n    });\n    onUnmounted(() => {\n      window.removeEventListener('scroll', handleScroll);\n    });\n    return {\n      getFullUrl,\n      openImagePreview,\n      moments,\n      currentUser,\n      formatTime,\n      sanitizeHtml,\n      defaultAvatar,\n      openMediaPreview,\n      getVideoType,\n      goToUser,\n      goToPublish: () => router.push('/publish'),\n      noMore,\n      loading,\n      getTimeAgo,\n      deleteMoment,\n      likeMoment,\n      toggleCommentInput,\n      postComment,\n      commentIconClick,\n      goToUserProfile,\n      showAllComments,\n      likeComment,\n      commentOnComment\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","onUnmounted","computed","useRouter","useStore","axios","DOMPurify","defaultAvatar","API_CONFIG","ElMessage","setup","router","store","moments","loading","noMore","lastId","pageSize","showAllComments","goToUser","push","goToUserProfile","userId","currentUser","state","user","getFullUrl","path","startsWith","BASE_URL","openImagePreview","url","window","open","openMediaPreview","match","getVideoType","extension","split","pop","toLowerCase","fetchMoments","value","params","limit","last_id","response","get","headers","Authorization","token","newMoments","data","map","moment","user_id","username","photo","isLiked","like_users","includes","id","commentInput","showCommentInput","comments","length","error","console","formatTime","timestamp","date","Date","getFullYear","getMonth","toString","padStart","getDate","getHours","getMinutes","getTimeAgo","now","created","diff","minutes","Math","floor","hours","days","sanitizeHtml","html","sanitize","handleScroll","scrollTop","clientHeight","scrollHeight","document","documentElement","deleteMoment","momentId","post","moment_id","filter","success","likeMoment","targetMoment","find","originalIsLiked","originalLikes","stats","likes","is_like","timeout","is_liked","likes_count","msg","toggleCommentInput","postComment","commentText","trim","warning","comment_user_id","comment_user_name","comment","newComment","created_at","comment_user_photo","commentsCount","commentIconClick","likeComment","commentIndex","targetComment","comment_index","commentOnComment","log","addEventListener","removeEventListener","goToPublish"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\article\\UserMoments.vue"],"sourcesContent":["<template>\r\n  <div class=\"moments-page\">\r\n      <!-- 其他代码不变 -->\r\n      <div class=\"moments-container\">\r\n          <div class=\"moments-list\">\r\n              <div\r\n                  v-for=\"moment in moments\"\r\n                  :key=\"moment.id\"\r\n                  class=\"moment-item\"\r\n              >\r\n                  <!-- 其他代码不变 -->\r\n                  <!-- 评论输入框，初始隐藏 -->\r\n                  <div v-if=\"moment.showCommentInput\" class=\"comment-input-area flex items-center mt-2\">\r\n                      <input\r\n                          v-model=\"moment.commentInput\"\r\n                          type=\"text\"\r\n                          placeholder=\"发表评论...\"\r\n                          class=\"flex-1 border border-gray-300 rounded-md p-2 mr-2\"\r\n                      />\r\n                      <button\r\n                          @click=\"postComment(moment.id)\"\r\n                          :disabled=\"!moment.commentInput.trim()\"\r\n                          :class=\"{ 'bg-green-500 text-white': moment.commentInput.trim(), 'bg-gray-300 text-gray-500':!moment.commentInput.trim() }\"\r\n                          class=\"px-4 py-2 rounded-md hover:bg-green-600\"\r\n                      >\r\n                          发布\r\n                      </button>\r\n                  </div>\r\n                  <!-- 评论展示区域 -->\r\n                  <ul v-if=\"moment.comments && moment.comments.length > 0\" class=\"comments-list\">\r\n                      <li\r\n                          v-for=\"(comment, index) in moment.comments.slice(0, showAllComments? moment.comments.length : 3)\"\r\n                          :key=\"index\"\r\n                          class=\"comment-item border-b border-gray-100 py-4\"\r\n                      >\r\n                          <!-- 其他代码不变 -->\r\n                          <!-- 评论的点赞和评论按钮 -->\r\n                          <div class=\"comment-actions flex justify-end space-x-4 mt-2 text-sm text-gray-500\">\r\n                              <div class=\"comment-like flex items-center space-x-1 cursor-pointer\" @click=\"likeComment(moment.id, index)\">\r\n                                  <i\r\n                                      class=\"fa-solid fa-thumbs-up\"\r\n                                      :class=\"{ 'liked': comment.isLiked }\"\r\n                                  ></i>\r\n                                  <span>{{ comment.likes }}</span>\r\n                              </div>\r\n                              <div class=\"comment-comment flex items-center space-x-1 cursor-pointer\" @click=\"commentOnComment(moment.id, index)\">\r\n                                  <i class=\"fa-solid fa-comment\"></i>\r\n                                  <span>{{ comment.commentsCount }}</span>\r\n                              </div>\r\n                              <!-- 新增评论回复输入框相关代码 -->\r\n                              <div v-if=\"comment.showReplyInput\" class=\"reply-input-area flex items-center mt-2\">\r\n                                  <input\r\n                                      v-model=\"comment.replyInput\"\r\n                                      type=\"text\"\r\n                                      placeholder=\"回复评论...\"\r\n                                      class=\"flex-1 border border-gray-300 rounded-md p-2 mr-2\"\r\n                                  />\r\n                                  <button\r\n                                      @click=\"postReply(moment.id, index)\"\r\n                                      :disabled=\"!comment.replyInput.trim()\"\r\n                                      :class=\"{ 'bg-green-500 text-white': comment.replyInput.trim(), 'bg-gray-300 text-gray-500':!comment.replyInput.trim() }\"\r\n                                      class=\"px-4 py-2 rounded-md hover:bg-green-600\"\r\n                                  >\r\n                                      回复\r\n                                  </button>\r\n                              </div>\r\n                          </div>\r\n                      </li>\r\n                      <!-- 如果评论数大于3，显示展开按钮 -->\r\n                      <li v-if=\"moment.comments.length > 3 &&!showAllComments\" class=\"show-more-comments text-blue-500 cursor-pointer\" @click=\"showAllComments = true\">\r\n                          展开查看全部评论\r\n                      </li>\r\n                  </ul>\r\n              </div>\r\n          </div>\r\n          <div v-if=\"noMore\" class=\"no-more-message text-center text-gray-500 py-4\">没有其他的内容了哦</div>\r\n      </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted, onUnmounted, computed } from 'vue';\r\nimport { useRouter } from 'vue-router';\r\nimport { useStore } from 'vuex';\r\nimport axios from 'axios';\r\nimport DOMPurify from 'dompurify';\r\nimport defaultAvatar from '@/assets/default-avatar.png';\r\nimport { API_CONFIG } from '@/config/config';\r\nimport { ElMessage } from 'element-plus';\r\n\r\nexport default {\r\n  setup() {\r\n      const router = useRouter();\r\n      const store = useStore();\r\n      const moments = ref([]);\r\n      const loading = ref(false);\r\n      const noMore = ref(false);\r\n      const lastId = ref(null);\r\n      const pageSize = 10;\r\n      const showAllComments = ref(false);\r\n\r\n      const goToUser = () => {\r\n          router.push('/user');\r\n      };\r\n\r\n      const goToUserProfile = (userId) => {\r\n          router.push(`/user/${userId}`);\r\n      };\r\n\r\n      const currentUser = computed(() => store.state.user || {});\r\n\r\n      const getFullUrl = (path) => {\r\n          if (!path || path === defaultAvatar) {\r\n              return path;\r\n          }\r\n          return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`;\r\n      };\r\n\r\n      const openImagePreview = (url) => {\r\n          window.open(url, '_blank');\r\n      };\r\n\r\n      const openMediaPreview = (url) => {\r\n          if (url.match(/\\.(mp4|mov|avi)$/i)) {\r\n              window.open(url, '_blank');\r\n          } else {\r\n              window.open(url, '_blank');\r\n          }\r\n      };\r\n\r\n      const getVideoType = (url) => {\r\n          const extension = url.split('.').pop().toLowerCase();\r\n          switch (extension) {\r\n              case 'mp4':\r\n                  return 'video/mp4';\r\n              case 'mov':\r\n                  return 'video/quicktime';\r\n              case 'avi':\r\n                  return 'video/x-msvideo';\r\n              default:\r\n                  return 'video/mp4';\r\n          }\r\n      };\r\n\r\n      const fetchMoments = async () => {\r\n          if (loading.value || noMore.value) return;\r\n\r\n          loading.value = true;\r\n          try {\r\n              const params = {\r\n                  limit: pageSize,\r\n                  last_id: lastId.value\r\n              };\r\n\r\n              const response = await axios.get(`${API_CONFIG.BASE_URL}/article/moments`, {\r\n                  headers: {\r\n                      Authorization: `Bearer ${store.state.token}`\r\n                  },\r\n                  params\r\n              });\r\n\r\n              const newMoments = response.data.map(moment => ({\r\n                  ...moment,\r\n                  user_id: moment.user_id,\r\n                  user: {\r\n                      username: moment.user?.username || '未知用户',\r\n                      photo: moment.user?.photo || '',\r\n                  },\r\n                  isLiked: moment.like_users?.includes(currentUser.value.id) || false,\r\n                  commentInput: '',\r\n                  showCommentInput: false,\r\n                  comments: moment.comments || []\r\n              }));\r\n\r\n              if (newMoments.length < pageSize) {\r\n                  noMore.value = true;\r\n              }\r\n\r\n              moments.value = [...moments.value, ...newMoments];\r\n              lastId.value = newMoments[newMoments.length - 1]?.id;\r\n          } catch (error) {\r\n              console.error('获取动态失败:', error);\r\n          } finally {\r\n              loading.value = false;\r\n          }\r\n      };\r\n\r\n      const formatTime = (timestamp) => {\r\n          const date = new Date(timestamp);\r\n          return `${date.getFullYear()}-${(date.getMonth() + 1).toString().padStart(2, '0')}-${date.getDate().toString().padStart(2, '0')} \r\n    ${date.getHours().toString().padStart(2, '0')}:${date.getMinutes().toString().padStart(2, '0')}`;\r\n      };\r\n\r\n      const getTimeAgo = (timestamp) => {\r\n          const now = new Date();\r\n          const created = new Date(timestamp);\r\n          const diff = now - created;\r\n\r\n          const minutes = Math.floor(diff / (1000 * 60));\r\n          const hours = Math.floor(diff / (1000 * 60 * 60));\r\n          const days = Math.floor(diff / (1000 * 60 * 60 * 24));\r\n\r\n          if (minutes < 1) {\r\n              return '刚刚';\r\n          } else if (minutes < 60) {\r\n              return `${minutes} 分钟前`;\r\n          } else if (hours < 24) {\r\n              return `${hours} 小时前`;\r\n          } else {\r\n              return `${days} 天前`;\r\n          }\r\n      };\r\n\r\n      const sanitizeHtml = (html) => {\r\n          return DOMPurify.sanitize(html);\r\n      };\r\n\r\n      const handleScroll = () => {\r\n          const { scrollTop, clientHeight, scrollHeight } = document.documentElement;\r\n          if (scrollTop + clientHeight >= scrollHeight - 100 &&!loading.value &&!noMore.value) {\r\n              fetchMoments();\r\n          }\r\n      };\r\n\r\n      const deleteMoment = async (momentId) => {\r\n          try {\r\n              await axios.post(`${API_CONFIG.BASE_URL}/article/delete/moment`, {\r\n                  moment_id: momentId\r\n              }, {\r\n                  headers: {\r\n                      Authorization: `Bearer ${store.state.token}`\r\n                  }\r\n              });\r\n              moments.value = moments.value.filter(moment => moment.id!== momentId);\r\n              ElMessage.success('动态删除成功');\r\n          } catch (error) {\r\n              console.error('删除动态失败:', error);\r\n              ElMessage.error('删除动态失败，请稍后重试');\r\n          }\r\n      };\r\n\r\n      const likeMoment = async (momentId) => {\r\n          const targetMoment = moments.value.find(moment => moment.id === momentId);\r\n          if (!targetMoment) return;\r\n\r\n          const originalIsLiked = targetMoment.isLiked;\r\n          const originalLikes = targetMoment.stats.likes;\r\n\r\n          try {\r\n              targetMoment.isLiked =!targetMoment.isLiked;\r\n              targetMoment.stats.likes += targetMoment.isLiked? 1 : -1;\r\n\r\n              const response = await axios.post(`${API_CONFIG.BASE_URL}/article/like_moment`, {\r\n                  moment_id: momentId,\r\n                  user_id: currentUser.value.id,\r\n                  is_like: targetMoment.isLiked\r\n              }, {\r\n                  headers: {\r\n                      Authorization: `Bearer ${store.state.token}`\r\n                  },\r\n                  timeout: 5000\r\n              });\r\n\r\n              if (response.data.success) {\r\n                  if (!targetMoment.stats) {\r\n                      targetMoment.stats = { likes: 0 };\r\n                  }\r\n\r\n                  targetMoment.isLiked = response.data.likes > targetMoment.stats.likes;\r\n                  targetMoment.stats.likes = response.data.likes;\r\n                  ElMessage.success(targetMoment.isLiked? '点赞成功' : '已取消点赞');\r\n\r\n                  targetMoment.isLiked = response.data.is_liked;\r\n                  targetMoment.stats.likes = response.data.likes_count;\r\n\r\n                  if (response.data.is_liked) {\r\n                      targetMoment.like_users = [\r\n                          ...(targetMoment.like_users || []),\r\n                          currentUser.value.id\r\n                      ];\r\n                  } else {\r\n                      targetMoment.like_users = (targetMoment.like_users || [])\r\n                         .filter(id => id!== currentUser.value.id);\r\n                  }\r\n              }\r\n          } catch (error) {\r\n              targetMoment.isLiked = originalIsLiked;\r\n              targetMoment.stats.likes = originalLikes;\r\n\r\n              console.error('点赞操作失败:', error);\r\n              ElMessage.error(`操作失败: ${error.response?.data?.msg || '网络错误'}`);\r\n          }\r\n      };\r\n\r\n      const toggleCommentInput = (moment) => {\r\n          moment.showCommentInput =!moment.showCommentInput;\r\n          if (moment.showCommentInput) {\r\n              moment.commentInput = '';\r\n          }\r\n      };\r\n\r\n      const postComment = async (momentId) => {\r\n          const targetMoment = moments.value.find(moment => moment.id === momentId);\r\n          const commentText = targetMoment.commentInput;\r\n          if (commentText.trim() === '') {\r\n              ElMessage.warning('评论内容不能为空');\r\n              return;\r\n          }\r\n          try {\r\n              const response = await axios.post(`${API_CONFIG.BASE_URL}/article/post_comment`, {\r\n                  moment_id: momentId,\r\n                  comment_user_id: currentUser.value.id,\r\n                  comment_user_name: currentUser.value.username,\r\