{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  name: \"UserPage\",\n  data() {\n    return {\n      username: \"管理员\" // 从登录信息中获取用户名\n    };\n  },\n  methods: {\n    // 退出登录\n    logout() {\n      this.$router.push(\"/login\"); // 跳转到登录页\n    }\n  }\n};","map":{"version":3,"names":["name","data","username","methods","logout","$router","push"],"sources":["E:\\vue_learn\\ai_vue\\ai_vue\\src\\views\\UserPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"user-page\">\r\n    <!-- 顶部导航栏 -->\r\n    <header class=\"header\">\r\n      <div class=\"header-left\">\r\n        <span class=\"logo\">Ruoyi Vue</span>\r\n      </div>\r\n      <div class=\"header-right\">\r\n        <span class=\"username\">{{ username }}</span>\r\n        <button @click=\"logout\" class=\"logout-button\">退出登录</button>\r\n      </div>\r\n    </header>\r\n\r\n    <!-- 侧边栏 -->\r\n    <aside class=\"sidebar\">\r\n      <ul class=\"menu\">\r\n        <li class=\"menu-item\">\r\n          <router-link to=\"/user/dashboard\">仪表盘</router-link>\r\n        </li>\r\n        <li class=\"menu-item\">\r\n          <router-link to=\"/user/profile\">个人资料</router-link>\r\n        </li>\r\n        <li class=\"menu-item\">\r\n          <router-link to=\"/user/settings\">设置</router-link>\r\n        </li>\r\n      </ul>\r\n    </aside>\r\n\r\n    <!-- 主内容区域 -->\r\n    <main class=\"main-content\">\r\n      <router-view></router-view>\r\n    </main>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: \"UserPage\",\r\n  data() {\r\n    return {\r\n      username: \"管理员\", // 从登录信息中获取用户名\r\n    };\r\n  },\r\n  methods: {\r\n    // 退出登录\r\n    logout() {\r\n      this.$router.push(\"/login\"); // 跳转到登录页\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.user-page {\r\n  display: flex;\r\n  flex-direction: column;\r\n  height: 100vh;\r\n  background-color: #f0f2f5; /* 背景颜色 */\r\n}\r\n\r\n.header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  padding: 0 20px;\r\n  height: 60px;\r\n  background-color: #001529; /* 顶部导航栏背景颜色 */\r\n  color: white;\r\n}\r\n\r\n.header-left .logo {\r\n  font-size: 20px;\r\n  font-weight: bold;\r\n}\r\n\r\n.header-right .username {\r\n  margin-right: 20px;\r\n}\r\n\r\n.logout-button {\r\n  padding: 5px 10px;\r\n  background-color: #1890ff; /* 按钮背景颜色 */\r\n  color: white;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n}\r\n\r\n.logout-button:hover {\r\n  background-color: #40a9ff; /* 按钮悬停颜色 */\r\n}\r\n\r\n.sidebar {\r\n  width: 200px;\r\n  background-color: #001529; /* 侧边栏背景颜色 */\r\n  color: white;\r\n}\r\n\r\n.menu {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 0;\r\n}\r\n\r\n.menu-item {\r\n  padding: 10px 20px;\r\n  border-bottom: 1px solid #002140; /* 菜单项分隔线颜色 */\r\n}\r\n\r\n.menu-item a {\r\n  color: white;\r\n  text-decoration: none;\r\n}\r\n\r\n.menu-item a:hover {\r\n  color: #1890ff; /* 菜单项悬停颜色 */\r\n}\r\n\r\n.main-content {\r\n  flex: 1;\r\n  padding: 20px;\r\n  background-color: white; /* 主内容区域背景颜色 */\r\n}\r\n</style>"],"mappings":";AAoCA,eAAe;EACbA,IAAI,EAAE,UAAU;EAChBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,KAAK,CAAE;IACnB,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP;IACAC,MAAMA,CAAA,EAAG;MACP,IAAI,CAACC,OAAO,CAACC,IAAI,CAAC,QAAQ,CAAC,EAAE;IAC/B;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}