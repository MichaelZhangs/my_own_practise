{"ast":null,"code":"import { ref } from 'vue';\nexport default {\n  props: {\n    placeholder: {\n      type: String,\n      default: '发表评论...'\n    },\n    buttonText: {\n      type: String,\n      default: '发布'\n    },\n    autoClear: {\n      type: Boolean,\n      default: true\n    }\n  },\n  emits: ['submit'],\n  setup(props, {\n    emit\n  }) {\n    const inputContent = ref('');\n    const handleSubmit = () => {\n      if (inputContent.value.trim()) {\n        emit('submit', inputContent.value);\n        if (props.autoClear) {\n          inputContent.value = '';\n        }\n      }\n    };\n    return {\n      inputContent,\n      handleSubmit\n    };\n  }\n};","map":{"version":3,"names":["ref","props","placeholder","type","String","default","buttonText","autoClear","Boolean","emits","setup","emit","inputContent","handleSubmit","value","trim"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\article\\CommentInput.vue"],"sourcesContent":["<template>\r\n    <div class=\"comment-input-area flex items-center mt-2\">\r\n      <input\r\n        v-model=\"inputContent\"\r\n        type=\"text\"\r\n        :placeholder=\"placeholder\"\r\n        class=\"flex-1 border border-gray-300 rounded-md p-2 mr-2\"\r\n        @keyup.enter=\"handleSubmit\"\r\n      />\r\n      <button\r\n        @click=\"handleSubmit\"\r\n        class=\"px-4 py-2 rounded-md transition-colors duration-200\"\r\n        :class=\"inputContent.trim()? \r\n          'bg-green-500 text-white hover:bg-green-600' : \r\n          'bg-gray-300 text-gray-500 cursor-not-allowed'\"\r\n        :disabled=\"!inputContent.trim()\"\r\n      >\r\n        {{ buttonText }}\r\n      </button>\r\n    </div>\r\n  </template>\r\n  <!-- 评论框组件 -->\r\n  <script>\r\n  import { ref } from 'vue'\r\n  \r\n  export default {\r\n    props: {\r\n      placeholder: {\r\n        type: String,\r\n        default: '发表评论...'\r\n      },\r\n      buttonText: {\r\n        type: String,\r\n        default: '发布'\r\n      },\r\n      autoClear: {\r\n        type: Boolean,\r\n        default: true\r\n      }\r\n    },\r\n    emits: ['submit'],\r\n    setup(props, { emit }) {\r\n      const inputContent = ref('')\r\n  \r\n      const handleSubmit = () => {\r\n        if (inputContent.value.trim()) {\r\n          emit('submit', inputContent.value)\r\n          if (props.autoClear) {\r\n            inputContent.value = ''\r\n          }\r\n        }\r\n      }\r\n  \r\n      return {\r\n        inputContent,\r\n        handleSubmit\r\n      }\r\n    }\r\n  }\r\n  </script>"],"mappings":"AAuBE,SAASA,GAAE,QAAS,KAAI;AAExB,eAAe;EACbC,KAAK,EAAE;IACLC,WAAW,EAAE;MACXC,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX,CAAC;IACDC,UAAU,EAAE;MACVH,IAAI,EAAEC,MAAM;MACZC,OAAO,EAAE;IACX,CAAC;IACDE,SAAS,EAAE;MACTJ,IAAI,EAAEK,OAAO;MACbH,OAAO,EAAE;IACX;EACF,CAAC;EACDI,KAAK,EAAE,CAAC,QAAQ,CAAC;EACjBC,KAAKA,CAACT,KAAK,EAAE;IAAEU;EAAK,CAAC,EAAE;IACrB,MAAMC,YAAW,GAAIZ,GAAG,CAAC,EAAE;IAE3B,MAAMa,YAAW,GAAIA,CAAA,KAAM;MACzB,IAAID,YAAY,CAACE,KAAK,CAACC,IAAI,CAAC,CAAC,EAAE;QAC7BJ,IAAI,CAAC,QAAQ,EAAEC,YAAY,CAACE,KAAK;QACjC,IAAIb,KAAK,CAACM,SAAS,EAAE;UACnBK,YAAY,CAACE,KAAI,GAAI,EAAC;QACxB;MACF;IACF;IAEA,OAAO;MACLF,YAAY;MACZC;IACF;EACF;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}