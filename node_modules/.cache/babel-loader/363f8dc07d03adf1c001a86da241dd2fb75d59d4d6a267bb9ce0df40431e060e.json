{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport { ref, onMounted } from 'vue';\nimport { useStore } from 'vuex';\nimport axios from 'axios';\nimport { API_CONFIG } from '@/config/config';\nimport { ElMessage } from 'element-plus';\nexport default {\n  setup() {\n    const store = useStore();\n    const currentUser = store.state.user;\n    const stats = ref({\n      publishedCount: 0,\n      likesReceived: 0,\n      followingCount: 0\n    });\n    const recentMoments = ref([]);\n\n    // 工具方法\n    const formatTime = timestamp => {\n      const date = new Date(timestamp);\n      return `${date.getFullYear()}-${(date.getMonth() + 1).toString().padStart(2, '0')}-` + `${date.getDate().toString().padStart(2, '0')} ` + `${date.getHours().toString().padStart(2, '0')}:` + `${date.getMinutes().toString().padStart(2, '0')}`;\n    };\n\n    // 获取用户统计数据\n    const fetchUserStats = async () => {\n      try {\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/user/stats`, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        });\n        stats.value = {\n          publishedCount: response.data.published_moments_count,\n          likesReceived: response.data.received_likes_count,\n          followingCount: response.data.following_count\n        };\n      } catch (error) {\n        console.error('获取用户统计数据失败:', error);\n        ElMessage.error('获取数据失败');\n      }\n    };\n\n    // 获取最近发布的动态\n    const fetchRecentMoments = async () => {\n      try {\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/article/user_moments`, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          },\n          params: {\n            user_id: currentUser.id,\n            limit: 3\n          }\n        });\n        recentMoments.value = response.data.map(moment => ({\n          ...moment,\n          stats: {\n            likes: moment.stats.likes || 0,\n            comments: moment.stats.comments?.length || 0\n          }\n        }));\n      } catch (error) {\n        console.error('获取最近动态失败:', error);\n      }\n    };\n    onMounted(() => {\n      if (currentUser) {\n        fetchUserStats();\n        fetchRecentMoments();\n      }\n    });\n    return {\n      stats,\n      recentMoments,\n      formatTime\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","useStore","axios","API_CONFIG","ElMessage","setup","store","currentUser","state","user","stats","publishedCount","likesReceived","followingCount","recentMoments","formatTime","timestamp","date","Date","getFullYear","getMonth","toString","padStart","getDate","getHours","getMinutes","fetchUserStats","response","get","BASE_URL","headers","Authorization","token","value","data","published_moments_count","received_likes_count","following_count","error","console","fetchRecentMoments","params","user_id","id","limit","map","moment","likes","comments","length"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\views\\UserDashboard.vue"],"sourcesContent":["<template>\r\n  <div class=\"dashboard-page\">\r\n    <div class=\"dashboard-header\">\r\n      <h1 class=\"dashboard-title\">用户仪表盘</h1>\r\n      <p class=\"dashboard-subtitle\">您的个人数据概览</p>\r\n    </div>\r\n    \r\n    <div class=\"dashboard-cards\">\r\n      <!-- 数据卡片1：动态统计 -->\r\n      <div class=\"dashboard-card\">\r\n        <div class=\"card-header\">\r\n          <i class=\"fa-solid fa-square-poll-vertical\"></i>\r\n          <h3>动态统计</h3>\r\n        </div>\r\n        <div class=\"card-content\">\r\n          <div class=\"stat-value\">{{ stats.publishedCount || 0 }}</div>\r\n          <div class=\"stat-label\">已发布动态</div>\r\n        </div>\r\n      </div>\r\n      \r\n      <!-- 数据卡片2：互动统计 -->\r\n      <div class=\"dashboard-card\">\r\n        <div class=\"card-header\">\r\n          <i class=\"fa-solid fa-heart\"></i>\r\n          <h3>互动数据</h3>\r\n        </div>\r\n        <div class=\"card-content\">\r\n          <div class=\"stat-value\">{{ stats.likesReceived || 0 }}</div>\r\n          <div class=\"stat-label\">收到点赞</div>\r\n        </div>\r\n      </div>\r\n      \r\n      <!-- 数据卡片3：关注统计 -->\r\n      <div class=\"dashboard-card\">\r\n        <div class=\"card-header\">\r\n          <i class=\"fa-solid fa-user-group\"></i>\r\n          <h3>社交数据</h3>\r\n        </div>\r\n        <div class=\"card-content\">\r\n          <div class=\"stat-value\">{{ stats.followingCount || 0 }}</div>\r\n          <div class=\"stat-label\">关注人数</div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    \r\n    <div class=\"recent-activity\">\r\n      <h2 class=\"section-title\">最近活动</h2>\r\n      <div v-if=\"recentMoments.length > 0\" class=\"activity-list\">\r\n        <div \r\n          v-for=\"moment in recentMoments\" \r\n          :key=\"moment.id\" \r\n          class=\"activity-item\"\r\n        >\r\n          <div class=\"activity-icon\">\r\n            <i class=\"fa-solid fa-comment\"></i>\r\n          </div>\r\n          <div class=\"activity-content\">\r\n            <div class=\"activity-text\">\r\n              您于 {{ formatTime(moment.created_at) }} 发布了动态: {{ moment.content.length > 30 ? moment.content.slice(0, 30) + '...' : moment.content }}\r\n            </div>\r\n            <div class=\"activity-meta\">\r\n              <span class=\"activity-likes\">{{ moment.stats.likes || 0 }} 点赞</span>\r\n              <span class=\"activity-comments\">{{ moment.stats.comments || 0 }} 评论</span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div v-else class=\"no-activity\">\r\n        <i class=\"fa-solid fa-clock\"></i>\r\n        <p>暂无活动记录</p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted } from 'vue'\r\nimport { useStore } from 'vuex'\r\nimport axios from 'axios'\r\nimport { API_CONFIG } from '@/config/config'\r\nimport { ElMessage } from 'element-plus'\r\n\r\nexport default {\r\n  setup() {\r\n    const store = useStore()\r\n    const currentUser = store.state.user\r\n    const stats = ref({\r\n      publishedCount: 0,\r\n      likesReceived: 0,\r\n      followingCount: 0\r\n    })\r\n    const recentMoments = ref([])\r\n    \r\n    // 工具方法\r\n    const formatTime = (timestamp) => {\r\n      const date = new Date(timestamp)\r\n      return `${date.getFullYear()}-${(date.getMonth() + 1).toString().padStart(2, '0')}-` +\r\n             `${date.getDate().toString().padStart(2, '0')} ` +\r\n             `${date.getHours().toString().padStart(2, '0')}:` +\r\n             `${date.getMinutes().toString().padStart(2, '0')}`\r\n    }\r\n    \r\n    // 获取用户统计数据\r\n    const fetchUserStats = async () => {\r\n      try {\r\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/user/stats`, {\r\n          headers: { Authorization: `Bearer ${store.state.token}` }\r\n        })\r\n        \r\n        stats.value = {\r\n          publishedCount: response.data.published_moments_count,\r\n          likesReceived: response.data.received_likes_count,\r\n          followingCount: response.data.following_count\r\n        }\r\n      } catch (error) {\r\n        console.error('获取用户统计数据失败:', error)\r\n        ElMessage.error('获取数据失败')\r\n      }\r\n    }\r\n    \r\n    // 获取最近发布的动态\r\n    const fetchRecentMoments = async () => {\r\n      try {\r\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/article/user_moments`, {\r\n          headers: { Authorization: `Bearer ${store.state.token}` },\r\n          params: { user_id: currentUser.id, limit: 3 }\r\n        })\r\n        \r\n        recentMoments.value = response.data.map(moment => ({\r\n          ...moment,\r\n          stats: {\r\n            likes: moment.stats.likes || 0,\r\n            comments: moment.stats.comments?.length || 0\r\n          }\r\n        }))\r\n      } catch (error) {\r\n        console.error('获取最近动态失败:', error)\r\n      }\r\n    }\r\n    \r\n    onMounted(() => {\r\n      if (currentUser) {\r\n        fetchUserStats()\r\n        fetchRecentMoments()\r\n      }\r\n    })\r\n\r\n    return {\r\n      stats,\r\n      recentMoments,\r\n      formatTime\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.dashboard-page {\r\n  padding: 20px;\r\n  background-color: #f0f2f5;\r\n  min-height: 100vh;\r\n}\r\n\r\n.dashboard-header {\r\n  text-align: center;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.dashboard-title {\r\n  font-size: 24px;\r\n  font-weight: 600;\r\n  color: #333;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.dashboard-subtitle {\r\n  font-size: 16px;\r\n  color: #666;\r\n}\r\n\r\n.dashboard-cards {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, 1fr);\r\n  gap: 20px;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.dashboard-card {\r\n  background: #fff;\r\n  border-radius: 12px;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);\r\n  padding: 20px;\r\n  transition: transform 0.3s ease, box-shadow 0.3s ease;\r\n}\r\n\r\n.dashboard-card:hover {\r\n  transform: translateY(-5px);\r\n  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.card-header {\r\n  display: flex;\r\n  align-items: center;\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.card-header i {\r\n  font-size: 24px;\r\n  color: #1890ff;\r\n  margin-right: 10px;\r\n}\r\n\r\n.card-header h3 {\r\n  font-size: 16px;\r\n  font-weight: 500;\r\n  color: #333;\r\n}\r\n\r\n.card-content {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n}\r\n\r\n.stat-value {\r\n  font-size: 36px;\r\n  font-weight: 700;\r\n  color: #333;\r\n  margin-bottom: 5px;\r\n}\r\n\r\n.stat-label {\r\n  font-size: 14px;\r\n  color: #666;\r\n}\r\n\r\n.recent-activity {\r\n  background: #fff;\r\n  border-radius: 12px;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);\r\n  padding: 20px;\r\n}\r\n\r\n.section-title {\r\n  font-size: 18px;\r\n  font-weight: 500;\r\n  color: #333;\r\n  margin-bottom: 20px;\r\n  padding-bottom: 10px;\r\n  border-bottom: 1px solid #eaeaea;\r\n}\r\n\r\n.activity-list {\r\n  list-style: none;\r\n  padding: 0;\r\n}\r\n\r\n.activity-item {\r\n  display: flex;\r\n  padding: 15px 0;\r\n  border-bottom: 1px solid #f0f2f5;\r\n}\r\n\r\n.activity-item:last-child {\r\n  border-bottom: none;\r\n}\r\n\r\n.activity-icon {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 40px;\r\n  height: 40px;\r\n  background-color: #e6f7ff;\r\n  border-radius: 50%;\r\n  color: #1890ff;\r\n  margin-right: 15px;\r\n}\r\n\r\n.activity-content {\r\n  flex: 1;\r\n}\r\n\r\n.activity-text {\r\n  font-size: 14px;\r\n  color: #333;\r\n  line-height: 1.5;\r\n  margin-bottom: 5px;\r\n}\r\n\r\n.activity-meta {\r\n  font-size: 12px;\r\n  color: #999;\r\n  display: flex;\r\n  gap: 15px;\r\n}\r\n\r\n.no-activity {\r\n  padding: 30px 0;\r\n  text-align: center;\r\n  color: #999;\r\n}\r\n\r\n.no-activity i {\r\n  font-size: 40px;\r\n  margin-bottom: 10px;\r\n  display: block;\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .dashboard-cards {\r\n    grid-template-columns: repeat(2, 1fr);\r\n  }\r\n  \r\n  .dashboard-title {\r\n    font-size: 20px;\r\n  }\r\n  \r\n  .stat-value {\r\n    font-size: 28px;\r\n  }\r\n}\r\n\r\n@media (max-width: 480px) {\r\n  .dashboard-cards {\r\n    grid-template-columns: 1fr;\r\n  }\r\n  \r\n  .activity-item {\r\n    flex-direction: column;\r\n  }\r\n  \r\n  .activity-icon {\r\n    margin-bottom: 10px;\r\n  }\r\n}\r\n</style>"],"mappings":";;AA4EA,SAASA,GAAG,EAAEC,SAAQ,QAAS,KAAI;AACnC,SAASC,QAAO,QAAS,MAAK;AAC9B,OAAOC,KAAI,MAAO,OAAM;AACxB,SAASC,UAAS,QAAS,iBAAgB;AAC3C,SAASC,SAAQ,QAAS,cAAa;AAEvC,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIL,QAAQ,CAAC;IACvB,MAAMM,WAAU,GAAID,KAAK,CAACE,KAAK,CAACC,IAAG;IACnC,MAAMC,KAAI,GAAIX,GAAG,CAAC;MAChBY,cAAc,EAAE,CAAC;MACjBC,aAAa,EAAE,CAAC;MAChBC,cAAc,EAAE;IAClB,CAAC;IACD,MAAMC,aAAY,GAAIf,GAAG,CAAC,EAAE;;IAE5B;IACA,MAAMgB,UAAS,GAAKC,SAAS,IAAK;MAChC,MAAMC,IAAG,GAAI,IAAIC,IAAI,CAACF,SAAS;MAC/B,OAAO,GAAGC,IAAI,C