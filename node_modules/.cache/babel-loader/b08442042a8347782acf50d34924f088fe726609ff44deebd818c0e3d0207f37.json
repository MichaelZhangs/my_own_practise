{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.iterator.some.js\";\nimport \"core-js/modules/web.url-search-params.delete.js\";\nimport \"core-js/modules/web.url-search-params.has.js\";\nimport \"core-js/modules/web.url-search-params.size.js\";\nimport { ref, onMounted, onBeforeUnmount } from 'vue';\nimport { Picture, VideoCamera, Smoking, Thumb, ChatDotRound, Close, Loading } from '@element-plus/icons-vue';\nimport axios from 'axios';\nimport { API_CONFIG } from '@/config/config';\nimport defaultAvatar from '@/assets/default-avatar.png';\nimport { ElMessage } from 'element-plus';\n\n// 数据定义\n\nexport default {\n  __name: 'UserArticle',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const currentUser = ref({\n      id: 1,\n      username: '当前用户',\n      photo: 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\n    });\n    const moments = ref([]);\n    const loading = ref(false);\n    const noMore = ref(false);\n    const lastId = ref(null);\n    const container = ref(null);\n    const newMoment = ref({\n      content: '',\n      media: []\n    });\n    const posting = ref(false);\n    const showEmojiPicker = ref(false);\n    const showPreview = ref(false);\n    const previewImages = ref([]);\n    const previewIndex = ref(0);\n    const emojis = ['😀', '😃', '😄', '😁', '😆', '😅', '😂', '🤣', '😊', '😇', '🙂', '🙃', '😉', '😌', '😍', '🥰', '😘', '😗', '😙', '😚', '😋', '😛', '😝', '😜', '🤪', '🤨', '🧐', '🤓', '😎', '🤩', '🥳'];\n\n    // 模拟用户数据，实际应用中应从后端获取\n    const users = [{\n      id: 1,\n      username: '用户1',\n      photo: 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\n    }, {\n      id: 2,\n      username: '用户2',\n      photo: 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\n    }\n    // 更多用户数据...\n    ];\n\n    // 获取动态列表\n    const fetchMoments = async () => {\n      if (loading.value || noMore.value) return;\n      loading.value = true;\n      try {\n        const params = {};\n        if (lastId.value) {\n          params.last_id = lastId.value;\n        }\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/article/moments`, {\n          params\n        });\n        if (response.data.length === 0) {\n          noMore.value = true;\n          return;\n        }\n        const newMoments = response.data.map(moment => ({\n          ...moment,\n          showCommentInput: false,\n          newComment: ''\n        }));\n        if (lastId.value) {\n          moments.value = [...moments.value, ...newMoments];\n        } else {\n          moments.value = newMoments;\n        }\n        lastId.value = newMoments[newMoments.length - 1].id;\n      } catch (error) {\n        console.error('获取动态列表失败:', error);\n      } finally {\n        loading.value = false;\n      }\n    };\n\n    // 滚动加载\n    const handleScroll = () => {\n      if (noMore.value || loading.value) return;\n      const {\n        scrollTop,\n        scrollHeight,\n        clientHeight\n      } = container.value;\n      const threshold = 100; // 距离底部100px时加载\n\n      if (scrollHeight - (scrollTop + clientHeight) < threshold) {\n        fetchMoments();\n      }\n    };\n\n    // 发布动态\n    const postMoment = async () => {\n      if (!newMoment.value.content.trim() && newMoment.value.media.length === 0) {\n        ElMessage.warning('请填写内容或上传图片/视频');\n        return;\n      }\n      posting.value = true;\n      try {\n        const formData = new FormData();\n        formData.append('content', newMoment.value.content);\n        newMoment.value.media.forEach((media, index) => {\n          if (media.file) {\n            formData.append(`media_${index}`, media.file);\n          }\n        });\n        const response = await axios.post(`${API_CONFIG.BASE_URL}/article/moments`, formData, {\n          headers: {\n            'Content-Type': 'multipart/form-data'\n          }\n        });\n        moments.value.unshift({\n          ...response.data,\n          showCommentInput: false,\n          newComment: ''\n        });\n        newMoment.value.content = '';\n        newMoment.value.media = [];\n        ElMessage.success('发布成功');\n      } catch (error) {\n        console.error('发布动态失败:', error);\n        ElMessage.error('发布失败');\n      } finally {\n        posting.value = false;\n      }\n    };\n\n    // 上传媒体处理\n    const handleUploadSuccess = (response, file) => {\n      const type = file.raw.type.startsWith('image') ? 'image' : 'video';\n      newMoment.value.media.push({\n        type,\n        url: URL.createObjectURL(file.raw),\n        file: file.raw\n      });\n    };\n    const beforeUpload = file => {\n      const isMedia = file.type.startsWith('image/') || file.type.startsWith('video/');\n      const isLt10M = file.size / 1024 / 1024 < 10;\n      if (!isMedia) {\n        ElMessage.error('只能上传图片或视频!');\n        return false;\n      }\n      if (!isLt10M) {\n        ElMessage.error('文件大小不能超过10MB!');\n        return false;\n      }\n      return true;\n    };\n    const removeMedia = index => {\n      newMoment.value.media.splice(index, 1);\n    };\n\n    // 点赞/取消点赞\n    const toggleLike = async moment => {\n      try {\n        const isLiked = moment.likes.some(like => like.user_id === currentUser.value.id);\n        if (isLiked) {\n          await axios.delete(`${API_CONFIG.BASE_URL}/article/moments/${moment.id}/likes`);\n          moment.likes = moment.likes.filter(like => like.user_id !== currentUser.value.id);\n        } else {\n          const response = await axios.post(`${API_CONFIG.BASE_URL}/article/moments/${moment.id}/likes`);\n          moment.likes.push(response.data);\n        }\n      } catch (error) {\n        console.error('操作点赞失败:', error);\n      }\n    };\n\n    // 评论处理\n    const toggleCommentInput = moment => {\n      moment.showCommentInput = !moment.showCommentInput;\n    };\n    const postComment = async moment => {\n      if (!moment.newComment.trim()) return;\n      try {\n        const response = await axios.post(`${API_CONFIG.BASE_URL}/article/moments/${moment.id}/comments`, {\n          content: moment.newComment\n        });\n        moment.comments.push(response.data);\n        moment.newComment = '';\n        moment.showCommentInput = false;\n      } catch (error) {\n        console.error('发表评论失败:', error);\n      }\n    };\n\n    // 图片预览\n    const openPreview = (mediaList, index) => {\n      previewImages.value = mediaList.filter(media => media.type === 'image').map(media => media.url);\n      if (previewImages.value.length > 0) {\n        previewIndex.value = index;\n        showPreview.value = true;\n      }\n    };\n    const closePreview = () => {\n      showPreview.value = false;\n    };\n\n    // 辅助函数\n    const getMediaGrid = count => {\n      if (count === 1) return '1fr';\n      if (count === 2) return '1fr 1fr';\n      if (count === 3) return '1fr 1fr 1fr';\n      if (count === 4) return '1fr 1fr';\n      return '1fr 1fr 1fr';\n    };\n    const formatDate = dateString => {\n      const date = new Date(dateString);\n      const now = new Date();\n      const diff = now - date;\n      const minutes = Math.floor(diff / 60000);\n      if (minutes < 1) return '刚刚';\n      if (minutes < 60) return `${minutes}分钟前`;\n      const hours = Math.floor(minutes / 60);\n      if (hours < 24) return `${hours}小时前`;\n      const days = Math.floor(hours / 24);\n      if (days < 7) return `${days}天前`;\n      return date.toLocaleDateString();\n    };\n\n    // eslint-disable-next-line no-unused-vars  // 忽略 ESLint 关于 userId 未使用的检查\n    const getUserAvatar = userId => {\n      const user = users.find(u => u.id === userId);\n      return user ? user.photo : defaultAvatar;\n    };\n\n    // eslint-disable-next-line no-unused-vars  // 忽略 ESLint 关于 userId 未使用的检查\n    const getUsername = userId => {\n      const user = users.find(u => u.id === userId);\n      return user ? user.username : '未知用户';\n    };\n    const insertEmoji = emoji => {\n      newMoment.value.content += emoji;\n      showEmojiPicker.value = false;\n    };\n\n    // 初始化加载\n    onMounted(() => {\n      fetchMoments();\n      window.addEventListener('scroll', handleScroll);\n    });\n    onBeforeUnmount(() => {\n      window.removeEventListener('scroll', handleScroll);\n    });\n    const __returned__ = {\n      currentUser,\n      moments,\n      loading,\n      noMore,\n      lastId,\n      container,\n      newMoment,\n      posting,\n      showEmojiPicker,\n      showPreview,\n      previewImages,\n      previewIndex,\n      emojis,\n      users,\n      fetchMoments,\n      handleScroll,\n      postMoment,\n      handleUploadSuccess,\n      beforeUpload,\n      removeMedia,\n      toggleLike,\n      toggleCommentInput,\n      postComment,\n      openPreview,\n      closePreview,\n      getMediaGrid,\n      formatDate,\n      getUserAvatar,\n      getUsername,\n      insertEmoji,\n      ref,\n      onMounted,\n      onBeforeUnmount,\n      get Picture() {\n        return Picture;\n      },\n      get VideoCamera() {\n        return VideoCamera;\n      },\n      get Smoking() {\n        return Smoking;\n      },\n      get Thumb() {\n        return Thumb;\n      },\n      get ChatDotRound() {\n        return ChatDotRound;\n      },\n      get Close() {\n        return Close;\n      },\n      get Loading() {\n        return Loading;\n      },\n      get axios() {\n        return axios;\n      },\n      get API_CONFIG() {\n        return API_CONFIG;\n      },\n      get defaultAvatar() {\n        return defaultAvatar;\n      },\n      get ElMessage() {\n        return ElMessage;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","onBeforeUnmount","Picture","VideoCamera","Smoking","Thumb","ChatDotRound","Close","Loading","axios","API_CONFIG","defaultAvatar","ElMessage","currentUser","id","username","photo","moments","loading","noMore","lastId","container","newMoment","content","media","posting","showEmojiPicker","showPreview","previewImages","previewIndex","emojis","users","fetchMoments","value","params","last_id","response","get","BASE_URL","data","length","newMoments","map","moment","showCommentInput","newComment","error","console","handleScroll","scrollTop","scrollHeight","clientHeight","threshold","postMoment","trim","warning","formData","FormData","append","forEach","index","file","post","headers","unshift","success","handleUploadSuccess","type","raw","startsWith","push","url","URL","createObjectURL","beforeUpload","isMedia","isLt10M","size","removeMedia","splice","toggleLike","isLiked","likes","some","like","user_id","delete","filter","toggleCommentInput","postComment","comments","openPreview","mediaList","closePreview","getMediaGrid","count","formatDate","dateString","date","Date","now","diff","minutes","Math","floor","hours","days","toLocaleDateString","getUserAvatar","userId","user","find","u","getUsername","insertEmoji","emoji","window","addEventListener","removeEventListener"],"sources":["E:/vue_fastapi/my_vue/vue_pro/src/article/UserArticle.vue"],"sourcesContent":["<template>\r\n  <div class=\"moment-container\" ref=\"container\">\r\n    <!-- 顶部标题 -->\r\n    <div class=\"header\">\r\n      <h2>朋友圈</h2>\r\n    </div>\r\n\r\n    <!-- 发布动态区域 -->\r\n    <div class=\"post-editor\">\r\n      <div class=\"user-info\">\r\n        <el-avatar :src=\"currentUser.photo || defaultAvatar\" />\r\n        <div class=\"post-input\">\r\n          <el-input\r\n            v-model=\"newMoment.content\"\r\n            type=\"textarea\"\r\n            :rows=\"3\"\r\n            placeholder=\"分享你的想法...\"\r\n            resize=\"none\"\r\n          />\r\n          <div class=\"media-preview\" v-if=\"newMoment.media.length > 0\">\r\n            <div\r\n              v-for=\"(media, index) in newMoment.media\"\r\n              :key=\"index\"\r\n              class=\"media-item\"\r\n            >\r\n              <img\r\n                v-if=\"media.type === 'image'\"\r\n                :src=\"media.url\"\r\n                @click=\"openPreview(newMoment.media, index)\"\r\n              />\r\n              <video\r\n                v-else\r\n                :src=\"media.url\"\r\n                controls\r\n              />\r\n              <el-icon class=\"delete-icon\" @click=\"removeMedia(index)\">\r\n                <Close />\r\n              </el-icon>\r\n            </div>\r\n          </div>\r\n          <div class=\"post-actions\">\r\n            <div class=\"action-buttons\">\r\n              <el-upload\r\n                action=\"/api/upload\"\r\n                :show-file-list=\"false\"\r\n                :multiple=\"true\"\r\n                :limit=\"9\"\r\n                accept=\"image/*,video/*\"\r\n                :on-success=\"handleUploadSuccess\"\r\n                :before-upload=\"beforeUpload\"\r\n              >\r\n                <el-button type=\"text\" :icon=\"Picture\" />\r\n              </el-upload>\r\n              <el-button type=\"text\" :icon=\"VideoCamera\" />\r\n              <el-button type=\"text\" :icon=\"Smoking\" @click=\"showEmojiPicker = !showEmojiPicker\" />\r\n            </div>\r\n            <el-button\r\n              type=\"primary\"\r\n              size=\"small\"\r\n              @click=\"postMoment\"\r\n              :loading=\"posting\"\r\n            >\r\n              发布\r\n            </el-button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 表情选择器 -->\r\n    <el-popover\r\n      v-model:visible=\"showEmojiPicker\"\r\n      placement=\"top-start\"\r\n      :width=\"300\"\r\n      trigger=\"click\"\r\n    >\r\n      <div class=\"emoji-grid\">\r\n        <span\r\n          v-for=\"emoji in emojis\"\r\n          :key=\"emoji\"\r\n          @click=\"insertEmoji(emoji)\"\r\n          class=\"emoji-item\"\r\n        >\r\n          {{ emoji }}\r\n        </span>\r\n      </div>\r\n      <template #reference>\r\n        <div style=\"display: none;\"></div>\r\n      </template>\r\n    </el-popover>\r\n\r\n    <!-- 动态列表 -->\r\n    <div class=\"moment-list\">\r\n      <div\r\n        v-for=\"moment in moments\"\r\n        :key=\"moment.id\"\r\n        class=\"moment-item\"\r\n      >\r\n        <div class=\"user-info\">\r\n          <el-avatar :src=\"getUserAvatar(moment.user_id)\" />\r\n          <div class=\"user-details\">\r\n            <span class=\"username\">{{ getUsername(moment.user_id) }}</span>\r\n            <span class=\"post-time\">{{ formatDate(moment.created_at) }}</span>\r\n          </div>\r\n        </div>\r\n\r\n        <div class=\"moment-content\">{{ moment.content }}</div>\r\n\r\n        <!-- 媒体展示 -->\r\n        <div\r\n          class=\"media-container\"\r\n          v-if=\"moment.media && moment.media.length > 0\"\r\n          :style=\"{ 'grid-template-columns': getMediaGrid(moment.media.length) }\"\r\n        >\r\n          <div\r\n            v-for=\"(media, index) in moment.media\"\r\n            :key=\"index\"\r\n            class=\"media-item\"\r\n          >\r\n            <img\r\n              v-if=\"media.type === 'image'\"\r\n              :src=\"media.url\"\r\n              @click=\"openPreview(moment.media, index)\"\r\n            />\r\n            <video\r\n              v-else\r\n              :src=\"media.url\"\r\n              controls\r\n            />\r\n          </div>\r\n        </div>\r\n\r\n        <!-- 互动区域 -->\r\n        <div class=\"interaction\">\r\n          <div class=\"action-buttons\">\r\n            <el-button\r\n              :icon=\"Thumb\"\r\n              :type=\"moment.likes.some(like => like.user_id === currentUser.id)? 'primary' : 'text'\"\r\n              @click=\"toggleLike(moment)\"\r\n              size=\"small\"\r\n            >\r\n              {{ moment.likes.length }}\r\n            </el-button>\r\n            <el-button\r\n              :icon=\"ChatDotRound\"\r\n              @click=\"toggleCommentInput(moment)\"\r\n              size=\"small\"\r\n            >\r\n              {{ moment.comments.length }}\r\n            </el-button>\r\n          </div>\r\n\r\n          <!-- 评论输入框 -->\r\n          <div v-if=\"moment.showCommentInput\" class=\"comment-input\">\r\n            <el-input\r\n              v-model=\"moment.newComment\"\r\n              placeholder=\"写评论...\"\r\n              size=\"small\"\r\n              @keyup.enter=\"postComment(moment)\"\r\n            >\r\n              <template #append>\r\n                <el-button @click=\"postComment(moment)\">\r\n                  发送\r\n                </el-button>\r\n              </template>\r\n            </el-input>\r\n          </div>\r\n\r\n          <!-- 评论列表 -->\r\n          <div v-if=\"moment.comments.length > 0\" class=\"comment-list\">\r\n            <div\r\n              v-for=\"comment in moment.comments\"\r\n              :key=\"comment.id\"\r\n              class=\"comment-item\"\r\n            >\r\n              <span class=\"comment-user\">{{ getUsername(comment.user_id) }}：</span>\r\n              <span class=\"comment-content\">{{ comment.content }}</span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- 加载更多提示 -->\r\n      <div v-if=\"loading\" class=\"loading-more\">\r\n        <el-icon class=\"is-loading\"><Loading /></el-icon>\r\n        <span>加载中...</span>\r\n      </div>\r\n      <div v-if=\"noMore\" class=\"no-more\">\r\n        没有更多内容了\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 图片预览 -->\r\n    <el-image-viewer\r\n      v-if=\"showPreview\"\r\n      :url-list=\"previewImages\"\r\n      :initial-index=\"previewIndex\"\r\n      @close=\"closePreview\"\r\n    />\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, onMounted, onBeforeUnmount } from 'vue'\r\nimport {\r\n  Picture, VideoCamera, Smoking, Thumb, ChatDotRound, Close, Loading\r\n} from '@element-plus/icons-vue'\r\nimport axios from 'axios'\r\nimport { API_CONFIG } from '@/config/config'\r\nimport defaultAvatar from '@/assets/default-avatar.png'\r\nimport { ElMessage } from 'element-plus'\r\n\r\n// 数据定义\r\nconst currentUser = ref({\r\n  id: 1,\r\n  username: '当前用户',\r\n  photo: 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png'\r\n})\r\n\r\nconst moments = ref([])\r\nconst loading = ref(false)\r\nconst noMore = ref(false)\r\nconst lastId = ref(null)\r\nconst container = ref(null)\r\n\r\nconst newMoment = ref({\r\n  content: '',\r\n  media: []\r\n})\r\n\r\nconst posting = ref(false)\r\nconst showEmojiPicker = ref(false)\r\nconst showPreview = ref(false)\r\nconst previewImages = ref([])\r\nconst previewIndex = ref(0)\r\n\r\nconst emojis = ['😀', '😃', '😄', '😁', '😆', '😅', '😂', '🤣', '😊', '😇', '🙂', '🙃', '😉', '😌', '😍', '🥰', '😘', '😗', '😙', '😚', '😋', '😛', '😝', '😜', '🤪', '🤨', '🧐', '🤓', '😎', '🤩', '🥳']\r\n\r\n// 模拟用户数据，实际应用中应从后端获取\r\nconst users = [\r\n  { id: 1, username: '用户1', photo: 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png' },\r\n  { id: 2, username: '用户2', photo: 'https://cube.elemecdn.com/3/7c/3ea6beec64369c2642b92c6726f1epng.png' },\r\n  // 更多用户数据...\r\n]\r\n\r\n// 获取动态列表\r\nconst fetchMoments = async () => {\r\n  if (loading.value || noMore.value) return\r\n\r\n  loading.value = true\r\n\r\n  try {\r\n    const params = {}\r\n    if (lastId.value) {\r\n      params.last_id = lastId.value\r\n    }\r\n\r\n    const response = await axios.get(`${API_CONFIG.BASE_URL}/article/moments`, { params })\r\n\r\n    if (response.data.length === 0) {\r\n      noMore.value = true\r\n      return\r\n    }\r\n\r\n    const newMoments = response.data.map(moment => ({\r\n     ...moment,\r\n      showCommentInput: false,\r\n      newComment: ''\r\n    }))\r\n\r\n    if (lastId.value) {\r\n      moments.value = [...moments.value, ...newMoments]\r\n    } else {\r\n      moments.value = newMoments\r\n    }\r\n\r\n    lastId.value = newMoments[newMoments.length - 1].id\r\n  } catch (error) {\r\n    console.error('获取动态列表失败:', error)\r\n  } finally {\r\n    loading.value = false\r\n  }\r\n}\r\n\r\n// 滚动加载\r\nconst handleScroll = () => {\r\n  if (noMore.value || loading.value) return\r\n\r\n  const { scrollTop, scrollHeight, clientHeight } = container.value\r\n  const threshold = 100 // 距离底部100px时加载\r\n\r\n  if (scrollHeight - (scrollTop + clientHeight) < threshold) {\r\n    fetchMoments()\r\n  }\r\n}\r\n\r\n// 发布动态\r\nconst postMoment = async () => {\r\n  if (!newMoment.value.content.trim() && newMoment.value.media.length === 0) {\r\n    ElMessage.warning('请填写内容或上传图片/视频')\r\n    return\r\n  }\r\n\r\n  posting.value = true\r\n\r\n  try {\r\n    const formData = new FormData()\r\n    formData.append('content', newMoment.value.content)\r\n    newMoment.value.media.forEach((media, index) => {\r\n      if (media.file) {\r\n        formData.append(`media_${index}`, media.file)\r\n      }\r\n    })\r\n\r\n    const response = await axios.post(`${API_CONFIG.BASE_URL}/article/moments`, formData, {\r\n      headers: {\r\n        'Content-Type': 'multipart/form-data'\r\n      }\r\n    })\r\n\r\n    moments.value.unshift({\r\n     ...response.data,\r\n      showCommentInput: false,\r\n      newComment: ''\r\n    })\r\n\r\n    newMoment.value.content = ''\r\n    newMoment.value.media = []\r\n    ElMessage.success('发布成功')\r\n  } catch (error) {\r\n    console.error('发布动态失败:', error)\r\n    ElMessage.error('发布失败')\r\n  } finally {\r\n    posting.value = false\r\n  }\r\n}\r\n\r\n// 上传媒体处理\r\nconst handleUploadSuccess = (response, file) => {\r\n  const type = file.raw.type.startsWith('image')? 'image' : 'video'\r\n  newMoment.value.media.push({\r\n    type,\r\n    url: URL.createObjectURL(file.raw),\r\n    file: file.raw\r\n  })\r\n}\r\n\r\nconst beforeUpload = (file) => {\r\n  const isMedia = file.type.startsWith('image/') || file.type.startsWith('video/')\r\n  const isLt10M = file.size / 1024 / 1024 < 10\r\n\r\n  if (!isMedia) {\r\n    ElMessage.error('只能上传图片或视频!')\r\n    return false\r\n  }\r\n  if (!isLt10M) {\r\n    ElMessage.error('文件大小不能超过10MB!')\r\n    return false\r\n  }\r\n\r\n  return true\r\n}\r\n\r\nconst removeMedia = (index) => {\r\n  newMoment.value.media.splice(index, 1)\r\n}\r\n\r\n// 点赞/取消点赞\r\nconst toggleLike = async (moment) => {\r\n  try {\r\n    const isLiked = moment.likes.some(like => like.user_id === currentUser.value.id)\r\n\r\n    if (isLiked) {\r\n      await axios.delete(`${API_CONFIG.BASE_URL}/article/moments/${moment.id}/likes`)\r\n      moment.likes = moment.likes.filter(like => like.user_id !== currentUser.value.id)\r\n    } else {\r\n      const response = await axios.post(`${API_CONFIG.BASE_URL}/article/moments/${moment.id}/likes`)\r\n      moment.likes.push(response.data)\r\n    }\r\n  } catch (error) {\r\n    console.error('操作点赞失败:', error)\r\n  }\r\n}\r\n\r\n// 评论处理\r\nconst toggleCommentInput = (moment) => {\r\n  moment.showCommentInput = !moment.showCommentInput\r\n}\r\n\r\nconst postComment = async (moment) => {\r\n  if (!moment.newComment.trim()) return\r\n\r\n  try {\r\n    const response = await axios.post(`${API_CONFIG.BASE_URL}/article/moments/${moment.id}/comments`, {\r\n      content: moment.newComment\r\n    })\r\n\r\n    moment.comments.push(response.data)\r\n    moment.newComment = ''\r\n    moment.showCommentInput = false\r\n  } catch (error) {\r\n    console.error('发表评论失败:', error)\r\n  }\r\n}\r\n\r\n// 图片预览\r\nconst openPreview = (mediaList, index) => {\r\n  previewImages.value = mediaList\r\n   .filter(media => media.type === 'image')\r\n   .map(media => media.url)\r\n\r\n  if (previewImages.value.length > 0) {\r\n    previewIndex.value = index\r\n    showPreview.value = true\r\n  }\r\n}\r\n\r\nconst closePreview = () => {\r\n  showPreview.value = false\r\n}\r\n\r\n// 辅助函数\r\nconst getMediaGrid = (count) => {\r\n  if (count === 1) return '1fr'\r\n  if (count === 2) return '1fr 1fr'\r\n  if (count === 3) return '1fr 1fr 1fr'\r\n  if (count === 4) return '1fr 1fr'\r\n  return '1fr 1fr 1fr'\r\n}\r\n\r\nconst formatDate = (dateString) => {\r\n  const date = new Date(dateString)\r\n  const now = new Date()\r\n  const diff = now - date\r\n  const minutes = Math.floor(diff / 60000)\r\n\r\n  if (minutes < 1) return '刚刚'\r\n  if (minutes < 60) return `${minutes}分钟前`\r\n\r\n  const hours = Math.floor(minutes / 60)\r\n  if (hours < 24) return `${hours}小时前`\r\n\r\n  const days = Math.floor(hours / 24)\r\n  if (days < 7) return `${days}天前`\r\n\r\n  return date.toLocaleDateString()\r\n}\r\n\r\n// eslint-disable-next-line no-unused-vars  // 忽略 ESLint 关于 userId 未使用的检查\r\nconst getUserAvatar = (userId) => {\r\n  const user = users.find(u => u.id === userId)\r\n  return user? user.photo : defaultAvatar\r\n}\r\n\r\n// eslint-disable-next-line no-unused-vars  // 忽略 ESLint 关于 userId 未使用的检查\r\nconst getUsername = (userId) => {\r\n  const user = users.find(u => u.id === userId)\r\n  return user? user.username : '未知用户'\r\n}\r\n\r\nconst insertEmoji = (emoji) => {\r\n  newMoment.value.content += emoji\r\n  showEmojiPicker.value = false\r\n}\r\n\r\n// 初始化加载\r\nonMounted(() => {\r\n  fetchMoments()\r\n  window.addEventListener('scroll', handleScroll)\r\n})\r\n\r\nonBeforeUnmount(() => {\r\n  window.removeEventListener('scroll', handleScroll)\r\n})\r\n</script>\r\n\r\n<style scoped>\r\n.moment-container {\r\n  max-width: 600px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n  background-color: #fff;\r\n}\r\n\r\n.header {\r\n  text-align: center;\r\n  margin-bottom: 20px;\r\n  padding-bottom: 15px;\r\n  border-bottom: 1px solid #f0f0f0;\r\n}\r\n\r\n.post-editor {\r\n  margin-bottom: 20px;\r\n  padding: 15px;\r\n  background-color: #f9f9f9;\r\n  border-radius: 8px;\r\n}\r\n\r\n.user-info {\r\n  display: flex;\r\n  gap: 10px;\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.post-input {\r\n  flex: 1;\r\n}\r\n\r\n.media-preview {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 5px;\r\n  margin: 10px 0;\r\n}\r\n\r\n.media-preview .media-item {\r\n  position: relative;\r\n  width: 80px;\r\n  height: 80px;\r\n  border-radius: 4px;\r\n  overflow: hidden;\r\n}\r\n\r\n.media-preview .media-item img,\r\n.media-preview .media-item video {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n}\r\n\r\n.delete-icon {\r\n  position: absolute;\r\n  top: 2px;\r\n  right: 2px;\r\n  background-color: rgba(0, 0, 0, 0.5);\r\n  color: white;\r\n  border-radius: 50%;\r\n  padding: 3px;\r\n  cursor: pointer;\r\n}\r\n\r\n.post-actions {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n}\r\n\r\n.action-buttons {\r\n  display: flex;\r\n  gap: 5px;\r\n}\r\n\r\n.moment-list {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 20px;\r\n}\r\n\r\n.moment-item {\r\n  padding: 15px;\r\n  border-radius: 8px;\r\n  background-color: #f9f9f9;\r\n}\r\n\r\n.user-details {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.username {\r\n  font-weight: bold;\r\n}\r\n\r\n.post-time {\r\n  font-size: 12px;\r\n  color: #999;\r\n}\r\n\r\n.moment-content {\r\n  margin: 10px 0;\r\n  line-height: 1.5;\r\n  word-break: break-word;\r\n}\r\n\r\n.media-container {\r\n  display: grid;\r\n  gap: 5px;\r\n  margin: 10px 0;\r\n}\r\n\r\n.media-container .media-item {\r\n  position: relative;\r\n  border-radius: 4px;\r\n  overflow: hidden;\r\n}\r\n\r\n.media-container .media-item img,\r\n.media-container .media-item video {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n  cursor: pointer;\r\n}\r\n\r\n.interaction {\r\n  margin-top: 15px;\r\n}\r\n\r\n.comment-input {\r\n  margin-top: 10px;\r\n}\r\n\r\n.comment-list {\r\n  margin-top: 10px;\r\n  padding: 8px;\r\n  background-color: #f0f0f0;\r\n  border-radius: 4px;\r\n}\r\n\r\n.comment-item {\r\n  ma