ue_fastapi\\my_vue\\vue_pro\\src\\article\\UserPublish.vue"],"sourcesContent":["<!-- Publish.vue -->\r\n<template>\r\n  <div class=\"publish-page\">\r\n    <div class=\"editor-container\">\r\n      <div class=\"toolbar\">\r\n        <button @click=\"formatText('bold')\" title=\"加粗\">\r\n          <strong>B</strong>\r\n        </button>\r\n        <button @click=\"formatText('italic')\" title=\"斜体\">\r\n          <em>I</em>\r\n        </button>\r\n        <button @click=\"formatText('underline')\" title=\"下划线\">\r\n          <u>U</u>\r\n        </button>\r\n      </div>\r\n      \r\n      <div \r\n        ref=\"editor\" \r\n        contenteditable=\"true\"\r\n        class=\"content-editor\"\r\n        placeholder=\"输入内容...\"\r\n        @input=\"updateContent\"\r\n      ></div>\r\n      \r\n      <button class=\"publish-button\" @click=\"publish\">\r\n        发布\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport { useStore } from 'vuex'\r\n\r\nexport default {\r\n  setup() {\r\n    const router = useRouter()\r\n    const store = useStore()\r\n    const editor = ref(null)\r\n    const content = ref('')\r\n\r\n    const formatText = (command) => {\r\n      document.execCommand(command, false)\r\n      editor.value.focus()\r\n    }\r\n\r\n    const updateContent = (e) => {\r\n      content.value = e.target.innerHTML\r\n    }\r\n\r\n    const publish = () => {\r\n      if (content.value.trim()) {\r\n        const newMoment = {\r\n          content: content.value,\r\n          time: new Date().toLocaleString()\r\n        }\r\n        \r\n        store.commit('addMoment', newMoment)\r\n        router.push('/moments')\r\n      }\r\n    }\r\n\r\n    return { editor, formatText, updateContent, publish }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.publish-page {\r\n  max-width: 600px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n  background: #fff;\r\n  min-height: 100vh;\r\n}\r\n\r\n.editor-container {\r\n  border: 1px solid #e0e0e0;\r\n  border-radius: 12px;\r\n  overflow: hidden;\r\n}\r\n\r\n.toolbar {\r\n  padding: 12px;\r\n  background: #f8f8f8;\r\n  border-bottom: 1px solid #e0e0e0;\r\n  display: flex;\r\n  gap: 12px;\r\n}\r\n\r\n.toolbar button {\r\n  padding: 6px 12px;\r\n  border: 1px solid #ddd;\r\n  border-radius: 6px;\r\n  background: #fff;\r\n  cursor: pointer;\r\n  transition: all 0.2s;\r\n}\r\n\r\n.toolbar button:hover {\r\n  background: #f0f0f0;\r\n}\r\n\r\n.content-editor {\r\n  min-height: 300px;\r\n  padding: 20px;\r\n  outline: none;\r\n  font-size: 16px;\r\n  line-height: 1.6;\r\n}\r\n\r\n.content-editor:empty::before {\r\n  content: attr(placeholder);\r\n  color: #999;\r\n}\r\n\r\n.publish-button {\r\n  display: block;\r\n  width: 100%;\r\n  padding: 14px;\r\n  background: #07c160;\r\n  color: white;\r\n  border: none;\r\n  border-top: 1px solid #e0e0e0;\r\n  cursor: pointer;\r\n  font-size: 16px;\r\n  transition: background 0.2s;\r\n}\r\n\r\n.publish-button:hover {\r\n  background: #06ad54;\r\n}\r\n</style>"],"mappings":";;EAEOA,KAAK,EAAC;AAAc;;EAClBA,KAAK,EAAC;AAAkB;;EACtBA,KAAK,EAAC;AAAS;;uBAFxBC,mBAAA,CA0BM,OA1BNC,UA0BM,GAzBJC,mBAAA,CAwBM,OAxBNC,UAwBM,GAvBJD,mBAAA,CAUM,OAVNE,UAUM,GATJF,mBAAA,CAES;IAFAG,OAAK,EAAAC,MAAA,QAAAA,MAAA,MAAAC,MAAA,IAAEC,MAAA,CAAAC,UAAU;IAAUC,KAAK,EAAC;gCACxCR,mBAAA,CAAkB,gBAAV,GAAC,oB,IAEXA,mBAAA,CAES;IAFAG,OAAK,EAAAC,MAAA,QAAAA,MAAA,MAAAC,MAAA,IAAEC,MAAA,CAAAC,UAAU;IAAYC,KAAK,EAAC;gCAC1CR,mBAAA,CAAU,YAAN,GAAC,oB,IAEPA,mBAAA,CAES;IAFAG,OAAK,EAAAC,MAAA,QAAAA,MAAA,MAAAC,MAAA,IAAEC,MAAA,CAAAC,UAAU;IAAeC,KAAK,EAAC;gCAC7CR,mBAAA,CAAQ,WAAL,GAAC,oB,MAIRA,mBAAA,CAMO;IALLS,GAAG,EAAC,QAAQ;IACZC,eAAe,EAAC,MAAM;IACtBb,KAAK,EAAC,gBAAgB;IACtBc,WAAW,EAAC,SAAS;IACpBC,OAAK,EAAAR,MAAA,QAAAA,MAAA,UAAAS,IAAA,KAAEP,MAAA,CAAAQ,aAAA,IAAAR,MAAA,CAAAQ,aAAA,IAAAD,IAAA,CAAa;kDAGvBb,mBAAA,CAES;IAFDH,KAAK,EAAC,gBAAgB;IAAEM,OAAK,EAAAC,MAAA,QAAAA,MAAA,UAAAS,IAAA,KAAEP,MAAA,CAAAS,OAAA,IAAAT,MAAA,CAAAS,OAAA,I