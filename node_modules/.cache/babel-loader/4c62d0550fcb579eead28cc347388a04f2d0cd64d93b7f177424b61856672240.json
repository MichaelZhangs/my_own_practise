{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.set.difference.v2.js\";\nimport \"core-js/modules/es.set.intersection.v2.js\";\nimport \"core-js/modules/es.set.is-disjoint-from.v2.js\";\nimport \"core-js/modules/es.set.is-subset-of.v2.js\";\nimport \"core-js/modules/es.set.is-superset-of.v2.js\";\nimport \"core-js/modules/es.set.symmetric-difference.v2.js\";\nimport \"core-js/modules/es.set.union.v2.js\";\nimport { ref, computed, onMounted } from 'vue';\nimport { useStore } from 'vuex';\nimport { ElMessage, ElMessageBox } from 'element-plus';\nimport axios from 'axios';\nimport { API_CONFIG } from '@/config/config';\nimport defaultAvatar from '@/assets/default-avatar.png';\nexport default {\n  name: 'GroupInfo',\n  props: {\n    visible: {\n      type: Boolean,\n      default: false\n    },\n    groupInfo: {\n      type: Object,\n      default: () => ({})\n    }\n  },\n  emits: ['update:visible'],\n  setup(props, {\n    emit\n  }) {\n    const store = useStore();\n    const currentUserId = computed(() => store.state.user.id);\n    const currentUser = computed(() => store.state.user);\n    const groupMembers = ref([]);\n    const isMuted = ref(false);\n    const showEditName = ref(false);\n    const editGroupName = ref('');\n    const showAddMember = ref(false);\n    const searchKeyword = ref('');\n    const selectedUserIds = ref(new Set());\n    const allUsers = ref([]);\n    const isGroupOwner = computed(() => {\n      return props.groupInfo.owner_id === currentUserId.value;\n    });\n    const groupAvatarUrls = computed(() => {\n      if (!props.groupInfo) return [defaultAvatar];\n      const avatarMembers = props.groupInfo.avatar_members || [];\n      if (avatarMembers.length > 0) {\n        return avatarMembers.slice(0, 9).map(url => getFullUrl(url)).filter(Boolean);\n      }\n      const members = props.groupInfo.members || [];\n      return getFirstMembers(members, 9).map(memberId => getMemberAvatarById(memberId));\n    });\n    const filteredUsers = computed(() => {\n      if (!searchKeyword.value) return allUsers.value;\n      return allUsers.value.filter(user => user.username.toLowerCase().includes(searchKeyword.value.toLowerCase()) || user.id.toString().includes(searchKeyword.value));\n    });\n    const getFullUrl = path => {\n      if (!path) return defaultAvatar;\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`;\n    };\n    const getAvatarPosition = index => {\n      const positions = [{\n        top: '0%',\n        left: '0%',\n        width: '50%',\n        height: '50%'\n      }, {\n        top: '0%',\n        left: '50%',\n        width: '50%',\n        height: '50%'\n      }, {\n        top: '50%',\n        left: '0%',\n        width: '50%',\n        height: '50%'\n      }, {\n        top: '50%',\n        left: '50%',\n        width: '50%',\n        height: '50%'\n      }, {\n        top: '16%',\n        left: '16%',\n        width: '33%',\n        height: '33%'\n      }, {\n        top: '16%',\n        right: '16%',\n        width: '33%',\n        height: '33%'\n      }, {\n        bottom: '16%',\n        left: '16%',\n        width: '33%',\n        height: '33%'\n      }, {\n        bottom: '16%',\n        right: '16%',\n        width: '33%',\n        height: '33%'\n      }, {\n        top: '33%',\n        left: '33%',\n        width: '33%',\n        height: '33%'\n      }];\n      return positions[index] || positions[0];\n    };\n    const getMemberAvatar = member => {\n      return member.photo ? getFullUrl(member.photo) : defaultAvatar;\n    };\n    const getMemberAvatarById = memberId => {\n      const member = groupMembers.value.find(m => m.id === memberId);\n      return member?.photo ? getFullUrl(member.photo) : defaultAvatar;\n    };\n    const getMemberRole = member => {\n      if (member.id === props.groupInfo.owner_id) return '群主';\n      return '成员';\n    };\n    const getFirstMembers = (members, count) => {\n      if (!members) return [];\n      return members.slice(0, count);\n    };\n    const close = () => {\n      emit('update:visible', false);\n    };\n    const loadGroupMembers = async () => {\n      try {\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/group/${props.groupInfo.id}/members`, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        });\n        if (response.data) {\n          groupMembers.value = response.data.members || [];\n        }\n      } catch (error) {\n        console.error('加载群成员失败:', error);\n        ElMessage.error('加载群成员失败');\n      }\n    };\n    const loadAllUsers = async () => {\n      try {\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/users`, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        });\n        if (response.data) {\n          // 过滤掉已经是群成员的用户\n          const memberIds = new Set(groupMembers.value.map(m => m.id));\n          allUsers.value = response.data.filter(user => !memberIds.has(user.id));\n        }\n      } catch (error) {\n        console.error('加载用户列表失败:', error);\n        ElMessage.error('加载用户列表失败');\n      }\n    };\n    const showEditNameDialog = () => {\n      editGroupName.value = props.groupInfo.name || '';\n      showEditName.value = true;\n    };\n    const cancelEditName = () => {\n      showEditName.value = false;\n    };\n    const confirmEditName = async () => {\n      try {\n        const response = await axios.post(`${API_CONFIG.BASE_URL}/group/update-name`, {\n          group_id: props.groupInfo.id,\n          name: editGroupName.value\n        }, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        });\n        if (response.data.success) {\n          ElMessage.success('群名称修改成功');\n          // 通知父组件更新群信息\n          emit('group-updated');\n        } else {\n          ElMessage.error(response.data.message || '修改失败');\n        }\n      } catch (error) {\n        console.error('修改群名称失败:', error);\n        ElMessage.error('修改群名称失败');\n      }\n      showEditName.value = false;\n    };\n    const toggleMute = async () => {\n      try {\n        const response = await axios.post(`${API_CONFIG.BASE_URL}/group/${props.groupInfo.id}/mute`, {\n          muted: !isMuted.value\n        }, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        });\n        if (response.data.success) {\n          isMuted.value = !isMuted.value;\n          ElMessage.success(isMuted.value ? '已开启消息免打扰' : '已关闭消息免打扰');\n        }\n      } catch (error) {\n        console.error('设置消息免打扰失败:', error);\n        ElMessage.error('设置失败');\n      }\n    };\n    const removeMember = async member => {\n      try {\n        await ElMessageBox.confirm(`确定要将 ${member.username} 移出群聊吗？`, '确认移除', {\n          type: 'warning'\n        });\n        const response = await axios.post(`${API_CONFIG.BASE_URL}/group/remove-member`, {\n          group_id: props.groupInfo.id,\n          user_id: member.id\n        }, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        });\n        if (response.data.success) {\n          ElMessage.success('成员已移除');\n          // 重新加载群成员\n          await loadGroupMembers();\n          await loadAllUsers();\n          emit('group-updated');\n        }\n      } catch (error) {\n        if (error !== 'cancel') {\n          console.error('移除成员失败:', error);\n          ElMessage.error('移除成员失败');\n        }\n      }\n    };\n    const exitGroup = async () => {\n      try {\n        await ElMessageBox.confirm('确定要退出该群聊吗？退出后将不再接收该群消息', '确认退出', {\n          type: 'warning'\n        });\n        const response = await axios.post(`${API_CONFIG.BASE_URL}/group/exit`, {\n          group_id: props.groupInfo.id\n        }, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        });\n        if (response.data.success) {\n          ElMessage.success('已退出群聊');\n          close();\n          // 通知父组件处理退出后的逻辑\n          emit('group-exited');\n        }\n      } catch (error) {\n        if (error !== 'cancel') {\n          console.error('退出群聊失败:', error);\n          ElMessage.error('退出群聊失败');\n        }\n      }\n    };\n    const showAddMemberDialog = async () => {\n      await loadAllUsers();\n      showAddMember.value = true;\n      selectedUserIds.value.clear();\n      searchKeyword.value = '';\n    };\n    const closeAddMemberDialog = () => {\n      showAddMember.value = false;\n    };\n    const selectUser = user => {\n      if (selectedUserIds.value.has(user.id)) {\n        selectedUserIds.value.delete(user.id);\n      } else {\n        selectedUserIds.value.add(user.id);\n      }\n    };\n    const isUserSelected = userId => {\n      return selectedUserIds.value.has(userId);\n    };\n    const confirmAddMembers = async () => {\n      if (selectedUserIds.value.size === 0) {\n        ElMessage.warning('请选择要添加的成员');\n        return;\n      }\n      try {\n        const response = await axios.post(`${API_CONFIG.BASE_URL}/group/add-members`, {\n          group_id: props.groupInfo.id,\n          user_ids: Array.from(selectedUserIds.value)\n        }, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        });\n        if (response.data.success) {\n          ElMessage.success('成员添加成功');\n          // 重新加载群成员\n          await loadGroupMembers();\n          await loadAllUsers();\n          closeAddMemberDialog();\n          emit('group-updated');\n        }\n      } catch (error) {\n        console.error('添加成员失败:', error);\n        ElMessage.error('添加成员失败');\n      }\n    };\n    onMounted(async () => {\n      if (props.visible && props.groupInfo.id) {\n        await loadGroupMembers();\n\n        // 加载群免打扰状态\n        try {\n          const response = await axios.get(`${API_CONFIG.BASE_URL}/group/${props.groupInfo.id}/mute-status`, {\n            headers: {\n              Authorization: `Bearer ${store.state.token}`\n            }\n          });\n          if (response.data.success) {\n            isMuted.value = response.data.muted;\n          }\n        } catch (error) {\n          console.error('获取免打扰状态失败:', error);\n        }\n      }\n    });\n    return {\n      currentUserId,\n      groupMembers,\n      isMuted,\n      showEditName,\n      editGroupName,\n      showAddMember,\n      searchKeyword,\n      filteredUsers,\n      isGroupOwner,\n      groupAvatarUrls,\n      getFullUrl,\n      getAvatarPosition,\n      getMemberAvatar,\n      getMemberRole,\n      close,\n      showEditNameDialog,\n      cancelEditName,\n      confirmEditName,\n      toggleMute,\n      removeMember,\n      exitGroup,\n      showAddMemberDialog,\n      closeAddMemberDialog,\n      selectUser,\n      isUserSelected,\n      confirmAddMembers\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","useStore","ElMessage","ElMessageBox","axios","API_CONFIG","defaultAvatar","name","props","visible","type","Boolean","default","groupInfo","Object","emits","setup","emit","store","currentUserId","state","user","id","currentUser","groupMembers","isMuted","showEditName","editGroupName","showAddMember","searchKeyword","selectedUserIds","Set","allUsers","isGroupOwner","owner_id","value","groupAvatarUrls","avatarMembers","avatar_members","length","slice","map","url","getFullUrl","filter","members","getFirstMembers","memberId","getMemberAvatarById","filteredUsers","username","toLowerCase","includes","toString","path","startsWith","BASE_URL","getAvatarPosition","index","positions","top","left","width","height","right","bottom","getMemberAvatar","member","photo","find","m","getMemberRole","count","close","loadGroupMembers","response","get","headers","Authorization","token","data","error","console","loadAllUsers","memberIds","has","showEditNameDialog","cancelEditName","confirmEditName","post","group_id","success","message","toggleMute","muted","removeMember","confirm","user_id","exitGroup","showAddMemberDialog","clear","closeAddMemberDialog","selectUser","delete","add","isUserSelected","userId","confirmAddMembers","size","warning","user_ids","Array","from"],"sources":["E:\\home\\vue_pro\\src\\views\\GroupInfo.vue"],"sourcesContent":["<!-- src/components/GroupInfo.vue -->\r\n<template>\r\n  <div class=\"group-info-dialog\" v-if=\"visible\">\r\n    <div class=\"group-info-content\">\r\n      <div class=\"group-info-header\">\r\n        <div class=\"group-info-close\" @click=\"close\">\r\n          <i class=\"fa-solid fa-xmark\"></i>\r\n        </div>\r\n        <div class=\"group-info-avatar\">\r\n          <div class=\"group-avatar\">\r\n            <div \r\n              v-for=\"(avatarUrl, idx) in groupAvatarUrls\" \r\n              :key=\"idx\"\r\n              class=\"group-avatar-member\"\r\n              :style=\"getAvatarPosition(idx)\"\r\n            >\r\n              <img \r\n                :src=\"avatarUrl\" \r\n                alt=\"成员头像\"\r\n                onerror=\"this.src='@/assets/default-avatar.png'\"\r\n              />\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div class=\"group-info-name\">\r\n          {{ groupInfo.name || '未命名群聊' }}\r\n          <span class=\"group-info-edit\" @click=\"showEditNameDialog\" v-if=\"isGroupOwner\">\r\n            <i class=\"fa-solid fa-pen\"></i>\r\n          </span>\r\n        </div>\r\n        <div class=\"group-info-id\">群ID: {{ groupInfo.id }}</div>\r\n      </div>\r\n      \r\n      <div class=\"group-info-body\">\r\n        <div class=\"group-info-section\">\r\n          <div class=\"group-info-section-title\">群成员 ({{ groupInfo.members_count || 0 }})</div>\r\n          <div class=\"members-list\">\r\n            <div class=\"member-item\" v-for=\"member in groupMembers\" :key=\"member.id\">\r\n              <div class=\"member-avatar\">\r\n                <img :src=\"getMemberAvatar(member)\" alt=\"成员头像\" onerror=\"this.src='@/assets/default-avatar.png'\">\r\n                <div class=\"member-actions\" v-if=\"isGroupOwner && member.id !== currentUserId\" @click=\"removeMember(member)\">\r\n                  <i class=\"fa-solid fa-minus\"></i>\r\n                </div>\r\n              </div>\r\n              <div class=\"member-name\">{{ member.username }}</div>\r\n              <div class=\"member-role\">{{ getMemberRole(member) }}</div>\r\n            </div>\r\n            \r\n            <div class=\"member-item\" v-if=\"isGroupOwner\">\r\n              <div class=\"add-member-btn\" @click=\"showAddMemberDialog\">\r\n                <i class=\"fa-solid fa-plus\"></i>\r\n              </div>\r\n              <div class=\"member-name\">添加成员</div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        \r\n        <div class=\"group-info-actions\">\r\n          <div class=\"group-action-btn\" @click=\"toggleMute\">\r\n            <i class=\"fa-solid\" :class=\"isMuted ? 'fa-bell' : 'fa-bell-slash'\"></i> \r\n            {{ isMuted ? '开启通知' : '消息免打扰' }}\r\n          </div>\r\n          <div class=\"group-action-btn danger-action\" @click=\"exitGroup\">\r\n            <i class=\"fa-solid fa-right-from-bracket\"></i> 退出群聊\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 编辑群名称弹窗 -->\r\n    <div v-if=\"showEditName\" class=\"edit-name-dialog\">\r\n      <div class=\"edit-name-content\">\r\n        <div class=\"edit-name-title\">修改群名称</div>\r\n        <input \r\n          type=\"text\" \r\n          class=\"edit-name-input\" \r\n          v-model=\"editGroupName\" \r\n          placeholder=\"请输入群名称\"\r\n          maxlength=\"20\"\r\n        >\r\n        <div class=\"edit-name-buttons\">\r\n          <button class=\"edit-name-btn edit-name-cancel\" @click=\"cancelEditName\">取消</button>\r\n          <button class=\"edit-name-btn edit-name-confirm\" @click=\"confirmEditName\">确定</button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 添加成员弹窗 -->\r\n    <div v-if=\"showAddMember\" class=\"add-member-dialog\">\r\n      <div class=\"add-member-content\">\r\n        <div class=\"add-member-header\">\r\n          <div class=\"add-member-title\">添加成员</div>\r\n          <div class=\"add-member-close\" @click=\"closeAddMemberDialog\">\r\n            <i class=\"fa-solid fa-xmark\"></i>\r\n          </div>\r\n        </div>\r\n        <div class=\"add-member-search\">\r\n          <input \r\n            type=\"text\" \r\n            v-model=\"searchKeyword\" \r\n            placeholder=\"搜索用户...\"\r\n            class=\"search-input\"\r\n          >\r\n        </div>\r\n        <div class=\"add-member-list\">\r\n          <div \r\n            v-for=\"user in filteredUsers\" \r\n            :key=\"user.id\" \r\n            class=\"user-item\"\r\n            @click=\"selectUser(user)\"\r\n          >\r\n            <div class=\"user-avatar\">\r\n              <img :src=\"getFullUrl(user.photo)\" alt=\"用户头像\" onerror=\"this.src='@/assets/default-avatar.png'\">\r\n            </div>\r\n            <div class=\"user-info\">\r\n              <div class=\"user-name\">{{ user.username }}</div>\r\n              <div class=\"user-id\">ID: {{ user.id }}</div>\r\n            </div>\r\n            <div class=\"user-checkbox\">\r\n              <input type=\"checkbox\" :checked=\"isUserSelected(user.id)\">\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div class=\"add-member-footer\">\r\n          <button class=\"add-member-cancel\" @click=\"closeAddMemberDialog\">取消</button>\r\n          <button class=\"add-member-confirm\" @click=\"confirmAddMembers\">确认添加</button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, onMounted } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { ElMessage, ElMessageBox } from 'element-plus';\r\nimport axios from 'axios';\r\nimport { API_CONFIG } from '@/config/config';\r\nimport defaultAvatar from '@/assets/default-avatar.png';\r\n\r\nexport default {\r\n  name: 'GroupInfo',\r\n  props: {\r\n    visible: {\r\n      type: Boolean,\r\n      default: false\r\n    },\r\n    groupInfo: {\r\n      type: Object,\r\n      default: () => ({})\r\n    }\r\n  },\r\n  emits: ['update:visible'],\r\n  setup(props, { emit }) {\r\n    const store = useStore();\r\n    const currentUserId = computed(() => store.state.user.id);\r\n    const currentUser = computed(() => store.state.user);\r\n    \r\n    const groupMembers = ref([]);\r\n    const isMuted = ref(false);\r\n    const showEditName = ref(false);\r\n    const editGroupName = ref('');\r\n    const showAddMember = ref(false);\r\n    const searchKeyword = ref('');\r\n    const selectedUserIds = ref(new Set());\r\n    const allUsers = ref([]);\r\n\r\n    const isGroupOwner = computed(() => {\r\n      return props.groupInfo.owner_id === currentUserId.value;\r\n    });\r\n\r\n    const groupAvatarUrls = computed(() => {\r\n      if (!props.groupInfo) return [defaultAvatar];\r\n      \r\n      const avatarMembers = props.groupInfo.avatar_members || [];\r\n      \r\n      if (avatarMembers.length > 0) {\r\n        return avatarMembers\r\n          .slice(0, 9)\r\n          .map(url => getFullUrl(url))\r\n          .filter(Boolean);\r\n      }\r\n      \r\n      const members = props.groupInfo.members || [];\r\n      return getFirstMembers(members, 9).map(memberId => getMemberAvatarById(memberId));\r\n    });\r\n\r\n    const filteredUsers = computed(() => {\r\n      if (!searchKeyword.value) return allUsers.value;\r\n      \r\n      return allUsers.value.filter(user => \r\n        user.username.toLowerCase().includes(searchKeyword.value.toLowerCase()) ||\r\n        user.id.toString().includes(searchKeyword.value)\r\n      );\r\n    });\r\n\r\n    const getFullUrl = (path) => {\r\n      if (!path) return defaultAvatar;\r\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`;\r\n    };\r\n\r\n    const getAvatarPosition = (index) => {\r\n      const positions = [\r\n        { top: '0%', left: '0%', width: '50%', height: '50%' },\r\n        { top: '0%', left: '50%', width: '50%', height: '50%' },\r\n        { top: '50%', left: '0%', width: '50%', height: '50%' },\r\n        { top: '50%', left: '50%', width: '50%', height: '50%' },\r\n        { top: '16%', left: '16%', width: '33%', height: '33%' },\r\n        { top: '16%', right: '16%', width: '33%', height: '33%' },\r\n        { bottom: '16%', left: '16%', width: '33%', height: '33%' },\r\n        { bottom: '16%', right: '16%', width: '33%', height: '33%' },\r\n        { top: '33%', left: '33%', width: '33%', height: '33%' }\r\n      ];\r\n      return positions[index] || positions[0];\r\n    };\r\n\r\n    const getMemberAvatar = (member) => {\r\n      return member.photo ? getFullUrl(member.photo) : defaultAvatar;\r\n    };\r\n\r\n    const getMemberAvatarById = (memberId) => {\r\n      const member = groupMembers.value.find(m => m.id === memberId);\r\n      return member?.photo ? getFullUrl(member.photo) : defaultAvatar;\r\n    };\r\n\r\n    const getMemberRole = (member) => {\r\n      if (member.id === props.groupInfo.owner_id) return '群主';\r\n      return '成员';\r\n    };\r\n\r\n    const getFirstMembers = (members, count) => {\r\n      if (!members) return [];\r\n      return members.slice(0, count);\r\n    };\r\n\r\n    const close = () => {\r\n      emit('update:visible', false);\r\n    };\r\n\r\n    const loadGroupMembers = async () => {\r\n      try {\r\n        const response = await axios.get(\r\n          `${API_CONFIG.BASE_URL}/group/${props.groupInfo.id}/members`,\r\n          { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n        );\r\n        \r\n        if (response.data) {\r\n          groupMembers.value = response.data.members || [];\r\n        }\r\n      } catch (error) {\r\n        console.error('加载群成员失败:', error);\r\n        ElMessage.error('加载群成员失败');\r\n      }\r\n    };\r\n\r\n    const loadAllUsers = async () => {\r\n      try {\r\n        const response = await axios.get(\r\n          `${API_CONFIG.BASE_URL}/users`,\r\n          { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n        );\r\n        \r\n        if (response.data) {\r\n          // 过滤掉已经是群成员的用户\r\n          const memberIds = new Set(groupMembers.value.map(m => m.id));\r\n          allUsers.value = response.data.filter(user => !memberIds.has(user.id));\r\n        }\r\n      } catch (error) {\r\n        console.error('加载用户列表失败:', error);\r\n        ElMessage.error('加载用户列表失败');\r\n      }\r\n    };\r\n\r\n    const showEditNameDialog = () => {\r\n      editGroupName.value = props.groupInfo.name || '';\r\n      showEditName.value = true;\r\n    };\r\n\r\n    const cancelEditName = () => {\r\n      showEditName.value = false;\r\n    };\r\n\r\n    const confirmEditName = async () => {\r\n      try {\r\n        const response = await axios.post(\r\n          `${API_CONFIG.BASE_URL}/group/update-name`,\r\n          {\r\n            group_id: props.groupInfo.id,\r\n            name: editGroupName.value\r\n          },\r\n          { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n        );\r\n        \r\n        if (response.data.success) {\r\n          ElMessage.success('群名称修改成功');\r\n          // 通知父组件更新群信息\r\n          emit('group-updated');\r\n        } else {\r\n          ElMessage.error(response.data.message || '修改失败');\r\n        }\r\n      } catch (error) {\r\n        console.error('修改群名称失败:', error);\r\n        ElMessage.error('修改群名称失败');\r\n      }\r\n      showEditName.value = false;\r\n    };\r\n\r\n    const toggleMute = async () => {\r\n      try {\r\n        const response = await axios.post(\r\n          `${API_CONFIG.BASE_URL}/group/${props.groupInfo.id}/mute`,\r\n          { muted: !isMuted.value },\r\n          { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n        );\r\n        \r\n        if (response.data.success) {\r\n          isMuted.value = !isMuted.value;\r\n          ElMessage.success(isMuted.value ? '已开启消息免打扰' : '已关闭消息免打扰');\r\n        }\r\n      } catch (error) {\r\n        console.error('设置消息免打扰失败:', error);\r\n        ElMessage.error('设置失败');\r\n      }\r\n    };\r\n\r\n    const removeMember = async (member) => {\r\n      try {\r\n        await ElMessageBox.confirm(\r\n          `确定要将 ${member.username} 移出群聊吗？`,\r\n          '确认移除',\r\n          { type: 'warning' }\r\n        );\r\n        \r\n        const response = await axios.post(\r\n          `${API_CONFIG.BASE_URL}/group/remove-member`,\r\n          {\r\n            group_id: props.groupInfo.id,\r\n            user_id: member.id\r\n          },\r\n          { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n        );\r\n        \r\n        if (response.data.success) {\r\n          ElMessage.success('成员已移除');\r\n          // 重新加载群成员\r\n          await loadGroupMembers();\r\n          await loadAllUsers();\r\n          emit('group-updated');\r\n        }\r\n      } catch (error) {\r\n        if (error !== 'cancel') {\r\n          console.error('移除成员失败:', error);\r\n          ElMessage.error('移除成员失败');\r\n        }\r\n      }\r\n    };\r\n\r\n    const exitGroup = async () => {\r\n      try {\r\n        await ElMessageBox.confirm(\r\n          '确定要退出该群聊吗？退出后将不再接收该群消息',\r\n          '确认退出',\r\n          { type: 'warning' }\r\n        );\r\n        \r\n        const response = await axios.post(\r\n          `${API_CONFIG.BASE_URL}/group/exit`,\r\n          { group_id: props.groupInfo.id },\r\n          { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n        );\r\n        \r\n        if (response.data.success) {\r\n          ElMessage.success('已退出群聊');\r\n          close();\r\n          // 通知父组件处理退出后的逻辑\r\n          emit('group-exited');\r\n        }\r\n      } catch (error) {\r\n        if (error !== 'cancel') {\r\n          console.error('退出群聊失败:', error);\r\n          ElMessage.error('退出群聊失败');\r\n        }\r\n      }\r\n    };\r\n\r\n    const showAddMemberDialog = async () => {\r\n      await loadAllUsers();\r\n      showAddMember.value = true;\r\n      selectedUserIds.value.clear();\r\n      searchKeyword.value = '';\r\n    };\r\n\r\n    const closeAddMemberDialog = () => {\r\n      showAddMember.value = false;\r\n    };\r\n\r\n    const selectUser = (user) => {\r\n      if (selectedUserIds.value.has(user.id)) {\r\n        selectedUserIds.value.delete(user.id);\r\n      } else {\r\n        selectedUserIds.value.add(user.id);\r\n      }\r\n    };\r\n\r\n    const isUserSelected = (userId) => {\r\n      return selectedUserIds.value.has(userId);\r\n    };\r\n\r\n    const confirmAddMembers = async () => {\r\n      if (selectedUserIds.value.size === 0) {\r\n        ElMessage.warning('请选择要添加的成员');\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const response = await axios.post(\r\n          `${API_CONFIG.BASE_URL}/group/add-members`,\r\n          {\r\n            group_id: props.groupInfo.id,\r\n            user_ids: Array.from(selectedUserIds.value)\r\n          },\r\n          { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n        );\r\n        \r\n        if (response.data.success) {\r\n          ElMessage.success('成员添加成功');\r\n          // 重新加载群成员\r\n          await loadGroupMembers();\r\n          await loadAllUsers();\r\n          closeAddMemberDialog();\r\n          emit('group-updated');\r\n        }\r\n      } catch (error) {\r\n        console.error('添加成员失败:', error);\r\n        ElMessage.error('添加成员失败');\r\n      }\r\n    };\r\n\r\n    onMounted(async () => {\r\n      if (props.visible && props.groupInfo.id) {\r\n        await loadGroupMembers();\r\n        \r\n        // 加载群免打扰状态\r\n        try {\r\n          const response = await axios.get(\r\n            `${API_CONFIG.BASE_URL}/group/${props.groupInfo.id}/mute-status`,\r\n            { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n          );\r\n          \r\n          if (response.data.success) {\r\n            isMuted.value = response.data.muted;\r\n          }\r\n        } catch (error) {\r\n          console.error('获取免打扰状态失败:', error);\r\n        }\r\n      }\r\n    });\r\n\r\n    return {\r\n      currentUserId,\r\n      groupMembers,\r\n      isMuted,\r\n      showEditName,\r\n      editGroupName,\r\n      showAddMember,\r\n      searchKeyword,\r\n      filteredUsers,\r\n      isGroupOwner,\r\n      groupAvatarUrls,\r\n      getFullUrl,\r\n      getAvatarPosition,\r\n      getMemberAvatar,\r\n      getMemberRole,\r\n      close,\r\n      showEditNameDialog,\r\n      cancelEditName,\r\n      confirmEditName,\r\n      toggleMute,\r\n      removeMember,\r\n      exitGroup,\r\n      showAddMemberDialog,\r\n      closeAddMemberDialog,\r\n      selectUser,\r\n      isUserSelected,\r\n      confirmAddMembers\r\n    };\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.group-info-dialog {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background-color: rgba(0, 0, 0, 0.5);\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  z-index: 1000;\r\n}\r\n\r\n.group-info-content {\r\n  background-color: white;\r\n  width: 90%;\r\n  max-width: 500px;\r\n  border-radius: 12px;\r\n  overflow: hidden;\r\n  max-height: 80vh;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.group-info-header {\r\n  padding: 20px;\r\n  text-align: center;\r\n  position: relative;\r\n  border-bottom: 1px solid #eee;\r\n}\r\n\r\n.group-info-close {\r\n  position: absolute;\r\n  right: 20px;\r\n  top: 20px;\r\n  cursor: pointer;\r\n  font-size: 18px;\r\n  color: #999;\r\n}\r\n\r\n.group-info-avatar {\r\n  width: 80px;\r\n  height: 80px;\r\n  border-radius: 10px;\r\n  margin: 0 auto 15px;\r\n  overflow: hidden;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  background-color: #f0f2f5;\r\n}\r\n\r\n.group-info-name {\r\n  font-size: 18px;\r\n  font-weight: bold;\r\n  margin-bottom: 5px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.group-info-edit {\r\n  margin-left: 8px;\r\n  color: #1890ff;\r\n  cursor: pointer;\r\n  font-size: 16px;\r\n}\r\n\r\n.group-info-id {\r\n  font-size: 14px;\r\n  color: #999;\r\n}\r\n\r\n.group-info-body {\r\n  flex: 1;\r\n  overflow-y: auto;\r\n  padding: 20px;\r\n}\r\n\r\n.group-info-section {\r\n  margin-bottom: 25px;\r\n}\r\n\r\n.group-info-section-title {\r\n  font-size: 16px;\r\n  font-weight: bold;\r\n  margin-bottom: 15px;\r\n  color: #333;\r\n}\r\n\r\n.members-list {\r\n  display: grid;\r\n  grid-template-columns: repeat(4, 1fr);\r\n  gap: 15px;\r\n}\r\n\r\n.member-item {\r\n  text-align: center;\r\n}\r\n\r\n.member-avatar {\r\n  width: 50px;\r\n  height: 50px;\r\n  border-radius: 50%;\r\n  margin: 0 auto 8px;\r\n  overflow: hidden;\r\n  position: relative;\r\n}\r\n\r\n.member-avatar img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n}\r\n\r\n.member-name {\r\n  font-size: 12px;\r\n  color: #333;\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n}\r\n\r\n.member-role {\r\n  font-size: 11px;\r\n  color: #999;\r\n}\r\n\r\n.member-actions {\r\n  position: absolute;\r\n  bottom: -5px;\r\n  right: -5px;\r\n  width: 20px;\r\n  height: 20px;\r\n  border-radius: 50%;\r\n  background-color: #ff4d4f;\r\n  color: white;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  font-size: 12px;\r\n  cursor: pointer;\r\n}\r\n\r\n.add-member-btn {\r\n  width: 50px;\r\n  height: 50px;\r\n  border-radius: 50%;\r\n  background-color: #f0f2f5;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  color: #999;\r\n  font-size: 24px;\r\n  cursor: pointer;\r\n  margin: 0 auto 8px;\r\n}\r\n\r\n.group-info-actions {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, 1fr);\r\n  gap: 15px;\r\n  margin-top: 20px;\r\n}\r\n\r\n.group-action-btn {\r\n  padding: 12px;\r\n  text-align: center;\r\n  background-color: #f0f2f5;\r\n  border-radius: 8px;\r\n  cursor: pointer;\r\n  transition: all 0.2s;\r\n}\r\n\r\n.group-action-btn:hover {\r\n  background-color: #e6e6e6;\r\n}\r\n\r\n.danger-action {\r\n  color: #ff4d4f;\r\n}\r\n\r\n/* 编辑名称弹窗 */\r\n.edit-name-dialog {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background-color: rgba(0, 0, 0, 0.5);\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  z-index: 1001;\r\n}\r\n\r\n.edit-name-content {\r\n  background-color: white;\r\n  width: 80%;\r\n  max-width: 400px;\r\n  border-radius: 12px;\r\n  padding: 20px;\r\n}\r\n\r\n.edit-name-title {\r\n  font-size: 18px;\r\n  font-weight: bold;\r\n  margin-bottom: 15px;\r\n  text-align: center;\r\n}\r\n\r\n.edit-name-input {\r\n  width: 100%;\r\n  padding: 12px;\r\n  border: 1px solid #e5e5e5;\r\n  border-radius: 8px;\r\n  margin-bottom: 20px;\r\n  font-size: 16px;\r\n}\r\n\r\n.edit-name-buttons {\r\n  display: flex;\r\n  justify-content: space-between;\r\n}\r\n\r\n.edit-name-btn {\r\n  padding: 10px 20px;\r\n  border-radius: 8px;\r\n  cursor: pointer;\r\n  border: none;\r\n}\r\n\r\n.edit-name-cancel {\r\n  background-color: #f0f2f5;\r\n  color: #333;\r\n}\r\n\r\n.edit-name-confirm {\r\n  background-color: #1890ff;\r\n  color: white;\r\n}\r\n\r\n/* 添加成员弹窗 */\r\n.add-member-dialog {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background-color: rgba(0, 0, 0, 0.5);\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  z-index: 1001;\r\n}\r\n\r\n.add-member-content {\r\n  background-color: white;\r\n  width: 90%;\r\n  max-width: 500px;\r\n  border-radius: 12px;\r\n  overflow: hidden;\r\n  max-height: 80vh;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.add-member-header {\r\n  padding: 20px;\r\n  text-align: center;\r\n  position: relative;\r\n  border-bottom: 1px solid #eee;\r\n}\r\n\r\n.add-member-title {\r\n  font-size: 18px;\r\n  font-weight: bold;\r\n}\r\n\r\n.add-member-close {\r\n  position: absolute;\r\n  right: 20px;\r\n  top: 20px;\r\n  cursor: pointer;\r\n  font-size: 18px;\r\n  color: #999;\r\n}\r\n\r\n.add-member-search {\r\n  padding: 15px;\r\n  border-bottom: 1px solid #eee;\r\n}\r\n\r\n.search-input {\r\n  width: 100%;\r\n  padding: 10px;\r\n  border: 1px solid #e5e5e5;\r\n  border-radius: 8px;\r\n  font-size: 14px;\r\n}\r\n\r\n.add-member-list {\r\n  flex: 1;\r\n  overflow-y: auto;\r\n  max-height: 300px;\r\n}\r\n\r\n.user-item {\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 12px 15px;\r\n  cursor: pointer;\r\n  border-bottom: 1px solid #f0f0f0;\r\n}\r\n\r\n.user-item:hover {\r\n  background-color: #f9f9f9;\r\n}\r\n\r\n.user-avatar {\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 50%;\r\n  overflow: hidden;\r\n  margin-right: 12px;\r\n}\r\n\r\n.user-avatar img {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: cover;\r\n}\r\n\r\n.user-info {\r\n  flex: 1;\r\n}\r\n\r\n.user-name {\r\n  font-weight: 500;\r\n  margin-bottom: 2px;\r\n}\r\n\r\n.user-id {\r\n  font-size: 12px;\r\n  color: #999;\r\n}\r\n\r\n.user-checkbox {\r\n  margin-left: 10px;\r\n}\r\n\r\n.add-member-footer {\r\n  padding: 15px;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  border-top: 1px solid #eee;\r\n}\r\n\r\n.add-member-cancel,\r\n.add-member-confirm {\r\n  padding: 10px 20px;\r\n  border-radius: 8px;\r\n  cursor: pointer;\r\n  border: none;\r\n}\r\n\r\n.add-member-cancel {\r\n  background-color: #f0f2f5;\r\n  color: #333;\r\n}\r\n\r\n.add-member-confirm {\r\n  background-color: #1890ff;\r\n  color: white;\r\n}\r\n