{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.find.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport { ref, onMounted, onUnmounted, computed, watchEffect } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { useStore } from 'vuex';\nimport axios from 'axios';\nimport DOMPurify from 'dompurify';\nimport defaultAvatar from '@/assets/default-avatar.png';\nimport { API_CONFIG } from '@/config/config';\nimport { ElMessage } from 'element-plus';\nimport useLike from '@/utils/UserLike';\nimport useComment from '@/utils/UserComment';\nexport default {\n  setup() {\n    const router = useRouter();\n    const store = useStore();\n    const moments = ref([]);\n    const loading = ref(false);\n    const noMore = ref(false);\n    const lastId = ref(null);\n    const pageSize = 10;\n    const error = ref(null);\n\n    // 用户方法\n    const currentUser = computed(() => store.state.user || {});\n    const goToUser = () => router.push('/user');\n    const goToUserProfile = userId => router.push(`/user/${userId}`);\n    const goToPublish = () => router.push('/publish');\n    const {\n      toggleLike\n    } = useLike();\n    const {\n      postComment: apiPostComment,\n      postReply: apiPostReply\n    } = useComment();\n    const goToMomentDetail = momentId => {\n      router.push(`/moment/${momentId}`);\n    };\n\n    // 工具方法\n    const getFullUrl = path => {\n      if (!path || path === defaultAvatar) return path;\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`;\n    };\n    const formatTime = timestamp => {\n      try {\n        const date = new Date(timestamp);\n        return `${date.getFullYear()}-${(date.getMonth() + 1).toString().padStart(2, '0')}-` + `${date.getDate().toString().padStart(2, '0')} ` + `${date.getHours().toString().padStart(2, '0')}:` + `${date.getMinutes().toString().padStart(2, '0')}`;\n      } catch (e) {\n        console.error('时间格式化错误:', e);\n        return '未知时间';\n      }\n    };\n    const getTimeAgo = timestamp => {\n      try {\n        const now = Date.now();\n        const diff = now - new Date(timestamp).getTime();\n        const minutes = Math.floor(diff / 60000);\n        const hours = Math.floor(minutes / 60);\n        const days = Math.floor(hours / 24);\n        if (minutes < 1) return '刚刚';\n        if (minutes < 60) return `${minutes}分钟前`;\n        if (hours < 24) return `${hours}小时前`;\n        return `${days}天前`;\n      } catch (e) {\n        console.error('时间计算错误:', e);\n        return '未知时间';\n      }\n    };\n    const sanitizeHtml = html => {\n      try {\n        return DOMPurify.sanitize(html);\n      } catch (e) {\n        console.error('HTML净化错误:', e);\n        return '';\n      }\n    };\n\n    // 动态加载\n    const fetchMoments = async () => {\n      if (loading.value || noMore.value) return;\n      loading.value = true;\n      error.value = null;\n      try {\n        const params = {\n          limit: pageSize,\n          last_id: lastId.value\n        };\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/article/moments`, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          },\n          params\n        });\n        if (!Array.isArray(response.data)) {\n          throw new Error('返回数据格式不正确');\n        }\n        const newMoments = response.data.map(moment => ({\n          ...moment,\n          showCommentInput: false,\n          commentInput: '',\n          comments: (moment.comments || []).map(comment => ({\n            ...comment,\n            showReplyInput: false,\n            replyInput: '',\n            replies: comment.replies || []\n          })),\n          showAllComments: false,\n          isLiked: moment.like_users?.includes(currentUser.value.id) || false\n        }));\n        moments.value = [...moments.value, ...newMoments];\n        lastId.value = newMoments[newMoments.length - 1]?.id;\n        noMore.value = newMoments.length < pageSize;\n      } catch (error) {\n        console.error('获取动态失败:', error);\n        error.value = error.message;\n        ElMessage.error('加载动态失败');\n      } finally {\n        loading.value = false;\n      }\n    };\n\n    // 互动功能\n    const toggleCommentInput = moment => {\n      moment.showCommentInput = !moment.showCommentInput;\n      moment.commentInput = '';\n    };\n    const toggleReplyInput = comment => {\n      comment.showReplyInput = !comment.showReplyInput;\n      comment.replyInput = '';\n    };\n    const handleLikeMoment = async momentId => {\n      const targetMoment = moments.value.find(m => m.id === momentId);\n      if (!targetMoment) return;\n      try {\n        const result = await toggleLike('moment', momentId);\n        if (result) {\n          targetMoment.isLiked = result.isLiked;\n          targetMoment.stats.likes = result.likes;\n        }\n      } catch (error) {\n        console.error('点赞失败:', error);\n        ElMessage.error('点赞操作失败');\n      }\n    };\n    const handleLikeComment = async commentId => {\n      try {\n        const result = await toggleLike('comment', commentId);\n        if (result) {\n          const targetComment = findCommentById(commentId);\n          if (targetComment) {\n            targetComment.isLiked = result.isLiked;\n            targetComment.likes = result.likes;\n          }\n        }\n      } catch (error) {\n        console.error('评论点赞失败:', error);\n        ElMessage.error('点赞操作失败');\n      }\n    };\n    const handleCommentSubmit = async (moment, content) => {\n      try {\n        const newComment = await apiPostComment(moment.id, content, currentUser.value);\n        if (newComment) {\n          moment.comments.unshift(newComment);\n          moment.stats.comments += 1;\n          moment.showCommentInput = false;\n        }\n      } catch (error) {\n        console.error('评论提交失败:', error);\n        ElMessage.error('评论发布失败');\n      }\n    };\n    const handleReplySubmit = async (comment, content) => {\n      try {\n        const newReply = await apiPostReply(comment.id, content, currentUser.value);\n        if (newReply) {\n          comment.replies.push(newReply);\n          comment.showReplyInput = false;\n        }\n      } catch (error) {\n        console.error('回复提交失败:', error);\n        ElMessage.error('回复失败');\n      }\n    };\n\n    // 辅助函数\n    const findCommentById = commentId => {\n      for (const moment of moments.value) {\n        const comment = moment.comments.find(c => c.id === commentId);\n        if (comment) return comment;\n        for (const c of moment.comments) {\n          const reply = c.replies.find(r => r.id === commentId);\n          if (reply) return reply;\n        }\n      }\n      return null;\n    };\n    const deleteMoment = async momentId => {\n      try {\n        await axios.post(`${API_CONFIG.BASE_URL}/article/delete/moment`, {\n          moment_id: momentId\n        }, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        });\n        moments.value = moments.value.filter(m => m.id !== momentId);\n        ElMessage.success('删除成功');\n      } catch (error) {\n        console.error('删除失败:', error);\n        ElMessage.error('删除失败');\n      }\n    };\n\n    // 辅助函数\n    const visibleComments = moment => {\n      return moment.showAllComments ? moment.comments : moment.comments.slice(0, 3);\n    };\n\n    // 生命周期\n    onMounted(() => {\n      fetchMoments();\n      window.addEventListener('scroll', handleScroll);\n    });\n    onUnmounted(() => {\n      window.removeEventListener('scroll', handleScroll);\n    });\n    const handleScroll = () => {\n      const {\n        scrollTop,\n        scrollHeight,\n        clientHeight\n      } = document.documentElement;\n      if (scrollTop + clientHeight >= scrollHeight - 100 && !loading.value) {\n        fetchMoments();\n      }\n    };\n\n    // 添加响应式错误处理\n    watchEffect(() => {\n      if (error.value) {\n        console.error('组件错误:', error.value);\n        // 可以在这里添加全局错误提示\n      }\n    });\n    return {\n      moments,\n      currentUser,\n      noMore,\n      loading,\n      error,\n      visibleComments,\n      getFullUrl,\n      formatTime,\n      getTimeAgo,\n      sanitizeHtml,\n      goToUser,\n      goToUserProfile,\n      goToPublish,\n      toggleCommentInput,\n      toggleReplyInput,\n      goToMomentDetail,\n      handleLikeMoment,\n      handleLikeComment,\n      handleCommentSubmit,\n      handleReplySubmit,\n      deleteMoment,\n      defaultAvatar\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","onUnmounted","computed","watchEffect","useRouter","useStore","axios","DOMPurify","defaultAvatar","API_CONFIG","ElMessage","useLike","useComment","setup","router","store","moments","loading","noMore","lastId","pageSize","error","currentUser","state","user","goToUser","push","goToUserProfile","userId","goToPublish","toggleLike","postComment","apiPostComment","postReply","apiPostReply","goToMomentDetail","momentId","getFullUrl","path","startsWith","BASE_URL","formatTime","timestamp","date","Date","getFullYear","getMonth","toString","padStart","getDate","getHours","getMinutes","e","console","getTimeAgo","now","diff","getTime","minutes","Math","floor","hours","days","sanitizeHtml","html","sanitize","fetchMoments","value","params","limit","last_id","response","get","headers","Authorization","token","Array","isArray","data","Error","newMoments","map","moment","showCommentInput","commentInput","comments","comment","showReplyInput","replyInput","replies","showAllComments","isLiked","like_users","includes","id","length","message","toggleCommentInput","toggleReplyInput","handleLikeMoment","targetMoment","find","m","result","stats","likes","handleLikeComment","commentId","targetComment","findCommentById","handleCommentSubmit","content","newComment","unshift","handleReplySubmit","newReply","c","reply","r","deleteMoment","post","moment_id","filter","success","visibleComments","slice","window","addEventListener","handleScroll","removeEventListener","scrollTop","scrollHeight","clientHeight","document","documentElement"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\article\\UserMoments_2.vue"],"sourcesContent":["<template>\r\n    <div class=\"moments-page\">\r\n      <!-- 左侧用户信息栏 -->\r\n      <div class=\"user-sidebar\">\r\n        <div class=\"user-profile\" @click=\"goToUser\">\r\n          <img\r\n            :src=\"getFullUrl(currentUser.photo) || defaultAvatar\"\r\n            class=\"sidebar-avatar\"\r\n          />\r\n          <span class=\"sidebar-username\">{{ currentUser.username }}</span>\r\n        </div>\r\n      </div>\r\n  \r\n      <!-- 头部容器 -->\r\n      <div class=\"moments-header\">\r\n        <div class=\"header-content\">\r\n          <div class=\"title-container\">\r\n            <h1>朋友圈</h1>\r\n          </div>\r\n        </div>\r\n      </div>\r\n  \r\n      <!-- 发布按钮 -->\r\n      <button class=\"publish-btn\" @click=\"goToPublish\">+</button>\r\n  \r\n      <!-- 动态内容容器 -->\r\n      <div class=\"moments-container\">\r\n        <div class=\"moments-list\">\r\n          <div\r\n            v-for=\"moment in moments\"\r\n            :key=\"moment.id\"\r\n            class=\"moment-item\"\r\n            @click=\"goToMomentDetail(moment.id)\"\r\n          >\r\n            <!-- 用户信息 -->\r\n            <div class=\"user-info\">\r\n              <img\r\n                :src=\"getFullUrl(moment.user.photo) || defaultAvatar\"\r\n                class=\"user-avatar\"\r\n              />\r\n              <div class=\"user-details\">\r\n                <span class=\"username\">{{ moment.user.username }}</span>\r\n                <span class=\"post-time\">{{ formatTime(moment.created_at) }}</span>\r\n              </div>\r\n            </div>\r\n  \r\n            <!-- 动态内容 -->\r\n            <div class=\"moment-content\" v-html=\"sanitizeHtml(moment.content)\"></div>\r\n  \r\n            <!-- 媒体内容 -->\r\n            <div v-if=\"moment.media?.length\" class=\"media-grid\">\r\n              <div\r\n                v-for=\"(media, index) in moment.media\"\r\n                :key=\"index\"\r\n                class=\"media-item\"\r\n                :class=\"{ 'video-container': media.type === 'video' }\"\r\n              >\r\n                <img\r\n                  v-if=\"media.type === 'image'\"\r\n                  :src=\"getFullUrl(media.url)\"\r\n                  @click.stop=\"openImagePreview(getFullUrl(media.url))\"\r\n                />\r\n                <video\r\n                  v-else-if=\"media.type === 'video'\"\r\n                  :src=\"getFullUrl(media.url)\"\r\n                  controls\r\n                  :poster=\"getFullUrl(media.thumbnail)\"\r\n                >\r\n                  <source :src=\"getFullUrl(media.url)\" :type=\"getVideoType(media.url)\">\r\n                  您的浏览器不支持视频播放\r\n                </video>\r\n              </div>\r\n            </div>\r\n  \r\n            <!-- 互动区域 -->\r\n            <div class=\"moment-interaction flex justify-end space-x-4\">\r\n              <div class=\"like-container flex items-center space-x-1 cursor-pointer\" @click.stop=\"handleLikeMoment(moment.id)\">\r\n                <i\r\n                  class=\"fa-solid fa-thumbs-up\"\r\n                  :class=\"{ 'liked': moment.isLiked }\"\r\n                ></i>\r\n                <span>{{ moment.stats.likes }}</span>\r\n              </div>\r\n              <div class=\"comment-container flex items-center space-x-1 cursor-pointer\" @click.stop=\"toggleCommentInput(moment)\">\r\n                <i class=\"fa-solid fa-comment\"></i>\r\n                <span>{{ moment.stats.comments }}</span>\r\n              </div>\r\n            </div>\r\n  \r\n            <!-- 底部信息 -->\r\n            <div class=\"moment-footer flex justify-between items-center text-sm text-gray-500\">\r\n              <span class=\"time-ago\">{{ getTimeAgo(moment.created_at) }}</span>\r\n              <i\r\n                v-if=\"moment.user_id === currentUser.id\"\r\n                class=\"fa-solid fa-trash-can delete-btn cursor-pointer hover:text-red-500\"\r\n                @click.stop=\"deleteMoment(moment.id)\"\r\n              ></i>\r\n            </div>\r\n  \r\n            <!-- 评论输入框 -->\r\n            <CommentInput\r\n              v-if=\"moment.showCommentInput\"\r\n              v-model=\"moment.commentInput\"\r\n              placeholder=\"发表评论...\"\r\n              button-text=\"发布\"\r\n              @submit=\"(content) => handleCommentSubmit(moment, content)\"\r\n              class=\"mt-2\"\r\n            />\r\n  \r\n            <!-- 评论列表 -->\r\n            <ul v-if=\"moment.comments?.length\" class=\"comments-list\">\r\n              <li\r\n                v-for=\"(comment, index) in visibleComments(moment)\"\r\n                :key=\"index\"\r\n                class=\"comment-item py-3\"\r\n              >\r\n                <div class=\"comment-header flex items-center space-x-2\">\r\n                  <img\r\n                    :src=\"getFullUrl(comment.comment_user_photo) || defaultAvatar\"\r\n                    class=\"comment-avatar\"\r\n                    @click=\"goToUserProfile(comment.comment_user_id)\"\r\n                  />\r\n                  <div class=\"comment-user-details\">\r\n                    <span class=\"comment-username\" @click=\"goToUserProfile(comment.comment_user_id)\">{{ comment.comment_user_name }}</span>\r\n                    <span class=\"comment-post-time\">{{ formatTime(comment.created_at) }}</span>\r\n                  </div>\r\n                </div>\r\n                \r\n                <div class=\"comment-content mt-1 ml-8 text-gray-600 text-sm\">\r\n                  {{ comment.comment }}\r\n                </div>\r\n  \r\n                <!-- 回复操作 -->\r\n                <div class=\"comment-actions flex justify-end space-x-3 mt-1 text-xs\">\r\n                  <div class=\"comment-like flex items-center space-x-1\" @click.stop=\"handleLikeComment(comment.id)\">\r\n                    <i class=\"fa-solid fa-thumbs-up\" :class=\"{ 'liked': comment.isLiked }\"></i>\r\n                    <span>{{ comment.likes }}</span>\r\n                  </div>\r\n                  <div class=\"comment-reply flex items-center space-x-1\" @click.stop=\"toggleReplyInput(comment)\">\r\n                    <i class=\"fa-solid fa-comment\"></i>\r\n                    <span>{{ comment.replies?.length || 0 }}</span>\r\n                  </div>\r\n                </div>\r\n  \r\n                <!-- 回复输入框 -->\r\n                <CommentInput\r\n                  v-if=\"comment.showReplyInput\"\r\n                  v-model=\"comment.replyInput\"\r\n                  placeholder=\"回复评论...\"\r\n                  button-text=\"发送\"\r\n                  @submit=\"(content) => handleReplySubmit(comment, content)\"\r\n                  class=\"mt-2 ml-8 text-sm\"\r\n                />\r\n  \r\n                <!-- 回复列表 -->\r\n                <div v-if=\"comment.replies?.length\" class=\"replies-list ml-8 mt-2\">\r\n                  <div \r\n                    v-for=\"(reply, replyIndex) in comment.replies\"\r\n                    :key=\"replyIndex\"\r\n                    class=\"reply-item py-2 border-t border-gray-100\"\r\n                  >\r\n                    <div class=\"flex items-center space-x-2\">\r\n                      <img\r\n                        :src=\"getFullUrl(reply.comment_user_photo) || defaultAvatar\"\r\n                        class=\"w-5 h-5 rounded-full\"\r\n                      />\r\n                      <span class=\"text-sm font-medium\">{{ reply.comment_user_name }}</span>\r\n                      <span class=\"text-xs text-gray-500\">{{ formatTime(reply.created_at) }}</span>\r\n                    </div>\r\n                    <div class=\"reply-content ml-7 text-gray-600 text-sm\">\r\n                      {{ reply.comment }}\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </li>\r\n  \r\n              <!-- 展开更多 -->\r\n              <li \r\n                v-if=\"moment.comments.length > 3 && !moment.showAllComments\"\r\n                class=\"show-more-comments text-blue-500 text-sm cursor-pointer pt-2\"\r\n                @click=\"moment.showAllComments = true\"\r\n              >\r\n                展开全部{{ moment.comments.length }}条评论\r\n              </li>\r\n            </ul>\r\n          </div>\r\n        </div>\r\n        \r\n        <div v-if=\"noMore\" class=\"no-more-message\">\r\n          没有更多动态了\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import { ref, onMounted, onUnmounted, computed, watchEffect } from 'vue'\r\nimport { useRouter } from 'vue-router'\r\nimport { useStore } from 'vuex'\r\nimport axios from 'axios'\r\nimport DOMPurify from 'dompurify'\r\nimport defaultAvatar from '@/assets/default-avatar.png'\r\nimport { API_CONFIG } from '@/config/config'\r\nimport { ElMessage } from 'element-plus'\r\nimport useLike from '@/utils/UserLike'\r\nimport useComment from '@/utils/UserComment'\r\n\r\n\r\nexport default {\r\n\r\n  setup() {\r\n    const router = useRouter()\r\n    const store = useStore()\r\n    const moments = ref([])\r\n    const loading = ref(false)\r\n    const noMore = ref(false)\r\n    const lastId = ref(null)\r\n    const pageSize = 10\r\n    const error = ref(null)\r\n\r\n    // 用户方法\r\n    const currentUser = computed(() => store.state.user || {})\r\n    const goToUser = () => router.push('/user')\r\n    const goToUserProfile = (userId) => router.push(`/user/${userId}`)\r\n    const goToPublish = () => router.push('/publish')\r\n    const { toggleLike } = useLike()\r\n    const { postComment: apiPostComment, postReply: apiPostReply } = useComment()  \r\n\r\n    const goToMomentDetail = (momentId) => {\r\n      router.push(`/moment/${momentId}`)\r\n    }\r\n    \r\n    // 工具方法\r\n    const getFullUrl = (path) => {\r\n      if (!path || path === defaultAvatar) return path\r\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`\r\n    }\r\n\r\n    const formatTime = (timestamp) => {\r\n      try {\r\n        const date = new Date(timestamp)\r\n        return `${date.getFullYear()}-${(date.getMonth() + 1).toString().padStart(2, '0')}-` +\r\n               `${date.getDate().toString().padStart(2, '0')} ` +\r\n               `${date.getHours().toString().padStart(2, '0')}:` +\r\n               `${date.getMinutes().toString().padStart(2, '0')}`\r\n      } catch (e) {\r\n        console.error('时间格式化错误:', e)\r\n        return '未知时间'\r\n      }\r\n    }\r\n\r\n    const getTimeAgo = (timestamp) => {\r\n      try {\r\n        const now = Date.now()\r\n        const diff = now - new Date(timestamp).getTime()\r\n        const minutes = Math.floor(diff / 60000)\r\n        const hours = Math.floor(minutes / 60)\r\n        const days = Math.floor(hours / 24)\r\n\r\n        if (minutes < 1) return '刚刚'\r\n        if (minutes < 60) return `${minutes}分钟前`\r\n        if (hours < 24) return `${hours}小时前`\r\n        return `${days}天前`\r\n      } catch (e) {\r\n        console.error('时间计算错误:', e)\r\n        return '未知时间'\r\n      }\r\n    }\r\n\r\n    const sanitizeHtml = (html) => {\r\n      try {\r\n        return DOMPurify.sanitize(html)\r\n      } catch (e) {\r\n        console.error('HTML净化错误:', e)\r\n        return ''\r\n      }\r\n    }\r\n\r\n    // 动态加载\r\n    const fetchMoments = async () => {\r\n      if (loading.value || noMore.value) return\r\n      loading.value = true\r\n      error.value = null\r\n\r\n      try {\r\n        const params = { limit: pageSize, last_id: lastId.value }\r\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/article/moments`, {\r\n          headers: { Authorization: `Bearer ${store.state.token}` },\r\n          params\r\n        })\r\n\r\n        if (!Array.isArray(response.data)) {\r\n          throw new Error('返回数据格式不正确')\r\n        }\r\n\r\n        const newMoments = response.data.map(moment => ({\r\n          ...moment,\r\n          showCommentInput: false,\r\n          commentInput: '',\r\n          comments: (moment.comments || []).map(comment => ({\r\n            ...comment,\r\n            showReplyInput: false,\r\n            replyInput: '',\r\n            replies: comment.replies || []\r\n          })),\r\n          showAllComments: false,\r\n          isLiked: moment.like_users?.includes(currentUser.value.id) || false\r\n        }))\r\n\r\n        moments.value = [...moments.value, ...newMoments]\r\n        lastId.value = newMoments[newMoments.length - 1]?.id\r\n        noMore.value = newMoments.length < pageSize\r\n      } catch (error) {\r\n        console.error('获取动态失败:', error)\r\n        error.value = error.message\r\n        ElMessage.error('加载动态失败')\r\n      } finally {\r\n        loading.value = false\r\n      }\r\n    }\r\n\r\n    // 互动功能\r\n    const toggleCommentInput = (moment) => {\r\n      moment.showCommentInput = !moment.showCommentInput\r\n      moment.commentInput = ''\r\n    }\r\n\r\n    const toggleReplyInput = (comment) => {\r\n      comment.showReplyInput = !comment.showReplyInput\r\n      comment.replyInput = ''\r\n    }\r\n\r\n    const handleLikeMoment = async (momentId) => {\r\n      const targetMoment = moments.value.find(m => m.id === momentId)\r\n      if (!targetMoment) return\r\n\r\n      try {\r\n        const result = await toggleLike('moment', momentId)\r\n        if (result) {\r\n          targetMoment.isLiked = result.isLiked\r\n          targetMoment.stats.likes = result.likes\r\n        }\r\n      } catch (error) {\r\n        console.error('点赞失败:', error)\r\n        ElMessage.error('点赞操作失败')\r\n      }\r\n    }\r\n\r\n    const handleLikeComment = async (commentId) => {\r\n      try {\r\n        const result = await toggleLike('comment', commentId)\r\n        if (result) {\r\n          const targetComment = findCommentById(commentId)\r\n          if (targetComment) {\r\n            targetComment.isLiked = result.isLiked\r\n            targetComment.likes = result.likes\r\n          }\r\n        }\r\n      } catch (error) {\r\n        console.error('评论点赞失败:', error)\r\n        ElMessage.error('点赞操作失败')\r\n      }\r\n    }\r\n\r\n    const handleCommentSubmit = async (moment, content) => {\r\n      try {\r\n        const newComment = await apiPostComment(moment.id, content, currentUser.value)\r\n        if (newComment) {\r\n          moment.comments.unshift(newComment)\r\n          moment.stats.comments += 1\r\n          moment.showCommentInput = false\r\n        }\r\n      } catch (error) {\r\n        console.error('评论提交失败:', error)\r\n        ElMessage.error('评论发布失败')\r\n      }\r\n    }\r\n\r\n    const handleReplySubmit = async (comment, content) => {\r\n      try {\r\n        const newReply = await apiPostReply(comment.id, content, currentUser.value)\r\n        if (newReply) {\r\n          comment.replies.push(newReply)\r\n          comment.showReplyInput = false\r\n        }\r\n      } catch (error) {\r\n        console.error('回复提交失败:', error)\r\n        ElMessage.error('回复失败')\r\n      }\r\n    }\r\n\r\n    // 辅助函数\r\n    const findCommentById = (commentId) => {\r\n      for (const moment of moments.value) {\r\n        const comment = moment.comments.find(c => c.id === commentId)\r\n        if (comment) return comment\r\n        for (const c of moment.comments) {\r\n          const reply = c.replies.find(r => r.id === commentId)\r\n          if (reply) return reply\r\n        }\r\n      }\r\n      return null\r\n    }\r\n\r\n    const deleteMoment = async (momentId) => {\r\n      try {\r\n        await axios.post(\r\n          `${API_CONFIG.BASE_URL}/article/delete/moment`,\r\n          { moment_id: momentId },\r\n          { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n        )\r\n        moments.value = moments.value.filter(m => m.id !== momentId)\r\n        ElMessage.success('删除成功')\r\n      } catch (error) {\r\n        console.error('删除失败:', error)\r\n        ElMessage.error('删除失败')\r\n      }\r\n    }\r\n\r\n    // 辅助函数\r\n    const visibleComments = (moment) => {\r\n      return moment.showAllComments ? \r\n        moment.comments : \r\n        moment.comments.slice(0, 3)\r\n    }\r\n\r\n    // 生命周期\r\n    onMounted(() => {\r\n      fetchMoments()\r\n      window.addEventListener('scroll', handleScroll)\r\n    })\r\n\r\n    onUnmounted(() => {\r\n      window.removeEventListener('scroll', handleScroll)\r\n    })\r\n\r\n    const handleScroll = () => {\r\n      const { scrollTop, scrollHeight, clientHeight } = document.documentElement\r\n      if (scrollTop + clientHeight >= scrollHeight - 100 && !loading.value) {\r\n        fetchMoments()\r\n      }\r\n    }\r\n\r\n    // 添加响应式错误处理\r\n    watchEffect(() => {\r\n      if (error.value) {\r\n        console.error('组件错误:', error.value)\r\n        // 可以在这里添加全局错误提示\r\n      }\r\n    })\r\n\r\n    return {\r\n      moments,\r\n      currentUser,\r\n      noMore,\r\n      loading,\r\n      error,\r\n      visibleComments,\r\n      getFullUrl,\r\n      formatTime,\r\n      getTimeAgo,\r\n      sanitizeHtml,\r\n      goToUser,\r\n      goToUserProfile,\r\n      goToPublish,\r\n      toggleCommentInput,\r\n      toggleReplyInput,\r\n      goToMomentDetail,\r\n      handleLikeMoment,\r\n      handleLikeComment,\r\n      handleCommentSubmit,\r\n      handleReplySubmit,\r\n      deleteMoment,\r\n      defaultAvatar\r\n    }\r\n  }\r\n}\r\n  </script>\r\n  \r\n  <style scoped>\r\n  /* 新增侧边栏样式 */\r\n  .user-sidebar {\r\n    position: fixed;\r\n    left: 0;\r\n    top: 0;\r\n    bottom: 0;\r\n    width: 240px;\r\n    background: #fff;\r\n    box-shadow: 2px 0 8px rgba(0, 0, 0, 0.05);\r\n    z-index: 99;\r\n    padding: 20px;\r\n  }\r\n 