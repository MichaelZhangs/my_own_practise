{"ast":null,"code":"import axios from \"axios\";\nexport default {\n  name: \"UserLogin\",\n  data() {\n    return {\n      loginType: \"phone\",\n      // 登录方式：phone 或 email\n      phone: \"\",\n      // 手机号\n      email: \"\",\n      // 邮箱\n      code: \"\",\n      // 验证码\n      loginResult: null // 登录结果\n    };\n  },\n  methods: {\n    // 发送验证码\n    async sendCode() {\n      if (this.loginType === \"phone\" && !this.phone) {\n        alert(\"请输入手机号\");\n        return;\n      }\n      if (this.loginType === \"email\" && !this.email) {\n        alert(\"请输入邮箱\");\n        return;\n      }\n      try {\n        // 调用后端接口发送验证码\n        const response = await axios.post(\"http://127.0.0.1:8000/api/send-code\", {\n          username: this.loginType === \"phone\" ? this.phone : this.email\n        });\n        alert(`验证码已发送：${response.data.code}`);\n      } catch (error) {\n        alert(\"验证码发送失败\");\n        console.error(\"Error:\", error);\n      }\n    },\n    // 处理登录\n    async handleLogin() {\n      if (!this.code) {\n        alert(\"请输入验证码\");\n        return;\n      }\n      try {\n        // 调用后端登录接口\n        const response = await axios.post(\"http://127.0.0.1:8000/api/login\", {\n          username: this.loginType === \"phone\" ? this.phone : this.email,\n          password: this.code // 这里将验证码作为密码\n        });\n\n        // 登录成功\n        this.loginResult = {\n          success: true,\n          message: \"登录成功！\",\n          data: response.data\n        };\n        console.log(\"登录成功：\", response.data);\n      } catch (error) {\n        // 登录失败\n        this.loginResult = {\n          success: false,\n          message: error.response?.data?.detail || \"登录失败\"\n        };\n        console.error(\"登录失败：\", error.response?.data);\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","loginType","phone","email","code","loginResult","methods","sendCode","alert","response","post","username","error","console","handleLogin","password","success","message","log","detail"],"sources":["E:\\vue_learn\\ai_vue\\ai_vue\\src\\components\\UserLogin.vue"],"sourcesContent":["<template>\r\n  <div class=\"login-wrapper\">\r\n    <div class=\"user-login-container\">\r\n      <h1>用户登录</h1>\r\n      <form @submit.prevent=\"handleLogin\">\r\n        <!-- 登录方式选择 -->\r\n        <div class=\"login-type\">\r\n          <label>\r\n            <input\r\n              type=\"radio\"\r\n              v-model=\"loginType\"\r\n              value=\"phone\"\r\n              checked\r\n            /> 短信登录\r\n          </label>\r\n          <label>\r\n            <input\r\n              type=\"radio\"\r\n              v-model=\"loginType\"\r\n              value=\"email\"\r\n            /> 邮箱登录\r\n          </label>\r\n        </div>\r\n\r\n        <!-- 手机号登录 -->\r\n        <div v-if=\"loginType === 'phone'\" class=\"input-group\">\r\n          <input\r\n            type=\"text\"\r\n            v-model=\"phone\"\r\n            placeholder=\"请输入手机号\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <!-- 邮箱登录 -->\r\n        <div v-else class=\"input-group\">\r\n          <input\r\n            type=\"email\"\r\n            v-model=\"email\"\r\n            placeholder=\"请输入邮箱\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <!-- 验证码输入 -->\r\n        <div class=\"input-group code-group\">\r\n          <input\r\n            type=\"text\"\r\n            v-model=\"code\"\r\n            placeholder=\"请输入验证码\"\r\n            required\r\n          />\r\n          <button type=\"button\" @click=\"sendCode\" class=\"code-button\">\r\n            获取验证码\r\n          </button>\r\n        </div>\r\n\r\n        <!-- 登录按钮 -->\r\n        <button type=\"submit\" class=\"login-button\">登录</button>\r\n      </form>\r\n\r\n      <!-- 显示登录结果 -->\r\n      <div v-if=\"loginResult\" class=\"login-result\">\r\n        <p v-if=\"loginResult.success\">登录成功！</p>\r\n        <p v-else>登录失败：{{ loginResult.message }}</p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from \"axios\";\r\n\r\nexport default {\r\n  name: \"UserLogin\",\r\n  data() {\r\n    return {\r\n      loginType: \"phone\", // 登录方式：phone 或 email\r\n      phone: \"\", // 手机号\r\n      email: \"\", // 邮箱\r\n      code: \"\", // 验证码\r\n      loginResult: null, // 登录结果\r\n    };\r\n  },\r\n  methods: {\r\n    // 发送验证码\r\n    async sendCode() {\r\n      if (this.loginType === \"phone\" && !this.phone) {\r\n        alert(\"请输入手机号\");\r\n        return;\r\n      }\r\n      if (this.loginType === \"email\" && !this.email) {\r\n        alert(\"请输入邮箱\");\r\n        return;\r\n      }\r\n\r\n      try {\r\n        // 调用后端接口发送验证码\r\n        const response = await axios.post(\"http://127.0.0.1:8000/api/send-code\", {\r\n          username: this.loginType === \"phone\" ? this.phone : this.email,\r\n        });\r\n        alert(`验证码已发送：${response.data.code}`);\r\n      } catch (error) {\r\n        alert(\"验证码发送失败\");\r\n        console.error(\"Error:\", error);\r\n      }\r\n    },\r\n\r\n    // 处理登录\r\n    async handleLogin() {\r\n      if (!this.code) {\r\n        alert(\"请输入验证码\");\r\n        return;\r\n      }\r\n\r\n      try {\r\n        // 调用后端登录接口\r\n        const response = await axios.post(\"http://127.0.0.1:8000/api/login\", {\r\n          username: this.loginType === \"phone\" ? this.phone : this.email,\r\n          password: this.code, // 这里将验证码作为密码\r\n        });\r\n\r\n        // 登录成功\r\n        this.loginResult = {\r\n          success: true,\r\n          message: \"登录成功！\",\r\n          data: response.data,\r\n        };\r\n        console.log(\"登录成功：\", response.data);\r\n      } catch (error) {\r\n        // 登录失败\r\n        this.loginResult = {\r\n          success: false,\r\n          message: error.response?.data?.detail || \"登录失败\",\r\n        };\r\n        console.error(\"登录失败：\", error.response?.data);\r\n      }\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.login-wrapper {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  height: 100vh;\r\n  background-image: url(\"@/assets/background.jpg\"); /* 壁纸路径 */\r\n  background-size: cover;\r\n  background-position: center;\r\n}\r\n\r\n.user-login-container {\r\n  max-width: 400px;\r\n  width: 100%;\r\n  padding: 30px;\r\n  border-radius: 10px;\r\n  background-color: rgba(255, 255, 255, 0.9); /* 半透明背景 */\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);\r\n}\r\n\r\nh1 {\r\n  text-align: center;\r\n  color: #333;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.login-type {\r\n  display: flex;\r\n  justify-content: center;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.login-type label {\r\n  margin: 0 10px;\r\n  font-size: 16px;\r\n}\r\n\r\n.input-group {\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.input-group input {\r\n  width: 100%;\r\n  padding: 10px;\r\n  border: 1px solid #ccc;\r\n  border-radius: 5px;\r\n  font-size: 16px;\r\n}\r\n\r\n.code-group {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.code-group input {\r\n  flex: 1;\r\n  margin-right: 10px;\r\n}\r\n\r\n.code-button {\r\n  padding: 10px 15px;\r\n  background-color: #42b983;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n  font-size: 14px;\r\n}\r\n\r\n.code-button:hover {\r\n  background-color: #369f6e;\r\n}\r\n\r\n.login-button {\r\n  width: 100%;\r\n  padding: 10px;\r\n  background-color: #42b983;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n  font-size: 16px;\r\n}\r\n\r\n.login-button:hover {\r\n  background-color: #369f6e;\r\n}\r\n\r\n.login-result {\r\n  margin-top: 20px;\r\n  text-align: center;\r\n  font-size: 16px;\r\n  color: #333;\r\n}\r\n</style>"],"mappings":"AAuEA,OAAOA,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,SAAS,EAAE,OAAO;MAAE;MACpBC,KAAK,EAAE,EAAE;MAAE;MACXC,KAAK,EAAE,EAAE;MAAE;MACXC,IAAI,EAAE,EAAE;MAAE;MACVC,WAAW,EAAE,IAAI,CAAE;IACrB,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACP;IACA,MAAMC,QAAQA,CAAA,EAAG;MACf,IAAI,IAAI,CAACN,SAAQ,KAAM,OAAM,IAAK,CAAC,IAAI,CAACC,KAAK,EAAE;QAC7CM,KAAK,CAAC,QAAQ,CAAC;QACf;MACF;MACA,IAAI,IAAI,CAACP,SAAQ,KAAM,OAAM,IAAK,CAAC,IAAI,CAACE,KAAK,EAAE;QAC7CK,KAAK,CAAC,OAAO,CAAC;QACd;MACF;MAEA,IAAI;QACF;QACA,MAAMC,QAAO,GAAI,MAAMX,KAAK,CAACY,IAAI,CAAC,qCAAqC,EAAE;UACvEC,QAAQ,EAAE,IAAI,CAACV,SAAQ,KAAM,OAAM,GAAI,IAAI,CAACC,KAAI,GAAI,IAAI,CAACC;QAC3D,CAAC,CAAC;QACFK,KAAK,CAAC,UAAUC,QAAQ,CAACT,IAAI,CAACI,IAAI,EAAE,CAAC;MACvC,EAAE,OAAOQ,KAAK,EAAE;QACdJ,KAAK,CAAC,SAAS,CAAC;QAChBK,OAAO,CAACD,KAAK,CAAC,QAAQ,EAAEA,KAAK,CAAC;MAChC;IACF,CAAC;IAED;IACA,MAAME,WAAWA,CAAA,EAAG;MAClB,IAAI,CAAC,IAAI,CAACV,IAAI,EAAE;QACdI,KAAK,CAAC,QAAQ,CAAC;QACf;MACF;MAEA,IAAI;QACF;QACA,MAAMC,QAAO,GAAI,MAAMX,KAAK,CAACY,IAAI,CAAC,iCAAiC,EAAE;UACnEC,QAAQ,EAAE,IAAI,CAACV,SAAQ,KAAM,OAAM,GAAI,IAAI,CAACC,KAAI,GAAI,IAAI,CAACC,KAAK;UAC9DY,QAAQ,EAAE,IAAI,CAACX,IAAI,CAAE;QACvB,CAAC,CAAC;;QAEF;QACA,IAAI,CAACC,WAAU,GAAI;UACjBW,OAAO,EAAE,IAAI;UACbC,OAAO,EAAE,OAAO;UAChBjB,IAAI,EAAES,QAAQ,CAACT;QACjB,CAAC;QACDa,OAAO,CAACK,GAAG,CAAC,OAAO,EAAET,QAAQ,CAACT,IAAI,CAAC;MACrC,EAAE,OAAOY,KAAK,EAAE;QACd;QACA,IAAI,CAACP,WAAU,GAAI;UACjBW,OAAO,EAAE,KAAK;UACdC,OAAO,EAAEL,KAAK,CAACH,QAAQ,EAAET,IAAI,EAAEmB,MAAK,IAAK;QAC3C,CAAC;QACDN,OAAO,CAACD,KAAK,CAAC,OAAO,EAAEA,KAAK,CAACH,QAAQ,EAAET,IAAI,CAAC;MAC9C;IACF;EACF;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}