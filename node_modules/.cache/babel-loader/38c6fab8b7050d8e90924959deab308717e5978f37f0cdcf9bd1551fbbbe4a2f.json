 null, 512 /* NEED_PATCH */), [[_vModelText, $data.username]])]), _createElementVNode(\"div\", _hoisted_9, [_withDirectives(_createElementVNode(\"input\", {\n    type: \"password\",\n    \"onUpdate:modelValue\": _cache[6] || (_cache[6] = $event => $data.password = $event),\n    placeholder: \"请输入密码\",\n    required: \"\"\n  }, null, 512 /* NEED_PATCH */), [[_vModelText, $data.password]])])])) : _createCommentVNode(\"v-if\", true), _createCommentVNode(\" 密码登录链接 \"), _createElementVNode(\"div\", _hoisted_10, [_createElementVNode(\"a\", {\n    onClick: _cache[7] || (_cache[7] = (...args) => $options.togglePasswordLogin && $options.togglePasswordLogin(...args))\n  }, _toDisplayString($data.isPasswordLogin ? \"验证码登录\" : \"密码登录\"), 1 /* TEXT */)]), _createCommentVNode(\" 登录按钮 \"), _createElementVNode(\"button\", _hoisted_11, _toDisplayString($data.isPasswordLogin ? \"密码登录\" : \"登录\"), 1 /* TEXT */)], 32 /* NEED_HYDRATION */), _createCommentVNode(\" 显示登录结果 \"), $data.loginResult ? (_openBlock(), _createElementBlock(\"div\", _hoisted_12, [$data.loginResult.success ? (_openBlock(), _createElementBlock(\"p\", _hoisted_13, \"登录成功！\")) : (_openBlock(), _createElementBlock(\"p\", _hoisted_14, \"登录失败：\" + _toDisplayString($data.loginResult.message), 1 /* TEXT */))])) : _createCommentVNode(\"v-if\", true)]), _createCommentVNode(\" 验证码弹窗 \"), $data.showCodeModal ? (_openBlock(), _createElementBlock(\"div\", _hoisted_15, [_createElementVNode(\"div\", _hoisted_16, [_cache[14] || (_cache[14] = _createElementVNode(\"h3\", null, \"验证码已发送\", -1 /* HOISTED */)), _createElementVNode(\"p\", null, [_cache[13] || (_cache[13] = _createTextVNode(\"您的验证码是：\")), _createElementVNode(\"strong\", null, _toDisplayString($data.generatedCode), 1 /* TEXT */)]), _createElementVNode(\"button\", {\n    onClick: _cache[9] || (_cache[9] = (...args) => $options.fillCodeAndCloseModal && $options.fillCodeAndCloseModal(...args))\n  }, \"填充验证码并关闭\")])])) : _createCommentVNode(\"v-if\", true)]);\n}","map":{"version":3,"names":["class","key","type","_createElementBlock","_hoisted_1","_createElementVNode","_hoisted_2","onSubmit","_cache","_withModifiers","args","$options","handleLogin","_createCommentVNode","_hoisted_3","$event","$data","loginType","value","checked","_createTextVNode","_hoisted_4","email","placeholder","required","isPasswordLogin","_hoisted_5","code","onClick","sendCode","disabled","isCodeButtonDisabled","codeButtonText","_hoisted_6","_hoisted_7","_hoisted_8","username","_hoisted_9","password","_hoisted_10","togglePasswordLogin","_hoisted_11","_toDisplayString","loginResult","_hoisted_12","success","_hoisted_13","_hoisted_14","message","showCodeModal","_hoisted_15","_hoisted_16","generatedCode","fillCodeAndCloseModal"],"sources":["E:\\vue_learn\\ai_vue\\ai_vue\\src\\components\\UserLogin.vue"],"sourcesContent":["<template>\r\n  <div class=\"login-wrapper\">\r\n    <div class=\"user-login-container\">\r\n      <h1>用户登录</h1>\r\n      <form @submit.prevent=\"handleLogin\">\r\n        <!-- 登录方式选择 -->\r\n        <div class=\"login-type\">\r\n          <label>\r\n            <input\r\n              type=\"radio\"\r\n              v-model=\"loginType\"\r\n              value=\"phone\"\r\n              checked\r\n            /> 短信登录\r\n          </label>\r\n          <label>\r\n            <input\r\n              type=\"radio\"\r\n              v-model=\"loginType\"\r\n              value=\"email\"\r\n            /> 邮箱登录\r\n          </label>\r\n        </div>\r\n\r\n        <!-- 手机号登录 -->\r\n        <!-- <div v-if=\"loginType === 'phone'\" class=\"input-group\">\r\n          <input\r\n            type=\"text\"\r\n            v-model=\"phone\"\r\n            placeholder=\"请输入手机号\"\r\n            required\r\n          />\r\n        </div> -->\r\n\r\n        <!-- 邮箱登录 -->\r\n        <div v-else class=\"input-group\">\r\n          <input\r\n            type=\"email\"\r\n            v-model=\"email\"\r\n            placeholder=\"请输入邮箱\"\r\n            required\r\n          />\r\n        </div>\r\n\r\n        <!-- 验证码输入 -->\r\n        <div v-if=\"!isPasswordLogin\" class=\"input-group code-group\">\r\n          <input\r\n            type=\"text\"\r\n            v-model=\"code\"\r\n            placeholder=\"请输入验证码\"\r\n            required\r\n          />\r\n          <button\r\n            type=\"button\"\r\n            @click=\"sendCode\"\r\n            class=\"code-button\"\r\n            :disabled=\"isCodeButtonDisabled\"\r\n          >\r\n            {{ codeButtonText }}\r\n          </button>\r\n        </div>\r\n\r\n        <!-- 密码登录表单 -->\r\n        <div v-if=\"isPasswordLogin\" class=\"password-login-form\">\r\n          <div class=\"input-group\">\r\n            <input\r\n              type=\"text\"\r\n              v-model=\"username\"\r\n              placeholder=\"请输入用户名/手机号/邮箱\"\r\n              required\r\n            />\r\n          </div>\r\n          <div class=\"input-group\">\r\n            <input\r\n              type=\"password\"\r\n              v-model=\"password\"\r\n              placeholder=\"请输入密码\"\r\n              required\r\n            />\r\n          </div>\r\n        </div>\r\n\r\n        <!-- 密码登录链接 -->\r\n        <div class=\"password-login-link\">\r\n          <a @click=\"togglePasswordLogin\">\r\n            {{ isPasswordLogin ? \"验证码登录\" : \"密码登录\" }}\r\n          </a>\r\n        </div>\r\n\r\n        <!-- 登录按钮 -->\r\n        <button type=\"submit\" class=\"login-button\">\r\n          {{ isPasswordLogin ? \"密码登录\" : \"登录\" }}\r\n        </button>\r\n      </form>\r\n\r\n      <!-- 显示登录结果 -->\r\n      <div v-if=\"loginResult\" class=\"login-result\">\r\n        <p v-if=\"loginResult.success\">登录成功！</p>\r\n        <p v-else>登录失败：{{ loginResult.message }}</p>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 验证码弹窗 -->\r\n    <div v-if=\"showCodeModal\" class=\"modal-overlay\">\r\n      <div class=\"modal-content\">\r\n        <h3>验证码已发送</h3>\r\n        <p>您的验证码是：<strong>{{ generatedCode }}</strong></p>\r\n        <button @click=\"fillCodeAndCloseModal\">填充验证码并关闭</button>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport axios from \"axios\";\r\n\r\nexport default {\r\n  name: \"UserLogin\",\r\n  data() {\r\n    return {\r\n      loginType: \"phone\", // 登录方式：phone 或 email\r\n      phone: \"\", // 手机号\r\n      email: \"\", // 邮箱\r\n      code: \"\", // 验证码\r\n      username: \"\", // 用户名/手机号/邮箱（用于密码登录）\r\n      password: \"\", // 密码（用于密码登录）\r\n      loginResult: null, // 登录结果\r\n      generatedCode: \"\", // 从后端获取的验证码\r\n      showCodeModal: false, // 是否显示验证码弹窗\r\n      isCodeButtonDisabled: false, // 获取验证码按钮是否禁用\r\n      codeButtonText: \"获取验证码\", // 获取验证码按钮文本\r\n      countdown: 0, // 倒计时时间\r\n      isPasswordLogin: false, // 是否使用密码登录\r\n    };\r\n  },\r\n  methods: {\r\n    // 发送验证码\r\n    async sendCode() {\r\n      if (this.loginType === \"phone\" && !this.phone) {\r\n        alert(\"请输入手机号\");\r\n        return;\r\n      }\r\n      if (this.loginType === \"email\" && !this.email) {\r\n        alert(\"请输入邮箱\");\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const username = this.loginType === \"phone\" ? this.phone : this.email;\r\n\r\n        // 调用后端接口获取验证码\r\n        const response = await axios.post(\"http://127.0.0.1:8000/api/send-code\", {\r\n          username,\r\n        });\r\n\r\n        // 从后端获取验证码\r\n        this.generatedCode = response.data.code;\r\n\r\n        // 显示验证码弹窗\r\n        this.showCodeModal = true;\r\n\r\n        // 启动倒计时\r\n        this.startCountdown();\r\n      } catch (error) {\r\n        console.error(\"验证码请求失败：\", error.response?.data);\r\n        alert(\"验证码发送失败\");\r\n      }\r\n    },\r\n\r\n    // 启动倒计时\r\n    startCountdown() {\r\n      this.isCodeButtonDisabled = true; // 禁用按钮\r\n      this.countdown = 60; // 设置倒计时时间\r\n      const timer = setInterval(() => {\r\n        this.countdown--;\r\n        if (this.countdown <= 0) {\r\n          clearInterval(timer);\r\n          this.isCodeButtonDisabled = false; // 恢复按钮\r\n          this.codeButtonText = \"获取验证码\"; // 恢复按钮文本\r\n        } else {\r\n          this.codeButtonText = `${this.countdown}s后重新获取`; // 更新按钮文本\r\n        }\r\n      }, 1000);\r\n    },\r\n\r\n    // 填充验证码并关闭弹窗\r\n    fillCodeAndCloseModal() {\r\n      this.code = this.generatedCode; // 将验证码填充到输入框\r\n      this.showCodeModal = false; // 关闭弹窗\r\n    },\r\n\r\n    // 处理登录\r\n    async handleLogin() {\r\n      if (this.isPasswordLogin) {\r\n        // 密码登录逻辑\r\n        await this.handlePasswordLogin();\r\n      } else {\r\n        // 验证码登录逻辑\r\n        await this.handleCodeLogin();\r\n      }\r\n    },\r\n\r\n    // 处理验证码登录\r\n    async handleCodeLogin() {\r\n      if (!this.code) {\r\n        alert(\"请输入验证码\");\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const username = this.loginType === \"phone\" ? this.phone : this.email;\r\n        const password = this.code;\r\n\r\n        // 调用后端登录接口\r\n        const response = await axios.post(\r\n          \"http://127.0.0.1:8000/api/login\",\r\n          {\r\n            username,\r\n            password,\r\n          },\r\n          {\r\n            headers: {\r\n              \"Content-Type\": \"application/json\",\r\n            },\r\n          }\r\n        );\r\n\r\n        // 登录成功\r\n        this.loginResult = {\r\n          success: true,\r\n          message: \"登录成功！\",\r\n          data: response.data,\r\n        };\r\n\r\n        // 存储用户信息和 Token 到 Vuex\r\n        this.$store.dispatch(\"login\", {\r\n          user: response.data.user,\r\n          token: response.data.access_token,\r\n        });\r\n\r\n        // 跳转到用户页面\r\n        this.$router.push(\"/user\");\r\n      } catch (error) {\r\n        // 登录失败\r\n        this.loginResult = {\r\n          success: false,\r\n          message: error.response?.data?.detail || \"登录失败\",\r\n        };\r\n      }\r\n    },\r\n\r\n    // 处理密码登录\r\n    async handlePasswordLogin() {\r\n      if (!this.username || !this.password) {\r\n        alert(\"请输入用户名和密码\");\r\n        return;\r\n      }\r\n\r\n      try {\r\n        // 调用后端密码登录接口\r\n        const response = await axios.post(\r\n          \"http://127.0.0.1:8000/api/password-login\",\r\n          {\r\n            username: this.username,\r\n            password: this.password,\r\n          },\r\n          {\r\n            headers: {\r\n              \"Content-Type\": \"application/json\",\r\n            },\r\n          }\r\n        );\r\n\r\n        // 登录成功\r\n        this.loginResult = {\r\n          success: true,\r\n          message: \"登录成功！\",\r\n          data: response.data,\r\n        };\r\n\r\n        // 存储用户信息和 Token 到 Vuex\r\n        this.$store.dispatch(\"login\", {\r\n          user: response.data.user,\r\n          token: response.data.access_token,\r\n        });\r\n\r\n        // 跳转到用户页面\r\n        this.$router.push(\"/user\");\r\n      } catch (error) {\r\n        // 登录失败\r\n        this.loginResult = {\r\n          success: false,\r\n          message: error.response?.data?.detail || \"登录失败\",\r\n        };\r\n      }\r\n    },\r\n\r\n    // 切换密码登录\r\n    togglePasswordLogin() {\r\n      this.isPasswordLogin = !this.isPasswordLogin;\r\n    },\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* 样式保持不变 */\r\n.login-wrapper {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  height: 100vh;\r\n  background-color: #f5f5f5;\r\n}\r\n\r\n.user-login-container {\r\n  max-width: 400px;\r\n  width: 100%;\r\n  padding: 30px;\r\n  border-radius: 10px;\r\n  background-color: white;\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);\r\n}\r\n\r\nh1 {\r\n  text-align: center;\r\n  color: #333;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.login-type {\r\n  display: flex;\r\n  justify-content: center;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.login-type label {\r\n  margin: 0 10px;\r\n  font-size: 16px;\r\n}\r\n\r\n.input-group {\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.input-group input {\r\n  width: 100%;\r\n  padding: 10px;\r\n  border: 1px solid #ccc;\r\n  border-radius: 5px;\r\n  font-size: 16px;\r\n}\r\n\r\n.code-group {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.code-group input {\r\n  flex: 1;\r\n  margin-right: 10px;\r\n}\r\n\r\n.code-button {\r\n  padding: 10px 15px;\r\n  background-color: #42b983;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n  font-size: 14px;\r\n}\r\n\r\n.code-button:disabled {\r\n  background-color: #ccc;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.code-button:hover:not(:disabled) {\r\n  background-color: #369f6e;\r\n}\r\n\r\n.password-login-form {\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.password-login-link {\r\n  text-align: center;\r\n  margin: 10px 0;\r\n}\r\n\r\n.password-login-link a {\r\n  color: #42b983;\r\n  cursor: pointer;\r\n  font-size: 14px;\r\n}\r\n\r\n.password-login-link a:hover {\r\n  text-decoration: underline;\r\n}\r\n\r\n.login-button {\r\n  width: 100%;\r\n  padding: 10px;\r\n  background-color: #42b983;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n  font-size: 16px;\r\n}\r\n\r\n.login-button:hover {\r\n  background-color: #369f6e;\r\n}\r\n\r\n.login-result {\r\n  margin-top: 20px;\r\n  text-align: center;\r\n  font-size: 16px;\r\n  color: #333;\r\n}\r\n\r\n/* 弹窗样式 */\r\n.modal-overlay {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background-color: rgba(0, 0, 0, 0.5);\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n\r\n.modal-content {\r\n  background-color: white;\r\n  padding: 20px;\r\n  border-radius: 10px;\r\n  text-align: center;\r\n}\r\n\r\n.modal-content h3 {\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.modal-content button {\r\n  margin-top: 10px;\r\n  padding: 10px 20px;\r\n  background-color: #42b983;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n}\r\n\r\n.modal-content button:hover {\r\n  backgrou