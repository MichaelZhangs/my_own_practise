ateElementVNode(\"div\", {\n    class: \"member-name\"\n  }, \"添加成员\", -1 /* HOISTED */))])) : _createCommentVNode(\"v-if\", true)])]), _createElementVNode(\"div\", _hoisted_19, [_createElementVNode(\"div\", {\n    class: \"group-action-btn\",\n    onClick: _cache[3] || (_cache[3] = (...args) => $setup.toggleMute && $setup.toggleMute(...args))\n  }, [_createElementVNode(\"i\", {\n    class: _normalizeClass([\"fa-solid\", $setup.isMuted ? 'fa-bell' : 'fa-bell-slash'])\n  }, null, 2 /* CLASS */), _createTextVNode(\" \" + _toDisplayString($setup.isMuted ? '开启通知' : '消息免打扰'), 1 /* TEXT */)]), _createElementVNode(\"div\", {\n    class: \"group-action-btn danger-action\",\n    onClick: _cache[4] || (_cache[4] = (...args) => $setup.exitGroup && $setup.exitGroup(...args))\n  }, _cache[17] || (_cache[17] = [_createElementVNode(\"i\", {\n    class: \"fa-solid fa-right-from-bracket\"\n  }, null, -1 /* HOISTED */), _createTextVNode(\" 退出群聊 \")]))])])]), _createCommentVNode(\" 编辑群名称弹窗 \"), $setup.showEditName ? (_openBlock(), _createElementBlock(\"div\", _hoisted_20, [_createElementVNode(\"div\", _hoisted_21, [_cache[18] || (_cache[18] = _createElementVNode(\"div\", {\n    class: \"edit-name-title\"\n  }, \"修改群名称\", -1 /* HOISTED */)), _withDirectives(_createElementVNode(\"input\", {\n    type: \"text\",\n    class: \"edit-name-input\",\n    \"onUpdate:modelValue\": _cache[5] || (_cache[5] = $event => $setup.editGroupName = $event),\n    placeholder: \"请输入群名称\",\n    maxlength: \"20\"\n  }, null, 512 /* NEED_PATCH */), [[_vModelText, $setup.editGroupName]]), _createElementVNode(\"div\", _hoisted_22, [_createElementVNode(\"button\", {\n    class: \"edit-name-btn edit-name-cancel\",\n    onClick: _cache[6] || (_cache[6] = (...args) => $setup.cancelEditName && $setup.cancelEditName(...args))\n  }, \"取消\"), _createElementVNode(\"button\", {\n    class: \"edit-name-btn edit-name-confirm\",\n    onClick: _cache[7] || (_cache[7] = (...args) => $setup.confirmEditName && $setup.confirmEdi