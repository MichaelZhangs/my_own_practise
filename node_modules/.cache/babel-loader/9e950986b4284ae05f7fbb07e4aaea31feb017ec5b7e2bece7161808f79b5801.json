er.id)\n    }, null, 8 /* PROPS */, _hoisted_35)])], 8 /* PROPS */, _hoisted_28);\n  }), 128 /* KEYED_FRAGMENT */))]), _createElementVNode(\"div\", _hoisted_36, [_createElementVNode(\"button\", {\n    class: \"add-member-cancel\",\n    onClick: _cache[10] || (_cache[10] = (...args) => $setup.closeAddMemberDialog && $setup.closeAddMemberDialog(...args))\n  }, \"取消\"), _createElementVNode(\"button\", {\n    class: \"add-member-confirm\",\n    onClick: _cache[11] || (_cache[11] = (...args) => $setup.confirmAddMembers && $setup.confirmAddMembers(...args))\n  }, \"确认添加\")])])])) : _createCommentVNode(\"v-if\", true)])) : _createCommentVNode(\"v-if\", true);\n}","map":{"version":3,"names":["key","class","$props","visible","_createElementBlock","_hoisted_1","_createElementVNode","_hoisted_2","_hoisted_3","onClick","_cache","args","$setup","close","_hoisted_4","_hoisted_5","_Fragment","_renderList","groupAvatarUrls","avatarUrl","idx","style","_normalizeStyle","getAvatarPosition","src","alt","onerror","_hoisted_6","_hoisted_7","_createTextVNode","_toDisplayString","groupInfo","group_name","isGroupOwner","showEditNameDialog","_createCommentVNode","_hoisted_8","group_id","_hoisted_9","_hoisted_10","_hoisted_11","members_count","_hoisted_12","groupMembers","member","_hoisted_13","getMemberAvatar","_hoisted_14","id","currentUserId","$event","removeMember","_hoisted_15","_hoisted_16","username","_hoisted_17","getMemberRole","_hoisted_18","showAddMemberDialog","_hoisted_19","toggleMute","_normalizeClass","isMuted","exitGroup","showEditName","_hoisted_20","_hoisted_21","type","editGroupName","placeholder","maxlength","_hoisted_22","cancelEditName","confirmEditName","showAddMember","_hoisted_23","_hoisted_24","_hoisted_25","closeAddMemberDialog","_hoisted_26","searchKeyword","_hoisted_27","filteredUsers","user","selectUser","_hoisted_29","getFullUrl","photo","_hoisted_30","_hoisted_31","_hoisted_32","_hoisted_33","_hoisted_34","checked","isUserSelected","_hoisted_35","_hoisted_28","_hoisted_36","confirmAddMembers"],"sources":["E:\\home\\vue_pro\\src\\components\\GroupInfo.vue"],"sourcesContent":["<!-- src/components/GroupInfo.vue -->\r\n<template>\r\n  <div class=\"group-info-dialog\" v-if=\"visible\">\r\n    <div class=\"group-info-content\">\r\n      <div class=\"group-info-header\">\r\n        <div class=\"group-info-close\" @click=\"close\">\r\n          <i class=\"fa-solid fa-xmark\"></i>\r\n        </div>\r\n        <div class=\"group-info-avatar\">\r\n          <div class=\"group-avatar\">\r\n            <div \r\n              v-for=\"(avatarUrl, idx) in groupAvatarUrls\" \r\n              :key=\"idx\"\r\n              class=\"group-avatar-member\"\r\n              :style=\"getAvatarPosition(idx)\"\r\n            >\r\n              <img \r\n                :src=\"avatarUrl\" \r\n                alt=\"成员头像\"\r\n                onerror=\"this.src='@/assets/default-avatar.png'\"\r\n              />\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div class=\"group-info-name\">\r\n          {{ groupInfo.group_name || '未命名群聊' }}\r\n          <span class=\"group-info-edit\" @click=\"showEditNameDialog\" v-if=\"isGroupOwner\">\r\n            <i class=\"fa-solid fa-pen\"></i>\r\n          </span>\r\n        </div>\r\n        <div class=\"group-info-id\">群ID: {{ groupInfo.group_id }}</div>\r\n      </div>\r\n      \r\n      <div class=\"group-info-body\">\r\n        <div class=\"group-info-section\">\r\n          <div class=\"group-info-section-title\">群成员 ({{ groupInfo.members_count || 0 }})</div>\r\n          <div class=\"members-list\">\r\n            <div class=\"member-item\" v-for=\"member in groupMembers\" :key=\"member\">\r\n              <div class=\"member-avatar\">\r\n                <img :src=\"getMemberAvatar(member)\" alt=\"成员头像\" onerror=\"this.src='@/assets/default-avatar.png'\">\r\n                <div class=\"member-actions\" v-if=\"isGroupOwner && member.id !== currentUserId\" @click=\"removeMember(member)\">\r\n                  <i class=\"fa-solid fa-minus\"></i>\r\n                </div>\r\n              </div>\r\n              <div class=\"member-name\">{{ member.username }}</div>\r\n              <div class=\"member-role\">{{ getMemberRole(member) }}</div>\r\n            </div>\r\n            \r\n            <div class=\"member-item\" v-if=\"isGroupOwner\">\r\n              <div class=\"add-member-btn\" @click=\"showAddMemberDialog\">\r\n                <i class=\"fa-solid fa-plus\"></i>\r\n              </div>\r\n              <div class=\"member-name\">添加成员</div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        \r\n        <div class=\"group-info-actions\">\r\n          <div class=\"group-action-btn\" @click=\"toggleMute\">\r\n            <i class=\"fa-solid\" :class=\"isMuted ? 'fa-bell' : 'fa-bell-slash'\"></i> \r\n            {{ isMuted ? '开启通知' : '消息免打扰' }}\r\n          </div>\r\n          <div class=\"group-action-btn danger-action\" @click=\"exitGroup\">\r\n            <i class=\"fa-solid fa-right-from-bracket\"></i> 退出群聊\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 编辑群名称弹窗 -->\r\n    <div v-if=\"showEditName\" class=\"edit-name-dialog\">\r\n      <div class=\"edit-name-content\">\r\n        <div class=\"edit-name-title\">修改群名称</div>\r\n        <input \r\n          type=\"text\" \r\n          class=\"edit-name-input\" \r\n          v-model=\"editGroupName\" \r\n          placeholder=\"请输入群名称\"\r\n          maxlength=\"20\"\r\n        >\r\n        <div class=\"edit-name-buttons\">\r\n          <button class=\"edit-name-btn edit-name-cancel\" @click=\"cancelEditName\">取消</button>\r\n          <button class=\"edit-name-btn edit-name-confirm\" @click=\"confirmEditName\">确定</button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 添加成员弹窗 -->\r\n    <div v-if=\"showAddMember\" class=\"add-member-dialog\">\r\n      <div class=\"add-member-content\">\r\n        <div class=\"add-member-header\">\r\n          <div class=\"add-member-title\">添加成员</div>\r\n          <div class=\"add-member-close\" @click=\"closeAddMemberDialog\">\r\n            <i class=\"fa-solid fa-xmark\"></i>\r\n          </div>\r\n        </div>\r\n        <div class=\"add-member-search\">\r\n          <input \r\n            type=\"text\" \r\n            v-model=\"searchKeyword\" \r\n            placeholder=\"搜索用户...\"\r\n            class=\"search-input\"\r\n          >\r\n        </div>\r\n        <div class=\"add-member-list\">\r\n          <div \r\n            v-for=\"user in filteredUsers\" \r\n            :key=\"user.id\" \r\n            class=\"user-item\"\r\n            @click=\"selectUser(user)\"\r\n          >\r\n            <div class=\"user-avatar\">\r\n              <img :src=\"getFullUrl(user.photo)\" alt=\"用户头像\" onerror=\"this.src='@/assets/default-avatar.png'\">\r\n            </div>\r\n            <div class=\"user-info\">\r\n              <div class=\"user-name\">{{ user.username }}</div>\r\n              <div class=\"user-id\">ID: {{ user.id }}</div>\r\n            </div>\r\n            <div class=\"user-checkbox\">\r\n              <input type=\"checkbox\" :checked=\"isUserSelected(user.id)\">\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div class=\"add-member-footer\">\r\n          <button class=\"add-member-cancel\" @click=\"closeAddMemberDialog\">取消</button>\r\n          <button class=\"add-member-confirm\" @click=\"confirmAddMembers\">确认添加</button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, onMounted, watch } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { ElMessage, ElMessageBox } from 'element-plus';\r\nimport axios from 'axios';\r\nimport { API_CONFIG } from '@/config/config';\r\nimport defaultAvatar from '@/assets/default-avatar.png';\r\n\r\nexport default {\r\n  name: 'GroupInfo',\r\n  props: {\r\n    visible: {\r\n      type: Boolean,\r\n      default: false\r\n    },\r\n    groupInfo: {\r\n      type: Object,\r\n      default: () => ({})\r\n    }\r\n  },\r\n  emits: ['update:visible'],\r\n  setup(props, { emit }) {\r\n    const store = useStore();\r\n    const currentUserId = computed(() => store.state.user.id);\r\n    const currentUser = computed(() => store.state.user);\r\n    \r\n    const groupMembers = ref([]);\r\n    const isMuted = ref(false);\r\n    const showEditName = ref(false);\r\n    const editGroupName = ref('');\r\n    const showAddMember = ref(false);\r\n    const searchKeyword = ref('');\r\n    const selectedUserIds = ref(new Set());\r\n    const allUsers = ref([]);\r\n\r\n    const isGroupOwner = computed(() => {\r\n      return props.groupInfo.owner_id === currentUserId.value;\r\n    });\r\n\r\n    const groupAvatarUrls = computed(() => {\r\n      if (!props.groupInfo) return [defaultAvatar];\r\n      \r\n      const avatarMembers = props.groupInfo.avatar_members || [];\r\n      \r\n      if (avatarMembers.length > 0) {\r\n        return avatarMembers\r\n          .slice(0, 9)\r\n          .map(url => getFullUrl(url))\r\n          .filter(Boolean);\r\n      }\r\n      \r\n      const members = props.groupInfo.members || [];\r\n      return getFirstMembers(members, 9).map(memberId => getMemberAvatarById(memberId));\r\n    });\r\n\r\n    const filteredUsers = computed(() => {\r\n      if (!searchKeyword.value) return allUsers.value;\r\n      \r\n      return allUsers.value.filter(user => \r\n        user.username.toLowerCase().includes(searchKeyword.value.toLowerCase()) ||\r\n        user.id.toString().includes(searchKeyword.value)\r\n      );\r\n    });\r\n\r\n    const getFullUrl = (path) => {\r\n      if (!path) return defaultAvatar;\r\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`;\r\n    };\r\n\r\n    const getAvatarPosition = (index) => {\r\n      const positions = [\r\n        { top: '0%', left: '0%', width: '50%', height: '50%' },\r\n        { top: '0%', left: '50%', width: '50%', height: '50%' },\r\n        { top: '50%', left: '0%', width: '50%', height: '50%' },\r\n        { top: '50%', left: '50%', width: '50%', height: '50%' },\r\n        { top: '16%', left: '16%', width: '33%', height: '33%' },\r\n        { top: '16%', right: '16%', width: '33%', height: '33%' },\r\n        { bottom: '16%', left: '16%', width: '33%', height: '33%' },\r\n        { bottom: '16%', right: '16%', width: '33%', height: '33%' },\r\n        { top: '33%', left: '33%', width: '33%', height: '33%' }\r\n      ];\r\n      return positions[index] || positions[0];\r\n    };\r\n\r\n    const getMemberAvatar = (member) => {\r\n      return member.photo ? getFullUrl(member.photo) : defaultAvatar;\r\n    };\r\n\r\n    const getMemberAvatarById = (memberId) => {\r\n      const member = groupMembers.value.find(m => m.id === memberId);\r\n      return member?.photo ? getFullUrl(member.photo) : defaultAvatar;\r\n    };\r\n\r\n    const getMemberRole = (member) => {\r\n      if (member.id === props.groupInfo.owner_id) return '群主';\r\n      return '成员';\r\n    };\r\n\r\n    const getFirstMembers = (members, count) => {\r\n      if (!members) return [];\r\n      return members.slice(0, count);\r\n    };\r\n\r\n    const close = () => {\r\n      emit('update:visible', false);\r\n    };\r\n\r\n    const loadGroupMembers = async () => {\r\n      console.log(\"获取群名称：\", props.groupInfo.id)\r\n      try {\r\n        const response = await axios.get(\r\n          `${API_CONFIG.BASE_URL}/group/${props.groupInfo.group_id}/members`,\r\n          { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n        );\r\n        console.log(\"群成员数据--2：\", response.data);\r\n        if (response.data) {\r\n          groupMembers.value = response.data.group_members || [];\r\n        }\r\n      } catch (error) {\r\n        console.error('加载群成员失败:', error);\r\n        ElMessage.error('加载群成员失败');\r\n      }\r\n    };\r\n\r\n    const loadAllUsers = async () => {\r\n      try {\r\n        const response = await axios.get(\r\n          `${API_CONFIG.BASE_URL}/users`,\r\n          { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n        );\r\n        \r\n        if (response.data) {\r\n          // 过滤掉已经是群成员的用户\r\n          const memberIds = new Set(groupMembers.value.map(m => m.id));\r\n          allUsers.value = response.data.filter(user => !memberIds.has(user.id));\r\n        }\r\n      } catch (error) {\r\n        console.error('加载用户列表失败:', error);\r\n        ElMessage.error('加载用户列表失败');\r\n      }\r\n    };\r\n\r\n    const showEditNameDialog = () => {\r\n      editGroupName.value = props.groupInfo.name || '';\r\n      showEditName.value = true;\r\n    };\r\n\r\n    const cancelEditName = () => {\r\n      showEditName.value = false;\r\n    };\r\n\r\n    const confirmEditName = async () => {\r\n      try {\r\n        const response = await axios.post(\r\n          `${API_CONFIG.BASE_URL}/group/update-name`,\r\n          {\r\n            group_id: props.groupInfo.id,\r\n            name: editGroupName.value\r\n          },\r\n          { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n        );\r\n        \r\n        if (response.data.success) {\r\n          ElMessage.success('群名称修改成功');\r\n          // 通知父组件更新群信息\r\n          emit('group-updated');\r\n        } else {\r\n          ElMessage.error(response.data.message || '修改失败');\r\n        }\r\n      } catch (error) {\r\n        console.error('修改群名称失败:', error);\r\n        ElMessage.error('修改群名称失败');\r\n      }\r\n      showEditName.value = false;\r\n    };\r\n\r\n    const toggleMute = async () => {\r\n      try {\r\n        const response = await axios.post(\r\n          `${API_CONFIG.BASE_URL}/group/${props.groupInfo.group_id}/mute`,\r\n          { muted: !isMuted.value },\r\n          { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n        );\r\n        \r\n        if (response.data.success) {\r\n          isMuted.value = !isMuted.value;\r\n          ElMessage.success(isMuted.value ? '已开启消息免打扰' : '已关闭消息免打扰');\r\n        }\r\n      } catch (error) {\r\n        console.error('设置消息免打扰失败:', error);\r\n        ElMessage.error('设置失败');\r\n      }\r\n    };\r\n\r\n    const removeMember = async (member) => {\r\n      try {\r\n        await ElMessageBox.confirm(\r\n          `确定要将 ${member.username} 移出群聊吗？`,\r\n          '确认移除',\r\n          { type: 'warning' }\r\n        );\r\n        \r\n        const response = await axios.post(\r\n          `${API_CONFIG.BASE_URL}/group/remove-member`,\r\n          {\r\n            group_id: props.groupInfo.id,\r\n            user_id: member.id\r\n          },\r\n          { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n        );\r\n        \r\n        if (response.data.success) {\r\n          ElMessage.success('成员已移除');\r\n          // 重新加载群成员\r\n          await loadGroupMembers();\r\n          await loadAllUsers();\r\n          emit('group-updated');\r\n        }\r\n      } catch (error) {\r\n        if (error !== 'cancel') {\r\n          console.error('移除成员失败:', error);\r\n          ElMessage.error('移除成员失败');\r\n        }\r\n      }\r\n    };\r\n\r\n    const exitGroup = async () => {\r\n      try {\r\n        await ElMessageBox.confirm(\r\n          '确定要退出该群聊吗？退出后将不再接收该群消息',\r\n          '确认退出',\r\n          { type: 'warning' }\r\n        );\r\n        \r\n        const response = await axios.post(\r\n          `${API_CONFIG.BASE_URL}/group/exit`,\r\n          { group_id: props.groupInfo.id },\r\n          { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n        );\r\n        \r\n        if (response.data.success) {\r\n          ElMessage.success('已退出群聊');\r\n          close();\r\n          // 通知父组件处理退出后的逻辑\r\n          emit('group-exited');\r\n        }\r\n      } catch (error) {\r\n        if (error !== 'cancel') {\r\n          console.error('退出群聊失败:', error);\r\n          ElMessage.error('退出群聊失败');\r\n        }\r\n      }\r\n    };\r\n\r\n    const showAddMemberDialog = async () => {\r\n      await loadAllUsers();\r\n      showAddMember.value = true;\r\n      selectedUserIds.value.clear();\r\n      searchKeyword.value = '';\r\n    };\r\n\r\n    const closeAddMemberDialog = () => {\r\n      showAddMember.value = false;\r\n    };\r\n\r\n    const selectUser = (user) => {\r\n      if (selectedUserIds.value.has(user.id)) {\r\n        selectedUserIds.value.delete(user.id);\r\n      } else {\r\n        selectedUserIds.value.add(user.id);\r\n      }\r\n    };\r\n\r\n    const isUserSelected = (userId) => {\r\n      return selectedUserIds.value.has(userId);\r\n    };\r\n\r\n    const confirmAddMembers = async () => {\r\n      if (selectedUserIds.value.size === 0) {\r\n        ElMessage.warning('请选择要添加的成员');\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const response = await axios.post(\r\n          `${API_CONFIG.BASE_URL}/group/add-members`,\r\n          {\r\n            group_id: props.groupInfo.id,\r\n            user_ids: Array.from(selectedUserIds.value)\r\n          },\r\n          { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n        );\r\n        \r\n        if (response.data.success) {\r\n          ElMessage.success('成员添加成功');\r\n          // 重新加载群成员\r\n          await loadGroupMembers();\r\n          await loadAllUsers();\r\n          closeAddMemberDialog();\r\n          emit('group-updated');\r\n        }\r\n      } catch (error) {\r\n        console.error('添加成员失败:', error);\r\n        ElMessage.error('添加成员失败');\r\n      }\r\n    };\r\n      // 在 setup 函数中添加\r\n      watch(() => props.visible, async (newVisible) => {\r\n        if (newVisible && props.groupInfo.group_id) {\r\n          console.log(\"GroupInfo 对话框显示，开始加载数据\");\r\n          await loadGroupMembers();\r\n          \r\n          // 加载群免打扰状态\r\n          try {\r\n            const response = await axios.get(\r\n              `${API_CONFIG.BASE_URL}/group/${props.