\n    \r\n    <div class=\"dashboard-cards\">\r\n      <!-- 数据卡片1：动态统计 -->\r\n      <div class=\"dashboard-card\">\r\n        <div class=\"card-header\">\r\n          <i class=\"fa-solid fa-square-poll-vertical\"></i>\r\n          <h3>动态统计</h3>\r\n        </div>\r\n        <div class=\"card-content\">\r\n          <div class=\"stat-value\">{{ stats.publishedCount || 0 }}</div>\r\n          <div class=\"stat-label\">已发布动态</div>\r\n        </div>\r\n      </div>\r\n      \r\n      <!-- 数据卡片2：互动统计 -->\r\n      <div class=\"dashboard-card\">\r\n        <div class=\"card-header\">\r\n          <i class=\"fa-solid fa-heart\"></i>\r\n          <h3>互动数据</h3>\r\n        </div>\r\n        <div class=\"card-content\">\r\n          <div class=\"stat-value\">{{ stats.likesReceived || 0 }}</div>\r\n          <div class=\"stat-label\">收到点赞</div>\r\n        </div>\r\n      </div>\r\n      \r\n      <!-- 数据卡片3：关注统计 -->\r\n      <div class=\"dashboard-card\">\r\n        <div class=\"card-header\">\r\n          <i class=\"fa-solid fa-user-group\"></i>\r\n          <h3>社交数据</h3>\r\n        </div>\r\n        <div class=\"card-content\">\r\n          <div class=\"stat-value\">{{ stats.followingCount || 0 }}</div>\r\n          <div class=\"stat-label\">关注人数</div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    \r\n    <div class=\"recent-activity\">\r\n      <h2 class=\"section-title\">最近活动</h2>\r\n      <div v-if=\"recentMoments.length > 0\" class=\"activity-list\">\r\n        <div \r\n          v-for=\"moment in recentMoments\" \r\n          :key=\"moment.id\" \r\n          class=\"activity-item\"\r\n        >\r\n          <div class=\"activity-icon\">\r\n            <i class=\"fa-solid fa-comment\"></i>\r\n          </div>\r\n          <div class=\"activity-content\">\r\n            <div class=\"activity-text\">\r\n              您于 {{ formatTime(moment.created_at) }} 发布了动态: {{ moment.content.length > 30 ? moment.content.slice(0, 30) + '...' : moment.content }}\r\n            </div>\r\n            <div class=\"activity-meta\">\r\n              <span class=\"activity-likes\">{{ moment.stats.likes || 0 }} 点赞</span>\r\n              <span class=\"activity-comments\">{{ moment.stats.comments || 0 }} 评论</span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div v-else class=\"no-activity\">\r\n        <i class=\"fa-solid fa-clock\"></i>\r\n        <p>暂无活动记录</p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, onMounted } from 'vue'\r\nimport { useStore } from 'vuex'\r\nimport axios from 'axios'\r\nimport { API_CONFIG } from '@/config/config'\r\nimport { ElMessage } from 'element-plus'\r\n\r\nexport default {\r\n  setup() {\r\n    const store = useStore()\r\n    const currentUser = store.state.user\r\n    const stats = ref({\r\n      publishedCount: 0,\r\n      likesReceived: 0,\r\n      followingCount: 0\r\n    })\r\n    const recentMoments = ref([])\r\n    \r\n    // 工具方法\r\n    const formatTime = (timestamp) => {\r\n      const date = new Date(timestamp)\r\n      return `${date.getFullYear()}-${(date.getMonth() + 1).toString().padStart(2, '0')}-` +\r\n             `${date.getDate().toString().padStart(2, '0')} ` +\r\n             `${date.getHours().toString().padStart(2, '0')}:` +\r\n             `${date.getMinutes().toString().padStart(2, '0')}`\r\n    }\r\n    \r\n    // 获取用户统计数据\r\n    const fetchUserStats = async () => {\r\n      try {\r\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/user/stats`, {\r\n          headers: { Authorization: `Bearer ${store.state.token}` }\r\n        })\r\n        \r\n        stats.value = {\r\n          publishedCount: response.data.published_moments_count,\r\n          likesReceived: response.data.received_likes_count,\r\n          followingCount: response.data.following_count\r\n        }\r\n      } catch (error) {\r\n        console.error('获取用户统计数据失败:', error)\r\n        ElMessage.error('获取数据失败')\r\n      }\r\n    }\r\n    \r\n    // 获取最近发布的动态\r\n    const fetchRecentMoments = async () => {\r\n      try {\r\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/article/user_moments`, {\r\n          headers: { Authorization: `Bearer ${store.state.token}` },\r\n          params: { user_id: currentUser.id, limit: 3 }\r\n        })\r\n        \r\n        recentMoments.value = response.data.map(moment => ({\r\n          ...moment,\r\n          stats: {\r\n            likes: moment.stats.likes || 0,\r\n            comments: moment.stats.comments?.length || 0\r\n          }\r\n        }))\r\n      } catch (error) {\r\n        console.error('获取最近动态失败:', error)\r\n      }\r\n    }\r\n    \r\n    onMounted(() => {\r\n      if (currentUser) {\r\n        fetchUserStats()\r\n        fetchRecentMoments()\r\n      }\r\n    })\r\n\r\n    return {\r\n      stats,\r\n      recentMoments,\r\n      formatTime\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.dashboard-page {\r\n  padding: 20px;\r\n  background-color: #f0f2f5;\r\n  min-height: 100vh;\r\n}\r\n\r\n.dashboard-header {\r\n  text-align: center;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.dashboard-title {\r\n  font-size: 24px;\r\n  font-weight: 600;\r\n  color: #333;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.dashboard-subtitle {\r\n  font-size: 16px;\r\n  color: #666;\r\n}\r\n\r\n.dashboard-cards {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, 1fr);\r\n  gap: 20px;\r\n  margin-bottom: 30px;\r\n}\r\n\r\n.dashboard-card {\r\n  background: #fff;\r\n  border-radius: 12px;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);\r\n  padding: 20px;\r\n  transition: transform 0.3s ease, box-shadow 0.3s ease;\r\n}\r\n\r\n.dashboard-card:hover {\r\n  transform: translateY(-5px);\r\n  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.card-header {\r\n  display: flex;\r\n  align-items: center;\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.card-header i {\r\n  font-size: 24px;\r\n  color: #1890ff;\r\n  margin-right: 10px;\r\n}\r\n\r\n.card-header h3 {\r\n  font-size: 16px;\r\n  font-weight: 500;\r\n  color: #333;\r\n}\r\n\r\n.card-content {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n}\r\n\r\n.stat-value {\r\n  font-size: 36px;\r\n  font-weight: 700;\r\n  color: #333;\r\n  margin-bottom: 5px;\r\n}\r\n\r\n.stat-label {\r\n  font-size: 14px;\r\n  color: #666;\r\n}\r\n\r\n.recent-activity {\r\n  background: #fff;\r\n  border-radius: 12px;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);\r\n  padding: 20px;\r\n}\r\n\r\n.section-title {\r\n  font-size: 18px;\r\n  font-weight: 500;\r\n  color: #333;\r\n  margin-bottom: 20px;\r\n  padding-bottom: 10px;\r\n  border-bottom: 1px solid #eaeaea;\r\n}\r\n\r\n.activity-list {\r\n  list-style: none;\r\n  padding: 0;\r\n}\r\n\r\n.activity-item {\r\n  display: flex;\r\n  padding: 15px 0;\r\n  border-bottom: 1px solid #f0f2f5;\r\n}\r\n\r\n.activity-item:last-child {\r\n  border-bottom: none;\r\n}\r\n\r\n.activity-icon {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  width: 40px;\r\n  height: 40px;\r\n  background-color: #e6f7ff;\r\n  border-radius: 50%;\r\n  color: #1890ff;\r\n  margin-right: 15px;\r\n}\r\n\r\n.activity-content {\r\n  flex: 1;\r\n}\r\n\r\n.activity-text {\r\n  font-size: 14px;\r\n  color: #333;\r\n  line-height: 1.5;\r\n  margin-bottom: 5px;\r\n}\r\n\r\n.activity-meta {\r\n  font-size: 12px;\r\n  color: #999;\r\n  display: flex;\r\n  gap: 15px;\r\n}\r\n\r\n.no-activity {\r\n  padding: 30px 0;\r\n  text-align: center;\r\n  color: #999;\r\n}\r\n\r\n.no-activity i {\r\n  font-size: 40px;\r\n  margin-bottom: 10px;\r\n  display: block;\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .dashboard-cards {\r\n    grid-template-columns: repeat(2, 1fr);\r\n  }\r\n  \r\n  .dashboard-title {\r\n    font-size: 20px;\r\n  }\r\n  \r\n  .stat-value {\r\n    font-size: 28px;\r\n  }\r\n}\r\n\r\n@media (max-width: 480px) {\r\n  .dashboard-cards {\r\n    grid-template-columns: 1fr;\r\n  }\r\n  \r\n  .activity-item {\r\n    flex-direction: column;\r\n  }\r\n  \r\n  .activity-icon {\r\n    margin-bottom: 10px;\r\n  }\r\n}\r\n</style>"],"mappings":";;EACOA,KAAK,EAAC;AAAgB;;EAMpBA,KAAK,EAAC;AAAiB;;EAErBA,KAAK,EAAC;AAAgB;;EAKpBA,KAAK,EAAC;AAAc;;EAClBA,KAAK,EAAC;AAAY;;EAMtBA,KAAK,EAAC;AAAgB;;EAKpBA,KAAK,EAAC;AAAc;;EAClBA,KAAK,EAAC;AAAY;;EAMtBA,KAAK,EAAC;AAAgB;;EAKpBA,KAAK,EAAC;AAAc;;EAClBA,KAAK,EAAC;AAAY;;EAMxBA,KAAK,EAAC;AAAiB;;EA7ChCC,GAAA;EA+C2CD,KAAK,EAAC;;;EASlCA,KAAK,EAAC;AAAkB;;EACtBA,KAAK,EAAC;AAAe;;EAGrBA,KAAK,EAAC;AAAe;;EAClBA,KAAK,EAAC;AAAgB;;EACtBA,KAAK,EAAC;AAAmB;;EA9D7CC,GAAA;EAmEkBD,KAAK,EAAC;;;uBAlEtBE,mBAAA,CAuEM,OAvENC,UAuEM,G,0BAtEJC,mBAAA,CAGM;IAHDJ,KAAK,EAAC;EAAkB,IAC3BI,mBAAA,CAAsC;IAAlCJ,KAAK,EAAC;EAAiB,GAAC,OAAK,GACjCI,mBAAA,CAA0C;IAAvCJ,KAAK,EAAC;EAAoB,GAAC,UAAQ,E,sBAGxCI,mBAAA,CAoCM,OApCNC,UAoCM,GAnCJC,mBAAA,gBAAmB,EACnBF,mBAAA,CASM,OATNG,UASM,G,0BARJH,mBAAA,CAGM;IAHDJ,KAAK,EAAC;EAAa,IACtBI,mBAAA,CAAgD;IAA7CJ,KAAK,EAAC;EAAkC,IAC3CI,mBAAA,CAAa,YAAT,MAAI,E,sBAEVA,mBAAA,CAGM,OAHNI,UAGM,GAFJJ,mBAAA,CAA6D,OAA7DK,UAA6D,EAAAC,gBAAA,CAAlCC,MAAA,CAAAC,KAAK,CAACC,cAAc,uB,0BAC/CT,mBAAA,CAAmC;IAA9BJ,KAAK,EAAC;EAAY,GAAC,OAAK,qB,KAIjCM,mBAAA,gBAAmB,EACnBF,mBAAA,CASM,OATNU,UASM,G,0BARJV,mBAAA,CAGM;IAHDJ,KAAK,EAAC;EAAa,IACtBI,mBAAA,CAAiC;IAA9BJ,KAAK,EAAC;EAAmB,IAC5BI,mBAAA,CAAa,YAAT,MAAI,E,sBAEVA,mBAAA,CAGM,OAHNW,UAGM,GAFJX,mBAAA,CAA4D,OAA5DY,UAA4D,EAAAN,gBAAA,CAAjCC,MAAA,CAAAC,KAAK,CAACK,aAAa,uB,0BAC9Cb,mBAAA,CAAkC;IAA7BJ,KAAK,EAAC;EAAY,GAAC,MAAI,qB,KAIhCM,mBAAA,gBAAmB,EACnBF,mBAAA,CASM,OATNc,UASM,G,0BARJd,mBAAA,CAGM;IAHDJ,KAAK,EAAC;EAAa,IACtBI,mBAAA,CAAsC;IAAnCJ,KAAK,EAAC;EAAwB,IACjCI,mBAAA,CAAa,YAAT,MAAI,E,sBAEVA,mBAAA,CAGM,OAHNe,WAGM,GAFJf,mBAAA,CAA6D,OAA7DgB,WAA6D,EAAAV,gBAAA,CAAlCC,MAAA,CAAAC,KAAK,CAACS,cAAc,uB,0BAC/CjB,mBAAA,CAAkC;IAA7BJ,KAAK,EAAC;EAAY,GAAC,MAAI,qB,OAKlCI,mBAAA,CA0BM,OA1BNkB,WA0BM,G,0BAzBJlB,mBAAA,CAAmC;IAA/BJ,KAAK,EAAC;EAAe,GAAC,MAAI,sBACnBW,MAAA,CAAAY,aAAa,CAACC,MAAM,Q,cAA/BtB,mBAAA,CAmBM,OAnBNuB,WAmBM,I,kBAlBJvB,mBAAA,CAiBMwB,S