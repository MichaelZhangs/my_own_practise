fetchUserData\" class=\"search-button\">查询</button>\r\n      </div>\r\n  \r\n      <!-- 用户列表表格 -->\r\n      <table class=\"user-table\">\r\n        <thead>\r\n          <tr>\r\n            <th>ID</th>\r\n            <th>姓名</th>\r\n            <th>证件号码</th>\r\n            <th>性别</th>\r\n            <th>出生地</th>\r\n            <th>证件类型</th>\r\n            <th>省份</th>\r\n            <th>年龄</th>\r\n            <th>生日</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"user in users\" :key=\"user.id\">\r\n            <td>{{ user.id }}</td>\r\n            <td>{{ user.name || '未填写' }}</td>\r\n            <td>{{ user.idno || '未填写' }}</td>\r\n            <td>{{ user.sex || '未知' }}</td>\r\n            <td>{{ user.bplace || '未填写' }}</td>\r\n            <td>{{ user.idtype || '未填写' }}</td>\r\n            <td>{{ user.province || '未填写' }}</td>\r\n            <td>{{ user.age ?? '未填写' }}</td>\r\n            <td>{{ formatBirthday(user.birthday) }}</td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n  \r\n      <!-- 分页组件 -->\r\n      <div class=\"pagination\">\r\n        <button\r\n          @click=\"prevPage\"\r\n          :disabled=\"currentPage === 1\"\r\n          class=\"pagination-button\"\r\n        >\r\n          上一页\r\n        </button>\r\n        <span class=\"pagination-info\">\r\n          第 {{ currentPage }} 页 / 共 {{ totalPages }} 页 (共 {{ totalItems }} 条记录)\r\n        </span>\r\n        <button\r\n          @click=\"nextPage\"\r\n          :disabled=\"currentPage >= totalPages\"\r\n          class=\"pagination-button\"\r\n        >\r\n          下一页\r\n        </button>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script setup>\r\n  import { ref, computed, onMounted } from 'vue';\r\n  import axios from 'axios';\r\n  import { API_CONFIG } from './config';\r\n  \r\n  // 用户数据状态\r\n  const users = ref([]);\r\n  const loading = ref(false);\r\n  const error = ref(null);\r\n  \r\n  // 分页相关状态\r\n  const currentPage = ref(1);\r\n  const pageSize = ref(50);\r\n  const totalItems = ref(0);\r\n  const totalPages = computed(() => Math.ceil(totalItems.value / pageSize.value));\r\n  \r\n  // 搜索条件\r\n  const searchQuery = ref({\r\n    name: '',\r\n    idno: '',\r\n    sex: ''\r\n  });\r\n  \r\n  // 格式化生日显示\r\n  const formatBirthday = (birthday) => {\r\n    if (!birthday) return '未填写';\r\n    \r\n    const dateStr = birthday.toString();\r\n    if (dateStr.length === 8) {\r\n      return `${dateStr.substring(0,4)}-${dateStr.substring(4,6)}-${dateStr.substring(6,8)}`;\r\n    }\r\n    return new Date(birthday).toLocaleDateString();\r\n  };\r\n  \r\n  // 获取用户数据\r\n  const fetchUserData = async () => {\r\n    try {\r\n      loading.value = true;\r\n      error.value = null;\r\n      \r\n      const params = {\r\n        page: currentPage.value,\r\n        pageSize: pageSize.value,\r\n        ...searchQuery.value\r\n      };\r\n  \r\n      const response = await axios.get(`${API_CONFIG.BASE_URL}/bigdata/bigdata-users`, {\r\n        params\r\n      });\r\n      \r\n      users.value = response.data.items || [];\r\n      console.log(\"users : \", users.value)\r\n      totalItems.value = response.data.total || 0;\r\n    } catch (err) {\r\n      console.error('获取用户数据失败:', err);\r\n      error.value = err.message || '获取用户数据失败';\r\n    } finally {\r\n      loading.value = false;\r\n    }\r\n  };\r\n  \r\n  // 上一页\r\n  const prevPage = () => {\r\n    if (currentPage.value > 1) {\r\n      currentPage.value--;\r\n      fetchUserData();\r\n    }\r\n  };\r\n  \r\n  // 下一页\r\n  const nextPage = () => {\r\n    if (currentPage.value < totalPages.value) {\r\n      currentPage.value++;\r\n      fetchUserData();\r\n    }\r\n  };\r\n  \r\n  // 组件挂载时获取数据\r\n  onMounted(() => {\r\n    fetchUserData();\r\n  });\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .user-list-container {\r\n    max-width: 1200px;\r\n    margin: 0 auto;\r\n    padding: 20px;\r\n    font-family: 'Arial', sans-serif;\r\n  }\r\n  \r\n  h2 {\r\n    text-align: center;\r\n    color: #333;\r\n    margin-bottom: 20px;\r\n    font-size: 24px;\r\n  }\r\n  \r\n  .search-box {\r\n    display: flex;\r\n    gap: 10px;\r\n    margin-bottom: 20px;\r\n    padding: 15px;\r\n    background-color: #f5f5f5;\r\n    border-radius: 4px;\r\n  }\r\n  \r\n  .search-input {\r\n    flex: 1;\r\n    padding: 8px 12px;\r\n    border: 1px solid #ddd;\r\n    border-radius: 4px;\r\n    font-size: 14px;\r\n  }\r\n  \r\n  .search-select {\r\n    padding: 8px 12px;\r\n    border: 1px solid #ddd;\r\n    border-radius: 4px;\r\n    font-size: 14px;\r\n    min-width: 120px;\r\n  }\r\n  \r\n  .search-button {\r\n    padding: 8px 16px;\r\n    background-color: #1890ff;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 4px;\r\n    cursor: pointer;\r\n    font-size: 14px;\r\n  }\r\n  \r\n  .search-button:hover {\r\n    background-color: #40a9ff;\r\n  }\r\n  \r\n  .user-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    margin-bottom: 20px;\r\n  }\r\n  \r\n  .user-table th, .user-table td {\r\n    padding: 12px 15px;\r\n    text-align: left;\r\n    border-bottom: 1px solid #e8e8e8;\r\n  }\r\n  \r\n  .user-table th {\r\n    background-color: #fafafa;\r\n    font-weight: 500;\r\n    color: rgba(0, 0, 0, 0.85);\r\n  }\r\n  \r\n  .user-table tr:hover {\r\n    background-color: #f5f5f5;\r\n  }\r\n  \r\n  .pagination {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    gap: 20px;\r\n    margin-top: 20px;\r\n  }\r\n  \r\n  .pagination-button {\r\n    padding: 6px 12px;\r\n    background-color: #fff;\r\n    border: 1px solid #d9d9d9;\r\n    border-radius: 4px;\r\n    cursor: pointer;\r\n    font-size: 14px;\r\n  }\r\n  \r\n  .pagination-button:disabled {\r\n    color: rgba(0, 0, 0, 0.25);\r\n    background-color: #f5f5f5;\r\n    cursor: not-allowed;\r\n  }\r\n  \r\n  .pagination-button:not(:disabled):hover {\r\n    color: #1890ff;\r\n    border-color: #1890ff;\r\n  }\r\n  \r\n  .pagination-info {\r\n    font-size: 14px;\r\n    color: rgba(0, 0, 0, 0.65);\r\n  }\r\n  \r\n  @media (max-width: 768px) {\r\n    .search-box {\r\n      flex-direction: column;\r\n    }\r\n    \r\n    .user-table {\r\n      display: block;\r\n      overflow-x: auto;\r\n    }\r\n  }\r\n  </style>"],"mappings":";;EACSA,KAAK,EAAC;AAAqB;;EAIzBA,KAAK,EAAC;AAAY;;EAqBhBA,KAAK,EAAC;AAAY;;EA8BpBA,KAAK,EAAC;AAAY;mBAxD7B;;EAgEcA,KAAK,EAAC;AAAiB;mBAhErC;;uBACIC,mBAAA,CA0EM,OA1ENC,UA0EM,G,0BAzEJC,mBAAA,CAAgB,YAAZ,SAAO,sBAEXC,mBAAA,SAAY,EACZD,mBAAA,CAkBM,OAlBNE,UAkBM,G,gBAjBJF,mBAAA,CAIE;IAVV,uBAAAG,MAAA,QAAAA,MAAA,MAAAC,MAAA,IAOmBC,MAAA,CAAAC,WAAW,CAACC,IAAI,GAAAH,MAAA;IACzBI,WAAW,EAAC,IAAI;IAChBX,KAAK,EAAC;iDAFGQ,MAAA,CAAAC,WAAW,CAACC,IAAI,E,mBAI3BP,mBAAA,CAIE;IAfV,uBAAAG,MAAA,QAAAA,MAAA,MAAAC,MAAA,IAYmBC,MAAA,CAAAC,WAAW,CAACG,IAAI,GAAAL,MAAA;IACzBI,WAAW,EAAC,MAAM;IAClBX,KAAK,EAAC;iDAFGQ,MAAA,CAAAC,WAAW,CAACG,IAAI,E,mBAI3BT,mBAAA,CAKS;IArBjB,uBAAAG,MAAA,QAAAA,MAAA,MAAAC,MAAA,IAgByBC,MAAA,CAAAC,WAAW,CAACI,GAAG,GAAAN,MAAA;IAAEP,KAAK,EAAC;gCACtCG,mBAAA,CAA8B;IAAtBW,KAAK,EAAC;EAAE,GAAC,MAAI,qBACrBX,mBAAA,CAA4B;IAApBW,KAAK,EAAC;EAAG,GAAC,GAAC,qBACnBX,mBAAA,CAA4B;IAApBW,KAAK,EAAC;EAAG,GAAC,GAAC,qBACnBX,mBAAA,CAA8B;IAAtBW,KAAK,EAAC;EAAI,GAAC,IAAE,oB,2CAJNN,MAAA,CAAAC,WAAW,CAACI,GAAG,E,GAMhCV,mBAAA,CAAgE;IAAvDY,OAAK,EAAEP,MAAA,CAAAQ,aAAa;IAAEhB,KAAK,EAAC;KAAgB,IAAE,E,GAGzDI,mBAAA,YAAe,EACfD,mBAAA,CA2BQ,SA3BRc,UA2BQ,G,0BA1BNd,mBAAA,CAYQ,gBAXNA,mBAAA,CAUK,aATHA,mBAAA,CAAW,YAAP,IAAE,GACNA,mBAAA,CAAW,YAAP,IAAE,GACNA,mBAAA,CAAa,YAAT,MAAI,GACRA,mBAAA,CAAW,YAAP,IAAE,GACNA,mBAAA,CAAY,YAAR,KAAG,GACPA,mBAAA,CAAa,YAAT,MAAI,GACRA,mBAAA,CAAW,YAAP,IAAE,GACNA,mBAAA,CAAW,YAAP,IAAE,GACNA,mBAAA,CAAW,YAAP,IAAE,E,wBAGVA,mBAAA,CAYQ,iB,kBAXNF,mBAAA,CAUKiB,SAAA,QAnDfC,WAAA,CAyC6BX,MAAA,CAAAY,KAAK,EAAbC,IAAI;yBAAfpB,mBAAA,CAUK;MAVsBqB,GAAG,EAAED,IAAI,CAACE;QACnCpB,mBAAA,CAAsB,YAAAqB,gBAAA,CAAfH,IAAI,CAACE,EAAE,kBACdpB,mBAAA,CAAiC,YAAAqB,gBAAA,CAA1BH,IAAI,CAACX,IAAI,2BAChBP,mBAAA,CAAiC,YAAAqB,gBAAA,CAA1BH,IAAI,CAACT,