{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref } from 'vue';\nimport { useRouter } from 'vue-router';\nimport { useStore } from 'vuex';\nexport default {\n  setup() {\n    const router = useRouter();\n    const store = useStore();\n    const editor = ref(null);\n    const content = ref('');\n    const formatText = command => {\n      document.execCommand(command, false);\n      editor.value.focus();\n    };\n    const updateContent = e => {\n      content.value = e.target.innerHTML;\n    };\n    const publish = () => {\n      if (content.value.trim()) {\n        const newMoment = {\n          content: content.value,\n          time: new Date().toLocaleString()\n        };\n\n        // 更新Vuex中的动态数据\n        store.commit('addMoment', newMoment);\n        router.push('/moments');\n      }\n    };\n    return {\n      editor,\n      formatText,\n      updateContent,\n      publish\n    };\n  }\n};","map":{"version":3,"names":["ref","useRouter","useStore","setup","router","store","editor","content","formatText","command","document","execCommand","value","focus","updateContent","e","target","innerHTML","publish","trim","newMoment","time","Date","toLocaleString","commit","push"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\article\\UserPublish.vue"],"sourcesContent":["<template>\r\n    <div class=\"publish-page\">\r\n      <div class=\"editor-container\">\r\n        <div class=\"toolbar\">\r\n          <button @click=\"formatText('bold')\" title=\"加粗\">B</button>\r\n          <button @click=\"formatText('italic')\" title=\"斜体\">I</button>\r\n          <button @click=\"formatText('underline')\" title=\"下划线\">U</button>\r\n        </div>\r\n        \r\n        <div ref=\"editor\" \r\n             contenteditable=\"true\"\r\n             class=\"content-editor\"\r\n             placeholder=\"分享你的新鲜事...\"\r\n             @input=\"updateContent\"></div>\r\n      </div>\r\n      \r\n      <button class=\"publish-button\" @click=\"publish\">发布</button>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import { ref } from 'vue'\r\n  import { useRouter } from 'vue-router'\r\n  import { useStore } from 'vuex'\r\n  \r\n  export default {\r\n    setup() {\r\n      const router = useRouter()\r\n      const store = useStore()\r\n      const editor = ref(null)\r\n      const content = ref('')\r\n  \r\n      const formatText = (command) => {\r\n        document.execCommand(command, false)\r\n        editor.value.focus()\r\n      }\r\n  \r\n      const updateContent = (e) => {\r\n        content.value = e.target.innerHTML\r\n      }\r\n  \r\n      const publish = () => {\r\n        if (content.value.trim()) {\r\n          const newMoment = {\r\n            content: content.value,\r\n            time: new Date().toLocaleString()\r\n          }\r\n          \r\n          // 更新Vuex中的动态数据\r\n          store.commit('addMoment', newMoment)\r\n          router.push('/moments')\r\n        }\r\n      }\r\n  \r\n      return { editor, formatText, updateContent, publish }\r\n    }\r\n  }\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .editor-container {\r\n    margin: 20px;\r\n    border: 1px solid #e0e0e0;\r\n    border-radius: 4px;\r\n  }\r\n  \r\n  .toolbar {\r\n    padding: 10px;\r\n    background: #f5f5f5;\r\n    border-bottom: 1px solid #e0e0e0;\r\n    display: flex;\r\n    gap: 8px;\r\n  }\r\n  \r\n  .toolbar button {\r\n    padding: 5px 10px;\r\n    min-width: 32px;\r\n    border: 1px solid #ddd;\r\n    border-radius: 3px;\r\n    background: white;\r\n    cursor: pointer;\r\n  }\r\n  \r\n  .toolbar button:hover {\r\n    background: #f0f0f0;\r\n  }\r\n  \r\n  .content-editor {\r\n    min-height: 200px;\r\n    padding: 15px;\r\n    outline: none;\r\n    font-size: 16px;\r\n    line-height: 1.5;\r\n  }\r\n  \r\n  .content-editor:empty::before {\r\n    content: attr(placeholder);\r\n    color: #999;\r\n  }\r\n  \r\n  .publish-button {\r\n    margin: 20px;\r\n    padding: 10px 30px;\r\n    background: #1890ff;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 20px;\r\n    cursor: pointer;\r\n    font-size: 16px;\r\n    float: right;\r\n  }\r\n  \r\n  .publish-button:hover {\r\n    background: #40a9ff;\r\n  }\r\n  </style>"],"mappings":";AAqBE,SAASA,GAAE,QAAS,KAAI;AACxB,SAASC,SAAQ,QAAS,YAAW;AACrC,SAASC,QAAO,QAAS,MAAK;AAE9B,eAAe;EACbC,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIH,SAAS,CAAC;IACzB,MAAMI,KAAI,GAAIH,QAAQ,CAAC;IACvB,MAAMI,MAAK,GAAIN,GAAG,CAAC,IAAI;IACvB,MAAMO,OAAM,GAAIP,GAAG,CAAC,EAAE;IAEtB,MAAMQ,UAAS,GAAKC,OAAO,IAAK;MAC9BC,QAAQ,CAACC,WAAW,CAACF,OAAO,EAAE,KAAK;MACnCH,MAAM,CAACM,KAAK,CAACC,KAAK,CAAC;IACrB;IAEA,MAAMC,aAAY,GAAKC,CAAC,IAAK;MAC3BR,OAAO,CAACK,KAAI,GAAIG,CAAC,CAACC,MAAM,CAACC,SAAQ;IACnC;IAEA,MAAMC,OAAM,GAAIA,CAAA,KAAM;MACpB,IAAIX,OAAO,CAACK,KAAK,CAACO,IAAI,CAAC,CAAC,EAAE;QACxB,MAAMC,SAAQ,GAAI;UAChBb,OAAO,EAAEA,OAAO,CAACK,KAAK;UACtBS,IAAI,EAAE,IAAIC,IAAI,CAAC,CAAC,CAACC,cAAc,CAAC;QAClC;;QAEA;QACAlB,KAAK,CAACmB,MAAM,CAAC,WAAW,EAAEJ,SAAS;QACnChB,MAAM,CAACqB,IAAI,CAAC,UAAU;MACxB;IACF;IAEA,OAAO;MAAEnB,MAAM;MAAEE,UAAU;MAAEM,aAAa;MAAEI;IAAQ;EACtD;AACF","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}