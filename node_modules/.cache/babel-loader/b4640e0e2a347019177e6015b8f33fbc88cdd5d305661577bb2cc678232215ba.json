{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { ref } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nimport axios from 'axios';\nexport default {\n  name: 'UserLogin',\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const loginType = ref('phone');\n    const phone = ref('');\n    const email = ref('');\n    const code = ref('');\n    const password = ref('');\n    const loginResult = ref(null);\n    const isPasswordLogin = ref(false);\n    const isCodeButtonDisabled = ref(false);\n    const codeButtonText = ref('获取验证码');\n    const countdown = ref(0);\n    const sendCode = async () => {\n      if (loginType.value === 'phone' && !phone.value || loginType.value === 'email' && !email.value) {\n        alert('请输入手机号或邮箱');\n        return;\n      }\n      try {\n        const response = await axios.post('http://127.0.0.1:8000/api/send-code', {\n          phone: loginType.value === 'phone' ? phone.value : email.value\n        });\n        console.log(\"response = \", response.data);\n        alert('验证码已发送');\n        startCountdown();\n      } catch (error) {\n        console.error('验证码发送失败', error);\n        alert('验证码发送失败');\n      }\n    };\n    const startCountdown = () => {\n      isCodeButtonDisabled.value = true;\n      countdown.value = 60;\n      const timer = setInterval(() => {\n        countdown.value--;\n        if (countdown.value <= 0) {\n          clearInterval(timer);\n          isCodeButtonDisabled.value = false;\n          codeButtonText.value = '获取验证码';\n        } else {\n          codeButtonText.value = `${countdown.value}s后重新获取`;\n        }\n      }, 1000);\n    };\n    const handleLogin = async () => {\n      try {\n        const response = await axios.post('http://127.0.0.1:8000/api/login', {\n          phone: isPasswordLogin.value ? phone.value : loginType.value === 'phone' ? phone.value : email.value,\n          password: isPasswordLogin.value ? password.value : code.value\n        });\n        store.dispatch('login', {\n          user: response.data.user,\n          token: response.data.token\n        });\n        router.push('/user');\n      } catch (error) {\n        loginResult.value = {\n          success: false,\n          message: error.response?.data?.message || '登录失败'\n        };\n      }\n    };\n    const togglePasswordLogin = () => {\n      isPasswordLogin.value = !isPasswordLogin.value;\n    };\n    const goToRegisterPage = () => {\n      router.push('/register');\n    };\n    const goToForgotPasswordPage = () => {\n      router.push('/forgot-password');\n    };\n    return {\n      loginType,\n      phone,\n      email,\n      code,\n      password,\n      loginResult,\n      isPasswordLogin,\n      isCodeButtonDisabled,\n      codeButtonText,\n      sendCode,\n      handleLogin,\n      togglePasswordLogin,\n      goToRegisterPage,\n      goToForgotPasswordPage\n    };\n  }\n};","map":{"version":3,"names":["ref","useStore","useRouter","axios","name","setup","store","router","loginType","phone","email","code","password","loginResult","isPasswordLogin","isCodeButtonDisabled","codeButtonText","countdown","sendCode","value","alert","response","post","console","log","data","startCountdown","error","timer","setInterval","clearInterval","handleLogin","dispatch","user","token","push","success","message","togglePasswordLogin","goToRegisterPage","goToForgotPasswordPage"],"sources":["E:\\vue_learn\\ai_vue\\ai_vue\\src\\components\\UserLogin.vue"],"sourcesContent":["<template>\r\n  <div class=\"login-wrapper\">\r\n    <div class=\"user-login-container\">\r\n      <h1>{{ isPasswordLogin ? '密码登录' : '用户登录' }}</h1>\r\n      <form @submit.prevent=\"handleLogin\">\r\n        <!-- 登录方式选择 -->\r\n        <div v-if=\"!isPasswordLogin\" class=\"login-type\">\r\n          <label>\r\n            <input type=\"radio\" v-model=\"loginType\" value=\"phone\" /> 短信登录\r\n          </label>\r\n          <label>\r\n            <input type=\"radio\" v-model=\"loginType\" value=\"email\" /> 邮箱登录\r\n          </label>\r\n        </div>\r\n\r\n        <!-- 手机号登录 -->\r\n        <div v-if=\"loginType === 'phone' && !isPasswordLogin\" class=\"input-group\">\r\n          <input type=\"text\" v-model=\"phone\" placeholder=\"请输入手机号\" required />\r\n        </div>\r\n\r\n        <!-- 邮箱登录 -->\r\n        <div v-else-if=\"loginType === 'email' && !isPasswordLogin\" class=\"input-group\">\r\n          <input type=\"email\" v-model=\"email\" placeholder=\"请输入邮箱\" required />\r\n        </div>\r\n\r\n        <!-- 验证码输入 -->\r\n        <div v-if=\"!isPasswordLogin\" class=\"input-group code-group\">\r\n          <input type=\"text\" v-model=\"code\" placeholder=\"请输入验证码\" required />\r\n          <button type=\"button\" @click=\"sendCode\" :disabled=\"isCodeButtonDisabled\">\r\n            {{ codeButtonText }}\r\n          </button>\r\n        </div>\r\n\r\n        <!-- 密码登录链接 -->\r\n        <div v-if=\"!isPasswordLogin\" class=\"switch-links\">\r\n          <span @click=\"togglePasswordLogin\">密码登录</span>\r\n          <span @click=\"goToRegisterPage\">注册新用户</span>\r\n        </div>\r\n\r\n        <!-- 密码登录表单 -->\r\n        <div v-if=\"isPasswordLogin\" class=\"password-login-form\">\r\n          <div class=\"input-group\">\r\n            <input\r\n              type=\"text\"\r\n              v-model=\"phone\"\r\n              placeholder=\"请输入用户名/手机号/邮箱\"\r\n              required\r\n            />\r\n          </div>\r\n          <div class=\"input-group\">\r\n            <input type=\"password\" v-model=\"password\" placeholder=\"请输入密码\" required />\r\n          </div>\r\n          <div v-if=\"isPasswordLogin\" class=\"switch-links\">\r\n            <span @click=\"togglePasswordLogin\">验证码登录</span>\r\n            <span @click=\"goToForgotPasswordPage\">找回密码</span>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- 登录按钮 -->\r\n        <button type=\"submit\">{{ isPasswordLogin ? \"密码登录\" : \"登录\" }}</button>\r\n      </form>\r\n\r\n      <!-- 登录结果 -->\r\n      <div v-if=\"loginResult\">\r\n        <p v-if=\"loginResult.success\">登录成功！</p>\r\n        <p v-else>登录失败：{{ loginResult.message }}</p>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { useRouter } from 'vue-router';\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  name: 'UserLogin',\r\n  setup() {\r\n    const store = useStore();\r\n    const router = useRouter();\r\n\r\n    const loginType = ref('phone');\r\n    const phone = ref('');\r\n    const email = ref('');\r\n    const code = ref('');\r\n    const password = ref('');\r\n    const loginResult = ref(null);\r\n    const isPasswordLogin = ref(false);\r\n    const isCodeButtonDisabled = ref(false);\r\n    const codeButtonText = ref('获取验证码');\r\n    const countdown = ref(0);\r\n\r\n    const sendCode = async () => {\r\n      if ((loginType.value === 'phone' && !phone.value) || (loginType.value === 'email' && !email.value)) {\r\n        alert('请输入手机号或邮箱');\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const response = await axios.post('http://127.0.0.1:8000/api/send-code', {\r\n          phone: loginType.value === 'phone' ? phone.value : email.value,\r\n        });\r\n        console.log(\"response = \", response.data)\r\n        alert('验证码已发送');\r\n        startCountdown();\r\n      } catch (error) {\r\n        console.error('验证码发送失败', error);\r\n        alert('验证码发送失败');\r\n      }\r\n    };\r\n    const startCountdown = () => {\r\n      isCodeButtonDisabled.value = true;\r\n      countdown.value = 60;\r\n      const timer = setInterval(() => {\r\n        countdown.value--;\r\n        if (countdown.value <= 0) {\r\n          clearInterval(timer);\r\n          isCodeButtonDisabled.value = false;\r\n          codeButtonText.value = '获取验证码';\r\n        } else {\r\n          codeButtonText.value = `${countdown.value}s后重新获取`;\r\n        }\r\n      }, 1000);\r\n    };\r\n\r\n    const handleLogin = async () => {\r\n      try {\r\n        const response = await axios.post('http://127.0.0.1:8000/api/login', {\r\n          phone: isPasswordLogin.value ? phone.value : loginType.value === 'phone' ? phone.value : email.value,\r\n          password: isPasswordLogin.value ? password.value : code.value,\r\n        });\r\n\r\n        store.dispatch('login', {\r\n          user: response.data.user,\r\n          token: response.data.token,\r\n        });\r\n\r\n        router.push('/user');\r\n      } catch (error) {\r\n        loginResult.value = {\r\n          success: false,\r\n          message: error.response?.data?.message || '登录失败',\r\n        };\r\n      }\r\n    };\r\n\r\n    const togglePasswordLogin = () => {\r\n      isPasswordLogin.value = !isPasswordLogin.value;\r\n    };\r\n\r\n    const goToRegisterPage = () => {\r\n      router.push('/register');\r\n    };\r\n\r\n    const goToForgotPasswordPage = () => {\r\n      router.push('/forgot-password');\r\n    };\r\n\r\n    return {\r\n      loginType,\r\n      phone,\r\n      email,\r\n      code,\r\n      password,\r\n      loginResult,\r\n      isPasswordLogin,\r\n      isCodeButtonDisabled,\r\n      codeButtonText,\r\n      sendCode,\r\n      handleLogin,\r\n      togglePasswordLogin,\r\n      goToRegisterPage,\r\n      goToForgotPasswordPage,\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* 样式保持不变 */\r\n.login-wrapper {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  height: 100vh;\r\n  background-color: #f5f5f5;\r\n}\r\n\r\n.user-login-container {\r\n  max-width: 400px;\r\n  width: 100%;\r\n  padding: 30px;\r\n  border-radius: 10px;\r\n  background-color: white;\r\n  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);\r\n}\r\n\r\nh1 {\r\n  text-align: center;\r\n  color: #333;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.login-type {\r\n  display: flex;\r\n  justify-content: center;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.login-type label {\r\n  margin: 0 10px;\r\n  font-size: 16px;\r\n}\r\n\r\n.input-group {\r\n  margin-bottom: 15px;\r\n  position: relative;\r\n}\r\n\r\n.input-group input {\r\n  width: 100%;\r\n  padding: 10px;\r\n  border: 1px solid #ccc;\r\n  border-radius: 5px;\r\n  font-size: 16px;\r\n}\r\n\r\n.check-icon {\r\n  position: absolute;\r\n  right: 10px;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  font-size: 20px;\r\n}\r\n\r\n.check-icon-valid {\r\n  color: green;\r\n}\r\n\r\n.check-icon-invalid {\r\n  color: red;\r\n}\r\n\r\n.error-message {\r\n  color: red;\r\n  font-size: 12px;\r\n  margin-top: 5px;\r\n}\r\n\r\n.code-group {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.code-group input {\r\n  flex: 1;\r\n  margin-right: 10px;\r\n}\r\n\r\n.code-button {\r\n  padding: 10px 15px;\r\n  background-color: #42b983;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n  font-size: 14px;\r\n}\r\n\r\n.code-button:disabled {\r\n  background-color: #ccc;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.code-button:hover:not(:disabled) {\r\n  background-color: #369f6e;\r\n}\r\n\r\n.password-login-form {\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.switch-links {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  margin-top: 5px;\r\n  font-size: 12px; /* 小字体显示 */\r\n}\r\n\r\n.switch-login-link,\r\n.register-link,\r\n.forgot-password-link {\r\n  color: #42b983;\r\n  cursor: pointer;\r\n}\r\n\r\n.switch-login-link:hover,\r\n.register-link:hover,\r\n.forgot-password-link:hover {\r\n  text-decoration: underline;\r\n}\r\n\r\n.login-button {\r\n  width: 100%;\r\n  padding: 10px;\r\n  background-color: #42b983;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n  font-size: 16px;\r\n}\r\n\r\n.login-button:hover {\r\n  background-color: #369f6e;\r\n}\r\n\r\n.login-result {\r\n  margin-top: 20px;\r\n  text-align: center;\r\n  font-size: 16px;\r\n  color: #333;\r\n}\r\n\r\n/* 弹窗样式 */\r\n.modal-overlay {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background-color: rgba(0, 0, 0, 0.5);\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n\r\n.modal-content {\r\n  background-color: white;\r\n  padding: 20px;\r\n  border-radius: 10px;\r\n  text-align: center;\r\n}\r\n\r\n.modal-content h3 {\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.modal-content button {\r\n  margin-top: 10px;\r\n  padding: 10px 20px;\r\n  background-color: #42b983;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 5px;\r\n  cursor: pointer;\r\n}\r\n\r\n.modal-content button:hover {\r\n  background-color: #369f6e;\r\n}\r\n</style>"],"mappings":";AAwEA,SAASA,GAAE,QAAS,KAAK;AACzB,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,SAAQ,QAAS,YAAY;AACtC,OAAOC,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAI,EAAE,WAAW;EACjBC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIL,QAAQ,CAAC,CAAC;IACxB,MAAMM,MAAK,GAAIL,SAAS,CAAC,CAAC;IAE1B,MAAMM,SAAQ,GAAIR,GAAG,CAAC,OAAO,CAAC;IAC9B,MAAMS,KAAI,GAAIT,GAAG,CAAC,EAAE,CAAC;IACrB,MAAMU,KAAI,GAAIV,GAAG,CAAC,EAAE,CAAC;IACrB,MAAMW,IAAG,GAAIX,GAAG,CAAC,EAAE,CAAC;IACpB,MAAMY,QAAO,GAAIZ,GAAG,CAAC,EAAE,CAAC;IACxB,MAAMa,WAAU,GAAIb,GAAG,CAAC,IAAI,CAAC;IAC7B,MAAMc,eAAc,GAAId,GAAG,CAAC,KAAK,CAAC;IAClC,MAAMe,oBAAmB,GAAIf,GAAG,CAAC,KAAK,CAAC;IACvC,MAAMgB,cAAa,GAAIhB,GAAG,CAAC,OAAO,CAAC;IACnC,MAAMiB,SAAQ,GAAIjB,GAAG,CAAC,CAAC,CAAC;IAExB,MAAMkB,QAAO,GAAI,MAAAA,CAAA,KAAY;MAC3B,IAAKV,SAAS,CAACW,KAAI,KAAM,OAAM,IAAK,CAACV,KAAK,CAACU,KAAK,IAAMX,SAAS,CAACW,KAAI,KAAM,OAAM,IAAK,CAACT,KAAK,CAACS,KAAM,EAAE;QAClGC,KAAK,CAAC,WAAW,CAAC;QAClB;MACF;MAEA,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMlB,KAAK,CAACmB,IAAI,CAAC,qCAAqC,EAAE;UACvEb,KAAK,EAAED,SAAS,CAACW,KAAI,KAAM,OAAM,GAAIV,KAAK,CAACU,KAAI,GAAIT,KAAK,CAACS;QAC3D,CAAC,CAAC;QACFI,OAAO,CAACC,GAAG,CAAC,aAAa,EAAEH,QAAQ,CAACI,IAAI;QACxCL,KAAK,CAAC,QAAQ,CAAC;QACfM,cAAc,CAAC,CAAC;MAClB,EAAE,OAAOC,KAAK,EAAE;QACdJ,OAAO,CAACI,KAAK,CAAC,SAAS,EAAEA,KAAK,CAAC;QAC/BP,KAAK,CAAC,SAAS,CAAC;MAClB;IACF,CAAC;IAC