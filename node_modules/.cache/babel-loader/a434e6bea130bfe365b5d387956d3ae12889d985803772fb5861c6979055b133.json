ElementVNode","_hoisted_2","_hoisted_3","_createCommentVNode","onClick","_cache","args","$setup","goToUserDetail","src","avatarUrl","alt","_hoisted_4","_hoisted_5","_toDisplayString","displayName","_hoisted_6","logout","_hoisted_7","_hoisted_8","_hoisted_9","_hoisted_10","_createVNode","_component_router_link","to","default","_withCtx","_createTextVNode","_","_hoisted_11","_hoisted_12","toggleUserInfo","_hoisted_13","isUserInfoOpen","_hoisted_14","_hoisted_15","_hoisted_16","_hoisted_17","_hoisted_18","_normalizeClass","activeTab","$event","switchTab","_hoisted_19","_hoisted_20","_Fragment","_renderList","publishedMoments","moment","id","_hoisted_21","getFullUrl","user","photo","defaultAvatar","_hoisted_22","_hoisted_23","_hoisted_24","username","_hoisted_25","formatTime","created_at","innerHTML","sanitizeHtml","content","_hoisted_26","media","length","_hoisted_27","index","type","url","openImagePreview","_hoisted_28","_hoisted_29","_hoisted_30","getTimeAgo","_hoisted_31","likedMoments","_hoisted_32","_hoisted_33","_hoisted_34","_hoisted_35","_hoisted_36","_hoisted_37","_hoisted_38","_hoisted_39","_hoisted_40","_hoisted_41","_component_router_view"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\views\\UserPage.vue"],"sourcesContent":["<template>\r\n  <div class=\"user-page\">\r\n    <header class=\"header\">\r\n      <div class=\"header-left\">\r\n        <!-- 点击头像跳转到用户详情页 -->\r\n        <div class=\"user-info\" @click=\"goToUserDetail\">\r\n          <img :src=\"avatarUrl\" alt=\"头像\" class=\"avatar\" />\r\n          <span class=\"username\">{{ displayName }}</span>\r\n        </div>\r\n      </div>\r\n      <div class=\"header-right\">\r\n        <button @click=\"logout\" class=\"logout-button\">退出登录</button>\r\n      </div>\r\n    </header>\r\n\r\n    <div class=\"main-layout\">\r\n      <aside class=\"sidebar\">\r\n        <ul class=\"menu\">\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/user/dashboard\" class=\"menu-link\">仪表盘</router-link>\r\n          </li>\r\n        \r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/moments\" class=\"menu-link\">朋友圈</router-link>\r\n          </li>\r\n\r\n          <li class=\"menu-item\">\r\n            <!-- 用户信息 -->\r\n            <div @click=\"toggleUserInfo\" class=\"menu-title\">\r\n              用户信息\r\n              <span class=\"arrow\">{{ isUserInfoOpen ? '▼' : '▶' }}</span>\r\n            </div>\r\n            <!-- 用户信息子目录 -->\r\n            <ul v-if=\"isUserInfoOpen\" class=\"sub-menu\">\r\n              <li class=\"sub-menu-item\">\r\n                <router-link to=\"/user/userinfo/userlist\" class=\"sub-menu-link\">用户列表</router-link>\r\n              </li>\r\n              <li class=\"sub-menu-item2\">\r\n                <router-link to=\"/user/bigdatauser/userlist\" class=\"sub-menu-link\">大数据用户</router-link>\r\n              </li>\r\n            </ul>\r\n          </li>\r\n        </ul>\r\n      </aside>\r\n\r\n      <main class=\"main-content\">\r\n        <!-- 新增的导航标签 -->\r\n        <div class=\"content-tabs\">\r\n          <div \r\n            class=\"tab\" \r\n            :class=\"{ 'active': activeTab === 'published' }\"\r\n            @click=\"switchTab('published')\"\r\n          >\r\n            我发布的\r\n          </div>\r\n          <div \r\n            class=\"tab\" \r\n            :class=\"{ 'active': activeTab === 'liked' }\"\r\n            @click=\"switchTab('liked')\"\r\n          >\r\n            我喜欢的\r\n          </div>\r\n        </div>\r\n        \r\n        <!-- 内容区域 -->\r\n        <div class=\"content-container\">\r\n          <div v-if=\"activeTab === 'published'\" class=\"published-content\">\r\n            <!-- 我发布的内容列表 -->\r\n            <div \r\n              v-for=\"moment in publishedMoments\" \r\n              :key=\"moment.id\" \r\n              class=\"moment-item\"\r\n            >\r\n              <div class=\"user-info\">\r\n                <img :src=\"getFullUrl(moment.user.photo) || defaultAvatar\" class=\"user-avatar\" />\r\n                <div class=\"user-details\">\r\n                  <span class=\"username\">{{ moment.user.username }}</span>\r\n                  <span class=\"post-time\">{{ formatTime(moment.created_at) }}</span>\r\n                </div>\r\n              </div>\r\n              \r\n              <div class=\"moment-content\" v-html=\"sanitizeHtml(moment.content)\"></div>\r\n              \r\n              <div v-if=\"moment.media?.length\" class=\"media-grid\">\r\n                <div\r\n                  v-for=\"(media, index) in moment.media\"\r\n                  :key=\"index\"\r\n                  class=\"media-item\"\r\n                >\r\n                  <img\r\n                    v-if=\"media.type === 'image'\"\r\n                    :src=\"getFullUrl(media.url)\"\r\n                    @click=\"openImagePreview(getFullUrl(media.url))\"\r\n                  />\r\n                </div>\r\n              </div>\r\n              \r\n              <div class=\"moment-footer\">\r\n                <span class=\"time-ago\">{{ getTimeAgo(moment.created_at) }}</span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          \r\n          <div v-if=\"activeTab === 'liked'\" class=\"liked-content\">\r\n            <!-- 我喜欢的内容列表 -->\r\n            <div \r\n              v-for=\"moment in likedMoments\" \r\n              :key=\"moment.id\" \r\n              class=\"moment-item\"\r\n            >\r\n              <div class=\"user-info\">\r\n                <img :src=\"getFullUrl(moment.user.photo) || defaultAvatar\" class=\"user-avatar\" />\r\n                <div class=\"user-details\">\r\n                  <span class=\"username\">{{ moment.user.username }}</span>\r\n                  <span class=\"post-time\">{{ formatTime(moment.created_at) }}</span>\r\n                </div>\r\n              </div>\r\n              \r\n              <div class=\"moment-content\" v-html=\"sanitizeHtml(moment.content)\"></div>\r\n              \r\n              <div v-if=\"moment.media?.length\" class=\"media-grid\">\r\n                <div\r\n                  v-for=\"(media, index) in moment.media\"\r\n                  :key=\"index\"\r\n                  class=\"media-item\"\r\n                >\r\n                  <img\r\n                    v-if=\"media.type === 'image'\"\r\n                    :src=\"getFullUrl(media.url)\"\r\n                    @click=\"openImagePreview(getFullUrl(media.url))\"\r\n                  />\r\n                </div>\r\n              </div>\r\n              \r\n              <div class=\"moment-footer\">\r\n                <span class=\"time-ago\">{{ getTimeAgo(moment.created_at) }}</span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        \r\n        <router-view></router-view>\r\n      </main>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { computed, onMounted, ref } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { useRouter } from 'vue-router';\r\nimport defaultAvatar from '@/assets/default-avatar.png';\r\nimport { API_CONFIG } from '@/config/config';\r\nimport axios from 'axios';\r\nimport DOMPurify from 'dompurify';\r\n\r\nexport default {\r\n  name: 'UserPage',\r\n  setup() {\r\n    const store = useStore();\r\n    const router = useRouter();\r\n    const isUserInfoOpen = ref(false);\r\n    const activeTab = ref('published');\r\n    const publishedMoments = ref([]);\r\n    const likedMoments = ref([]);\r\n    const loading = ref(false);\r\n\r\n    const user = computed(() => store.state.user);\r\n    const displayName = computed(() => user.value?.username || user.value?.phone || user.value?.email || '未登录');\r\n\r\n    // 处理头像路径\r\n    const avatarUrl = computed(() => {\r\n      if (user.value?.photo) {\r\n        return `${API_CONFIG.BASE_URL}${user.value.photo}`;\r\n      }\r\n      return defaultAvatar;\r\n    });\r\n\r\n    // 工具函数\r\n    const getFullUrl = (path) => {\r\n      if (!path || path === defaultAvatar) return path;\r\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`;\r\n    };\r\n\r\n    const formatTime = (timestamp) => {\r\n      const date = new Date(timestamp);\r\n      return `${date.getFullYear()}-${(date.getMonth() + 1).toString().padStart(2, '0')}-` +\r\n             `${date.getDate().toString().padStart(2, '0')} ` +\r\n             `${date.getHours().toString().padStart(2, '0')}:` +\r\n             `${date.getMinutes().toString().padStart(2, '0')}`;\r\n    };\r\n\r\n    const getTimeAgo = (timestamp) => {\r\n      const now = Date.now();\r\n      const diff = now - new Date(timestamp).getTime();\r\n      const minutes = Math.floor(diff / 60000);\r\n      const hours = Math.floor(minutes / 60);\r\n      const days = Math.floor(hours / 24);\r\n\r\n      if (minutes < 1) return '刚刚';\r\n      if (minutes < 60) return `${minutes}分钟前`;\r\n      if (hours < 24) return `${hours}小时前`;\r\n      return `${days}天前`;\r\n    };\r\n\r\n    const sanitizeHtml = (html) => DOMPurify.sanitize(html);\r\n\r\n    const openImagePreview = (url) => {\r\n      window.open(url, '_blank');\r\n    };\r\n\r\n    // 获取我发布的内容\r\n    const fetchPublishedMoments = async () => {\r\n      try {\r\n        loading.value = true;\r\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/article/user_moments`, {\r\n          headers: { Authorization: `Bearer ${store.state.token}` },\r\n          params: { user_id: user.value.id }\r\n        });\r\n        \r\n        publishedMoments.value = response.data.map(moment => ({\r\n          ...moment,\r\n          showCommentInput: false,\r\n          commentInput: '',\r\n          showAllComments: false\r\n        }));\r\n      } catch (error) {\r\n        console.error('获取发布内容失败:', error);\r\n      } finally {\r\n        loading.value = false;\r\n      }\r\n    };\r\n\r\n    // 获取我喜欢的内容\r\n    const fetchLikedMoments = async () => {\r\n      try {\r\n        loading.value = true;\r\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/article/liked_moments`, {\r\n          headers: { Authorization: `Bearer ${store.state.token}` },\r\n          params: { user_id: user.value.id }\r\n        });\r\n        \r\n        likedMoments.value = response.data.map(moment => ({\r\n          ...moment,\r\n          showCommentInput: false,\r\n          commentInput: '',\r\n          showAllComments: false\r\n        }));\r\n      } catch (error) {\r\n        console.error('获取喜欢内容失败:', error);\r\n      } finally {\r\n        loading.value = false;\r\n      }\r\n    };\r\n\r\n    // 切换标签\r\n    const switchTab = (tab) => {\r\n      activeTab.value = tab;\r\n      if (tab === 'published' && publishedMoments.value.length === 0) {\r\n        fetchPublishedMoments();\r\n      } else if (tab === 'liked' && likedMoments.value.length === 0) {\r\n        fetchLikedMoments();\r\n      }\r\n    };\r\n\r\n    // 退出登录\r\n    const logout = () => {\r\n      store.dispatch('logout');\r\n      router.push('/login');\r\n    };\r\n\r\n    // 跳转到用户详情页\r\n    const goToUserDetail = () => {\r\n      router.push('/user/detail');\r\n    };\r\n\r\n    // 切换用户信息子目录的展开状态\r\n    const toggleUserInfo = () => {\r\n      isUserInfoOpen.value = !isUserInfoOpen.value;\r\n    };\r\n\r\n    // 页面加载时检查用户是否登录\r\n    onMounted(() => {\r\n      if (!store.state.user) {\r\n        router.push('/login');\r\n      } else {\r\n        fetchPublishedMoments();\r\n      }\r\n    });\r\n\r\n    return {\r\n      user,\r\n      displayName,\r\n      avatarUrl,\r\n      logout,\r\n      goToUserDetail,\r\n      isUserInfoOpen,\r\n      toggleUserInfo,\r\n      activeTab,\r\n      switchTab,\r\n      publishedMoments,\r\n      likedMoments,\r\n      getFullUrl,\r\n      formatTime,\r\n      getTimeAgo,\r\n      sanitizeHtml,\r\n      openImagePreview,\r\n      defaultAvatar\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.user-page {\r\n  display