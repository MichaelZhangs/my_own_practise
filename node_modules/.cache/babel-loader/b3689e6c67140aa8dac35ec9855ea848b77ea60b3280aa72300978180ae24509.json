)\n  }, \"取消\"), _createElementVNode(\"button\", {\n    class: \"edit-name-btn edit-name-confirm\",\n    onClick: _cache[7] || (_cache[7] = (...args) => $setup.confirmEditName && $setup.confirmEditName(...args))\n  }, \"确定\")])])])) : _createCommentVNode(\"v-if\", true), _createCommentVNode(\" 添加成员弹窗 \"), $setup.showAddMember ? (_openBlock(), _createElementBlock(\"div\", _hoisted_23, [_createElementVNode(\"div\", _hoisted_24, [_createElementVNode(\"div\", _hoisted_25, [_cache[20] || (_cache[20] = _createElementVNode(\"div\", {\n    class: \"add-member-title\"\n  }, \"添加成员\", -1 /* HOISTED */)), _createElementVNode(\"div\", {\n    class: \"add-member-close\",\n    onClick: _cache[8] || (_cache[8] = (...args) => $setup.closeAddMemberDialog && $setup.closeAddMemberDialog(...args))\n  }, _cache[19] || (_cache[19] = [_createElementVNode(\"i\", {\n    class: \"fa-solid fa-xmark\"\n  }, null, -1 /* HOISTED */)]))]), _createElementVNode(\"div\", _hoisted_26, [_withDirectives(_createElementVNode(\"input\", {\n    type: \"text\",\n    \"onUpdate:modelValue\": _cache[9] || (_cache[9] = $event => $setup.searchKeyword = $event),\n    placeholder: \"搜索用户...\",\n    class: \"search-input\"\n  }, null, 512 /* NEED_PATCH */), [[_vModelText, $setup.searchKeyword]])]), _createElementVNode(\"div\", _hoisted_27, [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList($setup.filteredUsers, user => {\n    return _openBlock(), _createElementBlock(\"div\", {\n      key: user.id,\n      class: \"user-item\",\n      onClick: $event => $setup.selectUser(user)\n    }, [_createElementVNode(\"div\", _hoisted_29, [_createElementVNode(\"img\", {\n      src: $setup.getFullUrl(user.photo),\n      alt: \"用户头像\",\n      onerror: \"this.src='@/assets/default-avatar.png'\"\n    }, null, 8 /* PROPS */, _hoisted_30)]), _createElementVNode(\"div\", _hoisted_31, [_createElementVNode(\"div\", _hoisted_32, _toDisplayString(user.username), 1 /* TEXT */), _createElementVNode(\"div\", _hoisted_33, \"ID: \" + _toDisplayString(user.id), 1 /* TEXT */)]), _createElementVNode(\"div\", _hoisted_34, [_createElementVNode(\"input\", {\n      type: \"checkbox\",\n      checked: $setup.isUserSelected(user.id)\n    }, null, 8 /* PROPS */, _hoisted_35)])], 8 /* PROPS */, _hoisted_28);\n  }), 128 /* KEYED_FRAGMENT */))]), _createElementVNode(\"div\", _hoisted_36, [_createElementVNode(\"button\", {\n    class: \"add-member-cancel\",\n    onClick: _cache[10] || (_cache[10] = (...args) => $setup.closeAddMemberDialog && $setup.closeAddMemberDialog(...args))\n  }, \"取消\"), _createElementVNode(\"button\", {\n    class: \"add-member-confirm\",\n    onClick: _cache[11] || (_cache[11] = (...args) => $setup.confirmAddMembers && $setup.confirmAddMembers(...args))\n  }, \"确认添加\")])])])) : _createCommentVNode(\"v-if\", true)])) : _createCommentVNode(\"v-if\", true);\n}","map":{"version":3,"names":["key","class","$props","visible","_createElementBlock","_hoisted_1","_createElementVNode","_hoisted_2","_hoisted_3","onClick","_cache","args","$setup","close","_hoisted_4","_hoisted_5","_Fragment","_renderList","groupAvatarUrls","avatarUrl","idx","style","_normalizeStyle","getAvatarPosition","src","alt","onerror","_hoisted_6","_hoisted_7","_createTextVNode","_toDisplayString","groupInfo","group_name","isGroupOwner","showEditNameDialog","_createCommentVNode","_hoisted_8","group_id","_hoisted_9","_hoisted_10","_hoisted_11","members_count","_hoisted_12","validGroupMembers","member","getMemberKey","_hoisted_13","getMemberAvatar","_hoisted_14","canRemoveMember","_withModifiers","$event","removeMember","_hoisted_15","_hoisted_16","getMemberName","_hoisted_17","getMemberRole","_hoisted_18","showAddMemberDialog","_hoisted_19","toggleMute","_normalizeClass","isMuted","exitGroup","showEditName","_hoisted_20","_hoisted_21","type","editGroupName","placeholder","maxlength","_hoisted_22","cancelEditName","confirmEditName","showAddMember","_hoisted_23","_hoisted_24","_hoisted_25","closeAddMemberDialog","_hoisted_26","searchKeyword","_hoisted_27","filteredUsers","user","id","selectUser","_hoisted_29","getFullUrl","photo","_hoisted_30","_hoisted_31","_hoisted_32","username","_hoisted_33","_hoisted_34","checked","isUserSelected","_hoisted_35","_hoisted_28","_hoisted_36","confirmAddMembers"],"sources":["E:\\home\\vue_pro\\src\\components\\GroupInfo.vue"],"sourcesContent":["<!-- src/components/GroupInfo.vue -->\r\n<template>\r\n  <div class=\"group-info-dialog\" v-if=\"visible\">\r\n    <div class=\"group-info-content\">\r\n      <div class=\"group-info-header\">\r\n        <div class=\"group-info-close\" @click=\"close\">\r\n          <i class=\"fa-solid fa-xmark\"></i>\r\n        </div>\r\n        <div class=\"group-info-avatar\">\r\n          <div class=\"group-avatar\">\r\n            <div \r\n              v-for=\"(avatarUrl, idx) in groupAvatarUrls\" \r\n              :key=\"idx\"\r\n              class=\"group-avatar-member\"\r\n              :style=\"getAvatarPosition(idx)\"\r\n            >\r\n              <img \r\n                :src=\"avatarUrl\" \r\n                alt=\"成员头像\"\r\n                onerror=\"this.src='@/assets/default-avatar.png'\"\r\n              />\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div class=\"group-info-name\">\r\n          {{ groupInfo.group_name || '未命名群聊' }}\r\n          <span class=\"group-info-edit\" @click=\"showEditNameDialog\" v-if=\"isGroupOwner\">\r\n            <i class=\"fa-solid fa-pen\"></i>\r\n          </span>\r\n        </div>\r\n        <div class=\"group-info-id\">群ID: {{ groupInfo.group_id }}</div>\r\n      </div>\r\n      \r\n      <div class=\"group-info-body\">\r\n        <div class=\"group-info-section\">\r\n          <div class=\"group-info-section-title\">群成员 ({{ groupInfo.members_count || 0 }})</div>\r\n          <div class=\"members-list\">\r\n            <div \r\n              class=\"member-item\" \r\n              v-for=\"member in validGroupMembers\" \r\n              :key=\"getMemberKey(member)\"\r\n            >\r\n              <div class=\"member-avatar\">\r\n                <img :src=\"getMemberAvatar(member)\" alt=\"成员头像\" onerror=\"this.src='@/assets/default-avatar.png'\">\r\n                <!-- 移除按钮 - 只有群主可以看到且不能移除自己和群主 -->\r\n                <div \r\n                  class=\"member-actions\" \r\n                  v-if=\"isGroupOwner && canRemoveMember(member)\"\r\n                  @click.stop=\"removeMember(member)\"\r\n                >\r\n                  <i class=\"fa-solid fa-xmark\"></i>\r\n                </div>\r\n              </div>\r\n              <div class=\"member-name\">{{ getMemberName(member) }}</div>\r\n              <div class=\"member-role\">{{ getMemberRole(member) }}</div>\r\n            </div>\r\n            \r\n            <!-- 添加成员按钮 - 只有群主可以看到 -->\r\n            <div class=\"member-item\" v-if=\"isGroupOwner\">\r\n              <div class=\"add-member-btn\" @click=\"showAddMemberDialog\">\r\n                <i class=\"fa-solid fa-plus\"></i>\r\n              </div>\r\n              <div class=\"member-name\">添加成员</div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        \r\n        <div class=\"group-info-actions\">\r\n          <div class=\"group-action-btn\" @click=\"toggleMute\">\r\n            <i class=\"fa-solid\" :class=\"isMuted ? 'fa-bell' : 'fa-bell-slash'\"></i> \r\n            {{ isMuted ? '开启通知' : '消息免打扰' }}\r\n          </div>\r\n          <div class=\"group-action-btn danger-action\" @click=\"exitGroup\">\r\n            <i class=\"fa-solid fa-right-from-bracket\"></i> 退出群聊\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 编辑群名称弹窗 -->\r\n    <div v-if=\"showEditName\" class=\"edit-name-dialog\">\r\n      <div class=\"edit-name-content\">\r\n        <div class=\"edit-name-title\">修改群名称</div>\r\n        <input \r\n          type=\"text\" \r\n          class=\"edit-name-input\" \r\n          v-model=\"editGroupName\" \r\n          placeholder=\"请输入群名称\"\r\n          maxlength=\"20\"\r\n        >\r\n        <div class=\"edit-name-buttons\">\r\n          <button class=\"edit-name-btn edit-name-cancel\" @click=\"cancelEditName\">取消</button>\r\n          <button class=\"edit-name-btn edit-name-confirm\" @click=\"confirmEditName\">确定</button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 添加成员弹窗 -->\r\n    <div v-if=\"showAddMember\" class=\"add-member-dialog\">\r\n      <div class=\"add-member-content\">\r\n        <div class=\"add-member-header\">\r\n          <div class=\"add-member-title\">添加成员</div>\r\n          <div class=\"add-member-close\" @click=\"closeAddMemberDialog\">\r\n            <i class=\"fa-solid fa-xmark\"></i>\r\n          </div>\r\n        </div>\r\n        <div class=\"add-member-search\">\r\n          <input \r\n            type=\"text\" \r\n            v-model=\"searchKeyword\" \r\n            placeholder=\"搜索用户...\"\r\n            class=\"search-input\"\r\n          >\r\n        </div>\r\n        <div class=\"add-member-list\">\r\n          <div \r\n            v-for=\"user in filteredUsers\" \r\n            :key=\"user.id\" \r\n            class=\"user-item\"\r\n            @click=\"selectUser(user)\"\r\n          >\r\n            <div class=\"user-avatar\">\r\n              <img :src=\"getFullUrl(user.photo)\" alt=\"用户头像\" onerror=\"this.src='@/assets/default-avatar.png'\">\r\n            </div>\r\n            <div class=\"user-info\">\r\n              <div class=\"user-name\">{{ user.username }}</div>\r\n              <div class=\"user-id\">ID: {{ user.id }}</div>\r\n            </div>\r\n            <div class=\"user-checkbox\">\r\n              <input type=\"checkbox\" :checked=\"isUserSelected(user.id)\">\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div class=\"add-member-footer\">\r\n          <button class=\"add-member-cancel\" @click=\"closeAddMemberDialog\">取消</button>\r\n          <button class=\"add-member-confirm\" @click=\"confirmAddMembers\">确认添加</button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, computed, onMounted, watch } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { ElMessage, ElMessageBox } from 'element-plus';\r\nimport axios from 'axios';\r\nimport { API_CONFIG } from '@/config/config';\r\nimport defaultAvatar from '@/assets/default-avatar.png';\r\n\r\nexport default {\r\n  name: 'GroupInfo',\r\n  props: {\r\n    visible: {\r\n      type: Boolean,\r\n      default: false\r\n    },\r\n    groupInfo: {\r\n      type: Object,\r\n      default: () => ({})\r\n    }\r\n  },\r\n  emits: ['update:visible', 'group-updated', 'group-exited'],\r\n  setup(props, { emit }) {\r\n    const store = useStore();\r\n    const currentUserId = computed(() => store.state.user.id);\r\n    const currentUser = computed(() => store.state.user);\r\n    \r\n    const groupMembers = ref([]);\r\n    const isMuted = ref(false);\r\n    const showEditName = ref(false);\r\n    const editGroupName = ref('');\r\n    const showAddMember = ref(false);\r\n    const searchKeyword = ref('');\r\n    const selectedUserIds = ref(new Set());\r\n    const allUsers = ref([]);\r\n\r\n    const isGroupOwner = computed(() => {\r\n      return props.groupInfo.owner_id === currentUserId.value;\r\n    });\r\n\r\n    // 计算属性：有效的群组成员\r\n    const validGroupMembers = computed(() => {\r\n      return (groupMembers.value || []).filter(member => \r\n        member && \r\n        (typeof member === 'object' || typeof member === 'number') &&\r\n        (member.id !== undefined || typeof member === 'number')\r\n      );\r\n    });\r\n\r\n    const groupAvatarUrls = computed(() => {\r\n      if (!props.groupInfo) return [defaultAvatar];\r\n      \r\n      const avatarMembers = props.groupInfo.avatar_members || [];\r\n      \r\n      // 优先使用 avatar_members\r\n      if (avatarMembers.length > 0) {\r\n        return avatarMembers\r\n          .slice(0, 9)\r\n          .map(url => getFullUrl(url))\r\n          .filter(Boolean);\r\n      }\r\n      \r\n      // 如果没有 avatar_members，使用群成员的头像\r\n      if (groupMembers.value && groupMembers.value.length > 0) {\r\n        return groupMembers.value\r\n          .slice(0, 9)\r\n          .map(member => {\r\n            if (typeof member === 'object' && member.photo) {\r\n              return getFullUrl(member.photo);\r\n            }\r\n            return defaultAvatar;\r\n          });\r\n      }\r\n      \r\n      // 如果都没有，使用默认头像\r\n      return [defaultAvatar];\r\n    });\r\n\r\n    const filteredUsers = computed(() => {\r\n      if (!searchKeyword.value) return allUsers.value;\r\n      \r\n      return allUsers.value.filter(user => \r\n        user.username.toLowerCase().includes(searchKeyword.value.toLowerCase()) ||\r\n        user.id.toString().includes(searchKeyword.value)\r\n      );\r\n    });\r\n\r\n    const getFullUrl = (path) => {\r\n      if (!path) return defaultAvatar;\r\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`;\r\n    };\r\n\r\n    const getAvatarPosition = (index) => {\r\n      const positions = [\r\n        { top: '0%', left: '0%', width: '50%', height: '50%' },\r\n        { top: '0%', left: '50%', width: '50%', height: '50%' },\r\n        { top: '50%', left: '0%', width: '50%', height: '50%' },\r\n        { top: '50%', left: '50%', width: '50%', height: '50%' },\r\n        { top: '16%', left: '16%', width: '33%', height: '33%' },\r\n        { top: '16%', right: '16%', width: '33%', height: '33%' },\r\n        { bottom: '16%', left: '16%', width: '33%', height: '33%' },\r\n        { bottom: '16%', right: '16%', width: '33%', height: '33%' },\r\n        { top: '33%', left: '33%', width: '33%', height: '33%' }\r\n      ];\r\n      return positions[index] || positions[0];\r\n    };\r\n\r\n    const getMemberAvatar = (member) => {\r\n      if (!member) return defaultAvatar;\r\n      \r\n      if (typeof member === 'number') {\r\n        return defaultAvatar;\r\n      }\r\n      \r\n      if (!member.photo) {\r\n        return defaultAvatar;\r\n      }\r\n      \r\n      return getFullUrl(member.photo);\r\n    };\r\n\r\n    const getMemberRole = (member) => {\r\n      if (!member) return '成员';\r\n      \r\n      const memberId = typeof member === 'number' ? member : member.id;\r\n      \r\n      if (memberId === props.groupInfo.creator_id) return '群主';\r\n      if (memberId === props.groupInfo.owner_id) return '群主';\r\n      return '成员';\r\n    };\r\n\r\n    const getMemberName = (member) => {\r\n      if (!member) return '未知用户';\r\n      if (typeof member === 'number') return `用户 ${member}`;\r\n      return member.username || `用户 ${member.id}`;\r\n    };\r\n\r\n    const getMemberKey = (member) => {\r\n      if (typeof member === 'number') return member;\r\n      if (member && member.id) return member.id;\r\n      return Math.random();\r\n    };\r\n\r\n    const canRemoveMember = (member) => {\r\n      if (!member) return false;\r\n      \r\n      const memberId = typeof member === 'number' ? member : member.id;\r\n      \r\n      if (!memberId) return false;\r\n      if (memberId === currentUserId.value) return false;\r\n      if (memberId === props.groupInfo.creator_id) return false;\r\n      if (memberId === props.groupInfo.owner_id) return false;\r\n      \r\n      return true;\r\n    };\r\n\r\n    const close = () => {\r\n      emit('update:visible', false);\r\n    };\r\n\r\n    const loadGroupMembers = async () => {\r\n      try {\r\n        const response = await axios.get(\r\n          `${API_CONFIG.BASE_URL}/group/${props.groupInfo.group_id}/members`,\r\n          { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n        );\r\n        \r\n        if (response.data) {\r\n          const membersData = response.data.group_members || [];\r\n          \r\n          if (Array.isArray(membersData) && membersData.length > 0) {\r\n            if (typeof membersData[0] === 'number') {\r\n              // 如果是ID数组，转换为成员对象\r\n              groupMembers.value = membersData.map(id => ({\r\n                id: id,\r\n                username: `用户 ${id}`,\r\n                photo: null,\r\n              }));\r\n            } else {\r\n              // 已经是完整的成员对象\r\n              groupMembers.value = membersData.filter(member => \r\n                member && typeof member === 'object' && member.id !== undefined\r\n              );\r\n            }\r\n          } else {\r\n            groupMembers.value = [];\r\n          }\r\n        }\r\n      } catch (error) {\r\n        console.error('加载群成员失败:', error);\r\n        ElMessage.error('加载群成员失败');\r\n      }\r\n    };\r\n\r\n    const loadAllUsers = async () => {\r\n      try {\r\n        const response = await axios.get(\r\n          `${API_CONFIG.BASE_URL}/users`,\r\n          { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n        );\r\n        \r\n        if (response.data) {\r\n          // 过滤掉已经是群成员的用户\r\n          const memberIds = new Set(validGroupMembers.value.map(m => \r\n            typeof m === 'number' ? m : m.id\r\n          ));\r\n          allUsers.value = response.data.filter(user => !memberIds.has(user.id));\r\n        }\r\n      } catch (error) {\r\n        console.error('加载用户列表失败:', error);\r\n        ElMessage.error('加载用户列表失败');\r\n      }\r\n    };\r\n\r\n    const showEditNameDialog = () => {\r\n      editGroupName.value = props.groupInfo.group_name || '';\r\n      showEditName.value = true;\r\n    };\r\n\r\n    const cancelEditName = () => {\r\n      showEditName.value = false;\r\n    };\r\n\r\n    const confirmEditName = async () => {\r\n      try {\r\n        const response = await axios.post(\r\n          `${API_CONFIG.BASE_URL}/group/update-name`,\r\n          {\r\n            group_id: props.groupInfo.group_id,\r\n            name: editGroupName.value\r\n          },\r\n          { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n        );\r\n        \r\n        if (response.data.success) {\r\n          ElMessage.success('群名称修改成功');\r\n          showEditName.value = false;\r\n          \r\n          // 更新Vuex store中的群组信息\r\n          store.commit('chat/UPDATE_JOINED_GROUP', {\r\n            group_id: props.groupInfo.group_id,\r\n            name: editGroupName.value,\r\n            ...props.groupInfo\r\n          });\r\n          \r\n          emit('group-updated');\r\n          emit('update:visible', false);\r\n        } else {\r\n          ElMessage.error(response.data.message || '修改失败');\r\n          showEditName.value = false;\r\n        }\r\n      } catch (error) {\r\n        console.error('修改群名称失败:', error);\r\n        ElMessage.error('修改群名称失败');\r\n        showEditName.value = false;\r\n      }\r\n    };\r\n\r\n    const toggleMute = async () => {\r\n      try {\r\n        const response = await axios.post(\r\n          `${API_CONFIG.BASE_URL}/group/${props.groupInfo.group_id}/mute?user_id=${currentUserId.value}`,\r\n          { muted: !isMuted.value, user_id: currentUserId.value },\r\n          { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n        );\r\n        \r\n        if (response.data.success) {\r\n          isMuted.value = !isMuted.value;\r\n          ElMessage.success(isMuted.value ? '已开启消息免打扰' : '已关闭消息免打扰');\r\n        }\r\n      } catch (error) {\r\n        console.error('设置消息免打扰失败:', error);\r\n        ElMessage.error('设置失败');\r\n      }\r\n    };\r\n\r\n    const removeMember = async (member) => {\r\n      if (!member) {\r\n        ElMessage.error('成员信息无效');\r\n        return;\r\n      }\r\n      \r\n      const memberId = typeof member === 'number' ? member : member.id;\r\n      const memberName = typeof member === 'number' ? `用户 ${member}` : member.username;\r\n      \r\n      try {\r\n        await ElMessageBox.confirm(\r\n          `确定要将 ${memberName} 移出群聊吗？`,\r\n          '确认移除',\r\n          { type: 'warning' }\r\n        );\r\n        \r\n        const response = await axios.post(\r\n          `${API_CONFIG.BASE_URL}/group/remove-member`,\r\n          {\r\n            group_id: props.groupInfo.group_id,\r\n            user_id: memberId\r\n          },\r\n          { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n        );\r\n        \r\n        if (response.data.success) {\r\n          ElMessage.success('成员已移除');\r\n          await loadGroupMembers();\r\n          await loadAllUsers();\r\n          emit('group-updated');\r\n        }\r\n      } catch (error) {\r\n        if (error !== 'cancel') {\r\n          console.error('移除成员失败:', error);\r\n          ElMessage.error('移除成员失败');\r\n        }\r\n      }\r\n    };\r\n\r\n    const exitGroup = async () => {\r\n      try {\r\n        await ElMessageBox.confirm(\r\n          '确定要退出该群聊吗？退出后将不再接收该群消息',\r\n          '确认退出',\r\n          { type: 'warning' }\r\n        );\r\n        \r\n        const response = await axios.post(\r\n          `${API_CONFIG.BASE_URL}/group/exit`,\r\n          { group_id: props.groupInfo.group_id },\r\n          { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n        );\r\n        \r\n        if (response.data.success) {\r\n          ElMessage.success('已退出群聊');\r\n          close();\r\n          emit('group-exited');\r\n        }\r\n      } catch (error) {\r\n        if (error !== 'cancel') {\r\n          console.error('退出群聊失败:', error);\r\n          ElMessage.error('退出群聊失败');\r\n        }\r\n      }\r\n    };\r\n\r\n    const showAddMemberDialog = async () => {\r\n      await loadAllUsers();\r\n      showAddMember.value = true;\r\n      selectedUserIds.value.clear();\r\n      searchKeyword.value = '';\r\n    };\r\n\r\n    const closeAddMemberDialog = () => {\r\n      showAddMember.value = false;\r\n    };\r\n\r\n    const selectUser = (user) => {\r\n      if (selectedUserIds.value.has(user.id)) {\r\n        selectedUserIds.value.delete(user.id);\r\n      } else {\r\n        selectedUserIds.value.add(user.id);\r\n      }\r\n    };\r\n\r\n    const isUserSelected = (userId) => {\r\n      return selectedUserIds.value.has(userId);\r\n    };\r\n\r\n    const confirmAddMembers = async () => {\r\n      if (selectedUserIds.value.size === 0) {\r\n        ElMessage.warning('请选择要添加的成员');\r\n        return;\r\n      }\r\n\r\n      try {\r\n        const response = await axios.post(\r\n          `${API_CONFIG.BASE_URL}/group/add-members`,\r\n          {\r\n            group_id: props.groupInfo.group_id,\r\n            user_ids: Array.from(selectedUserIds.value)\r\n          },\r\n          { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n        );\r\n        \r\n        if (response.data.success) {\r\n          ElMessage.success('成员添加成功');\r\n          await loadGroupMembers();\r\n          await loadAllUsers();\r\n          closeAddMemberDialog();\r\n          emit('group-updated');\r\n        }\r\n      } catch (error) {\r\n        console.error('添加成员失败:', error);\r\n        ElMessage.error('添加成员失败');\r\n      }\r\n    };\r\n\r\n    watch(() => props.visible, async (newVisible) => {\r\n      if (newVisible && props.groupInfo.group_id) {\r\n        await loadGroupMembers();\r\n        \r\n        try {\r\n          const response = await axios.get(\r\n            `${API_CONFIG.BASE_URL}/group/${props.groupInfo.group_id}/mute-status?user_id=${currentUserId.value}`,\r\n            { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n          );\r\n          \r\n          if (response.data.success) {\r\n            isMuted.value = response.data.muted;\r\n          }\r\n        } catch (error) {\r\n          console.error('获取免打扰状态失败:', error);\r\n        }\r\n      }\r\n    });\r\n\r\n    onMounted(async () => {\r\n      if (props.visible && props.groupInfo.group_id) {\r\n        await loadGroupMembers();\r\n        \r\n        try {\r\n          const response = await axios.get(\r\n            `${API_CONFIG.BASE_URL}/group/${props.groupInfo.group_id}/mute-status?user_id=${currentUserId.value}`,\r\n            { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n          );\r\n          \r\n          if (response.data.success) {\r\n            isMuted.value = response.data.muted;\r\n          }\r\n        } catch (error) {\r\n          console.error('获取免打扰状态失败:', error);\r\n        }\r\n      }\r\n    });\r\n\r\n    return {\r\n      currentUserId,\r\n      groupMembers,\r\n      validGroupMembers,\r\n      currentUser,\r\n      isMuted,\r\n      showEditName,\r\n      editGroupName,\r\n      showAddMember,\r\n      searchKeyword,\r\n      filteredUsers,\r\n      isGroupOwner,\r\n      groupAvatarUrls,\r\n      getFullUrl,\r\n      getAvatarPosition,\r\n      getMemberAvatar,\r\n      getMemberRole,\r\n      getMemberName,\r\n      getMemberKey,\r\n      canRemoveMember,\r\n      close,\r\n      showEditNameDialog,\r\n      cancelEditName,\r\n      confirmEditName,\r\n      toggleMute,\r\n      removeMember,\r\n      exitGroup,\r\n      showAddMemberDialog,\r\n      closeAddMemberDialog,\r\n      selectUser,\r\n      isUserSelected,\r\n      confirmAddMembers\r\n    };\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* 原有的样式保持不变，只添加移除按钮样式 */\r\n.member-actions {\r\n  position: absolute;\r\n  bottom: -5px;\r\n  right: -5px;\r\n  width: 20px;\r\n  height: 20px;\r\n  border-radius: 50%;\r\n  background-color: #ff4d4f;\r\n  color: white;\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  font-size: 12px;\r\n  cursor: pointer;\r\n  opacity: 0;\r\n  transition: opacity 0.2s ease;\r\n}\r\n\r\n.member-item:hover .member-actions {\r\n  opacity: 1;\r\n}\r\n\r\n.member-actions:hover {\r\n  background-color: #d9363e;\r\n  transform: scale(1.1);\r\n}\r\n\r\n/* 其他原有样式保持不变 */\r\n.group-info-dialog {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100%;\r\n  height: 100%;\r\n  background-color: rgba(0, 0, 0, 0.5);\r\n  display: flex;\r\n  justify-content: center;\r\n  