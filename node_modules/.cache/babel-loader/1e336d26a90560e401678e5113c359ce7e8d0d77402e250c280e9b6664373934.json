{"ast":null,"code":"import { ref, computed, onMounted } from 'vue';\nimport axios from 'axios';\nimport { API_CONFIG } from './config';\n\n// 用户数据状态\n\nexport default {\n  __name: 'BigdataUser',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const users = ref([]);\n    const loading = ref(false);\n    const error = ref(null);\n\n    // 分页相关状态\n    const currentPage = ref(1);\n    const pageSize = ref(50);\n    const totalItems = ref(0);\n    const totalPages = computed(() => Math.ceil(totalItems.value / pageSize.value));\n\n    // 搜索条件\n    const searchQuery = ref({\n      name: '',\n      idno: '',\n      sex: ''\n    });\n\n    // 格式化生日显示\n    const formatBirthday = birthday => {\n      if (!birthday) return '未填写';\n      const dateStr = birthday.toString();\n      if (dateStr.length === 8) {\n        return `${dateStr.substring(0, 4)}-${dateStr.substring(4, 6)}-${dateStr.substring(6, 8)}`;\n      }\n      return new Date(birthday).toLocaleDateString();\n    };\n\n    // 获取用户数据\n    const fetchUserData = async () => {\n      try {\n        loading.value = true;\n        error.value = null;\n        const params = {\n          page: currentPage.value,\n          pageSize: pageSize.value,\n          ...searchQuery.value\n        };\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/bigdata/bigdata-users`, {\n          params\n        });\n        users.value = response.data.items || [];\n        console.log(\"users : \", users.value);\n        totalItems.value = response.data.total || 0;\n      } catch (err) {\n        console.error('获取用户数据失败:', err);\n        error.value = err.message || '获取用户数据失败';\n      } finally {\n        loading.value = false;\n      }\n    };\n\n    // 上一页\n    const prevPage = () => {\n      if (currentPage.value > 1) {\n        currentPage.value--;\n        fetchUserData();\n      }\n    };\n\n    // 下一页\n    const nextPage = () => {\n      if (currentPage.value < totalPages.value) {\n        currentPage.value++;\n        fetchUserData();\n      }\n    };\n\n    // 组件挂载时获取数据\n    onMounted(() => {\n      fetchUserData();\n    });\n    const __returned__ = {\n      users,\n      loading,\n      error,\n      currentPage,\n      pageSize,\n      totalItems,\n      totalPages,\n      searchQuery,\n      formatBirthday,\n      fetchUserData,\n      prevPage,\n      nextPage,\n      ref,\n      computed,\n      onMounted,\n      get axios() {\n        return axios;\n      },\n      get API_CONFIG() {\n        return API_CONFIG;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","computed","onMounted","axios","API_CONFIG","users","loading","error","currentPage","pageSize","totalItems","totalPages","Math","ceil","value","searchQuery","name","idno","sex","formatBirthday","birthday","dateStr","toString","length","substring","Date","toLocaleDateString","fetchUserData","params","page","response","get","BASE_URL","data","items","console","log","total","err","message","prevPage","nextPage"],"sources":["E:/vue_fastapi/my_vue/my_vue/src/views/BigdataUser.vue"],"sourcesContent":["<template>\r\n    <div class=\"user-list-container\">\r\n      <h2>大数据用户列表</h2>\r\n  \r\n      <!-- 查询框 -->\r\n      <div class=\"search-box\">\r\n        <input\r\n          v-model=\"searchQuery.name\"\r\n          placeholder=\"姓名\"\r\n          class=\"search-input\"\r\n        />\r\n        <input\r\n          v-model=\"searchQuery.idno\"\r\n          placeholder=\"证件号码\"\r\n          class=\"search-input\"\r\n        />\r\n        <select v-model=\"searchQuery.sex\" class=\"search-select\">\r\n          <option value=\"\">全部性别</option>\r\n          <option value=\"男\">男</option>\r\n          <option value=\"女\">女</option>\r\n          <option value=\"未知\">未知</option>\r\n        </select>\r\n        <button @click=\"fetchUserData\" class=\"search-button\">查询</button>\r\n      </div>\r\n  \r\n      <!-- 用户列表表格 -->\r\n      <table class=\"user-table\">\r\n        <thead>\r\n          <tr>\r\n            <th>ID</th>\r\n            <th>姓名</th>\r\n            <th>证件号码</th>\r\n            <th>性别</th>\r\n            <th>出生地</th>\r\n            <th>证件类型</th>\r\n            <th>省份</th>\r\n            <th>年龄</th>\r\n            <th>生日</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"user in users\" :key=\"user.id\">\r\n            <td>{{ user.id }}</td>\r\n            <td>{{ user.name || '未填写' }}</td>\r\n            <td>{{ user.idno || '未填写' }}</td>\r\n            <td>{{ user.sex || '未知' }}</td>\r\n            <td>{{ user.bplace || '未填写' }}</td>\r\n            <td>{{ user.idtype || '未填写' }}</td>\r\n            <td>{{ user.province || '未填写' }}</td>\r\n            <td>{{ user.age ?? '未填写' }}</td>\r\n            <td>{{ formatBirthday(user.birthday) }}</td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n  \r\n      <!-- 分页组件 -->\r\n      <div class=\"pagination\">\r\n        <button\r\n          @click=\"prevPage\"\r\n          :disabled=\"currentPage === 1\"\r\n          class=\"pagination-button\"\r\n        >\r\n          上一页\r\n        </button>\r\n        <span class=\"pagination-info\">\r\n          第 {{ currentPage }} 页 / 共 {{ totalPages }} 页 (共 {{ totalItems }} 条记录)\r\n        </span>\r\n        <button\r\n          @click=\"nextPage\"\r\n          :disabled=\"currentPage >= totalPages\"\r\n          class=\"pagination-button\"\r\n        >\r\n          下一页\r\n        </button>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script setup>\r\n  import { ref, computed, onMounted } from 'vue';\r\n  import axios from 'axios';\r\n  import { API_CONFIG } from './config';\r\n  \r\n  // 用户数据状态\r\n  const users = ref([]);\r\n  const loading = ref(false);\r\n  const error = ref(null);\r\n  \r\n  // 分页相关状态\r\n  const currentPage = ref(1);\r\n  const pageSize = ref(50);\r\n  const totalItems = ref(0);\r\n  const totalPages = computed(() => Math.ceil(totalItems.value / pageSize.value));\r\n  \r\n  // 搜索条件\r\n  const searchQuery = ref({\r\n    name: '',\r\n    idno: '',\r\n    sex: ''\r\n  });\r\n  \r\n  // 格式化生日显示\r\n  const formatBirthday = (birthday) => {\r\n    if (!birthday) return '未填写';\r\n    \r\n    const dateStr = birthday.toString();\r\n    if (dateStr.length === 8) {\r\n      return `${dateStr.substring(0,4)}-${dateStr.substring(4,6)}-${dateStr.substring(6,8)}`;\r\n    }\r\n    return new Date(birthday).toLocaleDateString();\r\n  };\r\n  \r\n  // 获取用户数据\r\n  const fetchUserData = async () => {\r\n    try {\r\n      loading.value = true;\r\n      error.value = null;\r\n      \r\n      const params = {\r\n        page: currentPage.value,\r\n        pageSize: pageSize.value,\r\n        ...searchQuery.value\r\n      };\r\n  \r\n      const response = await axios.get(`${API_CONFIG.BASE_URL}/bigdata/bigdata-users`, {\r\n        params\r\n      });\r\n      \r\n      users.value = response.data.items || [];\r\n      console.log(\"users : \", users.value)\r\n      totalItems.value = response.data.total || 0;\r\n    } catch (err) {\r\n      console.error('获取用户数据失败:', err);\r\n      error.value = err.message || '获取用户数据失败';\r\n    } finally {\r\n      loading.value = false;\r\n    }\r\n  };\r\n  \r\n  // 上一页\r\n  const prevPage = () => {\r\n    if (currentPage.value > 1) {\r\n      currentPage.value--;\r\n      fetchUserData();\r\n    }\r\n  };\r\n  \r\n  // 下一页\r\n  const nextPage = () => {\r\n    if (currentPage.value < totalPages.value) {\r\n      currentPage.value++;\r\n      fetchUserData();\r\n    }\r\n  };\r\n  \r\n  // 组件挂载时获取数据\r\n  onMounted(() => {\r\n    fetchUserData();\r\n  });\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .user-list-container {\r\n    max-width: 1200px;\r\n    margin: 0 auto;\r\n    padding: 20px;\r\n    font-family: 'Arial', sans-serif;\r\n  }\r\n  \r\n  h2 {\r\n    text-align: center;\r\n    color: #333;\r\n    margin-bottom: 20px;\r\n    font-size: 24px;\r\n  }\r\n  \r\n  .search-box {\r\n    display: flex;\r\n    gap: 10px;\r\n    margin-bottom: 20px;\r\n    padding: 15px;\r\n    background-color: #f5f5f5;\r\n    border-radius: 4px;\r\n  }\r\n  \r\n  .search-input {\r\n    flex: 1;\r\n    padding: 8px 12px;\r\n    border: 1px solid #ddd;\r\n    border-radius: 4px;\r\n    font-size: 14px;\r\n  }\r\n  \r\n  .search-select {\r\n    padding: 8px 12px;\r\n    border: 1px solid #ddd;\r\n    border-radius: 4px;\r\n    font-size: 14px;\r\n    min-width: 120px;\r\n  }\r\n  \r\n  .search-button {\r\n    padding: 8px 16px;\r\n    background-color: #1890ff;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 4px;\r\n    cursor: pointer;\r\n    font-size: 14px;\r\n  }\r\n  \r\n  .search-button:hover {\r\n    background-color: #40a9ff;\r\n  }\r\n  \r\n  .user-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    margin-bottom: 20px;\r\n  }\r\n  \r\n  .user-table th, .user-table td {\r\n    padding: 12px 15px;\r\n    text-align: left;\r\n    border-bottom: 1px solid #e8e8e8;\r\n  }\r\n  \r\n  .user-table th {\r\n    background-color: #fafafa;\r\n    font-weight: 500;\r\n    color: rgba(0, 0, 0, 0.85);\r\n  }\r\n  \r\n  .user-table tr:hover {\r\n    background-color: #f5f5f5;\r\n  }\r\n  \r\n  .pagination {\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    gap: 20px;\r\n    margin-top: 20px;\r\n  }\r\n  \r\n  .pagination-button {\r\n    padding: 6px 12px;\r\n    background-color: #fff;\r\n    border: 1px solid #d9d9d9;\r\n    border-radius: 4px;\r\n    cursor: pointer;\r\n    font-size: 14px;\r\n  }\r\n  \r\n  .pagination-button:disabled {\r\n    color: rgba(0, 0, 0, 0.25);\r\n    background-color: #f5f5f5;\r\n    cursor: not-allowed;\r\n  }\r\n  \r\n  .pagination-button:not(:disabled):hover {\r\n    color: #1890ff;\r\n    border-color: #1890ff;\r\n  }\r\n  \r\n  .pagination-info {\r\n    font-size: 14px;\r\n    color: rgba(0, 0, 0, 0.65);\r\n  }\r\n  \r\n  @media (max-width: 768px) {\r\n    .search-box {\r\n      flex-direction: column;\r\n    }\r\n    \r\n    .user-table {\r\n      display: block;\r\n      overflow-x: auto;\r\n    }\r\n  }\r\n  </style>"],"mappings":"AA+EE,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,QAAQ,KAAK;AAC9C,OAAOC,KAAK,MAAM,OAAO;AACzB,SAASC,UAAU,QAAQ,UAAU;;AAErC;;;;;;;;IACA,MAAMC,KAAK,GAAGL,GAAG,CAAC,EAAE,CAAC;IACrB,MAAMM,OAAO,GAAGN,GAAG,CAAC,KAAK,CAAC;IAC1B,MAAMO,KAAK,GAAGP,GAAG,CAAC,IAAI,CAAC;;IAEvB;IACA,MAAMQ,WAAW,GAAGR,GAAG,CAAC,CAAC,CAAC;IAC1B,MAAMS,QAAQ,GAAGT,GAAG,CAAC,EAAE,CAAC;IACxB,MAAMU,UAAU,GAAGV,GAAG,CAAC,CAAC,CAAC;IACzB,MAAMW,UAAU,GAAGV,QAAQ,CAAC,MAAMW,IAAI,CAACC,IAAI,CAACH,UAAU,CAACI,KAAK,GAAGL,QAAQ,CAACK,KAAK,CAAC,CAAC;;IAE/E;IACA,MAAMC,WAAW,GAAGf,GAAG,CAAC;MACtBgB,IAAI,EAAE,EAAE;MACRC,IAAI,EAAE,EAAE;MACRC,GAAG,EAAE;IACP,CAAC,CAAC;;IAEF;IACA,MAAMC,cAAc,GAAIC,QAAQ,IAAK;MACnC,IAAI,CAACA,QAAQ,EAAE,OAAO,KAAK;MAE3B,MAAMC,OAAO,GAAGD,QAAQ,CAACE,QAAQ,CAAC,CAAC;MACnC,IAAID,OAAO,CAACE,MAAM,KAAK,CAAC,EAAE;QACxB,OAAO,GAAGF,OAAO,CAACG,SAAS,CAAC,CAAC,EAAC,CAAC,CAAC,IAAIH,OAAO,CAACG,SAAS,CAAC,CAAC,EAAC,CAAC,CAAC,IAAIH,OAAO,CAACG,SAAS,CAAC,CAAC,EAAC,CAAC,CAAC,EAAE;MACxF;MACA,OAAO,IAAIC,IAAI,CAACL,QAAQ,CAAC,CAACM,kBAAkB,CAAC,CAAC;IAChD,CAAC;;IAED;IACA,MAAMC,aAAa,GAAG,MAAAA,CAAA,KAAY;MAChC,IAAI;QACFrB,OAAO,CAACQ,KAAK,GAAG,IAAI;QACpBP,KAAK,CAACO,KAAK,GAAG,IAAI;QAElB,MAAMc,MAAM,GAAG;UACbC,IAAI,EAAErB,WAAW,CAACM,KAAK;UACvBL,QAAQ,EAAEA,QAAQ,CAACK,KAAK;UACxB,GAAGC,WAAW,CAACD;QACjB,CAAC;QAED,MAAMgB,QAAQ,GAAG,MAAM3B,KAAK,CAAC4B,GAAG,CAAC,GAAG3B,UAAU,CAAC4B,QAAQ,wBAAwB,EAAE;UAC/EJ;QACF,CAAC,CAAC;QAEFvB,KAAK,CAACS,KAAK,GAAGgB,QAAQ,CAACG,IAAI,CAACC,KAAK,IAAI,EAAE;QACvCC,OAAO,CAACC,GAAG,CAAC,UAAU,EAAE/B,KAAK,CAACS,KAAK,CAAC;QACpCJ,UAAU,CAACI,KAAK,GAAGgB,QAAQ,CAACG,IAAI,CAACI,KAAK,IAAI,CAAC;MAC7C,CAAC,CAAC,OAAOC,GAAG,EAAE;QACZH,OAAO,CAAC5B,KAAK,CAAC,WAAW,EAAE+B,GAAG,CAAC;QAC/B/B,KAAK,CAACO,KAAK,GAAGwB,GAAG,CAACC,OAAO,IAAI,UAAU;MACzC,CAAC,SAAS;QACRjC,OAAO,CAACQ,KA