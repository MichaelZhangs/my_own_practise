{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { computed, ref } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nimport defaultAvatar from '@/assets/default-avatar.png';\nimport { API_CONFIG } from '@/config/config';\nimport axios from 'axios';\nimport { ElMessage } from 'element-plus';\nexport default {\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const isUserInfoOpen = ref(false);\n    const user = computed(() => store.state.user);\n    const displayName = computed(() => user.value?.username || '未登录');\n\n    // 搜索相关状态\n    const isSearchOpen = ref(false);\n    const searchKeyword = ref('');\n    const searchResults = ref([]);\n    const isSearching = ref(false);\n\n    // 最近聊天列表（从 Vuex 获取）\n    const recentChats = computed(() => store.getters['chat/getRecentChats']);\n\n    // 工具方法\n    const getFullUrl = path => {\n      if (!path || path === defaultAvatar) return path;\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`;\n    };\n    const avatarUrl = computed(() => {\n      if (user.value?.photo) {\n        return `${API_CONFIG.BASE_URL}${user.value.photo}`;\n      }\n      return defaultAvatar;\n    });\n    const logout = () => {\n      store.dispatch('logout');\n      router.push('/login');\n    };\n    const goToUserDetail = () => {\n      router.push('/user/userinfo/' + user.value?.id);\n    };\n    const toggleUserInfo = () => {\n      isUserInfoOpen.value = !isUserInfoOpen.value;\n    };\n\n    // 搜索相关方法\n    const toggleSearch = () => {\n      isSearchOpen.value = !isSearchOpen.value;\n\n      // 关闭搜索时清空结果\n      if (!isSearchOpen.value) {\n        searchKeyword.value = '';\n        searchResults.value = [];\n      }\n    };\n    const searchUsers = async () => {\n      if (!searchKeyword.value.trim()) {\n        ElMessage.warning('请输入搜索关键词');\n        return;\n      }\n      isSearching.value = true;\n      try {\n        // 调用搜索API\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/user/search`, {\n          params: {\n            keyword: searchKeyword.value.trim()\n          },\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        });\n        searchResults.value = response.data.data || [];\n        console.log(\"查找结果: \", searchResults.value);\n      } catch (error) {\n        console.error('搜索用户失败:', error);\n        ElMessage.error('搜索用户失败');\n      } finally {\n        isSearching.value = false;\n      }\n    };\n\n    // 开始聊天方法，跳转到聊天页面\n    const startChat = user => {\n      ElMessage.success(`开始与 ${user.username} 聊天`);\n\n      // 更新最近聊天列表\n      store.commit('chat/UPDATE_RECENT_CHATS', user);\n      // 保存到 localStorage\n      store.dispatch('chat/saveRecentChats');\n      isSearchOpen.value = false;\n      searchKeyword.value = '';\n      searchResults.value = [];\n\n      // 跳转到聊天页面，传递用户ID\n      router.push({\n        name: 'Chat',\n        params: {\n          userId: user.id\n        }\n      });\n    };\n    return {\n      user,\n      displayName,\n      avatarUrl,\n      getFullUrl,\n      logout,\n      goToUserDetail,\n      isUserInfoOpen,\n      toggleUserInfo,\n      isSearchOpen,\n      searchKeyword,\n      searchResults,\n      isSearching,\n      toggleSearch,\n      searchUsers,\n      startChat,\n      defaultAvatar,\n      API_CONFIG\n    };\n  }\n};","map":{"version":3,"names":["computed","ref","useStore","useRouter","defaultAvatar","API_CONFIG","axios","ElMessage","setup","store","router","isUserInfoOpen","user","state","displayName","value","username","isSearchOpen","searchKeyword","searchResults","isSearching","recentChats","getters","getFullUrl","path","startsWith","BASE_URL","avatarUrl","photo","logout","dispatch","push","goToUserDetail","id","toggleUserInfo","toggleSearch","searchUsers","trim","warning","response","get","params","keyword","headers","Authorization","token","data","console","log","error","startChat","success","commit","name","userId"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\views\\UserLayout.vue"],"sourcesContent":["<template>\r\n  <div class=\"user-page\">\r\n    <header class=\"header\">\r\n      <div class=\"header-left\">\r\n        <div class=\"user-info\" @click=\"goToUserDetail\">\r\n          <img :src=\"avatarUrl\" alt=\"用户头像\" class=\"avatar\" />\r\n          <span class=\"username\">{{ displayName }}</span>\r\n        </div>\r\n      </div>\r\n      \r\n      <div class=\"header-right\">\r\n        <button @click=\"logout\" class=\"logout-button\">退出登录</button>\r\n      </div>\r\n    </header>\r\n\r\n    <div class=\"main-layout\">\r\n      <aside class=\"sidebar\">\r\n        <!-- 搜索组件 -->\r\n        <div class=\"sidebar-search\">\r\n          <div class=\"search-toggle\" @click=\"toggleSearch\">\r\n            <i class=\"fa fa-search\" aria-hidden=\"true\"></i>\r\n            <span>搜索用户</span>\r\n          </div>\r\n          \r\n          <div v-if=\"isSearchOpen\" class=\"search-box\">\r\n            <div class=\"search-input-group\">\r\n              <input \r\n                type=\"text\" \r\n                v-model=\"searchKeyword\" \r\n                placeholder=\"搜索用户...\" \r\n                @keyup.enter=\"searchUsers\"\r\n              />\r\n              <button class=\"search-button\" @click=\"searchUsers\">\r\n                <i class=\"fa fa-search\" aria-hidden=\"true\"></i>\r\n              </button>\r\n              <button class=\"cancel-button\" @click=\"toggleSearch\">\r\n                取消\r\n              </button>\r\n            </div>\r\n            \r\n            <!-- 搜索结果列表 -->\r\n            <div v-if=\"isSearching\" class=\"search-loading\">\r\n              <i class=\"fa fa-spinner fa-spin\" aria-hidden=\"true\"></i> 搜索中...\r\n            </div>\r\n            \r\n            <div v-else-if=\"searchResults.length > 0\" class=\"search-results\">\r\n              <div \r\n                v-for=\"user in searchResults\" \r\n                :key=\"user.id\" \r\n                class=\"search-result-item\"\r\n                @click=\"startChat(user)\"\r\n              >\r\n                <div class=\"result-avatar-container\">\r\n                  <img \r\n                    :src=\"getFullUrl(user.photo)|| defaultAvatar\" \r\n                    alt=\"用户头像\" \r\n                    class=\"result-avatar\"\r\n                  />\r\n                </div>\r\n                <div class=\"result-info\">\r\n                  <div class=\"result-name\">{{ user.username }}</div>\r\n                  <div class=\"result-phone\">{{ user.phone }}</div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            \r\n            <div v-else-if=\"searchKeyword && !isSearching\" class=\"no-results\">\r\n              没有找到匹配的用户\r\n            </div>\r\n          </div>\r\n        </div>\r\n              <!-- 最近聊天列表 -->\r\n      <div class=\"recent-chats\">\r\n        <div class=\"recent-chats-title\">最近聊天</div>\r\n        <div\r\n          v-for=\"(user, index) in recentChats\"\r\n          :key=\"index\"\r\n          class=\"recent-chat-item\"\r\n          @click=\"startChat(user)\"\r\n        >\r\n          <div class=\"result-avatar-container\">\r\n            <img\r\n              :src=\"getFullUrl(user.photo) || defaultAvatar\"\r\n              alt=\"用户头像\"\r\n              class=\"result-avatar\"\r\n            />\r\n          </div>\r\n          <div class=\"result-info\">\r\n            <div class=\"result-name\">{{ user.username }}</div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n        <!-- 菜单保持不变 -->\r\n        <ul class=\"menu\">\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/user/dashboard\" class=\"menu-link\">仪表盘</router-link>\r\n          </li>\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/user-moment\" class=\"menu-link\">我相关</router-link>\r\n          </li>\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/moments\" class=\"menu-link\">朋友圈</router-link>\r\n          </li>\r\n          <li class=\"menu-item\">\r\n            <div @click=\"toggleUserInfo\" class=\"menu-title\">\r\n              用户信息\r\n              <span class=\"arrow\">{{ isUserInfoOpen ? '▼' : '▶' }}</span>\r\n            </div>\r\n            <ul v-if=\"isUserInfoOpen\" class=\"sub-menu\">\r\n              <li class=\"sub-menu-item\">\r\n                <router-link to=\"/user/userinfo/userlist\" class=\"sub-menu-link\">用户列表</router-link>\r\n              </li>\r\n              <li class=\"sub-menu-item2\">\r\n                <router-link to=\"/user/bigdatauser\" class=\"sub-menu-link\">大数据用户</router-link>\r\n              </li>\r\n            </ul>\r\n          </li>\r\n        </ul>\r\n      </aside>\r\n\r\n      <main class=\"main-content\">\r\n        <router-view />\r\n      </main>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { computed, ref } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { useRouter } from 'vue-router';\r\nimport defaultAvatar from '@/assets/default-avatar.png';\r\nimport { API_CONFIG } from '@/config/config';\r\nimport axios from 'axios';\r\nimport { ElMessage } from 'element-plus';\r\n\r\nexport default {\r\n  setup() {\r\n    const store = useStore();\r\n    const router = useRouter();\r\n    const isUserInfoOpen = ref(false);\r\n    const user = computed(() => store.state.user);\r\n    const displayName = computed(() => user.value?.username || '未登录');\r\n    \r\n    // 搜索相关状态\r\n    const isSearchOpen = ref(false);\r\n    const searchKeyword = ref('');\r\n    const searchResults = ref([]);\r\n    const isSearching = ref(false);\r\n    \r\n        // 最近聊天列表（从 Vuex 获取）\r\n    const recentChats = computed(() => store.getters['chat/getRecentChats']);\r\n\r\n        // 工具方法\r\n    const getFullUrl = (path) => {\r\n      if (!path || path === defaultAvatar) return path\r\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`\r\n    }\r\n\r\n    const avatarUrl = computed(() => {\r\n      if (user.value?.photo) {\r\n        return `${API_CONFIG.BASE_URL}${user.value.photo}`;\r\n      }\r\n      return defaultAvatar;\r\n    });\r\n\r\n    const logout = () => {\r\n      store.dispatch('logout');\r\n      router.push('/login');\r\n    };\r\n\r\n    const goToUserDetail = () => {\r\n      router.push('/user/userinfo/' + user.value?.id);\r\n    };\r\n\r\n    const toggleUserInfo = () => {\r\n      isUserInfoOpen.value = !isUserInfoOpen.value;\r\n    };\r\n    \r\n    // 搜索相关方法\r\n    const toggleSearch = () => {\r\n      isSearchOpen.value = !isSearchOpen.value;\r\n      \r\n      // 关闭搜索时清空结果\r\n      if (!isSearchOpen.value) {\r\n        searchKeyword.value = '';\r\n        searchResults.value = [];\r\n      }\r\n    };\r\n    \r\n    const searchUsers = async () => {\r\n      if (!searchKeyword.value.trim()) {\r\n        ElMessage.warning('请输入搜索关键词');\r\n        return;\r\n      }\r\n      \r\n      isSearching.value = true;\r\n      \r\n      try {\r\n        // 调用搜索API\r\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/user/search`, {\r\n          params: {\r\n            keyword: searchKeyword.value.trim()\r\n          },\r\n          headers: { Authorization: `Bearer ${store.state.token}` }\r\n        });\r\n        \r\n        searchResults.value = response.data.data || [];\r\n        console.log(\"查找结果: \", searchResults.value)\r\n\r\n          \r\n      } catch (error) {\r\n        console.error('搜索用户失败:', error);\r\n        ElMessage.error('搜索用户失败');\r\n      } finally {\r\n        isSearching.value = false;\r\n      }\r\n    };\r\n    \r\n    // 开始聊天方法，跳转到聊天页面\r\nconst startChat = (user) => {\r\n  ElMessage.success(`开始与 ${user.username} 聊天`);\r\n\r\n  // 更新最近聊天列表\r\n  store.commit('chat/UPDATE_RECENT_CHATS', user);\r\n  // 保存到 localStorage\r\n  store.dispatch('chat/saveRecentChats');\r\n\r\n  isSearchOpen.value = false;\r\n  searchKeyword.value = '';\r\n  searchResults.value = [];\r\n\r\n  // 跳转到聊天页面，传递用户ID\r\n  router.push({\r\n    name: 'Chat',\r\n    params: { userId: user.id },\r\n  });\r\n};\r\n\r\n    return {\r\n      user,\r\n      displayName,\r\n      avatarUrl,\r\n      getFullUrl,\r\n      logout,\r\n      goToUserDetail,\r\n      isUserInfoOpen,\r\n      toggleUserInfo,\r\n      isSearchOpen,\r\n      searchKeyword,\r\n      searchResults,\r\n      isSearching,\r\n      toggleSearch,\r\n      searchUsers,\r\n      startChat,\r\n      defaultAvatar,\r\n      API_CONFIG\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n\r\n/* 新增最近聊天列表样式 */\r\n.recent-chats {\r\n  padding: 15px 20px;\r\n  border-bottom: 1px solid #002140;\r\n}\r\n\r\n.recent-chats-title {\r\n  font-size: 14px;\r\n  font-weight: bold;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.recent-chat-item {\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 10px 0;\r\n  cursor: pointer;\r\n}\r\n\r\n.recent-chat-item:hover {\r\n  background-color: #003a75;\r\n}\r\n\r\n.result-avatar {\r\n  width: 32px;\r\n  height: 32px;\r\n  border-radius: 50%;\r\n  margin-right: 10px;\r\n}\r\n\r\n.result-name {\r\n  font-size: 14px;\r\n}\r\n\r\n/* 与原UserPage.vue样式一致，新增搜索相关样式 */\r\n.user-page {\r\n  display: flex;\r\n  flex-direction: column;\r\n  height: 100vh;\r\n  background-color: #f0f2f5;\r\n}\r\n\r\n.header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  padding: 0 20px;\r\n  height: 60px;\r\n  background-color: #001529;\r\n  color: white;\r\n}\r\n\r\n.header-left {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.user-info {\r\n  display: flex;\r\n  align-items: center;\r\n  cursor: pointer;\r\n}\r\n\r\n.avatar {\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 50%;\r\n  margin-right: 10px;\r\n}\r\n\r\n.username {\r\n  margin-right: 20px;\r\n  font-size: 16px;\r\n}\r\n\r\n.logout-button {\r\n  padding: 5px 1