{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/web.url-search-params.delete.js\";\nimport \"core-js/modules/web.url-search-params.has.js\";\nimport \"core-js/modules/web.url-search-params.size.js\";\nimport { ref } from 'vue';\nimport axios from 'axios';\nimport { ElMessage } from 'element-plus';\nimport { Upload, Close, Refresh } from '@element-plus/icons-vue';\nimport { API_CONFIG } from '@/config/config';\nexport default {\n  name: 'MediaUploader',\n  components: {\n    Upload,\n    Close,\n    Refresh\n  },\n  props: {\n    // 允许的最大文件大小 (MB)\n    maxSize: {\n      type: Number,\n      default: 20\n    },\n    // 允许的最大文件数量\n    maxFiles: {\n      type: Number,\n      default: 9\n    }\n  },\n  emits: ['upload-success', 'upload-error', 'file-removed'],\n  setup(props, {\n    emit\n  }) {\n    // 上传相关\n    const fileInput = ref(null);\n    const mediaFiles = ref([]);\n    const dragOver = ref(false);\n    const uploadProgress = ref(0);\n    const uploadStatus = ref('');\n\n    // 文件处理\n    const triggerFileInput = () => {\n      fileInput.value.click();\n    };\n    const handleFileSelect = async e => {\n      const files = Array.from(e.target.files);\n      await processFiles(files);\n      e.target.value = ''; // 重置input\n    };\n    const handleDrop = async e => {\n      dragOver.value = false;\n      const files = Array.from(e.dataTransfer.files);\n      await processFiles(files);\n    };\n    const processFiles = async files => {\n      for (const file of files) {\n        // 验证文件类型和大小\n        if (!file.type.startsWith('image/') && !file.type.startsWith('video/')) {\n          ElMessage.warning(`文件 ${file.name} 不是支持的图片或视频类型`);\n          continue;\n        }\n        if (file.size > props.maxSize * 1024 * 1024) {\n          ElMessage.warning(`文件 ${file.name} 超过${props.maxSize}MB大小限制`);\n          continue;\n        }\n\n        // 验证文件数量\n        if (mediaFiles.value.length >= props.maxFiles) {\n          ElMessage.warning(`最多只能上传 ${props.maxFiles} 个文件`);\n          continue;\n        }\n\n        // 生成预览URL\n        const previewUrl = URL.createObjectURL(file);\n        const fileType = file.type.split('/')[0];\n\n        // 添加到媒体文件列表\n        const fileId = Date.now() + Math.random().toString(36).substr(2, 9);\n        const fileObj = {\n          id: fileId,\n          raw: file,\n          previewUrl,\n          type: fileType,\n          name: file.name,\n          size: file.size,\n          status: 'pending',\n          progress: 0,\n          serverUrl: null\n        };\n        mediaFiles.value.push(fileObj);\n\n        // 开始上传\n        await uploadFile(fileId);\n      }\n    };\n    const uploadFile = async fileId => {\n      const fileIndex = mediaFiles.value.findIndex(f => f.id === fileId);\n      if (fileIndex === -1) return;\n      const fileObj = mediaFiles.value[fileIndex];\n      fileObj.status = 'uploading';\n      try {\n        const formData = new FormData();\n        formData.append('file', fileObj.raw);\n        const response = await axios.post(`${API_CONFIG.BASE_URL}/article/upload/media`, formData, {\n          headers: {\n            'Content-Type': 'multipart/form-data'\n          },\n          onUploadProgress: progressEvent => {\n            const progress = Math.round(progressEvent.loaded * 100 / progressEvent.total);\n            fileObj.progress = progress;\n            uploadProgress.value = progress;\n          }\n        });\n        fileObj.status = 'success';\n        fileObj.serverUrl = response.data.url;\n        uploadStatus.value = 'success';\n\n        // 通知父组件上传成功\n        emit('upload-success', {\n          id: fileId,\n          url: response.data.url,\n          type: fileObj.type\n        });\n      } catch (error) {\n        console.error('上传失败:', error);\n        fileObj.status = 'error';\n        uploadStatus.value = 'exception';\n        ElMessage.error(`上传 ${fileObj.name} 失败: ${error.message}`);\n\n        // 通知父组件上传失败\n        emit('upload-error', {\n          id: fileId,\n          error: error.message\n        });\n      }\n    };\n    const retryUpload = index => {\n      const fileId = mediaFiles.value[index].id;\n      mediaFiles.value[index].status = 'pending';\n      uploadFile(fileId);\n    };\n    const removeFile = index => {\n      const file = mediaFiles.value[index];\n      URL.revokeObjectURL(file.previewUrl);\n      const removedFile = mediaFiles.value.splice(index, 1)[0];\n      if (mediaFiles.value.length === 0) {\n        uploadProgress.value = 0;\n        uploadStatus.value = '';\n      }\n\n      // 通知父组件文件已移除\n      emit('file-removed', removedFile);\n    };\n    const formatFileSize = bytes => {\n      if (bytes === 0) return '0 Bytes';\n      const k = 1024;\n      const sizes = ['Bytes', 'KB', 'MB', 'GB'];\n      const i = Math.floor(Math.log(bytes) / Math.log(k));\n      return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];\n    };\n    return {\n      fileInput,\n      mediaFiles,\n      dragOver,\n      uploadProgress,\n      uploadStatus,\n      triggerFileInput,\n      handleFileSelect,\n      handleDrop,\n      removeFile,\n      retryUpload,\n      formatFileSize\n    };\n  }\n};","map":{"version":3,"names":["ref","axios","ElMessage","Upload","Close","Refresh","API_CONFIG","name","components","props","maxSize","type","Number","default","maxFiles","emits","setup","emit","fileInput","mediaFiles","dragOver","uploadProgress","uploadStatus","triggerFileInput","value","click","handleFileSelect","e","files","Array","from","target","processFiles","handleDrop","dataTransfer","file","startsWith","warning","size","length","previewUrl","URL","createObjectURL","fileType","split","fileId","Date","now","Math","random","toString","substr","fileObj","id","raw","status","progress","serverUrl","push","uploadFile","fileIndex","findIndex","f","formData","FormData","append","response","post","BASE_URL","headers","onUploadProgress","progressEvent","round","loaded","total","data","url","error","console","message","retryUpload","index","removeFile","revokeObjectURL","removedFile","splice","formatFileSize","bytes","k","sizes","i","floor","log","parseFloat","pow","toFixed"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\article\\MediaUploader.vue"],"sourcesContent":["<!-- components/MediaUploader.vue -->\r\n<template>\r\n    <div class=\"media-upload-container\">\r\n      <!-- 上传区域 -->\r\n      <div class=\"upload-section\">\r\n        <input \r\n          type=\"file\" \r\n          ref=\"fileInput\" \r\n          accept=\"image/*,video/*\" \r\n          style=\"display: none\" \r\n          @change=\"handleFileSelect\"\r\n          multiple\r\n          aria-label=\"选择文件上传\"\r\n        >\r\n        <div \r\n          class=\"upload-card\" \r\n          @click=\"triggerFileInput\"\r\n          @dragover.prevent=\"dragOver = true\"\r\n          @dragleave=\"dragOver = false\"\r\n          @drop.prevent=\"handleDrop\"\r\n          :class=\"{ 'drag-over': dragOver }\"\r\n        >\r\n          <el-icon class=\"upload-icon\"><Upload /></el-icon>\r\n          <div class=\"upload-text\">\r\n            <p>点击或拖拽文件到此处</p>\r\n            <p class=\"hint-text\">支持图片和视频 (最大 20MB)</p>\r\n          </div>\r\n        </div>\r\n        \r\n        <!-- 上传进度 -->\r\n        <div v-if=\"uploadProgress > 0\" class=\"upload-progress\">\r\n          <el-progress \r\n            :percentage=\"uploadProgress\" \r\n            :stroke-width=\"12\"\r\n            :status=\"uploadStatus\"\r\n          />\r\n          <span class=\"progress-text\">\r\n            {{ uploadStatus === 'success' ? '上传完成' : \r\n               uploadStatus === 'exception' ? '上传失败' : \r\n               `上传中 ${uploadProgress}%` }}\r\n          </span>\r\n        </div>\r\n        \r\n        <!-- 预览区域 -->\r\n        <div class=\"media-preview-grid\">\r\n          <div \r\n            v-for=\"(file, index) in mediaFiles\" \r\n            :key=\"file.id\"\r\n            class=\"media-preview-item\"\r\n            :class=\"[`media-${file.type}`, { 'upload-failed': file.status === 'error' }]\"\r\n          >\r\n            <div class=\"media-content\">\r\n              <img \r\n                v-if=\"file.type === 'image'\" \r\n                :src=\"file.previewUrl\" \r\n                alt=\"预览图\"\r\n              />\r\n              <video \r\n                v-else \r\n                :src=\"file.previewUrl\"\r\n                controls\r\n                muted\r\n              ></video>\r\n            </div>\r\n            \r\n            <div class=\"media-info\">\r\n              <span class=\"file-name\">{{ file.name }}</span>\r\n              <span class=\"file-size\">{{ formatFileSize(file.size) }}</span>\r\n            </div>\r\n            \r\n            <div class=\"media-actions\">\r\n              <el-icon \r\n                v-if=\"file.status === 'error'\" \r\n                class=\"retry-icon\"\r\n                @click=\"retryUpload(index)\"\r\n              ><Refresh /></el-icon>\r\n              \r\n              <el-icon \r\n                class=\"remove-icon\"\r\n                @click=\"removeFile(index)\"\r\n              ><Close /></el-icon>\r\n            </div>\r\n            \r\n            <div v-if=\"file.status === 'uploading'\" class=\"upload-progress-bar\">\r\n              <div \r\n                class=\"progress-fill\" \r\n                :style=\"{ width: `${file.progress}%` }\"\r\n              ></div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import { ref} from 'vue'\r\n  import axios from 'axios'\r\n  import { ElMessage } from 'element-plus'\r\n  import { Upload, Close, Refresh } from '@element-plus/icons-vue'\r\n  import { API_CONFIG } from '@/config/config'\r\n  \r\n  export default {\r\n    name: 'MediaUploader',\r\n    components: {\r\n      Upload,\r\n      Close,\r\n      Refresh\r\n    },\r\n    props: {\r\n      // 允许的最大文件大小 (MB)\r\n      maxSize: {\r\n        type: Number,\r\n        default: 20\r\n      },\r\n      // 允许的最大文件数量\r\n      maxFiles: {\r\n        type: Number,\r\n        default: 9\r\n      }\r\n    },\r\n    emits: ['upload-success', 'upload-error', 'file-removed'],\r\n    setup(props, { emit }) {\r\n      // 上传相关\r\n      const fileInput = ref(null)\r\n      const mediaFiles = ref([])\r\n      const dragOver = ref(false)\r\n      const uploadProgress = ref(0)\r\n      const uploadStatus = ref('')\r\n      \r\n      // 文件处理\r\n      const triggerFileInput = () => {\r\n        fileInput.value.click()\r\n      }\r\n      \r\n      const handleFileSelect = async (e) => {\r\n        const files = Array.from(e.target.files)\r\n        await processFiles(files)\r\n        e.target.value = '' // 重置input\r\n      }\r\n      \r\n      const handleDrop = async (e) => {\r\n        dragOver.value = false\r\n        const files = Array.from(e.dataTransfer.files)\r\n        await processFiles(files)\r\n      }\r\n      \r\n      const processFiles = async (files) => {\r\n        for (const file of files) {\r\n          // 验证文件类型和大小\r\n          if (!file.type.startsWith('image/') && !file.type.startsWith('video/')) {\r\n            ElMessage.warning(`文件 ${file.name} 不是支持的图片或视频类型`)\r\n            continue\r\n          }\r\n          \r\n          if (file.size > props.maxSize * 1024 * 1024) { \r\n            ElMessage.warning(`文件 ${file.name} 超过${props.maxSize}MB大小限制`)\r\n            continue\r\n          }\r\n          \r\n          // 验证文件数量\r\n          if (mediaFiles.value.length >= props.maxFiles) {\r\n            ElMessage.warning(`最多只能上传 ${props.maxFiles} 个文件`)\r\n            continue\r\n          }\r\n          \r\n          // 生成预览URL\r\n          const previewUrl = URL.createObjectURL(file)\r\n          const fileType = file.type.split('/')[0]\r\n          \r\n          // 添加到媒体文件列表\r\n          const fileId = Date.now() + Math.random().toString(36).substr(2, 9)\r\n          const fileObj = {\r\n            id: fileId,\r\n            raw: file,\r\n            previewUrl,\r\n            type: fileType,\r\n            name: file.name,\r\n            size: file.size,\r\n            status: 'pending',\r\n            progress: 0,\r\n            serverUrl: null\r\n          }\r\n          \r\n          mediaFiles.value.push(fileObj)\r\n          \r\n          // 开始上传\r\n          await uploadFile(fileId)\r\n        }\r\n      }\r\n      \r\n      const uploadFile = async (fileId) => {\r\n        const fileIndex = mediaFiles.value.findIndex(f => f.id === fileId)\r\n        if (fileIndex === -1) return\r\n        \r\n        const fileObj = mediaFiles.value[fileIndex]\r\n        fileObj.status = 'uploading'\r\n        \r\n        try {\r\n          const formData = new FormData()\r\n          formData.append('file', fileObj.raw)\r\n          \r\n          const response = await axios.post(`${API_CONFIG.BASE_URL}/article/upload/media`, formData, {\r\n            headers: {\r\n              'Content-Type': 'multipart/form-data'\r\n            },\r\n            onUploadProgress: (progressEvent) => {\r\n              const progress = Math.round(\r\n                (progressEvent.loaded * 100) / progressEvent.total\r\n              )\r\n              fileObj.progress = progress\r\n              uploadProgress.value = progress\r\n            }\r\n          })\r\n          \r\n          fileObj.status = 'success'\r\n          fileObj.serverUrl = response.data.url\r\n          uploadStatus.value = 'success'\r\n          \r\n          // 通知父组件上传成功\r\n          emit('upload-success', {\r\n            id: fileId,\r\n            url: response.data.url,\r\n            type: fileObj.type\r\n          })\r\n          \r\n        } catch (error) {\r\n          console.error('上传失败:', error)\r\n          fileObj.status = 'error'\r\n          uploadStatus.value = 'exception'\r\n          ElMessage.error(`上传 ${fileObj.name} 失败: ${error.message}`)\r\n          \r\n          // 通知父组件上传失败\r\n          emit('upload-error', {\r\n            id: fileId,\r\n            error: error.message\r\n          })\r\n        }\r\n      }\r\n      \r\n      const retryUpload = (index) => {\r\n        const fileId = mediaFiles.value[index].id\r\n        mediaFiles.value[index].status = 'pending'\r\n        uploadFile(fileId)\r\n      }\r\n      \r\n      const removeFile = (index) => {\r\n        const file = mediaFiles.value[index]\r\n        URL.revokeObjectURL(file.previewUrl)\r\n        const removedFile = mediaFiles.value.splice(index, 1)[0]\r\n        \r\n        if (mediaFiles.value.length === 0) {\r\n          uploadProgress.value = 0\r\n          uploadStatus.value = ''\r\n        }\r\n        \r\n        // 通知父组件文件已移除\r\n        emit('file-removed', removedFile)\r\n      }\r\n      \r\n      const formatFileSize = (bytes) => {\r\n        if (bytes === 0) return '0 Bytes'\r\n        const k = 1024\r\n        const sizes = ['Bytes', 'KB', 'MB', 'GB']\r\n        const i = Math.floor(Math.log(bytes) / Math.log(k))\r\n        return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i]\r\n      }\r\n      \r\n      return {\r\n        fileInput,\r\n        mediaFiles,\r\n        dragOver,\r\n        uploadProgress,\r\n        uploadStatus,\r\n        triggerFileInput,\r\n        handleFileSelect,\r\n        handleDrop,\r\n        removeFile,\r\n        retryUpload,\r\n        formatFileSize\r\n      }\r\n    }\r\n  }\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .upload-section {\r\n    margin-top: 20px;\r\n  }\r\n  \r\n  .upload-card {\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center;\r\n    justify-content: center;\r\n    padding: 30px;\r\n    border: 2px dashed #dcdfe6;\r\n    border-radius: 8px;\r\n    background-color: #f8f9fa;\r\n    cursor: pointer;\r\n    transition: all 0.3s;\r\n  }\r\n  \r\n  .upload-card.drag-over {\r\n    border-color: #409eff;\r\n    