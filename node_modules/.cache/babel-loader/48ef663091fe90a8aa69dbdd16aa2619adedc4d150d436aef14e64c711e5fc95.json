ription\" placeholder=\"未设置\"></textarea>\r\n          </div>\r\n  \r\n          <!-- 保存按钮 -->\r\n          <button @click=\"saveUserInfo\" class=\"save-button\">保存信息</button>\r\n  \r\n          <!-- 二维码 -->\r\n          <div class=\"qr-code-section\">\r\n            <h2 @click=\"generateQrcode\">我的二维码</h2>\r\n            <div class=\"qr-code-container\">\r\n              <img :src=\"qrcodeUrl || defaultqrcode\" alt=\"我的二维码\" class=\"qr-code\" />\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import { computed, ref } from 'vue';\r\n  import { useStore } from 'vuex';\r\n  import defaultAvatar from '@/assets/default-avatar.png';\r\n  import defaultqrcode from '@/assets/logo.png';\r\n  import QRCode from 'qrcode';\r\n  \r\n  export default {\r\n    name: 'UserDetail',\r\n    setup() {\r\n      const store = useStore();\r\n  \r\n      // 从 Vuex 中获取用户信息\r\n      const user = computed(() => store.state.user);\r\n  \r\n      // 可编辑的用户信息\r\n      const editableUser = ref({ ...user.value });\r\n  \r\n      // 二维码 URL\r\n      const qrcodeUrl = ref('');\r\n  \r\n      // 生成二维码\r\n      const generateQrcode = async () => {\r\n        try {\r\n          const content = `用户名: ${editableUser.value.username}\\n手机号: ${editableUser.value.phone}`;\r\n  \r\n          // 生成二维码\r\n          const qrCanvas = document.createElement('canvas');\r\n          await QRCode.toCanvas(qrCanvas, content, {\r\n            errorCorrectionLevel: 'H', // 高容错率\r\n            width: 200, // 二维码大小\r\n            color: {\r\n              dark: '#07c160', // 二维码颜色（微信绿）\r\n              light: '#ffffff', // 背景颜色\r\n            },\r\n          });\r\n  \r\n          // 创建头像 canvas\r\n          const avatarCanvas = document.createElement('canvas');\r\n          const avatarCtx = avatarCanvas.getContext('2d');\r\n          const avatarImg = new Image();\r\n          avatarImg.src = user.value.photo || defaultAvatar;\r\n  \r\n          // 等待头像加载完成\r\n          await new Promise((resolve) => {\r\n            avatarImg.onload = resolve;\r\n          });\r\n  \r\n          // 设置头像 canvas 大小\r\n          avatarCanvas.width = 40; // 头像大小\r\n          avatarCanvas.height = 40;\r\n          avatarCtx.drawImage(avatarImg, 0, 0, 40, 40);\r\n  \r\n          // 将头像绘制到二维码中心\r\n          const qrCtx = qrCanvas.getContext('2d');\r\n          const center = (qrCanvas.width - 40) / 2;\r\n          qrCtx.drawImage(avatarCanvas, center, center);\r\n  \r\n          // 将 canvas 转换为 URL\r\n          qrcodeUrl.value = qrCanvas.toDataURL();\r\n        } catch (error) {\r\n          console.error(\"生成二维码失败\", error);\r\n        }\r\n      };\r\n  \r\n      // 保存用户信息\r\n      const saveUserInfo = async () => {\r\n        try {\r\n          // 更新 Vuex 中的用户信息\r\n          await store.dispatch('updateUser', editableUser.value);\r\n          alert(\"用户信息保存成功\");\r\n        } catch (error) {\r\n          console.error(\"保存用户信息失败\", error);\r\n          alert(\"保存用户信息失败\");\r\n        }\r\n      };\r\n  \r\n      return {\r\n        user,\r\n        editableUser,\r\n        defaultAvatar,\r\n        defaultqrcode,\r\n        qrcodeUrl,\r\n        generateQrcode,\r\n        saveUserInfo,\r\n      };\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .user-detail-page {\r\n    padding: 20px;\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center; /* 整体内容居中 */\r\n  }\r\n  \r\n  h1 {\r\n    font-size: 24px;\r\n    margin-bottom: 20px;\r\n    text-align: center;\r\n  }\r\n  \r\n  .user-detail-container {\r\n    max-width: 800px; /* 限制容器宽度 */\r\n    width: 100%;\r\n    display: flex;\r\n    justify-content: center; /* 内容居中 */\r\n  }\r\n  \r\n  .info-section {\r\n    width: 100%;\r\n    max-width: 500px; /* 限制信息区域宽度 */\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center; /* 内容居中 */\r\n    gap: 15px; /* 信息项间距 */\r\n  }\r\n  \r\n  .avatar-section {\r\n    display: flex;\r\n    justify-content: center;\r\n    width: 100%;\r\n    margin-bottom: 20px;\r\n  }\r\n  \r\n  .avatar {\r\n    width: 100px;\r\n    height: 100px;\r\n    border-radius: 50%;\r\n  }\r\n  \r\n  .info-item {\r\n    display: flex;\r\n    align-items: center;\r\n    width: 100%;\r\n  }\r\n  \r\n  .info-item label {\r\n    font-weight: bold;\r\n    width: 80px;\r\n    text-align: right; /* 标签右对齐 */\r\n    margin-right: 10px;\r\n  }\r\n  \r\n  .info-item input,\r\n  .info-item textarea {\r\n    flex: 1;\r\n    padding: 5px;\r\n    border: 1px solid #ccc;\r\n    border-radius: 4px;\r\n  }\r\n  \r\n  .info-item textarea {\r\n    height: 80px;\r\n    resize: vertical;\r\n  }\r\n  \r\n  .save-button {\r\n    padding: 10px 20px;\r\n    background-color: #1890ff;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 4px;\r\n    cursor: pointer;\r\n    margin-top: 20px;\r\n  }\r\n  \r\n  .save-button:hover {\r\n    background-color: #40a9ff;\r\n  }\r\n  \r\n  .qr-code-section {\r\n    width: 100%;\r\n    display: flex;\r\n    flex-direction: column;\r\n    align-items: center; /* 内容居中 */\r\n    margin-top: 20px;\r\n  }\r\n  \r\n  .qr-code-section h2 {\r\n    cursor: pointer; /* 点击区域 */\r\n    color: #1890ff;\r\n    margin-bottom: 10px;\r\n  }\r\n  \r\n  .qr-code-section h2:hover {\r\n    text-decoration: underline;\r\n  }\r\n  \r\n  .qr-code-container {\r\n    display: flex;\r\n    justify-content: center; /* 内容居中 */\r\n    align-items: center;\r\n  }\r\n  \r\n  .qr-code {\r\n    width: 200px; /* 二维码大小 */\r\n    height: 200px;\r\n    border: 5px solid #07c160; /* 微信二维码样式 */\r\n    border-radius: 10px;\r\n  }\r\n  </style>"],"mappings":";;EACSA,KAAK,EAAC;AAAkB;;EAEtBA,KAAK,EAAC;AAAuB;;EAE3BA,KAAK,EAAC;AAAc;;EAElBA,KAAK,EAAC;AAAgB;mBAPrC;;EAYeA,KAAK,EAAC;AAAW;;EAIjBA,KAAK,EAAC;AAAW;;EAIjBA,KAAK,EAAC;AAAW;;EAIjBA,KAAK,EAAC;AAAW;;EAIjBA,KAAK,EAAC;AAAW;;EASjBA,KAAK,EAAC;AAAiB;;EAErBA,KAAK,EAAC;AAAmB;oBAvC1C;;uBACIC,mBAAA,CA4CM,OA5CNC,UA4CM,G,4BA3CJC,mBAAA,CAAa,Y