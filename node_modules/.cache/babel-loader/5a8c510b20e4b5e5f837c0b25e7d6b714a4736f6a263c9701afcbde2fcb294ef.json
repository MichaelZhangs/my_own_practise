{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport axios from 'axios';\nimport defaultAvatar from '@/assets/default-avatar.png'; // 默认头像\n\nexport default {\n  name: 'UserList',\n  setup() {\n    const users = ref([]);\n\n    // 获取用户列表\n    const fetchUsers = async () => {\n      try {\n        const response = await axios.get('http://127.0.0.1:8000/user/get-users');\n        users.value = response.data;\n      } catch (error) {\n        console.error('获取用户列表失败:', error);\n      }\n    };\n\n    // 页面加载时获取用户列表\n    onMounted(() => {\n      fetchUsers();\n    });\n    return {\n      users,\n      defaultAvatar\n    };\n  }\n};","map":{"version":3,"names":["ref","onMounted","axios","defaultAvatar","name","setup","users","fetchUsers","response","get","value","data","error","console"],"sources":["E:\\vue_learn\\my_vue\\my_vue\\src\\views\\UserList.vue"],"sourcesContent":["<template>\r\n    <div class=\"user-list\">\r\n      <h2>用户列表</h2>\r\n      <table class=\"user-table\">\r\n        <thead>\r\n          <tr>\r\n            <th>ID</th>\r\n            <th>用户名</th>\r\n            <th>手机号</th>\r\n            <th>性别</th>\r\n            <th>头像</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          <tr v-for=\"user in users\" :key=\"user.id\">\r\n            <td>{{ user.id }}</td>\r\n            <td>{{ user.username }}</td>\r\n            <td>{{ user.phone }}</td>\r\n            <td>{{ user.sex }}</td>\r\n            <!-- <td>\r\n              <img :src=\"user.photo ? `http://127.0.0.1:8000${user.photo}` : defaultAvatar\" alt=\"头像\" class=\"user-avatar\" />\r\n            </td> -->\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import { ref, onMounted } from 'vue';\r\n  import axios from 'axios';\r\n  import defaultAvatar from '@/assets/default-avatar.png'; // 默认头像\r\n  \r\n  export default {\r\n    name: 'UserList',\r\n    setup() {\r\n      const users = ref([]);\r\n  \r\n      // 获取用户列表\r\n      const fetchUsers = async () => {\r\n        try {\r\n          const response = await axios.get('http://127.0.0.1:8000/user/get-users');\r\n          users.value = response.data;\r\n        } catch (error) {\r\n          console.error('获取用户列表失败:', error);\r\n        }\r\n      };\r\n  \r\n      // 页面加载时获取用户列表\r\n      onMounted(() => {\r\n        fetchUsers();\r\n      });\r\n  \r\n      return {\r\n        users,\r\n        defaultAvatar,\r\n      };\r\n    },\r\n  };\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .user-list {\r\n    padding: 20px;\r\n  }\r\n  \r\n  .user-table {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    margin-top: 20px;\r\n  }\r\n  \r\n  .user-table th,\r\n  .user-table td {\r\n    padding: 10px;\r\n    border: 1px solid #ddd;\r\n    text-align: left;\r\n  }\r\n  \r\n  .user-table th {\r\n    background-color: #f5f5f5;\r\n    font-weight: bold;\r\n  }\r\n  \r\n  .user-table tr:hover {\r\n    background-color: #f9f9f9;\r\n  }\r\n  \r\n  .user-avatar {\r\n    width: 50px;\r\n    height: 50px;\r\n    border-radius: 50%;\r\n    object-fit: cover;\r\n  }\r\n  </style>"],"mappings":"AA6BE,SAASA,GAAG,EAAEC,SAAQ,QAAS,KAAK;AACpC,OAAOC,KAAI,MAAO,OAAO;AACzB,OAAOC,aAAY,MAAO,6BAA6B,EAAE;;AAEzD,eAAe;EACbC,IAAI,EAAE,UAAU;EAChBC,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIN,GAAG,CAAC,EAAE,CAAC;;IAErB;IACA,MAAMO,UAAS,GAAI,MAAAA,CAAA,KAAY;MAC7B,IAAI;QACF,MAAMC,QAAO,GAAI,MAAMN,KAAK,CAACO,GAAG,CAAC,sCAAsC,CAAC;QACxEH,KAAK,CAACI,KAAI,GAAIF,QAAQ,CAACG,IAAI;MAC7B,EAAE,OAAOC,KAAK,EAAE;QACdC,OAAO,CAACD,KAAK,CAAC,WAAW,EAAEA,KAAK,CAAC;MACnC;IACF,CAAC;;IAED;IACAX,SAAS,CAAC,MAAM;MACdM,UAAU,CAAC,CAAC;IACd,CAAC,CAAC;IAEF,OAAO;MACLD,KAAK;MACLH;IACF,CAAC;EACH;AACF,CAAC","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}