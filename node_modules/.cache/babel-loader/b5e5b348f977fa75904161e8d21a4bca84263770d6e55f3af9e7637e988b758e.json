{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.iterator.some.js\";\nimport { ref, computed, nextTick, onMounted } from 'vue';\nimport axios from 'axios';\nimport { ElMessage } from 'element-plus';\nimport { Upload } from '@element-plus/icons-vue';\nimport { API_CONFIG } from '@/config/config';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nimport FileUploader from './FileUploader.vue';\nimport emojis from '@/utils/emojis';\nexport default {\n  name: 'PublishPage',\n  components: {\n    Upload,\n    FileUploader\n  },\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const editor = ref(null);\n    const content = ref('');\n    const fileUploader = ref(null);\n\n    // 表情相关\n    const showEmojiPicker = ref(false);\n    const emojiList = ref([]); // 初始化空数组\n\n    // 验证emojis导入是否正确\n    onMounted(() => {\n      try {\n        // 尝试加载emojis\n        if (Array.isArray(emojis) && emojis.length > 0) {\n          emojiList.value = emojis;\n          console.log('表情加载成功，共加载', emojis.length, '个表情');\n        } else {\n          console.error('表情数据格式不正确，应为数组');\n          // 设置默认表情\n          emojiList.value = ['😀', '😃', '😄', '😁', '😆', '😅', '😂', '🤣'];\n        }\n      } catch (error) {\n        console.error('加载表情失败:', error);\n        // 设置默认表情\n        emojiList.value = ['😀', '😃', '😄', '😁', '😆', '😅', '😂', '🤣'];\n      }\n    });\n\n    // 编辑器功能\n    const formatText = command => {\n      document.execCommand(command, false);\n      editor.value.focus();\n    };\n    const updateContent = e => {\n      content.value = e.target.innerHTML;\n    };\n\n    // 表情功能\n    const toggleEmojiPicker = () => {\n      showEmojiPicker.value = !showEmojiPicker.value;\n      if (showEmojiPicker.value) nextTick(() => editor.value.focus());\n    };\n    // 插入表情\n    const insertEmoji = emoji => {\n      console.log('尝试插入表情:', emoji);\n\n      // 确保编辑器有焦点\n      if (!document.activeElement.isSameNode(editor.value)) {\n        editor.value.focus();\n        console.log('已重新获取编辑器焦点');\n      }\n      try {\n        // 保存当前选择\n        const selection = window.getSelection();\n        if (selection && selection.rangeCount > 0) {\n          const range = selection.getRangeAt(0);\n\n          // 创建包含表情的span元素\n          const emojiSpan = document.createElement('span');\n          emojiSpan.textContent = emoji;\n          emojiSpan.className = 'emoji-inline';\n\n          // 插入表情\n          range.deleteContents();\n          range.insertNode(emojiSpan);\n\n          // 移动光标到表情后面\n          range.setStartAfter(emojiSpan);\n          range.collapse(true);\n\n          // 更新选择\n          selection.removeAllRanges();\n          selection.addRange(range);\n\n          // 更新内容\n          content.value = editor.value.innerHTML;\n\n          // 触发input事件\n          const event = new Event('input', {\n            bubbles: true\n          });\n          editor.value.dispatchEvent(event);\n          console.log('表情插入成功');\n        } else {\n          console.log('没有活动的选择范围，无法插入表情');\n          // 回退方案：直接追加到内容末尾\n          editor.value.innerHTML += `<span class=\"emoji-inline\">${emoji}</span>`;\n          content.value = editor.value.innerHTML;\n        }\n      } catch (error) {\n        console.error('插入表情失败:', error);\n        // 回退方案：直接追加到内容末尾\n        editor.value.innerHTML += `<span class=\"emoji-inline\">${emoji}</span>`;\n        content.value = editor.value.innerHTML;\n      } finally {\n        showEmojiPicker.value = false;\n      }\n    };\n\n    // 上传完成处理\n    const handleUploadComplete = fileData => {\n      console.log('上传完成的文件:', fileData);\n    };\n\n    // 发布功能\n    const isPublishing = ref(false);\n    const canPublish = computed(() => {\n      const hasContent = content.value.trim().length > 0;\n      const hasFiles = fileUploader.value?.files.some(f => f.status === 'success');\n      return (hasContent || hasFiles) && !isPublishing.value;\n    });\n    const handlePublish = async () => {\n      if (!canPublish.value) return;\n      isPublishing.value = true;\n      try {\n        const postData = {\n          content: content.value,\n          user_id: store.state.user.id,\n          media: fileUploader.value.files.filter(f => f.status === 'success').map(f => ({\n            url: f.serverUrl,\n            type: f.type\n          }))\n        };\n        const response = await axios.post(`${API_CONFIG.BASE_URL}/article/moments`, postData, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`,\n            'Content-Type': 'application/json'\n          }\n        });\n        if (response.data.status_code === 0) {\n          ElMessage.success('发布成功');\n          resetForm();\n          // 添加路由跳转\n          router.push('/moments').then(() => {\n            // 重新加载页面\n            window.location.reload();\n          });\n        }\n      } catch (error) {\n        ElMessage.error(`发布失败: ${error.message}`);\n      } finally {\n        isPublishing.value = false;\n      }\n    };\n    const resetForm = () => {\n      content.value = '';\n      editor.value.innerHTML = '';\n      fileUploader.value?.reset();\n    };\n    const handleCancel = () => {\n      router.push('/moments');\n    };\n    return {\n      editor,\n      content,\n      showEmojiPicker,\n      emojiList,\n      fileUploader,\n      isPublishing,\n      canPublish,\n      formatText,\n      updateContent,\n      toggleEmojiPicker,\n      insertEmoji,\n      handleUploadComplete,\n      handlePublish,\n      handleCancel\n    };\n  }\n};","map":{"version":3,"names":["ref","computed","nextTick","onMounted","axios","ElMessage","Upload","API_CONFIG","useStore","useRouter","FileUploader","emojis","name","components","setup","store","router","editor","content","fileUploader","showEmojiPicker","emojiList","Array","isArray","length","value","console","log","error","formatText","command","document","execCommand","focus","updateContent","e","target","innerHTML","toggleEmojiPicker","insertEmoji","emoji","activeElement","isSameNode","selection","window","getSelection","rangeCount","range","getRangeAt","emojiSpan","createElement","textContent","className","deleteContents","insertNode","setStartAfter","collapse","removeAllRanges","addRange","event","Event","bubbles","dispatchEvent","handleUploadComplete","fileData","isPublishing","canPublish","hasContent","trim","hasFiles","files","some","f","status","handlePublish","postData","user_id","state","user","id","media","filter","map","url","serverUrl","type","response","post","BASE_URL","headers","Authorization","token","data","status_code","success","resetForm","push","then","location","reload","message","reset","handleCancel"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\article\\UserPublish_2.vue"],"sourcesContent":["<template>\r\n    <div class=\"publish-container\">\r\n      <!-- 编辑器工具栏 -->\r\n      <div class=\"editor-toolbar relative\">\r\n        <button @click=\"formatText('bold')\" title=\"加粗\">\r\n          <strong>B</strong>\r\n        </button>\r\n        <button @click=\"formatText('italic')\" title=\"斜体\">\r\n          <em>I</em>\r\n        </button>\r\n        <button @click=\"formatText('underline')\" title=\"下划线\">\r\n          <u>U</u>\r\n        </button>\r\n        <button \r\n          @click=\"toggleEmojiPicker\" \r\n          title=\"插入表情\" \r\n          class=\"relative z-10\"\r\n          aria-label=\"插入表情\"\r\n        >\r\n          😀\r\n        </button>\r\n  \r\n      <!-- 表情选择面板 -->\r\n      <div \r\n        v-if=\"showEmojiPicker\" \r\n        class=\"emoji-picker absolute\"\r\n        role=\"menu\"\r\n        aria-labelledby=\"emoji-button\"\r\n      >\r\n        <div \r\n          v-for=\"(emoji, index) in emojiList\"\r\n          :key=\"index\"\r\n          class=\"emoji-item\"\r\n          @click=\"insertEmoji(emoji)\"\r\n          role=\"menuitem\"\r\n          tabindex=\"0\"\r\n        >\r\n          {{ emoji }}\r\n        </div>\r\n      </div>\r\n    </div>\r\n      \r\n      <!-- 内容编辑器 -->\r\n      <div \r\n        ref=\"editor\" \r\n        contenteditable=\"true\"\r\n        class=\"content-editor\"\r\n        placeholder=\"分享新鲜事...\"\r\n        @input=\"updateContent\"\r\n        @click=\"showEmojiPicker = false\"\r\n      ></div>\r\n      \r\n      <!-- 使用FileUploader组件 -->\r\n      <FileUploader\r\n        ref=\"fileUploader\"\r\n        :max-size=\"20\"\r\n        :max-files=\"9\"\r\n        @upload-complete=\"handleUploadComplete\"\r\n        class=\"media-upload-section\"\r\n      >\r\n        <template #trigger>\r\n          <div class=\"custom-upload-trigger\">\r\n            <el-icon><Upload /></el-icon>\r\n            <div class=\"trigger-text\">\r\n              <p>点击或拖拽文件到此处</p>\r\n              <p class=\"hint-text\">支持图片和视频 (最大 20MB)</p>\r\n            </div>\r\n          </div>\r\n        </template>\r\n      </FileUploader>\r\n  \r\n    <!-- 发布按钮 -->\r\n    <div class=\"publish-actions\">\r\n      <el-button \r\n        type=\"primary\" \r\n        :loading=\"isPublishing\"\r\n        :disabled=\"!canPublish\"\r\n        @click=\"handlePublish\"\r\n        :class=\"{ 'publish-enabled': canPublish, 'publish-disabled': !canPublish }\"\r\n        style=\"margin-right: 10px;\"\r\n      >\r\n        {{ isPublishing ? '发布中...' : '发布' }}\r\n      </el-button>\r\n      <el-button \r\n        type=\"text\" \r\n        @click=\"handleCancel\"\r\n      >\r\n        取消\r\n      </el-button>\r\n    </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script>\r\n  import { ref, computed, nextTick, onMounted } from 'vue'\r\n  import axios from 'axios'\r\n  import { ElMessage } from 'element-plus'\r\n  import { Upload } from '@element-plus/icons-vue'\r\n  import { API_CONFIG } from '@/config/config'\r\n  import { useStore } from 'vuex'\r\n  import { useRouter } from 'vue-router'\r\n  import FileUploader from './FileUploader.vue'\r\n  import emojis from '@/utils/emojis'\r\n  \r\n  export default {\r\n    name: 'PublishPage',\r\n    components: {\r\n      Upload,\r\n      FileUploader\r\n    },\r\n    setup() {\r\n      const store = useStore()\r\n      const router = useRouter()\r\n      const editor = ref(null)\r\n      const content = ref('')\r\n      const fileUploader = ref(null)\r\n      \r\n      // 表情相关\r\n      const showEmojiPicker = ref(false)\r\n      const emojiList =ref([]) // 初始化空数组\r\n  \r\n    // 验证emojis导入是否正确\r\n    onMounted(() => {\r\n      try {\r\n        // 尝试加载emojis\r\n        if (Array.isArray(emojis) && emojis.length > 0) {\r\n          emojiList.value = emojis\r\n          console.log('表情加载成功，共加载', emojis.length, '个表情')\r\n        } else {\r\n          console.error('表情数据格式不正确，应为数组')\r\n          // 设置默认表情\r\n          emojiList.value = ['😀', '😃', '😄', '😁', '😆', '😅', '😂', '🤣']\r\n        }\r\n      } catch (error) {\r\n        console.error('加载表情失败:', error)\r\n        // 设置默认表情\r\n        emojiList.value = ['😀', '😃', '😄', '😁', '😆', '😅', '😂', '🤣']\r\n      }\r\n    })\r\n  \r\n      // 编辑器功能\r\n      const formatText = (command) => {\r\n        document.execCommand(command, false)\r\n        editor.value.focus()\r\n      }\r\n  \r\n      const updateContent = (e) => {\r\n        content.value = e.target.innerHTML\r\n      }\r\n  \r\n      // 表情功能\r\n      const toggleEmojiPicker = () => {\r\n        showEmojiPicker.value = !showEmojiPicker.value\r\n        if (showEmojiPicker.value) nextTick(() => editor.value.focus())\r\n      }\r\n    // 插入表情\r\n    const insertEmoji = (emoji) => {\r\n      console.log('尝试插入表情:', emoji)\r\n      \r\n      // 确保编辑器有焦点\r\n      if (!document.activeElement.isSameNode(editor.value)) {\r\n        editor.value.focus()\r\n        console.log('已重新获取编辑器焦点')\r\n      }\r\n      \r\n      try {\r\n        // 保存当前选择\r\n        const selection = window.getSelection()\r\n        \r\n        if (selection && selection.rangeCount > 0) {\r\n          const range = selection.getRangeAt(0)\r\n          \r\n          // 创建包含表情的span元素\r\n          const emojiSpan = document.createElement('span')\r\n          emojiSpan.textContent = emoji\r\n          emojiSpan.className = 'emoji-inline'\r\n          \r\n          // 插入表情\r\n          range.deleteContents()\r\n          range.insertNode(emojiSpan)\r\n          \r\n          // 移动光标到表情后面\r\n          range.setStartAfter(emojiSpan)\r\n          range.collapse(true)\r\n          \r\n          // 更新选择\r\n          selection.removeAllRanges()\r\n          selection.addRange(range)\r\n          \r\n          // 更新内容\r\n          content.value = editor.value.innerHTML\r\n          \r\n          // 触发input事件\r\n          const event = new Event('input', { bubbles: true })\r\n          editor.value.dispatchEvent(event)\r\n          \r\n          console.log('表情插入成功')\r\n        } else {\r\n          console.log('没有活动的选择范围，无法插入表情')\r\n          // 回退方案：直接追加到内容末尾\r\n          editor.value.innerHTML += `<span class=\"emoji-inline\">${emoji}</span>`\r\n          content.value = editor.value.innerHTML\r\n        }\r\n      } catch (error) {\r\n        console.error('插入表情失败:', error)\r\n        // 回退方案：直接追加到内容末尾\r\n        editor.value.innerHTML += `<span class=\"emoji-inline\">${emoji}</span>`\r\n        content.value = editor.value.innerHTML\r\n      } finally {\r\n        showEmojiPicker.value = false\r\n      }\r\n    }\r\n  \r\n      // 上传完成处理\r\n      const handleUploadComplete = (fileData) => {\r\n        console.log('上传完成的文件:', fileData)\r\n      }\r\n  \r\n      // 发布功能\r\n      const isPublishing = ref(false)\r\n      \r\n      const canPublish = computed(() => {\r\n        const hasContent = content.value.trim().length > 0\r\n        const hasFiles = fileUploader.value?.files.some(f => f.status === 'success')\r\n        return (hasContent || hasFiles) && !isPublishing.value\r\n      })\r\n  \r\n      const handlePublish = async () => {\r\n        if (!canPublish.value) return\r\n        \r\n        isPublishing.value = true\r\n        \r\n        try {\r\n          const postData = {\r\n            content: content.value,\r\n            user_id: store.state.user.id,\r\n            media: fileUploader.value.files\r\n              .filter(f => f.status === 'success')\r\n              .map(f => ({\r\n                url: f.serverUrl,\r\n                type: f.type\r\n              }))\r\n          }\r\n  \r\n          const response = await axios.post(\r\n            `${API_CONFIG.BASE_URL}/article/moments`, \r\n            postData,\r\n            {\r\n              headers: {\r\n                Authorization: `Bearer ${store.state.token}`,\r\n                'Content-Type': 'application/json'\r\n              }\r\n            }\r\n          )\r\n  \r\n          if (response.data.status_code === 0) {\r\n            ElMessage.success('发布成功')\r\n            resetForm()\r\n                   // 添加路由跳转\r\n        router.push('/moments').then(() => {\r\n            // 重新加载页面\r\n            window.location.reload();\r\n          });\r\n          }\r\n        } catch (error) {\r\n          ElMessage.error(`发布失败: ${error.message}`)\r\n        } finally {\r\n          isPublishing.value = false\r\n        }\r\n      }\r\n  \r\n      const resetForm = () => {\r\n        content.value = ''\r\n        editor.value.innerHTML = ''\r\n        fileUploader.value?.reset()\r\n      }\r\n  \r\n      const handleCancel = () => {\r\n        router.push('/moments')\r\n      }\r\n  \r\n      return {\r\n        editor,\r\n        content,\r\n        showEmojiPicker,\r\n        emojiList,\r\n        fileUploader,\r\n        isPublishing,\r\n        canPublish,\r\n        formatText,\r\n        updateContent,\r\n        toggleEmojiPicker,\r\n        insertEmoji,\r\n        handleUploadComplete,\r\n        handlePublish,\r\n        han