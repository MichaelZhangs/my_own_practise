{"ast":null,"code":"import { ref, onMounted } from 'vue';\nimport { useStore } from 'vuex';\nimport axios from 'axios';\nimport QRCode from 'qrcode';\nimport defaultAvatar from '@/assets/default-avatar.png';\nimport defaultQR from '@/assets/logo.png';\nexport default {\n  __name: 'UserDetail',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const store = useStore();\n\n    // 响应式数据\n    const editableUser = ref({\n      ...store.state.user,\n      description: store.state.user.description || ''\n    });\n    const qrcodeUrl = ref(defaultQR);\n    const isPhoneEditable = ref(false);\n\n    // 启用手机号编辑\n    const enablePhoneEdit = async () => {\n      isPhoneEditable.value = true;\n      document.querySelector('.short-input[readonly]')?.focus();\n    };\n\n    // 头像上传处理\n    const handleAvatarUpload = async event => {\n      const file = event.target.files?.[0];\n      if (!file || !file.type.startsWith('image/')) return;\n      try {\n        // 将文件转换为 Base64\n        const reader = new FileReader();\n        reader.readAsDataURL(file);\n        reader.onload = async () => {\n          const base64Image = reader.result; // 获取 Base64 编码的图片数据\n\n          // 调用后端上传头像接口\n          const response = await axios.post('http://127.0.0.1:8000/user/upload-avatar', {\n            phone: editableUser.value.phone,\n            photo: base64Image\n          });\n          if (response.data.avatar_url) {\n            // 更新本地数据（使用完整URL）\n            editableUser.value.photo = response.data.avatar_url;\n            alert('头像上传成功');\n          }\n        };\n        reader.onerror = error => {\n          console.error('文件读取失败:', error);\n          alert('文件读取失败，请重试');\n        };\n      } catch (error) {\n        console.error('头像上传失败:', error);\n        alert('头像上传失败，请重试');\n      }\n    };\n\n    // 生成带头像的二维码\n    const generateQRWithAvatar = async () => {\n      try {\n        const userData = {\n          name: editableUser.value.username,\n          phone: editableUser.value.phone,\n          email: editableUser.value.email,\n          description: editableUser.value.description\n        };\n        const canvas = document.createElement('canvas');\n        await QRCode.toCanvas(canvas, JSON.stringify(userData), {\n          width: 200,\n          margin: 2,\n          color: {\n            dark: '#07c160',\n            light: '#ffffff'\n          },\n          errorCorrectionLevel: 'H'\n        });\n        const ctx = canvas.getContext('2d');\n        const avatarImg = new Image();\n        avatarImg.src = editableUser.value.photo || defaultAvatar;\n        await new Promise(resolve => {\n          avatarImg.onload = resolve;\n          avatarImg.onerror = resolve;\n        });\n        ctx.beginPath();\n        ctx.arc(100, 100, 25, 0, Math.PI * 2);\n        ctx.clip();\n        ctx.drawImage(avatarImg, 75, 75, 50, 50);\n        qrcodeUrl.value = canvas.toDataURL();\n        editableUser.value.qrcode = qrcodeUrl.value; // 同步到可编辑数据\n      } catch (error) {\n        console.error('二维码生成失败:', error);\n        alert('二维码生成失败，请重试');\n      }\n    };\n\n    // 获取用户信息\n    const fetchUserInfo = async () => {\n      try {\n        const response = await axios.get('http://127.0.0.1:8000/user/info', {\n          params: {\n            phone: editableUser.value.phone // 根据你的接口需求传参\n          }\n        });\n        if (response.data) {\n          // 更新本地数据\n          editableUser.value = {\n            username: response.data.username || \"\",\n            phone: response.data.phone || \"\",\n            email: response.data.email || \"\",\n            sex: response.data.sex || \"\",\n            description: response.data.description || \"\",\n            photo: response.data.photo || defaultAvatar,\n            qrcode: response.data.qrcode || defaultQR\n          };\n          // 更新store中的用户信息\n          await store.dispatch('updateUser', response.data);\n\n          // 更新本地可编辑数据\n          editableUser.value = {\n            ...response.data,\n            description: response.data.description || ''\n          };\n\n          // 如果用户有二维码信息，直接显示\n          if (response.data.qrcode) {\n            qrcodeUrl.value = response.data.qrcode;\n          }\n        }\n      } catch (error) {\n        console.error('获取用户信息失败:', error);\n        alert('获取用户信息失败，请重试');\n      }\n    };\n\n    // 组件挂载时自动获取用户信息\n    onMounted(async () => {\n      await fetchUserInfo();\n    });\n\n    // 保存用户信息\n    const saveUserInfo = async () => {\n      try {\n        // 构造请求数据\n        const requestData = {\n          username: editableUser.value.username,\n          email: editableUser.value.email || \"\",\n          sex: editableUser.value.sex,\n          description: editableUser.value.description || \"\",\n          phone: editableUser.value.phone,\n          qrcode: qrcodeUrl.value // 将二维码数据添加到请求中\n        };\n\n        // 发送PUT请求保存用户信息\n        const response = await axios.put('http://127.0.0.1:8000/user/info', requestData);\n        console.log(\"response: \", response.status);\n        if (response.status === 200) {\n          // 更新本地存储\n          await store.dispatch('updateUser', requestData);\n\n          // 保存二维码到服务器\n          await saveQrcodeToServer();\n        }\n      } catch (error) {\n        console.error('保存失败:', error);\n        const errorMsg = error.response?.data?.detail || '保存失败，请检查网络后重试';\n        alert(`保存失败: ${errorMsg}`);\n      }\n    };\n\n    // 保存二维码到服务器\n    const saveQrcodeToServer = async () => {\n      try {\n        if (!qrcodeUrl.value) {\n          alert('请先生成二维码');\n          return;\n        }\n        const response = await axios.post('http://127.0.0.1:8000/user/save-qrcode', {\n          phone: editableUser.value.phone,\n          qrcode: qrcodeUrl.value // 二维码的Base64数据\n        });\n        if (response.status === 200) {\n          alert('二维码保存成功');\n        }\n      } catch (error) {\n        console.error('二维码保存失败:', error);\n        alert('二维码保存失败，请重试');\n      }\n    };\n    const __returned__ = {\n      store,\n      editableUser,\n      qrcodeUrl,\n      isPhoneEditable,\n      enablePhoneEdit,\n      handleAvatarUpload,\n      generateQRWithAvatar,\n      fetchUserInfo,\n      saveUserInfo,\n      saveQrcodeToServer,\n      ref,\n      onMounted,\n      get useStore() {\n        return useStore;\n      },\n      get axios() {\n        return axios;\n      },\n      get QRCode() {\n        return QRCode;\n      },\n      get defaultAvatar() {\n        return defaultAvatar;\n      },\n      get defaultQR() {\n        return defaultQR;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","onMounted","useStore","axios","QRCode","defaultAvatar","defaultQR","store","editableUser","state","user","description","qrcodeUrl","isPhoneEditable","enablePhoneEdit","value","document","querySelector","focus","handleAvatarUpload","event","file","target","files","type","startsWith","reader","FileReader","readAsDataURL","onload","base64Image","result","response","post","phone","photo","data","avatar_url","alert","onerror","error","console","generateQRWithAvatar","userData","name","username","email","canvas","createElement","toCanvas","JSON","stringify","width","margin","color","dark","light","errorCorrectionLevel","ctx","getContext","avatarImg","Image","src","Promise","resolve","beginPath","arc","Math","PI","clip","drawImage","toDataURL","qrcode","fetchUserInfo","get","params","sex","dispatch","saveUserInfo","requestData","put","log","status","saveQrcodeToServer","errorMsg","detail"],"sources":["E:/vue_learn/ai_vue/ai_vue/src/views/UserDetail.vue"],"sourcesContent":["<template>\r\n  <div class=\"user-detail-page\">\r\n    <h1 class=\"page-title\">用户详情</h1>\r\n    <div class=\"user-container\">\r\n      <!-- 可编辑头像 -->\r\n      <div class=\"avatar-wrapper\">\r\n        <label class=\"avatar-upload\">\r\n          <input \r\n            type=\"file\" \r\n            accept=\"image/*\" \r\n            @change=\"handleAvatarUpload\" \r\n            hidden\r\n          />\r\n          <img \r\n            :src=\"editableUser.photo || defaultAvatar\" \r\n            alt=\"用户头像\" \r\n            class=\"user-avatar\"\r\n          />\r\n          <span class=\"edit-tip\">点击更换头像</span>\r\n        </label>\r\n      </div>\r\n\r\n      <!-- 用户信息编辑 -->\r\n      <div class=\"info-section\">\r\n        <div class=\"info-item\">\r\n          <label>姓名：</label>\r\n          <input v-model=\"editableUser.username\" class=\"short-input\" />\r\n        </div>\r\n        \r\n        <div class=\"info-item\">\r\n          <label>性别：</label>\r\n          <select v-model=\"editableUser.sex\">\r\n            <option value=\"male\">male</option>\r\n            <option value=\"female\">female</option>\r\n          </select>\r\n        </div>\r\n\r\n        <div class=\"info-item\">\r\n          <label>手机：</label>\r\n          <input\r\n            v-model=\"editableUser.phone\"\r\n            :readonly=\"!isPhoneEditable\"\r\n            class=\"short-input\"\r\n            @dblclick=\"enablePhoneEdit\"\r\n            @blur=\"isPhoneEditable = false\"\r\n          />\r\n          <span v-if=\"!isPhoneEditable\" class=\"edit-hint\">(双击编辑)</span>\r\n        </div>\r\n\r\n        <div class=\"info-item\">\r\n          <label>邮箱：</label>\r\n          <input v-model=\"editableUser.email\" class=\"short-input\" />\r\n        </div>\r\n\r\n        <div class=\"info-item\">\r\n          <label>描述：</label>\r\n          <input v-model=\"editableUser.description\" class=\"short-input\" />\r\n        </div>\r\n\r\n        <!-- 二维码展示 -->\r\n        <div class=\"info-item\">\r\n          <label class=\"qr-label\">我的二维码：</label>\r\n          <div class=\"qr-wrapper\" @click=\"generateQRWithAvatar\">\r\n            <img \r\n              :src=\"qrcodeUrl || defaultQR\" \r\n              alt=\"个人二维码\" \r\n              class=\"wechat-qr\"\r\n            />\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <button class=\"save-btn\" @click=\"saveUserInfo\">保存修改</button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, onMounted } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport axios from 'axios';\r\nimport QRCode from 'qrcode';\r\nimport defaultAvatar from '@/assets/default-avatar.png';\r\nimport defaultQR from '@/assets/logo.png';\r\n\r\nconst store = useStore();\r\n\r\n// 响应式数据\r\nconst editableUser = ref({\r\n  ...store.state.user,\r\n  description: store.state.user.description || ''\r\n});\r\nconst qrcodeUrl = ref(defaultQR);\r\nconst isPhoneEditable = ref(false);\r\n\r\n// 启用手机号编辑\r\nconst enablePhoneEdit = async () => {\r\n  isPhoneEditable.value = true;\r\n  document.querySelector('.short-input[readonly]')?.focus();\r\n};\r\n\r\n// 头像上传处理\r\nconst handleAvatarUpload = async (event) => {\r\n  const file = event.target.files?.[0];\r\n  if (!file || !file.type.startsWith('image/')) return;\r\n\r\n  try {\r\n    // 将文件转换为 Base64\r\n    const reader = new FileReader();\r\n    reader.readAsDataURL(file);\r\n\r\n    reader.onload = async () => {\r\n      const base64Image = reader.result; // 获取 Base64 编码的图片数据\r\n\r\n      // 调用后端上传头像接口\r\n      const response = await axios.post('http://127.0.0.1:8000/user/upload-avatar', {\r\n        phone: editableUser.value.phone,\r\n        photo: base64Image\r\n      });\r\n\r\n      if (response.data.avatar_url) {\r\n        // 更新本地数据（使用完整URL）\r\n        editableUser.value.photo = response.data.avatar_url;\r\n        alert('头像上传成功');\r\n      }\r\n    };\r\n\r\n    reader.onerror = (error) => {\r\n      console.error('文件读取失败:', error);\r\n      alert('文件读取失败，请重试');\r\n    };\r\n  } catch (error) {\r\n    console.error('头像上传失败:', error);\r\n    alert('头像上传失败，请重试');\r\n  }\r\n};\r\n\r\n// 生成带头像的二维码\r\nconst generateQRWithAvatar = async () => {\r\n  try {\r\n    const userData = {\r\n      name: editableUser.value.username,\r\n      phone: editableUser.value.phone,\r\n      email: editableUser.value.email,\r\n      description: editableUser.value.description\r\n    };\r\n\r\n    const canvas = document.createElement('canvas');\r\n    await QRCode.toCanvas(canvas, JSON.stringify(userData), {\r\n      width: 200,\r\n      margin: 2,\r\n      color: {\r\n        dark: '#07c160',\r\n        light: '#ffffff'\r\n      },\r\n      errorCorrectionLevel: 'H'\r\n    });\r\n\r\n    const ctx = canvas.getContext('2d');\r\n    const avatarImg = new Image();\r\n    avatarImg.src = editableUser.value.photo || defaultAvatar;\r\n    \r\n    await new Promise((resolve) => {\r\n      avatarImg.onload = resolve;\r\n      avatarImg.onerror = resolve;\r\n    });\r\n\r\n    ctx.beginPath();\r\n    ctx.arc(100, 100, 25, 0, Math.PI * 2);\r\n    ctx.clip();\r\n    ctx.drawImage(avatarImg, 75, 75, 50, 50);\r\n\r\n    qrcodeUrl.value = canvas.toDataURL();\r\n    editableUser.value.qrcode = qrcodeUrl.value; // 同步到可编辑数据\r\n  } catch (error) {\r\n    console.error('二维码生成失败:', error);\r\n    alert('二维码生成失败，请重试');\r\n  }\r\n};\r\n\r\n// 获取用户信息\r\nconst fetchUserInfo = async () => {\r\n  try {\r\n    const response = await axios.get('http://127.0.0.1:8000/user/info', {\r\n      params: {\r\n        phone: editableUser.value.phone  // 根据你的接口需求传参\r\n      }\r\n    });\r\n    \r\n    if (response.data) {\r\n            // 更新本地数据\r\n      editableUser.value = {\r\n        username: response.data.username || \"\",\r\n        phone: response.data.phone || \"\",\r\n        email: response.data.email || \"\",\r\n        sex: response.data.sex || \"\",\r\n        description: response.data.description || \"\",\r\n        photo: response.data.photo || defaultAvatar,\r\n        qrcode: response.data.qrcode || defaultQR\r\n      };\r\n      // 更新store中的用户信息\r\n      await store.dispatch('updateUser', response.data);\r\n      \r\n      // 更新本地可编辑数据\r\n      editableUser.value = { \r\n        ...response.data,\r\n        description: response.data.description || '' \r\n      };\r\n\r\n      // 如果用户有二维码信息，直接显示\r\n      if (response.data.qrcode) {\r\n        qrcodeUrl.value = response.data.qrcode;\r\n      }\r\n    }\r\n  } catch (error) {\r\n    console.error('获取用户信息失败:', error);\r\n    alert('获取用户信息失败，请重试');\r\n  }\r\n};\r\n\r\n// 组件挂载时自动获取用户信息\r\nonMounted(async () => {\r\n  await fetchUserInfo();\r\n});\r\n\r\n// 保存用户信息\r\nconst saveUserInfo = async () => {\r\n  try {\r\n    // 构造请求数据\r\n    const requestData = {\r\n      username: editableUser.value.username,\r\n      email: editableUser.value.email || \"\",\r\n      sex: editableUser.value.sex,\r\n      description: editableUser.value.description || \"\",\r\n      phone: editableUser.value.phone,\r\n      qrcode: qrcodeUrl.value // 将二维码数据添加到请求中\r\n    };\r\n\r\n    // 发送PUT请求保存用户信息\r\n    const response = await axios.put('http://127.0.0.1:8000/user/info', requestData);\r\n    console.log(\"response: \", response.status);\r\n\r\n    if (response.status === 200) {\r\n      // 更新本地存储\r\n      await store.dispatch('updateUser', requestData);\r\n\r\n      // 保存二维码到服务器\r\n      await saveQrcodeToServer();\r\n    }\r\n  } catch (error) {\r\n    console.error('保存失败:', error);\r\n    const errorMsg = error.response?.data?.detail || '保存失败，请检查网络后重试';\r\n    alert(`保存失败: ${errorMsg}`);\r\n  }\r\n};\r\n\r\n// 保存二维码到服务器\r\nconst saveQrcodeToServer = async () => {\r\n  try {\r\n    if (!qrcodeUrl.value) {\r\n      alert('请先生成二维码');\r\n      return;\r\n    }\r\n\r\n    const response = await axios.post('http://127.0.0.1:8000/user/save-qrcode', {\r\n      phone: editableUser.value.phone,\r\n      qrcode: qrcodeUrl.value // 二维码的Base64数据\r\n    });\r\n\r\n    if (response.status === 200) {\r\n      alert('二维码保存成功');\r\n    }\r\n  } catch (error) {\r\n    console.error('二维码保存失败:', error);\r\n    alert('二维码保存失败，请重试');\r\n  }\r\n};\r\n</script>\r\n\r\n  <style scoped>\r\n  /* 基础布局 */\r\n  .user-detail-page {\r\n    max-width: 600px;\r\n    margin: 0 auto;\r\n    padding: 2rem;\r\n    font-family: 'Helvetica Neue', Arial, sans-serif;\r\n  }\r\n  \r\n  .page-title {\r\n    text-align: center;\r\n    font-size: 1.5rem;\r\n    color: #333;\r\n    margin-bottom: 2rem;\r\n  }\r\n  \r\n  .user-container {\r\n    background: #fff;\r\n    border-radius: 12px;\r\n    padding: 1.5rem;\r\n    box-shadow: 0 2px 8px rgba(0,0,0,0.1);\r\n  }\r\n  \r\n  /* 头像样式 */\r\n  .avatar-wrapper {\r\n    text-align: center;\r\n    margin-bottom: 1.5rem;\r\n  }\r\n  \r\n  .user-avatar {\r\n    width: 100px;\r\n    height: 100px;\r\n    border-radius: 50%;\r\n    border: 3px solid #07c160;\r\n    cursor: pointer;\r\n    transition: transform 0.3s ease;\r\n  }\r\n  \r\n  .user-avatar:hover {\r\n    transform: scale(1.05);\r\n  }\r\n  /* 二维码标签特殊样式 */\r\n    .qr-label {\r\n    margin-top: 5px; /* 保持垂直对齐 */\r\n    }\r\n  \r\n  .edit-tip {\r\n    display: block;\r\n    color: #666;\r\n    font-size: 0.8rem;\r\n    margin-top: 0.5rem;\r\n  }\r\n  \r\n  /* 手机号编辑提示 */\r\n    .edit-hint {\r\n    color: #999;\r\n    font-size: 0.8rem;\r\n    margin-left: 10px;\r\n    }\r\n    /* 手机号输入框只读状态 */\r\n    input:read-only {\r\n    background-color: #f5f5f5;\r\n    cursor: not-allowed;\r\n    border-color: #eee;\r\n    }\r\n\r\n  /* 信息项样式 */\r\n  .info-section {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 1rem;\r\n  }\r\n  \r\n  .info-item {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 1rem;\r\n  }\r\n  \r\n  .info-item label {\r\n  flex: 0 0 100px;\r\n  text-align: left; /* 改为左对齐 */\r\n  color: #666;\r\n  font-size: 0.9rem;\r\n  margin-right: 15px;\r\n}\r\n  \r\n  /* 输入控件样式 */\r\n  .short-input, select {\r\n    flex: 1;\r\n    padding: 0.5rem;\r\n    border: 1px solid #ddd;\r\n    border-radius: 4px;\r\n    max-width: 300px;\r\n    font-size: 0.9rem;\r\n  }\r\n  \r\n  select {\r\n    background: white;\r\n    cursor: pointer;\r\n  }\r\n  \r\n  /* 二维码区域 */\r\n  .qr-wrapper {\r\n    flex: 1;\r\n    cursor: pointer;\r\n  }\r\n  \r\n  .wechat-qr {\r\n    width: 160px;\r\n    height: 160px;\r\n    border: 3px solid #07c160;\r\n    border-radius: 8px;\r\n    padding: 5px;\r\n    background: white;\r\n    transition: transform 0.3s ease;\r\n  }\r\n  \r\n  .wechat-qr:hover {\r\n    transform: scale(1.05);\r\n  }\r\n  \r\n  /* 保存按钮 */\r\n  .save-btn {\r\n    display: block;\r\n    width: 200px;\r\n    padding: 0.8rem;\r\n    margin: 2rem auto 0;\r\n    background: #07c160;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 25px;\r\n    cursor: pointer;\r\n    font-size: 1rem;\r\n    transition: background 0.3s ease;\r\n  }\r\n  \r\n  .save-btn:hover {\r\n    background: #05964d;\r\n  }\r\n  \r\n  /* 响应式设计 */\r\n  @media (max-width: 480px) {\r\n    .user-container {\r\n      padding: 1rem;\r\n    }\r\n  \r\n    .info-item {\r\n      flex-direction: column;\r\n      align-items: flex-start;\r\n    }\r\n  \r\n    .info-item label {\r\n      text-align: left;\r\n      flex: none;\r\n    }\r\n  \r\n    .short-input, select {\r\n      max-width: 100%;\r\n      width: 100%;\r\n    }\r\n  \r\n    .wechat-qr {\r\n      width: 140px;\r\n      height: 140px;\r\n    }\r\n  }\r\n  </style>  "],"mappings":"AA8EA,SAASA,GAAG,EAAEC,SAAS,QAAQ,KAAK;AACpC,SAASC,QAAQ,QAAQ,MAAM;AAC/B,OAAOC,KAAK,MAAM,OAAO;AACzB,OAAOC,MAAM,MAAM,QAAQ;AAC3B,OAAOC,aAAa,MAAM,6BAA6B;AACvD,OAAOC,SAAS,MAAM,mBAAmB;;;;;;;IAEzC,MAAMC,KAAK,GAAGL,QAAQ,CAAC,CAAC;;IAExB;IACA,MAAMM,YAAY,GAAGR,GAAG,CAAC;MACvB,GAAGO,KAAK,CAACE,KAAK,CAACC,IAAI;MACnBC,WAAW,EAAEJ,KAAK,CAACE,KAAK,CAACC,IAAI,CAACC,WAAW,IAAI;IAC/C,CAAC,CAAC;IACF,MAAMC,SAAS,GAAGZ,GAAG,CAACM,SAAS,CAAC;IAChC,MAAMO,eAAe,GAAGb,GAAG,CAAC,KAAK,CAAC;;IAElC;IACA,MAAMc,eAAe,GAAG,MAAAA,CAAA,KAAY;MAClCD,eAAe,CAACE,KAAK,GAAG,IAAI;MAC5BC,QAAQ,CAACC,aAAa,CAAC,wBAAwB,CAAC,EAAEC,KAAK,CAAC,CAAC;IAC3D,CAAC;;IAED;IACA,MAAMC,kBAAkB,GAAG,MAAOC,KAAK,IAAK;MAC1C,MAAMC,IAAI,GAAGD,KAAK,CAACE,MAAM,CAACC,KAAK,GAAG,CAAC,CAAC;MACpC,IAAI,CAACF,IAAI,IAAI,C