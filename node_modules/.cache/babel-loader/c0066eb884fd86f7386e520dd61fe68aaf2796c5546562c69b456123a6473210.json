{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.iterator.some.js\";\nimport { computed, ref, onMounted, onUnmounted, nextTick, watch } from 'vue';\nimport { useRoute, useRouter } from 'vue-router';\nimport { useStore } from 'vuex';\nimport defaultAvatar from '@/assets/default-avatar.png';\nimport { API_CONFIG } from '@/config/config';\nimport { ElMessage, ElNotification } from 'element-plus';\nimport axios from 'axios';\nexport default {\n  setup() {\n    const route = useRoute();\n    const router = useRouter();\n    const store = useStore();\n    const messagesContainer = ref(null);\n    const targetUser = ref({});\n    const messages = ref([]);\n    const inputMessage = ref('');\n    const myAvatar = computed(() => {\n      const user = store.state.user;\n      return user.photo ? `${API_CONFIG.BASE_URL}${user.photo}` : defaultAvatar;\n    });\n    const socket = ref(null);\n    const isConnected = ref(false);\n    const reconnecting = ref(false);\n    const reconnectTimer = ref(null);\n    const myId = computed(() => store.state.user.id);\n\n    // 工具方法：处理图片URL\n    const getFullUrl = path => {\n      if (!path) return defaultAvatar;\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`;\n    };\n\n    // 工具方法：格式化时间\n    const formatTime = time => {\n      if (!time) return '';\n      const date = new Date(time);\n      const now = new Date();\n      if (date.toDateString() === now.toDateString()) {\n        return date.toTimeString().substring(0, 5);\n      }\n      const yesterday = new Date();\n      yesterday.setDate(now.getDate() - 1);\n      if (date.toDateString() === yesterday.toDateString()) {\n        return '昨天';\n      }\n      return `${date.getMonth() + 1}/${date.getDate()}`;\n    };\n\n    // 初始化WebSocket连接\n    const initWebSocket = () => {\n      if (myId.value && targetUser.value.id) {\n        const wsUrl = `ws://${API_CONFIG.URL_CHAT}/ws/chat/${myId.value}/${targetUser.value.id}`;\n        console.log(\"尝试连接WebSocket:\", wsUrl);\n        if (socket.value) {\n          socket.value.close();\n        }\n        socket.value = new WebSocket(wsUrl);\n\n        // 心跳检测相关变量\n        let heartbeatTimer = null;\n        const HEARTBEAT_INTERVAL = 30000; // 30秒发送一次心跳\n\n        // 发送心跳消息\n        const sendHeartbeat = () => {\n          if (socket.value && socket.value.readyState === WebSocket.OPEN) {\n            socket.value.send(JSON.stringify({\n              type: 'heartbeat',\n              from: myId.value,\n              time: new Date().toISOString()\n            }));\n          }\n        };\n\n        // 启动心跳检测\n        const startHeartbeat = () => {\n          stopHeartbeat();\n          heartbeatTimer = setInterval(sendHeartbeat, HEARTBEAT_INTERVAL);\n        };\n\n        // 停止心跳检测\n        const stopHeartbeat = () => {\n          if (heartbeatTimer) {\n            clearInterval(heartbeatTimer);\n            heartbeatTimer = null;\n          }\n        };\n        socket.value.onopen = () => {\n          isConnected.value = true;\n          reconnecting.value = false;\n          ElNotification({\n            title: '连接成功',\n            message: `已与 ${targetUser.value.username || '对方'} 建立聊天连接`,\n            type: 'success',\n            duration: 3000\n          });\n\n          // 启动心跳检测\n          startHeartbeat();\n\n          // 连接成功后加载历史消息\n          loadHistoryMessages();\n\n          // 发送连接确认消息\n          socket.value.send(JSON.stringify({\n            type: 'connection_ack',\n            from: myId.value,\n            to: targetUser.value.id,\n            time: new Date().toISOString()\n          }));\n        };\n        socket.value.onmessage = event => {\n          try {\n            const msg = JSON.parse(event.data);\n\n            // 处理心跳响应\n            if (msg.type === 'heartbeat') {\n              console.log('收到心跳响应');\n              return;\n            }\n\n            // 处理普通消息\n            addMessage({\n              id: msg.id,\n              text: msg.text,\n              fromMe: msg.from !== myId.value,\n              time: msg.time\n            });\n\n            // 发送消息已读确认\n            if (msg.id && !msg.fromMe) {\n              socket.value.send(JSON.stringify({\n                type: 'message_read',\n                message_id: msg.id,\n                from: myId.value,\n                to: msg.from,\n                time: new Date().toISOString()\n              }));\n            }\n          } catch (e) {\n            console.error('解析消息失败', e);\n            ElMessage.error('接收消息失败');\n          }\n        };\n        socket.value.onclose = event => {\n          isConnected.value = false;\n          stopHeartbeat();\n          console.log('WebSocket连接关闭，状态码:', event.code, '原因:', event.reason);\n          ElNotification({\n            title: '连接断开',\n            message: '聊天连接已断开，正在尝试重连...',\n            type: 'warning',\n            duration: 0\n          });\n          if (!reconnecting.value) {\n            startReconnect();\n          }\n        };\n        socket.value.onerror = errorEvent => {\n          console.error('WebSocket错误:', errorEvent);\n          ElMessage.error('聊天连接错误，请检查网络连接');\n        };\n      }\n    };\n    // 添加消息到列表\n    const addMessage = msg => {\n      // 检查消息是否已存在（避免重复添加）\n      const exists = messages.value.some(m => m.id === msg.id);\n      if (exists) return;\n\n      // 添加消息状态（如果没有提供）\n      if (!msg.status) {\n        msg.status = 'received';\n      }\n      messages.value.push(msg);\n      nextTick(() => {\n        if (messagesContainer.value) {\n          messagesContainer.value.scrollTop = messagesContainer.value.scrollHeight;\n        }\n      });\n    };\n    // 加载历史消息\n    const loadHistoryMessages = () => {\n      if (myId.value && targetUser.value.id) {\n        axios.get(`${API_CONFIG.BASE_URL}/chat/history/${myId.value}/${targetUser.value.id}`, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        }).then(res => {\n          if (res.data && res.data.length) {\n            messages.value = res.data.map(msg => ({\n              id: msg.id,\n              text: msg.text,\n              fromMe: msg.from_id !== myId.value,\n              time: msg.created_at\n            }));\n            nextTick(() => {\n              if (messagesContainer.value) {\n                messagesContainer.value.scrollTop = messagesContainer.value.scrollHeight;\n              }\n            });\n          }\n        }).catch(err => {\n          console.error('加载历史消息失败', err);\n          ElMessage.warning('历史消息加载失败');\n        });\n      }\n    };\n\n    // 开始重连\n    const startReconnect = () => {\n      if (reconnecting.value || !targetUser.value.id) return;\n      reconnecting.value = true;\n      console.log('尝试重连WebSocket...');\n      reconnectTimer.value = setTimeout(() => {\n        initWebSocket();\n        reconnecting.value = false;\n      }, 3000); // 3秒后尝试重连\n    };\n\n    // 停止重连\n    const stopReconnect = () => {\n      if (reconnectTimer.value) {\n        clearTimeout(reconnectTimer.value);\n        reconnectTimer.value = null;\n        reconnecting.value = false;\n      }\n    };\n\n    // 发送消息\n    const sendMessage = () => {\n      if (!inputMessage.value.trim()) return;\n      if (!isConnected.value) {\n        ElMessage.warning('当前连接已断开，无法发送消息');\n        return;\n      }\n      const msgId = Date.now(); // 生成唯一消息ID\n      const msg = {\n        id: msgId,\n        text: inputMessage.value.trim(),\n        from: myId.value,\n        to: targetUser.value.id,\n        type: 'text',\n        time: new Date().toISOString()\n      };\n      addMessage({\n        id: msgId,\n        text: msg.text,\n        fromMe: false,\n        time: msg.time,\n        status: 'sending' // 添加消息状态\n      });\n      inputMessage.value = '';\n      try {\n        socket.value.send(JSON.stringify(msg));\n\n        // 设置消息超时处理\n        setTimeout(() => {\n          // 查找消息并更新状态\n          const messageIndex = messages.value.findIndex(m => m.id === msgId);\n          if (messageIndex !== -1 && messages.value[messageIndex].status === 'sending') {\n            messages.value[messageIndex].status = 'failed';\n          }\n        }, 10000); // 10秒后如果没有确认，标记为失败\n      } catch (error) {\n        console.error('发送消息失败', error);\n\n        // 更新消息状态为失败\n        const messageIndex = messages.value.findIndex(m => m.id === msgId);\n        if (messageIndex !== -1) {\n          messages.value[messageIndex].status = 'failed';\n        }\n        ElMessage.error('消息发送失败，请稍后再试');\n      }\n    };\n\n    // 返回上一页\n    const goBack = () => {\n      router.back();\n      stopReconnect();\n      if (socket.value) {\n        socket.value.close();\n      }\n    };\n\n    // 监听路由参数变化\n    watch(() => route.params.userId, newId => {\n      if (newId) {\n        fetchUserInfo(newId);\n      }\n      console.log(\"newId : \", newId);\n    });\n\n    // 获取用户信息\n    const fetchUserInfo = userId => {\n      console.log(\"userId \", userId);\n      console.log(`${API_CONFIG.BASE_URL}/user/info/${userId}`);\n      axios.get(`${API_CONFIG.BASE_URL}/user/info`, {\n        // 修改URL路径\n        params: {\n          id: userId\n        },\n        // 添加查询参数\n        headers: {\n          Authorization: `Bearer ${store.state.token}`\n        }\n      }).then(res => {\n        if (res.data && res.data.id) {\n          console.log(\"res = \", res.data);\n          targetUser.value = res.data;\n          initWebSocket();\n        } else {\n          console.error(\"res : \", res.data);\n          throw new Error('用户信息为空');\n        }\n      }).catch(err => {\n        console.log(\"失败： \", userId);\n        console.error('获取用户信息失败', err);\n        ElMessage.error('获取用户信息失败');\n        router.back();\n      });\n    };\n    onMounted(() => {\n      if (route.params.userId) {\n        fetchUserInfo(route.params.userId);\n      } else {\n        ElMessage.error('未指定聊天对象');\n        router.back();\n      }\n    });\n    onUnmounted(() => {\n      stopReconnect();\n      if (socket.value) {\n        socket.value.close();\n      }\n    });\n    return {\n      targetUser,\n      messages,\n      inputMessage,\n      myAvatar,\n      getFullUrl,\n      formatTime,\n      sendMessage,\n      goBack,\n      messagesContainer,\n      isConnected\n    };\n  }\n};","map":{"version":3,"names":["computed","ref","onMounted","onUnmounted","nextTick","watch","useRoute","useRouter","useStore","defaultAvatar","API_CONFIG","ElMessage","ElNotification","axios","setup","route","router","store","messagesContainer","targetUser","messages","inputMessage","myAvatar","user","state","photo","BASE_URL","socket","isConnected","reconnecting","reconnectTimer","myId","id","getFullUrl","path","startsWith","formatTime","time","date","Date","now","toDateString","toTimeString","substring","yesterday","setDate","getDate","getMonth","initWebSocket","value","wsUrl","URL_CHAT","console","log","close","WebSocket","heartbeatTimer","HEARTBEAT_INTERVAL","sendHeartbeat","readyState","OPEN","send","JSON","stringify","type","from","toISOString","startHeartbeat","stopHeartbeat","setInterval","clearInterval","onopen","title","message","username","duration","loadHistoryMessages","to","onmessage","event","msg","parse","data","addMessage","text","fromMe","message_id","e","error","onclose","code","reason","startReconnect","onerror","errorEvent","exists","some","m","status","push","scrollTop","scrollHeight","get","headers","Authorization","token","then","res","length","map","from_id","created_at","catch","err","warning","setTimeout","stopReconnect","clearTimeout","sendMessage","trim","msgId","messageIndex","findIndex","goBack","back","params","userId","newId","fetchUserInfo","Error"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\views\\ChatView.vue"],"sourcesContent":["<template>\r\n  <div class=\"chat-view\">\r\n    <div class=\"chat-header\">\r\n      <div class=\"back-button\" @click=\"goBack\">\r\n        <i class=\"fa fa-arrow-left\" aria-hidden=\"true\"></i>\r\n      </div>\r\n      <div class=\"chat-title\">{{ targetUser.username || '未知用户' }}</div>\r\n      <div class=\"chat-avatar\">\r\n        <img \r\n          :src=\"getFullUrl(targetUser.photo || defaultAvatar)\" \r\n          alt=\"对方头像\" \r\n          class=\"avatar\" \r\n          onerror=\"this.src='@/assets/default-avatar.png'\"\r\n        />\r\n      </div>\r\n    </div>\r\n    \r\n    <div class=\"chat-messages\" ref=\"messagesContainer\">\r\n      <div v-if=\"messages.length === 0\" class=\"empty-chat\">\r\n        开始和 {{ targetUser.username || '对方' }} 聊天吧\r\n      </div>\r\n      \r\n      <div \r\n        v-for=\"(msg, index) in messages\" \r\n        :key=\"msg.id || index\" \r\n        :class=\"['message-item', msg.fromMe ? 'from-me' : 'from-other']\"\r\n      >\r\n        <div class=\"message-avatar\">\r\n          <img \r\n            :src=\"msg.fromMe ? myAvatar : getFullUrl(targetUser.photo || defaultAvatar)\" \r\n            alt=\"头像\" \r\n            class=\"avatar-sm\" \r\n            onerror=\"this.src='@/assets/default-avatar.png'\"\r\n          />\r\n        </div>\r\n        \r\n        <div class=\"message-content\">\r\n          <div class=\"message-bubble\">{{ msg.text }}</div>\r\n          <div class=\"message-time\">{{ formatTime(msg.time) }}</div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    \r\n    <div class=\"chat-input-area\">\r\n      <div class=\"connection-status\" v-if=\"!isConnected\">\r\n        <i class=\"fa fa-exclamation-triangle\" aria-hidden=\"true\"></i> 未连接\r\n      </div>\r\n      <input \r\n        type=\"text\" \r\n        v-model=\"inputMessage\" \r\n        placeholder=\"输入消息...\" \r\n        @keyup.enter=\"sendMessage\"\r\n        :disabled=\"!isConnected\"\r\n      />\r\n      <button class=\"send-button\" @click=\"sendMessage\" :disabled=\"!isConnected\">\r\n        <i class=\"fa fa-paper-plane\" aria-hidden=\"true\"></i>\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { computed, ref, onMounted, onUnmounted, nextTick, watch } from 'vue';\r\nimport { useRoute, useRouter } from 'vue-router';\r\nimport { useStore } from 'vuex';\r\nimport defaultAvatar from '@/assets/default-avatar.png';\r\nimport { API_CONFIG } from '@/config/config';\r\nimport { ElMessage, ElNotification } from 'element-plus';\r\nimport axios from 'axios';\r\n\r\nexport default {\r\n  setup() {\r\n    const route = useRoute();\r\n    const router = useRouter();\r\n    const store = useStore();\r\n    const messagesContainer = ref(null);\r\n    const targetUser = ref({});\r\n    const messages = ref([]);\r\n    const inputMessage = ref('');\r\n    const myAvatar = computed(() => {\r\n      const user = store.state.user;\r\n      return user.photo ? `${API_CONFIG.BASE_URL}${user.photo}` : defaultAvatar;\r\n    });\r\n    const socket = ref(null);\r\n    const isConnected = ref(false);\r\n    const reconnecting = ref(false);\r\n    const reconnectTimer = ref(null);\r\n    const myId = computed(() => store.state.user.id);\r\n    \r\n    // 工具方法：处理图片URL\r\n    const getFullUrl = (path) => {\r\n      if (!path) return defaultAvatar;\r\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`;\r\n    };\r\n    \r\n    // 工具方法：格式化时间\r\n    const formatTime = (time) => {\r\n      if (!time) return '';\r\n      const date = new Date(time);\r\n      const now = new Date();\r\n      \r\n      if (date.toDateString() === now.toDateString()) {\r\n        return date.toTimeString().substring(0, 5);\r\n      }\r\n      \r\n      const yesterday = new Date();\r\n      yesterday.setDate(now.getDate() - 1);\r\n      if (date.toDateString() === yesterday.toDateString()) {\r\n        return '昨天';\r\n      }\r\n      \r\n      return `${date.getMonth() + 1}/${date.getDate()}`;\r\n    };\r\n    \r\n// 初始化WebSocket连接\r\nconst initWebSocket = () => {\r\n  if (myId.value && targetUser.value.id) {\r\n    const wsUrl = `ws://${API_CONFIG.URL_CHAT}/ws/chat/${myId.value}/${targetUser.value.id}`;\r\n    console.log(\"尝试连接WebSocket:\", wsUrl);\r\n    \r\n    if (socket.value) {\r\n      socket.value.close();\r\n    }\r\n    \r\n    socket.value = new WebSocket(wsUrl);\r\n    \r\n    // 心跳检测相关变量\r\n    let heartbeatTimer = null;\r\n    const HEARTBEAT_INTERVAL = 30000; // 30秒发送一次心跳\r\n    \r\n    // 发送心跳消息\r\n    const sendHeartbeat = () => {\r\n      if (socket.value && socket.value.readyState === WebSocket.OPEN) {\r\n        socket.value.send(JSON.stringify({\r\n          type: 'heartbeat',\r\n          from: myId.value,\r\n          time: new Date().toISOString()\r\n        }));\r\n      }\r\n    };\r\n    \r\n    // 启动心跳检测\r\n    const startHeartbeat = () => {\r\n      stopHeartbeat();\r\n      heartbeatTimer = setInterval(sendHeartbeat, HEARTBEAT_INTERVAL);\r\n    };\r\n    \r\n    // 停止心跳检测\r\n    const stopHeartbeat = () => {\r\n      if (heartbeatTimer) {\r\n        clearInterval(heartbeatTimer);\r\n        heartbeatTimer = null;\r\n      }\r\n    };\r\n    \r\n    socket.value.onopen = () => {\r\n      isConnected.value = true;\r\n      reconnecting.value = false;\r\n      ElNotification({\r\n        title: '连接成功',\r\n        message: `已与 ${targetUser.value.username || '对方'} 建立聊天连接`,\r\n        type: 'success',\r\n        duration: 3000\r\n      });\r\n      \r\n      // 启动心跳检测\r\n      startHeartbeat();\r\n      \r\n      // 连接成功后加载历史消息\r\n      loadHistoryMessages();\r\n      \r\n      // 发送连接确认消息\r\n      socket.value.send(JSON.stringify({\r\n        type: 'connection_ack',\r\n        from: myId.value,\r\n        to: targetUser.value.id,\r\n        time: new Date().toISOString()\r\n      }));\r\n    };\r\n    \r\n    socket.value.onmessage = (event) => {\r\n      try {\r\n        const msg = JSON.parse(event.data);\r\n        \r\n        // 处理心跳响应\r\n        if (msg.type === 'heartbeat') {\r\n          console.log('收到心跳响应');\r\n          return;\r\n        }\r\n        \r\n        // 处理普通消息\r\n        addMessage({\r\n          id: msg.id,\r\n          text: msg.text,\r\n          fromMe: msg.from !== myId.value,\r\n          time: msg.time\r\n        });\r\n        \r\n        // 发送消息已读确认\r\n        if (msg.id && !msg.fromMe) {\r\n          socket.value.send(JSON.stringify({\r\n            type: 'message_read',\r\n            message_id: msg.id,\r\n            from: myId.value,\r\n            to: msg.from,\r\n            time: new Date().toISOString()\r\n          }));\r\n        }\r\n        \r\n      } catch (e) {\r\n        console.error('解析消息失败', e);\r\n        ElMessage.error('接收消息失败');\r\n      }\r\n    };\r\n    \r\n    socket.value.onclose = (event) => {\r\n      isConnected.value = false;\r\n      stopHeartbeat();\r\n      \r\n      console.log('WebSocket连接关闭，状态码:', event.code, '原因:', event.reason);\r\n      \r\n      ElNotification({\r\n        title: '连接断开',\r\n        message: '聊天连接已断开，正在尝试重连...',\r\n        type: 'warning',\r\n        duration: 0\r\n      });\r\n      \r\n      if (!reconnecting.value) {\r\n        startReconnect();\r\n      }\r\n    };\r\n    \r\n    socket.value.onerror = (errorEvent) => {\r\n      console.error('WebSocket错误:', errorEvent);\r\n      ElMessage.error('聊天连接错误，请检查网络连接');\r\n    };\r\n  }\r\n};\r\n    // 添加消息到列表\r\nconst addMessage = (msg) => {\r\n  // 检查消息是否已存在（避免重复添加）\r\n  const exists = messages.value.some(m => m.id === msg.id);\r\n  if (exists) return;\r\n  \r\n  // 添加消息状态（如果没有提供）\r\n  if (!msg.status) {\r\n    msg.status = 'received';\r\n  }\r\n  \r\n  messages.value.push(msg);\r\n  \r\n  nextTick(() => {\r\n    if (messagesContainer.value) {\r\n      messagesContainer.value.scrollTop = messagesContainer.value.scrollHeight;\r\n    }\r\n  });\r\n};\r\n    // 加载历史消息\r\n    const loadHistoryMessages = () => {\r\n      if (myId.value && targetUser.value.id) {\r\n        axios.get(`${API_CONFIG.BASE_URL}/chat/history/${myId.value}/${targetUser.value.id}`, {\r\n          headers: { Authorization: `Bearer ${store.state.token}` }\r\n        })\r\n        .then(res => {\r\n          if (res.data && res.data.length) {\r\n            messages.value = res.data.map(msg => ({\r\n              id: msg.id,\r\n              text: msg.text,\r\n              fromMe: msg.from_id !== myId.value,\r\n              time: msg.created_at\r\n            }));\r\n            \r\n            nextTick(() => {\r\n              if (messagesContainer.value) {\r\n                messagesContainer.value.scrollTop = messagesContainer.value.scrollHeight;\r\n              }\r\n            });\r\n          }\r\n        })\r\n        .catch(err => {\r\n          console.error('加载历史消息失败', err);\r\n          ElMessage.warning('历史消息加载失败');\r\n        });\r\n      }\r\n    };\r\n    \r\n// 开始重连\r\nconst startReconnect = () => {\r\n  if (reconnecting.value || !targetUser.value.id) return;\r\n  \r\n  reconnecting.value = true;\r\n  console.log('尝试重连WebSocket...');\r\n  \r\n  reconnectTimer.value = setTimeout(() => {\r\n    initWebSocket();\r\n    reconnecting.value = false;\r\n  }, 3000); // 3秒后尝试重连\r\n};\r\n    \r\n    // 停止重连\r\n    const stopReconnect = () => {\r\n      if (reconnectTimer.value) {\r\n        clearTimeout(reconnectTimer.value);\r\n        reconnectTimer.value = null;\r\n        reconnecting.value = false;\r\n      }\r\n    };\r\n    \r\n// 发送消息\r\nconst sendMessage = () => {\r\n  if (!inputMessage.value.trim()) return;\r\n  \r\n  if (!isConnected.value) {\r\n    ElMessage.warning('当前连接已断开，无法发送消息');\r\n    return;\r\n  }\r\n  \r\n  const msgId = Date.now(); // 生成唯一消息ID\r\n  const msg = {\r\n    id: msgId,\r\n    text: inputMessage.value.trim(),\r\n    from: myId.value,\r\n    to: targetUser.value.id,\r\n    type: 'text',\r\n    time: new Date().toISOString()\r\n  };\r\n  \r\n  addMessage({\r\n    id: msgId,\r\n    text: msg.tex