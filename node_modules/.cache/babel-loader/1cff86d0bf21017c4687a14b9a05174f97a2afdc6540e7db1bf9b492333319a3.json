{"ast":null,"code":"import \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.for-each.js\";\nimport { ref, reactive, onMounted, watch } from 'vue';\nimport axios from 'axios';\nimport { API_CONFIG } from './config';\n\n// 用户数据\n\nexport default {\n  __name: 'BigdataUser',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const users = ref([]);\n    const loading = ref(false);\n    const error = ref(null);\n\n    // 查询参数\n    const searchParams = reactive({\n      name: '',\n      idno: '',\n      sex: '',\n      province: '',\n      min_age: null,\n      max_age: null\n    });\n\n    // 分页参数\n    const pagination = reactive({\n      page: 1,\n      page_size: 100,\n      total: 0,\n      total_pages: 1\n    });\n\n    // 格式化生日显示\n    const formatBirthday = birthday => {\n      if (!birthday) return '-';\n      const dateStr = birthday.toString();\n      if (dateStr.length === 8) {\n        return `${dateStr.substring(0, 4)}-${dateStr.substring(4, 6)}-${dateStr.substring(6, 8)}`;\n      }\n      return birthday;\n    };\n\n    // 获取数据\n    const fetchData = async () => {\n      try {\n        loading.value = true;\n        error.value = null;\n        const params = {\n          ...searchParams,\n          page: pagination.page,\n          page_size: pagination.page_size\n        };\n\n        // 清除空参数\n        Object.keys(params).forEach(key => {\n          if (params[key] === '' || params[key] === null) {\n            delete params[key];\n          }\n        });\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/bigdata/bigdata-users`, {\n          params\n        });\n        users.value = response.data.data;\n        pagination.total = response.data.total;\n        pagination.total_pages = Math.ceil(response.data.total / pagination.page_size);\n      } catch (err) {\n        console.error('获取数据失败:', err);\n        error.value = err.response?.data?.detail || err.message || '获取数据失败';\n      } finally {\n        loading.value = false;\n      }\n    };\n\n    // 重置查询\n    const resetSearch = () => {\n      Object.assign(searchParams, {\n        name: '',\n        idno: '',\n        sex: '',\n        province: '',\n        min_age: null,\n        max_age: null\n      });\n      pagination.page = 1;\n      fetchData();\n    };\n\n    // 分页操作\n    const prevPage = () => {\n      if (pagination.page > 1) {\n        pagination.page--;\n        fetchData();\n      }\n    };\n    const nextPage = () => {\n      if (pagination.page < pagination.total_pages) {\n        pagination.page++;\n        fetchData();\n      }\n    };\n    const handlePageSizeChange = () => {\n      pagination.page = 1;\n      fetchData();\n    };\n\n    // 监听查询参数变化，实时触发查询\n    watch(searchParams, (newParams, oldParams) => {\n      // 这里添加防抖或节流逻辑可以优化频繁查询的性能问题\n      // 简单起见，这里直接触发查询\n      fetchData();\n    }, {\n      deep: true\n    });\n\n    // 初始化加载数据\n    onMounted(() => {\n      fetchData();\n    });\n    const __returned__ = {\n      users,\n      loading,\n      error,\n      searchParams,\n      pagination,\n      formatBirthday,\n      fetchData,\n      resetSearch,\n      prevPage,\n      nextPage,\n      handlePageSizeChange,\n      ref,\n      reactive,\n      onMounted,\n      watch,\n      get axios() {\n        return axios;\n      },\n      get API_CONFIG() {\n        return API_CONFIG;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","reactive","onMounted","watch","axios","API_CONFIG","users","loading","error","searchParams","name","idno","sex","province","min_age","max_age","pagination","page","page_size","total","total_pages","formatBirthday","birthday","dateStr","toString","length","substring","fetchData","value","params","Object","keys","forEach","key","response","get","BASE_URL","data","Math","ceil","err","console","detail","message","resetSearch","assign","prevPage","nextPage","handlePageSizeChange","newParams","oldParams","deep"],"sources":["E:/vue_fastapi/my_vue/my_vue/src/views/BigdataUser.vue"],"sourcesContent":["<template>\r\n  <div class=\"bigdata-container\">\r\n    <!-- 查询表单 -->\r\n    <div class=\"search-card\">\r\n      <h2>大数据用户查询</h2>\r\n      <div class=\"search-form\">\r\n        <div class=\"form-group\">\r\n          <label>姓名：</label>\r\n          <input v-model=\"searchParams.name\" placeholder=\"输入姓名\" />\r\n        </div>\r\n        <div class=\"form-group\">\r\n          <label>证件号：</label>\r\n          <input v-model=\"searchParams.idno\" placeholder=\"输入证件号\" />\r\n        </div>\r\n        <div class=\"form-group\">\r\n          <label>性别：</label>\r\n          <select v-model=\"searchParams.sex\">\r\n            <option value=\"\">全部</option>\r\n            <option value=\"男\">男</option>\r\n            <option value=\"女\">女</option>\r\n          </select>\r\n        </div>\r\n        <div class=\"form-group\">\r\n          <label>省份：</label>\r\n          <input v-model=\"searchParams.province\" placeholder=\"输入省份\" />\r\n        </div>\r\n        <div class=\"form-group age-range\">\r\n          <label>年龄范围：</label>\r\n          <input \r\n            v-model.number=\"searchParams.min_age\" \r\n            type=\"number\" \r\n            placeholder=\"最小\" \r\n            min=\"0\"\r\n          />\r\n          <span>-</span>\r\n          <input \r\n            v-model.number=\"searchParams.max_age\" \r\n            type=\"number\" \r\n            placeholder=\"最大\" \r\n            min=\"0\"\r\n          />\r\n        </div>\r\n        <button class=\"search-btn\" @click=\"fetchData\">查询</button>\r\n        <button class=\"reset-btn\" @click=\"resetSearch\">重置</button>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- 数据表格 -->\r\n    <div class=\"data-table\">\r\n      <div v-if=\"loading\" class=\"loading\">加载中...</div>\r\n      <div v-else-if=\"error\" class=\"error\">\r\n        {{ error }}\r\n        <button @click=\"fetchData\">重试</button>\r\n      </div>\r\n      <template v-else>\r\n        <table>\r\n          <thead>\r\n            <tr>\r\n              <th>姓名</th>\r\n              <th>证件号</th>\r\n              <th>性别</th>\r\n              <th>出生地</th>\r\n              <th>证件类型</th>\r\n              <th>省份</th>\r\n              <th>年龄</th>\r\n              <th>生日</th>\r\n            </tr>\r\n          </thead>\r\n          <tbody>\r\n            <tr v-for=\"user in users\" :key=\"user.idno\">\r\n              <td>{{ user.name || '-' }}</td>\r\n              <td>{{ user.idno || '-' }}</td>\r\n              <td>{{ user.sex || '-' }}</td>\r\n              <td>{{ user.bplace || '-' }}</td>\r\n              <td>{{ user.idtype || '-' }}</td>\r\n              <td>{{ user.province || '-' }}</td>\r\n              <td>{{ user.age ?? '-' }}</td>\r\n              <td>{{ formatBirthday(user.birthday) }}</td>\r\n            </tr>\r\n          </tbody>\r\n        </table>\r\n\r\n        <!-- 分页控件 -->\r\n        <div class=\"pagination\">\r\n          <button \r\n            @click=\"prevPage\" \r\n            :disabled=\"pagination.page === 1\"\r\n          >\r\n            上一页\r\n          </button>\r\n          <span class=\"page-info\">\r\n            第 {{ pagination.page }} 页 / 共 {{ pagination.total_pages }} 页 \r\n            (共 {{ pagination.total }} 条记录)\r\n          </span>\r\n          <button \r\n            @click=\"nextPage\" \r\n            :disabled=\"pagination.page >= pagination.total_pages\"\r\n          >\r\n            下一页\r\n          </button>\r\n          <select v-model=\"pagination.page_size\" @change=\"handlePageSizeChange\">\r\n            <option value=\"50\">50条/页</option>\r\n            <option value=\"100\">100条/页</option>\r\n            <option value=\"200\">200条/页</option>\r\n          </select>\r\n        </div>\r\n      </template>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script setup>\r\nimport { ref, reactive, onMounted, watch } from 'vue'\r\nimport axios from 'axios'\r\nimport { API_CONFIG } from './config';\r\n\r\n// 用户数据\r\nconst users = ref([])\r\nconst loading = ref(false)\r\nconst error = ref(null)\r\n\r\n// 查询参数\r\nconst searchParams = reactive({\r\n  name: '',\r\n  idno: '',\r\n  sex: '',\r\n  province: '',\r\n  min_age: null,\r\n  max_age: null\r\n})\r\n\r\n// 分页参数\r\nconst pagination = reactive({\r\n  page: 1,\r\n  page_size: 100,\r\n  total: 0,\r\n  total_pages: 1\r\n})\r\n\r\n// 格式化生日显示\r\nconst formatBirthday = (birthday) => {\r\n  if (!birthday) return '-'\r\n  const dateStr = birthday.toString()\r\n  if (dateStr.length === 8) {\r\n    return `${dateStr.substring(0,4)}-${dateStr.substring(4,6)}-${dateStr.substring(6,8)}`\r\n  }\r\n  return birthday\r\n}\r\n\r\n// 获取数据\r\nconst fetchData = async () => {\r\n  try {\r\n    loading.value = true\r\n    error.value = null\r\n    \r\n    const params = {\r\n      ...searchParams,\r\n      page: pagination.page,\r\n      page_size: pagination.page_size\r\n    }\r\n\r\n    // 清除空参数\r\n    Object.keys(params).forEach(key => {\r\n      if (params[key] === '' || params[key] === null) {\r\n        delete params[key]\r\n      }\r\n    })\r\n\r\n    const response = await axios.get(`${API_CONFIG.BASE_URL}/bigdata/bigdata-users`, { params })\r\n    users.value = response.data.data\r\n    pagination.total = response.data.total\r\n    pagination.total_pages = Math.ceil(response.data.total / pagination.page_size)\r\n    \r\n  } catch (err) {\r\n    console.error('获取数据失败:', err)\r\n    error.value = err.response?.data?.detail || err.message || '获取数据失败'\r\n  } finally {\r\n    loading.value = false\r\n  }\r\n}\r\n\r\n// 重置查询\r\nconst resetSearch = () => {\r\n  Object.assign(searchParams, {\r\n    name: '',\r\n    idno: '',\r\n    sex: '',\r\n    province: '',\r\n    min_age: null,\r\n    max_age: null\r\n  })\r\n  pagination.page = 1\r\n  fetchData()\r\n}\r\n\r\n// 分页操作\r\nconst prevPage = () => {\r\n  if (pagination.page > 1) {\r\n    pagination.page--\r\n    fetchData()\r\n  }\r\n}\r\n\r\nconst nextPage = () => {\r\n  if (pagination.page < pagination.total_pages) {\r\n    pagination.page++\r\n    fetchData()\r\n  }\r\n}\r\n\r\nconst handlePageSizeChange = () => {\r\n  pagination.page = 1\r\n  fetchData()\r\n}\r\n\r\n// 监听查询参数变化，实时触发查询\r\nwatch(searchParams, (newParams, oldParams) => {\r\n  // 这里添加防抖或节流逻辑可以优化频繁查询的性能问题\r\n  // 简单起见，这里直接触发查询\r\n  fetchData()\r\n}, { deep: true })\r\n\r\n// 初始化加载数据\r\nonMounted(() => {\r\n  fetchData()\r\n})\r\n</script>\r\n\r\n<style scoped>\r\n.bigdata-container {\r\n  max-width: 1200px;\r\n  margin: 0 auto;\r\n  padding: 20px;\r\n  font-family: 'Arial', sans-serif;\r\n}\r\n\r\n.search-card {\r\n  background: #f5f7fa;\r\n  padding: 20px;\r\n  border-radius: 8px;\r\n  margin-bottom: 20px;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.search-card h2 {\r\n  margin-top: 0;\r\n  color: #333;\r\n  border-bottom: 1px solid #e6e6e6;\r\n  padding-bottom: 10px;\r\n}\r\n\r\n.search-form {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));\r\n  gap: 15px;\r\n  align-items: end;\r\n}\r\n\r\n.form-group {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.form-group label {\r\n  margin-bottom: 5px;\r\n  font-weight: bold;\r\n  color: #666;\r\n}\r\n\r\n.form-group input,\r\n.form-group select {\r\n  padding: 8px 12px;\r\n  border: 1px solid #dcdfe6;\r\n  border-radius: 4px;\r\n  font-size: 14px;\r\n}\r\n\r\n.age-range {\r\n  display: flex;\r\n  flex-direction: row;\r\n  align-items: center;\r\n  gap: 5px;\r\n}\r\n\r\n.age-range input {\r\n  width: 60px;\r\n}\r\n\r\n.search-btn, .reset-btn {\r\n  padding: 8px 16px;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n  font-size: 14px;\r\n}\r\n\r\n.search-btn {\r\n  background-color: #409eff;\r\n  color: white;\r\n}\r\n\r\n.search-btn:hover {\r\n  background-color: #66b1ff;\r\n}\r\n\r\n.reset-btn {\r\n  background-color: #f5f5f5;\r\n  color: #666;\r\n  margin-left: 10px;\r\n}\r\n\r\n.reset-btn:hover {\r\n  background-color: #e6e6e6;\r\n}\r\n\r\n.data-table {\r\n  background: white;\r\n  border-radius: 8px;\r\n  padding: 20px;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.loading, .error {\r\n  text-align: center;\r\n  padding: 20px;\r\n  color: #666;\r\n}\r\n\r\n.error {\r\n  color: #f56c6c;\r\n}\r\n\r\n.error button {\r\n  margin-top: 10px;\r\n  padding: 5px 10px;\r\n  background: #f56c6c;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n}\r\n\r\ntable {\r\n  width: 100%;\r\n  border-collapse: collapse;\r\n  margin-bottom: 20px;\r\n}\r\n\r\nth, td {\r\n  padding: 12px 15px;\r\n  text-align: left;\r\n  border-bottom: 1px solid #ebeef5;\r\n}\r\n\r\nth {\r\n  background-color: #f5f7fa;\r\n  color: #333;\r\n  font-weight: bold;\r\n}\r\n\r\ntr:hover {\r\n  background-color: #f5f7fa;\r\n}\r\n\r\n.pagination {\r\n  display: flex;\r\n  justify-content: center;\r\n  align-items: center;\r\n  gap: 15px;\r\n  margin-top: 20px;\r\n}\r\n\r\n.pagination button {\r\n  padding: 6px 12px;\r\n  background: white;\r\n  border: 1px solid #dcdfe6;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n}\r\n\r\n.pagination button:disabled {\r\n  color: #c0c4cc;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.pagination select {\r\n  padding: 6px;\r\n  border: 1px solid #dcdfe6;\r\n  border-radius: 4px;\r\n}\r\n\r\n.page-info {\r\n  color: #666;\r\n}\r\n\r\n@media (max-width: 768px) {\r\n  .search-form {\r\n    grid-template-columns: 1fr;\r\n  }\r\n  \r\n  table {\r\n    display: block;\r\n    overflow-x: auto;\r\n  }\r\n}\r\n</style>"],"mappings":";;AAgHA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,EAAEC,KAAK,QAAQ,KAAK;AACrD,OAAOC,KAAK,MAAM,OAAO;AACzB,SAASC,UAAU,QAAQ,UAAU;;AAErC;;;;;;;;IACA,MAAMC,KAAK,GAAGN,GAAG,CAAC,EAAE,CAAC;IACrB,MAAMO,OAAO,GAAGP,GAAG,CAAC,KAAK,CAAC;IAC1B,MAAMQ,KAAK,GAAGR,GAAG,CAAC,IAAI,CAAC;;IAEvB;IACA,MAAMS,YAAY,GAAGR,QAAQ,CAAC;MAC5BS,IAAI,EAAE,EAA