isted_1","_createElementVNode","_hoisted_2","_createCommentVNode","_hoisted_3","_hoisted_4","type","accept","onChange","$setup","handleAvatarUpload","hidden","src","editableUser","photo","_ctx","defaultAvatar","alt","_hoisted_5","_hoisted_6","_hoisted_7","_cache","$event","username","_hoisted_8","sex","value","_hoisted_9","_hoisted_10","phone","readonly","isPhoneEditable","onDblclick","startPhoneEdit","onBlur","handlePhoneBlur","_hoisted_11","_hoisted_12","_hoisted_13","smsCode","placeholder","disabled","countdown","onClick","sendSmsCode","_hoisted_14","_hoisted_15","email","_hoisted_16","description","_hoisted_17","generateQRWithAvatar","qrcodeUrl","defaultQR","_hoisted_18","saveUserInfo"],"sources":["E:\\vue_learn\\ai_vue\\ai_vue\\src\\views\\UserDetail.vue"],"sourcesContent":["<template>\r\n    <div class=\"user-detail-page\">\r\n      <h1 class=\"page-title\">用户详情</h1>\r\n      <div class=\"user-container\">\r\n        <!-- 可编辑头像 -->\r\n        <div class=\"avatar-wrapper\">\r\n          <label class=\"avatar-upload\">\r\n            <input \r\n              type=\"file\" \r\n              accept=\"image/*\" \r\n              @change=\"handleAvatarUpload\" \r\n              hidden\r\n            />\r\n            <img \r\n              :src=\"editableUser.photo || defaultAvatar\" \r\n              alt=\"用户头像\" \r\n              class=\"user-avatar\"\r\n            />\r\n            <span class=\"edit-tip\">点击更换头像</span>\r\n          </label>\r\n        </div>\r\n  \r\n        <!-- 用户信息编辑 -->\r\n        <div class=\"info-section\">\r\n          <div class=\"info-item\">\r\n            <label>姓名：</label>\r\n            <input v-model=\"editableUser.username\" class=\"short-input\" />\r\n          </div>\r\n          \r\n          <div class=\"info-item\">\r\n            <label>性别：</label>\r\n            <select v-model=\"editableUser.sex\">\r\n              <option value=\"男\">男</option>\r\n              <option value=\"女\">女</option>\r\n            </select>\r\n          </div>\r\n  \r\n          <div class=\"info-item\">\r\n            <label>手机：</label>\r\n            <div class=\"phone-edit-wrapper\">\r\n              <input\r\n                v-model=\"editableUser.phone\"\r\n                :readonly=\"!isPhoneEditable\"\r\n                class=\"short-input\"\r\n                @dblclick=\"startPhoneEdit\"\r\n                @blur=\"handlePhoneBlur\"\r\n              />\r\n              <span v-if=\"!isPhoneEditable\" class=\"edit-hint\">(双击修改)</span>\r\n              \r\n              <div v-if=\"isPhoneEditable\" class=\"sms-verify\">\r\n                <input\r\n                  v-model=\"smsCode\"\r\n                  placeholder=\"请输入验证码\"\r\n                  class=\"sms-input\"\r\n                />\r\n                <button \r\n                  class=\"sms-btn\"\r\n                  :disabled=\"countdown > 0\"\r\n                  @click=\"sendSmsCode\"\r\n                >\r\n                  {{ countdown > 0 ? `${countdown}s后重试` : '获取验证码' }}\r\n                </button>\r\n              </div>\r\n            </div>\r\n          </div>\r\n  \r\n          <div class=\"info-item\">\r\n            <label>邮箱：</label>\r\n            <input v-model=\"editableUser.email\" class=\"short-input\" />\r\n          </div>\r\n  \r\n          <div class=\"info-item\">\r\n            <label>描述：</label>\r\n            <input v-model=\"editableUser.description\" class=\"short-input\" />\r\n          </div>\r\n  \r\n          <!-- 二维码展示 -->\r\n          <div class=\"info-item\">\r\n            <label class=\"qr-label\">我的二维码：</label>\r\n            <div class=\"qr-wrapper\" @click=\"generateQRWithAvatar\">\r\n              <img \r\n                :src=\"qrcodeUrl || defaultQR\" \r\n                alt=\"个人二维码\" \r\n                class=\"wechat-qr\"\r\n              />\r\n            </div>\r\n          </div>\r\n        </div>\r\n  \r\n        <button class=\"save-btn\" @click=\"saveUserInfo\">保存修改</button>\r\n      </div>\r\n    </div>\r\n  </template>\r\n  \r\n  <script setup>\r\n  import { ref, nextTick, onBeforeUnmount } from 'vue'\r\n  import { useStore } from 'vuex'\r\n  import axios from 'axios'\r\n  \r\n  const store = useStore()\r\n  \r\n  // 响应式数据\r\n  const editableUser = ref({\r\n    ...store.state.user,\r\n    description: store.state.user.description || ''\r\n  })\r\n  const qrcodeUrl = ref('')\r\n  const isPhoneEditable = ref(false)\r\n  const smsCode = ref('')\r\n  const countdown = ref(0)\r\n  let timer = null\r\n  \r\n  // 生命周期钩子\r\n  onBeforeUnmount(() => {\r\n    if (timer) clearInterval(timer)\r\n  })\r\n  \r\n  // 手机号编辑逻辑\r\n  const startPhoneEdit = async () => {\r\n    if (!isPhoneEditable.value) {\r\n      isPhoneEditable.value = true\r\n      await nextTick()\r\n      document.querySelector('.sms-input')?.focus()\r\n    }\r\n  }\r\n  \r\n  const handlePhoneBlur = () => {\r\n    if (smsCode.value === '') {\r\n      isPhoneEditable.value = false\r\n    }\r\n  }\r\n  \r\n  // 发送短信验证码\r\n  const sendSmsCode = async () => {\r\n    try {\r\n      const response = await axios.post('/user/send-sms', {\r\n        phone: editableUser.value.phone\r\n      })\r\n      \r\n      if (response.data.message === '验证码已发送') {\r\n        countdown.value = 60\r\n        timer = setInterval(() => {\r\n          countdown.value--\r\n          if (countdown.value <= 0) clearInterval(timer)\r\n        }, 1000)\r\n      }\r\n    } catch (error) {\r\n      alert(error.response?.data?.detail || '验证码发送失败')\r\n    }\r\n  }\r\n  \r\n  // 头像上传处理\r\n  const handleAvatarUpload = async (event) => {\r\n    const file = event.target.files?.[0]\r\n    if (file && file.type.startsWith('image/')) {\r\n      try {\r\n        const formData = new FormData()\r\n        formData.append('file', file)\r\n        \r\n        const response = await axios.post('/user/upload-avatar', formData, {\r\n          headers: { 'Content-Type': 'multipart/form-data' }\r\n        })\r\n  \r\n        editableUser.value.photo = response.data.url\r\n        await generateQRWithAvatar()\r\n      } catch (error) {\r\n        alert('头像上传失败，请重试')\r\n      }\r\n    }\r\n  }\r\n  \r\n  // 生成二维码\r\n  const generateQRWithAvatar = async () => {\r\n    try {\r\n      const response = await axios.post('/user/generate-qrcode', {\r\n        username: editableUser.value.username,\r\n        phone: editableUser.value.phone,\r\n        avatar_url: editableUser.value.photo\r\n      })\r\n  \r\n      qrcodeUrl.value = response.data.qrcode_url\r\n      await store.dispatch('updateUser', {\r\n        ...editableUser.value,\r\n        qrcode: response.data.qrcode_url\r\n      })\r\n    } catch (error) {\r\n      alert('二维码生成失败，请重试')\r\n    }\r\n  }\r\n  \r\n  // 保存用户信息\r\n  const saveUserInfo = async () => {\r\n    try {\r\n      // 手机号修改需要验证\r\n      if (isPhoneEditable.value) {\r\n        if (!smsCode.value) {\r\n          alert('请先完成短信验证')\r\n          return\r\n        }\r\n  \r\n        await axios.post('/user/update-phone', {\r\n          new_phone: editableUser.value.phone,\r\n          verification_code: smsCode.value\r\n        })\r\n      }\r\n  \r\n      // 更新其他信息\r\n      await axios.put('/user/info', editableUser.value)\r\n      \r\n      // 更新本地存储\r\n      await store.dispatch('updateUser', editableUser.value)\r\n      isPhoneEditable.value = false\r\n      alert('信息保存成功!')\r\n    } catch (error) {\r\n      alert(error.response?.data?.detail || '保存失败，请检查输入')\r\n    }\r\n  }\r\n  </script>\r\n  \r\n  <style scoped>\r\n  /* 保持原有所有样式不变 */\r\n  .user-detail-page {\r\n    max-width: 600px;\r\n    margin: 0 auto;\r\n    padding: 2rem;\r\n    font-family: 'Helvetica Neue', Arial, sans-serif;\r\n  }\r\n  \r\n  .page-title {\r\n    text-align: center;\r\n    font-size: 1.5rem;\r\n    color: #333;\r\n    margin-bottom: 2rem;\r\n  }\r\n  \r\n  .user-container {\r\n    background: #fff;\r\n    border-radius: 12px;\r\n    padding: 1.5rem;\r\n    box-shadow: 0 2px 8px rgba(0,0,0,0.1);\r\n  }\r\n  \r\n  .avatar-wrapper {\r\n    text-align: center;\r\n    margin-bottom: 1.5rem;\r\n  }\r\n  \r\n  .user-avatar {\r\n    width: 100px;\r\n    height: 100px;\r\n    border-radius: 50%;\r\n    border: 3px solid #07c160;\r\n    cursor: pointer;\r\n    transition: transform 0.3s ease;\r\n  }\r\n  \r\n  .user-avatar:hover {\r\n    transform: scale(1.05);\r\n  }\r\n  \r\n  .edit-tip {\r\n    display: block;\r\n    color: #666;\r\n    font-size: 0.8rem;\r\n    margin-top: 0.5rem;\r\n  }\r\n  \r\n  .info-section {\r\n    display: flex;\r\n    flex-direction: column;\r\n    gap: 1rem;\r\n  }\r\n  \r\n  .info-item {\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 1rem;\r\n  }\r\n  \r\n  .info-item label {\r\n    flex: 0 0 100px;\r\n    text-align: left;\r\n    color: #666;\r\n    font-size: 0.9rem;\r\n    margin-right: 15px;\r\n  }\r\n  \r\n  .short-input, select {\r\n    flex: 1;\r\n    padding: 0.5rem;\r\n    border: 1px solid #ddd;\r\n    border-radius: 4px;\r\n    max-width: 300px;\r\n    font-size: 0.9rem;\r\n  }\r\n  \r\n  select {\r\n    background: white;\r\n    cursor: pointer;\r\n  }\r\n  \r\n  .qr-wrapper {\r\n    flex: 1;\r\n    cursor: pointer;\r\n  }\r\n  \r\n  .wechat-qr {\r\n    width: 160px;\r\n    height: 160px;\r\n    border: 3px solid #07c160;\r\n    border-radius: 8px;\r\n    padding: 5px;\r\n    background: white;\r\n    transition: transform 0.3s ease;\r\n  }\r\n  \r\n  .wechat-qr:hover {\r\n    transform: scale(1.05);\r\n  }\r\n  \r\n  .save-btn {\r\n    display: block;\r\n    width: 200px;\r\n    padding: 0.8rem;\r\n    margin: 2rem auto 0;\r\n    background: #07c160;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 25px;\r\n    cursor: pointer;\r\n    font-size: 1rem;\r\n    transition: background 0.3s ease;\r\n  }\r\n  \r\n  .save-btn:hover {\r\n    background: #05964d;\r\n  }\r\n  \r\n  @media (max-width: 480px) {\r\n    .user-container {\r\n      padding: 1rem;\r\n    }\r\n  \r\n    .info-item {\r\n      flex-direction: column;\r\n      align-items: flex-start;\r\n    }\r\n  \r\n    .info-item label {\r\n      text-align: left;\r\n      flex: none;\r\n    }\r\n  \r\n    .short-input, select {\r\n      max-width: 100%;\r\n      width: 100%;\r\n    }\r\n  \r\n    .wechat-qr {\r\n      width: 140px;\r\n      height: 140px;\r\n    }\r\n  }\r\n  \r\n  /* 手机号编辑相关样式 */\r\n  .phone-edit-wrapper {\r\n    position: relative;\r\n    flex: 1;\r\n  }\r\n  \r\n  .edit-hint {\r\n    color: #999;\r\n    font-size: 0.8rem;\r\n    margin-left: 10px;\r\n  }\r\n  \r\n  .sms-verify {\r\n    margin-top: 10px;\r\n    display: flex;\r\n    gap: 10px;\r\n  }\r\n  \r\n  .sms-input {\r\n    flex: 1;\r\n    max-width: 150px;\r\n    padding: 8px;\r\n    border: 1px solid #ddd;\r\n    border-radius: 4px;\r\n  }\r\n  \r\n  .sms-btn {\r\n    padding: 8px 15px;\r\n    background: #07c160;\r\n    color: white;\r\n    border: none;\r\n    border-radius: 4px;\r\n    cursor: pointer;\r\n  }\r\n  \r\n  .sms-btn:disabled {\r\n    background: #ccc;\r\n    cursor: not-allowed;\r\n  }\r\n  \r\n  input:read-only {\r\n    background-color: #f5f5f5;\r\n    cursor: not-allowed;\r\n  }\r\n  </style>"],"mappings":";;EACSA,KAAK,EAAC;AAAkB;;EAEtBA,KAAK,EAAC;AAAgB;;EAEpBA,KAAK,EAAC;AAAgB;;EAClBA,KAAK,EAAC;AAAe;mBANtC;;EAuBaA,KAAK,EAAC;AAAc;;EAClBA,KAAK,EAAC;AAAW;;EAKjBA,KAAK,EAAC;AAAW;;EAQjBA,KAAK,EAAC;AAAW;;EAEfA,KAAK,EAAC;AAAoB;oBAvC3C;;EAAAC,GAAA;EA+C4CD,KAAK,EAAC;;;EA/ClDC,GAAA;EAiD0CD,KAAK,EAAC;;oBAjDhD;;EAkEeA,KAAK,EAAC;AAAW;;EAKjBA,KAAK,EAAC;AAAW;;EAMjBA,KAAK,EAAC;AAAW;oBA7EhC;;uBACIE,mBAAA,CA0FM,OA1FNC,UA0FM,G,4BAzFJC,mBAAA,CAAgC;IAA5BJ,KAAK,EAAC;EAAY,GAAC,MAAI,sBAC3BI,mBAAA,CAuFM,OAvFNC,UAuFM,GAtFJC,mBAAA,WAAc,EACdF,mBAAA,CAeM,OAfNG,UAeM,GAdJH,mBAAA,CAaQ,SAbRI,UAaQ,GAZNJ,mBAAA,CAKE;IAJAK,IAAI,EAAC,MAAM;IACXC,MAAM,EAAC,SAAS;IACfC,QAAM,EAAEC,MAAA,CAAAC,kBAAkB;IAC3BC,MAAM,EAAN;qCAEFV,mBAAA,CAIE;IAHCW,GAAG,EAAEH,MAAA,CAAAI,YAAY,CAACC,KAAK,IAAIC,IAAA,CAAAC,aAAa;IACzCC,GAAG,EAAC,MAAM;IACVpB,KAAK,EAAC;0BAhBpBqB,UAAA,G,0BAkBYjB,mBA