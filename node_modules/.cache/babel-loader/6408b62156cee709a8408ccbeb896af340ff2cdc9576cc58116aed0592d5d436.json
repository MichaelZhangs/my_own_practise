ck(), _createElementBlock(\"div\", _hoisted_7, \" 开始和 \" + _toDisplayString($setup.targetUser.username || '对方') + \" 聊天吧 \", 1 /* TEXT */)) : _createCommentVNode(\"v-if\", true), (_openBlock(true), _createElementBlock(_Fragment, null, _renderList($setup.messages, (msg, index) => {\n    return _openBlock(), _createElementBlock(\"div\", {\n      key: msg.id || index,\n      class: _normalizeClass(['message-item', msg.fromMe ? 'from-me' : 'from-other'])\n    }, [_createElementVNode(\"div\", _hoisted_8, [_createElementVNode(\"img\", {\n      src: msg.fromMe ? $setup.myAvatar : $setup.getFullUrl($setup.targetUser.photo),\n      alt: \"头像\",\n      class: \"avatar-sm\"\n    }, null, 8 /* PROPS */, _hoisted_9)]), _createElementVNode(\"div\", _hoisted_10, [_createElementVNode(\"div\", _hoisted_11, _toDisplayString(msg.text), 1 /* TEXT */), _createElementVNode(\"div\", _hoisted_12, _toDisplayString($setup.formatTime(msg.time)), 1 /* TEXT */)])], 2 /* CLASS */);\n  }), 128 /* KEYED_FRAGMENT */))], 512 /* NEED_PATCH */), _createElementVNode(\"div\", _hoisted_13, [_withDirectives(_createElementVNode(\"input\", {\n    type: \"text\",\n    \"onUpdate:modelValue\": _cache[1] || (_cache[1] = $event => $setup.inputMessage = $event),\n    placeholder: \"输入消息...\",\n    onKeyup: _cache[2] || (_cache[2] = _withKeys((...args) => $setup.sendMessage && $setup.sendMessage(...args), [\"enter\"]))\n  }, null, 544 /* NEED_HYDRATION, NEED_PATCH */), [[_vModelText, $setup.inputMessage]]), _createElementVNode(\"button\", {\n    class: \"send-button\",\n    onClick: _cache[3] || (_cache[3] = (...args) => $setup.sendMessage && $setup.sendMessage(...args))\n  }, _cache[5] || (_cache[5] = [_createElementVNode(\"i\", {\n    class: \"fa fa-paper-plane\",\n    \"aria-hidden\": \"true\"\n  }, null, -1 /* HOISTED */)]))])]);\n}","map":{"version":3,"names":["class","ref","key","_createElementBlock","_hoisted_1","_createElementVNode","_hoisted_2","onClick","_cache","args","$setup","goBack","_hoisted_3","_toDisplayString","targetUser","username","_hoisted_4","src","getFullUrl","photo","alt","_hoisted_5","_hoisted_6","messages","length","_hoisted_7","_createCommentVNode","_Fragment","_renderList","msg","index","id","_normalizeClass","fromMe","_hoisted_8","myAvatar","_hoisted_9","_hoisted_10","_hoisted_11","text","_hoisted_12","formatTime","time","_hoisted_13","type","$event","inputMessage","placeholder","onKeyup","_withKeys","sendMessage"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\views\\ChatView.vue"],"sourcesContent":["<template>\r\n  <div class=\"chat-view\">\r\n    <div class=\"chat-header\">\r\n      <div class=\"back-button\" @click=\"goBack\">\r\n        <i class=\"fa fa-arrow-left\" aria-hidden=\"true\"></i>\r\n      </div>\r\n      <div class=\"chat-title\">{{ targetUser.username || '聊天' }}</div>\r\n      <div class=\"chat-avatar\">\r\n        <img :src=\"getFullUrl(targetUser.photo)\" alt=\"对方头像\" class=\"avatar\" />\r\n      </div>\r\n    </div>\r\n    \r\n    <div class=\"chat-messages\" ref=\"messagesContainer\">\r\n      <div v-if=\"messages.length === 0\" class=\"empty-chat\">\r\n        开始和 {{ targetUser.username || '对方' }} 聊天吧\r\n      </div>\r\n      \r\n      <div \r\n        v-for=\"(msg, index) in messages\" \r\n        :key=\"msg.id || index\" \r\n        :class=\"['message-item', msg.fromMe ? 'from-me' : 'from-other']\"\r\n      >\r\n        <div class=\"message-avatar\">\r\n          <img \r\n            :src=\"msg.fromMe ? myAvatar : getFullUrl(targetUser.photo)\" \r\n            alt=\"头像\" \r\n            class=\"avatar-sm\"\r\n          />\r\n        </div>\r\n        \r\n        <div class=\"message-content\">\r\n          <div class=\"message-bubble\">{{ msg.text }}</div>\r\n          <div class=\"message-time\">{{ formatTime(msg.time) }}</div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n    \r\n    <div class=\"chat-input-area\">\r\n      <input \r\n        type=\"text\" \r\n        v-model=\"inputMessage\" \r\n        placeholder=\"输入消息...\" \r\n        @keyup.enter=\"sendMessage\"\r\n      />\r\n      <button class=\"send-button\" @click=\"sendMessage\">\r\n        <i class=\"fa fa-paper-plane\" aria-hidden=\"true\"></i>\r\n      </button>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { computed, ref, onMounted, onUnmounted, nextTick, watch } from 'vue';\r\nimport { useRoute, useRouter } from 'vue-router';\r\nimport { useStore } from 'vuex';\r\nimport defaultAvatar from '@/assets/default-avatar.png';\r\nimport { API_CONFIG } from '@/config/config';\r\nimport { ElMessage, ElNotification } from 'element-plus';\r\n\r\nexport default {\r\n  setup() {\r\n    const route = useRoute();\r\n    const router = useRouter();\r\n    const store = useStore();\r\n    const messagesContainer = ref(null);\r\n    const targetUser = ref({});\r\n    const messages = ref([]);\r\n    const inputMessage = ref('');\r\n    const myAvatar = computed(() => {\r\n      const user = store.state.user;\r\n      return user.photo ? `${API_CONFIG.BASE_URL}${user.photo}` : defaultAvatar;\r\n    });\r\n    const socket = ref(null);\r\n    const isConnected = ref(false);\r\n    const reconnecting = ref(false);\r\n    const reconnectTimer = ref(null);\r\n    const myId = computed(() => store.state.user.id);\r\n    \r\n    // 工具方法：处理图片URL\r\n    const getFullUrl = (path) => {\r\n      if (!path || path === defaultAvatar) return path;\r\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`;\r\n    };\r\n    \r\n    // 工具方法：格式化时间\r\n    const formatTime = (time) => {\r\n      if (!time) return '';\r\n      const date = new Date(time);\r\n      const now = new Date();\r\n      \r\n      if (date.toDateString() === now.toDateString()) {\r\n        return date.toTimeString().substring(0, 5);\r\n      }\r\n      \r\n      const yesterday = new Date();\r\n      yesterday.setDate(now.getDate() - 1);\r\n      if (date.toDateString() === yesterday.toDateString()) {\r\n        return '昨天';\r\n      }\r\n      \r\n      return `${date.getMonth() + 1}/${date.getDate()}`;\r\n    };\r\n    \r\n    // 初始化WebSocket连接\r\n    const initWebSocket = () => {\r\n      if (myId.value && targetUser.value.id) {\r\n        const wsUrl = `ws://${window.location.host}/ws/chat/${myId.value}/${targetUser.value.id}`;\r\n        \r\n        if (socket.value) {\r\n          socket.value.close();\r\n        }\r\n        \r\n        socket.value = new WebSocket(wsUrl);\r\n        \r\n        socket.value.onopen = () => {\r\n          isConnected.value = true;\r\n          ElNotification({\r\n            title: '连接成功',\r\n            message: '已建立聊天连接',\r\n            type: 'success',\r\n            duration: 3000\r\n          });\r\n        };\r\n        \r\n        socket.value.onmessage = (event) => {  // 这里的event参数被使用，保留\r\n          try {\r\n            const msg = JSON.parse(event.data);\r\n            addMessage({\r\n              id: msg.id,\r\n              text: msg.text,\r\n              fromMe: false,\r\n              time: msg.time\r\n            });\r\n          } catch (e) {\r\n            console.error('解析消息失败', e);\r\n          }\r\n        };\r\n        \r\n        socket.value.onclose = (closeEvent) => {  // 重命名为closeEvent并使用\r\n          isConnected.value = false;\r\n          ElNotification({\r\n            title: '连接断开',\r\n            message: '聊天连接已断开，正在尝试重连...',\r\n            type: 'warning',\r\n            duration: 0\r\n          });\r\n          \r\n          if (!reconnecting.value) {\r\n            startReconnect();\r\n          }\r\n        };\r\n        \r\n        socket.value.onerror = (errorEvent) => {  // 重命名为errorEvent并使用\r\n          console.error('WebSocket错误', errorEvent);\r\n          ElMessage.error('聊天连接错误，请稍后再试');\r\n        };\r\n      }\r\n    };\r\n    \r\n    // 开始重连\r\n    const startReconnect = () => {\r\n      if (reconnecting.value) return;\r\n      \r\n      reconnecting.value = true;\r\n      reconnectTimer.value = setTimeout(() => {\r\n        initWebSocket();\r\n        reconnecting.value = false;\r\n      }, 3000);\r\n    };\r\n    \r\n    // 停止重连\r\n    const stopReconnect = () => {\r\n      if (reconnectTimer.value) {\r\n        clearTimeout(reconnectTimer.value);\r\n        reconnectTimer.value = null;\r\n        reconnecting.value = false;\r\n      }\r\n    };\r\n    \r\n    // 添加消息到列表\r\n    const addMessage = (msg) => {\r\n      messages.value.push(msg);\r\n      nextTick(() => {\r\n        if (messagesContainer.value) {\r\n          messagesContainer.value.scrollTop = messagesContainer.value.scrollHeight;\r\n        }\r\n      });\r\n    };\r\n    \r\n    // 发送消息\r\n    const sendMessage = () => {\r\n      if (!inputMessage.value.trim() || !isConnected.value) {\r\n        if (!isConnected.value) {\r\n          ElMessage.warning('当前连接已断开，消息发送失败');\r\n        }\r\n        return;\r\n      }\r\n      \r\n      const msg = {\r\n        id: Date.now(),\r\n        text: inputMessage.value.trim(),\r\n        fromMe: true,\r\n        time: new Date().toISOString()\r\n      };\r\n      \r\n      addMessage(msg);\r\n      inputMessage.value = '';\r\n      \r\n      try {\r\n        socket.value.send(JSON.stringify({\r\n          id: msg.id,\r\n          text: msg.text,\r\n          time: msg.time,\r\n          from: myId.value,\r\n          to: targetUser.value.id\r\n        }));\r\n      } catch (error) {\r\n        console.error('发送消息失败', error);\r\n        ElMessage.error('消息发送失败，请稍后再试');\r\n      }\r\n    };\r\n    \r\n    // 返回上一页\r\n    const goBack = () => {\r\n      router.back();\r\n      stopReconnect();\r\n      if (socket.value) {\r\n        socket.value.close();\r\n      }\r\n    };\r\n    \r\n    // 监听路由参数变化\r\n    watch(() => route.params.userId, (newId) => {\r\n      if (newId) {\r\n        // 获取目标用户信息\r\n        axios.get(`${API_CONFIG.BASE_URL}/user/userinfo/${newId}`, {\r\n          headers: { Authorization: `Bearer ${store.state.token}` }\r\n        })\r\n        .then(res => {\r\n          targetUser.value = res.data;\r\n          initWebSocket();\r\n        })\r\n        .catch(err => {\r\n          console.error('获取用户信息失败', err);\r\n          ElMessage.error('获取用户信息失败');\r\n          router.back();\r\n        });\r\n      }\r\n    });\r\n    \r\n    onMounted(() => {\r\n      if (route.params.userId) {\r\n        // 初始化时获取目标用户信息\r\n        axios.get(`${API_CONFIG.BASE_URL}/user/userinfo/${route.params.userId}`, {\r\n          headers: { Authorization: `Bearer ${store.state.token}` }\r\n        })\r\n        .then(res => {\r\n          targetUser.value = res.data;\r\n          initWebSocket();\r\n        })\r\n        .catch(err => {\r\n          console.error('获取用户信息失败', err);\r\n          ElMessage.error('获取用户信息失败');\r\n          router.back();\r\n        });\r\n      }\r\n    });\r\n    \r\n    onUnmounted(() => {\r\n      stopReconnect();\r\n      if (socket.value) {\r\n        socket.value.close();\r\n      }\r\n    });\r\n\r\n    return {\r\n      targetUser,\r\n      messages,\r\n      inputMessage,\r\n      myAvatar,\r\n      getFullUrl,\r\n      formatTime,\r\n      sendMessage,\r\n      goBack,\r\n      messagesContainer,\r\n      isConnected\r\n    };\r\n  }\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n.chat-view {\r\n  display: flex;\r\n  flex-direction: column;\r\n  height: 100vh;\r\n  background-color: #f5f5f5;\r\n}\r\n\r\n.chat-header {\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 0 15px;\r\n  height: 50px;\r\n  background-color: #fff;\r\n  border-bottom: 1px solid #e5e5e5;\r\n  position: relative;\r\n}\r\n\r\n.back-button {\r\n  position: absolute;\r\n  left: 15px;\r\n  cursor: pointer;\r\n}\r\n\r\n.chat-title {\r\n  flex: 1;\r\n  text-align: center;\r\n  font-weight: bold;\r\n}\r\n\r\n.chat-avatar {\r\n  position: absolute;\r\n  right: 15px;\r\n  width: 30px;\r\n  height: 30px;\r\n  border-radius: 50%;\r\n  overflow: hidden;\r\n}\r\n\r\n.avatar {\r\n  width: 100%;\r\n  height: 100%;\r\n}\r\n\r\n.chat-messages {\r\n  flex: 1;\r\n  overflow-y: auto;\r\n  padding: 15px;\r\n}\r\n\r\n.empty-chat {\r\n  text-align: center;\r\n  color: #999;\r\n  padding-top: 30px;\r\n}\r\n\r\n.message-item {\r\n  display: flex;\r\n  margin-bottom: 15px;\r\n  max-width: 80%;\r\n}\r\n\r\n.from-me {\r\n  justify-content: flex-end;\r\n  margin-left: auto;\r\n}\r\n\r\n.from-other {\r\n  justify-content: flex-start;\r\n  margin-right: auto;\r\n}\r\n\r\n.message-avatar {\r\n  width: 32px;\r\n  height: 32px;\r\n  margin: 0 8px;\r\n}\r\n\r\n.avatar-sm {\r\n  width: 100%;\r\n  height: 100%;\r\n  border-radius: 50%;\r\n}\r\n\r\n.message-content {\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.message-bubble {\r\n  padding: 8px 12px;\r\n  border-radius: 18px;\r\n  position: relative;\r\n  max-width: 100%;\r\n}\r\n\r\n.from-me .message-bubble {\r\n  background-color: #1890ff;\r\n  color: #fff;\r\n}\r\n\r\n.from-other .message-bubble {\r\n  background-color: #fff;\r\n  color: #333;\r\n  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);\r\n}\r\n\r\n.message-time {\r\n  font-size: 10px;\r\n  color: #999;\r\n  text-align: center;\r\n  margin-top: 3px;\r\n}\r\n\r\n.chat-input-area {\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 10px 15px;\r\n  background-color: #fff;\r\n  border-top: 1px solid #e5e5e5;\r\n}\r\n\r\n.chat-input-area input {\r\n  flex: 1;\r\n  height: 32px;\r\n  padding: 0 12px;\r\n  border: 1px solid #e5e5e5;\r\n  border-radius: 16px;\r\n  outline: none;\r\n}\r\n\r\n.send-button {\r\n  background-color: #1890ff;\r\n  color: #fff;\r\n  border: none;\r\n  border-radius: 50%;\r\n  width: 32px;\r\n  height: 32px;\r\n  margin-left: 10px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  cursor: pointer;\r\n}\r\n</style>"],"mappings":";;EACOA,KAAK,EAAC;AAAW;;EACfA,KAAK,EAAC;AAAa;;EAIjBA,KAAK,EAAC;AAAY;;EAClBA,KAAK,EAAC;AAAa;mBAP9B;;EAYSA,KAAK,EAAC,eAAe;EAACC,GAAG,EAAC;;;EAZnCC,GAAA;EAawCF,KAAK,EAAC;;;EASjCA,KAAK,EAAC;AAAgB;mBAtBn