.id,\n      class: \"moment-item\"\n    }, [_createCommentVNode(\" 用户信息 \"), _createElementVNode(\"div\", _hoisted_4, [_createElementVNode(\"img\", {\n      src: moment.user.photo || $setup.defaultAvatar,\n      class: \"user-avatar\"\n    }, null, 8 /* PROPS */, _hoisted_5), _createElementVNode(\"div\", _hoisted_6, [_createElementVNode(\"span\", _hoisted_7, _toDisplayString(moment.user.username), 1 /* TEXT */), _createElementVNode(\"span\", _hoisted_8, _toDisplayString($setup.formatTime(moment.created_at)), 1 /* TEXT */)])]), _createCommentVNode(\" 动态内容 \"), _createElementVNode(\"div\", {\n      class: \"moment-content\",\n      innerHTML: $setup.sanitizeHtml(moment.content)\n    }, null, 8 /* PROPS */, _hoisted_9), _createCommentVNode(\" 图片展示 \"), moment.media?.length ? (_openBlock(), _createElementBlock(\"div\", _hoisted_10, [(_openBlock(true), _createElementBlock(_Fragment, null, _renderList(moment.media, (media, index) => {\n      return _openBlock(), _createElementBlock(\"div\", {\n        key: index,\n        class: _normalizeClass([\"media-item\", {\n          'video-container': media.type === 'video'\n        }])\n      }, [media.type === 'image' ? (_openBlock(), _createElementBlock(\"img\", {\n        key: 0,\n        src: $setup.getFullUrl(media.url),\n        onClick: $event => $setup.openImagePreview($setup.getFullUrl(media.url))\n      }, null, 8 /* PROPS */, _hoisted_11)) : media.type === 'video' ? (_openBlock(), _createElementBlock(_Fragment, {\n        key: 1\n      }, [_createCommentVNode(\" 视频展示 \"), _createElementVNode(\"video\", {\n        src: $setup.getFullUrl(media.url),\n        controls: \"\",\n        poster: $setup.getFullUrl(media.thumbnail),\n        onClick: _cache[1] || (_cache[1] = _withModifiers((...args) => _ctx.handleVideoClick && _ctx.handleVideoClick(...args), [\"stop\"]))\n      }, [_createElementVNode(\"source\", {\n        src: $setup.getFullUrl(media.url),\n        type: $setup.getVideoType(media.url)\n      }, null, 8 /* PR