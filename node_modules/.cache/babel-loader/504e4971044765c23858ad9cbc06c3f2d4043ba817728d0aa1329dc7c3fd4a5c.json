{"ast":null,"code":"import { ref, reactive, onMounted } from 'vue';\nimport { ElMessage } from 'element-plus';\nimport axios from 'axios';\n\n// 表格数据\n\nexport default {\n  __name: 'BigdataUser',\n  setup(__props, {\n    expose: __expose\n  }) {\n    __expose();\n    const tableData = ref([]);\n    const loading = ref(false);\n\n    // 查询参数\n    const queryParams = reactive({\n      name: '',\n      idno: '',\n      sex: ''\n    });\n\n    // 分页参数\n    const pagination = reactive({\n      page: 1,\n      page_size: 100,\n      total: 0\n    });\n\n    // 格式化生日显示\n    const formatBirthday = birthday => {\n      if (!birthday) return '-';\n      const dateStr = String(birthday);\n      if (dateStr.length === 8) {\n        return `${dateStr.slice(0, 4)}-${dateStr.slice(4, 6)}-${dateStr.slice(6, 8)}`;\n      }\n      return birthday;\n    };\n\n    // 获取用户数据\n    const fetchData = async () => {\n      try {\n        loading.value = true;\n        const params = {\n          ...queryParams,\n          page: pagination.page,\n          page_size: pagination.page_size\n        };\n        const response = await axios.get('/bigdata-users', {\n          params\n        });\n        tableData.value = response.data.data || [];\n        pagination.total = response.data.total;\n\n        // 如果当前页没有数据且不是第一页，则自动跳转到前一页\n        if (tableData.value.length === 0 && pagination.page > 1) {\n          pagination.page -= 1;\n          await fetchData();\n        }\n      } catch (error) {\n        ElMessage.error('获取数据失败: ' + error.message);\n      } finally {\n        loading.value = false;\n      }\n    };\n\n    // 处理查询\n    const handleSearch = () => {\n      pagination.page = 1; // 重置到第一页\n      fetchData();\n    };\n\n    // 处理分页大小变化\n    const handleSizeChange = size => {\n      pagination.page_size = size;\n      fetchData();\n    };\n\n    // 处理页码变化\n    const handlePageChange = page => {\n      pagination.page = page;\n      fetchData();\n    };\n\n    // 初始化加载数据\n    onMounted(() => {\n      fetchData();\n    });\n    const __returned__ = {\n      tableData,\n      loading,\n      queryParams,\n      pagination,\n      formatBirthday,\n      fetchData,\n      handleSearch,\n      handleSizeChange,\n      handlePageChange,\n      ref,\n      reactive,\n      onMounted,\n      get ElMessage() {\n        return ElMessage;\n      },\n      get axios() {\n        return axios;\n      }\n    };\n    Object.defineProperty(__returned__, '__isScriptSetup', {\n      enumerable: false,\n      value: true\n    });\n    return __returned__;\n  }\n};","map":{"version":3,"names":["ref","reactive","onMounted","ElMessage","axios","tableData","loading","queryParams","name","idno","sex","pagination","page","page_size","total","formatBirthday","birthday","dateStr","String","length","slice","fetchData","value","params","response","get","data","error","message","handleSearch","handleSizeChange","size","handlePageChange"],"sources":["E:/vue_fastapi/my_vue/my_vue/src/views/BigdataUser.vue"],"sourcesContent":["<template>\r\n    <div class=\"bigdata-container\">\r\n      <!-- 查询条件 -->\r\n      <div class=\"filter-section\">\r\n        <el-input\r\n          v-model=\"queryParams.name\"\r\n          placeholder=\"姓名\"\r\n          clearable\r\n          style=\"width: 200px\"\r\n        />\r\n        <el-input\r\n          v-model=\"queryParams.idno\"\r\n          placeholder=\"证件号\"\r\n          clearable\r\n          style=\"width: 200px\"\r\n        />\r\n        <el-select\r\n          v-model=\"queryParams.sex\"\r\n          placeholder=\"性别\"\r\n          clearable\r\n          style=\"width: 120px\"\r\n        >\r\n          <el-option label=\"男\" value=\"男\" />\r\n          <el-option label=\"女\" value=\"女\" />\r\n        </el-select>\r\n        <el-button type=\"primary\" @click=\"handleSearch\">查询</el-button>\r\n      </div>\r\n  \r\n      <!-- 数据表格 -->\r\n      <el-table\r\n        :data=\"tableData\"\r\n        border\r\n        stripe\r\n        v-loading=\"loading\"\r\n        style=\"width: 100%\"\r\n      >\r\n        <el-table-column prop=\"name\" label=\"姓名\" width=\"120\" />\r\n        <el-table-column prop=\"idno\" label=\"证件号\" width=\"180\" />\r\n        <el-table-column prop=\"sex\" label=\"性别\" width=\"80\" />\r\n        <el-table-column prop=\"bplace\" label=\"出生地\" width=\"120\" />\r\n        <el-table-column prop=\"idtype\" label=\"证件类型\" width=\"120\" />\r\n        <el-table-column prop=\"province\" label=\"省份\" width=\"120\" />\r\n        <el-table-column prop=\"age\" label=\"年龄\" width=\"80\" />\r\n        <el-table-column prop=\"birthday\" label=\"生日\" width=\"120\">\r\n          <template #default=\"{ row }\">\r\n            {{ formatBirthday(row.birthday) }}\r\n          </template>\r\n        </el-table-column>\r\n      </el-table>\r\n  \r\n      <!-- 分页组件 -->\r\n      <el-pagination\r\n        v-model:current-page=\"pagination.page\"\r\n        v-model:page-size=\"pagination.page_size\"\r\n        :total=\"pagination.total\"\r\n        :page-sizes=\"[50, 100, 200]\"\r\n        layout=\"total, sizes, prev, pager, next, jumper\"\r\n        @size-change=\"handleSizeChange\"\r\n        @current-change=\"handlePageChange\"\r\n      />\r\n    </div>\r\n  </template>\r\n  \r\n  <script setup>\r\n  import { ref, reactive, onMounted } from 'vue'\r\n  import { ElMessage } from 'element-plus'\r\n  import axios from 'axios'\r\n  \r\n  // 表格数据\r\n  const tableData = ref([])\r\n  const loading = ref(false)\r\n  \r\n  // 查询参数\r\n  const queryParams = reactive({\r\n    name: '',\r\n    idno: '',\r\n    sex: ''\r\n  })\r\n  \r\n  // 分页参数\r\n  const pagination = reactive({\r\n    page: 1,\r\n    page_size: 100,\r\n    total: 0\r\n  })\r\n  \r\n  // 格式化生日显示\r\n  const formatBirthday = (birthday) => {\r\n    if (!birthday) return '-'\r\n    const dateStr = String(birthday)\r\n    if (dateStr.length === 8) {\r\n      return `${dateStr.slice(0, 4)}-${dateStr.slice(4, 6)}-${dateStr.slice(6, 8)}`\r\n    }\r\n    return birthday\r\n  }\r\n  \r\n  // 获取用户数据\r\n  const fetchData = async () => {\r\n    try {\r\n      loading.value = true\r\n      const params = {\r\n        ...queryParams,\r\n        page: pagination.page,\r\n        page_size: pagination.page_size\r\n      }\r\n  \r\n      const response = await axios.get('/bigdata-users', { params })\r\n      tableData.value = response.data.data || []\r\n      pagination.total = response.data.total\r\n      \r\n      // 如果当前页没有数据且不是第一页，则自动跳转到前一页\r\n      if (tableData.value.length === 0 && pagination.page > 1) {\r\n        pagination.page -= 1\r\n        await fetchData()\r\n      }\r\n    } catch (error) {\r\n      ElMessage.error('获取数据失败: ' + error.message)\r\n    } finally {\r\n      loading.value = false\r\n    }\r\n  }\r\n  \r\n  // 处理查询\r\n  const handleSearch = () => {\r\n    pagination.page = 1 // 重置到第一页\r\n    fetchData()\r\n  }\r\n  \r\n  // 处理分页大小变化\r\n  const handleSizeChange = (size) => {\r\n    pagination.page_size = size\r\n    fetchData()\r\n  }\r\n  \r\n  // 处理页码变化\r\n  const handlePageChange = (page) => {\r\n    pagination.page = page\r\n    fetchData()\r\n  }\r\n  \r\n  // 初始化加载数据\r\n  onMounted(() => {\r\n    fetchData()\r\n  })\r\n  </script>\r\n  \r\n  <style scoped>\r\n  .bigdata-container {\r\n    padding: 20px;\r\n    background: #fff;\r\n    border-radius: 4px;\r\n    box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\r\n  }\r\n  \r\n  .filter-section {\r\n    margin-bottom: 20px;\r\n    display: flex;\r\n    gap: 10px;\r\n  }\r\n  \r\n  .el-pagination {\r\n    margin-top: 20px;\r\n    justify-content: flex-end;\r\n  }\r\n  </style>"],"mappings":"AAgEE,SAASA,GAAG,EAAEC,QAAQ,EAAEC,SAAS,QAAQ,KAAK;AAC9C,SAASC,SAAS,QAAQ,cAAc;AACxC,OAAOC,KAAK,MAAM,OAAO;;AAEzB;;;;;;;;IACA,MAAMC,SAAS,GAAGL,GAAG,CAAC,EAAE,CAAC;IACzB,MAAMM,OAAO,GAAGN,GAAG,CAAC,KAAK,CAAC;;IAE1B;IACA,MAAMO,WAAW,GAAGN,QAAQ,CAAC;MAC3BO,IAAI,EAAE,EAAE;MACRC,IAAI,EAAE,EAAE;MACRC,GAAG,EAAE;IACP,CAAC,CAAC;;IAEF;IACA,MAAMC,UAAU,GAAGV,QAAQ,CAAC;MAC1BW,IAAI,EA