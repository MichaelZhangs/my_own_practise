{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport \"core-js/modules/es.iterator.map.js\";\nimport \"core-js/modules/es.iterator.some.js\";\nimport { computed, ref, onMounted, watch } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRouter } from 'vue-router';\nimport defaultAvatar from '@/assets/default-avatar.png';\nimport { API_CONFIG } from '@/config/config';\nimport axios from 'axios';\nimport { ElMessage } from 'element-plus';\nimport { debounce } from 'lodash';\nexport default {\n  setup() {\n    const store = useStore();\n    const router = useRouter();\n    const isUserInfoOpen = ref(false);\n    const user = computed(() => store.state.user);\n    const displayName = computed(() => user.value?.username || '未登录');\n\n    // 搜索相关状态\n    const isSearchOpen = ref(false);\n    const searchKeyword = ref('');\n    const searchResults = ref([]);\n    const isSearching = ref(false);\n\n    // 最近聊天列表\n    const recentChats = computed(() => store.getters['chat/getRecentChats']);\n\n    // 工具方法\n    const getFullUrl = path => {\n      if (!path || path === defaultAvatar) return path;\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`;\n    };\n\n    // 最近聊天折叠状态\n    const isRecentChatCollapse = ref(true);\n    const toggleRecentChatCollapse = () => {\n      isRecentChatCollapse.value = !isRecentChatCollapse.value;\n    };\n    const avatarUrl = computed(() => {\n      if (user.value?.photo) {\n        return `${API_CONFIG.BASE_URL}${user.value.photo}`;\n      }\n      return defaultAvatar;\n    });\n    const logout = () => {\n      store.dispatch('logout');\n      router.push('/login');\n    };\n    const goToUserDetail = () => {\n      router.push('/user/userinfo/' + user.value?.id);\n    };\n    const toggleUserInfo = () => {\n      isUserInfoOpen.value = !isUserInfoOpen.value;\n    };\n\n    // 搜索相关方法\n    const toggleSearch = () => {\n      isSearchOpen.value = !isSearchOpen.value;\n\n      // 关闭搜索时清空结果\n      if (!isSearchOpen.value) {\n        searchKeyword.value = '';\n        searchResults.value = [];\n      }\n    };\n    const debouncedSearchUsers = debounce(async keyword => {\n      if (!keyword.trim()) {\n        searchResults.value = [];\n        return;\n      }\n      isSearching.value = true;\n      try {\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/user/search`, {\n          params: {\n            keyword: keyword.trim()\n          },\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        });\n        searchResults.value = response.data.data || [];\n      } catch (error) {\n        console.error('搜索用户失败:', error);\n        ElMessage.error('搜索用户失败');\n      } finally {\n        isSearching.value = false;\n      }\n    }, 300);\n    watch(searchKeyword, newVal => {\n      debouncedSearchUsers(newVal);\n    });\n    const clearSearch = () => {\n      searchKeyword.value = '';\n      searchResults.value = [];\n    };\n\n    // 检查用户是否已登录\n    const isUserLoggedIn = computed(() => !!user.value?.id);\n\n    // 组件挂载时尝试加载最近聊天\n    onMounted(() => {\n      if (isUserLoggedIn.value) {\n        loadRecentChats();\n      }\n    });\n\n    // 监听用户状态变化\n    watch(user, newUser => {\n      if (newUser?.id) {\n        loadRecentChats();\n      }\n    });\n    const loadRecentChats = async () => {\n      try {\n        await store.dispatch('chat/loadRecentChats');\n      } catch (error) {\n        console.error('加载最近聊天失败:', error);\n      }\n    };\n\n    // 开始聊天方法\n    const startChat = async user => {\n      ElMessage.success(`开始与 ${user.username} 聊天`);\n      const userId = parseInt(user.id, 10);\n      const newUser = {\n        ...user,\n        id: userId\n      };\n\n      // 更新最近聊天列表\n      store.commit('chat/ADD_RECENT_CHAT', newUser);\n      await store.dispatch('chat/saveRecentChat', newUser);\n      await store.dispatch('chat/clearUnreadCount', newUser.id);\n      isSearchOpen.value = false;\n      searchKeyword.value = '';\n      searchResults.value = [];\n\n      // 跳转到聊天页面\n      router.push({\n        name: 'Chat',\n        params: {\n          userId: newUser.id\n        }\n      });\n    };\n\n    // 群聊相关状态\n    const showGroupMenu = ref(false);\n    const showCreateGroupDialog = ref(false);\n    const groupSearchKeyword = ref('');\n    const groupName = ref('');\n    const allUsers = ref([]); // 所有可用用户\n    const selectedUsers = ref([]); // 已选用户\n\n    // 加载所有用户（创建群聊时使用）\n    const loadAllUsers = async () => {\n      try {\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/user/list`, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        });\n\n        // 排除当前用户\n        allUsers.value = response.data.data.filter(u => u.id !== user.value.id);\n      } catch (error) {\n        console.error('加载用户列表失败:', error);\n        ElMessage.error('加载用户列表失败');\n      }\n    };\n\n    // 打开创建群聊对话框\n    const openCreateGroupDialog = async () => {\n      showGroupMenu.value = false;\n      showCreateGroupDialog.value = true;\n      groupName.value = '';\n      selectedUsers.value = [];\n      groupSearchKeyword.value = '';\n\n      // 确保用户列表已加载\n      if (allUsers.value.length === 0) {\n        await loadAllUsers();\n      }\n    };\n\n    // 过滤群聊用户列表\n    const filteredUsers = computed(() => {\n      if (!groupSearchKeyword.value.trim()) {\n        return allUsers.value;\n      }\n      const keyword = groupSearchKeyword.value.toLowerCase().trim();\n      return allUsers.value.filter(u => u.username.toLowerCase().includes(keyword) || u.phone && u.phone.includes(keyword));\n    });\n\n    // 切换用户选择状态\n    const toggleUserSelection = user => {\n      const index = selectedUsers.value.findIndex(u => u.id === user.id);\n      if (index === -1) {\n        selectedUsers.value.push(user);\n      } else {\n        selectedUsers.value.splice(index, 1);\n      }\n    };\n\n    // 检查用户是否已被选中\n    const isUserSelected = userId => {\n      return selectedUsers.value.some(u => u.id === userId);\n    };\n\n    // 移除已选用户\n    const removeUser = userId => {\n      selectedUsers.value = selectedUsers.value.filter(u => u.id !== userId);\n    };\n\n    // 创建群聊\n    const createGroup = async () => {\n      if (selectedUsers.value.length < 2) {\n        ElMessage.warning('至少选择2位成员');\n        return;\n      }\n      try {\n        const groupMembers = selectedUsers.value.map(u => u.id);\n        groupMembers.push(user.value.id); // 添加当前用户\n\n        const groupData = {\n          name: groupName.value || `群聊 (${selectedUsers.value.length + 1}人)`,\n          members: groupMembers\n        };\n\n        // 调用创建群聊API\n        const response = await axios.post(`${API_CONFIG.BASE_URL}/group/create`, groupData, {\n          headers: {\n            Authorization: `Bearer ${store.state.token}`\n          }\n        });\n        if (response.data.success) {\n          ElMessage.success('群聊创建成功');\n\n          // 添加到最近聊天\n          const groupInfo = {\n            id: response.data.group.id,\n            username: groupData.name,\n            photo: response.data.group.photo || null,\n            isGroup: true\n          };\n          store.commit('chat/ADD_RECENT_CHAT', groupInfo);\n          await store.dispatch('chat/saveRecentChat', groupInfo);\n          showCreateGroupDialog.value = false;\n\n          // 跳转到群聊页面\n          router.push({\n            name: 'Chat',\n            params: {\n              userId: response.data.group.id\n            }\n          });\n        } else {\n          ElMessage.error('群聊创建失败: ' + response.data.message);\n        }\n      } catch (error) {\n        console.error('创建群聊失败:', error);\n        ElMessage.error('群聊创建失败，请重试');\n      }\n    };\n    return {\n      user,\n      displayName,\n      avatarUrl,\n      getFullUrl,\n      logout,\n      goToUserDetail,\n      isUserInfoOpen,\n      toggleUserInfo,\n      isSearchOpen,\n      searchKeyword,\n      searchResults,\n      isSearching,\n      toggleSearch,\n      clearSearch,\n      startChat,\n      defaultAvatar,\n      API_CONFIG,\n      recentChats,\n      isRecentChatCollapse,\n      toggleRecentChatCollapse,\n      // 群聊相关\n      showGroupMenu,\n      showCreateGroupDialog,\n      groupSearchKeyword,\n      groupName,\n      selectedUsers,\n      filteredUsers,\n      openCreateGroupDialog,\n      toggleUserSelection,\n      isUserSelected,\n      removeUser,\n      createGroup\n    };\n  }\n};","map":{"version":3,"names":["computed","ref","onMounted","watch","useStore","useRouter","defaultAvatar","API_CONFIG","axios","ElMessage","debounce","setup","store","router","isUserInfoOpen","user","state","displayName","value","username","isSearchOpen","searchKeyword","searchResults","isSearching","recentChats","getters","getFullUrl","path","startsWith","BASE_URL","isRecentChatCollapse","toggleRecentChatCollapse","avatarUrl","photo","logout","dispatch","push","goToUserDetail","id","toggleUserInfo","toggleSearch","debouncedSearchUsers","keyword","trim","response","get","params","headers","Authorization","token","data","error","console","newVal","clearSearch","isUserLoggedIn","loadRecentChats","newUser","startChat","success","userId","parseInt","commit","name","showGroupMenu","showCreateGroupDialog","groupSearchKeyword","groupName","allUsers","selectedUsers","loadAllUsers","filter","u","openCreateGroupDialog","length","filteredUsers","toLowerCase","includes","phone","toggleUserSelection","index","findIndex","splice","isUserSelected","some","removeUser","createGroup","warning","groupMembers","map","groupData","members","post","groupInfo","group","isGroup","message"],"sources":["E:\\vue_fastapi\\my_vue\\vue_pro\\src\\views\\UserLayout.vue"],"sourcesContent":["<template>\r\n  <div class=\"user-page\">\r\n    <header class=\"header\">\r\n      <div class=\"header-left\">\r\n        <div class=\"user-info\" @click=\"goToUserDetail\">\r\n          <img :src=\"avatarUrl\" alt=\"用户头像\" class=\"avatar\" />\r\n          <span class=\"username\">{{ displayName }}</span>\r\n        </div>\r\n      </div>\r\n      \r\n      <div class=\"header-right\">\r\n        <!-- 添加群聊按钮 -->\r\n        <button class=\"add-group-button\" @click=\"showGroupMenu = true\">\r\n          <i class=\"fa fa-plus\" aria-hidden=\"true\"></i>\r\n        </button>\r\n        <button @click=\"logout\" class=\"logout-button\">退出登录</button>\r\n        \r\n        <!-- 群聊操作菜单 -->\r\n        <div \r\n          class=\"group-menu\" \r\n          v-if=\"showGroupMenu\"\r\n          @click.away=\"showGroupMenu = false\"\r\n        >\r\n          <div class=\"menu-item\" @click=\"openCreateGroupDialog\">\r\n            <i class=\"fa fa-users\" aria-hidden=\"true\"></i> 发起群聊\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </header>\r\n\r\n    <div class=\"main-layout\">\r\n      <aside class=\"sidebar\">\r\n        <!-- 搜索组件 -->\r\n        <div class=\"sidebar-search\">\r\n          <div class=\"search-toggle\" @click=\"toggleSearch\">\r\n            <i class=\"fa fa-search\" aria-hidden=\"true\"></i>\r\n            <span>搜索用户</span>\r\n          </div>\r\n          \r\n          <div v-if=\"isSearchOpen\" class=\"search-box\">\r\n            <div class=\"search-input-group\">\r\n              <input \r\n                type=\"text\" \r\n                v-model=\"searchKeyword\" \r\n                placeholder=\"搜索用户...\" \r\n                @keyup.enter=\"searchUsers\"\r\n              />\r\n              <button class=\"search-button\" @click=\"searchUsers\">\r\n                <i class=\"fa fa-search\" aria-hidden=\"true\"></i>\r\n              </button>\r\n              <button class=\"cancel-button\" @click=\"toggleSearch\">\r\n                取消\r\n              </button>\r\n            </div>\r\n            \r\n            <!-- 搜索结果列表 -->\r\n            <div v-if=\"isSearching\" class=\"search-loading\">\r\n              <i class=\"fa fa-spinner fa-spin\" aria-hidden=\"true\"></i> 搜索中...\r\n            </div>\r\n            \r\n            <div v-else-if=\"searchResults.length > 0\" class=\"search-results\">\r\n              <div \r\n                v-for=\"user in searchResults\" \r\n                :key=\"user.id\" \r\n                class=\"search-result-item\"\r\n                @click=\"startChat(user)\"\r\n              >\r\n                <div class=\"result-avatar-container\">\r\n                  <img \r\n                    :src=\"getFullUrl(user.photo)|| defaultAvatar\" \r\n                    alt=\"用户头像\" \r\n                    class=\"result-avatar\"\r\n                  />\r\n                </div>\r\n                <div class=\"result-info\">\r\n                  <div class=\"result-name\">{{ user.username }}</div>\r\n                  <div class=\"result-phone\">{{ user.phone }}</div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n            \r\n            <div v-else-if=\"searchKeyword && !isSearching\" class=\"no-results\">\r\n              没有找到匹配的用户\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <!-- 菜单 -->\r\n        <ul class=\"menu\">\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/user/dashboard\" class=\"menu-link\">仪表盘</router-link>\r\n          </li>\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/user-moment\" class=\"menu-link\">我相关</router-link>\r\n          </li>\r\n          <li class=\"menu-item\">\r\n            <router-link to=\"/moments\" class=\"menu-link\">朋友圈</router-link>\r\n          </li>\r\n          <li class=\"menu-item\">\r\n            <div @click=\"toggleUserInfo\" class=\"menu-title\">\r\n              用户信息\r\n              <span class=\"arrow\">{{ isUserInfoOpen ? '▼' : '▶' }}</span>\r\n            </div>\r\n            <ul v-if=\"isUserInfoOpen\" class=\"sub-menu\">\r\n              <li class=\"sub-menu-item\">\r\n                <router-link to=\"/user/userinfo/userlist\" class=\"sub-menu-link\">用户列表</router-link>\r\n              </li>\r\n              <li class=\"sub-menu-item2\">\r\n                <router-link to=\"/user/bigdatauser\" class=\"sub-menu-link\">大数据用户</router-link>\r\n              </li>\r\n            </ul>\r\n          </li>\r\n          <!-- 最近聊天列表 -->\r\n          <div class=\"recent-chats\">\r\n            <div \r\n              class=\"recent-chats-title\" \r\n              @click=\"toggleRecentChatCollapse\"\r\n            >\r\n              最近聊天\r\n              <span>{{ isRecentChatCollapse ? '▶' : '▼' }}</span>\r\n            </div>\r\n            <div \r\n              class=\"recent-chat-list\" \r\n              v-show=\"!isRecentChatCollapse\"\r\n            >\r\n              <div\r\n                v-for=\"(user, index) in recentChats\"\r\n                :key=\"index\"\r\n                class=\"recent-chat-item\"\r\n                @click=\"startChat(user)\"\r\n              >\r\n                <div class=\"result-avatar-container\">\r\n                  <img\r\n                    :src=\"getFullUrl(user.photo) || defaultAvatar\"\r\n                    alt=\"用户头像\"\r\n                    class=\"result-avatar\"\r\n                  />\r\n                </div>\r\n                <div class=\"result-info\">\r\n                  <div class=\"result-name\">{{ user.username }}</div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </ul>\r\n      </aside>\r\n\r\n      <main class=\"main-content\">\r\n        <router-view />\r\n      </main>\r\n    </div>\r\n    \r\n    <!-- 创建群聊弹窗 -->\r\n    <div class=\"group-dialog-mask\" v-if=\"showCreateGroupDialog\">\r\n      <div class=\"group-dialog\">\r\n        <div class=\"dialog-header\">\r\n          <h3>创建群聊</h3>\r\n          <button class=\"close-button\" @click=\"showCreateGroupDialog = false\">\r\n            <i class=\"fa fa-times\" aria-hidden=\"true\"></i>\r\n          </button>\r\n        </div>\r\n        \r\n        <div class=\"dialog-body\">\r\n          <div class=\"search-box\">\r\n            <input \r\n              type=\"text\" \r\n              v-model=\"groupSearchKeyword\" \r\n              placeholder=\"搜索用户...\" \r\n              @input=\"filterGroupUsers\"\r\n            />\r\n          </div>\r\n          \r\n          <div class=\"selected-users\" v-if=\"selectedUsers.length > 0\">\r\n            <div class=\"selected-title\">已选 {{ selectedUsers.length }} 人</div>\r\n            <div class=\"selected-avatars\">\r\n              <div \r\n                v-for=\"user in selectedUsers\" \r\n                :key=\"user.id\"\r\n                class=\"selected-avatar\"\r\n                @click=\"removeUser(user.id)\"\r\n              >\r\n                <img :src=\"getFullUrl(user.photo) || defaultAvatar\" alt=\"用户头像\" />\r\n                <span class=\"remove-icon\">×</span>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          \r\n          <div class=\"group-name-input\">\r\n            <input \r\n              type=\"text\" \r\n              v-model=\"groupName\" \r\n              placeholder=\"请输入群聊名称\"\r\n            />\r\n          </div>\r\n          \r\n          <div class=\"user-list\">\r\n            <div class=\"list-header\">选择联系人</div>\r\n            <div \r\n              v-for=\"user in filteredUsers\" \r\n              :key=\"user.id\"\r\n              class=\"user-item\"\r\n              @click=\"toggleUserSelection(user)\"\r\n              :class=\"{ selected: isUserSelected(user.id) }\"\r\n            >\r\n              <div class=\"result-avatar-container\">\r\n                <img \r\n                  :src=\"getFullUrl(user.photo) || defaultAvatar\" \r\n                  alt=\"用户头像\" \r\n                  class=\"result-avatar\"\r\n                />\r\n              </div>\r\n              <div class=\"result-info\">\r\n                <div class=\"result-name\">{{ user.username }}</div>\r\n                <div class=\"result-phone\">{{ user.phone }}</div>\r\n              </div>\r\n              <div class=\"selection-indicator\" v-if=\"isUserSelected(user.id)\">\r\n                <i class=\"fa fa-check\" aria-hidden=\"true\"></i>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        \r\n        <div class=\"dialog-footer\">\r\n          <button \r\n            class=\"cancel-btn\" \r\n            @click=\"showCreateGroupDialog = false\"\r\n          >\r\n            取消\r\n          </button>\r\n          <button \r\n            class=\"create-btn\" \r\n            @click=\"createGroup\"\r\n            :disabled=\"selectedUsers.length < 2\"\r\n          >\r\n            创建\r\n          </button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { computed, ref, onMounted, watch } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { useRouter } from 'vue-router';\r\nimport defaultAvatar from '@/assets/default-avatar.png';\r\nimport { API_CONFIG } from '@/config/config';\r\nimport axios from 'axios';\r\nimport { ElMessage } from 'element-plus';\r\nimport { debounce } from 'lodash';\r\n\r\nexport default {\r\n  setup() {\r\n    const store = useStore();\r\n    const router = useRouter();\r\n    const isUserInfoOpen = ref(false);\r\n    const user = computed(() => store.state.user);\r\n    const displayName = computed(() => user.value?.username || '未登录');\r\n    \r\n    // 搜索相关状态\r\n    const isSearchOpen = ref(false);\r\n    const searchKeyword = ref('');\r\n    const searchResults = ref([]);\r\n    const isSearching = ref(false);\r\n    \r\n    // 最近聊天列表\r\n    const recentChats = computed(() => store.getters['chat/getRecentChats']);\r\n    \r\n    // 工具方法\r\n    const getFullUrl = (path) => {\r\n      if (!path || path === defaultAvatar) return path;\r\n      return path.startsWith('http') ? path : `${API_CONFIG.BASE_URL}${path}`;\r\n    };\r\n    \r\n    // 最近聊天折叠状态\r\n    const isRecentChatCollapse = ref(true);\r\n    const toggleRecentChatCollapse = () => {\r\n      isRecentChatCollapse.value = !isRecentChatCollapse.value;\r\n    };\r\n\r\n    const avatarUrl = computed(() => {\r\n      if (user.value?.photo) {\r\n        return `${API_CONFIG.BASE_URL}${user.value.photo}`;\r\n      }\r\n      return defaultAvatar;\r\n    });\r\n\r\n    const logout = () => {\r\n      store.dispatch('logout');\r\n      router.push('/login');\r\n    };\r\n\r\n    const goToUserDetail = () => {\r\n      router.push('/user/userinfo/' + user.value?.id);\r\n    };\r\n\r\n    const toggleUserInfo = () => {\r\n      isUserInfoOpen.value = !isUserInfoOpen.value;\r\n    };\r\n    \r\n    // 搜索相关方法\r\n    const toggleSearch = () => {\r\n      isSearchOpen.value = !isSearchOpen.value;\r\n      \r\n      // 关闭搜索时清空结果\r\n      if (!isSearchOpen.value) {\r\n        searchKeyword.value = '';\r\n        searchResults.value = [];\r\n      }\r\n    };\r\n\r\n    const debouncedSearchUsers = debounce(async (keyword) => {\r\n      if (!keyword.trim()) {\r\n        searchResults.value = [];\r\n        return;\r\n      }\r\n      \r\n      isSearching.value = true;\r\n      \r\n      try {\r\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/user/search`, {\r\n          params: {\r\n            keyword: keyword.trim()\r\n          },\r\n          headers: { Authorization: `Bearer ${store.state.token}` }\r\n        });\r\n        \r\n        searchResults.value = response.data.data || [];\r\n      } catch (error) {\r\n        console.error('搜索用户失败:', error);\r\n        ElMessage.error('搜索用户失败');\r\n      } finally {\r\n        isSearching.value = false;\r\n      }\r\n    }, 300);\r\n\r\n    watch(searchKeyword, (newVal) => {\r\n      debouncedSearchUsers(newVal);\r\n    });\r\n\r\n    const clearSearch = () => {\r\n      searchKeyword.value = '';\r\n      searchResults.value = [];\r\n    };\r\n    \r\n    // 检查用户是否已登录\r\n    const isUserLoggedIn = computed(() => !!user.value?.id);\r\n    \r\n    // 组件挂载时尝试加载最近聊天\r\n    onMounted(() => {\r\n      if (isUserLoggedIn.value) {\r\n        loadRecentChats();\r\n      }\r\n    });\r\n    \r\n    // 监听用户状态变化\r\n    watch(user, (newUser) => {\r\n      if (newUser?.id) {\r\n        loadRecentChats();\r\n      }\r\n    });\r\n    \r\n    const loadRecentChats = async () => {\r\n      try {\r\n        await store.dispatch('chat/loadRecentChats');\r\n      } catch (error) {\r\n        console.error('加载最近聊天失败:', error);\r\n      }\r\n    };\r\n\r\n    // 开始聊天方法\r\n    const startChat = async (user) => {\r\n      ElMessage.success(`开始与 ${user.username} 聊天`);\r\n\r\n      const userId = parseInt(user.id, 10);\r\n      const newUser = { ...user, id: userId };\r\n\r\n      // 更新最近聊天列表\r\n      store.commit('chat/ADD_RECENT_CHAT', newUser);\r\n      await store.dispatch('chat/saveRecentChat', newUser);\r\n      await store.dispatch('chat/clearUnreadCount', newUser.id);\r\n\r\n      isSearchOpen.value = false;\r\n      searchKeyword.value = '';\r\n      searchResults.value = [];\r\n\r\n      // 跳转到聊天页面\r\n      router.push({\r\n        name: 'Chat',\r\n        params: { userId: newUser.id },\r\n      });\r\n    };\r\n\r\n    // 群聊相关状态\r\n    const showGroupMenu = ref(false);\r\n    const showCreateGroupDialog = ref(false);\r\n    const groupSearchKeyword = ref('');\r\n    const groupName = ref('');\r\n    const allUsers = ref([]); // 所有可用用户\r\n    const selectedUsers = ref([]); // 已选用户\r\n    \r\n    // 加载所有用户（创建群聊时使用）\r\n    const loadAllUsers = async () => {\r\n      try {\r\n        const response = await axios.get(`${API_CONFIG.BASE_URL}/user/list`, {\r\n          headers: { Authorization: `Bearer ${store.state.token}` }\r\n        });\r\n        \r\n        // 排除当前用户\r\n        allUsers.value = response.data.data.filter(u => u.id !== user.value.id);\r\n      } catch (error) {\r\n        console.error('加载用户列表失败:', error);\r\n        ElMessage.error('加载用户列表失败');\r\n      }\r\n    };\r\n    \r\n    // 打开创建群聊对话框\r\n    const openCreateGroupDialog = async () => {\r\n      showGroupMenu.value = false;\r\n      showCreateGroupDialog.value = true;\r\n      groupName.value = '';\r\n      selectedUsers.value = [];\r\n      groupSearchKeyword.value = '';\r\n      \r\n      // 确保用户列表已加载\r\n      if (allUsers.value.length === 0) {\r\n        await loadAllUsers();\r\n      }\r\n    };\r\n    \r\n    // 过滤群聊用户列表\r\n    const filteredUsers = computed(() => {\r\n      if (!groupSearchKeyword.value.trim()) {\r\n        return allUsers.value;\r\n      }\r\n      \r\n      const keyword = groupSearchKeyword.value.toLowerCase().trim();\r\n      return allUsers.value.filter(u => \r\n        u.username.toLowerCase().includes(keyword) || \r\n        (u.phone && u.phone.includes(keyword))\r\n      );\r\n    });\r\n    \r\n    // 切换用户选择状态\r\n    const toggleUserSelection = (user) => {\r\n      const index = selectedUsers.value.findIndex(u => u.id === user.id);\r\n      \r\n      if (index === -1) {\r\n        selectedUsers.value.push(user);\r\n      } else {\r\n        selectedUsers.value.splice(index, 1);\r\n      }\r\n    };\r\n    \r\n    // 检查用户是否已被选中\r\n    const isUserSelected = (userId) => {\r\n      return selectedUsers.value.some(u => u.id === userId);\r\n    };\r\n    \r\n    // 移除已选用户\r\n    const removeUser = (userId) => {\r\n      selectedUsers.value = selectedUsers.value.filter(u => u.id !== userId);\r\n    };\r\n    \r\n    // 创建群聊\r\n    const createGroup = async () => {\r\n      if (selectedUsers.value.length < 2) {\r\n        ElMessage.warning('至少选择2位成员');\r\n        return;\r\n      }\r\n      \r\n      try {\r\n        const groupMembers = selectedUsers.value.map(u => u.id);\r\n        groupMembers.push(user.value.id); // 添加当前用户\r\n        \r\n        const groupData = {\r\n          name: groupName.value || `群聊 (${selectedUsers.value.length + 1}人)`,\r\n          members: groupMembers\r\n        };\r\n        \r\n        // 调用创建群聊API\r\n        const response = await axios.post(\r\n          `${API_CONFIG.BASE_URL}/group/create`,\r\n          groupData,\r\n          { headers: { Authorization: `Bearer ${store.state.token}` } }\r\n        );\r\n        \r\n        if (response.data.success) {\r\n          ElMessage.success('群聊创建成功');\r\n          \r\n          // 添加到最近聊天\r\n          const groupInfo = {\r\n            id: response.data.group.id,\r\n            username: groupData.name,\r\n            photo: response.data.group.photo || null,\r\n            isGroup: true\r\n          };\r\n          \r\n          store.commit('chat/ADD_RECENT_CHAT', groupInfo);\r\n          await store.dispatch('chat/saveRecentChat', groupInfo);\r\n          \r\n          showCreateGroupDialog.value = false;\r\n          \r\n          // 跳转到群聊页面\r\n          router.push({\r\n            name: 'Chat',\r\n            params: { userId: response.data.group.id },\r\n          });\r\n        } else {\r\n          ElMessage.error('群聊创建失败: ' + response.data.message);\r\n        }\r\n      } catch (error) {\r\n        console.error('创建群聊失败:', error);\r\n        ElMessage.error('群聊创建失败，请重试');\r\n      }\r\n    };\r\n\r\n    return {\r\n      user,\r\n      displayName,\r\n      avatarUrl,\r\n      getFullUrl,\r\n      logout,\r\n      goToUserDetail,\r\n      isUserInfoOpen,\r\n      toggleUserInfo,\r\n      isSearchOpen,\r\n      searchKeyword,\r\n      searchResults,\r\n      isSearching,\r\n      toggleSearch,\r\n      clearSearch,\r\n      startChat,\r\n      defaultAvatar,\r\n      API_CONFIG,\r\n      recentChats,\r\n      isRecentChatCollapse,\r\n      toggleRecentChatCollapse,\r\n      \r\n      // 群聊相关\r\n      showGroupMenu,\r\n      showCreateGroupDialog,\r\n      groupSearchKeyword,\r\n      groupName,\r\n      selectedUsers,\r\n      filteredUsers,\r\n      openCreateGroupDialog,\r\n      toggleUserSelection,\r\n      isUserSelected,\r\n      removeUser,\r\n      createGroup\r\n    };\r\n  },\r\n};\r\n</script>\r\n\r\n<style scoped>\r\n/* 原有样式 */\r\n.user-page {\r\n  display: flex;\r\n  flex-direction: column;\r\n  height: 100vh;\r\n  background-color: #f0f2f5;\r\n}\r\n\r\n.header {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  padding: 0 20px;\r\n  height: 60px;\r\n  background-color: #001529;\r\n  color: white;\r\n}\r\n\r\n.header-left {\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.user-info {\r\n  display: flex;\r\n  align-items: center;\r\n  cursor: pointer;\r\n}\r\n\r\n.avatar {\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 50%;\r\n  margin-right: 10px;\r\n}\r\n\r\n.username {\r\n  margin-right: 20px;\r\n  font-size: 16px;\r\n}\r\n\r\n.logout-button {\r\n  padding: 5px 10px;\r\n  background-color: #1890ff;\r\n  color: white;\r\n  border: none;\r\n  border-radius: 4px;\r\n  cursor: pointer;\r\n}\r\n\r\n.logout-button:hover {\r\n  background-color: #40a9ff;\r\n}\r\n\r\n.main-layout {\r\n  display: flex;\r\n  flex: 1;\r\n  overflow: hidden;\r\n}\r\n\r\n.sidebar {\r\n  width: 200px;\r\n  background-color: #001529;\r\n  color: white;\r\n  overflow-y: auto;\r\n}\r\n\r\n.menu {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 0;\r\n}\r\n\r\n.menu-item {\r\n  padding: 15px 20px;\r\n  border-bottom: 1px solid #002140;\r\n}\r\n\r\n.menu-link {\r\n  color: white;\r\n  text-decoration: none;\r\n  font-size: 14px;\r\n}\r\n\r\n.menu-link:hover {\r\n  color: #1890ff;\r\n}\r\n\r\n.menu-title {\r\n  cursor: pointer;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  font-size: 14px;\r\n}\r\n\r\n.arrow {\r\n  font-size: 12px;\r\n}\r\n\r\n.sub-menu {\r\n  list-style: none;\r\n  padding: 0;\r\n  margin: 10px 0 0 20px;\r\n}\r\n\r\n.sub-menu-item {\r\n  padding: 10px 0;\r\n}\r\n\r\n.sub-menu-link {\r\n  color: white;\r\n  text-decoration: none;\r\n  font-size: 14px;\r\n}\r\n\r\n.sub-menu-link:hover {\r\n  color: #1890ff;\r\n}\r\n\r\n.main-content {\r\n  flex: 1;\r\n  padding: 20px;\r\n  background-color: white;\r\n  overflow-y: auto;\r\n  position: relative;\r\n}\r\n\r\n/* 搜索区域样式 */\r\n.sidebar-search {\r\n  padding: 15px 20px;\r\n  border-bottom: 1px solid #002140;\r\n}\r\n\r\n.search-toggle {\r\n  cursor: pointer;\r\n  display: flex;\r\n  align-items: center;\r\n  font-size: 14px;\r\n}\r\n\r\n.search-toggle i {\r\n  margin-right: 10px;\r\n}\r\n\r\n.search-box {\r\n  margin-top: 10px;\r\n  background-color: #002140;\r\n  border-radius: 4px;\r\n  padding: 10px;\r\n}\r\n\r\n.search-input-group {\r\n  display: flex;\r\n  align-items: center;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.search-input-group input {\r\n  flex: 1;\r\n  padding: 8px;\r\n  border: 1px solid #003a75;\r\n  border-radius: 4px 0 0 4px;\r\n  outline: none;\r\n  background-color: #003a75;\r\n  color: white;\r\n}\r\n\r\n.search-input-group input::placeholder {\r\n  color: #8c8c8c;\r\n}\r\n\r\n.search-button, .cancel-button {\r\n  padding: 8px 12px;\r\n  background-color: #1890ff;\r\n  color: white;\r\n  border: none;\r\n  cursor: pointer;\r\n}\r\n\r\n.search-button {\r\n  border-radius: 0 4px 4px 0;\r\n}\r\n\r\n.cancel-button {\r\n  margin-left: 5px;\r\n  border-radius: 4px;\r\n  background-color: #f5222d;\r\n}\r\n\r\n.search-loading, .no-results {\r\n  padding: 10px;\r\n  text-align: center;\r\n  color: #8c8c8c;\r\n}\r\n\r\n.search-results {\r\n  max-height: 300px;\r\n  overflow-y: auto;\r\n}\r\n\r\n.search-result-item {\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 10px;\r\n  border-bottom: 1px solid #003a75;\r\n  cursor: pointer;\r\n}\r\n\r\n.search-result-item:hover {\r\n  background-color: #003a75;\r\n}\r\n\r\n.result-avatar {\r\n  width: 32px;\r\n  height: 32px;\r\n  border-radius: 50%;\r\n  margin-right: 10px;\r\n}\r\n\r\n.result-info {\r\n  flex: 1;\r\n}\r\n\r\n.result-name {\r\n  font-weight: bold;\r\n}\r\n\r\n.result-phone {\r\n  font-size: 12px;\r\n  color: #8c8c8c;\r\n}\r\n\r\n/* 最近聊天列表样式 */\r\n.recent-chats {\r\n  padding: 15px 20px;\r\n  border-bottom: 1px solid #002140;\r\n}\r\n\r\n.recent-chats-title {\r\n  font-size: 14px;\r\n  font-weight: bold;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.recent-chat-item {\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 10px 0;\r\n  cursor: pointer;\r\n}\r\n\r\n.recent-chat-item:hover {\r\n  background-color: #003a75;\r\n}\r\n\r\n/* 新增群聊相关样式 */\r\n.add-group-button {\r\n  width: 32px;\r\n  height: 32px;\r\n  border-radius: 50%;\r\n  background-color: rgba(255, 255, 255, 0.1);\r\n  color: white;\r\n  border: none;\r\n  margin-right: 10px;\r\n  cursor: pointer;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n\r\n.add-group-button:hover {\r\n  background-color: rgba(255, 255, 255, 0.2);\r\n}\r\n\r\n.group-menu {\r\n  position: absolute;\r\n  top: 50px;\r\n  right: 15px;\r\n  background-color: white;\r\n  border-radius: 4px;\r\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);\r\n  z-index: 10;\r\n  width: 160px;\r\n  color: #333;\r\n}\r\n\r\n.group-menu .menu-item {\r\n  padding: 10px 15px;\r\n  cursor: pointer;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.group-menu .menu-item:hover {\r\n  background-color: #f5f5f5;\r\n}\r\n\r\n.group-menu .menu-item i {\r\n  margin-right: 10px;\r\n}\r\n\r\n.group-dialog-mask {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  right: 0;\r\n  bottom: 0;\r\n  background-color: rgba(0, 0, 0, 0.5);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  z-index: 100;\r\n}\r\n\r\n.group-dialog {\r\n  background-color: white;\r\n  border-radius: 4px;\r\n  width: 400px;\r\n  max-height: 80vh;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.dialog-header {\r\n  padding: 15px 20px;\r\n  border-bottom: 1px solid #e8e8e8;\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  position: relative;\r\n}\r\n\r\n.dialog-header h3 {\r\n  margin: 0;\r\n  font-size: 16px;\r\n  font-weight: 500;\r\n}\r\n\r\n.close-button {\r\n  background: none;\r\n  border: none;\r\n  cursor: pointer;\r\n  font-size: 16px;\r\n  color: #999;\r\n}\r\n\r\n.close-button:hover {\r\n  color: #333;\r\n}\r\n\r\n.dialog-body {\r\n  flex: 1;\r\n  overflow-y: auto;\r\n  padding: 15px 20px;\r\n}\r\n\r\n.dialog-body .search-box {\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.dialog-body .search-box input {\r\n  width: 100%;\r\n  padding: 8px 12px;\r\n  border: 1px solid #d9d9d9;\r\n  border-radius: 4px;\r\n  outline: none;\r\n}\r\n\r\n.dialog-body .search-box input:focus {\r\n  border-color: #1890ff;\r\n  box-shadow: 0 0 0 2px rgba(24, 144, 255, 0.2);\r\n}\r\n\r\n.selected-users {\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.selected-title {\r\n  font-size: 14px;\r\n  color: #666;\r\n  margin-bottom: 10px;\r\n}\r\n\r\n.selected-avatars {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: 8px;\r\n}\r\n\r\n.selected-avatar {\r\n  position: relative;\r\n}\r\n\r\n.selected-avatar img {\r\n  width: 40px;\r\n  height: 40px;\r\n  border-radius: 50%;\r\n}\r\n\r\n.remove-icon {\r\n  position: absolute;\r\n  top: -4px;\r\n  right: -4px;\r\n  background-color: #f5222d;\r\n  color: white;\r\n  width: 16px;\r\n  height: 16px;\r\n  border-radius: 50%;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 10px;\r\n  cursor: pointer;\r\n}\r\n\r\n.group-name-input {\r\n  margin-bottom: 15px;\r\n}\r\n\r\n.group-name-input input {\r\n  width: 100%;\r\n  padding: 8px 12px;\r\n  border: 1px solid #d9d9d9;\r\n  border-radius: 4px;\r\n  outline: none;\r\n}\r\n\r\n.group-name-input input:focus {\r\n  border-color: #1890ff;\r\n  box-shadow: 0 0 0 2px rgba(24, 144, 255, 0.2);\r\n}\r\n\r\n.user-list .list-header {\r\n  font-size: 14px;\r\n  font-weight: 500;\r\n  margin-bottom: 10px;\r\n  color: #333;\r\n}\r\n\r\n.user-item {\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 10px 0;\r\n  cursor: 